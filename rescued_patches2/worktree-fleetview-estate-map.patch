+# The RCA worker's Postgres role password: bin/idp-estate-seed mints it straight into the
+# estate-db vault entry (it is a brand new consumer, same as lago and aevum-evidence -- no
+# legacy server, so no copy Job and no platform/estate-db/migrate row), and
+# platform/estate-db/cluster/secrets.yaml publishes the same value into estate-db so
+# CloudNativePG can mint the `via_negativa` role from it. This is that same value again, here,
+# because the RCA worker's own container composes VN_LEDGER_DSN from it (same shape as
+# platform/llm/litellm.yaml's DATABASE_URL) -- one value, two namespaces, never typed.
+#
+# Mounted as a file, never as pod env (Kyverno secrets-not-from-env-vars).
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-db
+  namespace: via-negativa
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: via-negativa-db
+    creationPolicy: Owner
+  data:
+    - secretKey: DB_PASSWORD
+      remoteRef: { key: estate-db, property: via-negativa-password }
+---
+# The RCA worker's own router key (LAW 34: the router is the only place a model credential
+# exists). Minted by bin/idp-estate-seed's router-key plan, scoped to `groq` alone -- Primitive
+# B's regex pre-filter is the free path (bin/rca_worker/worker.py, regex_extract_constraint());
+# this key is only ever reached on the fallback, so it is deliberately the cheapest lane
+# (llm/config.yaml's `groq` row), never minimax or gemini.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-router
+  namespace: via-negativa
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: via-negativa-router, creationPolicy: Owner }
+  data:
+    - secretKey: LITELLM_API_KEY
+      remoteRef: { key: via-negativa, property: LITELLM_API_KEY }
