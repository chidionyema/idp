diff --git a/platform/via-negativa/namespace.yaml b/platform/via-negativa/namespace.yaml
new file mode 100644
index 000000000..73e57d17f
--- /dev/null
+++ b/platform/via-negativa/namespace.yaml
@@ -0,0 +1,20 @@
+# The via-negativa engine (bin/negative-constraints-proxy, bin/rca_worker): an interception
+# proxy that pre-flight-rejects banned tool-call signatures, an async worker that turns a real
+# agent failure into a negative constraint, and a Postgres ledger of what was learned. Own
+# namespace, own Redis (platform/llm/redis.yaml's own-dedicated-cache pattern, not a shared
+# store per THE HEADLINE), own row on the one Postgres (platform/estate-db).
+#
+# Restricted profile, default-deny NetworkPolicy + ResourceQuota + LimitRange from
+# platform/ns-fences (bin/idp-ns-fence-gen, allowances.yaml) -- not hand-written here, same
+# deferred-until-measured state platform/epistemic-fabric/namespace.yaml is in.
+apiVersion: v1
+kind: Namespace
+metadata:
+  annotations:
+    # Never garbage-collected by Flux (idp#648): a namespace dropped from git stays, with
+    # everything in it, and the next reconcile reads as a portability break.
+    kustomize.toolkit.fluxcd.io/prune: disabled
+  name: via-negativa
+  labels:
+    app.kubernetes.io/part-of: idp
+    pod-security.kubernetes.io/enforce: restricted
diff --git a/platform/via-negativa/proxy.yaml b/platform/via-negativa/proxy.yaml
new file mode 100644
index 000000000..39b20f7c2
--- /dev/null
+++ b/platform/via-negativa/proxy.yaml
@@ -0,0 +1,75 @@
+# Primitive A (interception proxy: banned-signature pre-flight rejection, the deadlock breaker)
+# and the read side of Primitive C (top-constraints prompt injection). Sits in front of the
+# router, so every agent's tool calls pass through it before litellm ever sees them.
+apiVersion: v1
+kind: Service
+metadata:
+  name: via-negativa-proxy
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: via-negativa }
+spec:
+  type: ClusterIP
+  selector: { app.kubernetes.io/name: via-negativa-proxy }
+  ports:
+    - { name: http, port: 80, targetPort: 8080 }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-proxy
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 2
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-proxy }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: proxy
+          image: ghcr.io/chidionyema/negative-constraints-proxy:main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:negative-constraints-proxy:tag"}
+          # distroless/static: no shell to compose REDIS_URL before exec, and Kyverno
+          # secrets-not-from-env-vars refuses the password as pod env either way. The redis
+          # password rides a mounted file instead; REDIS_PASSWORD_FILE tells the binary itself
+          # where to read it and fold it into REDIS_URL (main.go, resolveRedisURL()).
+          ports:
+            - { name: http, containerPort: 8080 }
+          env:
+            - { name: LISTEN_ADDR, value: ":8080" }
+            - { name: UPSTREAM_URL, value: "http://litellm.llm.svc.cluster.local:4000" }
+            - { name: REDIS_URL, value: "redis://via-negativa-redis.via-negativa.svc.cluster.local:6379" }
+            - { name: REDIS_PASSWORD_FILE, value: "/run/secrets/via-negativa/redis/REDIS_PASSWORD" }
+            - { name: REDIS_KEY, value: "via_negativa:banned_signatures" }
+            - { name: TOP_CONSTRAINTS_KEY, value: "via_negativa:top_constraints" }
+            - { name: TOP_CONSTRAINTS_N, value: "5" }
+          readinessProbe:
+            httpGet: { path: /healthz, port: 8080 }
+            initialDelaySeconds: 2
+          livenessProbe:
+            httpGet: { path: /healthz, port: 8080 }
+            initialDelaySeconds: 5
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          resources:
+            requests: { cpu: 100m, memory: 64Mi }
+            limits: { cpu: 500m, memory: 128Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/via-negativa/rca.yaml b/platform/via-negativa/rca.yaml
new file mode 100644
index 000000000..804cdeddd
--- /dev/null
+++ b/platform/via-negativa/rca.yaml
@@ -0,0 +1,84 @@
+# Primitive D: the async RCA worker. Consumes real agent failures off Redis Streams, extracts a
+# negative constraint (Primitive B's regex pre-filter first, an LLM-schema-enforced fallback
+# second), writes it to the Postgres ledger and ranks it into the top-constraints set the proxy
+# reads (Primitive C's write side).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-rca
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-rca, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 1
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-rca }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-rca, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: rca
+          image: ghcr.io/chidionyema/rca_worker:main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:via-negativa-rca:tag"}
+          env:
+            - { name: REDIS_URL, value: "redis://via-negativa-redis.via-negativa.svc.cluster.local:6379" }
+            - { name: REDIS_PASSWORD_FILE, value: "/run/secrets/via-negativa/redis/REDIS_PASSWORD" }
+            # No password here -- estate-rw is the one Postgres (platform/estate-db); the
+            # worker itself folds VN_LEDGER_DSN_PASSWORD_FILE's contents in
+            # (worker.py, _with_password_from_file()), the same convention the proxy's
+            # REDIS_PASSWORD_FILE uses (Kyverno secrets-not-from-env-vars).
+            - { name: VN_LEDGER_DSN, value: "postgresql://via_negativa@estate-rw.estate-db.svc.cluster.local:5432/via_negativa" }
+            - { name: VN_LEDGER_DSN_PASSWORD_FILE, value: "/run/secrets/via-negativa/db/DB_PASSWORD" }
+            # Fallback only -- Primitive B's regex pre-filter is the free path and satisfies
+            # most failures without ever reaching this. `groq` is the cheapest lane
+            # (platform/llm/config.yaml), matching the router key's own scope below.
+            - { name: VN_LLM_MODEL, value: "groq" }
+            - { name: VN_FAILURE_STREAM, value: "via_negativa:failures" }
+            - { name: VN_CONSUMER_GROUP, value: "rca-workers" }
+            - { name: VN_DLQ_STREAM, value: "via_negativa:failures:dlq" }
+            - { name: VN_BANNED_SET, value: "via_negativa:banned_signatures" }
+            - { name: VN_TOP_CONSTRAINTS_KEY, value: "via_negativa:top_constraints" }
+            - { name: VN_MAX_ATTEMPTS, value: "3" }
+            - { name: OPENAI_BASE_URL, value: "http://litellm.llm.svc.cluster.local:4000/v1" }
+            - { name: OPENAI_API_KEY_FILE, value: "/run/secrets/via-negativa/router/LITELLM_API_KEY" }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          # No listening port to probe (Redis Streams consumer, no server) -- same shape as
+          # platform/mcp/estate-mcp.yaml's file-freshness probe: the consume loop (worker.py,
+          # run_forever()) touches /tmp/heartbeat every turn, block=2000ms even when idle, so a
+          # stale file means the loop, not just the process, is wedged.
+          livenessProbe:
+            exec: { command: ["sh", "-c", "find /tmp/heartbeat -mmin -2 | grep -q ."] }
+            initialDelaySeconds: 30
+            periodSeconds: 30
+            failureThreshold: 3
+          readinessProbe:
+            exec: { command: ["sh", "-c", "find /tmp/heartbeat -mmin -2 | grep -q ."] }
+            initialDelaySeconds: 10
+            periodSeconds: 15
+          resources:
+            requests: { cpu: 100m, memory: 128Mi }
+            limits: { cpu: 500m, memory: 256Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: db-secret, mountPath: /run/secrets/via-negativa/db, readOnly: true }
+            - { name: router-secret, mountPath: /run/secrets/via-negativa/router, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: db-secret
+          secret: { secretName: via-negativa-db }
+        - name: router-secret
+          secret: { secretName: via-negativa-router }
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/via-negativa/redis.yaml b/platform/via-negativa/redis.yaml
new file mode 100644
index 000000000..9cdf40600
--- /dev/null
+++ b/platform/via-negativa/redis.yaml
@@ -0,0 +1,114 @@
+# via-negativa's own memory: the proxy's banned-signature set and top-constraints ranking
+# (Primitives A and C) and the RCA worker's failure stream (Primitive D). One dedicated Redis,
+# not the shared llm cache -- THE HEADLINE's "never add a second store" is about not building a
+# second kind of store for one estate, not about sharing one cache instance across unrelated
+# components; the shape here is a direct copy of platform/llm/redis.yaml.
+#
+# The password is minted inside the cluster by the secret machinery's own password generator --
+# no vault entry, no console, no person ever sees it. refreshInterval 0h: minted once at
+# creation and stable, so the proxy and the worker can never disagree about it.
+apiVersion: generators.external-secrets.io/v1alpha1
+kind: Password
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+spec:
+  length: 42
+  digits: 10
+  symbols: 0
+  symbolCharacters: ""
+  noUpper: false
+  allowRepeat: true
+---
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+spec:
+  refreshInterval: 0h
+  target: { name: via-negativa-redis, creationPolicy: Owner }
+  dataFrom:
+    - sourceRef:
+        generatorRef:
+          apiVersion: generators.external-secrets.io/v1alpha1
+          kind: Password
+          name: via-negativa-redis
+      rewrite:
+        - transform: { template: "REDIS_PASSWORD" }
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: via-negativa }
+spec:
+  type: ClusterIP
+  selector: { app.kubernetes.io/name: via-negativa-redis }
+  ports:
+    - { name: redis, port: 6379, targetPort: 6379 }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 1
+  # One memory: two caches behind one name would briefly disagree, so replace, never overlap.
+  # Losing it for the seconds of a replace is safe -- the proxy fails open (patternStore.match
+  # sees an empty set) and the worker's XREADGROUP simply resumes from its consumer group
+  # position once the store is back.
+  strategy: { type: Recreate }
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-redis }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 999   # redis uid in the alpine image
+        runAsGroup: 999
+        fsGroup: 999
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: redis
+          image: docker.io/library/redis:7.4-alpine
+          command: ["/bin/sh", "-c"]
+          args:
+            - exec redis-server --requirepass "$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)" --maxmemory 192mb --maxmemory-policy allkeys-lru --save "" --appendonly no
+          ports:
+            - { containerPort: 6379, name: redis }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            exec:
+              command: ["/bin/sh", "-c", "REDISCLI_AUTH=\"$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)\" redis-cli ping"]
+            periodSeconds: 10
+          livenessProbe:
+            exec:
+              command: ["/bin/sh", "-c", "REDISCLI_AUTH=\"$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)\" redis-cli ping"]
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 25m, memory: 64Mi }
+            limits: { cpu: 250m, memory: 256Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: data, mountPath: /data }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: data
+          emptyDir: { sizeLimit: 256Mi }
+        - name: tmp
+          emptyDir: {}
