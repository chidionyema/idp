+# crew#539: the scheduler primitives that make the cluster structurally immune to the 2026-08-27
+# node-swap starvation (langfuse 503 for nine minutes, telemetry and gateway pods Pending on
+# "Insufficient cpu"). Three Kubernetes-native objects, no new paid infrastructure (founder spec,
+# crew#539, verbatim on the issue): two PriorityClasses, a balloon Deployment, and the Kyverno
+# policy that keeps the radio-room set honest. Restricted PSA: the balloon is the pause image.
+apiVersion: v1
+kind: Namespace
+metadata:
+  name: scheduling
+  labels:
+    app.kubernetes.io/part-of: idp
+    pod-security.kubernetes.io/enforce: restricted
diff --git a/platform/scheduling/priorityclasses.yaml b/platform/scheduling/priorityclasses.yaml
new file mode 100644
index 000000000..30206ae31
--- /dev/null
+++ b/platform/scheduling/priorityclasses.yaml
@@ -0,0 +1,24 @@
+# The "radio room" rule (crew#539 CP2): if the ship is sinking the radio room floods last. Under
+# CPU pressure the scheduler evicts ordinary pods to seat these; a runner or an app job may die,
+# the visibility and the routing never do. Applied strictly (founder) to langfuse-web,
+# langfuse-worker, mcp/agentgateway, hermes-agent-gateway, telemetry-coverage and cluster-state;
+# require-priority-class.yaml refuses any of the six that drops it.
+apiVersion: scheduling.k8s.io/v1
+kind: PriorityClass
+metadata:
+  name: infrastructure-critical
+value: 1000000
+globalDefault: false
+preemptionPolicy: PreemptLowerPriority
+description: "crew#539: monitoring and routing are seated before anything else on the node"
+---
+# The balloon (crew#539 CP1): the class the pause pods run under. Negative so every real pod
+# outranks them, and preemptionPolicy Never so a balloon itself can never evict anything.
+apiVersion: scheduling.k8s.io/v1
+kind: PriorityClass
+metadata:
+  name: balloon
+value: -1
+globalDefault: false
+preemptionPolicy: Never
+description: "crew#539: reserved headroom; preempted in milliseconds by any real workload"
diff --git a/platform/scheduling/require-priority-class.yaml b/platform/scheduling/require-priority-class.yaml
new file mode 100644
index 000000000..5dd79ed41
--- /dev/null
+++ b/platform/scheduling/require-priority-class.yaml
@@ -0,0 +1,68 @@
+# LAW 45 guard for crew#539 (CP5). Two rules, two modes, on purpose (LAW 38: a guard that refuses
+# correct work is an outage):
+#   radio-room-set-is-critical      Enforce  the six named workloads must run as infrastructure-critical;
+#                                            the class the founder set is not something a later edit drops.
+#   platform-workload-names-a-class Audit    every other Deployment/StatefulSet/CronJob in an idp namespace
+#                                            without a priorityClassName is a PolicyReport row. Flipped to
+#                                            Enforce the way crew#341's secrets policy is: after a pass with
+#                                            zero violations, never before (the langfuse chart alone ships
+#                                            five workloads that would be refused today).
+# Kyverno is already the estate's admission controller (platform/edge); a shell gate here would be
+# a script for a solved problem (headline rule 1).
+apiVersion: kyverno.io/v1
+kind: ClusterPolicy
+metadata:
+  name: require-priority-class
+  annotations:
+    policies.kyverno.io/title: Require a PriorityClass on platform workloads
+    policies.kyverno.io/category: crew#539 scheduling immunity
+    policies.kyverno.io/severity: high
+    policies.kyverno.io/subject: Deployment, StatefulSet, CronJob
+    policies.kyverno.io/description: >-
+      The radio-room set (langfuse-web, langfuse-worker, agentgateway, hermes-agent-gateway,
+      telemetry-coverage, cluster-state) must run under the infrastructure-critical PriorityClass;
+      every other platform workload should name a class so the scheduler can rank it under pressure.
+spec:
+  background: true
+  rules:
+    - name: radio-room-set-is-critical
+      match:
+        any:
+          - resources:
+              kinds: [Deployment, CronJob]
+              names: [langfuse-web, langfuse-worker, agentgateway, hermes-agent-gateway, telemetry-coverage, cluster-state]
+      validate:
+        failureAction: Enforce
+        message: "crew#539: this workload is in the radio-room set and must run as priorityClassName infrastructure-critical"
+        anyPattern:
+          - spec:
+              template:
+                spec:
+                  priorityClassName: infrastructure-critical
+          - spec:
+              jobTemplate:
+                spec:
+                  template:
+                    spec:
+                      priorityClassName: infrastructure-critical
+    - name: platform-workload-names-a-class
+      match:
+        any:
+          - resources:
+              kinds: [Deployment, StatefulSet, CronJob]
+              namespaceSelector:
+                matchLabels: { app.kubernetes.io/part-of: idp }
+      validate:
+        failureAction: Audit
+        message: "crew#539: a platform workload names a priorityClassName so the scheduler can rank it under CPU pressure"
+        anyPattern:
+          - spec:
+              template:
+                spec:
+                  priorityClassName: "?*"
+          - spec:
+              jobTemplate:
+                spec:
+                  template:
+                    spec:
+                      priorityClassName: "?*"
