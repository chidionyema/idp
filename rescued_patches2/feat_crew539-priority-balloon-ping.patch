diff --git a/platform/scheduling/balloon.yaml b/platform/scheduling/balloon.yaml
new file mode 100644
index 000000000..27c280013
--- /dev/null
+++ b/platform/scheduling/balloon.yaml
@@ -0,0 +1,38 @@
+# Balloon pods (crew#539 CP1, founder spec): a Deployment of pause containers that request CPU and
+# do nothing. When a real pod needs the CPU during a node swap the scheduler preempts a balloon in
+# milliseconds instead of waiting the 3-5 minutes a new VM takes. Sized for the one 4 OCPU node
+# (platform/keda/keda.yaml): 2 x 300m = 600m, 15 % of the node, inside the founder's 10-20 %.
+# A preempted balloon then sits Pending, which is exactly the signal the OKE Cluster Autoscaler
+# (CP4, through oke-check) boots a node on; until CP4 lands this is a standing 15 % reservation.
+# registry.k8s.io/pause, not k8s.gcr.io: the old registry is frozen (kubernetes.io, 2023-03).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: balloon
+  labels: { app.kubernetes.io/name: balloon, app.kubernetes.io/part-of: idp }
+spec:
+  replicas: 2
+  selector:
+    matchLabels: { app.kubernetes.io/name: balloon }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: balloon, app.kubernetes.io/part-of: idp }
+    spec:
+      priorityClassName: balloon
+      terminationGracePeriodSeconds: 0
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65535
+        runAsGroup: 65535
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: pause
+          image: registry.k8s.io/pause:3.10
+          resources:
+            requests: { cpu: 300m, memory: 16Mi }
+            limits: { cpu: 300m, memory: 16Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
