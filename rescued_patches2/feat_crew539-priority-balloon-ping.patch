+# The K8sGPT analyzer. Split from the operator install (incident 2026-08-25, chaos row):
+# Flux dry-runs a row as one unit, and a core.k8sgpt.ai CR cannot be dry-run before the
+# operator chart has installed its CRD. Row `healing-analyzer` orders after `healing`.
+apiVersion: core.k8sgpt.ai/v1alpha1
+kind: K8sGPT
+metadata:
+  name: estate
+  namespace: healing
+spec:
+  ai:
+    enabled: true
+    backend: openai
+    baseUrl: http://litellm.llm.svc:4000/v1
+    model: minimax
+    secret:
+      name: k8sgpt
+      key: key
+    anonymized: true
+    language: english
+  noCache: false
+  repository: ghcr.io/k8sgpt-ai/k8sgpt
+  version: v0.4.37
