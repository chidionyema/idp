+++ b/platform/healing/k8sgpt.yaml
@@ -0,0 +1,80 @@
+# crew#539 CP7. K8sGPT (LAW 43, k8sgpt-ai/k8sgpt, Apache-2.0) scans the cluster and explains a
+# Pending wave, a CrashLoop or a failed HelmRelease in plain English as Result objects
+# (`kubectl get results -n healing`). Operator chart 0.2.29 read from https://charts.k8sgpt.ai/
+# index on 2026-08-27; k8sgpt binary v0.4.37 is the latest release tag the same day.
+# LAW 34: the backend is the estate's LiteLLM (Service litellm.llm.svc:4000), reached through the
+# OpenAI-compatible door with a router virtual key from the vault entry `k8sgpt` (external-secret.yaml).
+# No vendor key lives here; swapping the model is a LiteLLM row, not a K8sGPT change.
+apiVersion: source.toolkit.fluxcd.io/v1
+kind: HelmRepository
+metadata:
+  name: k8sgpt
+  namespace: healing
+spec:
+  interval: 24h
+  url: https://charts.k8sgpt.ai/
+---
+apiVersion: helm.toolkit.fluxcd.io/v2
+kind: HelmRelease
+metadata:
+  name: k8sgpt-operator
+  namespace: healing
+spec:
+  interval: 1h
+  timeout: 10m
+  chart:
+    spec:
+      chart: k8sgpt-operator
+      version: 0.2.29
+      sourceRef:
+        kind: HelmRepository
+        name: k8sgpt
+  install:
+    remediation: { retries: 3 }
+    crds: CreateReplace
+  upgrade:
+    remediation: { retries: 3 }
+    crds: CreateReplace
+  # The chart's manager pod passes every estate policy except three (bin/idp-kyverno-render, 2026-08-27):
+  # the kube-rbac-proxy sidecar carries no probes, and neither container sets readOnlyRootFilesystem
+  # or a seccomp profile. Patched here rather than excepted; the manager already probes 8081.
+  postRenderers:
+    - kustomize:
+        patches:
+          - target: { kind: Deployment, name: k8sgpt-operator-controller-manager }
+            patch: |
+              apiVersion: apps/v1
+              kind: Deployment
+              metadata: { name: k8sgpt-operator-controller-manager }
+              spec:
+                template:
+                  spec:
+                    securityContext:
+                      seccompProfile: { type: RuntimeDefault }
+                    containers:
+                      - name: manager
+                        securityContext:
+                          readOnlyRootFilesystem: true
+                          seccompProfile: { type: RuntimeDefault }
+                      - name: kube-rbac-proxy
+                        securityContext:
+                          readOnlyRootFilesystem: true
+                          seccompProfile: { type: RuntimeDefault }
+                        livenessProbe:
+                          tcpSocket: { port: https }
+                          initialDelaySeconds: 10
+                          periodSeconds: 30
+                        readinessProbe:
+                          tcpSocket: { port: https }
+                          initialDelaySeconds: 5
+                          periodSeconds: 10
+  values:
+    serviceMonitor:
+      enabled: false
+    grafanaDashboard:
+      enabled: false
+    controllerManager:
+      manager:
+        resources:
+          requests: { cpu: 50m, memory: 64Mi }
+          limits: { cpu: 500m, memory: 256Mi }
