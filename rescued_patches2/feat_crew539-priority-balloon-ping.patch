@@ -0,0 +1,14 @@
+# The one Secret K8sGPT reads: key `key`, a LiteLLM virtual key (a router key, never a vendor key),
+# from the estate vault entry `k8sgpt` written by .github/workflows/vault-seed.yml -f entry=k8sgpt.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: k8sgpt
+  namespace: healing
+spec:
+  refreshInterval: 1h
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: k8sgpt, creationPolicy: Owner }
+  data:
+    - secretKey: key
+      remoteRef: { key: k8sgpt, property: key }
