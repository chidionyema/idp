+  wait: true
+  timeout: 5m
+---
+# crew#539 CP6/CP7: the self-healing loops. Descheduler rebalances after every node swap; K8sGPT
+# explains a Pending wave through the estate's own router. After scheduling (it must not evict the
+# radio room), llm (the backend) and secret-store (the router key).
+apiVersion: kustomize.toolkit.fluxcd.io/v1
+kind: Kustomization
+metadata:
+  name: healing
+  namespace: flux-system
+spec:
+  interval: 10m
+  dependsOn:
+    - name: scheduling
+    - name: llm
+    - name: secret-store
+  sourceRef:
+    kind: GitRepository
+    name: flux-system
+  path: ./platform/healing
+  prune: true
+  wait: true
+  timeout: 15m
+  healthChecks:
+    - apiVersion: helm.toolkit.fluxcd.io/v2
+      kind: HelmRelease
+      name: descheduler
+      namespace: healing
+    - apiVersion: helm.toolkit.fluxcd.io/v2
+      kind: HelmRelease
+      name: k8sgpt-operator
+      namespace: healing
+---
+# crew#539 CP7: the K8sGPT analyzer CR, split from the operator install so the row
+# dry-runs after core.k8sgpt.ai exists (the chaos-mesh/chaos shape).
+apiVersion: kustomize.toolkit.fluxcd.io/v1
+kind: Kustomization
+metadata:
+  name: healing-analyzer
+  namespace: flux-system
+spec:
+  interval: 10m
+  dependsOn:
+    - name: healing
+  sourceRef:
