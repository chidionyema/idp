+	case "$f" in
+	bin/* | .githooks/* | scripts/*)
+		[ -f "$f" ] || continue
+		shell_staged+=("$f")
+		;;
+	*.py)
+		if command -v ruff >/dev/null; then
+			ruff check --quiet --select E9,F "$f" || {
+				echo "pre-commit: ruff refused $f"
+				rc=1
+			}
