+          echo "1f57a384d59542f8fac5f503da1f3ea44242f46dff969569e80b524d64b71dbc  /tmp/shfmt" | sha256sum -c -
+          install -m 0755 /tmp/shfmt /usr/local/bin/shfmt
+      # Rule 5 (crew#620 CP2): the lint step itself runs under `bash -x` so a red prints its
+      # trace inline -- installer and checkout steps above stay untraced, this is the lint step.
+      - name: shell-strict lint
+        run: bash -x bin/idp-shell-strict
