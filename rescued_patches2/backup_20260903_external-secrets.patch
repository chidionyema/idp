+# The one ClusterSecretStore. Vault OCID and region are substituted by Flux from the
+# `estate-vars` ConfigMap that bin/idp-flux-bootstrap writes from tofu outputs (LAW 46: no
+# identifier for this tenancy is typed here).
+apiVersion: external-secrets.io/v1
+kind: ClusterSecretStore
+metadata:
+  name: oci-vault
+spec:
+  provider:
+    oracle:
+      vault: ${OCI_VAULT_ID}
+      region: ${OCI_REGION}
+      principalType: InstancePrincipal
diff --git a/platform/secrets/external-secrets.yaml b/platform/secrets/external-secrets.yaml
new file mode 100644
index 000000000..685fbdea9
--- /dev/null
+++ b/platform/secrets/external-secrets.yaml
@@ -0,0 +1,41 @@
+# External Secrets Operator: reads OCI Vault as the node's instance principal and writes
+# Kubernetes Secrets. Replaces the sops-age key that lives in flux-system (crew#227 CP3).
+# Chart pinned; the release tag was helm-chart-2.9.0 on 2026-08-25
+# (api.github.com/repos/external-secrets/external-secrets/releases/latest).
+apiVersion: source.toolkit.fluxcd.io/v1
+kind: HelmRepository
+metadata:
+  name: external-secrets
+  namespace: external-secrets
+spec:
+  interval: 24h
+  url: https://charts.external-secrets.io
+---
+apiVersion: helm.toolkit.fluxcd.io/v2
+kind: HelmRelease
+metadata:
+  name: external-secrets
+  namespace: external-secrets
+spec:
+  interval: 1h
+  chart:
+    spec:
+      chart: external-secrets
+      version: 2.9.0
+      sourceRef:
+        kind: HelmRepository
+        name: external-secrets
+  values:
+    installCRDs: true
+    # one 1.8-core node (platform/oci/main.tf); Kyverno refuses pods without limits
+    resources:
+      requests: { cpu: 20m, memory: 64Mi }
+      limits: { cpu: 200m, memory: 128Mi }
+    webhook:
+      resources:
+        requests: { cpu: 10m, memory: 32Mi }
+        limits: { cpu: 100m, memory: 64Mi }
+    certController:
+      resources:
+        requests: { cpu: 10m, memory: 32Mi }
+        limits: { cpu: 100m, memory: 64Mi }
