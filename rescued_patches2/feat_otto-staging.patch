diff --git a/platform/otto-staging/deployment.yaml b/platform/otto-staging/deployment.yaml
new file mode 100644
index 000000000..a7622a81f
--- /dev/null
+++ b/platform/otto-staging/deployment.yaml
@@ -0,0 +1,163 @@
+# Otto staging (founder order 2026-09-01). Fixed deploy contract from the crew#otto-staging
+# task: container command `python -m otto.boot`, port from OTTO_BOOT_PORT (default 8080),
+# health at GET /healthz, webhook at POST /telegram-webhook, the bot token via env
+# OTTO_TELEGRAM_BOT_TOKEN, the config file path via env OTTO_BOOT_CONFIG. Same image as
+# platform/hermes-agent (ghcr.io/chidionyema/hermes-agent, built from hermes-v2); only the
+# command differs -- this is the new otto.boot process (hermes-v2 branch otto/boot-surface),
+# not the hermes-agent gateway (Telegram poller + a2a + mac-run) that lives in the other
+# namespace and keeps running unchanged.
+#
+# workingDir: the image's Dockerfile (hermes-v2/Dockerfile) sets ENTRYPOINT to
+# deploy/k8s/entrypoint.sh and leaves WORKDIR at /app/hermes-agent (the upstream fork's own
+# checkout and venv, PATH-first). This Deployment's `command:` replaces that entrypoint
+# entirely (Kubernetes `command` overrides a Docker ENTRYPOINT the same way `args` overrides
+# CMD), so entrypoint.sh's own HERMES_BUILD_DIR copy never runs here. The estate repo itself
+# (hermes-v2, which carries the otto/ package) is baked into the image at /app/estate
+# (Dockerfile: `COPY --chown=10001:10001 . /app/estate`) -- so `python -m otto.boot` only
+# resolves the package with the working directory set there; `python -m` adds the current
+# directory to sys.path. Not proven against a running otto.boot yet (the package does not
+# exist on hermes-v2 main as of this branch) -- flagged as a gap, not claimed done.
+#
+# Secrets as files, never pod env (Kyverno secrets-not-from-env-vars, crew#341/crew#284): the
+# ExternalSecret in telegram-secret.yaml is mounted read-only, and the container's own command
+# exports its one file into OTTO_TELEGRAM_BOT_TOKEN before exec'ing the process the fixed
+# contract names -- same shape as deploy/k8s/entrypoint.sh's HERMES_ENV_DIR loop, done inline
+# here because that entrypoint is bypassed (see workingDir note above).
+apiVersion: v1
+kind: Service
+metadata:
+  name: otto-staging
+  namespace: otto-staging
+  labels:
+    backstage.io/kubernetes-id: otto-staging
+    app.kubernetes.io/name: otto-staging
+spec:
+  selector:
+    app: otto-staging
+  ports:
+    - name: http
+      port: 8080
+      targetPort: http
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: otto-staging
+  namespace: otto-staging
+  annotations:
+    # Reloader (platform/reloader) rolls the pod when the vault-sourced Secret changes; the
+    # ConfigMap the same way. `auto` discovers every Secret/ConfigMap this pod mounts, so a new
+    # one added later needs no second annotation here (founder blueprint 2026-08-30, idp#955's
+    # enumerated-list mistake).
+    reloader.stakater.com/auto: "true"
+  labels:
+    app: otto-staging
+    app.kubernetes.io/name: otto-staging
+    app.kubernetes.io/part-of: idp
+spec:
+  # Two pods behind the door (crew#539: a routed surface survives one node). The pod is
+  # stateless -- Telegram delivers each update once to the Service and any replica may answer;
+  # nothing exclusive is held (no volume outlives the pod), so the earlier one-pod Recreate
+  # caution protected nothing and went.
+  replicas: 2
+  selector:
+    matchLabels:
+      app: otto-staging
+  template:
+    metadata:
+      labels:
+        app: otto-staging
+        app.kubernetes.io/name: otto-staging
+    spec:
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: DoNotSchedule
+          labelSelector:
+            matchLabels: { app.kubernetes.io/name: otto-staging }
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 10001
+        runAsGroup: 10001
+        fsGroup: 10001
+        seccompProfile:
+          type: RuntimeDefault
+      containers:
+        - name: otto-boot
+          image: ghcr.io/chidionyema/hermes-agent
+          imagePullPolicy: IfNotPresent
+          workingDir: /app/estate
+          command: ["/bin/sh", "-c"]
+          args:
+            - |
+              set -eu
+              export OTTO_TELEGRAM_BOT_TOKEN="$(cat /run/secrets/otto-staging-telegram/OTTO_TELEGRAM_BOT_TOKEN)"
+              exec python -m otto.boot
+          env:
+            - name: OTTO_BOOT_PORT
+              value: "8080"
+            - name: OTTO_BOOT_CONFIG
+              value: /etc/otto/boot.yaml
+            - name: PYTHONUNBUFFERED
+              value: "1"
+            # LAW 50: every workload emits to the central collector. Same endpoint and mode as
+            # platform/llm/litellm.yaml; otto/obs/config.py reads OTEL_EXPORTER_OTLP_ENDPOINT
+            # directly and refuses to start in otlp mode without it.
+            - name: OTEL_EXPORTER_OTLP_ENDPOINT
+              value: "http://signoz-otel-collector.observability.svc:4318"
+          ports:
+            - containerPort: 8080
+              name: http
+          startupProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            periodSeconds: 10
+            failureThreshold: 30
+          readinessProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            periodSeconds: 30
+            timeoutSeconds: 5
+            failureThreshold: 3
+          livenessProbe:
+            httpGet:
+              path: /healthz
+              port: http
+            periodSeconds: 60
+            timeoutSeconds: 5
+            failureThreshold: 3
+          resources:
+            requests:
+              cpu: 25m
+              memory: 128Mi
+            limits:
+              cpu: 200m
+              memory: 256Mi
+          securityContext:
+            allowPrivilegeEscalation: false
+            privileged: false
+            readOnlyRootFilesystem: true
+            runAsNonRoot: true
+            capabilities:
+              drop: ["ALL"]
+            seccompProfile:
+              type: RuntimeDefault
+          volumeMounts:
+            - name: tmp
+              mountPath: /tmp
+            - name: boot-config
+              mountPath: /etc/otto
+              readOnly: true
+            - name: telegram-token
+              mountPath: /run/secrets/otto-staging-telegram
+              readOnly: true
+      volumes:
+        - name: tmp
+          emptyDir: {}
+        - name: boot-config
+          configMap: { name: otto-staging-boot-config }
+        - name: telegram-token
+          secret: { secretName: otto-staging-telegram }
diff --git a/platform/otto-staging/edge-manners.yaml b/platform/otto-staging/edge-manners.yaml
new file mode 100644
index 000000000..1e9f17cad
--- /dev/null
+++ b/platform/otto-staging/edge-manners.yaml
@@ -0,0 +1,42 @@
+# Edge manners (crew#307 follow-up, founder 2026-08-29: a user saw Traefik's raw "no available
+# server" on the catalogue -- "amateur"). Two of Traefik's built-in middlewares, attached to every
+# rule on this namespace's routes that fronts an application:
+#   friendly-errors  502/503/504 from a backend (pod restarting, namespace rebuilding, node gone)
+#                    are answered by the status page in platform/edge/status-page.yaml, which says
+#                    in plain English that the door is starting and retries itself.
+#   edge-headers     HSTS, nosniff, same-origin framing, referrer policy, and the backend's
+#                    Server / X-Powered-By banners removed, so no door tells a stranger which
+#                    web server or framework sits behind it.
+# A Middleware is an ExtensionRef filter and must live in the route's namespace (Traefik Gateway
+# API reference); the errors service lives in edge, which is why providers.kubernetesCRD
+# .allowCrossNamespace is on in platform/edge/traefik.yaml.
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: friendly-errors
+  namespace: otto-staging
+spec:
+  errors:
+    status: ["502-504"]
+    service:
+      name: status-page
+      namespace: edge
+      port: 80
+    query: "/{status}.html"
+---
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: edge-headers
+  namespace: otto-staging
+spec:
+  headers:
+    stsSeconds: 63072000
+    stsIncludeSubdomains: true
+    stsPreload: true
+    contentTypeNosniff: true
+    customFrameOptionsValue: SAMEORIGIN
+    referrerPolicy: strict-origin-when-cross-origin
+    customResponseHeaders:
+      Server: ""
+      X-Powered-By: ""
diff --git a/platform/otto-staging/httproute.yaml b/platform/otto-staging/httproute.yaml
new file mode 100644
index 000000000..8d6916821
--- /dev/null
+++ b/platform/otto-staging/httproute.yaml
@@ -0,0 +1,78 @@
+# Otto staging's public door. The shared Gateway (prospector-edge, defined in the prospector-main
+# repo, out of scope here) already carries a listener named https-otto for hostname
+# otto.${ESTATE_ZONE} -- platform/hermes-agent/httproute.yaml owns the path /telegram on it today
+# for the production gateway. This route attaches to the SAME listener and hostname (no new
+# listener needed, nothing to change in prospector-main) and claims only the two paths the fixed
+# deploy contract names: POST /telegram-webhook and GET /healthz. Gateway API merges rules from
+# multiple HTTPRoutes bound to one listener/hostname pair; the paths here do not collide with
+# hermes-agent's /telegram, so both routes coexist unchanged.
+#
+# Nothing else on this host is exposed -- no catch-all path, so a request to any other path on
+# otto.${ESTATE_ZONE} falls through to whichever other route (or Traefik's own default) already
+# owns it; this route adds no new surface beyond the two paths the contract names.
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: otto-staging
+  namespace: otto-staging
+  annotations:
+    # The webhook door is authenticated at the gateway, not in the pod (founder edict
+    # 2026-09-02: auth is infrastructure physics; the app stays ignorant of it). The rule
+    # below forwards a POST only when X-Telegram-Bot-Api-Secret-Token exactly matches the
+    # vault-fed value; a missing or wrong header never reaches the pod (GHSA-3vpc-7q5r-276h).
+    # tests/test_front_door_every_route_is_behind_the_one_login.py holds this proof.
+    idp.estate/auth: telegram-webhook-secret-token
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-otto
+  hostnames:
+    - "otto.${ESTATE_ZONE}"
+  rules:
+    - matches:
+        - path:
+            type: Exact
+            value: /telegram-webhook
+          method: POST
+          # Exact header match at the edge: Telegram echoes the secret_token registered at
+          # setWebhook in this header on every delivery. The value is substituted by Flux from
+          # the otto-webhook Secret (platform/otto-staging-secret/, vault entry
+          # otto-staging-telegram property webhook_secret) -- no literal in git (LAW 46).
+          headers:
+            - type: Exact
+              name: X-Telegram-Bot-Api-Secret-Token
+              value: "${OTTO_WEBHOOK_SECRET}"
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: otto-staging
+          port: 8080
+    - matches:
+        - path:
+            type: Exact
+            value: /healthz
+          method: GET
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: otto-staging
+          port: 8080
