+def http_hostnames(src):
+    """Hostnames a layer declares reachable over HTTP: kind: HTTPRoute (spec.hostnames) or
+    kind: Ingress (spec.rules[].host), read only from the *.yaml files sitting directly in the
+    Kustomization's own spec.path -- never typed here as a literal (LAW 46, R36). A layer with
+    neither gets no API: an API entity with no reachable interface is a promise the catalogue
+    cannot back."""
+    hosts = []
