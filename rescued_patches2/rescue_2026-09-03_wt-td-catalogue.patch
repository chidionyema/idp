@@ -0,0 +1,60 @@
+# The org, hand-written and in git. bin/catalog-gen line 18 sets OWNER = "group:default/platform"
+# and stamps it on every entity it emits, but no Group named `platform` was defined in any tracked
+# file -- the only tracked org file was backstage/examples/org.yaml (Group `guests`, User
+# `guest`), so every ownedBy relation in the portal pointed at a group that did not exist. This
+# file is that group, and the company it belongs to.
+---
+# Founder, 2026-08-30 (crew#691): the parent is the AI research and tooling company he registers
+# next week -- "the one everything else falls under". Its name is not chosen yet, so this entity
+# does not guess one. Bytesync Ltd is the consulting arm, not the parent; an earlier session
+# recorded it as the parent and that was corrected. Rename this entity when crew#691 lands.
+apiVersion: backstage.io/v1alpha1
+kind: Group
+metadata:
+  name: parent-company
+  title: "The parent company"
+  description: "The AI research and tooling company every team, product and asset here falls under. Its name is being chosen on crew#691."
+spec:
+  type: organization
+  profile:
+    displayName: "The parent company"
+  children: [platform, commerce, agents]
+---
+apiVersion: backstage.io/v1alpha1
+kind: Group
+metadata:
+  name: platform
+  title: "Platform"
+  description: "Owns the one platform every product runs on: catalogue, routing, traces, identity, secrets, scheduling and CI."
+spec:
+  type: team
+  profile:
+    displayName: "Platform"
+  parent: parent-company
+  children: []
+---
+apiVersion: backstage.io/v1alpha1
+kind: Group
+metadata:
+  name: commerce
+  title: "Commerce"
+  description: "Owns the store: the storefront, its API and everything that takes a customer's money."
+spec:
+  type: team
+  profile:
+    displayName: "Commerce"
+  parent: parent-company
+  children: []
+---
+apiVersion: backstage.io/v1alpha1
+kind: Group
+metadata:
+  name: agents
+  title: "Agents"
+  description: "Owns the agents that act for the founder: Hermes, Otto and the crew that runs them."
+spec:
+  type: team
+  profile:
+    displayName: "Agents"
+  parent: parent-company
+  children: []
diff --git a/backstage/org/kustomization.yaml b/backstage/org/kustomization.yaml
new file mode 100644
