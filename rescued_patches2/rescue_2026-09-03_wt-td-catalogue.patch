+++ b/backstage/org/kustomization.yaml
@@ -0,0 +1,16 @@
+# The org reaches the portal from git through Flux, the same road as backstage/founder (crew#503 CP6)
+# and backstage/platform (crew#459). Without this the Groups would exist only in the developer
+# app-config on a laptop: the deployed pod reads app-config.container.yaml, whose locations are all
+# /estate/* paths fed by ConfigMaps, so a git-only file changes nothing a buyer or the founder sees.
+# The oke overlay projects this ConfigMap at /estate/org/catalog-info.yaml.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+configMapGenerator:
+  - name: org-catalog
+    # crew#503, 2026-08-27 15:05Z: a generated ConfigMap with no namespace fails the backstage Flux
+    # Kustomization ("namespace not specified") and takes its dependents down with it.
+    namespace: backstage
+    files:
+      - catalog-info.yaml
+generatorOptions:
+  disableNameSuffixHash: true
