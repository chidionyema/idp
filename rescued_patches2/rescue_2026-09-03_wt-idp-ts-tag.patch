diff --git a/.github/workflows/estate-inventory.yml b/.github/workflows/estate-inventory.yml
new file mode 100644
index 000000000..964f62988
--- /dev/null
+++ b/.github/workflows/estate-inventory.yml
@@ -0,0 +1,183 @@
+# button: Inventory the estate from its control planes
+# founder: Reads what every cloud, the cluster, GitHub, Cloudflare and Tailscale actually run and grades each thing against what git declares: managed, drifted, orphan or ghost.
+# crew#740 PR 1 (founder blueprint 2026-08-31T11:55Z): the inventory comes from the control-plane
+# APIs, never from git. Read-only on every plane. One table (plane, type, id, declared_in, verdict)
+# published as an OCI artifact next to the estate state document, attached to the run, and put
+# on the state branch the Ops dashboard reads (founder, crew#684: everything is seen from Backstage).
+# A plane that cannot be read is a BLIND line and an UNKNOWN row, never a green zero.
+# Audit mode: this run reports and never fails on a red row; the nightly red gate (E1) is the
+# next PR and turns the strict flag on once every row has been adopted or killed.
+name: estate-inventory
+on:
+  schedule:
+    - cron: "23 2 * * *"
+  workflow_dispatch:
+  pull_request:
+    paths: [".github/workflows/estate-inventory.yml", "bin/idp-inventory", "bin/idp-estate-audit", "platform/inventory/**"]
+permissions:
+  contents: read
+  id-token: write   # traded for the OCI session (discovery search, state bucket, vault reads)
+  packages: write   # the artifact push uses GITHUB_TOKEN, like estate-state
+# contents: read holds for the job that touches the planes; the one write (the state branch the
+# Ops tile reads) is a separate job below with its own scope and nothing but the two table files.
+concurrency:
+  group: estate-inventory
+  cancel-in-progress: false
+jobs:
+  inventory:
+    if: github.actor != 'dependabot[bot]'
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    env:
+      ARTIFACT: oci://ghcr.io/chidionyema/idp/estate-inventory:latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: .github/requirements/oci-cli.txt
+      - uses: opentofu/setup-opentofu@a1320f892987e89d278cc92dc5adc984fb93aca4 # v2.0.2
+        with: { tofu_version: "1.12.6", tofu_wrapper: false }
+      - uses: fluxcd/flux2/action@ed8c5f2c24d57715d08423d3c1a7b0554ceb030e # v2.9.4 -- flux push artifact
+      # turbot/steampipe-action-setup v1.7.0 pages the GitHub releases API with no token and
+      # takes no token input (dist/index.js: no GITHUB_TOKEN), so on a hosted runner it hits the
+      # anonymous rate limit: "Got 403 from api.github.com/repos/turbot/steampipe/releases"
+      # (run 33392031378). The vendor's own install script downloads the release asset by URL;
+      # this does the same with the version and the vendor-published checksum pinned.
+      - name: steampipe (pinned release, checksum verified; plugin install writes the connections)
+        run: |
+          set -euo pipefail
+          v=v2.4.5
+          sum=d68f31a7ec0950fa37e58b47797f9b85823be24464dcb4f6d409fe205612ea3e   # checksums.txt of $v
+          curl -fsSLo "$RUNNER_TEMP/steampipe.tar.gz" "https://github.com/turbot/steampipe/releases/download/$v/steampipe_linux_amd64.tar.gz"
+          echo "$sum  $RUNNER_TEMP/steampipe.tar.gz" | sha256sum -c -
+          sudo tar -xzf "$RUNNER_TEMP/steampipe.tar.gz" -C /usr/local/bin steampipe
+          steampipe plugin install github cloudflare tailscale
+          steampipe plugin list
+      - name: tools
+        run: |
+          set -euo pipefail
+          pip install -q -r .github/requirements/oci-cli.txt
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+      - name: App token (the GitHub plane reads every repository the App is installed on)
+        id: app
+        uses: ./.github/actions/github-app-token
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+          oci_compartment: ${{ vars.OCI_COMPARTMENT_OCID }}
+      # R52: no root in this file. The Cloudflare token is the vault entry the bootstrapper minted;
+      # the Tailscale key is a short-lived access token from the operator's OAuth client in the vault.
+      # Either missing = that plane reads UNKNOWN, never a paste and never a red run.
+      - name: SaaS plane credentials from the vault (masked, never printed)
+        env:
+          OCI_CLI_AUTH: security_token
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+        run: |
+          set -uo pipefail
+          cf=$(bin/idp-cloud secret get cloudflare-api-token 2>/dev/null || true)
+          if [ -n "$cf" ]; then echo "::add-mask::$cf"; echo "CLOUDFLARE_API_TOKEN=$cf" >> "$GITHUB_ENV"
+          else echo "BLIND   inventory  cloudflare: vault entry cloudflare-api-token unread"; fi
+          ts=$(bin/idp-cloud secret get tailscale-operator 2>/dev/null || true)
+          if [ -n "$ts" ]; then
+            tok=$(printf '%s' "$ts" | python3 -c '
+          import json,sys,urllib.request,urllib.parse
+          c=json.load(sys.stdin)
+          body=urllib.parse.urlencode({"client_id":c["client_id"],"client_secret":c["client_secret"]}).encode()
+          r=urllib.request.urlopen(urllib.request.Request("https://api.tailscale.com/api/v2/oauth/token",body),timeout=30)
+          print(json.load(r).get("access_token",""))' 2>/dev/null || true)
+            if [ -n "$tok" ]; then echo "::add-mask::$tok"; echo "TAILSCALE_API_KEY=$tok" >> "$GITHUB_ENV"; echo "TAILSCALE_TAILNET=-" >> "$GITHUB_ENV"
+            else echo "BLIND   inventory  tailscale: the operator client did not mint an access token"; fi
+          else echo "BLIND   inventory  tailscale: vault entry tailscale-operator unread"; fi
+      - name: bin/idp-inventory
+        env:
+          OCI_CLI_AUTH: security_token
+          OCI_TENANCY_OCID: ${{ secrets.OCI_TENANCY_OCID }}
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+          OCI_OS_NAMESPACE: ${{ vars.OCI_OS_NAMESPACE }}
+          GITHUB_TOKEN: ${{ steps.app.outputs.token }}
+          TF_VAR_tenancy_ocid: ${{ secrets.OCI_TENANCY_OCID }}
+          TF_VAR_compartment_ocid: ${{ vars.OCI_COMPARTMENT_OCID }}
+          TF_VAR_region: ${{ vars.OCI_REGION }}
+        run: |
+          set -uo pipefail
+          bin/idp-inventory --planes oci,kubernetes,github,cloudflare,tailscale,mac --out "$RUNNER_TEMP/inventory" || rc=$?
+          echo "exit ${rc:-0}"
+          # exit 2 is every plane BLIND: that IS red, the run has measured nothing
+          [ "${rc:-0}" != 2 ]
+      - name: the table, on the run
+        if: always()
+        run: |
+          set -uo pipefail
+          if [ -f "$RUNNER_TEMP/inventory/inventory.md" ]; then
+            cat "$RUNNER_TEMP/inventory/inventory.md" >> "$GITHUB_STEP_SUMMARY"
+            head -40 "$RUNNER_TEMP/inventory/inventory.md"
+          else
+            echo "no table was written; read the inventory step above"
+          fi
+      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1
+        if: always()
+        with:
+          name: estate-inventory
+          path: |
+            ${{ runner.temp }}/inventory/inventory.md
+            ${{ runner.temp }}/inventory/inventory.json
+          if-no-files-found: warn
+      - name: publish the table next to the estate state document (same door as estate-state)
+        if: github.event_name != 'pull_request'
+        env:
+          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          # Only the table leaves the runner. raw/ holds the whole cluster dump and the tenancy
+          # search; neither is published anywhere.
+          mkdir -p "$RUNNER_TEMP/publish"
+          cp "$RUNNER_TEMP/inventory/inventory.md" "$RUNNER_TEMP/inventory/inventory.json" "$RUNNER_TEMP/publish/"
+          echo "$GITHUB_TOKEN" | flux push artifact "$ARTIFACT" \
+            --path="$RUNNER_TEMP/publish" --source="$GITHUB_SERVER_URL/$GITHUB_REPOSITORY" \
+            --revision="$GITHUB_REF_NAME@sha1:$GITHUB_SHA" --creds "$GITHUB_ACTOR:$GITHUB_TOKEN" >/dev/null
+          echo "ok      inventory  published $ARTIFACT"
+  # The Ops dashboard's "Estate inventory" tile reads docs/inventory.json through the portal's
+  # /estate-state proxy, which serves the state/live-diagram branch. bin/catalog-render force-pushes
+  # that branch on its own schedule and carries these two files forward (it checks them out from
+  # origin before staging), so neither writer drops the other's work.
+  publish-to-state-branch:
+    if: github.event_name != 'pull_request'
+    needs: inventory
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: state/live-diagram
+          fetch-depth: 1
+      - uses: actions/download-artifact@fa0a91b85d4f404e444e00e005971372dc801d16 # v4.1.8
+        with:
+          name: estate-inventory
+          path: ${{ runner.temp }}/inventory
+      - name: put the table on the branch the Ops tile reads
+        run: |
+          set -euo pipefail
+          test -s "$RUNNER_TEMP/inventory/inventory.json"
+          mkdir -p docs
+          cp "$RUNNER_TEMP/inventory/inventory.json" "$RUNNER_TEMP/inventory/inventory.md" docs/
+          git config user.name "estate-inventory"
+          git config user.email "estate-inventory@users.noreply.github.com"
+          git add docs/inventory.json docs/inventory.md
+          if git diff --cached --quiet; then echo "ok      inventory  state branch already holds this table"; exit 0; fi
+          git commit -q -m "docs(inventory): estate inventory from the control planes, run $GITHUB_RUN_ID (crew#740)"
+          git push -q origin HEAD:refs/heads/state/live-diagram
+          echo "ok      inventory  docs/inventory.json on state/live-diagram; the Ops tile reads it within a minute"
diff --git a/.github/workflows/fast-gate.yml b/.github/workflows/fast-gate.yml
index 01b17c919..49d9c181f 100644
--- a/.github/workflows/fast-gate.yml
+++ b/.github/workflows/fast-gate.yml
@@ -25,3 +25,34 @@ jobs:
         run: |
           base=$(git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD~1)
           PYTHON_STRICT_RANGE="${base}...HEAD" .estate-hooks/guards/hooks/python-strict-default
+      # No docs, no merge (founder blueprint 2026-08-31, doc 2026-08-31T0959Z...b276fe41):
+      # a PR that changes code but adds nothing under docs/ fails with "Missing Architectural
+      # Record". Enforced at the git layer, never by scanning chat replies. Graded against the
+      # estate before landing (R: a-new-gate-is-run-against-the-estate-before-it-merges):
+      # PRs opened before 2026-09-01 warn only; bot PRs (image updates, dependabot) are exempt;
+      # a PR body line "Docs-exempt: <reason>" is the LAW 38 escape valve and is printed loud.
+      - name: no docs, no merge
+        if: github.event_name == 'pull_request'
+        env:
+          PR_AUTHOR: ${{ github.event.pull_request.user.login }}
+          PR_CREATED: ${{ github.event.pull_request.created_at }}
+          PR_BODY: ${{ github.event.pull_request.body }}
+        run: |
+          base=$(git merge-base origin/main HEAD)
+          changed=$(git diff --name-only "$base"...HEAD)
+          code=$(printf '%s\n' "$changed" | grep -vE '^docs/|\.md$' || true)
+          docs_added=$(git diff --name-only --diff-filter=AM "$base"...HEAD -- docs/ | wc -l)
+          [ -z "$code" ] && { echo "docs-only change"; exit 0; }
+          case "$PR_AUTHOR" in *'[bot]') echo "bot PR ($PR_AUTHOR): exempt"; exit 0;; esac
+          if printf '%s\n' "$PR_BODY" | grep -qi '^Docs-exempt:'; then
+            printf '%s\n' "$PR_BODY" | grep -i '^Docs-exempt:' | head -1
+            echo "::warning::Docs-exempt claimed; the reason above is on the record."; exit 0
+          fi
+          if [ "$docs_added" -eq 0 ]; then
+            if [ "$(printf '%s' "$PR_CREATED" | cut -c1-10)" \< "2026-09-01" ]; then
+              echo "::warning::Missing Architectural Record (grandfathered: PR opened $PR_CREATED)"; exit 0
+            fi
+            echo "::error::Missing Architectural Record: this PR changes code but adds no file under docs/."
+            exit 1
+          fi
+          echo "code change carries $docs_added docs file(s)"
