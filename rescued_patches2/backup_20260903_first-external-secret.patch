diff --git a/platform/prospector/cloudflare-external-secret.yaml b/platform/prospector/cloudflare-external-secret.yaml
new file mode 100644
index 000000000..2ca904516
--- /dev/null
+++ b/platform/prospector/cloudflare-external-secret.yaml
@@ -0,0 +1,20 @@
+# Cloudflare API token for external-dns and the edge, pulled from OCI Vault by the node's
+# instance principal (ClusterSecretStore oci-vault, platform/secret-store). Replaces
+# cloudflare.sops.yaml: no age key in the cluster is needed to produce this Secret.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: cloudflare-api-token
+  namespace: edge
+spec:
+  refreshInterval: 1h
+  secretStoreRef:
+    kind: ClusterSecretStore
+    name: oci-vault
+  target:
+    name: cloudflare-api-token
+    creationPolicy: Owner
+  data:
+    - secretKey: CF_API_TOKEN
+      remoteRef:
+        key: cloudflare-api-token
