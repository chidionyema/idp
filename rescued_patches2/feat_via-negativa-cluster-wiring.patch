+metadata:
+  name: via-negativa
+  namespace: flux-system
+spec:
+  interval: 10m
+  dependsOn:
+    - name: secret-store
+    - name: llm
+    - name: estate-db
+  sourceRef:
+    kind: GitRepository
+    name: flux-system
+  path: ./platform/via-negativa
+  prune: true
+  wait: true
+  timeout: 10m
+---
 # crew#839: every namespace's request defaults and its ceiling, generated in one pass by
 # bin/idp-ns-fence-gen from platform/ns-fences/allowances.yaml. A LimitRange lands beside every
 # quota in the same file, because a quota that counts requests.cpu refuses every pod that declares
diff --git a/platform/estate-db/cluster/databases.yaml b/platform/estate-db/cluster/databases.yaml
index 35e2c6302..39581bf15 100644
--- a/platform/estate-db/cluster/databases.yaml
+++ b/platform/estate-db/cluster/databases.yaml
@@ -185,6 +185,31 @@ spec:
   owner: lago
   ensure: present
 ---
+# The via-negativa engine's RCA ledger (Primitive D). Brand new, like lago and aevum-evidence
+# above -- there is no copy Job for it because the layer has never run and there is nothing to
+# move; its password is minted straight into this entry by bin/idp-estate-seed.
+#
+# bin/rca_worker/schema.sql embeds a rules.embedding vector(384) column (same reasoning as the
+# hindsight and otto-gateway entries above): pgvector is not a trusted extension, so the
+# `via_negativa` role cannot CREATE EXTENSION it however it is granted -- only a superuser can.
+# The operator issues the CREATE here; the worker's own `CREATE EXTENSION IF NOT EXISTS vector`
+# on every start then finds it present and does nothing, a notice rather than a permission error.
+apiVersion: postgresql.cnpg.io/v1
+kind: Database
+metadata:
+  name: via-negativa
+  namespace: estate-db
+spec:
+  cluster:
+    name: estate
+  name: via_negativa
+  owner: via_negativa
+  ensure: present
+  extensions:
+    - name: vector
+      ensure: present
+      schema: public
+---
