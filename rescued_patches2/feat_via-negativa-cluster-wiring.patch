diff --git a/platform/image-automation/via-negativa.yaml b/platform/image-automation/via-negativa.yaml
new file mode 100644
index 000000000..360b7a6a9
--- /dev/null
+++ b/platform/image-automation/via-negativa.yaml
@@ -0,0 +1,60 @@
+# The via-negativa engine's two images roll on every main build, the same wiring
+# router-events.yaml and epistemic-ingest.yaml use. build-multiarch pushes
+# ghcr.io/chidionyema/negative-constraints-proxy:main-<run>-<sha> and
+# ghcr.io/chidionyema/rca_worker:main-<run>-<sha>; the policy picks the highest run and the one
+# ImageUpdateAutomation (backstage.yaml, path ./) writes it into
+# platform/via-negativa/kustomization.yaml on flux/image-updates. Two automations on one push
+# branch collide (crew#406), so there is exactly one, shared by every image. The ImagePolicy
+# object here is named via-negativa-rca (not rca_worker -- Kubernetes names refuse the
+# underscore) while spec.image still names the real ghcr repository.
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: negative-constraints-proxy
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/negative-constraints-proxy
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: negative-constraints-proxy
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: negative-constraints-proxy
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: via-negativa-rca
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/rca_worker
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: via-negativa-rca
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: via-negativa-rca
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
diff --git a/platform/via-negativa/external-secret.yaml b/platform/via-negativa/external-secret.yaml
new file mode 100644
index 000000000..df34c24f4
--- /dev/null
+++ b/platform/via-negativa/external-secret.yaml
@@ -0,0 +1,41 @@
+# The RCA worker's Postgres role password: bin/idp-estate-seed mints it straight into the
+# estate-db vault entry (it is a brand new consumer, same as lago and aevum-evidence -- no
+# legacy server, so no copy Job and no platform/estate-db/migrate row), and
+# platform/estate-db/cluster/secrets.yaml publishes the same value into estate-db so
+# CloudNativePG can mint the `via_negativa` role from it. This is that same value again, here,
+# because the RCA worker's own container composes VN_LEDGER_DSN from it (same shape as
+# platform/llm/litellm.yaml's DATABASE_URL) -- one value, two namespaces, never typed.
+#
+# Mounted as a file, never as pod env (Kyverno secrets-not-from-env-vars).
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-db
+  namespace: via-negativa
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: via-negativa-db
+    creationPolicy: Owner
+  data:
+    - secretKey: DB_PASSWORD
+      remoteRef: { key: estate-db, property: via-negativa-password }
+---
+# The RCA worker's own router key (LAW 34: the router is the only place a model credential
+# exists). Minted by bin/idp-estate-seed's router-key plan, scoped to `groq` alone -- Primitive
+# B's regex pre-filter is the free path (bin/rca_worker/worker.py, regex_extract_constraint());
+# this key is only ever reached on the fallback, so it is deliberately the cheapest lane
+# (llm/config.yaml's `groq` row), never minimax or gemini.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-router
+  namespace: via-negativa
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: via-negativa-router, creationPolicy: Owner }
+  data:
+    - secretKey: LITELLM_API_KEY
+      remoteRef: { key: via-negativa, property: LITELLM_API_KEY }
diff --git a/platform/via-negativa/kustomization.yaml b/platform/via-negativa/kustomization.yaml
new file mode 100644
index 000000000..0768125ed
--- /dev/null
+++ b/platform/via-negativa/kustomization.yaml
@@ -0,0 +1,25 @@
+# The via-negativa engine: Primitive A/C's proxy, Primitive D's RCA worker, and their own
+# dedicated Redis and Postgres row -- plain Kustomize, the same shape every other first-party
+# service in platform/ uses (platform/llm, platform/epistemic-fabric, platform/router-events).
+# No Helm chart: this repo has none for first-party code (HelmRelease is reserved for
+# third-party infra, e.g. cert-manager).
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+namespace: via-negativa
+resources:
+  - namespace.yaml
+  - external-secret.yaml
+  - redis.yaml
+  - proxy.yaml
+  - rca.yaml
+images:
+  # Neither image has been built yet -- this PR is what makes build-multiarch discover
+  # `negative-constraints-proxy` and `rca_worker` for the first time (bin/dockerfiles).
+  # newTag is git's own null object id, not a real commit; the one ImageUpdateAutomation
+  # (platform/image-automation/backstage.yaml) overwrites these two lines with the real
+  # main-<run>-<sha> the first time CI pushes each image, the same way it already does for
+  # router-events and epistemic-ingest.
+  - name: ghcr.io/chidionyema/negative-constraints-proxy
+    newTag: main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:negative-constraints-proxy:tag"}
+  - name: ghcr.io/chidionyema/rca_worker
+    newTag: main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:via-negativa-rca:tag"}
diff --git a/platform/via-negativa/namespace.yaml b/platform/via-negativa/namespace.yaml
new file mode 100644
index 000000000..73e57d17f
--- /dev/null
+++ b/platform/via-negativa/namespace.yaml
@@ -0,0 +1,20 @@
+# The via-negativa engine (bin/negative-constraints-proxy, bin/rca_worker): an interception
+# proxy that pre-flight-rejects banned tool-call signatures, an async worker that turns a real
+# agent failure into a negative constraint, and a Postgres ledger of what was learned. Own
+# namespace, own Redis (platform/llm/redis.yaml's own-dedicated-cache pattern, not a shared
+# store per THE HEADLINE), own row on the one Postgres (platform/estate-db).
+#
+# Restricted profile, default-deny NetworkPolicy + ResourceQuota + LimitRange from
+# platform/ns-fences (bin/idp-ns-fence-gen, allowances.yaml) -- not hand-written here, same
+# deferred-until-measured state platform/epistemic-fabric/namespace.yaml is in.
+apiVersion: v1
+kind: Namespace
+metadata:
+  annotations:
+    # Never garbage-collected by Flux (idp#648): a namespace dropped from git stays, with
+    # everything in it, and the next reconcile reads as a portability break.
+    kustomize.toolkit.fluxcd.io/prune: disabled
+  name: via-negativa
+  labels:
+    app.kubernetes.io/part-of: idp
+    pod-security.kubernetes.io/enforce: restricted
diff --git a/platform/via-negativa/proxy.yaml b/platform/via-negativa/proxy.yaml
new file mode 100644
index 000000000..39b20f7c2
--- /dev/null
+++ b/platform/via-negativa/proxy.yaml
@@ -0,0 +1,75 @@
+# Primitive A (interception proxy: banned-signature pre-flight rejection, the deadlock breaker)
+# and the read side of Primitive C (top-constraints prompt injection). Sits in front of the
+# router, so every agent's tool calls pass through it before litellm ever sees them.
+apiVersion: v1
+kind: Service
+metadata:
+  name: via-negativa-proxy
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: via-negativa }
+spec:
+  type: ClusterIP
+  selector: { app.kubernetes.io/name: via-negativa-proxy }
+  ports:
+    - { name: http, port: 80, targetPort: 8080 }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-proxy
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 2
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-proxy }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-proxy, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: proxy
+          image: ghcr.io/chidionyema/negative-constraints-proxy:main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:negative-constraints-proxy:tag"}
+          # distroless/static: no shell to compose REDIS_URL before exec, and Kyverno
+          # secrets-not-from-env-vars refuses the password as pod env either way. The redis
+          # password rides a mounted file instead; REDIS_PASSWORD_FILE tells the binary itself
+          # where to read it and fold it into REDIS_URL (main.go, resolveRedisURL()).
+          ports:
+            - { name: http, containerPort: 8080 }
+          env:
+            - { name: LISTEN_ADDR, value: ":8080" }
+            - { name: UPSTREAM_URL, value: "http://litellm.llm.svc.cluster.local:4000" }
+            - { name: REDIS_URL, value: "redis://via-negativa-redis.via-negativa.svc.cluster.local:6379" }
+            - { name: REDIS_PASSWORD_FILE, value: "/run/secrets/via-negativa/redis/REDIS_PASSWORD" }
+            - { name: REDIS_KEY, value: "via_negativa:banned_signatures" }
+            - { name: TOP_CONSTRAINTS_KEY, value: "via_negativa:top_constraints" }
+            - { name: TOP_CONSTRAINTS_N, value: "5" }
+          readinessProbe:
+            httpGet: { path: /healthz, port: 8080 }
+            initialDelaySeconds: 2
+          livenessProbe:
+            httpGet: { path: /healthz, port: 8080 }
+            initialDelaySeconds: 5
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          resources:
+            requests: { cpu: 100m, memory: 64Mi }
+            limits: { cpu: 500m, memory: 128Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/via-negativa/rca.yaml b/platform/via-negativa/rca.yaml
new file mode 100644
index 000000000..eeecb340b
--- /dev/null
+++ b/platform/via-negativa/rca.yaml
@@ -0,0 +1,88 @@
+# Primitive D: the async RCA worker. Consumes real agent failures off Redis Streams, extracts a
+# negative constraint (Primitive B's regex pre-filter first, an LLM-schema-enforced fallback
+# second), writes it to the Postgres ledger and ranks it into the top-constraints set the proxy
+# reads (Primitive C's write side).
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-rca
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-rca, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 1
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-rca }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-rca, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        runAsGroup: 65532
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: rca
+          image: ghcr.io/chidionyema/rca_worker:main-0-0000000000000000000000000000000000000000 # {"$imagepolicy": "flux-system:via-negativa-rca:tag"}
+          env:
+            - { name: REDIS_URL, value: "redis://via-negativa-redis.via-negativa.svc.cluster.local:6379" }
+            - { name: REDIS_PASSWORD_FILE, value: "/run/secrets/via-negativa/redis/REDIS_PASSWORD" }
+            # No password here -- estate-rw is the one Postgres (platform/estate-db); the
+            # worker itself folds VN_LEDGER_DSN_PASSWORD_FILE's contents in
+            # (worker.py, _with_password_from_file()), the same convention the proxy's
+            # REDIS_PASSWORD_FILE uses (Kyverno secrets-not-from-env-vars).
+            - { name: VN_LEDGER_DSN, value: "postgresql://via_negativa@estate-rw.estate-db.svc.cluster.local:5432/via_negativa" }
+            - { name: VN_LEDGER_DSN_PASSWORD_FILE, value: "/run/secrets/via-negativa/db/DB_PASSWORD" }
+            # Fallback only -- Primitive B's regex pre-filter is the free path and satisfies
+            # most failures without ever reaching this. `groq` is the cheapest lane
+            # (platform/llm/config.yaml), matching the router key's own scope below.
+            - { name: VN_LLM_MODEL, value: "groq" }
+            - { name: VN_FAILURE_STREAM, value: "via_negativa:failures" }
+            - { name: VN_CONSUMER_GROUP, value: "rca-workers" }
+            - { name: VN_DLQ_STREAM, value: "via_negativa:failures:dlq" }
+            - { name: VN_BANNED_SET, value: "via_negativa:banned_signatures" }
+            - { name: VN_TOP_CONSTRAINTS_KEY, value: "via_negativa:top_constraints" }
+            - { name: VN_MAX_ATTEMPTS, value: "3" }
+            - { name: OPENAI_BASE_URL, value: "http://litellm.llm.svc.cluster.local:4000/v1" }
+            - { name: OPENAI_API_KEY_FILE, value: "/run/secrets/via-negativa/router/LITELLM_API_KEY" }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          # No HTTP port to probe -- this is a Redis Streams consumer, not a server. worker.py
+          # touches /tmp/via-negativa-heartbeat once per pass through its consume loop (at most
+          # every 2s); --healthcheck exits 0 only when that file is fresh, so a stuck event loop
+          # is caught same as a dead process. Precedent: platform/dagster/dagster.yaml's own
+          # `dagster-daemon liveness-check` exec probe, the same shape for the same reason.
+          livenessProbe:
+            exec: { command: ["python", "worker.py", "--healthcheck"] }
+            initialDelaySeconds: 30
+            periodSeconds: 20
+            timeoutSeconds: 10
+            failureThreshold: 3
+          readinessProbe:
+            exec: { command: ["python", "worker.py", "--healthcheck"] }
+            initialDelaySeconds: 10
+            periodSeconds: 15
+            timeoutSeconds: 10
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 100m, memory: 128Mi }
+            limits: { cpu: 500m, memory: 256Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: db-secret, mountPath: /run/secrets/via-negativa/db, readOnly: true }
+            - { name: router-secret, mountPath: /run/secrets/via-negativa/router, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: db-secret
+          secret: { secretName: via-negativa-db }
+        - name: router-secret
+          secret: { secretName: via-negativa-router }
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/via-negativa/redis.yaml b/platform/via-negativa/redis.yaml
new file mode 100644
index 000000000..9cdf40600
--- /dev/null
+++ b/platform/via-negativa/redis.yaml
@@ -0,0 +1,114 @@
+# via-negativa's own memory: the proxy's banned-signature set and top-constraints ranking
+# (Primitives A and C) and the RCA worker's failure stream (Primitive D). One dedicated Redis,
+# not the shared llm cache -- THE HEADLINE's "never add a second store" is about not building a
+# second kind of store for one estate, not about sharing one cache instance across unrelated
+# components; the shape here is a direct copy of platform/llm/redis.yaml.
+#
+# The password is minted inside the cluster by the secret machinery's own password generator --
+# no vault entry, no console, no person ever sees it. refreshInterval 0h: minted once at
+# creation and stable, so the proxy and the worker can never disagree about it.
+apiVersion: generators.external-secrets.io/v1alpha1
+kind: Password
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+spec:
+  length: 42
+  digits: 10
+  symbols: 0
+  symbolCharacters: ""
+  noUpper: false
+  allowRepeat: true
+---
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+spec:
+  refreshInterval: 0h
+  target: { name: via-negativa-redis, creationPolicy: Owner }
+  dataFrom:
+    - sourceRef:
+        generatorRef:
+          apiVersion: generators.external-secrets.io/v1alpha1
+          kind: Password
+          name: via-negativa-redis
+      rewrite:
+        - transform: { template: "REDIS_PASSWORD" }
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: via-negativa }
+spec:
+  type: ClusterIP
+  selector: { app.kubernetes.io/name: via-negativa-redis }
+  ports:
+    - { name: redis, port: 6379, targetPort: 6379 }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: via-negativa-redis
+  namespace: via-negativa
+  labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp }
+  annotations:
+    reloader.stakater.com/auto: "true"
+spec:
+  replicas: 1
+  # One memory: two caches behind one name would briefly disagree, so replace, never overlap.
+  # Losing it for the seconds of a replace is safe -- the proxy fails open (patternStore.match
+  # sees an empty set) and the worker's XREADGROUP simply resumes from its consumer group
+  # position once the store is back.
+  strategy: { type: Recreate }
+  selector:
+    matchLabels: { app.kubernetes.io/name: via-negativa-redis }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: via-negativa-redis, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 999   # redis uid in the alpine image
+        runAsGroup: 999
+        fsGroup: 999
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: redis
+          image: docker.io/library/redis:7.4-alpine
+          command: ["/bin/sh", "-c"]
+          args:
+            - exec redis-server --requirepass "$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)" --maxmemory 192mb --maxmemory-policy allkeys-lru --save "" --appendonly no
+          ports:
+            - { containerPort: 6379, name: redis }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            exec:
+              command: ["/bin/sh", "-c", "REDISCLI_AUTH=\"$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)\" redis-cli ping"]
+            periodSeconds: 10
+          livenessProbe:
+            exec:
+              command: ["/bin/sh", "-c", "REDISCLI_AUTH=\"$(cat /run/secrets/via-negativa/redis/REDIS_PASSWORD)\" redis-cli ping"]
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 25m, memory: 64Mi }
+            limits: { cpu: 250m, memory: 256Mi }
+          volumeMounts:
+            - { name: redis-secret, mountPath: /run/secrets/via-negativa/redis, readOnly: true }
+            - { name: data, mountPath: /data }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: redis-secret
+          secret: { secretName: via-negativa-redis }
+        - name: data
+          emptyDir: { sizeLimit: 256Mi }
+        - name: tmp
+          emptyDir: {}
diff --git a/tests/test_via_negativa_engine.py b/tests/test_via_negativa_engine.py
new file mode 100644
index 000000000..0db3b818f
--- /dev/null
+++ b/tests/test_via_negativa_engine.py
@@ -0,0 +1,168 @@
+"""Acceptance tests for the via-negativa engine.
+
+Per the founder 2026-09-13 spec: build the four primitives
+(A: Go proxy, B: regex hook, C: injection, D: async RCA worker)
+and prove they work end-to-end against the founder's pasted code.
+"""
+# ruff: noqa: S101
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import os
+import pathlib
+import shutil
+import subprocess
+import time
+
+import pytest
+
+REPO_ROOT = pathlib.Path(__file__).resolve().parents[1]
+PROXY_DIR = REPO_ROOT / "bin" / "negative-constraints-proxy"
+WORKER_DIR = REPO_ROOT / "bin" / "rca_worker"
+GO_BIN = shutil.which("go")
+
+
+@pytest.mark.skipif(GO_BIN is None, reason="go is not installed")
+def test_go_proxy_compiles() -> None:
+    """Primitive A: the Go interception sidecar builds cleanly."""
+    result = subprocess.run(  # noqa: S603 - fixed argv built in this file, no shell
+        [GO_BIN, "build", "-o", "/tmp/via-negativa-proxy-test", "."],  # noqa: S108
+        cwd=str(PROXY_DIR),
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+    assert result.returncode == 0, f"go build failed:\n{result.stderr}\n{result.stdout}"
