+    module = HOME_MODULE.read_text()
+    layout = (
+        ROOT / "backstage/packages/app/src/modules/home/homeLayout.tsx"
+    ).read_text()
+    code = lambda src: re.sub(r"//.*", "", src)
+    assert not re.search(r"path:\s*'/'", module), (
