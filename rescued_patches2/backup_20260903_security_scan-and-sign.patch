+          # A glob and a case guard rather than `ls | grep`. The build job writes
+          # one empty file per architecture named for its digest, so the filter
+          # is "64 hex characters"; parsing ls to get there breaks on any name
+          # that is not one (shellcheck SC2010).
+          digests=""
+          for f in *; do
+            case "$f" in *[!0-9a-f]*) continue ;; esac
+            [ "${#f}" -eq 64 ] || continue
+            digests="$digests $image@sha256:$f"
+          done
+          n=$(echo "$digests" | wc -w)
