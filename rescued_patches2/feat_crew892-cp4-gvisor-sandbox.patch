+# 2026-09-15T00:00:00Z unless explicitly renewed.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+namespace: gvisor-runsc
+resources:
+  - namespace.yaml
+  - daemonset.yaml
