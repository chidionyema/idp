 defs_validate() { ( cd "$(dirname "$1")" && DAGSTER_HOME="$(mktemp -d)" "$MPY" -m dagster definitions validate -f "$(basename "$1")" ) >/dev/null 2>&1; }
 # 6a. main's verdict, against the live workflows rather than the fixtures (crew#865). On 2026-09-05
 #     nine of twelve ci runs on main were cancelled by the commit after them, so the one branch the
@@ -544,6 +556,32 @@ else
   say "FAIL  denyflow calico deny-feed cannot tell a denied flow from no evidence (platform/calico README)"; fail=1
 fi
 
+# 6e. crew#892 CP4 (zero-trust-boundary.md step 5 one-run / work order item 12): the isolation
+#     break is caught in the pull request, not discovered on the cluster. Proved two ways in one
+#     run with the fixture pair: a Pod that asks to run in the otto-gvisor-sandbox cell without
+#     naming `runtimeClassName: gvisor` (or that is privileged, host-networked, or mounts a
+#     hostPath) must be refused, while a conforming cell Pod must be admitted. This grades the
+#     parsed object, mirroring the Kyverno admission policy that refuses the same shape at
+#     admission, so the repo half and the cluster half cannot drift apart.
+if gvisor_cell_gate "$IDP/tests/fixtures/gvisor-cell/good.yaml" \
+   && ! gvisor_cell_gate "$IDP/tests/fixtures/gvisor-cell/bad.yaml"; then
+  say "ok    gvisor   a cell Pod without the runtime class (or privileged, host-networked, hostPath) is refused; the conforming cell Pod passes"
+else
+  say "FAIL  gvisor   bin/gvisor-cell-gate cannot tell a gVisor cell boundary break from a conforming Pod (ZT step 5)"; fail=1
+fi
+
+# 6f. crew#892 CP4 (zero-trust-boundary.md step 6): the cell fence is default-deny with the
+#     gateway the one declared app route; a fence that lets the untrusted-code cell reach the
+#     internet is the isolation break, caught here in the pull request. Proved two ways in one run
+#     with the fixture pair: an allowances file that grants the cell egress_internet is refused,
+#     the default-deny cell fence is admitted. Grades the declarations the generator fans out.
+if gvisor_cell_fence_gate "$IDP/tests/fixtures/gvisor-cell-fence/good.yaml" \
+   && ! gvisor_cell_fence_gate "$IDP/tests/fixtures/gvisor-cell-fence/bad.yaml"; then
+  say "ok    gvrfence a gVisor-cell fence granting internet egress is refused; the default-deny cell fence passes"
+else
+  say "FAIL  gvrfence bin/gvisor-cell-fence-gate cannot tell a cell fence that leaks to the internet from the default-deny fence (ZT step 6)"; fail=1
+fi
+
 # 6b. The namespace fence, against the estate rather than against its own fixtures (crew#839).
 #     Until now ns_fence_gate ran only inside the loop above, on tests/fixtures/ns-fence/*.yaml,
