@@ -0,0 +1,25 @@
+# The concierge's public origin, pulled from OCI Vault by the node's instance principal
+# (ClusterSecretStore estate-vault, platform/secret-store) -- same store, same pattern as
+# platform/dns/cloudflare-external-secret.yaml. NOT human-vault: nothing here was pasted by a
+# person for a person to see again. bin/idp-bootstrap-concierge-tunnel is the only writer of the
+# `concierge-tunnel` vault entry (root-trust.md, crew#832): a Cloudflare Tunnel minted under the
+# estate's one Cloudflare root (R52), bound to a stable hostname on ESTATE_ZONE.
+#
+# The concierge itself is Mac-hosted, not a pod (mums-concierge/docs/DEPLOYMENT.md) -- this
+# namespace carries no workload for it, same as human-twilio above. What lands here is read by the
+# machine's own `kubectl`, the same way mums_concierge/bootstrap.py already reads human-twilio.
+# One JSON object of KEY: value (PUBLIC_SERVER_URL, PUBLIC_WSS_URL, TUNNEL_TOKEN, TUNNEL_ID),
+# through ClusterSecretStore estate-vault -- same shape as platform/prospector/engine-external-secret.yaml.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: concierge-tunnel
+  namespace: concierge
+spec:
+  refreshInterval: 10m
+  secretStoreRef:
+    kind: ClusterSecretStore
+    name: estate-vault
+  target: { name: concierge-tunnel, creationPolicy: Owner }
+  dataFrom:
+    - extract: { key: concierge-tunnel }
