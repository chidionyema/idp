@@ -0,0 +1,159 @@
+#!/usr/bin/env python3
+"""estate-flux-dag: the deploy-time map, drawn from what Flux itself will honour.
+
+The estate's spec: the map must be a deterministic byproduct of the GitOps engine, never
+hand-drawn (R29, crew#236 row 2), because a hand-drawn map is a claim with no receipt and it
+desyncs the moment a `dependsOn:` line changes and nobody updates a diagram. This estate's
+GitOps engine is Flux (`clusters/oke/flux-system/gotk-components.yaml`); this script is the
+only reader of the `dependsOn:` edges Flux honours BEFORE a reconcile (`bin/estate-twin-runtime`
+G4 comment: "the estate's real ordering, declared by its own GitOps controller, not inferred by
+us"). It parses every Kustomization/HelmRelease across clusters/ and platform/ -- the same
+files Flux itself applies -- and writes one Graphviz `.dot` DAG. It collects nothing live, so
+it can never disagree with git; `--check` fails the moment the committed `.dot` drifts from
+what these manifests now declare.
+
+    estate-flux-dag                 render clusters/ + platform/ -> docs/architecture/flux-deploy-map.dot
+    estate-flux-dag --root R --out F   other paths (the tests use a fixture tree)
+    estate-flux-dag --check         exit 1 when the file on disk is not what the manifests say
+
+Node id `flux:{kind}:{namespace}/{name}` matches `bin/estate-twin-runtime`'s own identity rule
+(same G4 comment) so this git-declared graph and the live-receipt-derived one in
+`catalog/estate.db` name the same object the same way -- a future cross-check needs no
+translation table. A `dependsOn` entry with no matching node in this tree (a target defined
+elsewhere, or misspelled) still gets a node, drawn dashed, so a broken reference is visible on
+the map rather than silently absent from it.
+
+Deterministic: node and edge order is sorted before rendering, so two sweeps of one working
+tree that changed nothing agree byte for byte -- the same property every generator in this
+estate must hold (AGENTS.md, unconditional in `bin/idp-ci`).
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+from pathlib import Path
+
+import yaml
+
+ROOT = Path(__file__).resolve().parent.parent
+OUT = ROOT / "docs" / "architecture" / "flux-deploy-map.dot"
+SCAN_DIRS = ("clusters", "platform")
+FLUX_KINDS = ("Kustomization", "HelmRelease")
+
+
+def _iter_flux_objects(root: Path):
+    for scan in SCAN_DIRS:
+        base = root / scan
+        if not base.is_dir():
+            continue
+        for fp in sorted(base.rglob("*.yaml")):
+            if "/.terraform/" in str(fp):
+                continue
+            try:
+                docs = list(yaml.safe_load_all(fp.read_text(encoding="utf-8")))
+            except Exception as e:
+                # Unparseable YAML under clusters/ or platform/ is a broken manifest, not an
+                # absent one -- printed so it is visible on the map's own render, never a
+                # silently-clean skip (the estate's own recurring defect class).
+                print(f"estate-flux-dag: {fp} did not parse: {e}", file=sys.stderr)
+                continue
+            for d in docs:
+                if not isinstance(d, dict):
+                    continue
+                kind = d.get("kind")
+                api = d.get("apiVersion") or ""
+                if kind not in FLUX_KINDS or "fluxcd.io" not in api:
+                    continue
+                yield fp, d
+
+
+def build_graph(root: Path) -> tuple[set[str], list[tuple[str, str]]]:
+    """Returns (declared node ids, sorted unique edges). Pure function of the manifests on disk.
+
+    A `dependsOn` target with no manifest doc of its own is not a node here -- it is drawn as
+    a dashed reference by `render`, kept separate so "declared" never silently absorbs "only
+    referenced" (that distinction is the whole point of drawing it dashed).
+    """
+    declared: set[str] = set()
+    edges: set[tuple[str, str]] = set()
+    for _fp, d in _iter_flux_objects(root):
+        kind = d["kind"]
+        md = d.get("metadata") or {}
+        name = md.get("name")
+        if not name:
+            continue
+        ns = md.get("namespace") or "flux-system"
+        nid = f"flux:{kind}:{ns}/{name}"
+        declared.add(nid)
+        for dep in (d.get("spec") or {}).get("dependsOn") or []:
+            dname = dep.get("name")
+            if not dname:
+                continue
+            dns = dep.get("namespace") or ns
+            edges.add((nid, f"flux:Kustomization:{dns}/{dname}"))
+    return declared, sorted(edges)
+
+
+def dot_id(node_id: str) -> str:
+    return '"' + node_id.replace('"', '\\"') + '"'
+
+
+def render(root: Path) -> str:
+    declared, edges = build_graph(root)
+    referenced_only = sorted({t for _, t in edges} - declared)
+    lines = [
+        "// GENERATED by bin/estate-flux-dag from clusters/ and platform/. Do not edit: the",
+        "// next render overwrites it. `bin/estate-flux-dag --check` fails when this file and",
+        "// the manifests disagree (R29: a hand-drawn map is deleted).",
+        "digraph flux_deploy_map {",
+        "  rankdir=LR;",
+    ]
+    for nid in sorted(declared):
+        lines.append(f"  {dot_id(nid)};")
+    for nid in referenced_only:
+        lines.append(
+            f'  {dot_id(nid)} [style=dashed,label="{nid}\\n(depended on, not declared in this tree)"];'
+        )
+    for src, dst in edges:
+        lines.append(f"  {dot_id(src)} -> {dot_id(dst)};")
+    lines.append("}")
+    lines.append("")
+    return "\n".join(lines)
+
+
+def main(argv: list[str]) -> int:
+    ap = argparse.ArgumentParser(add_help=True)
+    ap.add_argument("--root", default=str(ROOT))
+    ap.add_argument("--out", default=str(OUT))
+    ap.add_argument(
+        "--check",
+        action="store_true",
+        help="exit 1 when the file on disk differs from the manifests",
+    )
+    args = ap.parse_args(argv)
+    root, out = Path(args.root), Path(args.out)
+    if not (root / "clusters").is_dir() and not (root / "platform").is_dir():
+        print(
+            f"BLIND estate-flux-dag: no clusters/ or platform/ under {root}",
+            file=sys.stderr,
+        )
+        return 3
+    page = render(root)
+    if args.check:
+        if out.is_file() and out.read_text(encoding="utf-8") == page:
+            print(f"ok    estate-flux-dag: {out} matches clusters/ + platform/")
+            return 0
+        print(
+            f"FAIL  estate-flux-dag: {out} is not what clusters/ + platform/ declare; run bin/estate-flux-dag"
+        )
+        return 1
+    out.parent.mkdir(parents=True, exist_ok=True)
+    out.write_text(page, encoding="utf-8")
+    nodes, edges = build_graph(root)
+    print(f"estate-flux-dag: {len(nodes)} nodes, {len(edges)} edges -> {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
