+        tun_tok_id = tuntok_result["result"]["id"]
+        if not verify(tun):
+            fail("verify", "tunnel-mgmt token does not verify")
+        say("ok", "mint", f"tunnel-management token minted (account {account_id}, Cloudflare Tunnel Read+Write)")
+
+        # 5. the tunnel itself: a remotely-managed tunnel (config_src=cloudflare) so `cloudflared
+        #    tunnel run --token ...` needs no cert.pem/credentials.json on the Mac.
+        existing_result = cf(tun, "GET", f"/accounts/{account_id}/cfd_tunnel?name=concierge&is_deleted=false")
+        existing = (existing_result.get("result") or [None])[0]
+        if existing:
+            tunnel_id = existing["id"]
+            say("ok", "tunnel", f"reusing existing tunnel 'concierge' ({tunnel_id})")
+        else:
+            created = cf(tun, "POST", f"/accounts/{account_id}/cfd_tunnel", {"name": "concierge", "config_src": "cloudflare"})
+            if not created.get("success"):
+                fail("tunnel", f"POST /cfd_tunnel refused: {created.get('errors')}")
+            tunnel_id = created["result"]["id"]
+            say("ok", "tunnel", f"tunnel 'concierge' created ({tunnel_id})")
+        token_result = cf(tun, "GET", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/token")
+        tunnel_token = token_result.get("result") or ""
+        if not tunnel_token:
+            fail("tunnel", f"no token returned for tunnel {tunnel_id}")
+
+        # 6. the public hostname route -> the concierge's own port.
+        ingress = {"config": {"ingress": [{"hostname": hostname, "service": "http://127.0.0.1:8000"}, {"service": "http_status:404"}]}}
+        if not cf(tun, "PUT", f"/accounts/{account_id}/cfd_tunnel/{tunnel_id}/configurations", ingress).get("success"):
+            fail("tunnel", "ingress configuration refused")
+        say("ok", "tunnel", f"public hostname {hostname} routed to 127.0.0.1:8000")
+
+        # 7. the DNS record, with the estate's EXISTING DNS-edit token (never a second one) --
+        #    LAW 15, prove it reads before it's trusted to write.
+        if not cf(dns, "GET", f"/zones/{zone_id}/dns_records?per_page=1").get("success"):
+            fail("verify", f"cloudflare-api-token cannot read {zone} records")
+        rec_result = cf(dns, "GET", f"/zones/{zone_id}/dns_records?type=CNAME&name={hostname}")
+        rec = (rec_result.get("result") or [None])[0]
+        body = {"type": "CNAME", "name": hostname, "content": f"{tunnel_id}.cfargotunnel.com", "proxied": True, "ttl": 1}
+        if rec:
+            if not cf(dns, "PUT", f"/zones/{zone_id}/dns_records/{rec['id']}", body).get("success"):
+                fail("dns", f"CNAME update for {hostname} refused")
+            say("ok", "dns", f"{hostname} CNAME updated -> {tunnel_id}.cfargotunnel.com")
+        else:
+            if not cf(dns, "POST", f"/zones/{zone_id}/dns_records", body).get("success"):
+                fail("dns", f"CNAME create for {hostname} refused")
+            say("ok", "dns", f"{hostname} CNAME created -> {tunnel_id}.cfargotunnel.com")
+
+        # 8. vault, in-process, key names only. PUBLIC_WSS_URL rides the same entry: it is the
+        #    same hostname, same tunnel, and voice_endpoints.py reads it as a hard os.environ[...].
+        env_path = tmp / "env"
+        env_path.write_text(
+            f"V_URL=https://{hostname}\nV_WSS=wss://{hostname}/ws/live-call\nV_TOKEN={tunnel_token}\nV_ID={tunnel_id}\n"
+        )
+        vault_write = run(
+            [
+                str(IDP / "bin" / "idp-vault-put"),
+                "--merge",
+                "concierge-tunnel",
+                "PUBLIC_SERVER_URL=V_URL",
+                "PUBLIC_WSS_URL=V_WSS",
+                "TUNNEL_TOKEN=V_TOKEN",
+                "TUNNEL_ID=V_ID",
+            ],
+            capture_output=True,
+            text=True,
+            env={**os.environ, "ESTATE_ENV_FILE": str(env_path)},
+        )
+        if vault_write.returncode != 0:
+            # idp-vault-put prints key NAMES only, by its own header contract -- never a value --
+            # so its real stdout/stderr is safe to surface here instead of the generic one-liner
+            # that hid it (run 34998308859, idp#3537).
+            cause = (vault_write.stderr.strip() or vault_write.stdout.strip()).splitlines()
+            fail("vault", "concierge-tunnel write refused: " + (cause[-1][:200] if cause else "no output"))
+
+        # 9. the single-purpose tunnel-mgmt token is revoked; the DNS token it borrowed was
+        #    already standing and stays. A driver-born root dies with this process.
+        cf(root, "DELETE", f"/user/tokens/{tun_tok_id}")
+        if name:
+            tokens = cf(root, "GET", "/user/tokens")
+            match = next((t["id"] for t in tokens.get("result", []) if t.get("name") == name), None)
+            if match:
+                cf(root, "DELETE", f"/user/tokens/{match}")
+            revoked = "root token revoked"
+        else:
+            revoked = "standing root kept"
+        say(
+            "ok",
+            "concierge-tunnel",
+            f"concierge-tunnel vault entry written (PUBLIC_SERVER_URL https://{hostname}); "
+            f"tunnel-mgmt token revoked; {revoked}. cloudflared on the Mac still needs: launchctl "
+            "load with TUNNEL_TOKEN (docs/DEPLOYMENT.md #7); reachability itself is unverified "
+            "until cloudflared actually runs.",
+        )
+    finally:
+        shutil.rmtree(tmp, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    main()
