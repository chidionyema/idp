diff --git a/bin/idp-oke-break-glass b/bin/idp-oke-break-glass
index e23ce8ab1..b36ba873f 100755
--- a/bin/idp-oke-break-glass
+++ b/bin/idp-oke-break-glass
@@ -13,9 +13,18 @@ set -uo pipefail
 IDP="$(cd "$(dirname "$0")/.." && pwd)"
 K="kubectl --request-timeout=60s"
 FAILED=""
-step() { local name="$1"; shift; local out rc; out=$("$@" 2>&1); rc=$?
-  printf '%-5s %-22s rc=%-3s %s\n' "$([ $rc -eq 0 ] && echo ok || echo FAIL)" "$name" "$rc" "$(printf %s "$out" | tail -1 | cut -c1-110)"
-  [ $rc -eq 0 ] || { FAILED="$FAILED $name"; printf '%s\n' "$out" | tail -6 | sed 's/^/      | /'; }; return $rc; }
+BLIND=""
+# BLIND verdict (2026-08-31, run 33384482689): a probe that never reached the workload's node was
+# graded FAIL, and 13 "broken" rows were one dead kubelet. Cannot-measure is not measured-broken:
+# such rows read BLIND, are listed separately, and still fail the playbook -- BLIND is never green.
+blind_out() { grep -qE 'watch closed before UntilWithoutRetry timeout|error dialing backend|unable to upgrade connection' <<<"$1"; }
+step() { local name="$1"; shift; local out rc v; out=$("$@" 2>&1); rc=$?
+  if [ $rc -eq 0 ]; then v=ok; elif blind_out "$out"; then v=BLIND; else v=FAIL; fi
+  printf '%-5s %-22s rc=%-3s %s\n' "$v" "$name" "$rc" "$(printf %s "$out" | tail -1 | cut -c1-110)"
+  case $v in
+    FAIL) FAILED="$FAILED $name"; printf '%s\n' "$out" | tail -6 | sed 's/^/      | /' ;;
+    BLIND) BLIND="$BLIND $name"; echo '      | unmeasured: the probe never reached the workload (node/kubelet unreachable); this row proves nothing either way' ;;
+  esac; return $rc; }
 show() { local name="$1"; shift; echo "--- $name"; "$@" 2>&1 | head -60; }
 # show_redacted is show for anything that prints a workload's own output: same shape, every line
 # through redact() first, so reading a log is never the thing that leaks a token (LAW 21).
@@ -1213,5 +1222,7 @@ case "${1:-}" in
   registries-conf) pb_registries_conf ;;
   *) echo "usage: $0 <$(sed -n 's/^  --list) echo "\(.*\)"; exit 0 ;;$/\1/p' "$0" | tr " " "|")>"; exit 64 ;;
 esac
-[ -z "$FAILED" ] && { echo "PASS  break-glass $1"; exit 0; }
-echo "FAIL  break-glass $1 broken:$FAILED"; exit 1
+[ -z "$FAILED" ] && [ -z "$BLIND" ] && { echo "PASS  break-glass $1"; exit 0; }
+[ -n "$BLIND" ] && echo "BLIND break-glass $1 unmeasured:$BLIND"
+[ -n "$FAILED" ] && echo "FAIL  break-glass $1 broken:$FAILED"
+exit 1
diff --git a/tests/test_breakglass_blind_verdict.py b/tests/test_breakglass_blind_verdict.py
new file mode 100644
index 000000000..75ae41dcb
--- /dev/null
+++ b/tests/test_breakglass_blind_verdict.py
@@ -0,0 +1,72 @@
+"""A break-glass row whose probe never reached the workload reads BLIND, never FAIL.
+
+Incident: run 33384482689 (2026-08-31) printed 13 FAIL rows for otto-parity that were all one
+dead kubelet -- the probe never ran, but the receipt said the feature was broken. The grader
+must separate measured-broken (FAIL) from cannot-measure (BLIND), and BLIND must still fail
+the playbook: BLIND is never green.
+"""
+
+import pathlib
+import shutil
+import subprocess
+
+BASH = shutil.which("bash") or "/bin/bash"
+
+SCRIPT = pathlib.Path(__file__).resolve().parents[1] / "bin" / "idp-oke-break-glass"
+
+
+def _helpers() -> str:
+    src = SCRIPT.read_text()
+    start = src.index('FAILED=""')
+    end = src.index("show() {")
+    return src[start:end]
+
+
+def _run(snippet: str) -> subprocess.CompletedProcess:
+    return subprocess.run(  # noqa: S603 - runs the script under test's own helpers plus fixed literals
+        [BASH, "-c", _helpers() + "\n" + snippet],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+
+def test_watch_timeout_reads_blind_not_fail():
+    r = _run(
+        'step key-usable sh -c "echo error: watch closed before UntilWithoutRetry timeout; exit 1";'
+        ' echo "BLIND_LIST=$BLIND"; echo "FAIL_LIST=$FAILED"'
+    )
+    assert r.stdout.startswith("BLIND"), r.stdout
+    assert "BLIND_LIST= key-usable" in r.stdout, r.stdout
+    assert "FAIL_LIST= key-usable" not in r.stdout, r.stdout
+    assert "unmeasured" in r.stdout, r.stdout
+
+
+def test_kubelet_dial_error_reads_blind():
+    r = _run(
+        'step git-in-pod sh -c "echo error dialing backend: dial tcp: i/o timeout; exit 1"; echo "BLIND_LIST=$BLIND"'
+    )
+    assert r.stdout.startswith("BLIND"), r.stdout
+    assert "BLIND_LIST= git-in-pod" in r.stdout, r.stdout
+
+
+def test_real_failure_still_reads_fail():
+    r = _run(
+        'step boot-line sh -c "echo no estate-state line in the gateway log; exit 1"; echo "FAIL_LIST=$FAILED"'
+    )
+    assert r.stdout.startswith("FAIL"), r.stdout
+    assert "FAIL_LIST= boot-line" in r.stdout, r.stdout
+
+
+def test_success_still_reads_ok():
+    r = _run(
+        'step gateway-ready sh -c "echo rolled out; exit 0"; echo "FAIL_LIST=$FAILED"; echo "BLIND_LIST=$BLIND"'
+    )
+    assert r.stdout.startswith("ok"), r.stdout
+    assert "FAIL_LIST=\n" in r.stdout and "BLIND_LIST=\n" in r.stdout, r.stdout
+
+
+def test_blind_alone_still_fails_the_playbook():
+    src = SCRIPT.read_text()
+    assert '[ -z "$FAILED" ] && [ -z "$BLIND" ]' in src
+    assert "unmeasured:$BLIND" in src
