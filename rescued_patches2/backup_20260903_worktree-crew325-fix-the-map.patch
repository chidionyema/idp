diff --git a/platform/observability/httproute.yaml b/platform/observability/httproute.yaml
index c50d0ed17..4680dcbbf 100644
--- a/platform/observability/httproute.yaml
+++ b/platform/observability/httproute.yaml
@@ -42,3 +42,29 @@ spec:
       backendRefs:
         - name: langfuse-web
           port: 3000
+---
+# Langfuse's public API, the path programs use: bin/idp-trace-drill from a runner reads a trace
+# back by id (crew#325). It carries Langfuse's own auth (project public:secret key, basic auth;
+# the keys are the two vault entries langfuse.yaml pulls) and cannot sit behind a browser login,
+# where every program got a 302. Same two-part proof as the router's route (platform/llm): the
+# annotation says so, and the gates check that this route exposes /api/public/ and nothing else.
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: langfuse-api
+  namespace: observability
+  annotations:
+    idp.estate/auth: langfuse-project-keys
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-langfuse
+  hostnames:
+    - "langfuse.${ESTATE_ZONE}"
+  rules:
+    - matches:
+        - path: { type: PathPrefix, value: /api/public/ }
+      backendRefs:
+        - name: langfuse-web
+          port: 3000
