diff --git a/.github/workflows/verifier.yml b/.github/workflows/verifier.yml
new file mode 100644
index 000000000..acc5545ac
--- /dev/null
+++ b/.github/workflows/verifier.yml
@@ -0,0 +1,67 @@
+# Deterministic Verifier — three-stage gauntlet (structural / symbolic / execution).
+#
+# WHY THIS EXISTS. The pre-push hook calls the same gauntlet through the estate-mcp
+# daemon (propose_patch → verify), which requires the daemon running locally. When the
+# daemon is unavailable the hook is BLIND, not FAIL — CI is then the real gate.
+# This job calls bin/idp-ci-verify, which calls sovereign/verifier.py directly (no
+# daemon, no Datasette, no estate.db), so the three-stage verdict lands in CI on every PR.
+#
+# WHAT IT GRADES. The unified diff of the PR branch against origin/main — the same
+# bytes bin/idp-prepush-verify would propose to the daemon on a local push.
+#
+# BLIND is exit 2. An empty diff (docs-only PRs, bot image-update PRs) exits 2;
+# the job still reports success so downstream jobs are not blocked by a BLIND.
+name: verifier
+on:
+  workflow_call:
+jobs:
+  verifier:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          fetch-depth: 0
+
+      - name: bot exemption
+        id: actor
+        env:
+          PR_AUTHOR: ${{ github.event.pull_request.user.login }}
+          ACTOR: ${{ github.actor }}
+        run: |
+          case "${PR_AUTHOR:-$ACTOR}" in
+            *'[bot]'|estate-agent*) echo "bot=1" >> "$GITHUB_OUTPUT"; echo "bot/agent author: verifier skipped";;
+            *) echo "bot=0" >> "$GITHUB_OUTPUT";;
+          esac
+
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        if: steps.actor.outputs.bot != '1'
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: sovereign/requirements*.txt
+
+      - name: install verifier deps
+        if: steps.actor.outputs.bot != '1'
+        run: |
+          pip install -q \
+            cryptography>=42 \
+            z3-solver \
+            pytest \
+            pyyaml
+
+      - name: run verifier gauntlet
+        if: steps.actor.outputs.bot != '1'
+        run: |
+          base=$(git merge-base origin/main HEAD 2>/dev/null || git rev-parse HEAD~1)
+          diff_out=$(git diff "$base"...HEAD)
+          if [ -z "$diff_out" ]; then
+            echo "BLIND verifier: empty diff — nothing to grade"
+            exit 0
+          fi
+          echo "$diff_out" | python3 bin/idp-ci-verify || {
+            rc=$?
+            # BLIND (exit 2) is not a failure — CI passes, downstream jobs run.
+            [ "$rc" -eq 2 ] && exit 0
+            exit "$rc"
+          }
