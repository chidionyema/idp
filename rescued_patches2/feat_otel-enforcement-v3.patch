new file mode 100644
index 000000000..01e3b0e08
--- /dev/null
+++ b/platform/edge/otel-endpoint-exception.yaml
@@ -0,0 +1,31 @@
+# Work queue for require-otel-endpoint (founder ruling 2026-09-16).
+# Adding an entry requires a crew# ticket. Removing one (because the workload is wired) requires none.
+# A new workload not listed here is refused at admission without OTEL_EXPORTER_OTLP_ENDPOINT.
+apiVersion: kyverno.io/v2
+kind: PolicyException
+metadata:
+  name: otel-endpoint-dark-workloads
+  namespace: kyverno
+spec:
+  exceptions:
+    - policyName: require-otel-endpoint
+      ruleNames: [application-workload-declares-otel-endpoint,
+                  autogen-application-workload-declares-otel-endpoint]
+  match:
+    any:
+      # INFRA — probe/canary/balloon, no meaningful spans
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [scheduling], names: [balloon*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [cross-node-drill], names: [cross-node-canary*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [staging], names: [canary*, canary-gauge*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [state], names: [rotation-canary*] }
+      # VENDOR — third-party image, no OTel SDK
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [guacamole], names: [guacamole*, guacd*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [healthchecks], names: [healthchecks*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [searxng], names: [searxng*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [weave-gitops], names: [weave-gitops*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [commerce], names: [lago*, redis*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [llm, idp-agent, via-negativa], names: [redis*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [dagster] }
+      # VENDOR — third-party image with no OTel SDK; cannot be instrumented
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [notify], names: [apprise*] }
+      - resources: { kinds: [Deployment, StatefulSet, Pod, ReplicaSet], namespaces: [edge], names: [status-page*] }
diff --git a/platform/edge/require-otel-endpoint.yaml b/platform/edge/require-otel-endpoint.yaml
new file mode 100644
index 000000000..fba0257d0
--- /dev/null
+++ b/platform/edge/require-otel-endpoint.yaml
@@ -0,0 +1,50 @@
+# Founder ruling 2026-09-16: "mathematical guarantees only — never out of sync".
+# Every application Deployment or StatefulSet admitted to the cluster must declare
+# OTEL_EXPORTER_OTLP_ENDPOINT in at least one container. Violations refused at CREATE/UPDATE.
+# Existing dark workloads are named in otel-endpoint-exception.yaml — that list can only shrink.
+apiVersion: kyverno.io/v1
+kind: ClusterPolicy
+metadata:
+  name: require-otel-endpoint
+  annotations:
+    policies.kyverno.io/title: Every application workload declares an OTel endpoint
+    policies.kyverno.io/category: founder ruling 2026-09-16, telemetry
+    policies.kyverno.io/severity: high
+    policies.kyverno.io/subject: Deployment, StatefulSet
+    policies.kyverno.io/description: >-
+      A Deployment or StatefulSet outside system and observability namespaces must
+      declare OTEL_EXPORTER_OTLP_ENDPOINT in at least one container.
+spec:
+  background: true
+  rules:
+    - name: application-workload-declares-otel-endpoint
+      match:
+        any:
+          - resources:
+              kinds: [Deployment, StatefulSet]
+              operations: [CREATE, UPDATE]
+      exclude:
+        any:
+          - resources:
+              namespaces: [kube-system, flux-system, kyverno, cert-manager, spire-mgmt,
+                           metrics-server, reloader, keda, external-secrets, trivy-system, tailscale]
+          - resources:
+              namespaces: [observability]
+          - resources:
+              namespaces: [monitoring]
+          - resources:
+              namespaces: [healing, nodesoftware-operator, crossplane-system, calico-system, calico-apiserver]
+      validate:
+        failureAction: Enforce
+        message: >-
+          {{ request.object.kind }} {{ request.namespace }}/{{ request.object.metadata.name }}
+          has no container declaring OTEL_EXPORTER_OTLP_ENDPOINT. Wire it to
+          http://signoz-otel-collector.observability.svc:4318 following hermes-v2/otto/obs/core.py.
+          If this workload cannot emit OTel, add a named entry to
+          platform/edge/otel-endpoint-exception.yaml with a crew# justification.
+        deny:
+          conditions:
+            all:
+              - key: OTEL_EXPORTER_OTLP_ENDPOINT
+                operator: NotIn
+                value: "{{ request.object.spec.template.spec.containers[].env[].name }}"
