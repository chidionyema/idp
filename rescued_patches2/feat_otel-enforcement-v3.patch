+++ b/bin/idp-catalog-validator
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Validate catalog YAML before merge to prevent data corruption.
+
+Enforces Backstage catalog policies at commit time, catching invalid data
+before it reaches production. Runs on every commit via pre-commit hook and
+in CI as a required gate.
+
+    bin/idp-catalog-validator [--strict] <catalog-file> [more...]
+
+    --strict: exit 1 on ANY error (also used by CI gates)
+    Exit 0 if all validations pass, 1 if any fail.
+"""
+import sys
+import yaml
+import re
+from urllib.parse import urlparse
+
+def is_valid_url(url):
+    """Check if URL is valid (must be http/https or relative path starting with /)."""
+    if not isinstance(url, str):
+        return False
+    # Must be http/https URL
+    try:
+        result = urlparse(url)
+        return result.scheme in ('http', 'https')
+    except:
+        return False
+
+def validate_catalog_file(path):
+    """Validate one catalog YAML file. Returns (errors, warnings)."""
+    errors = []
+    warnings = []
+
+    try:
+        with open(path) as f:
+            docs = yaml.safe_load_all(f)
+            for doc_idx, doc in enumerate(docs):
+                if not isinstance(doc, dict):
+                    continue
+
+                kind = doc.get('kind')
+                metadata = doc.get('metadata', {})
+                spec = doc.get('spec', {})
+                entity_ref = f"{kind.lower()}:default/{metadata.get('name', '?')}" if kind else '?'
+
+                # Validate links
+                if 'links' in spec:
+                    links = spec['links']
+                    if not isinstance(links, list):
+                        links = [links]
+                    for link_idx, link in enumerate(links):
+                        if isinstance(link, dict):
+                            url = link.get('url')
+                            if url and not is_valid_url(url):
+                                errors.append(
+                                    f"{path}: {entity_ref} links[{link_idx}].url is not valid: '{url}' "
+                                    f"(must be http/https URL)"
+                                )
+                            if not link.get('title'):
+                                warnings.append(
+                                    f"{path}: {entity_ref} links[{link_idx}] has no title"
+                                )
+
+                # Validate all required fields present
+                if kind:
+                    if not metadata.get('name'):
+                        errors.append(f"{path}: {entity_ref} missing metadata.name")
+                    if not doc.get('apiVersion'):
+                        errors.append(f"{path}: {entity_ref} missing apiVersion")
+
+                    # Validate spec.owner if present
+                    if 'owner' in spec:
+                        owner = spec['owner']
+                        if isinstance(owner, str) and owner:
+                            # Owner should be a reference like "group:default/platform"
+                            if ':' not in owner and not any(c in owner for c in ['/', '@']):
+                                warnings.append(
+                                    f"{path}: {entity_ref} spec.owner '{owner}' looks incomplete"
+                                )
+
+                # Validate no direct self-dependencies
+                if kind == 'Component':
+                    depends_on = spec.get('dependsOn', [])
+                    if isinstance(depends_on, str):
+                        depends_on = [depends_on]
+                    name = metadata.get('name')
+                    for dep in depends_on:
+                        # Check exact self-reference (component depends on itself)
+                        # Extract just the component name from "component:default/name" format
+                        if isinstance(dep, str) and ':' in dep:
+                            dep_name = dep.split('/')[-1] if '/' in dep else dep.split(':')[-1]
+                        else:
+                            dep_name = dep
+
+                        if dep_name == name:
+                            errors.append(
+                                f"{path}: {entity_ref} has self-reference in dependsOn: {dep}"
+                            )
+    except Exception as e:
+        errors.append(f"{path}: Failed to parse YAML: {e}")
+
+    return errors, warnings
+
+def main():
+    # Handle --help before anything else (must exit 0 per LAW 43/45)
+    if '-h' in sys.argv or '--help' in sys.argv:
+        print("bin/idp-catalog-validator -- validate catalog YAML data integrity")
+        print("usage: bin/idp-catalog-validator [--strict] <catalog-file> [more...]")
+        return 0
+
+    strict = '--strict' in sys.argv
+    paths = [p for p in sys.argv[1:] if not p.startswith('-')]
+
+    if not paths:
+        print("usage: bin/idp-catalog-validator [--strict] <catalog-file> [more...]", file=sys.stderr)
+        return 2
+
+    all_errors = []
+    all_warnings = []
+    total_files = 0
+
+    for path in paths:
+        errors, warnings = validate_catalog_file(path)
+        all_errors.extend(errors)
+        all_warnings.extend(warnings)
+        total_files += 1
+
+    # Print errors
+    for error in all_errors:
+        print(f"ERROR   {error}")
+
+    # Print warnings (only if not strict)
+    if not strict:
+        for warning in all_warnings:
+            print(f"WARN    {warning}")
+
+    if all_errors:
+        print(f"\nValidation FAILED: {len(all_errors)} error(s), {len(all_warnings)} warning(s)")
+        return 1
+
+    print(f"ok      catalog-validator  validated {total_files} file(s): "
+          f"{len(all_errors)} errors, {len(all_warnings)} warnings")
+    return 0
+
+if __name__ == '__main__':
+    sys.exit(main())
