+# One ImageUpdateAutomation (backstage.yaml, path ./platform) writes every
+# ImagePolicy marker the policy tracks. Two automations on one push branch
+# collide ("cannot lock ref", crew#406, 2026-08-27), so there is exactly one.
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: runsc
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/runsc
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: runsc
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: runsc
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
