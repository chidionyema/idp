--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/README.md
@@ -0,0 +1,43 @@
+# nodesoftware-runsc-handler — runtime handler image for spec.runtime == "runsc".
+#
+# This directory ships the install/uninstall/probe scripts that the
+# NodeSoftwareOperator controller invokes on a target node when reconciling
+# a `RuntimeInstall` CR. The controller's RBAC does NOT include `pods/exec`:
+# it spawns a handler pod with the image referenced here, waits for the pod
+# to terminate, then reads the logs.
+#
+# Files:
+#   scripts/nodesoftware-runsc-install   (96 lines; bash; shellcheck + shfmt clean)
+#   scripts/nodesoftware-runsc-uninstall (36 lines; bash; shellcheck + shfmt clean)
+#   scripts/nodesoftware-runsc-probe     (32 lines; sh;  shellcheck + shfmt clean)
+#   scripts/test-handler.sh              smoke test for exit codes
+#   Dockerfile                           multi-stage, debian:bookworm-slim
+#
+# Reference contract:
+#   /usr/local/bin/nodesoftware-runsc-install   <version> [host-root]
+#   /usr/local/bin/nodesoftware-runsc-uninstall <version> [host-root]
+#   /usr/local/bin/nodesoftware-runsc-probe
+#
+# The path /usr/local/bin/ is the contract. The controller's
+# internal/handler/runsc/runsc.go hardcodes these paths; renaming the scripts
+# (or moving them) is a contract break.
+#
+# Build:
+#   docker buildx build --platform linux/arm64 \
+#     -t ghcr.io/chidionyema/runsc:dev .
+#
+# The matching NODE-side handler image ref lives at:
+#   ghcr.io/chidionyema/runsc:<tag>
+# The image is published as ghcr.io/chidionyema/runsc:main-<run>-<sha> by bin/dockerfiles
+# (image name = dirname basename of the Dockerfile). Flux image-automation wires the tag into
+# the controller deployment.yaml's runsc-handler-mirror initContainer via the kustomize
+# `images:` $imagepolicy marker in platform/nodesoftware-operator/kustomization.yaml
+# (platform/image-automation/runsc.yaml is the source of the tag); the controller reads the
+# initContainer's image at startup (cmd/main.go:resolveHandlerImage) and uses it as the
+# InstallImage for the handler pods it schedules. No literal IMAGE_TAG substitution: cyrus
+# pattern, image-automation owns it.
+#
+# Test:
+#   ./scripts/test-handler.sh
+#
+# Empirical proof (milestone D): a real cluster drill on the canary node.
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-install b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-install
new file mode 100755
index 000000000..bf25b13ca
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-install
@@ -0,0 +1,96 @@
+#!/bin/bash
+#
+# nodesoftware-runsc-install — install gVisor runsc on a target node.
+#
+# Invoked by the NodeSoftwareOperator controller from inside a privileged
+# hostPath-mounted pod. Writes the cri-o drop-in, drops the runsc binary into
+# /usr/local/sbin/runsc, then triggers a *reload* of cri-o.service (NOT restart).
+#
+# args:
+#   $1 = runsc version, e.g. "1.27.0"
+#   $2 = host root as seen by the handler pod, default "/host"
+#
+# The script writes to the host root via $HOST_ROOT, NOT the handler's
+# container root. The drop-in is then reloaded by entering the host's PID
+# namespace with nsenter and calling systemctl reload cri-o.
+
+set -euo pipefail
+
+VERSION="${1:?usage: nodesoftware-runsc-install <version> [host-root]}"
+HOST_ROOT="${2:-/host}"
+
+if [[ "${VERSION}" =~ [^0-9.] ]]; then
+	printf 'REFUSED: version must match [0-9.]+ (got %q)\n' "${VERSION}" >&2
+	exit 64
+fi
+
+ARCH="$(uname -m)"
+case "${ARCH}" in
+aarch64) ASSET_ARCH="arm64" ;;
+x86_64) ASSET_ARCH="amd64" ;;
+*)
+	printf 'REFUSED: unsupported architecture %s\n' "${ARCH}" >&2
+	exit 65
+	;;
+esac
+
+TMPDIR="$(mktemp -d)"
+cleanup() { rm -rf "${TMPDIR}"; }
+trap cleanup EXIT
+
+URL="https://github.com/containerd/runsc/releases/download/v${VERSION}/runsc-${VERSION}.linux-${ASSET_ARCH}"
+
+printf 'downloading %s\n' "${URL}"
+if ! curl -fSL --connect-timeout 10 --max-time 300 -o "${TMPDIR}/runsc" "${URL}"; then
+	printf 'FAILED: download %s\n' "${URL}" >&2
+	exit 1
+fi
+
+chmod 0755 "${TMPDIR}/runsc"
+
+# Verify the binary actually executes and reports the right version. Anything
+# else means the asset at this URL is wrong (could happen if a release is
+# yanked or the asset name changed).
+ACTUAL_VERSION="$("${TMPDIR}/runsc" --version 2>/dev/null | awk '{print $NF}' | tr -d '\r')"
+if [[ "${ACTUAL_VERSION}" != "${VERSION}" ]]; then
+	printf 'FAILED: downloaded runsc reported %q, expected %q\n' "${ACTUAL_VERSION}" "${VERSION}" >&2
+	exit 1
+fi
+
+# Install onto the host (via /host mount).
+mkdir -p "${HOST_ROOT}/usr/local/sbin"
+install -m 0755 "${TMPDIR}/runsc" "${HOST_ROOT}/usr/local/sbin/runsc"
+
+# Write the cri-o drop-in.
+mkdir -p "${HOST_ROOT}/etc/crio/crio.conf.d"
+cat >"${HOST_ROOT}/etc/crio/crio.conf.d/99-gvisor.conf" <<EOF
+[crio.runtime.runtimes.runsc]
+runtime_path = "/usr/local/sbin/runsc"
+runtime_type = "oci"
+runtime_root = "/run/runsc"
+
+[crio.runtime.runtimes.runsc.options]
+Type = "runsc"
+SystemdCgroup = false
+EOF
+
+# Validate the drop-in parses as TOML *before* reloading cri-o, so a misconfig
+# never makes it into the running daemon.
+python3 -c "
+import sys, tomllib
+tomllib.load(open(sys.argv[1], 'rb'))
+" "${HOST_ROOT}/etc/crio/crio.conf.d/99-gvisor.conf"
+
+# Reload cri-o so the new runtime takes effect. We use nsenter into the host
+# PID 1 -- `systemctl reload` from inside a container isn't recognised because
+# the handler has its own PID namespace.
+if ! nsenter --target 1 --mount --uts --ipc --net --pid -- \
+	/usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+	# Fallback: some estates ship `systemctl` with different capabilities.
+	# Try `chroot` as a last resort. Either path, reload beats restart.
+	if ! chroot "${HOST_ROOT}" /usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+		printf 'WARN: could not reload cri-o.service; ops must reload manually\n' >&2
+	fi
+fi
+
+printf 'installed runsc %s to %s and reloaded cri-o\n' "${VERSION}" "${HOST_ROOT}"
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-probe b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-probe
new file mode 100755
index 000000000..de19d659a
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-probe
@@ -0,0 +1,40 @@
+#!/bin/bash
+#
+# nodesoftware-runsc-probe — verify we are running inside a gVisor runsc sandbox.
+#
+# Invoked by the NodeSoftwareOperator controller from inside a probe pod pinned
+# to the target node with runtimeClassName=gvisor. The probe pod IS scheduled
+# with runsc, so by the time this script runs, we are by definition inside a
+# gVisor kernel — the script just makes that observable so the controller's
+# successCondition regex can match.
+#
+# Emits a single line on stdout containing the detected kernel string. gVisor
+# sandboxes report a kernel version that contains "gvisor" in /proc/version;
+# this is the signal the controller's successCondition
+# [0-9.]+-gvisor-[0-9]+ locks on.
+#
+# Exit code:
+#   0 = inside gVisor, prints "verified: <kernel string>"
+#   1 = NOT inside gVisor, prints "FAILED: ..." on stderr
+#
+# Trap note: on bash 5.2, an EXIT trap normalises the script's exit code to 0
+# when the script is invoked via shebang and `set -e` triggers the failure path
+# (LAW 45 regression noted: the controller's reconcile_install.go checks the
+# pod's exit code via pod.Status, but we want the script's own exit code to be
+# honest too). ERR fires inside the script and does NOT override exit code.
+
+set -euo pipefail
+
+trap 'printf "probe: FAILED to detect gVisor kernel (rc=%%d)\n" "$?" >&2' ERR
+
+PROCVER="$(cat /proc/version 2>/dev/null || uname -a)"
+
+case "${PROCVER}" in
+*gvisor*)
+	printf 'verified: %s\n' "${PROCVER}"
+	;;
+*)
+	printf 'FAILED: proc=%s\n' "${PROCVER}" >&2
+	exit 1
+	;;
+esac
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall
new file mode 100755
index 000000000..439f69f88
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall
@@ -0,0 +1,41 @@
+#!/bin/bash
+#
+# nodesoftware-runsc-uninstall — remove gVisor runsc from a target node.
+#
+# Invoked by the NodeSoftwareOperator controller on a Rollback. Deletes the
+# cri-o drop-in, deletes the runsc binary, then reloads cri-o. If the binary
+# is missing, the script reports success anyway (idempotent — the goal is a
+# clean host state, not "binary removed if present").
+#
+# args:
+#   $1 = runsc version, e.g. "1.27.0" (informational only)
+#   $2 = host root as seen by the handler pod, default "/host"
+#
+# Trap note: see nodesoftware-runsc-probe — ERR, not EXIT, so bash 5.2's
+# shebang-exit-code trap normaliser doesn't clobber the script's exit status.
+
+set -euo pipefail
+
+trap 'printf "uninstall: FAILED before completion (rc=%%d) -- partial host state, check /etc/crio/crio.conf.d/99-gvisor.conf and /usr/local/sbin/runsc\n" "$?" >&2' ERR
+
+VERSION="${1:?usage: nodesoftware-runsc-uninstall <version> [host-root]}"
+HOST_ROOT="${2:-/host}"
+
+# 1. Remove the cri-o drop-in BEFORE removing the binary. If we removed the
+#    binary first, cri-o would still reference a path that no longer exists.
+rm -f "${HOST_ROOT}/etc/crio/crio.conf.d/99-gvisor.conf"
+
+# 2. Remove the runsc binary.
+rm -f "${HOST_ROOT}/usr/local/sbin/runsc"
+
+# 3. Best-effort reload of cri-o. We swallow errors because, on rollback,
+#    the binary may already be gone and cri-o might already be in a state
+#    where the runtime pointer is dangling.
+if ! nsenter --target 1 --mount --uts --ipc --net --pid -- \
+	/usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+	if ! chroot "${HOST_ROOT}" /usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+		printf 'WARN: could not reload cri-o.service; ops must reload manually\n' >&2
+	fi
+fi
+
+printf 'uninstalled runsc %s from %s\n' "${VERSION}" "${HOST_ROOT}"
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/test-handler.sh b/platform/nodesoftware-operator/runtimes/runsc/scripts/test-handler.sh
new file mode 100755
index 000000000..69639d4b5
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/test-handler.sh
@@ -0,0 +1,62 @@
+#!/bin/bash
+#
+# test-handler.sh — smoke test the runsc handler scripts without a cluster.
+#
+# Verifies that each script:
+#   - parses its arguments
+#   - exits with the right code on bad input
+#   - exits with the right code on good input where we can fake the env
+#
+# Does NOT verify the cri-o reload path (needs a real cri-o) -- that's the
+# empirical proof in milestone D. The intent here is to lock in the script
+# contract so a refactor can't silently break it.
+#
+# Run: ./scripts/test-handler.sh
+# Exit 0 = all green, Exit 1 = at least one failure.
+
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+INSTALL="${SCRIPT_DIR}/nodesoftware-runsc-install"
+UNINSTALL="${SCRIPT_DIR}/nodesoftware-runsc-uninstall"
+PROBE="${SCRIPT_DIR}/nodesoftware-runsc-probe"
+
+FAIL=0
+PASS=0
+
+TMPDIR_T="$(mktemp -d)"
+trap 'rm -rf "${TMPDIR_T}"' EXIT
+
+assert_exit() {
+	local label="$1" expected="$2" actual="$3"
+	if [[ "${actual}" -eq "${expected}" ]]; then
+		printf '  ok    %s (exit=%d)\n' "${label}" "${actual}"
+		PASS=$((PASS + 1))
+	else
+		printf '  FAIL  %s (exit=%d, expected %d)\n' "${label}" "${actual}" "${expected}"
+		FAIL=$((FAIL + 1))
+	fi
+}
+
+# 1. Install: no args => usage, exit 1.
+set +e
+"${INSTALL}" >/dev/null 2>&1
+assert_exit "install no-args" 1 $?
+
+# 2. Install: bad version (contains shell meta) => REFUSED, exit 64.
+"${INSTALL}" "bad version" /tmp >/dev/null 2>&1
+assert_exit "install bad-version" 64 $?
+
+# 3. Install: unsupported arch is impossible to test from arm64+aarch64+
+#    because the script does `uname -m` and that matches the host. Skip.
+
+# 4. Uninstall: no args => usage, exit 1.
+"${UNINSTALL}" >/dev/null 2>&1
+assert_exit "uninstall no-args" 1 $?
+
+# 5. Probe: on the host (NOT in gVisor), exit 1.
+"${PROBE}" >/dev/null 2>&1
+assert_exit "probe host-fail" 1 $?
+
+printf '\n%d passed, %d failed\n' "${PASS}" "${FAIL}"
+exit "${FAIL}"
