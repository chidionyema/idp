new file mode 100644
index 000000000..989a4d717
--- /dev/null
+++ b/platform/image-automation/controller.yaml
@@ -0,0 +1,37 @@
+# nodesoftware-operator controller binary (goal b9217bea C2). The controller Dockerfile lives at
+# platform/nodesoftware-operator/controller/Dockerfile so `bin/dockerfiles` publishes the
+# multi-arch manifest list as ghcr.io/chidionyema/controller:main-<run>-<sha> (the dirname's
+# basename). ImageRepository below watches that registry name; the kustomization.yaml in the
+# platform/nodesoftware-operator directory carries the `$imagepolicy` marker that maps the
+# ImagePolicy's chosen tag onto the controller Deployment's `image:` field. Without this row
+# the controller's deployment asks for `ghcr.io/chidionyema/nodesoftware-operator` with no tag
+# and kubelet ImagePullBackOffs the pod until a human types a SHA.
+#
+# One ImageUpdateAutomation (backstage.yaml, path ./platform) writes every ImagePolicy marker
+# the policy tracks. Two automations on one push branch collide ("cannot lock ref", crew#406,
+# 2026-08-27), so there is exactly one.
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: controller
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/controller
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: controller
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: controller
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
