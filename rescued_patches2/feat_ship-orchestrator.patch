+    "headRefOid": "3" * 40,
+    "createdAt": "2026-09-22T08:00:00Z",
+    "mergedAt": "2026-09-22T08:30:00Z",
+    "state": "MERGED",
+    "baseRefName": "main",
+}
+
+
+def _stub(args):
+    if args[:2] == ["pr", "list"]:
+        return [PR1, PR2, PR3]
+    if args[0] == "api" and "check-runs" in args[1]:
+        return {
