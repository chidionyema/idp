+            "ok": merge.get("ok") and merge2.get("ok"),
+            "detail": f"merged_count={merge2.get('merged_count')}",
+        }
+    )
+
+    sm = _daemon._get_or_load_replica("p1-shared")
+    triplets = sm.top_k(symbol="auth", k=8)
+    steps.append(
+        {
+            "step": "shared_sees_both",
+            "ok": len(triplets) == 2,
+            "detail": f"top_k(auth) returned {len(triplets)}",
+        }
+    )
+
+    shutil.rmtree(runs, ignore_errors=True)
+    overall = all(s["ok"] for s in steps)
+    return {"ok": overall, "plane": 1, "steps": steps}
