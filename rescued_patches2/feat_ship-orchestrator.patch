+    _daemon._persist_triplet("p1-b", "edit auth", "added logout", "ok", "auth")
+    steps.append(
+        {
+            "step": "two_replicas_put",
+            "ok": True,
+            "detail": "p1-a and p1-b each added 1 triplet",
+        }
+    )
+
+    merge = _daemon.Handler.__new__(_daemon.Handler)._merge_replica(
+        {"replica_id": "p1-shared", "from_replica_id": "p1-a"}
+    )
+    merge2 = _daemon.Handler.__new__(_daemon.Handler)._merge_replica(
+        {"replica_id": "p1-shared", "from_replica_id": "p1-b"}
+    )
