+    "headRefName": "feat/first",
+    "headRefOid": "1" * 40,
+    "createdAt": "2026-09-20T08:00:00Z",
+    "mergedAt": "2026-09-20T08:30:00Z",
+    "state": "MERGED",
+    "baseRefName": "main",
+}
+PR2 = {
+    "number": 3902,
+    "title": "middle",
+    "headRefName": "feat/middle",
+    "headRefOid": "2" * 40,
+    "createdAt": "2026-09-21T08:00:00Z",
+    "mergedAt": None,
+    "state": "OPEN",
+    "baseRefName": "main",
+}
+PR3 = {
+    "number": 3903,
