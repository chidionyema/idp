+
+def test_cli_subprocess_blind_returns_error(tmp_path, monkeypatch):
+    monkeypatch.setenv("ESTATE_DB", str(tmp_path / "never.db"))
+    import os
+
+    env = {**os.environ, "ESTATE_DB": str(tmp_path / "never.db")}
