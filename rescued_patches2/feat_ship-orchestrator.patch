+{# deploy-observatory page -- three concentric rings, one per plane.
+   Zero chrome. The rings ARE the page. Soundtrack note per ring at the top.
+   Inner ring = Jev (decisions), middle = judges, outer = Physics (seals). #}<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>deploy observatory</title>
+<style>
+  :root {
+    --bg: #06080d; --ink: #d6dee8; --dim: #5a6577; --line: #1a2030;
+    --ring1: #c89a3a;   /* jev: amber - thought */
+    --ring2: #7da4d6;   /* judges: blue - evaluation */
+    --ring3: #54c08a;   /* physics: green - proof */
+    --fail: #d05656; --pass: #54c08a;
+  }
+  * { box-sizing: border-box; margin: 0; padding: 0; }
+  html, body { width: 100%; height: 100%; overflow: hidden;
+               background: var(--bg); color: var(--ink);
+               font-family: -apple-system, "SF Pro Text", system-ui, sans-serif;
+               font-size: 13px; line-height: 1.4; }
+  body { display: grid; grid-template-rows: auto 1fr; gap: 16px;
+         padding: 24px 32px; }
+  h1 { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
+       font-weight: 600; color: var(--dim); }
+  .legend { display: flex; gap: 32px; font-size: 11px; color: var(--dim);
+            letter-spacing: 0.04em; }
+  .legend span::before { content: ""; display: inline-block; width: 8px;
+                          height: 8px; border-radius: 50%; margin-right: 6px;
+                          vertical-align: 1px; }
+  .legend .jev::before    { background: var(--ring1); }
+  .legend .judges::before { background: var(--ring2); }
+  .legend .physics::before{ background: var(--ring3); }
+
+  svg { width: 100%; height: 100%; }
+  .ring-jev     { stroke: var(--ring1); fill: none; stroke-width: 0.8;
+                  opacity: 0.5; }
+  .ring-judges  { stroke: var(--ring2); fill: none; stroke-width: 0.8;
+                  opacity: 0.5; }
+  .ring-physics { stroke: var(--ring3); fill: none; stroke-width: 0.8;
+                  opacity: 0.5; }
+  .star         { stroke-linecap: round; }
+  .star.pass    { fill: var(--pass); stroke: var(--pass); }
+  .star.fail    { fill: var(--fail); stroke: var(--fail); }
+  .star.escalate{ fill: var(--ring1); stroke: var(--ring1); }
+  .label-jev    { fill: var(--ring1); font-size: 9px; letter-spacing: 0.08em;
+                  text-transform: uppercase; font-weight: 600; }
+  .label-judges { fill: var(--ring2); font-size: 9px; letter-spacing: 0.08em;
+                  text-transform: uppercase; font-weight: 600; }
+  .label-physics{ fill: var(--ring3); font-size: 9px; letter-spacing: 0.08em;
+                  text-transform: uppercase; font-weight: 600; }
+  .label-empty  { fill: var(--dim); font-size: 11px; text-anchor: middle; }
+</style>
+</head>
+<body>
+<h1>observatory — three planes</h1>
+<div class="legend">
+  <span class="jev">ring 1: jev decisions</span>
+  <span class="judges">ring 2: judges</span>
+  <span class="physics">ring 3: physics seals</span>
+</div>
+
+<svg viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid meet">
+  <g transform="translate(600 320)">
+    <!-- Three concentric rings, outermost = physics, innermost = jev -->
+    <circle r="280" class="ring-physics"/>
+    <circle r="200" class="ring-judges"/>
+    <circle r="120" class="ring-jev"/>
+
+    <!-- Ring labels at 12 o'clock outside -->
+    <text x="0" y="-296" text-anchor="middle" class="label-physics">physics</text>
+    <text x="0" y="-216" text-anchor="middle" class="label-judges">judges</text>
+    <text x="0" y="-136" text-anchor="middle" class="label-jev">jev</text>
+
+    {{STARS_SVG}}
+
+    {{EMPTY_LABEL}}
+  </g>
+</svg>
+</body>
+</html>
diff --git a/web/templates/deploy-river.html b/web/templates/deploy-river.html
new file mode 100644
index 000000000..3e15379b0
--- /dev/null
+++ b/web/templates/deploy-river.html
@@ -0,0 +1,87 @@
+{# deploy-river page -- single-file, no chrome, no sidebar, no breadcrumbs.
+   The room is the interface. One comet per open PR; one ring per gate;
+   ambient Andon color drives the page background. #}<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>deploy river</title>
+<style>
+  :root {
+    --bg:        #06080d;
+    --ink:       #d6dee8;
+    --dim:       #5a6577;
+    --gate:      #2a3344;
+    --gate-pass: #54c08a;
+    --gate-fail: #d05656;
+    --gate-unkn: #c89a3a;
+    --ambient:   {{AMBIENT_COLOR}};
+    --ambient-tint: {{AMBIENT_TINT}};
+    --comet:     #c0d6ff;
+    --comet-tail:#7da4d6;
+  }
+  * { box-sizing: border-box; margin: 0; padding: 0; }
+  html, body { width: 100%; height: 100%; overflow: hidden;
+               background: var(--bg); color: var(--ink);
+               font-family: -apple-system, "SF Pro Text", system-ui, sans-serif;
+               font-size: 13px; line-height: 1.4; }
+  body { background: radial-gradient(ellipse at 50% 110%,
+                                     var(--ambient-tint) 0%, var(--bg) 60%);
+         transition: background 800ms ease; }
+  svg { width: 100%; height: 100%; display: block; }
+
+  .label { fill: var(--dim); font-size: 10px; letter-spacing: 0.06em;
+           text-transform: uppercase; font-weight: 500; }
+  .gate-name { fill: var(--ink); font-size: 11px; font-weight: 500;
+               letter-spacing: 0.02em; }
+  .sha       { fill: var(--dim); font-size: 9px;
+               font-family: ui-monospace, "SF Mono", monospace; }
+  .ambient-text { fill: var(--ambient); font-size: 11px;
+                  letter-spacing: 0.08em; text-transform: uppercase;
+                  font-weight: 600; }
+
+  .comet-glow { filter: blur(8px); opacity: 0.4; }
+  .comet-body { fill: var(--comet); }
+  .comet-tail { stroke: var(--comet-tail); stroke-width: 1.5;
+                stroke-linecap: round; opacity: 0.6; fill: none; }
+  .gate-pass  { stroke: var(--gate-pass); stroke-width: 1; fill: none; }
+  .gate-fail  { stroke: var(--gate-fail); stroke-width: 1.5; fill: none; }
+  .gate-unkn  { stroke: var(--gate-unkn); stroke-width: 1; fill: none;
+                stroke-dasharray: 2 3; }
+  .gate-future{ stroke: var(--gate); stroke-width: 0.8; fill: none;
+                stroke-dasharray: 1 4; opacity: 0.4; }
+</style>
+</head>
+<body>
+<svg viewBox="0 0 1200 720" preserveAspectRatio="xMidYMid slice">
+  <defs>
+    <radialGradient id="cometGrad" cx="50%" cy="50%" r="50%">
+      <stop offset="0%"  stop-color="#ffffff" stop-opacity="1"/>
+      <stop offset="40%" stop-color="#c0d6ff" stop-opacity="0.7"/>
+      <stop offset="100%" stop-color="#c0d6ff" stop-opacity="0"/>
+    </radialGradient>
+  </defs>
+
+  <!-- The basin (ambient Andon caption lives top-left) -->
+  <text x="24" y="32" class="ambient-text">{{AMBIENT_LABEL}}</text>
+  <text x="24" y="48" class="label">{{AMBIENT_REASON}}</text>
+
+  <!-- The four gate rings (concentric circles centered, fixed order) -->
+  <g transform="translate(600 420)">
+    <circle r="340" class="gate-future"/>
+    <circle r="260" class="gate-future"/>
+    <circle r="180" class="gate-future"/>
+    <circle r="100" class="gate-future"/>
+    <g transform="translate(0 -340)"><text text-anchor="middle" class="gate-name">reconcile</text></g>
+    <g transform="translate(0 -260)"><text text-anchor="middle" class="gate-name">merged</text></g>
+    <g transform="translate(0 -180)"><text text-anchor="middle" class="gate-name">checks</text></g>
+    <g transform="translate(0 -100)"><text text-anchor="middle" class="gate-name">opened</text></g>
+  </g>
+
+  <!-- Comets (open PRs) -->
+  {{COMETS_SVG}}
+
+  <!-- Comet tail / history (last 11 merged, fading as they recede) -->
+  {{RECENT_SVG}}
+</svg>
+</body>
+</html>
diff --git a/web/templates/deploy-time-scrub.html b/web/templates/deploy-time-scrub.html
new file mode 100644
index 000000000..7d67daf52
--- /dev/null
+++ b/web/templates/deploy-time-scrub.html
@@ -0,0 +1,125 @@
+{# deploy-time-scrub page -- drag the date to replay history.
+   Each journey is a single card. Focus pauses replay. No chrome. #}<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<title>deploy time-scrub</title>
+<style>
+  :root {
+    --bg: #06080d; --ink: #d6dee8; --dim: #5a6577;
+    --merged: #54c08a; --in_flight: #c89a3a; --failed: #d05656;
+    --abandoned: #6a6a6a; --unknown: #c89a3a;
+    --line: #1a2030;
+  }
+  * { box-sizing: border-box; margin: 0; padding: 0; }
+  html, body { width: 100%; height: 100%; overflow: hidden;
+               background: var(--bg); color: var(--ink);
+               font-family: -apple-system, "SF Pro Text", system-ui, sans-serif;
+               font-size: 13px; line-height: 1.45; }
+  body { display: grid; grid-template-rows: auto auto 1fr; gap: 16px;
+         padding: 24px 32px; }
+
+  h1 { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
+       font-weight: 600; color: var(--dim); }
+
+  .scrubber { display: flex; align-items: center; gap: 12px; }
+  .scrubber input[type=date] { background: transparent; color: var(--ink);
+                                border: 1px solid var(--line); padding: 6px 10px;
+                                font: inherit; }
+  .scrubber .stat { color: var(--dim); font-size: 11px;
+                     letter-spacing: 0.04em; }
+
+  .list { overflow-y: auto; padding-right: 8px; }
+  .card { display: grid; grid-template-columns: 56px 1fr 100px;
+          gap: 16px; padding: 12px 0; border-top: 1px solid var(--line); }
+  .card:first-child { border-top: 0; }
+  .state { font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
+           font-weight: 600; padding-top: 2px; }
+  .state.merged    { color: var(--merged); }
+  .state.in_flight { color: var(--in_flight); }
+  .state.failed    { color: var(--failed); }
+  .state.abandoned { color: var(--abandoned); }
+  .state.unknown   { color: var(--unknown); }
+
+  .meta { color: var(--ink); }
+  .meta .pr    { font-size: 13px; font-weight: 500; }
+  .meta .branch{ font-size: 11px; color: var(--dim);
+                 font-family: ui-monospace, "SF Mono", monospace; }
+  .meta .sha   { font-size: 10px; color: var(--dim);
+                 font-family: ui-monospace, "SF Mono", monospace; }
+
+  .time { text-align: right; color: var(--dim); font-size: 11px;
+          font-family: ui-monospace, "SF Mono", monospace; }
+  .time .open  { display: block; }
+  .time .merge { display: block; color: var(--merged); }
+
+  .empty { color: var(--dim); padding: 32px 0; text-align: center; }
+</style>
+</head>
+<body>
+<h1>time-scrub</h1>
+<div class="scrubber">
+  <input type="date" id="day" value="{{DAY}}">
+  <span class="stat" id="stat">—</span>
+</div>
+<div class="list" id="list">
+  <div class="empty">loading…</div>
+</div>
+
+<script>
+  // The page can either be opened directly (data inlined below) or served
+  // by bin/estate-web-server with the date fetched live. We honour both.
+  const INLINED = {{DATA_JSON}};
+
+  const $ = (s) => document.querySelector(s);
+  const dayInput = $("#day");
+  const list = $("#list");
+  const stat = $("#stat");
+
+  function render(data) {
+    stat.textContent = data.journeys.length
+      ? data.journeys.length + " journey" + (data.journeys.length === 1 ? "" : "s")
+      : (data.error || "no data");
+    if (!data.journeys.length) {
+      list.innerHTML = '<div class="empty">' +
+        (data.error || "no journeys on this date") + '</div>';
+      return;
+    }
+    list.innerHTML = data.journeys.map(j => `
+      <div class="card">
+        <div class="state ${j.state}">${j.state}</div>
+        <div class="meta">
+          <div class="pr">#${j.pr_number || "—"} ${escape(j.title || "")}</div>
+          <div class="branch">${escape(j.branch || "—")}</div>
+          <div class="sha">${escape(j.sha || "").slice(0,12)}</div>
+        </div>
+        <div class="time">
+          <span class="open">open ${(j.started_at || "").slice(11,16)}</span>
+          <span class="merge">${j.merged_at ? "merge " + j.merged_at.slice(11,16) : "—"}</span>
+        </div>
+      </div>
+    `).join("");
+  }
+
+  function escape(s) {
+    return String(s).replace(/[&<>"']/g, c =>
+      ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
+  }
+
+  if (INLINED) {
+    render(INLINED);
+  } else {
+    fetch("/api/scrub?day=" + encodeURIComponent(dayInput.value))
+      .then(r => r.json()).then(render).catch(e => {
+        list.innerHTML = '<div class="empty">BLIND: ' + e + '</div>';
+      });
+  }
+  dayInput.addEventListener("change", () => {
+    if (!INLINED) {
+      fetch("/api/scrub?day=" + encodeURIComponent(dayInput.value))
+        .then(r => r.json()).then(render);
+    }
+  });
+</script>
+</body>
+</html>
