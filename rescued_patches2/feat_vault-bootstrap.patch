@@ -0,0 +1,93 @@
+# button: Connect the estate to Bitwarden Secrets Manager
+# founder: With the machine token already sitting in the estate vault, this run creates the
+# `estate` project in Bitwarden Secrets Manager (or finds it if it already exists), reads back
+# the organisation and project identifiers, and opens a pull request that fills them into
+# clusters/oke/estate-config.yaml. The token travels vault -> runner memory and is never
+# printed, never an argument, never committed (R49, R52). The two identifiers are public
+# names, not secrets. Runs from the phone: gh workflow run vault-bootstrap.yml
+name: vault-bootstrap
+on:
+  workflow_dispatch: {}
+permissions:
+  id-token: write      # traded for an OCI session, the same road vault-seed drives
+  contents: write      # pushes the branch carrying the two public identifiers
+  pull-requests: write # opens the pull request the founder merges
+concurrency: { group: oke-check, cancel-in-progress: false }
+jobs:
+  bootstrap:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: .github/requirements/oci-cli.txt
+      - name: oci cli
+        run: pip install -q -r .github/requirements/oci-cli.txt
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+      - name: bws, the vendor's own tool, pinned and checksummed
+        run: |
+          set -euo pipefail
+          curl -sSLo bws.zip https://github.com/bitwarden/sdk-sm/releases/download/bws-v2.1.0/bws-x86_64-unknown-linux-gnu-2.1.0.zip
+          echo "ba8233c3a4aee5d43e3c73bbd04d99e9bc5aba13bbbfd06d89b073abe732b860  bws.zip" | sha256sum -c -
+          unzip -q bws.zip bws
+          sudo install -m 0755 bws /usr/local/bin/bws
+          rm -f bws bws.zip
+      - name: create the estate project and read back the two identifiers
+        env:
+          OCI_CLI_AUTH: security_token
+          OCI_CI: "1"
+          OCI_TENANCY_OCID: ${{ secrets.OCI_TENANCY_OCID }}
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+        run: |
+          set -euo pipefail
+          # The machine token: vault to process memory. Never printed, never an argument (R49).
+          BWS_ACCESS_TOKEN=$(bin/idp-cloud secret get bitwarden-machine)
+          # The founder may have pasted the raw token or a JSON wrapper; accept both shapes.
+          if printf '%s' "$BWS_ACCESS_TOKEN" | jq -e '.token' >/dev/null 2>&1; then
+            BWS_ACCESS_TOKEN=$(printf '%s' "$BWS_ACCESS_TOKEN" | jq -r '.token')
+          fi
+          export BWS_ACCESS_TOKEN
+          projects=$(bws project list --output json 2>/dev/null || echo '[]')
+          row=$(printf '%s' "$projects" | jq -c '[.[] | select(.name=="estate")][0] // empty')
+          if [ -z "$row" ]; then
+            row=$(bws project create estate --output json)
+            echo "ok    bws     project estate created"
+          else
+            echo "ok    bws     project estate already exists; reusing it"
+          fi
+          ORG_ID=$(printf '%s' "$row" | jq -r '.organizationId')
+          PROJECT_ID=$(printf '%s' "$row" | jq -r '.id')
+          [ -n "$ORG_ID" ] && [ "$ORG_ID" != null ] || { echo "FAIL  bws     no organisation identifier in the project row"; exit 1; }
+          [ -n "$PROJECT_ID" ] && [ "$PROJECT_ID" != null ] || { echo "FAIL  bws     no project identifier in the project row"; exit 1; }
+          sed -i "s|^  BITWARDEN_ORG_ID: .*|  BITWARDEN_ORG_ID: \"$ORG_ID\"|" clusters/oke/estate-config.yaml
+          sed -i "s|^  BITWARDEN_PROJECT_ID: .*|  BITWARDEN_PROJECT_ID: \"$PROJECT_ID\"|" clusters/oke/estate-config.yaml
+          echo "ok    config  both identifiers written to clusters/oke/estate-config.yaml (public names, not secrets)"
+      - name: pull request for the founder
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          if git diff --quiet; then
+            echo "ok    config  identifiers already current; nothing to open"
+            exit 0
+          fi
+          git config user.name  "estate-agents[bot]"
+          git config user.email "estate-agents[bot]@users.noreply.github.com"
+          git checkout -B vault-bootstrap/identifiers
+          git add clusters/oke/estate-config.yaml
+          git commit -m "config: Bitwarden organisation and project identifiers from the bootstrap run"
+          git push --force origin HEAD:vault-bootstrap/identifiers
+          gh pr create --base main --head vault-bootstrap/identifiers \
+            --title "config: Bitwarden identifiers from the bootstrap run" \
+            --body "The vault-bootstrap run created (or found) the estate project in Bitwarden Secrets Manager and read back its organisation and project identifiers. This fills the two empty keys in clusters/oke/estate-config.yaml. Both values are public names, not secrets; the machine token never left the runner. Merging this connects the cluster's secret store to the project." \
+            2>&1 | tail -1 || echo "ok    pr      a pull request for this branch already exists"
