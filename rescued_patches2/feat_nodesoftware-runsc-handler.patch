index 000000000..de19d659a
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-probe
@@ -0,0 +1,40 @@
+#!/bin/bash
+#
+# nodesoftware-runsc-probe — verify we are running inside a gVisor runsc sandbox.
+#
+# Invoked by the NodeSoftwareOperator controller from inside a probe pod pinned
+# to the target node with runtimeClassName=gvisor. The probe pod IS scheduled
+# with runsc, so by the time this script runs, we are by definition inside a
+# gVisor kernel — the script just makes that observable so the controller's
+# successCondition regex can match.
+#
+# Emits a single line on stdout containing the detected kernel string. gVisor
+# sandboxes report a kernel version that contains "gvisor" in /proc/version;
+# this is the signal the controller's successCondition
+# [0-9.]+-gvisor-[0-9]+ locks on.
+#
+# Exit code:
+#   0 = inside gVisor, prints "verified: <kernel string>"
+#   1 = NOT inside gVisor, prints "FAILED: ..." on stderr
+#
+# Trap note: on bash 5.2, an EXIT trap normalises the script's exit code to 0
+# when the script is invoked via shebang and `set -e` triggers the failure path
+# (LAW 45 regression noted: the controller's reconcile_install.go checks the
+# pod's exit code via pod.Status, but we want the script's own exit code to be
+# honest too). ERR fires inside the script and does NOT override exit code.
+
+set -euo pipefail
+
+trap 'printf "probe: FAILED to detect gVisor kernel (rc=%%d)\n" "$?" >&2' ERR
+
+PROCVER="$(cat /proc/version 2>/dev/null || uname -a)"
+
+case "${PROCVER}" in
+*gvisor*)
+	printf 'verified: %s\n' "${PROCVER}"
+	;;
+*)
+	printf 'FAILED: proc=%s\n' "${PROCVER}" >&2
+	exit 1
+	;;
+esac
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall
new file mode 100755
index 000000000..439f69f88
--- /dev/null
+++ b/platform/nodesoftware-operator/runtimes/runsc/scripts/nodesoftware-runsc-uninstall
@@ -0,0 +1,41 @@
+#!/bin/bash
+#
+# nodesoftware-runsc-uninstall — remove gVisor runsc from a target node.
+#
+# Invoked by the NodeSoftwareOperator controller on a Rollback. Deletes the
+# cri-o drop-in, deletes the runsc binary, then reloads cri-o. If the binary
+# is missing, the script reports success anyway (idempotent — the goal is a
+# clean host state, not "binary removed if present").
+#
+# args:
+#   $1 = runsc version, e.g. "1.27.0" (informational only)
+#   $2 = host root as seen by the handler pod, default "/host"
+#
+# Trap note: see nodesoftware-runsc-probe — ERR, not EXIT, so bash 5.2's
+# shebang-exit-code trap normaliser doesn't clobber the script's exit status.
+
+set -euo pipefail
+
+trap 'printf "uninstall: FAILED before completion (rc=%%d) -- partial host state, check /etc/crio/crio.conf.d/99-gvisor.conf and /usr/local/sbin/runsc\n" "$?" >&2' ERR
+
+VERSION="${1:?usage: nodesoftware-runsc-uninstall <version> [host-root]}"
+HOST_ROOT="${2:-/host}"
+
+# 1. Remove the cri-o drop-in BEFORE removing the binary. If we removed the
+#    binary first, cri-o would still reference a path that no longer exists.
+rm -f "${HOST_ROOT}/etc/crio/crio.conf.d/99-gvisor.conf"
+
+# 2. Remove the runsc binary.
+rm -f "${HOST_ROOT}/usr/local/sbin/runsc"
+
+# 3. Best-effort reload of cri-o. We swallow errors because, on rollback,
+#    the binary may already be gone and cri-o might already be in a state
+#    where the runtime pointer is dangling.
+if ! nsenter --target 1 --mount --uts --ipc --net --pid -- \
+	/usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+	if ! chroot "${HOST_ROOT}" /usr/bin/systemctl reload cri-o.service >/dev/null 2>&1; then
+		printf 'WARN: could not reload cri-o.service; ops must reload manually\n' >&2
+	fi
+fi
+
+printf 'uninstalled runsc %s from %s\n' "${VERSION}" "${HOST_ROOT}"
diff --git a/platform/nodesoftware-operator/runtimes/runsc/scripts/test-handler.sh b/platform/nodesoftware-operator/runtimes/runsc/scripts/test-handler.sh
