diff --git a/bin/idp-oci-bootstrap b/bin/idp-oci-bootstrap
index 49fd193e3..4265d3784 100755
--- a/bin/idp-oci-bootstrap
+++ b/bin/idp-oci-bootstrap
@@ -92,6 +92,26 @@ if ! oci os bucket get "${O[@]}" -bn estate-tofu-state >/dev/null 2>&1; then
 else
   echo "os      bucket estate-tofu-state"
 fi
+# 2026-08-25 incident: the objects statement carried `where target.bucket.name='estate-tofu-state'`;
+# OCI stored it without the quotes and every PutObject from estate-tofu got 404, found only after
+# an apply had to be pushed by hand. Class: a policy granted on paper and never exercised by the
+# identity it was granted to. So exercise it: write and delete one object as estate-tofu.
+# BLIND (not FAIL) when the estate-tofu profile does not exist yet (bin/idp-oci-login writes it).
+probe_state_write() { # $1 bucket, $2 the estate-tofu user OCID the policy was written for
+  local bucket="$1" want="$2" profile="${OCI_TOFU_PROFILE:-DEFAULT}" cfg="${OCI_CLI_CONFIG_FILE:-$HOME/.oci/config}" have
+  # bin/idp-oci-login writes [DEFAULT] as estate-tofu; prove it is that user, not the tenancy owner,
+  # or the probe exercises the wrong identity and passes regardless of the policy (idp#119 review).
+  have=$(awk -v p="[$profile]" '$0==p{f=1;next} /^\[/{f=0} f&&/^user[ \t]*=/{sub(/^user[ \t]*=[ \t]*/,"");print}' "$cfg" 2>/dev/null)
+  [ -n "$have" ] || { echo "BLIND   state-write probe: no profile $profile in $cfg yet (bin/idp-oci-login); policy unexercised"; return 0; }
+  [ "$have" = "$want" ] || { echo "BLIND   state-write probe: profile $profile is not estate-tofu (${have:0:24}...); policy unexercised"; return 0; }
+  if printf ok | oci os object put --profile "$profile" -bn "$bucket" --name .write-probe --file - --force >/dev/null 2>&1; then
+    oci os object delete --profile "$profile" -bn "$bucket" --name .write-probe --force >/dev/null 2>&1 || true
+    echo "os      state-write probe ok: estate-tofu ($profile) can PutObject on $bucket"; return 0
+  fi
+  echo "FAIL    state-write probe: estate-tofu ($profile) cannot PutObject on $bucket; the objects policy statement is not in force (2026-08-25: OCI strips quotes from a where clause)" >&2
+  return 1
+}
+probe_state_write estate-tofu-state "$USER_ID"
 NS_VAL=$(oci os ns get "${O[@]}" --query data --raw-output); printf %s "$NS_VAL" | vput OCI_OS_NAMESPACE
 if [ ! -e "$VAULT/secrets/$ENV_NAME/OCI_S3_SECRET_KEY.yaml" ]; then
   SK=$(oci iam customer-secret-key create "${O[@]}" --user-id "$USER_ID" --display-name estate-tofu-state)
diff --git a/tests/test_incident_policy_granted_never_exercised.py b/tests/test_incident_policy_granted_never_exercised.py
new file mode 100644
index 000000000..0bffa9dc3
--- /dev/null
+++ b/tests/test_incident_policy_granted_never_exercised.py
@@ -0,0 +1,53 @@
+"""Incident 2026-08-25: bin/idp-oci-bootstrap wrote an objects policy with a quoted
+where clause; OCI stored it unquoted and estate-tofu got 404 on every PutObject,
+found only when an apply could not save state. Rule: bootstrap exercises the
+policy it writes with a real PutObject as estate-tofu, and only as estate-tofu
+(idp#119 review: a probe as the tenancy owner passes regardless of the policy).
+Rung 4 (incident test), driven both ways through a fake `oci` on PATH."""
+import os
+import subprocess
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TOFU = "ocid1.user.oc1..tofu"
+OWNER = "ocid1.user.oc1..owner"
+FN = ('source <(sed -n "/^probe_state_write()/,/^}/p" bin/idp-oci-bootstrap); '
+      f'probe_state_write estate-tofu-state {TOFU}')
+
+
+def _run(tmp_path: Path, put_rc: int, profile_user: str | None = TOFU) -> subprocess.CompletedProcess:
+    fake = tmp_path / "oci"
+    fake.write_text(
+        "#!/usr/bin/env bash\n"
+        'echo "$*" >> "$FAKE_LOG"\n'
+        f'case "$*" in *"object put"*) exit {put_rc};; *) exit 0;; esac\n'
+    )
+    fake.chmod(0o755)
+    cfg = tmp_path / "config"
+    cfg.write_text(f"[DEFAULT]\nuser={profile_user}\nregion=x\n" if profile_user else "[estate-bootstrap]\nuser=z\n")
+    env = {**os.environ, "PATH": f"{tmp_path}:{os.environ['PATH']}",
+           "OCI_CLI_CONFIG_FILE": str(cfg), "FAKE_LOG": str(tmp_path / "log")}
+    env.pop("OCI_TOFU_PROFILE", None)
+    return subprocess.run(["bash", "-c", FN], cwd=ROOT, env=env, capture_output=True, text=True)
+
+
+def test_must_fail_when_put_object_is_refused(tmp_path: Path) -> None:
+    r = _run(tmp_path, put_rc=1)
+    assert r.returncode == 1 and "FAIL    state-write probe" in r.stderr
+
+
+def test_must_pass_when_put_object_succeeds_as_estate_tofu(tmp_path: Path) -> None:
+    r = _run(tmp_path, put_rc=0)
+    assert r.returncode == 0 and "state-write probe ok" in r.stdout
+    assert "--profile DEFAULT" in (tmp_path / "log").read_text()
+
+
+def test_blind_when_profile_is_not_estate_tofu(tmp_path: Path) -> None:
+    r = _run(tmp_path, put_rc=0, profile_user=OWNER)
+    assert r.returncode == 0 and "BLIND" in r.stdout and "not estate-tofu" in r.stdout
+    assert not (tmp_path / "log").exists()  # no PutObject as the wrong identity
+
+
+def test_blind_without_profile_permits_and_says_so(tmp_path: Path) -> None:
+    r = _run(tmp_path, put_rc=1, profile_user=None)
+    assert r.returncode == 0 and "BLIND" in r.stdout
