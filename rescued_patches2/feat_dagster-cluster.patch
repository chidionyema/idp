+# crew#716: the estate-scheduler image rolls on every main build, the same way the
+# other images do (sovereign-worker, estate-mcp). build-multiarch pushes
+# ghcr.io/chidionyema/estate-scheduler:main-<run>-<sha>; the policy picks the highest run and
+# the ImageUpdateAutomation writes it into platform/dagster/dagster.yaml on flux/image-updates.
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: estate-scheduler
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/estate-scheduler
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: estate-scheduler
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: estate-scheduler
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
