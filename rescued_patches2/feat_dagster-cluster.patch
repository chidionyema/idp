diff --git a/platform/edge/dagster-exception.yaml b/platform/edge/dagster-exception.yaml
new file mode 100644
index 000000000..e3c5853db
--- /dev/null
+++ b/platform/edge/dagster-exception.yaml
@@ -0,0 +1,52 @@
+# The estate scheduler (crew#716) uses Dagster's built-in postgres subchart, which reads
+# POSTGRES_PASSWORD from an environment variable sourced by secretKeyRef. The same pattern
+# appears in the dagster-webserver, dagster-daemon and every launched run pod: DAGSTER_PG_PASSWORD
+# is passed the same way from the dagster-postgresql-secret Secret.
+#
+# Verified with `helm template dagster dagster/dagster --version 1.13.19` (rendered output in
+# .wt-scratch-render.yaml):
+#   - dagster-webserver Deployment: env[].valueFrom.secretKeyRef name DAGSTER_PG_PASSWORD
+#   - dagster-daemon Deployment: env[].valueFrom.secretKeyRef name DAGSTER_PG_PASSWORD
+#   - dagster-user-deployments Deployment (estate-scheduler): same pattern
+#   - every launched run Job (k8sRunLauncher): same pattern
+#   - postgresql StatefulSet: env[].valueFrom.secretKeyRef name dagster-postgresql
+#     key postgresql-password (POSTGRES_PASSWORD)
+# There is no file form without a wrapper: the chart writes env.valueFrom.secretKeyRef directly
+# into its templates, and the values file offers no alternative.
+#
+# This exception follows the same shape as platform/edge/autoscaler-exception.yaml: the same four
+# ruleNames, the same kinds, scoped to the dagster namespace.
+apiVersion: kyverno.io/v2
+kind: PolicyException
+metadata:
+  name: dagster-password-from-secret
+  namespace: kyverno
+spec:
+  exceptions:
+    # require-ro-rootfs, measured on the 1.13.19 render (crew#716): the dagster image runs
+    # Python that writes /tmp (grpc, tempfiles) and $DAGSTER_HOME; docker.io/library/postgres
+    # writes /var/run/postgresql and its PGDATA mount. Neither image ships a read-only-root
+    # mode and the chart offers no scratch-mount values for it. Same class and same shape as
+    # the Lago rows in commerce-exception.yaml beside this file; reconsidered when the layer
+    # is retested against running pods on the drill cluster (the crew#716 CP2 item).
+    - policyName: require-ro-rootfs
+      ruleNames:
+        - validate-readOnlyRootFilesystem
+        - autogen-validate-readOnlyRootFilesystem
+    - policyName: secrets-not-from-env-vars
+      ruleNames:
+        - secrets-not-from-env-vars
+        - secrets-not-from-envfrom
+        - autogen-secrets-not-from-env-vars
+        - autogen-secrets-not-from-envfrom
+  match:
+    any:
+      - resources:
+          kinds:
+            - Deployment
+            - Pod
+            - ReplicaSet
+            - Job
+            - StatefulSet
+          namespaces:
+            - dagster
