diff --git a/backstage/app-config.container.yaml b/backstage/app-config.container.yaml
new file mode 100644
index 000000000..6872c45d3
--- /dev/null
+++ b/backstage/app-config.container.yaml
@@ -0,0 +1,102 @@
+# What changes when the catalogue runs in a container instead of `yarn start`.
+#
+# Layered on top of app-config.yaml, which stays the source for everything that
+# is the same in both. Backstage replaces arrays rather than merging them, so
+# every `catalog.locations` entry has to be restated here, not just the one that
+# moves.
+
+app:
+  # One origin. Under `yarn start` the app was a separate dev server on 3100 and
+  # the backend was on 7107, which is why this repo carried two ports, two
+  # health probes and a CORS rule between its own halves. The image runs
+  # @backstage/plugin-app-backend, so the backend serves the UI: one process,
+  # one port, one bind, and CORS between the app and its own API stops being a
+  # thing that can be misconfigured.
+  #
+  # The origin itself is not this file's to know: it is wherever the platform
+  # publishes the portal, so it comes from the environment (LAW 46). Review on
+  # idp#125: a literal localhost here made every browser catalog call fail on
+  # the cluster. platform/backstage/overlays/oke sets APP_BASE_URL.
+  baseUrl: ${APP_BASE_URL}
+
+auth:
+  providers:
+    guest:
+      # The image sets NODE_ENV=production, and Backstage refuses the guest
+      # provider outside development unless this is set. Measured on the first
+      # container boot, 2026-08-24: `POST /api/auth/guest/refresh` returned 403
+      # and every catalog read returned 401, while `GET /` returned 200 -- a
+      # portal that renders, serves no data, and cannot be signed into. Under
+      # `yarn start` NODE_ENV was development and this never appeared, which is
+      # the kind of difference containerising exists to surface.
+      #
+      # The flag is named "dangerously" because it makes anyone who can reach
+      # the port a signed-in user. The boundary is one layer out and today it is
+      # the cluster itself: the Service in platform/backstage/base/catalogue.yaml
+      # is ClusterIP, platform/edge carries no route for it, so the only way to
+      # reach the port is `kubectl port-forward` with cluster credentials.
+      # The PR that adds the public route must put identity in front of it in
+      # the same change (ADR 0003, OIDC at the gateway) or turn this flag off;
+      # tests/test_incident_backstage_image_critical_cve.py holds that rule.
+      dangerouslyAllowOutsideDevelopment: true
+
+backend:
+  baseUrl: ${APP_BASE_URL}
+  listen:
+    port: 3100
+    # 0.0.0.0 INSIDE the container, 127.0.0.1 on the host. These are not in
+    # conflict and the distinction is the whole point of R20 (the gateway is the
+    # only process that binds a non-loopback address).
+    #
+    # The container's network namespace is not the host's. A process that binds
+    # 127.0.0.1 inside a container is reachable only from that container -- the
+    # published port cannot forward to it and `docker compose up` produces a
+    # service nothing can reach. What R20 governs is the HOST bind, and compose.yml
+    # publishes `127.0.0.1:3100:3100`, so `lsof` on this machine sees the loopback
+    # and nothing on the LAN can reach the catalogue.
+    #
+    # It also removes the [::1] versus 127.0.0.1 split that made `curl
+    # 127.0.0.1:3100` return 000 while a browser on the same machine got 200.
+    host: 0.0.0.0
+  csp:
+    connect-src: ["'self'", 'http:', 'https:']
+  database:
+    # Postgres, not the in-memory sqlite of app-config.yaml. Two reasons, and
+    # neither is preference. `:memory:` means every restart re-ingests the whole
+    # estate from files and serves an empty catalogue until it finishes --
+    # measured 2026-08-24, ingestion took 124 seconds after boot, during which
+    # the portal renders and looks correct with nothing in it. And Postgres is
+    # what the k8s deployment will use, so Phase 2 changes where the database
+    # runs, not which database it is.
+    client: pg
+    connection:
+      host: ${POSTGRES_HOST}
+      port: ${POSTGRES_PORT}
+      user: ${POSTGRES_USER}
+      password: ${POSTGRES_PASSWORD}
+      database: ${POSTGRES_DB}
+
+catalog:
+  locations:
+    # The estate. Generated on the host by bin/catalog-gen from the LAW 39
+    # inventory, and bind-mounted read-only at /estate. It is deliberately not
+    # baked into the image: the image is a build artefact that Phase 2 ships to
+    # k8s unchanged, and the inventory changes hourly. Baking it in would make
+    # every inventory refresh an image rebuild.
+    - type: file
+      target: /estate/catalog-info.yaml
+      rules:
+        - allow: [Component, Resource, Domain, System, Group]
+
+    # The only scaffolder template the portal offers.
+    - type: file
+      target: /app/templates/estate-component/template.yaml
+      rules:
+        - allow: [Template]
+
+    # user:default/guest. The guest auth provider resolves it through the
+    # catalog, so this is sign-in, not example data.
+    - type: file
+      target: /app/examples/org.yaml
+      rules:
+        - allow: [User, Group]
