diff --git a/platform/backstage/overlays/oke/backstage-external-secret.yaml b/platform/backstage/overlays/oke/backstage-external-secret.yaml
new file mode 100644
index 000000000..9ca394811
--- /dev/null
+++ b/platform/backstage/overlays/oke/backstage-external-secret.yaml
@@ -0,0 +1,13 @@
+# backstage-env from OCI Vault secret backstage-env (JSON: BACKEND_SECRET, POSTGRES_PASSWORD),
+# through ClusterSecretStore oci-vault (crew#227 CP3). Replaced backstage-env.sops.yaml.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: backstage-env
+  namespace: backstage
+spec:
+  refreshInterval: 1h
+  secretStoreRef: { kind: ClusterSecretStore, name: oci-vault }
+  target: { name: backstage-env, creationPolicy: Owner }
+  dataFrom:
+    - extract: { key: backstage-env }
