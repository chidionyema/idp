diff --git a/platform/prospector/store-api-external-secret.yaml b/platform/prospector/store-api-external-secret.yaml
new file mode 100644
index 000000000..f55829018
--- /dev/null
+++ b/platform/prospector/store-api-external-secret.yaml
@@ -0,0 +1,13 @@
+# store-api env from OCI Vault secret prospector-store-api-env (one JSON object holding the
+# nine keys), through ClusterSecretStore oci-vault (crew#227 CP3). Replaced store-api-env.sops.yaml.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: prospector-store-api-env
+  namespace: prospector
+spec:
+  refreshInterval: 1h
+  secretStoreRef: { kind: ClusterSecretStore, name: oci-vault }
+  target: { name: prospector-store-api-env, creationPolicy: Owner }
+  dataFrom:
+    - extract: { key: prospector-store-api-env }
diff --git a/tests/test_incident_eso_controller_without_probes.py b/tests/test_incident_eso_controller_without_probes.py
index 30e044aae..dd0aa15e5 100644
--- a/tests/test_incident_eso_controller_without_probes.py
+++ b/tests/test_incident_eso_controller_without_probes.py
@@ -25,3 +25,17 @@ def test_cloudflare_token_comes_from_oci_vault_not_sops() -> None:
     assert d["kind"] == "ExternalSecret"
     assert d["spec"]["secretStoreRef"] == {"kind": "ClusterSecretStore", "name": "oci-vault"}
     assert not (ROOT / "platform/prospector/cloudflare.sops.yaml").exists()
+
+
+def test_no_sops_files_remain_under_platform() -> None:
+    # crew#227 CP3: the sops-age key goes when the last sops file is gone.
+    assert not list(ROOT.glob("platform/**/*.sops.yaml"))
+
+
+def test_every_platform_external_secret_uses_oci_vault() -> None:
+    files = list(ROOT.glob("platform/**/*external-secret.yaml"))
+    assert len(files) >= 3
+    for f in files:
+        d = yaml.safe_load(f.read_text())
+        assert d["kind"] == "ExternalSecret", f
+        assert d["spec"]["secretStoreRef"] == {"kind": "ClusterSecretStore", "name": "oci-vault"}, f
