+pb_store_generation_state() {
+  # THE SHOP HAS INVENTORY AND NO NEW LISTINGS, AND THAT IS ON PURPOSE.
+  #
+  # Founder, 2026-09-09: "the site does have inventory but no new listing for a month" and, when
+  # asked to resume it: "we cant turn it on yet, we need to earn the token first ... it runs
+  # constantly." Generation is a continuous spender. It is off because the money is not there
+  # yet, not because anything failed.
+  #
+  # This playbook therefore READS and never clears. An earlier draft of it disarmed the pause
+  # automatically, which would have switched on the estate's largest running cost to fix what
+  # looked like a fault and was a decision.
+  #
+  # What it is for: the decision has no surface. prospector-scheduler announces it on every tick
+  # to nobody --
+  #
+  #   CRITICAL Generation suppressed: generation paused:
+  #            /data/store/scheduler/PAUSE_GENERATION present (the drain still runs)
+  #   WARNING  ALERT [critical] Generation DEAD: 4 consecutive barren ticks
+  #   WARNING  Telegram alert NOT sent: TELEGRAM_BOT_TOKEN and TELEGRAM_HOME_CHANNEL unset
+  #
+  # -- and prospector/ops/console_api.py, which implements pause.arm and pause.disarm with an
+  # actor, a reason and a receipt, is not deployed: the namespace runs store-api and store-web
+  # and nothing else. So a deliberate, indefinite, revenue-shaped decision is legible only to
+  # someone with a shell on a pod, and reads from outside as a month-long outage. That is the
+  # defect this closes: not the pause, the silence around it.
+  #
+  # Turning generation back on is a spend decision and belongs to the founder in his own words.
+  # When it comes, the audited path is the product's own:
+  #   kubectl -n prospector exec <scheduler> -c scheduler -- \
+  #     python -m prospector.ops.pause disarm generation --actor <name>
+  local pod out
+  pod=$($K get pods -n prospector -o name 2>/dev/null | grep scheduler | head -1 | cut -d/ -f2)
+  [ -n "$pod" ] || { echo "FAIL  store-generation-state: no scheduler pod in prospector"; FAILED="$FAILED guard-pod"; return 1; }
+  echo "ok    guard-pod the scheduler is $pod"
+
+  echo "--- the three pause scopes, with whoever armed them and why"
+  out=$($K exec -n prospector "$pod" -c scheduler -- python -m prospector.ops.pause show 2>&1) || true
+  echo "$out"
+  case "$out" in
+    *'"scope": "generation"'*) echo "ok    pause-show the scheduler reported its pause state" ;;
+    *) echo "FAIL  store-generation-state: the scheduler could not report its pause state"
+       FAILED="$FAILED pause-show"; return 1 ;;
+  esac
+
+  # The pause is one reason nothing is listed. The other is that the generation chain has no
+  # brain -- the same tick logs "Heartbeat: 0 alive, 21 down" and "Failed ollama_raw_call", and
+  # the model keys arrive over the external-secrets path the node partition severed. Both are
+  # named here so that clearing one is never mistaken for clearing both.
+  echo "--- the brains, as the scheduler last measured them"
+  show heartbeat $K logs -n prospector "$pod" -c scheduler --tail=200
+}
