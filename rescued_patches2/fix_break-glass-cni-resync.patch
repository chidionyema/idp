+pb_cni_resync() {
+  local nodes n i=0 targets ip
+  $K get ds -n kube-system calico-node >/dev/null 2>&1 || { echo "FAIL  cni-resync: no calico-node DaemonSet in kube-system"; FAILED="$FAILED guard-ds"; return 1; }
+  step "calico-restart" $K -n kube-system rollout restart ds calico-node
+  step "calico-rolled" $K -n kube-system rollout status ds calico-node --timeout=240s
+  nodes=$($K get nodes -o jsonpath='{.items[*].metadata.name}')
+  for n in $nodes; do
+    i=$((i+1)); targets=""
+    for ip in $($K get pods -A -o jsonpath='{range .items[?(@.spec.nodeName!="'"$n"'")]}{.metadata.namespace}/{.metadata.labels.app}/{.status.podIP}{"\n"}{end}' 2>/dev/null | grep -E '^(llm/litellm/|llm/litellm-cache/|llm/redis/)' | cut -d/ -f3); do
+      [ -n "$ip" ] && targets="$targets $ip:4000 $ip:6379"
+    done
+    for ip in $($K get pods -n kube-system -l k8s-app=kube-dns -o jsonpath='{range .items[?(@.spec.nodeName!="'"$n"'")]}{.status.podIP}{"\n"}{end}' 2>/dev/null); do
+      targets="$targets $ip:53"
+    done
+    echo "--- node $n -> other node: ${targets:-nothing on the other node}"
+    [ -n "$targets" ] && tcp_probe "cni-probe-$i" "$n" kube-system "$targets"
+    dns_probe "cni-dns-$i" "$n" kubernetes.default.svc.cluster.local
+  done
+  show calico-node $K get pods -n kube-system -l k8s-app=calico-node -o wide
+}
