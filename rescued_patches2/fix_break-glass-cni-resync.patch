-  namespace: cyrus
-spec:
-  accessModes: [ReadWriteOnce]
-  resources: { requests: { storage: 1Gi } }
----
-apiVersion: v1
-kind: ServiceAccount
-metadata:
-  name: cyrus
-  namespace: cyrus
----
