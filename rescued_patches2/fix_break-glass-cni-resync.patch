+# cni-resync (2026-09-09, incident: OKE re-rolled kube-flannel on both nodes at 10:34Z; from then on
+# a pod on one node reached a pod on the other only some of the time, both CoreDNS replicas sat on
+# .221 while the router sat on .197, and every second router call died at Traefik's 30s timeout).
+# Calico is the dataplane (pods carry Calico IPAM addresses; flannel's leases are unused), so the
+# repair is Calico re-programming its VXLAN routes on EVERY node, not one. The session identity
+# (agents:agent-reader) cannot touch kube-system by design (WJ.5), so this is the door.
+# Receipt: one TCP probe pinned to each node against the router, its cache and each CoreDNS pod
+# on the OTHER node, and an nslookup pinned to each node. A probe that cannot reach is a FAIL.
+# flannel-off: incident 2026-09-09. Two dataplanes ran on one cluster -- Oracle's kube-flannel-ds
+# add-on beside calico-node -- and both speak VXLAN on port 4789. When flannel re-rolled at 10:34Z
+# with new VTEP MACs it took the cross-node path with it: a router replica on one node died with
+# `redis.exceptions.TimeoutError` reaching its cache on the other, and half of every request that
+# entered through the gateway pod on the far node hung until the gateway gave up at 30s. Restarting
+# calico-node alone did not fix it (run 34353905638) because flanneld still held the port.
+#
+# Nothing is deleted. The DaemonSet is given a nodeSelector no node carries, so flanneld stops and
+# one patch puts it back; the flannel.1 links and their routes stay, inert, for subnets holding no
+# pod. Two guards run first: calico-node must be Ready on every node, and every pod address must
+# fall inside a Calico IPPool, so a pod that actually depends on flannel stops this before it acts.
+# gateway-one-node: the 2026-09-09 band-aid, founder-approved at 16:12Z. Cross-node pod traffic
+# has been severed since flannel re-rolled at 10:34Z, and parking flanneld did not restore it.
+# The gateway runs one pod per node while the router has one ready backend, so every request that
+# entered through the far gateway pod crossed the dead link and hung: measured over fifteen
+# minutes, 25 answers and no failure through the pod beside the router, and 8 gateway timeouts
+# plus 17 abandoned requests and no answer at all through the pod on the other node.
+#
+# The Service is externalTrafficPolicy Local, so a node with no gateway pod fails its load
+# balancer health check and stops receiving traffic at all. Cordon the far node, move the gateway
+# and DNS pods off it, and nothing crosses the link. The gateway's hostname spread constraint is
+# maxSkew 1 DoNotSchedule, so its second replica stays Pending while the node is cordoned -- that
+# is the intended state, not a fault, and it is why this playbook does NOT uncordon at the end.
+# Reverse it with node-uncordon once the link is repaired.
+#
+# The node is never named as a literal (R46): the good node is the one holding the ready router
+# backend, and the far node is the other one.
+# routed-backend-rescue: after gateway-one-node has pinned the ingress path to one node, every
+# routed backend still sitting on the cordoned node is unreachable from outside -- the gateway is
+# not there and externalTrafficPolicy Local means the load balancer stopped using that node. On
+# 2026-09-09 that was mumchimp.com: prospector-store-web had a replica on the serving node, but
+# prospector-store-api had its only replica on the severed one, so the shop returned nothing at
+# all rather than half the time. Deleting such a pod reschedules it onto the node that can serve.
+#
+# It cannot be a sweep. Thirty one workloads were stranded needing 3022m CPU against 108m free, so
+# the order matters, and the cluster's own answer was wrong: langfuse-web was infrastructure-critical
+# and the shop had no priority class at all. platform/ingress-recovery-order.yaml holds the order a
+# person decided; this reads it, moves what fits, and names what did not.
+pb_routed_backend_rescue() {
+  local good bad n order out kind TMP
+  TMP=$(mktemp -d); trap 'rm -rf "$TMP"' RETURN
+  order="$IDP/platform/ingress-recovery-order.yaml"
+  [ -f "$order" ] || { echo "FAIL  routed-backend-rescue: no $order, nothing says what comes back first"; FAILED="$FAILED guard-order"; return 1; }
+
+  bad=$($K get nodes -o jsonpath='{range .items[?(@.spec.unschedulable==true)]}{.metadata.name}{"\n"}{end}' | head -1)
+  [ -n "$bad" ] || { echo "ok    routed-backend-rescue: no cordoned node, nothing is stranded by this band-aid"; return 0; }
+  good=""
+  for n in $($K get nodes -o jsonpath='{.items[*].metadata.name}'); do [ "$n" = "$bad" ] || good=$n; done
+  [ -n "$good" ] || { echo "FAIL  routed-backend-rescue: every node is cordoned"; FAILED="$FAILED guard-good"; return 1; }
+  echo "ok    guard-nodes stranded on $bad, rescuing onto $good"
+
+  $K get pods -A -o json > "$TMP/pods.json" 2>/dev/null || { echo "FAIL  routed-backend-rescue: cannot read pods"; FAILED="$FAILED guard-read"; return 1; }
+  $K get svc -A -o json > "$TMP/svcs.json" 2>/dev/null || true
+  $K get node "$good" -o json > "$TMP/good.json" 2>/dev/null || true
+
+  # the plan is computed once, printed, and only then executed: a rescue that half-runs and then
+  # discovers it has no room has spent the room on the wrong thing
+  python3 - "$order" "$TMP/pods.json" "$TMP/svcs.json" "$TMP/good.json" "$bad" "$good" > "$TMP/plan.txt" <<'PYPLAN'
+import json, re, sys
+order_file, pods_file, svcs_file, good_file, bad, good = sys.argv[1:7]
+order, yields, internal, section = [], [], [], None
+for line in open(order_file):
+    head = line.split("#")[0].rstrip()
+    if re.match(r"^order:\s*$", head): section = order; continue
+    if re.match(r"^yield:\s*$", head): section = yields; continue
+    if re.match(r"^internal:\s*$", head): section = internal; continue
+    m = re.match(r"^\s*-\s*(\S+/\S+)\s*$", head)
+    if m and section is not None: section.append(m.group(1))
+pods = json.load(open(pods_file))["items"]
+svcs = json.load(open(svcs_file)).get("items", [])
+node = json.load(open(good_file))
+
+def cpu(v):
+    if not v: return 0
+    return int(v[:-1]) if str(v).endswith("m") else int(float(v) * 1000)
+def mem(v):
+    if not v: return 0
+    v = str(v)
+    for suf, mult in (("Gi", 1024), ("Mi", 1), ("Ki", 1 / 1024)):
+        if v.endswith(suf): return int(float(v[:-2]) * mult)
+    return int(int(v) / 1048576)
+def req(p):
+    c = sum(cpu(((x.get("resources") or {}).get("requests") or {}).get("cpu")) for x in p["spec"]["containers"])
+    m = sum(mem(((x.get("resources") or {}).get("requests") or {}).get("memory")) for x in p["spec"]["containers"])
+    return c, m
+
+alloc = node.get("status", {}).get("allocatable", {})
+free_c = cpu(alloc.get("cpu")) - sum(req(p)[0] for p in pods
+    if p["spec"].get("nodeName") == good and p["status"].get("phase") in ("Running", "Pending"))
+free_m = mem(alloc.get("memory")) - sum(req(p)[1] for p in pods
+    if p["spec"].get("nodeName") == good and p["status"].get("phase") in ("Running", "Pending"))
+print(f"# room on {good}: {free_c}m cpu {free_m}Mi memory")
+
+sel = {}
+for s in svcs:
+    key = s["metadata"]["namespace"] + "/" + s["metadata"]["name"]
+    sel[key] = (s["metadata"]["namespace"], (s["spec"].get("selector") or {}))
+
+def owned_by(p, ns, name):
+    # A pod belongs to the workload `name` when what follows the name is the generated part and
+    # nothing else: a ReplicaSet hash plus a pod suffix, or a StatefulSet ordinal. Plain
+    # startswith() is wrong here and quietly so -- `external-secrets` prefixes
+    # `external-secrets-cert-controller` and `external-secrets-webhook`, so the plan believed the
+    # secrets controller had a healthy peer on the serving node when it had none at all, and
+    # emitted an eviction where a rescue was needed.
+    if p["metadata"]["namespace"] != ns: return False
+    n = p["metadata"]["name"]
+    if not n.startswith(name + "-"): return False
+    rest = n[len(name) + 1:]
+    return rest.count("-") == 1 or rest.isdigit()
+
+def yield_sources(want):
+    # Room comes from the declared yield list and from nowhere else.
+    #
+    # This function briefly also returned everything ranked below `want`, on the reasoning that a
+    # rank which cannot take room back is not a rank. Run against the live cluster on 2026-09-09
+    # that plan proposed scaling `prospector-store-web` to zero -- the storefront itself -- to make
+    # room for the storefront's API, and scaling `external-secrets` to zero for a Langfuse
+    # dashboard that came out stranded anyway. The rank is the order things are brought BACK in.
+    # Reading it as an order things may be killed in turns a rescue into the outage.
+    #
+    # What a surface may cost is therefore only ever what this estate has written down, in
+    # advance, as sheddable. The scheduler protects a seated pod from later arrivals; that is a
+    # priority class's job (platform/priority-classes), not this playbook's.
+    return list(yields)
+
+def take_room(y):
+    yns, yname = y.split("/", 1)
+    held = [q for q in pods if q["spec"].get("nodeName") == good
+            and owned_by(q, yns, yname)
+            and q["status"].get("phase") == "Running"]
+    if not held:
+        return None
+    yc = sum(req(q)[0] for q in held); ym = sum(req(q)[1] for q in held)
+    if y in yields:
+        yields.remove(y)
+    print(f"YIELD {yns} {yname} {len(held)} {yc}m {ym}Mi")
+    return yc, ym
+
+# internal controllers are matched by Deployment name; no HTTPRoute names them, and several run
+# with no Service at all, but a severed link breaks them exactly the same way
+for want in order + internal:
+    by_name = want in internal
+    if by_name:
+        ns, prefix = want.split("/", 1)
+        def backs(p, ns=ns, prefix=prefix):
+            return owned_by(p, ns, prefix)
+    else:
+        ns_sel = sel.get(want)
+        if not ns_sel or not ns_sel[1]:
+            print(f"# skip {want}: no such Service, or it selects nothing")
+            continue
+        ns, labels = ns_sel
+        def backs(p, ns=ns, labels=labels):
+            L = p["metadata"].get("labels") or {}
+            return p["metadata"]["namespace"] == ns and all(L.get(k) == v for k, v in labels.items())
+    on_good = [p for p in pods if backs(p) and p["spec"].get("nodeName") == good
+               and p["status"].get("phase") == "Running"
+               and all(c.get("ready") for c in (p["status"].get("containerStatuses") or []))]
+    on_bad = [p for p in pods if backs(p) and p["spec"].get("nodeName") == bad
+              and p["status"].get("phase") == "Running"]
+    # A surface can be dark without a single pod on the cordoned node. When the scheduler
+    # preempts its pod and cannot seat the replacement, the pod sits Pending on no node at all,
+    # and a rescue that only ever asks "what is stranded on the bad node" walks straight past it.
+    # That is how the storefront API went dark a second time on 2026-09-09: hermes-agent-gateway,
+    # rated infrastructure-critical, took its 1088Mi, and the shop's own API -- priority 0 --
+    # had nowhere to land. Nothing needs moving here; room needs making.
+    unseated = [p for p in pods if backs(p) and not p["spec"].get("nodeName")
+                and p["status"].get("phase") == "Pending"]
+    if not on_bad:
+        if on_good or not unseated:
+            print(f"# skip {want}: nothing of it on {bad}")
+            continue
+        c, m = req(unseated[0])
+        if c <= free_c and m <= free_m:
+            print(f"# skip {want}: {unseated[0]['metadata']['name']} is Pending but {good} already has room for it")
+            continue
+        made_c, made_m = free_c, free_m
+        for y in yield_sources(want):
+            if c <= made_c and m <= made_m: break
+            got = take_room(y)
+            if got: made_c += got[0]; made_m += got[1]
+        if c > made_c or m > made_m:
+            print(f"# STRANDED {want}: {c}m/{m}Mi unseatable, only {made_c}m/{made_m}Mi after every yield")
+            continue
+        free_c, free_m = made_c - c, made_m - m
+        print(f'ROOM {ns} {unseated[0]["metadata"]["name"]} {want} {c}m {m}Mi')
+        continue
+    if on_good:
+        # A stranded pod is still an endpoint of the Service, so the gateway keeps sending it
+        # traffic that goes nowhere. mumchimp.com came back at two requests in three for exactly
+        # this reason after the API was rescued: one storefront replica served, the other was a
+        # black hole. Removing it needs no room -- it is not being brought back, it is being
+        # taken out of rotation, and the Deployment reschedules it if and when there is space.
+        for q in on_bad:
+            print(f'EVICT {q["metadata"]["namespace"]} {q["metadata"]["name"]} {want} blackhole-endpoint')
+        continue
+    p = on_bad[0]
+    c, m = req(p)
+    if c > free_c or m > free_m:
+        # Room comes from the declared yield list first, then from routed services ranked BELOW
+        # this one. Without the second source the rescue eats its own room: on 2026-09-09 the
+        # storefront API was seated, six lower-ranked surfaces were rescued after it, and when
+        # the API's pod was later replaced there was no longer anywhere to put it -- the shop
+        # went back to serving a page with no catalogue. A rank that cannot take room back is
+        # not a rank, it is a wish.
+        for y in yield_sources(want):
+            if c <= free_c and m <= free_m: break
+            got = take_room(y)
+            if got: free_c += got[0]; free_m += got[1]
+        if c > free_c or m > free_m:
+            print(f"# STRANDED {want}: needs {c}m/{m}Mi, only {free_c}m/{free_m}Mi left after every yield")
+            continue
+    free_c -= c; free_m -= m
+    print(f'MOVE {p["metadata"]["namespace"]} {p["metadata"]["name"]} {want} {c}m {m}Mi')
+print(f"# room after the plan: {free_c}m cpu {free_m}Mi memory")
+PYPLAN
+  echo "--- the plan"
+  cat "$TMP/plan.txt"
+
+  out=$(grep -cE '^(YIELD|MOVE|EVICT|ROOM) ' "$TMP/plan.txt" || true)
+  if [ "${out:-0}" -eq 0 ]; then
+    echo "ok    routed-backend-rescue nothing both stranded and affordable; the lines above say why"
+    return 0
+  fi
+
+  # yields first: the room has to exist before the rescued pod is scheduled
+  while read -r _ ns name n c m; do
+    # a yielded workload is a Deployment or a StatefulSet; observability/signoz is the latter, and
+    # `scale deploy` on it fails with "not found", which would leave the room unclaimed
+    # Three shapes hold a pod on a node and each yields differently. `scale` is the answer for a
+    # Deployment and a StatefulSet (observability/signoz is the latter, and `scale deploy` on it
+    # fails "not found", which would leave the room unclaimed). A CronJob answers to neither: it
+    # has no replicas, and its pods belong to Jobs it creates on a timer, so scaling reaches
+    # nothing and the next tick puts the pod straight back. It yields by having its schedule
+    # suspended and its active runs deleted -- 2026-09-09, when a batch job failing every fifteen
+    # minutes held the storefront API off the only working node.
+    if $K -n "$ns" get deploy "$name" >/dev/null 2>&1; then
+      echo "--- $ns/$name yields $c $m ($n pod(s)); restore with: kubectl -n $ns scale deploy/$name --replicas=<n>"
+      step "yield-$name" $K -n "$ns" scale "deploy/$name" --replicas=0
+    elif $K -n "$ns" get statefulset "$name" >/dev/null 2>&1; then
+      echo "--- $ns/$name yields $c $m ($n pod(s)); restore with: kubectl -n $ns scale statefulset/$name --replicas=<n>"
+      step "yield-$name" $K -n "$ns" scale "statefulset/$name" --replicas=0
+    elif $K -n "$ns" get cronjob "$name" >/dev/null 2>&1; then
+      echo "--- $ns/$name yields $c $m ($n pod(s)); restore with: kubectl -n $ns patch cronjob/$name -p '{\"spec\":{\"suspend\":false}}'"
+      step "yield-$name-suspend" $K -n "$ns" patch cronjob "$name" -p '{"spec":{"suspend":true}}'
+      # only this CronJob's own runs: a Job it created is named <cronjob>-<timestamp>, and a
+      # namespace may hold other jobs that nothing here asked to shed.
+      for j in $($K -n "$ns" get jobs -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null | grep -E "^$name-[0-9]+$" || true); do
+        step "yield-$name-job-$j" $K -n "$ns" delete job "$j" --wait=false
+      done
+    else
+      echo "FAIL  yield-$name $ns/$name is neither a Deployment, a StatefulSet nor a CronJob; the room was not freed"
+      FAILED="$FAILED yield-$name"
+    fi
+  done < <(grep '^YIELD ' "$TMP/plan.txt" || true)
+
+  while read -r _ ns pod svc c m; do
+    echo "--- rescuing $svc ($c $m) from $bad"
+    step "rescue-$pod" $K -n "$ns" delete pod "$pod" --wait=false
+  done < <(grep '^MOVE ' "$TMP/plan.txt" || true)
+
+  # a ROOM line needs no pod action: the yields above already freed what the scheduler was short
+  # of, and the Pending pod is seated by the scheduler itself on its next pass. Naming it here is
+  # what makes the settle check below mean something rather than a blind sleep.
+  while read -r _ ns pod svc c m; do
+    echo "--- $svc has no serving pod; $pod was unseatable at $c $m and now has room on $good"
+  done < <(grep '^ROOM ' "$TMP/plan.txt" || true)
+
+  # a black-hole endpoint costs nothing to remove and is never left in rotation
+  while read -r _ ns pod svc _; do
+    echo "--- taking $svc out of rotation on $bad: $pod answers nothing the gateway can reach"
+    step "evict-$pod" $K -n "$ns" delete pod "$pod" --wait=false
+  done < <(grep '^EVICT ' "$TMP/plan.txt" || true)
+
+  step "rescue-settle" sleep 45
+  show rescued $K get pods -A -o wide --field-selector spec.nodeName="$good"
+
+  # Every surface the plan claimed to rescue is graded by name. Run 34381468088 was recorded FAILED
+  # while the rescue had in fact worked, and a reader could not tell the two apart from the log;
+  # a rescue that does not say which surface came back is a receipt for nothing.
+  while read -r verb ns pod svc _; do
+    case "$verb" in ROOM|MOVE) ;; *) continue ;; esac
+    out=$($K get pods -n "$ns" -o jsonpath='{range .items[?(@.spec.nodeName=="'"$good"'")]}{.metadata.name}{" "}{range .status.containerStatuses[*]}{.ready}{end}{"\n"}{end}' 2>/dev/null \
+      | grep -c 'true$' || true)
+    if [ "${out:-0}" -ge 1 ]; then
+      echo "ok    seated-$svc ${out} ready pod(s) for $ns on $good"
+    else
+      echo "FAIL  seated-$svc nothing ready for $ns on $good after the rescue"; FAILED="$FAILED seated-$svc"
+    fi
+  done < <(grep -E '^(ROOM|MOVE) ' "$TMP/plan.txt" || true)
+}
