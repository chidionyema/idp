-kind: Role
-metadata:
-  name: cyrus
-  namespace: cyrus
-rules:
-  # Read-only: can list pods to check status, but nothing else
-  - apiGroups: [""]
-    resources: ["pods", "pods/log"]
-    verbs: ["get", "list"]
----
-apiVersion: rbac.authorization.k8s.io/v1
-kind: RoleBinding
-metadata:
-  name: cyrus
-  namespace: cyrus
-subjects:
-  - kind: ServiceAccount
-    name: cyrus
-    namespace: cyrus
-roleRef:
-  kind: Role
-  name: cyrus
-  apiGroup: rbac.authorization.k8s.io
