-          # /status, not /health: cyrus serves no /health. EdgeWorker registers GET /status
-          # and GET /version and the shared server registers the webhook and OAuth routes;
-          # nothing answers /health, so both probes were 404 from the first second.
-          # A socket, not GET /status: while the entrypoint runs `cyrus self-auth` the same port
-          # is served by a one-route server that answers only /callback, and a 404 on /status
-          # there would have the kubelet kill the pod and the Service drop the endpoint the
-          # consent redirect has to reach. Both phases listen on 3456; the socket is the probe
-          # they share.
-          livenessProbe:
-            tcpSocket: { port: 3456 }
-            initialDelaySeconds: 30
-            periodSeconds: 30
-          readinessProbe:
-            tcpSocket: { port: 3456 }
-            initialDelaySeconds: 10
-            periodSeconds: 10
-          resources:
-            requests:
-              cpu: 100m
-              memory: 256Mi
-            # 1 core, not 2. The namespace quota is limits.cpu: 4 (namespace.yaml), so a
-            # 2-core limit let exactly two pods exist and a rolling update -- which needs the
-            # old pod plus one surge pod, and a third the moment either is slow to go -- was
-            # refused by the quota rather than by anything wrong with the image. Measured
-            # 2026-09-05: `limits.cpu: 4/4` with two pods, both ContainerCreating, one from
-            # each of two ReplicaSets, and no third pod admissible. Cyrus is a webhook agent;
-            # it has never needed two cores.
-            limits:
-              cpu: "1"
-              memory: 2Gi
-          securityContext:
-            allowPrivilegeEscalation: false
-            readOnlyRootFilesystem: true
-            capabilities:
-              drop: ["ALL"]
-      volumes:
-        - name: config
-          configMap:
-            name: cyrus-config
-        - name: github-secret
-          secret:
-            secretName: cyrus-github
-        - name: router-secret
-          secret:
-            secretName: cyrus-router
-        - name: webhook-secret
-          secret:
-            secretName: cyrus-webhook
-        - name: worktrees
-          emptyDir: {}
-        - name: repos
-          emptyDir: {}
-        # The root filesystem is read-only, so the three paths git, npm and the engine CLIs
-        # write to are explicit volumes rather than a writable image.
-        - name: tmp
-          emptyDir: {}
-        # ~/.cyrus/config.json is where `cyrus self-auth` saves the Linear OAuth token and where
-        # cyrus writes each refreshed one back (EdgeWorker.js:5215). On an emptyDir every restart
-        # threw the token away and asked the founder to consent again; a claim keeps it, and the
-        # entrypoint carries linearWorkspaces across the fresh copy of the git config.
-        - name: home
-          persistentVolumeClaim: { claimName: cyrus-home }
-        # optional: the pod comes up on the GitHub transport before the Bitwarden item exists.
-        - name: linear-oauth
-          secret: { secretName: cyrus-linear-oauth, optional: true }
-        - name: npm-cache
-          emptyDir: {}
