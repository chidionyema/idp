+pb_flannel_off() {
+  local nodes n i=0 targets ip out
+  $K get ds -n kube-system calico-node >/dev/null 2>&1 || { echo "FAIL  flannel-off: no calico-node DaemonSet"; FAILED="$FAILED guard-calico"; return 1; }
+  out=$($K get ds -n kube-system calico-node -o jsonpath='{.status.desiredNumberScheduled}/{.status.numberReady}')
+  case "$out" in
+    */0|0/*) echo "FAIL  flannel-off: calico-node is $out desired/ready"; FAILED="$FAILED guard-calico-ready"; return 1 ;;
+    *) [ "${out%/*}" = "${out#*/}" ] || { echo "FAIL  flannel-off: calico-node is $out desired/ready"; FAILED="$FAILED guard-calico-ready"; return 1; } ;;
+  esac
+  echo "ok    guard-calico calico-node ready on every node ($out)"
+
+  # every pod address must be inside a Calico pool, or something still rides flannel
+  if ! $K get ippools.crd.projectcalico.org >/dev/null 2>&1; then
+    echo "FAIL  flannel-off: no Calico IPPool CRD, cannot prove the pods are Calico's"
+    FAILED="$FAILED guard-pools"; return 1
+  fi
+  out=$($K get ippools.crd.projectcalico.org -o jsonpath='{range .items[*]}{.spec.cidr}{"\n"}{end}' 2>/dev/null)
+  if ! $K get pods -A -o jsonpath='{range .items[*]}{.status.podIP} {.metadata.namespace}/{.metadata.name} {.spec.hostNetwork}{"\n"}{end}' 2>/dev/null \
+      | POOLS="$out" python3 -c '
+import os, sys, ipaddress
+pools = [ipaddress.ip_network(c.strip()) for c in os.environ["POOLS"].split() if c.strip()]
+bad = []
+for ln in sys.stdin:
+    f = ln.split()
+    if len(f) < 2 or f[0] in ("", "<none>"):
+        continue
+    if len(f) > 2 and f[2] == "true":
+        continue
+    try:
+        a = ipaddress.ip_address(f[0])
+    except ValueError:
+        continue
+    if not any(a in p for p in pools):
+        bad.append(f[1] + " " + f[0])
+print("pools:", " ".join(str(p) for p in pools))
+if bad:
+    print("outside every Calico pool:", "; ".join(bad[:10]))
+    sys.exit(1)
+print("every pod address is Calico IPAM")
+'; then
+    echo "FAIL  flannel-off: a pod holds an address no Calico pool owns; flanneld is load-bearing here"
+    FAILED="$FAILED guard-ipam"; return 1
+  fi
+  echo "ok    guard-ipam every pod address belongs to a Calico pool"
+
+  if ! $K get ds -n kube-system kube-flannel-ds >/dev/null 2>&1; then
+    echo "ok    flannel-absent no kube-flannel-ds in kube-system, nothing to stop"
+  else
+    step "flannel-parked" $K -n kube-system patch ds kube-flannel-ds --type=merge \
+      -p '{"spec":{"template":{"spec":{"nodeSelector":{"estate.mumchimp.com/flannel":"parked-2026-09-09"}}}}}'
+    step "flannel-drained" $K -n kube-system rollout status ds kube-flannel-ds --timeout=180s
+  fi
+
+  step "calico-restart" $K -n kube-system rollout restart ds calico-node
+  step "calico-rolled" $K -n kube-system rollout status ds calico-node --timeout=300s
+
+  nodes=$($K get nodes -o jsonpath='{.items[*].metadata.name}')
+  for n in $nodes; do
+    i=$((i+1))
+    # Targets used to be two hardcoded app labels (llm/litellm, llm/litellm-cache) plus kube-dns.
+    # When those all sat on one node, the far node found nothing, printed "nothing on the other
+    # node" and probed nothing -- the playbook then passed without ever testing the direction that
+    # was broken. A silent pass on the failing direction is worse than no probe. So: any running
+    # pod on the other node with its own address (podIP != hostIP, i.e. not hostNetwork) and a
+    # declared container port is a legitimate cross-node target, and finding none is a FAIL.
+    targets=$($K get pods -A -o json 2>/dev/null | python3 -c '
+import json, sys
+node = sys.argv[1]
+out = []
+for pod in json.load(sys.stdin).get("items", []):
+    spec, st = pod.get("spec", {}), pod.get("status", {})
+    if spec.get("nodeName") == node or st.get("phase") != "Running":
+        continue
+    ip = st.get("podIP")
+    if not ip or ip == st.get("hostIP"):
+        continue
+    for c in spec.get("containers", []):
+        for port in c.get("ports", []) or []:
+            n = port.get("containerPort")
+            if n and str(port.get("protocol", "TCP")).upper() == "TCP":
+                out.append("%s:%d" % (ip, n))
+                break
+        break
+print(" ".join(out[:6]))
+' "$n")
+    if [ -z "$targets" ]; then
+      echo "FAIL  flanoff-targets-$i node $n found no addressable pod on any other node; the cross-node hop was never tested"
+      FAILED="$FAILED flanoff-targets-$i"
+    else
+      echo "--- node $n -> the other node: $targets"
+      tcp_probe "flanoff-probe-$i" "$n" kube-system "$targets"
+    fi
+    dns_probe "flanoff-dns-$i" "$n" kubernetes.default.svc.cluster.local
+  done
+  show flannel-ds $K get ds -n kube-system kube-flannel-ds -o wide
+  show calico-node $K get pods -n kube-system -l k8s-app=calico-node -o wide
+  show router $K get pods -n llm -o wide
+}
