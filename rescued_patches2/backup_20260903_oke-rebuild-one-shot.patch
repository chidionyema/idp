diff --git a/platform/oci/clusters/estate.env b/platform/oci/clusters/estate.env
new file mode 100644
index 000000000..b7a913e15
--- /dev/null
+++ b/platform/oci/clusters/estate.env
@@ -0,0 +1,5 @@
+# What bin/idp-oke-rebuild measures for the cluster named `estate`. One file per cluster; a drill
+# cluster gets its own (clusters/estate-drill.env) or the site and catalog rows report BLIND.
+OKE_HOST=mumchimp.com
+OKE_API_HOST=api.mumchimp.com
+WANT_PACKS=77
diff --git a/platform/oci/main.tf b/platform/oci/main.tf
index 64254d775..8c595d6a4 100644
--- a/platform/oci/main.tf
+++ b/platform/oci/main.tf
@@ -9,7 +9,7 @@ module "oke" {
   region         = var.region
 
   # Basic cluster: no control-plane charge (ADR 0004 decision 1).
-  cluster_name       = "estate"
+  cluster_name       = var.cluster_name # crew#220 hand step 2: a drill cluster is the same module under another name
   cluster_type       = "basic"
   kubernetes_version = var.kubernetes_version
   cni_type           = "flannel"
diff --git a/platform/oci/variables.tf b/platform/oci/variables.tf
index 72fed4df0..3041da60d 100644
--- a/platform/oci/variables.tf
+++ b/platform/oci/variables.tf
@@ -49,3 +49,26 @@ variable "control_plane_allowed_cidrs" {
   description = "CIDRs admitted to the Kubernetes API endpoint. Written by bin/idp-oci-login from the measured egress IP."
   default     = []
 }
+
+# crew#220 hand step 2: the name was the literal "estate", so a second cluster (a drill target,
+# a blue/green move) could not exist. Pass -var cluster_name=estate-drill from bin/idp-oke-rebuild.
+variable "cluster_name" {
+  type    = string
+  default = "estate"
+}
+
+variable "oci_auth" {
+  description = "Provider auth: APIKey on a laptop (bin/idp-oci-login), SecurityToken under GitHub OIDC."
+  type        = string
+  default     = "APIKey"
+  validation {
+    condition     = contains(["APIKey", "SecurityToken"], var.oci_auth)
+    error_message = "oci_auth is APIKey or SecurityToken."
+  }
+}
+
+variable "oci_profile" {
+  description = "Profile in ~/.oci/config that holds the credential."
+  type        = string
+  default     = "DEFAULT"
+}
diff --git a/platform/oci/versions.tf b/platform/oci/versions.tf
index 3c8dd7b45..de67df66b 100644
--- a/platform/oci/versions.tf
+++ b/platform/oci/versions.tf
@@ -11,13 +11,19 @@ terraform {
 }
 
 provider "oci" {
-  # Credentials come from ~/.oci/config (profile DEFAULT), written by bin/idp-oci-login from the
-  # sops vault (OCI_* names). Nothing here (LAW 46, LAW 21).
-  region = var.region
+  # Credentials come from ~/.oci/config, never from here (LAW 46, LAW 21). On a laptop
+  # bin/idp-oci-login writes an API key profile from the vault (auth APIKey). In GitHub Actions
+  # the profile holds a one-hour session token minted from the workflow's OIDC token
+  # (auth SecurityToken, crew#227 CP2), so no key exists to leak.
+  region              = var.region
+  auth                = var.oci_auth
+  config_file_profile = var.oci_profile
 }
 
 # The module needs a second alias for the home region (IAM lives there). Same region here.
 provider "oci" {
-  alias  = "home"
-  region = var.region
+  alias               = "home"
+  region              = var.region
+  auth                = var.oci_auth
+  config_file_profile = var.oci_profile
 }
