+# crew#227 CP2: the platform is checked by a machine identity, not by a key on a laptop.
+# The job's GitHub OIDC token is exchanged for a one-hour OCI session token that impersonates the
+# service user estate-ci (identity propagation trust `github-actions-estate`, created by
+# bin/idp-oci-bootstrap). No OCI API key exists for this path. Residual static credentials on
+# this path, listed so nobody pretends otherwise: the OIDC client secret (the trust's own
+# credential) and the S3 customer secret key for the state bucket (OpenTofu 1.12's S3 backend
+# cannot take a session token). Both are GitHub repository secrets, scoped to this repo.
+name: oke-check
+on:
+  schedule:
+    - cron: "17 6 * * *"   # daily; crew#220 drill row
+  workflow_dispatch:
+  pull_request:
+    paths: [".github/workflows/oke-check.yml", "bin/idp-oci-login", "bin/idp-oke-rebuild", "platform/oci/**"]
+permissions:
+  id-token: write   # the OIDC token this job trades for OCI access
+  contents: read
+concurrency: { group: oke-check, cancel-in-progress: false }
+jobs:
+  check:
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with: { python-version: "3.12" }
+      - uses: opentofu/setup-opentofu@592200bd4b9bbf4772ace78f887668b1aee8f716 # v1.0.5
+        with: { tofu_version: "1.12.6", tofu_wrapper: false }
+      - uses: fluxcd/flux2/action@5350425cdcd5fa015337e09fa502153c0275bd4b # v2.4.0
+      - name: oci cli
+        run: pip install -q oci-cli
+      - name: token exchange receipt (claims of the job token, and the domain's answer; never the tokens)
+        env:
+          OIDC: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          EP: ${{ vars.DOMAIN_BASE_URL }}
+        run: |
+          JWT=$(curl -sS -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=https://cloud.oracle.com" | jq -r .value)
+          printf '%s' "$JWT" | cut -d. -f2 | tr '_-' '/+' | base64 -d 2>/dev/null | jq -c '{iss,aud,sub,repository,ref,event_name}'
+          PUB=$(openssl genrsa 2048 2>/dev/null | openssl rsa -pubout -outform DER 2>/dev/null | base64 -w0)
+          curl -sS -o /tmp/x.json -w 'exchange http %{http_code}\n' -u "$OIDC" "$EP/oauth2/v1/token" \
+            --data-urlencode grant_type=urn:ietf:params:oauth:grant-type:token-exchange --data-urlencode requested_token_type=urn:oci:token-type:oci-upst \
+            --data-urlencode public_key="$PUB" --data-urlencode subject_token="$JWT" --data-urlencode subject_token_type=jwt
+          jq -c 'del(.token, .access_token, .id_token)' /tmp/x.json; rm -f /tmp/x.json
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+      - name: bin/idp-oke-rebuild --check
+        env:
+          OCI_CI: "1"
+          OCI_CLI_AUTH: security_token   # every oci call in the run uses the exchanged session token
+          OCI_TENANCY_OCID: ${{ secrets.OCI_TENANCY_OCID }}
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+          OCI_OS_NAMESPACE: ${{ vars.OCI_OS_NAMESPACE }}
+          OCI_S3_ACCESS_KEY: ${{ secrets.OCI_S3_ACCESS_KEY }}
+          OCI_S3_SECRET_KEY: ${{ secrets.OCI_S3_SECRET_KEY }}
+          OKE_SSH_PUBKEY_TEXT: ${{ vars.OKE_SSH_PUBKEY }}
+          OKE_ALLOWED_CIDRS: ${{ vars.OKE_ALLOWED_CIDRS }}
+        run: bin/idp-oke-rebuild --check
