diff --git a/platform/observability/signoz.yaml b/platform/observability/signoz.yaml
new file mode 100644
index 000000000..81c67e465
--- /dev/null
+++ b/platform/observability/signoz.yaml
@@ -0,0 +1,164 @@
+# SigNoz: the estate's metrics, traces and logs store (crew/docs/STANDARDS.md "Observability",
+# crew#258 CP2). Chart pinned; 0.138.0 was `helm search repo signoz/signoz` on 2026-08-25.
+# Values live in values.yaml (ConfigMap signoz-values). The chart exposes securityContext only for
+# signoz, otelCollector and clickhouse, and Kyverno enforces the restricted profile on this cluster,
+# so the postRenderers below add non-root, drop-ALL, seccomp and a read-only root filesystem to
+# every workload, with emptyDir scratch where the process writes. Proven offline by
+# bin/idp-kyverno-render (helm template + these patches + the cluster's ClusterPolicies).
+apiVersion: source.toolkit.fluxcd.io/v1
+kind: HelmRepository
+metadata:
+  name: signoz
+spec:
+  interval: 24h
+  url: https://charts.signoz.io
+---
+apiVersion: helm.toolkit.fluxcd.io/v2
+kind: HelmRelease
+metadata:
+  name: signoz
+spec:
+  interval: 1h
+  timeout: 15m
+  chart:
+    spec:
+      chart: signoz
+      version: 0.138.0
+      sourceRef:
+        kind: HelmRepository
+        name: signoz
+  install:
+    remediation: { retries: 3 }
+  upgrade:
+    remediation: { retries: 3 }
+  valuesFrom:
+    - kind: ConfigMap
+      name: signoz-values
+  postRenderers:
+    - kustomize:
+        patches:
+          # --- restricted profile for the workloads the chart renders directly ---
+          - target: { kind: Deployment, name: signoz-clickhouse-operator }
+            patch: |
+              apiVersion: apps/v1
+              kind: Deployment
+              metadata: { name: signoz-clickhouse-operator }
+              spec:
+                template:
+                  spec:
+                    securityContext: { runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, seccompProfile: { type: RuntimeDefault } }
+                    containers:
+                      - name: operator
+                        securityContext: &sc { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+                        resources: { requests: { cpu: 30m, memory: 64Mi }, limits: { cpu: 200m, memory: 256Mi } }
+                        livenessProbe: &op { httpGet: { path: /metrics, port: 8888 }, initialDelaySeconds: 20, periodSeconds: 30 }
+                        readinessProbe: *op
+                      - name: metrics-exporter
+                        securityContext: *sc
+                        resources: { requests: { cpu: 10m, memory: 32Mi }, limits: { cpu: 100m, memory: 128Mi } }
+                        livenessProbe: &mp { httpGet: { path: /metrics, port: 8888 }, initialDelaySeconds: 20, periodSeconds: 30 }
+                        readinessProbe: *mp
+          - target: { kind: Deployment, name: signoz-otel-collector }
+            patch: |
+              apiVersion: apps/v1
+              kind: Deployment
+              metadata: { name: signoz-otel-collector }
+              spec:
+                template:
+                  spec:
+                    securityContext: { runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, seccompProfile: { type: RuntimeDefault } }
+                    initContainers:
+                      - name: check
+                        securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+                    containers:
+                      - name: collector
+                        securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+                        volumeMounts:
+                          - { name: tmp, mountPath: /tmp }
+                    volumes:
+                      - { name: tmp, emptyDir: {} }
+          - target: { kind: StatefulSet, name: signoz }
+            patch: |
+              apiVersion: apps/v1
+              kind: StatefulSet
+              metadata: { name: signoz }
+              spec:
+                template:
+                  spec:
+                    securityContext: { runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, fsGroup: 10001, seccompProfile: { type: RuntimeDefault } }
+                    containers:
+                      - name: signoz
+                        securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+                        volumeMounts:
+                          - { name: tmp, mountPath: /tmp }
+                    volumes:
+                      - { name: tmp, emptyDir: {} }
+          - target: { kind: StatefulSet, name: signoz-zookeeper }
+            patch: |
+              apiVersion: apps/v1
+              kind: StatefulSet
+              metadata: { name: signoz-zookeeper }
+              spec:
+                template:
+                  spec:
+                    securityContext: { runAsNonRoot: true, runAsUser: 1001, runAsGroup: 1001, fsGroup: 1001, seccompProfile: { type: RuntimeDefault } }
+                    containers:
+                      - name: zookeeper
+                        securityContext: { allowPrivilegeEscalation: false, runAsNonRoot: true, runAsUser: 1001, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+                        volumeMounts:
+                          - { name: tmp, mountPath: /tmp }
+                          - { name: zk-conf, mountPath: /opt/bitnami/zookeeper/conf }
+                          - { name: zk-logs, mountPath: /opt/bitnami/zookeeper/logs }
+                    volumes:
+                      - { name: tmp, emptyDir: {} }
+                      - { name: zk-conf, emptyDir: {} }
+                      - { name: zk-logs, emptyDir: {} }
+          - target: { kind: Job, name: signoz-telemetrystore-migrator }
+            patch: |
+              apiVersion: batch/v1
+              kind: Job
+              metadata: { name: signoz-telemetrystore-migrator }
+              spec:
+                template:
+                  spec:
+                    securityContext: { runAsNonRoot: true, runAsUser: 10001, runAsGroup: 10001, seccompProfile: { type: RuntimeDefault } }
+                    initContainers:
+                      - { name: ready, securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } } }
+                      - { name: bootstrap, securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } } }
+                      - { name: sync, securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } } }
+                    containers:
+                      - { name: async, securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } } }
+          # --- the ClickHouse pods are built by the operator from this template; Kyverno judges
+          # them at admission, so the template must already carry the restricted profile ---
+          - target: { kind: ClickHouseInstallation, name: signoz-clickhouse }
+            patch: |
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/securityContext/runAsNonRoot
+                value: true
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/securityContext/seccompProfile
+                value: { type: RuntimeDefault }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/volumes/-
+                value: { name: tmp, emptyDir: {} }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/volumes/-
+                value: { name: ch-logs, emptyDir: {} }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/initContainers/0/securityContext
+                value: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/initContainers/0/volumeMounts/-
+                value: { name: tmp, mountPath: /tmp }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/initContainers/0/resources
+                value: { requests: { cpu: 20m, memory: 32Mi }, limits: { cpu: 200m, memory: 128Mi } }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/containers/0/securityContext
+                value: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/containers/0/volumeMounts/-
+                value: { name: tmp, mountPath: /tmp }
+              - op: add
+                path: /spec/templates/podTemplates/0/spec/containers/0/volumeMounts/-
+                value: { name: ch-logs, mountPath: /var/log/clickhouse-server }
diff --git a/platform/observability/values.yaml b/platform/observability/values.yaml
new file mode 100644
index 000000000..020eca02c
--- /dev/null
+++ b/platform/observability/values.yaml
@@ -0,0 +1,41 @@
+# SigNoz on the one 1.8-core / 9.2 GiB OKE node (crew#258 CP2). Requests are sized so the node
+# stays under its allocatable CPU: 1270m was requested before this release (kubectl describe node,
+# 2026-08-25). Kyverno enforces the restricted profile, so every pod carries limits, probes,
+# non-root, seccomp and a read-only root filesystem with emptyDir scratch where the process writes.
+global:
+  storageClass: oci-bv
+clickhouse:
+  resources:
+    requests: { cpu: 150m, memory: 512Mi }
+    limits: { cpu: 1000m, memory: 2Gi }
+  persistence:
+    size: 20Gi
+  zookeeper:
+    replicaCount: 1
+    # the chart leaves this image unqualified (signoz/zookeeper:3.7.1); the node runtime enforces
+    # short-name mode and refused it with ImageInspectError on 2026-08-25
+    image:
+      registry: docker.io
+    resources:
+      requests: { cpu: 50m, memory: 128Mi }
+      limits: { cpu: 250m, memory: 512Mi }
+    persistence:
+      size: 2Gi
+signoz:
+  replicaCount: 1
+  resources:
+    requests: { cpu: 100m, memory: 256Mi }
+    limits: { cpu: 500m, memory: 1Gi }
+  persistence:
+    size: 1Gi
+  ingress:
+    enabled: false
+otelCollector:
+  replicaCount: 1
+  resources:
+    requests: { cpu: 100m, memory: 200Mi }
+    limits: { cpu: 500m, memory: 512Mi }
+telemetryStoreMigrator:
+  resources:
+    requests: { cpu: 50m, memory: 128Mi }
+    limits: { cpu: 500m, memory: 512Mi }
