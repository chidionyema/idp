+# CI fallback for bin/idp-kyverno-render when the prospector checkout is absent: the same pinned
+# upstream policies prospector/deploy/k8s/policies/kustomization.yaml names, minus its two
+# estate-only policies (money-rail-single-writer, no-optional-secret-references). Source of truth
+# is that file; this one repeats its URLs and its two patch files, which CI cannot fetch from a
+# private repo. Incident 2026-08-25: the copy lacked admit-job-pods.yaml (prospector#733) and CI
+# refused the migrator pod the cluster would have admitted.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - github.com/kyverno/policies/pod-security/restricted?ref=ef9843f08d25b3555fe69616f8612c9f915af5d4
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/disallow-latest-tag/disallow-latest-tag.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/require-pod-requests-limits/require-pod-requests-limits.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/require-probes/require-probes.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/require-drop-all/require-drop-all.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/require-ro-rootfs/require-ro-rootfs.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/best-practices/disallow-default-namespace/disallow-default-namespace.yaml
+  - https://raw.githubusercontent.com/kyverno/policies/ef9843f08d25b3555fe69616f8612c9f915af5d4/other/disallow-secrets-from-env-vars/disallow-secrets-from-env-vars.yaml
+patches:
+  - path: enforce.yaml
+    target:
+      group: kyverno.io
+      version: v1
+      kind: ClusterPolicy
+    target:
+      group: kyverno.io
+      version: v1
+      kind: ClusterPolicy
+      name: require-pod-probes
+  - path: admit-acme-solver.yaml
+    target:
+      group: kyverno.io
+      version: v1
+      kind: ClusterPolicy
+      name: require-pod-probes
+  - path: admit-job-pods.yaml   # after admit-acme-solver.yaml, as in the source kustomization
+    target:
+      group: kyverno.io
+      version: v1
+      kind: ClusterPolicy
+      name: require-pod-probes
