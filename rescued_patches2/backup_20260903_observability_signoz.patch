diff --git a/tests/fixtures/kyverno/upstream/admit-acme-solver.yaml b/tests/fixtures/kyverno/upstream/admit-acme-solver.yaml
new file mode 100644
index 000000000..f47de4ab7
--- /dev/null
+++ b/tests/fixtures/kyverno/upstream/admit-acme-solver.yaml
@@ -0,0 +1,16 @@
+# cert-manager's http-01 solver pods carry no probes and cannot be given any: cert-manager
+# creates them, serves one token for a minute, and deletes them. On 2026-08-25 require-pod-probes
+# refused all three solver pods for mumchimp.com and the Certificate stayed Ready=False for ten
+# hours while the site was dark (crew#78). A guard that refuses correct work is an outage
+# (LAW 38), so the one label cert-manager stamps on every solver pod skips this one rule.
+# A precondition rather than an exclude: an exclude block is rewritten by autogen and, measured
+# on the CLI, made the no-probes Deployment case report "Excluded" too. The precondition is
+# evaluated per object and touches nothing else. Nothing else is relaxed: the solver still has
+# to run non-root, drop capabilities, mount a read-only root and declare limits, and it does.
+- op: add
+  path: /spec/rules/0/preconditions
+  value:
+    all:
+      - key: "{{ request.object.metadata.labels.\"acme.cert-manager.io/http01-solver\" || '' }}"
+        operator: NotEquals
+        value: "true"
diff --git a/tests/fixtures/kyverno/upstream/admit-job-pods.yaml b/tests/fixtures/kyverno/upstream/admit-job-pods.yaml
new file mode 100644
index 000000000..4ff7958a3
--- /dev/null
+++ b/tests/fixtures/kyverno/upstream/admit-job-pods.yaml
@@ -0,0 +1,13 @@
+# A Pod owned by a Job runs to completion; a liveness or readiness probe on it describes nothing
+# and a fake one is a proxy the guard would be grading instead of the pod. On 2026-08-25
+# require-pod-probes refused SigNoz's schema migrator (idp#133) at admission, after the Kyverno
+# CLI had passed the Job: autogen covers Deployment, StatefulSet and DaemonSet, not Job. A guard
+# that refuses correct work is an outage (LAW 38). Same shape as admit-acme-solver.yaml: a
+# precondition on the one rule, appended after that patch. Nothing else is relaxed; the pod still
+# runs non-root, drops capabilities, mounts a read-only root and declares limits.
+- op: add
+  path: /spec/rules/0/preconditions/all/-
