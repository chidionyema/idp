diff --git a/tests/fixtures/kyverno/upstream/enforce.yaml b/tests/fixtures/kyverno/upstream/enforce.yaml
new file mode 100644
index 000000000..92e74c7ef
--- /dev/null
+++ b/tests/fixtures/kyverno/upstream/enforce.yaml
@@ -0,0 +1,10 @@
+# Upstream ships every policy as `validationFailureAction: Audit`, which writes a report and admits
+# the workload anyway. LAW 28: an instrument nobody reads is not an instrument. This flips the whole
+# build to Enforce, in staging and production alike, because a staging cluster with softer rules
+# admits manifests production refuses and turns a caught problem into an outage.
+#
+# `add`, not `replace`: RFC 6902 `add` on an existing object member overwrites it, and on a missing
+# one creates it. `replace` fails the build for any upstream policy that omits the field.
+- op: add
+  path: /spec/validationFailureAction
+  value: Enforce
