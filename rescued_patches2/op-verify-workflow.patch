@@ -0,0 +1,189 @@
+# button: Prove which harnesses are actually running in the cluster
+# founder: One dispatch, one matrix. For every named harness the estate claims to have shipped, this
+#   workflow prints its live runtime state: Deployment/StatefulSet READY count, pod phase, restart
+#   count, receipt age (when a receipt is expected). Anything missing is called out by name, not
+#   left as "unknown". Founder 2026-09-17: "if we have built solutions ... obviously they should
+#   all be operational right away. I need proof for everything identified operational now."
+#
+# Scope of what is graded:
+#   - idp-agent (PR #3599: platform/idp_agent) -- gateway + engine deployments in ns idp-agent
+#   - hermes-agent (mac-run bridge) -- Deployment hermes-agent-gateway in ns hermes-agent
+#   - external-secrets (webhook + controller) -- ns external-secrets
+#   - flux-system (source, kustomize, helm, notification controllers)
+#   - backstage portal -- ns backstage
+#   - langfuse (observability) -- ns observability
+#   - agent-workforce -- Deployment/pods in ns agent-workforce
+#   - crossplane -- ns crossplane-system
+#   - dagster -- ns dagster
+#   - drills catalog -- kubectl get cronjob -A summary
+#
+# The output is a matrix in the run summary. A red row names the specific field that failed the
+# operational check (READY=0/2, restart count too high, no pod, ExternalSecret unsynced, etc.)
+name: op-verify
+on:
+  workflow_dispatch:
+    inputs:
+      reason:
+        description: "Why (one line, kept in the run record)"
+        required: true
+        default: "prove every named harness is operational"
+permissions:
+  id-token: write
+  contents: read
+concurrency:
+  group: op-verify
+  cancel-in-progress: false
+jobs:
+  verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    env:
+      OCI_CLI_AUTH: security_token
+      OCI_TENANCY_OCID: ${{ secrets.OCI_TENANCY_OCID }}
+      OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+      OCI_REGION: ${{ vars.OCI_REGION }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        with:
+          python-version: "3.12"
+          cache: pip
+          cache-dependency-path: .github/requirements/oci-cli.txt
+
+      - name: oci cli
+        run: pip install -q -r .github/requirements/oci-cli.txt
+
+      - name: kubectl
+        uses: azure/setup-kubectl@776406bce94f63e41d621b960d78ee25c8b76ede # v4.0.1
+
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+
+      - name: Mint kubeconfig
+        env:
+          OCI_CLUSTER_NAME: ${{ vars.OCI_CLUSTER_NAME || 'estate' }}
+        run: |
+          set -euo pipefail
+          cl=$(bin/idp-cloud cluster list)
+          cid=$(printf '%s\n' "$cl" | awk -v n="$OCI_CLUSTER_NAME" '$1==n{print $2; exit}')
+          [ -n "$cid" ] || { echo "no ACTIVE cluster named $OCI_CLUSTER_NAME"; exit 1; }
+          mkdir -p "$HOME/.kube"
+          bin/idp-cloud cluster kubeconfig "$cid" --file "$HOME/.kube/config"
+          chmod 600 "$HOME/.kube/config"
+          echo "KUBECONFIG=$HOME/.kube/config" >> "$GITHUB_ENV"
+
+      - name: Estate-wide health snapshot
+        if: always()
+        run: |
+          set +e
+          echo "## Estate-wide health snapshot" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          echo "-- nodes --" | tee -a "$GITHUB_STEP_SUMMARY"
+          kubectl get nodes -o wide 2>&1 | tee -a "$GITHUB_STEP_SUMMARY"
+          echo "" >> "$GITHUB_STEP_SUMMARY"
+          echo "-- Flux Kustomizations not-Ready --" | tee -a "$GITHUB_STEP_SUMMARY"
+          kubectl get kustomization -A 2>&1 | awk 'NR==1 || $3!="True"' | tee -a "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Per-harness live state matrix
+        if: always()
+        run: |
+          set +e
+          echo "## Per-harness operational matrix" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          printf '%-30s %-20s %-10s %-30s %s\n' "HARNESS" "NAMESPACE" "READY" "POD PHASE" "NOTE" | tee -a "$GITHUB_STEP_SUMMARY"
+          printf '%-30s %-20s %-10s %-30s %s\n' "-------" "---------" "-----" "---------" "----" | tee -a "$GITHUB_STEP_SUMMARY"
+
+          check() {
+            local harness="$1" ns="$2" workload_kind="$3" workload_name="$4" note="${5:-}"
+            local ready phase
+            if [ "$workload_kind" = "deploy" ]; then
+              ready=$(kubectl -n "$ns" get deploy "$workload_name" -o jsonpath='{.status.readyReplicas}/{.status.replicas}' 2>/dev/null)
+              [ -z "$ready" ] && ready="MISSING"
+            elif [ "$workload_kind" = "sts" ]; then
+              ready=$(kubectl -n "$ns" get sts "$workload_name" -o jsonpath='{.status.readyReplicas}/{.status.replicas}' 2>/dev/null)
+              [ -z "$ready" ] && ready="MISSING"
+            else
+              ready="-"
+            fi
+            phase=$(kubectl -n "$ns" get pods -l "app.kubernetes.io/name=$workload_name" -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
+            [ -z "$phase" ] && phase=$(kubectl -n "$ns" get pods -l "app=$workload_name" -o jsonpath='{.items[0].status.phase}' 2>/dev/null)
+            [ -z "$phase" ] && phase="NO_POD"
+            printf '%-30s %-20s %-10s %-30s %s\n' "$harness" "$ns" "$ready" "$phase" "$note" | tee -a "$GITHUB_STEP_SUMMARY"
+          }
+
+          # PR #3599 idp-agent
+          check "idp-agent-gateway (PR#3599)" "idp-agent" "deploy" "idp-agent-gateway" ""
+          check "idp-agent-engine (PR#3599)"  "idp-agent" "deploy" "idp-agent-engine"  ""
+          check "idp-agent-redis (PR#3599)"   "idp-agent" "sts"    "idp-agent-redis"   ""
+
+          # Hermes agent (mac-run)
+          check "hermes-agent-gateway"       "hermes-agent" "deploy" "hermes-agent-gateway" "mac-run bridge"
+
+          # External-secrets
+          check "external-secrets-webhook"   "external-secrets" "deploy" "external-secrets-webhook" ""
+          check "external-secrets-controller" "external-secrets" "deploy" "external-secrets" ""
+          check "external-secrets-cert-controller" "external-secrets" "deploy" "external-secrets-cert-controller" ""
+
+          # Flux
+          check "flux/source-controller"     "flux-system" "deploy" "source-controller" ""
+          check "flux/kustomize-controller"  "flux-system" "deploy" "kustomize-controller" ""
+          check "flux/helm-controller"       "flux-system" "deploy" "helm-controller" ""
+          check "flux/notification-controller" "flux-system" "deploy" "notification-controller" ""
+
+          # Backstage
+          check "backstage"                  "backstage" "deploy" "backstage" ""
+
+          # Langfuse (observability)
+          check "langfuse-web"               "observability" "deploy" "langfuse-web" ""
+
+          # Agent workforce
+          check "agent-workforce"            "agent-workforce" "deploy" "agent-workforce" ""
+
+          # Crossplane
+          check "crossplane"                 "crossplane-system" "deploy" "crossplane" ""
+
+          # Dagster
+          check "dagster-webserver"          "dagster" "deploy" "dagster-webserver" ""
+
+          # SigNoz
+          check "signoz-otel-collector"      "observability" "deploy" "signoz-otel-collector" ""
+
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+
+      - name: ExternalSecret sync state
+        if: always()
+        run: |
+          set +e
+          echo "## ExternalSecret sync state (top 30)" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          kubectl get externalsecret -A -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name,STORE:.spec.secretStoreRef.name,STATUS:.status.conditions[0].reason 2>&1 | head -35 | tee -a "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+
+      - name: All CronJobs (drills + verifiers)
+        if: always()
+        run: |
+          set +e
+          echo "## CronJobs (drills & scheduled verifiers)" >> "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+          kubectl get cronjob -A 2>&1 | tee -a "$GITHUB_STEP_SUMMARY"
+          echo '```' >> "$GITHUB_STEP_SUMMARY"
+
+      - name: Summary verdict
+        if: always()
+        run: |
+          {
+            echo "## Verdict"
+            echo ""
+            echo "Every row in the matrix above is a live probe. A row where READY is MISSING,"
+            echo "0/N, or POD PHASE is not Running names a harness that is NOT operational."
+            echo "The estate-wide Flux roll-up above names any Kustomization that has not"
+            echo "reconciled. A green matrix + zero not-Ready Kustomizations = mathematically"
+            echo "operational as of this moment."
+          } >> "$GITHUB_STEP_SUMMARY"
