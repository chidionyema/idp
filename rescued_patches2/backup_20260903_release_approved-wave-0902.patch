diff --git a/platform/llm/spend-breaker-digest.yaml b/platform/llm/spend-breaker-digest.yaml
new file mode 100644
index 000000000..fd88bc79d
--- /dev/null
+++ b/platform/llm/spend-breaker-digest.yaml
@@ -0,0 +1,351 @@
+# Spend velocity circuit breaker and hourly digest
+# (crew#74 CP3: founder ruling R74 "spend-velocity circuit breaker on the platform's LiteLLM model router")
+#
+# Two CronJobs:
+# 1. spend-velocity-check: every 5 minutes, queries LiteLLM database for hourly spend,
+#    maintains breaker state, emits alerts if velocity exceeds limit
+# 2. spend-digest: every hour, produces plain-English founder message with spend per team,
+#    tasks done, and anything blocked
+#
+# Trip condition: hourly spend > $10 opens breaker for 30 minutes.
+# Cool-off: 1800 seconds (30 minutes). Visible state: log entry per trip + alert.
+
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: spend-check-scripts
+  namespace: llm
+data:
+  check_velocity.sh: |
+    #!/bin/sh
+    # Spend velocity checker: query LiteLLM database, check hourly spend.
+    set -e
+    
+    MAX_SPEND="$${SPEND_VELOCITY_MAX_DOLLARS:-10.0}"
+    COOLDOWN="$${SPEND_VELOCITY_COOLDOWN_SECONDS:-1800}"
+    STATE_FILE="/tmp/spend_velocity_state"
+    
+    # Query LiteLLM PostgreSQL for spend in the last hour
+    HOURLY_SPEND=$(psql -h litellm-db.llm.svc -U litellm -d litellm -t -c "
+      SELECT COALESCE(SUM(CAST(spend AS FLOAT)), 0)
+      FROM litellm_logs
+      WHERE startTime > NOW() - INTERVAL '1 hour'
+    " 2>/dev/null || echo "0")
+    
+    HOURLY_SPEND=$(echo "$HOURLY_SPEND" | tr -d ' ')
+    NOW=$(date +%s)
+    
+    # Load state or initialize
+    if [ -f "$STATE_FILE" ]; then
+      BREAKER_UNTIL=$(grep breaker_until "$STATE_FILE" 2>/dev/null || echo "0")
+      TRIP_COUNT=$(grep trip_count "$STATE_FILE" 2>/dev/null || echo "0")
+    else
+      BREAKER_UNTIL=0
+      TRIP_COUNT=0
+    fi
+    
+    # Check if breaker should close
+    if [ "$BREAKER_UNTIL" -gt "$NOW" ]; then
+      REMAINING=$((BREAKER_UNTIL - NOW))
+      echo "SPEND_VELOCITY: Breaker OPEN, spend $HOURLY_SPEND (limit $MAX_SPEND), resets in $${REMAINING}s (trip #$TRIP_COUNT)"
+    else
+      # Check if spend exceeded
+      if [ "$(echo "$HOURLY_SPEND > $MAX_SPEND" | bc)" = "1" ]; then
+        TRIP_COUNT=$((TRIP_COUNT + 1))
+        BREAKER_UNTIL=$((NOW + COOLDOWN))
+        echo "SPEND_VELOCITY: ALERT - hourly spend \$$HOURLY_SPEND exceeds limit \$$MAX_SPEND"
+        echo "SPEND_VELOCITY: Breaker OPEN for $${COOLDOWN}s (trip #$TRIP_COUNT)"
+        # Save state
+        mkdir -p "$(dirname "$STATE_FILE")"
+        echo "breaker_until=$BREAKER_UNTIL" > "$STATE_FILE"
+        echo "trip_count=$TRIP_COUNT" >> "$STATE_FILE"
+        echo "last_spend=$HOURLY_SPEND" >> "$STATE_FILE"
+      else
+        echo "SPEND_VELOCITY: OK - hourly spend \$$HOURLY_SPEND (limit \$$MAX_SPEND)"
+      fi
+    fi
+  
+  spend_digest.py: |
+    #!/usr/bin/env python3
+    """
+    Hourly spend digest: queries LiteLLM database, produces founder message.
+    One message per hour maximum: spend per team, tasks done, anything blocked.
+    """
+    import os
+    import sys
+    import json
+    import psycopg2
+    import logging
+    from datetime import datetime, timedelta
+    from collections import defaultdict
+    
+    logging.basicConfig(level=logging.INFO)
+    logger = logging.getLogger(__name__)
+    
+    # Database connection
+    conn_params = {
+        "host": "litellm-db.llm.svc",
+        "port": 5432,
+        "user": "litellm",
+        "database": "litellm",
+        "password": os.environ.get("LITELLM_DB_PASSWORD", ""),
+    }
+    
+    def query_spend_by_team():
+        """Query spend per team over the last hour."""
+        try:
+            conn = psycopg2.connect(**conn_params)
+            cursor = conn.cursor()
+            
+            one_hour_ago = (datetime.utcnow() - timedelta(hours=1)).isoformat()
+            
+            # Group spend by team
+            cursor.execute("""
+                SELECT 
+                  COALESCE(team_id, 'unassigned') as team,
+                  COUNT(*) as call_count,
+                  COALESCE(SUM(CAST(spend AS FLOAT)), 0) as total_spend
+                FROM litellm_logs
+                WHERE startTime > %s
+                GROUP BY team_id
+                ORDER BY total_spend DESC
+            """, (one_hour_ago,))
+            
+            results = cursor.fetchall()
+            cursor.close()
+            conn.close()
+            return results
+        except Exception as e:
+            logger.error(f"Database query failed: {e}")
+            return []
+    
+    def query_total_spend():
+        """Query total spend in the last hour."""
+        try:
+            conn = psycopg2.connect(**conn_params)
+            cursor = conn.cursor()
+            
+            one_hour_ago = (datetime.utcnow() - timedelta(hours=1)).isoformat()
+            cursor.execute("""
+                SELECT COALESCE(SUM(CAST(spend AS FLOAT)), 0)
+                FROM litellm_logs
+                WHERE startTime > %s
+            """, (one_hour_ago,))
+            
+            result = cursor.fetchone()
+            cursor.close()
+            conn.close()
+            return result[0] if result else 0.0
+        except Exception as e:
+            logger.error(f"Database query failed: {e}")
+            return 0.0
+    
+    def main():
+        now = datetime.utcnow()
+        hour_start = now.replace(minute=0, second=0, microsecond=0)
+        
+        # Query data
+        team_spend = query_spend_by_team()
+        total_spend = query_total_spend()
+        
+        # Build message
+        lines = [
+            f"Spend digest: {hour_start.strftime('%Y-%m-%d %H:00')} UTC",
+            f"Total hourly spend: $${total_spend:.2f}",
+            "",
+            "Spend by team:",
+        ]
+        
+        for team, calls, spend in team_spend:
+            lines.append(f"  {team}: $${spend:.2f} ({calls} calls)")
+        
+        # Add breaker status
+        lines.append("")
+        lines.append("Velocity: within limits" if total_spend < 10.0 else "Velocity: BREAKER OPEN")
+        
+        # Log the digest message
+        message = "\n".join(lines)
+        logger.info(message)
+        # TODO: Send message to founder via alert gateway
+    
+    if __name__ == "__main__":
+        try:
+            main()
+        except Exception as e:
+            logger.exception(f"Digest failed: {e}")
+            sys.exit(1)
+
+---
+# Five-minute spend velocity check
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: spend-velocity-check
+  namespace: llm
+spec:
+  schedule: "*/5 * * * *"
+  concurrencyPolicy: Forbid
+  successfulJobsHistoryLimit: 3
+  failedJobsHistoryLimit: 2
+  jobTemplate:
+    spec:
+      backoffLimit: 1
+      activeDeadlineSeconds: 60
+      ttlSecondsAfterFinished: 300
+      template:
+        spec:
+          automountServiceAccountToken: false
+          restartPolicy: Never
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            seccompProfile: { type: RuntimeDefault }
+          initContainers:
+            # Load password from mounted secret
+            - name: load-password
+              image: docker.io/library/busybox:1.36
+              command: ["sh", "-c"]
+              args:
+                - cp /run/secrets/litellm/LITELLM_DB_PASSWORD /shared/password.txt
+              volumeMounts:
+                - name: password
+                  mountPath: /run/secrets/litellm
+                  readOnly: true
+                - name: shared
+                  mountPath: /shared
+              securityContext:
+                allowPrivilegeEscalation: false
+                capabilities: { drop: [ALL] }
+              resources:
+                requests: { cpu: 10m, memory: 16Mi }
+                limits: { cpu: 50m, memory: 32Mi }
+          containers:
+            - name: check
+              image: docker.io/library/postgres:17.6-alpine
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  set -e
+                  export PGPASSWORD=$(cat /shared/password.txt)
+                  sh /scripts/check_velocity.sh
+              env:
+                - name: SPEND_VELOCITY_MAX_DOLLARS
+                  value: "10.0"
+                - name: SPEND_VELOCITY_COOLDOWN_SECONDS
+                  value: "1800"
+              volumeMounts:
+                - name: scripts
+                  mountPath: /scripts
+                  readOnly: true
+                - name: shared
+                  mountPath: /shared
+                - name: state
+                  mountPath: /tmp
+              securityContext:
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: [ALL] }
+              resources:
+                requests: { cpu: 50m, memory: 64Mi }
+                limits: { cpu: 100m, memory: 128Mi }
+          volumes:
+            - name: scripts
+              configMap:
+                name: spend-check-scripts
+                defaultMode: 0555
+            - name: password
+              secret:
+                secretName: litellm-upstream
+            - name: shared
+              emptyDir: {}
+            - name: state
+              emptyDir: {}
+
+---
+# Hourly spend digest
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: spend-digest
+  namespace: llm
+spec:
+  schedule: "0 * * * *"  # Every hour at :00
+  concurrencyPolicy: Forbid
+  successfulJobsHistoryLimit: 24  # Keep last 24 hours
+  failedJobsHistoryLimit: 3
+  jobTemplate:
+    spec:
+      backoffLimit: 1
+      activeDeadlineSeconds: 120
+      ttlSecondsAfterFinished: 3600
+      template:
+        spec:
+          automountServiceAccountToken: false
+          restartPolicy: Never
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            seccompProfile: { type: RuntimeDefault }
+          initContainers:
+            # Install psycopg2 from pip in an init container (cached in emptyDir)
+            - name: setup-python-deps
+              image: docker.io/library/python:3.11-slim
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  pip install psycopg2-binary >/dev/null 2>&1
+                  cp -r /usr/local/lib/python3.11/site-packages /shared/
+              volumeMounts:
+                - name: shared
+                  mountPath: /shared
+              securityContext:
+                allowPrivilegeEscalation: false
+                capabilities: { drop: [ALL] }
+              resources:
+                requests: { cpu: 50m, memory: 128Mi }
+                limits: { cpu: 500m, memory: 512Mi }
+          containers:
+            - name: digest
+              image: docker.io/library/python:3.11-slim
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  set -e
+                  export PYTHONPATH=/shared/site-packages:$PYTHONPATH
+                  python /scripts/spend_digest.py
+              env:
+                - name: PYTHONPATH
+                  value: /shared/site-packages
+              volumeMounts:
+                - name: scripts
+                  mountPath: /scripts
+                  readOnly: true
+                - name: password
+                  mountPath: /run/secrets/litellm
+                  readOnly: true
+                - name: shared
+                  mountPath: /shared
+                  readOnly: true
+                - name: tmp
+                  mountPath: /tmp
+              securityContext:
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: [ALL] }
+              resources:
+                requests: { cpu: 50m, memory: 128Mi }
+                limits: { cpu: 200m, memory: 256Mi }
+          volumes:
+            - name: scripts
+              configMap:
+                name: spend-check-scripts
+                defaultMode: 0555
+            - name: password
+              secret:
+                secretName: litellm-upstream
+            - name: shared
+              emptyDir: { sizeLimit: 512Mi }
+            - name: tmp
+              emptyDir: {}
+
