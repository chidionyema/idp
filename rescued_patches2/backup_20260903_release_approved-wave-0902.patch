+# crew#539: a founder-facing surface survives losing one node.
+# 2026-08-28 06:20-06:39Z one node was cordoned, the single metabase pod had nowhere to land, and
+# the surface answered 503. maxUnavailable 1 is deliberate: a budget whose floor equals the replica
+# count refuses every drain for ever. Graded by bin/idp-availability-gate in bin/idp-ci.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: metabase
+  namespace: observability
+spec:
+  maxUnavailable: 1
+  selector:
+    matchLabels:
+      app.kubernetes.io/name: metabase
diff --git a/platform/observability/metabase-deployment.yaml b/platform/observability/metabase-deployment.yaml
new file mode 100644
index 000000000..c95b34132
--- /dev/null
+++ b/platform/observability/metabase-deployment.yaml
@@ -0,0 +1,97 @@
+# Metabase on the OKE node pool: the boardroom dashboard reads LLM traces from Langfuse's
+# PostgreSQL and stores dashboards in its own database (crew#R74 CP1). Sign-in is the front
+# door: oauth2-proxy answers the ForwardAuth subrequest and Traefik copies X-Auth-Request-Email;
+# Metabase reads it as METABASE_USER_LOGIN_EMAIL_HEADER and creates or updates the user by email
+# (the founder is enrolled at setup). No password exists anywhere for Metabase; ADMIN_EMAIL is
+# set to the founder's email and the account is an admin (ADR 0007).
+apiVersion: v1
+kind: Service
+metadata:
+  name: metabase
+  namespace: observability
+  labels: { app.kubernetes.io/name: metabase, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: founder-jobs }
+spec:
+  selector: { app.kubernetes.io/name: metabase }
+  ports:
+    - { name: http, port: 3000, targetPort: 3000 }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: metabase
+  namespace: observability
+  annotations:
+    reloader.stakater.com/auto: "true"
+  labels: { app.kubernetes.io/name: metabase, app.kubernetes.io/part-of: idp }
+spec:
+  replicas: 2   # crew#539: one pod is one node event away from a 503
+  strategy:
+    type: RollingUpdate
+    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
+  selector:
+    matchLabels: { app.kubernetes.io/name: metabase }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: metabase, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: DoNotSchedule
+          labelSelector:
+            matchLabels: { app.kubernetes.io/name: metabase }
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 2000
+        runAsGroup: 2000
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: metabase
+          image: docker.io/metabase/metabase:v0.63.16.1
+          ports:
+            - { containerPort: 3000, name: http }
+          command: ["/bin/sh", "-c"]
+          args:
+            - |
+              set -eu
+              # Secrets are mounted as files (Kyverno secrets-not-from-env-vars policy).
+              # Read them and export as environment variables for Metabase to use.
+              export MB_DB_PASS=$(cat /run/secrets/metabase/MB_DB_PASS)
+              export METABASE_ADMIN_EMAIL=$(cat /run/secrets/metabase/METABASE_ADMIN_EMAIL)
+              exec java -jar /app/metabase.jar
+          env:
+            - { name: MB_DB_TYPE, value: postgres }
+            - { name: MB_DB_HOST, value: metabase-db.observability.svc.cluster.local }
+            - { name: MB_DB_PORT, value: "5432" }
+            - { name: MB_DB_USER, value: metabase }
+            - { name: MB_DB_DBNAME, value: metabase }
+            # SSO integration: read email from the Traefik header set by oauth2-proxy (ADR 0007)
+            - { name: METABASE_USER_LOGIN_EMAIL_HEADER, value: X-Auth-Request-Email }
+            - { name: METABASE_SESSION_COOKIE_SAMESITE, value: lax }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            httpGet: { path: /api/health, port: 3000 }
+            periodSeconds: 10
+            failureThreshold: 2
+          livenessProbe:
+            httpGet: { path: /api/health, port: 3000 }
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 50m, memory: 512Mi }
+            limits: { cpu: 1000m, memory: 2Gi }
+          volumeMounts:
+            - { name: tmp, mountPath: /tmp }
+            - { name: metabase-data, mountPath: /metabase.db }
+            - { name: secrets, mountPath: /run/secrets/metabase, readOnly: true }
+      volumes:
+        - name: tmp
+          emptyDir: {}
+        - name: metabase-data
+          emptyDir: {}
+        - name: secrets
+          secret: { secretName: metabase }
diff --git a/platform/observability/metabase-external-secret.yaml b/platform/observability/metabase-external-secret.yaml
new file mode 100644
index 000000000..979427acb
--- /dev/null
+++ b/platform/observability/metabase-external-secret.yaml
@@ -0,0 +1,37 @@
+# Metabase: the boardroom dashboard for the LLM traces (crew#R74 CP1). One ExternalSecret
+# pulls the app database password and founder email from the estate vault; Metabase stores
+# configuration and saved dashboards in its own PostgreSQL database. The password is rotated via
+# the vault; Reloader rolls the pod when the secret changes. The founder's email is pulled from
+# the same vault entry Langfuse uses (platform/oci/langfuse.tf), so there is one of it.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: metabase
+  namespace: observability
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: metabase
+    creationPolicy: Owner
+  data:
+    - secretKey: MB_DB_PASS
+      remoteRef: { key: metabase-db-password }
+    - secretKey: METABASE_ADMIN_EMAIL
+      remoteRef: { key: langfuse-init-user-email }
+---
+# Postgres reads its password as a file (POSTGRES_PASSWORD_FILE), the same shape as healthchecks-db.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: metabase-db
+  namespace: observability
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: metabase-db
+    creationPolicy: Owner
+  data:
+    - secretKey: password
+      remoteRef: { key: metabase-db-password }
diff --git a/platform/observability/metabase-httproute.yaml b/platform/observability/metabase-httproute.yaml
new file mode 100644
index 000000000..bbe4fb56d
--- /dev/null
+++ b/platform/observability/metabase-httproute.yaml
@@ -0,0 +1,57 @@
+# metabase.<zone>: the boardroom dashboard behind the one login (crew#R74 CP1). Same shape as the
+# langfuse route (platform/observability/httproute.yaml): every request is subrequested to oauth2-proxy
+# first through Traefik's ForwardAuth (login-forward-auth middleware defined at namespace level in
+# edge-manners.yaml), which must live in the identity namespace; the /oauth2/ path goes to oauth2-proxy
+# itself (ReferenceGrant in platform/identity). The listener is https-metabase on the shared Gateway
+# (prospector-main deploy/k8s/base/edge.yaml).
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  labels:
+    backstage.io/kubernetes-id: founder-dashboards
+  name: metabase
+  namespace: observability
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-metabase
+  hostnames:
+    - "metabase.${ESTATE_ZONE}"
+  rules:
+    - matches:
+        - path: { type: PathPrefix, value: /oauth2/ }
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: oauth2-proxy
+          namespace: identity
+          port: 80
+    - filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: login-forward-auth
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: metabase
+          port: 3000
diff --git a/platform/observability/metabase-postgres.yaml b/platform/observability/metabase-postgres.yaml
new file mode 100644
index 000000000..99f858d21
--- /dev/null
+++ b/platform/observability/metabase-postgres.yaml
@@ -0,0 +1,84 @@
+# Metabase persistence: one StatefulSet storing dashboards, queries, and configuration, non-root,
+# read-only root, password from a mounted Secret. One database, metabase; the app runs its own
+# migrations on start (crew#R74 CP1).
+apiVersion: v1
+kind: Service
+metadata:
+  name: metabase-db
+  namespace: observability
+  labels: { app.kubernetes.io/name: metabase-db, app.kubernetes.io/part-of: idp, backstage.io/kubernetes-id: founder-jobs }
+spec:
+  type: ClusterIP
+  clusterIP: None
+  selector: { app.kubernetes.io/name: metabase-db }
+  ports:
+    - { name: pg, port: 5432, targetPort: 5432 }
+---
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  annotations:
+    reloader.stakater.com/auto: "true"
+  name: metabase-db
+  namespace: observability
+  labels: { app.kubernetes.io/name: metabase-db, app.kubernetes.io/part-of: idp }
+spec:
+  serviceName: metabase-db
+  replicas: 1
+  selector:
+    matchLabels: { app.kubernetes.io/name: metabase-db }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: metabase-db, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 70   # postgres uid in the alpine image
+        runAsGroup: 70
+        fsGroup: 70
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: postgres
+          image: docker.io/library/postgres:17.6-alpine
+          env:
+            - { name: POSTGRES_USER, value: metabase }
+            - { name: POSTGRES_DB, value: metabase }
+            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
+            - { name: POSTGRES_PASSWORD_FILE, value: /run/secrets/metabase-db/password }
+          ports:
+            - { containerPort: 5432, name: pg }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            exec: { command: ["pg_isready", "-U", "metabase", "-d", "metabase"] }
+            periodSeconds: 10
+          livenessProbe:
+            exec: { command: ["pg_isready", "-U", "metabase", "-d", "metabase"] }
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 50m, memory: 128Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          volumeMounts:
+            - { name: pgdata, mountPath: /var/lib/postgresql/data }
+            - { name: secret, mountPath: /run/secrets/metabase-db, readOnly: true }
+            - { name: run, mountPath: /var/run/postgresql }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: secret
+          secret: { secretName: metabase-db }
+        - name: run
+          emptyDir: {}
+        - name: tmp
+          emptyDir: {}
+  volumeClaimTemplates:
+    - metadata:
+        name: pgdata
+      spec:
+        accessModes: ["ReadWriteOnce"]
+        resources:
+          requests:
+            storage: 5Gi
