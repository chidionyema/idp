+# Apprise API reads channel URLs from the vault. Each row names a channel and its URL(s).
+# Example: notify-founder-telegram maps to the vault entry "notify-apprise-founder-telegram" which
+# contains the Telegram bot token and chat ID in URL form (tgram://bottoken/chatid/).
+# Slack and email are commented stubs for new integrations.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: notify-channels
+  namespace: notify
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: notify-channels
+    creationPolicy: Owner
+  data:
+    - secretKey: founder-telegram
+      remoteRef: { key: notify-apprise-founder-telegram }
+    # - secretKey: slack
+    #   remoteRef: { key: notify-apprise-slack }
+    # - secretKey: email
+    #   remoteRef: { key: notify-apprise-email }
