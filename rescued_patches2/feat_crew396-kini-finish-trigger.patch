diff --git a/features/sovereign-bus/cp0d_kini_finish_trigger.feature b/features/sovereign-bus/cp0d_kini_finish_trigger.feature
new file mode 100644
index 000000000..084a54300
--- /dev/null
+++ b/features/sovereign-bus/cp0d_kini_finish_trigger.feature
@@ -0,0 +1,18 @@
+Feature: CP0d "Finish KINI" is one word, and the answer is a receipt (crew#396 step 4)
+  Founder, 2026-08-26: "type 'Finish KINI', close the laptop, wake up to a green dashboard."
+  The word is an issue comment `FINISH: KINI` (or a dispatch). Actions renames the Job in
+  platform/temporal/kini-finish.yaml to the request and auto-merges; Flux applies it; the Job
+  runs `kini finish --wait` on the in-cluster engine; the kini-state CronJob publishes state/kini;
+  bin/idp-kini-state grades it in oke-check job kini-state, catalogue row kini-finish.
+
+  Scenario: the receipt head is total and the reader grades every branch both ways
+    Given every status the CLI can report
+    Then receipt_head maps NONE, RUNNING and a green COMPLETED to "ok" and anything red to "FAIL"
+    And bin/idp-kini-state passes a fresh green receipt and refuses a red or stale one
+
+  Scenario: the trigger is wired end to end in git
+    Given the workflow kini-finish.yml
+    Then it fires on an owner's `FINISH: KINI` comment, renames the Job and arms auto-merge
+    And platform/temporal renders the Job and the kini-state CronJob on the worker image and service account
+    And oke-check.yml has job kini-state and drills/catalogue.yaml has row kini-finish
+    And `kini receipt` is a CLI subcommand
diff --git a/platform/temporal/kini-finish.yaml b/platform/temporal/kini-finish.yaml
new file mode 100644
index 000000000..dcdf33d39
--- /dev/null
+++ b/platform/temporal/kini-finish.yaml
@@ -0,0 +1,51 @@
+# crew#396 step 4: the trigger. `FINISH: KINI` (an issue comment, or `gh workflow run
+# kini-finish.yml`) makes .github/workflows/kini-finish.yml rename this Job to
+# kini-finish-<request> on a branch and auto-merge it; Flux applies the new name, the Job starts
+# KiniFinishWorkflow on the in-cluster engine and waits for it. A completed Job is never re-run
+# by a metadata change, which is why the name carries the request. Same image, SA and profile
+# as worker.yaml; the pull secret is the namespace's mirrored ghcr-pull.
+apiVersion: batch/v1
+kind: Job
+metadata:
+  name: kini-finish-0
+  namespace: temporal
+  labels: { app.kubernetes.io/name: kini-finish }
+spec:
+  backoffLimit: 3
+  activeDeadlineSeconds: 7200
+  ttlSecondsAfterFinished: 86400
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: kini-finish }
+    spec:
+      serviceAccountName: sovereign-worker
+      automountServiceAccountToken: false
+      restartPolicy: Never
+      imagePullSecrets:
+        - name: ghcr-pull
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 10001
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: finish
+          image: idp/sovereign-worker:local
+          command: ["python", "-m", "sovereign.cli", "kini", "finish", "--wait", "--json"]
+          env:
+            - { name: TEMPORAL_HOST, value: temporal-frontend.temporal.svc }
+            - { name: TEMPORAL_PORT, value: "7233" }
+            - { name: TEMPORAL_NAMESPACE, value: estate }
+            - { name: ESTATE_HOME, value: /tmp/estate }
+            - { name: HOME, value: /tmp }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          volumeMounts:
+            - { name: tmp, mountPath: /tmp }
+          resources:
+            requests: { cpu: 50m, memory: 128Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+      volumes:
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/temporal/kini-state.yaml b/platform/temporal/kini-state.yaml
new file mode 100644
index 000000000..809060f22
--- /dev/null
+++ b/platform/temporal/kini-state.yaml
@@ -0,0 +1,83 @@
+# crew#396 step 4: the receipt. Every 15 minutes the init container asks the engine where the
+# KINI run is (`sovereign.cli kini receipt`: verdict line, then JSON) and the main container
+# puts it in the drill-receipts bucket as state/kini from the node's instance principal, the
+# same path platform/state/cluster-state.yaml uses. Reader: bin/idp-kini-state, job kini-state
+# in oke-check.yml, catalogue row kini-finish. Lives here, not in platform/state, because the
+# init container is the worker image and only this kustomization's image automation rolls it.
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: kini-state
+  namespace: temporal
+spec:
+  schedule: "*/15 * * * *"
+  concurrencyPolicy: Forbid
+  successfulJobsHistoryLimit: 1
+  failedJobsHistoryLimit: 2
+  jobTemplate:
+    spec:
+      backoffLimit: 2
+      activeDeadlineSeconds: 180
+      template:
+        spec:
+          serviceAccountName: sovereign-worker
+          automountServiceAccountToken: false
+          restartPolicy: Never
+          imagePullSecrets:
+            - name: ghcr-pull
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            seccompProfile: { type: RuntimeDefault }
+          initContainers:
+            - name: receipt
+              image: idp/sovereign-worker:local
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  set -eu
+                  python -m sovereign.cli kini receipt > /shared/receipt
+                  head -1 /shared/receipt
+              env:
+                - { name: TEMPORAL_HOST, value: temporal-frontend.temporal.svc }
+                - { name: TEMPORAL_PORT, value: "7233" }
+                - { name: TEMPORAL_NAMESPACE, value: estate }
+                - { name: ESTATE_HOME, value: /tmp/estate }
+                - { name: HOME, value: /tmp }
+              securityContext:
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: [ALL] }
+              volumeMounts:
+                - { name: shared, mountPath: /shared }
+                - { name: tmp, mountPath: /tmp }
+              resources:
+                requests: { cpu: 50m, memory: 128Mi }
+                limits: { cpu: 500m, memory: 512Mi }
+          containers:
+            - name: publish
+              # Same image and uid as platform/state/cluster-state.yaml.
+              image: ghcr.io/oracle/oci-cli:20260826
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  set -eu
+                  oci --auth instance_principal os object put --bucket-name estate-drill-receipts \
+                    --name state/kini --file /shared/receipt --content-type text/plain --force
+              env:
+                - { name: HOME, value: /tmp }
+              securityContext:
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: [ALL] }
+              volumeMounts:
+                - { name: shared, mountPath: /shared, readOnly: true }
+                - { name: tmp, mountPath: /tmp }
+              resources:
+                requests: { cpu: 50m, memory: 128Mi }
+                limits: { cpu: 500m, memory: 512Mi }
+          volumes:
+            - name: shared
+              emptyDir: {}
+            - name: tmp
+              emptyDir: {}
