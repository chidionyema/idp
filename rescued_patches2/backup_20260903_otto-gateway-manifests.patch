diff --git a/platform/otto-gateway/availability.yaml b/platform/otto-gateway/availability.yaml
new file mode 100644
index 000000000..9b10242c0
--- /dev/null
+++ b/platform/otto-gateway/availability.yaml
@@ -0,0 +1,12 @@
+# crew#539: a routed surface survives one node. A drain may never evict the last door;
+# minAvailable 1 against replicas 2 keeps one open and still lets every drain finish.
+apiVersion: policy/v1
+kind: PodDisruptionBudget
+metadata:
+  name: otto-gateway
+  namespace: otto-gateway
+spec:
+  minAvailable: 1
+  selector:
+    matchLabels:
+      app: otto-gateway
diff --git a/platform/otto-gateway/binding-seed.yaml b/platform/otto-gateway/binding-seed.yaml
new file mode 100644
index 000000000..eb6a20c40
--- /dev/null
+++ b/platform/otto-gateway/binding-seed.yaml
@@ -0,0 +1,52 @@
+# Binding row one, seeded from the vault.
+#
+# The door's whole premise is that onboarding a channel is a database write. That premise
+# needs one row to exist before the first message arrives, and the estate's operator chat is
+# it: customer `estate`, channel `telegram`, the operator's own chat as the external
+# identifier. Nothing in this file names that identifier or the credential -- both are read
+# at run time from files the secret store projects, and the credential is stored as a
+# one-way fingerprint, so the table holds no secret material even if it is dumped.
+#
+# The shape is the one platform/guacamole/guacamole.yaml already uses: an init container on
+# the pod that needs the data, running psql against a mounted script, idempotent under an
+# advisory lock so every replica may run it and only one does the work.
+#
+# The table definition here is the same definition otto/ingress/store.py declares. It is
+# repeated rather than imported because the init container is a plain postgres image with no
+# application code in it; tests/test_otto_gateway_manifests_are_releasable.py is the control
+# that keeps the two from drifting.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: otto-gateway-binding-seed
+  namespace: otto-gateway
+data:
+  seed.sql: |
+    SELECT pg_advisory_lock(776003);
+
+    CREATE TABLE IF NOT EXISTS channel_binding (
+        tenant_id         TEXT        NOT NULL,
+        channel           TEXT        NOT NULL,
+        external_id       TEXT        NOT NULL,
+        secret_ref        TEXT        NOT NULL,
+        token_fingerprint TEXT        NOT NULL,
+        status            TEXT        NOT NULL DEFAULT 'active',
+        created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
+        PRIMARY KEY (channel, external_id)
+    );
+
+    CREATE UNIQUE INDEX IF NOT EXISTS channel_binding_lookup
+        ON channel_binding (channel, token_fingerprint);
+
+    INSERT INTO channel_binding
+        (tenant_id, channel, external_id, secret_ref, token_fingerprint, status)
+    VALUES
+        ('estate', 'telegram', :'chat_id',
+         'vault://otto-staging-telegram/webhook_secret', :'fingerprint', 'active')
+    ON CONFLICT (channel, external_id) DO UPDATE SET
+        tenant_id = excluded.tenant_id,
+        secret_ref = excluded.secret_ref,
+        token_fingerprint = excluded.token_fingerprint,
+        status = excluded.status;
+
+    SELECT pg_advisory_unlock(776003);
diff --git a/platform/otto-gateway/deployment.yaml b/platform/otto-gateway/deployment.yaml
new file mode 100644
index 000000000..6e29d9a3e
--- /dev/null
+++ b/platform/otto-gateway/deployment.yaml
@@ -0,0 +1,152 @@
+# The Universal Event Gateway itself: `python -m otto.ingress`, from the same image the rest
+# of Otto runs (one build, several commands). The entrypoint refuses to start without the
+# collector, the binding database and the event bus, in that order, so a pod that is
+# listening is a pod that can accept a customer's event.
+apiVersion: v1
+kind: Service
+metadata:
+  name: otto-gateway
+  namespace: otto-gateway
+  labels:
+    app: otto-gateway
+    app.kubernetes.io/name: otto-gateway
+    app.kubernetes.io/part-of: idp
+    backstage.io/kubernetes-id: otto-gateway
+spec:
+  type: ClusterIP
+  selector: { app: otto-gateway }
+  ports:
+    - { name: http, port: 8080, targetPort: http }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  annotations:
+    reloader.stakater.com/auto: "true"
+  name: otto-gateway
+  namespace: otto-gateway
+  labels:
+    app: otto-gateway
+    app.kubernetes.io/name: otto-gateway
+    app.kubernetes.io/part-of: idp
+    backstage.io/kubernetes-id: otto-gateway
+spec:
+  # Two, because this is a routed surface and a drain may never take the last door
+  # (crew#539 availability).
+  replicas: 2
+  selector:
+    matchLabels: { app: otto-gateway }
+  template:
+    metadata:
+      labels:
+        app: otto-gateway
+        app.kubernetes.io/name: otto-gateway
+        app.kubernetes.io/part-of: idp
+    spec:
+      # DoNotSchedule and not ScheduleAnyway, the same choice otto-golden makes: two doors on
+      # one node are one eviction, and bin/idp-availability-gate refuses the softer form for
+      # a routed surface. On an estate with one node the second pod stays pending until a
+      # second node exists, which is the honest state rather than a false pair.
+      topologySpreadConstraints:
+        - maxSkew: 1
+          topologyKey: kubernetes.io/hostname
+          whenUnsatisfiable: DoNotSchedule
+          labelSelector:
+            matchLabels: { app: otto-gateway }
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 10001
+        runAsGroup: 10001
+        fsGroup: 10001
+        seccompProfile: { type: RuntimeDefault }
+      initContainers:
+        # Binding row one, from the vault. Reads the operator's chat and the Telegram
+        # webhook word from mounted files, turns the word into the one-way fingerprint the
+        # lookup indexes on, and writes the row. Idempotent: safe on every replica and on
+        # every restart, and it never prints either value.
+        - name: seed-binding
+          image: docker.io/library/postgres:17.6-alpine
+          command: ["/bin/sh", "-c"]
+          args:
+            - |
+              set -eu
+              PGPASSWORD=$(cat /run/secrets/otto-gateway-db/POSTGRES_PASSWORD); export PGPASSWORD
+              fingerprint=$(sha256sum < /run/secrets/otto-gateway-channels/OTTO_TELEGRAM_WEBHOOK_SECRET | cut -d' ' -f1)
+              psql -h otto-gateway-db -U otto_gateway -d otto_gateway -v ON_ERROR_STOP=1 \
+                -v chat_id="$(cat /run/secrets/otto-gateway-channels/TELEGRAM_CHAT_ID)" \
+                -v fingerprint="$fingerprint" \
+                -f /seed/seed.sql
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          resources:
+            requests: { cpu: 25m, memory: 64Mi }
+            limits: { cpu: 200m, memory: 128Mi }
+          volumeMounts:
+            - { name: db-password, mountPath: /run/secrets/otto-gateway-db, readOnly: true }
+            - { name: channels, mountPath: /run/secrets/otto-gateway-channels, readOnly: true }
+            - { name: seed, mountPath: /seed, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      containers:
+        - name: gateway
+          image: ghcr.io/chidionyema/hermes-agent
+          workingDir: /app/estate
+          command: ["/bin/sh", "-c"]
+          # The channel credential is read from its mounted file and exported here, never
+          # delivered as pod environment: Kyverno's secrets-not-from-env-vars policy refuses
+          # env.valueFrom.secretKeyRef on a pod. The variable name is not a choice made here
+          # -- otto/ingress/secrets.py maps the binding row's reference
+          # `vault://otto-staging-telegram/webhook_secret` onto exactly this name.
+          args:
+            - |
+              set -eu
+              OTTO_CHANNEL_SECRET_VAULT_OTTO_STAGING_TELEGRAM_WEBHOOK_SECRET=$(cat /run/secrets/otto-gateway-channels/OTTO_TELEGRAM_WEBHOOK_SECRET)
+              export OTTO_CHANNEL_SECRET_VAULT_OTTO_STAGING_TELEGRAM_WEBHOOK_SECRET
+              exec python -m otto.ingress
+          env:
+            - { name: OTTO_INGRESS_PORT, value: "8080" }
+            - { name: OTTO_INGRESS_DB_HOST, value: otto-gateway-db }
+            - { name: OTTO_INGRESS_DB_PORT, value: "5432" }
+            - { name: OTTO_INGRESS_DB_NAME, value: otto_gateway }
+            - { name: OTTO_INGRESS_DB_USER, value: otto_gateway }
+            - { name: OTTO_INGRESS_DB_PASSWORD_FILE, value: /run/secrets/otto-gateway-db/POSTGRES_PASSWORD }
+            - { name: OTTO_NATS_URL, value: "nats://nats.event-bus.svc:4222" }
+            # LAW 50. The entrypoint refuses to start without this, so a door that cannot be
+            # seen never opens rather than running dark.
+            - { name: OTEL_EXPORTER_OTLP_ENDPOINT, value: "http://signoz-otel-collector.observability.svc:4318" }
+            - { name: PYTHONUNBUFFERED, value: "1" }
+          ports:
+            - { containerPort: 8080, name: http }
+          startupProbe:
+            httpGet: { path: /healthz, port: http }
+            periodSeconds: 5
+            failureThreshold: 30
+          readinessProbe:
+            httpGet: { path: /healthz, port: http }
+            periodSeconds: 10
+          livenessProbe:
+            httpGet: { path: /healthz, port: http }
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 25m, memory: 128Mi }
+            limits: { cpu: 200m, memory: 256Mi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          volumeMounts:
+            - { name: db-password, mountPath: /run/secrets/otto-gateway-db, readOnly: true }
+            - { name: channels, mountPath: /run/secrets/otto-gateway-channels, readOnly: true }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: db-password
+          secret: { secretName: otto-gateway-db }
+        - name: channels
+          secret: { secretName: otto-gateway-channels }
+        - name: seed
+          configMap: { name: otto-gateway-binding-seed }
+        - name: tmp
+          emptyDir: {}
diff --git a/platform/otto-gateway/edge-manners.yaml b/platform/otto-gateway/edge-manners.yaml
new file mode 100644
index 000000000..b6fea356e
--- /dev/null
+++ b/platform/otto-gateway/edge-manners.yaml
@@ -0,0 +1,34 @@
+# Edge manners (crew#307 follow-up, founder 2026-08-29: a user saw Traefik's raw "no available
+# server" -- "amateur"). A Middleware is an ExtensionRef filter and must live in the route's own
+# area (Traefik Gateway API reference), which is why these two are repeated here rather than
+# referenced across from otto-golden.
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: friendly-errors
+  namespace: otto-gateway
+spec:
+  errors:
+    status: ["502-504"]
+    service:
+      name: status-page
+      namespace: edge
+      port: 80
+    query: "/{status}.html"
+---
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: edge-headers
+  namespace: otto-gateway
+spec:
+  headers:
+    stsSeconds: 63072000
+    stsIncludeSubdomains: true
+    stsPreload: true
+    contentTypeNosniff: true
+    customFrameOptionsValue: SAMEORIGIN
+    referrerPolicy: strict-origin-when-cross-origin
+    customResponseHeaders:
+      Server: ""
+      X-Powered-By: ""
diff --git a/platform/otto-gateway/external-secret.yaml b/platform/otto-gateway/external-secret.yaml
new file mode 100644
index 000000000..9396aeb81
--- /dev/null
+++ b/platform/otto-gateway/external-secret.yaml
@@ -0,0 +1,55 @@
+# Everything this area needs from the vault, and nothing written into git.
+#
+# Two Secrets, both mounted as files and never as pod environment: Kyverno's
+# secrets-not-from-env-vars policy refuses env.valueFrom.secretKeyRef and envFrom.secretRef
+# on a pod, and a value in the environment is readable by anything that can list the process.
+#
+# Rotation for any of these goes through `bin/idp-vault-put --merge <entry> <field>=...`,
+# never a chat, a manifest or a log (LAW 46, R49). A missing field fails the row by name,
+# never by printing a value.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: otto-gateway-db
+  namespace: otto-gateway
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: otto-gateway-db
+    creationPolicy: Owner
+  data:
+    # The binding database's own password. The database reads it as
+    # POSTGRES_PASSWORD_FILE and the door reads it as OTTO_INGRESS_DB_PASSWORD_FILE, so
+    # both sides read the same file and neither can drift onto a stale copy.
+    - secretKey: POSTGRES_PASSWORD
+      remoteRef: { key: otto-gateway-db, property: password }
+---
+# The channel credentials the door resolves at request time. The binding table stores a
+# reference (`vault://otto-staging-telegram/webhook_secret`), never material; this Secret is
+# what that reference resolves to inside the pod. The mapping from reference to key is
+# mechanical -- otto/ingress/secrets.py:env_var_name -- so an operator reading a binding row
+# knows which key it needs without a second lookup table to keep in sync.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: otto-gateway-channels
+  namespace: otto-gateway
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: otto-gateway-channels
+    creationPolicy: Owner
+  data:
+    # The word Telegram echoes in its secret-token header. Same vault entry and same field
+    # the otto-golden route already matches on, so the two doors agree during the overlap
+    # and the cutover changes nothing about the credential.
+    - secretKey: OTTO_TELEGRAM_WEBHOOK_SECRET
+      remoteRef: { key: otto-staging-telegram, property: webhook_secret }
+    # The operator's own chat, which is binding row one's external identifier. It comes from
+    # the entry the estate's alerting already reads (platform/robusta/external-secret.yaml
+    # takes the same field), so no new vault entry is invented for a value that exists, and
+    # the identifier never appears in this repository.
+    - secretKey: TELEGRAM_CHAT_ID
+      remoteRef: { key: flux-telegram, property: channel }
diff --git a/platform/otto-gateway/httproute.yaml b/platform/otto-gateway/httproute.yaml
new file mode 100644
index 000000000..e47698898
--- /dev/null
+++ b/platform/otto-gateway/httproute.yaml
@@ -0,0 +1,54 @@
+# One path for every channel: /webhook/<channel>.
+#
+# This route is added alongside the existing otto-golden route, not in place of it. The old
+# exact path /telegram-webhook keeps working and keeps its own edge header match while the
+# new door is proved on the same host; two routes on one host with different paths is what
+# makes the cutover a small, reversible change of its own.
+#
+# Where the credential is checked, and why it is not checked here. The otto-golden route
+# matches an exact secret-token header at the edge, which works because that door carries one
+# channel for one customer. This door carries every channel and every customer, and each one
+# presents a different credential in a different header -- there is no single header value an
+# edge rule could match without going back to one route per channel, which is the thing the
+# door exists to remove. The check moved one hop, into the door's first pipeline step: the
+# credential is looked up in the binding table, and an event whose credential matches no
+# active row is refused with the same answer as an event whose credential is wrong, so a
+# stranger cannot probe for which customers exist. `idp.estate/auth` below names that.
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: otto-gateway
+  namespace: otto-gateway
+  labels:
+    backstage.io/kubernetes-id: otto-gateway
+  annotations:
+    idp.estate/auth: channel-binding-registry
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-otto
+  hostnames:
+    - "otto.${ESTATE_ZONE}"
+  rules:
+    # Every inbound event, from every channel, for every customer. A prefix and not a list of
+    # exact paths: carrying a channel this estate has never carried before must not require
+    # editing this file.
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /webhook/
+          method: POST
+      filters:
+        - type: ExtensionRef
+          extensionRef: { group: traefik.io, kind: Middleware, name: friendly-errors }
+        - type: ExtensionRef
+          extensionRef: { group: traefik.io, kind: Middleware, name: edge-headers }
+      backendRefs:
+        - name: otto-gateway
+          port: 8080
+    # There is deliberately no public health path here. otto-golden already answers the exact
+    # path /healthz on this same host, and two routes claiming one exact path on one host is
+    # a precedence puzzle nobody should have to reason about during an incident. This door's
+    # health is graded where health belongs: the kubelet's three probes in deployment.yaml,
+    # and the Flux row's own health check on the Deployment.
diff --git a/platform/otto-gateway/kustomization.yaml b/platform/otto-gateway/kustomization.yaml
new file mode 100644
index 000000000..b31215c16
--- /dev/null
+++ b/platform/otto-gateway/kustomization.yaml
@@ -0,0 +1,21 @@
+# The Universal Event Gateway. Same image as platform/hermes-agent and platform/otto-golden
+# -- one build, several commands -- and the tag below carries the same $imagepolicy marker,
+# so the estate's one ImageUpdateAutomation bumps all three together on every build. No new
+# automation object: two automations on one push branch collide (crew#406).
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+namespace: otto-gateway
+resources:
+  - namespace.yaml
+  - quota.yaml
+  - network-policy.yaml
+  - external-secret.yaml
+  - postgres.yaml
+  - binding-seed.yaml
+  - deployment.yaml
+  - httproute.yaml
+  - edge-manners.yaml
+  - availability.yaml
+images:
+  - name: ghcr.io/chidionyema/hermes-agent
+    newTag: main-65-3c2b68b9faf88f27fb5160bf6283e326c6c91d22 # {"$imagepolicy": "flux-system:hermes-agent:tag"}
diff --git a/platform/otto-gateway/namespace.yaml b/platform/otto-gateway/namespace.yaml
new file mode 100644
index 000000000..9652c3e0d
--- /dev/null
+++ b/platform/otto-gateway/namespace.yaml
@@ -0,0 +1,31 @@
+# The Universal Event Gateway: one door for every channel and every customer.
+#
+# This is the door the founder's 2026-09-03 directive asked for. Onboarding a customer's
+# channel is a row in a database table, never a deployment: the door reads the credential
+# that arrived, looks up which customer owns it, and mints a task that carries that
+# customer's name. Adding a second customer, or a channel this estate has never carried,
+# changes no manifest in this directory.
+#
+# It is a separate area of the cluster from otto-golden, deliberately. otto-golden is the
+# single-tenant staging pod and keeps its own exact-path Telegram route untouched while this
+# door is proved; the cutover that removes that route is its own small change, released on
+# its own. Two doors answering on the same host, on different paths, is what makes that
+# cutover reversible.
+#
+# The fence (bin/ns-fence-gate, crew#191) wants a both-ways default-deny NetworkPolicy, a
+# ResourceQuota, a LimitRange and a DNS exception on every area. network-policy.yaml and
+# quota.yaml carry those.
+apiVersion: v1
+kind: Namespace
+metadata:
+  annotations:
+    # Never garbage-collected by Flux: an area moved between rows or dropped from git stays,
+    # with everything in it (portal 404, 2026-08-29 01:05Z, idp#648).
+    kustomize.toolkit.fluxcd.io/prune: disabled
+  name: otto-gateway
+  labels:
+    # Kyverno require-availability grades this area in the cluster too (crew#539).
+    availability.idp/tier: founder-facing
+    app.kubernetes.io/part-of: idp
+    pod-security.kubernetes.io/enforce: restricted
+    idp.estate/edge-attach: "true"   # the shared Gateway selects route areas by this label
diff --git a/platform/otto-gateway/network-policy.yaml b/platform/otto-gateway/network-policy.yaml
new file mode 100644
index 000000000..5c55ec31c
--- /dev/null
+++ b/platform/otto-gateway/network-policy.yaml
@@ -0,0 +1,122 @@
+# The crew#191 fence: a both-ways default deny, plus the narrow holes this door actually
+# needs -- DNS, the shared edge Gateway reaching the door's port, the estate's own trace
+# collector (LAW 50), the event bus the door hands tasks to, and the binding database that
+# lives in this same area.
+#
+# There is deliberately no hole to the public internet. The door only ever receives; it
+# never calls a channel's API back. That work belongs to the agent lanes reading the bus,
+# which run elsewhere and have their own fences. A door that cannot dial out is a door that
+# cannot be turned into an exfiltration path by a bad event.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: default-deny-all
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Ingress, Egress]
+---
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-dns-egress
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Egress]
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: kube-system
+          podSelector:
+            matchLabels:
+              k8s-app: kube-dns
+      ports:
+        - protocol: UDP
+          port: 53
+        - protocol: TCP
+          port: 53
+---
+# The shared Traefik gateway (area `edge`) is what an HTTPRoute forwards through; without
+# this, a channel's POST to /webhook/telegram and the edge's own health probe would arrive
+# at a pod that drops every inbound packet by default.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-ingress-from-edge
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Ingress]
+  ingress:
+    - from:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: edge
+      ports:
+        - protocol: TCP
+          port: 8080
+---
+# LAW 50: every workload emits to the central collector. The door refuses to start without
+# the collector endpoint, so this rule is not optional decoration -- without it the pod
+# starts, exports nothing, and reads green.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-egress-observability
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Egress]
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: observability
+      ports:
+        - protocol: TCP
+          port: 4318
+---
+# The door's whole output: a task envelope on the estate's event bus. Without this the door
+# accepts a customer's event, cannot publish it, and answers unavailable -- loudly, which is
+# right, but the fix is this rule.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-egress-event-bus
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Egress]
+  egress:
+    - to:
+        - namespaceSelector:
+            matchLabels:
+              kubernetes.io/metadata.name: event-bus
+      ports:
+        - protocol: TCP
+          port: 4222
+---
+# The binding table lives in this same area, so this rule is area-internal on both sides:
+# the door reaches the database, and the database accepts only from this area.
+apiVersion: networking.k8s.io/v1
+kind: NetworkPolicy
+metadata:
+  name: allow-binding-database
+  namespace: otto-gateway
+spec:
+  podSelector: {}
+  policyTypes: [Ingress, Egress]
+  ingress:
+    - from:
+        - podSelector: {}
+      ports:
+        - protocol: TCP
+          port: 5432
+  egress:
+    - to:
+        - podSelector: {}
+      ports:
+        - protocol: TCP
+          port: 5432
diff --git a/platform/otto-gateway/postgres.yaml b/platform/otto-gateway/postgres.yaml
new file mode 100644
index 000000000..38a4b4104
--- /dev/null
+++ b/platform/otto-gateway/postgres.yaml
@@ -0,0 +1,99 @@
+# The binding table's database. Same shape as platform/llm/postgres.yaml and
+# platform/backstage/base/postgres.yaml: a headless ClusterIP Service reachable only inside
+# this area, the official alpine image reading POSTGRES_PASSWORD_FILE from a mounted Secret.
+#
+# Its own instance rather than a shared one, because that is what this estate does: llm,
+# hindsight, temporal, healthchecks, guacamole, commerce and backstage each run their own.
+# A shared database here would be the new thing, not the reuse -- and one customer table
+# behind one lifecycle is what lets this area be restored, moved or deleted on its own.
+apiVersion: v1
+kind: Service
+metadata:
+  name: otto-gateway-db
+  namespace: otto-gateway
+  labels:
+    app.kubernetes.io/name: otto-gateway-db
+    app.kubernetes.io/part-of: idp
+    backstage.io/kubernetes-id: otto-gateway
+spec:
+  type: ClusterIP
+  clusterIP: None
+  selector: { app.kubernetes.io/name: otto-gateway-db }
+  ports:
+    - { name: pg, port: 5432, targetPort: 5432 }
+---
+apiVersion: apps/v1
+kind: StatefulSet
+metadata:
+  annotations:
+    # Reloader discovers every Secret and ConfigMap this pod references and rolls it when
+    # one changes; platform/edge/require-auto-reload.yaml injects this at admission, so git
+    # and the cluster say the same thing.
+    reloader.stakater.com/auto: "true"
+  name: otto-gateway-db
+  namespace: otto-gateway
+  labels:
+    app.kubernetes.io/name: otto-gateway-db
+    app.kubernetes.io/part-of: idp
+spec:
+  serviceName: otto-gateway-db
+  replicas: 1
+  selector:
+    matchLabels: { app.kubernetes.io/name: otto-gateway-db }
+  template:
+    metadata:
+      labels:
+        app.kubernetes.io/name: otto-gateway-db
+        app.kubernetes.io/part-of: idp
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 70   # postgres uid in the alpine image
+        runAsGroup: 70
+        fsGroup: 70
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: postgres
+          image: docker.io/library/postgres:17.6-alpine
+          env:
+            - { name: POSTGRES_USER, value: otto_gateway }
+            - { name: POSTGRES_DB, value: otto_gateway }
+            - { name: PGDATA, value: /var/lib/postgresql/data/pgdata }
+            - { name: POSTGRES_PASSWORD_FILE, value: /run/secrets/otto-gateway-db/POSTGRES_PASSWORD }
+          ports:
+            - { containerPort: 5432, name: pg }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            exec: { command: ["pg_isready", "-U", "otto_gateway", "-d", "otto_gateway"] }
+            periodSeconds: 10
+          livenessProbe:
+            exec: { command: ["pg_isready", "-U", "otto_gateway", "-d", "otto_gateway"] }
+            periodSeconds: 30
+            failureThreshold: 3
+          resources:
+            requests: { cpu: 50m, memory: 128Mi }
+            limits: { cpu: 500m, memory: 512Mi }
+          volumeMounts:
+            - { name: pgdata, mountPath: /var/lib/postgresql/data }
+            - { name: db-password, mountPath: /run/secrets/otto-gateway-db, readOnly: true }
+            - { name: run, mountPath: /var/run/postgresql }
+            - { name: tmp, mountPath: /tmp }
+      volumes:
+        - name: db-password
+          secret: { secretName: otto-gateway-db }
+        - name: run
+          emptyDir: {}
+        - name: tmp
+          emptyDir: {}
+  volumeClaimTemplates:
+    - metadata:
+        name: pgdata
+      spec:
+        accessModes: ["ReadWriteOnce"]
+        resources:
+          requests:
+            storage: 2Gi
diff --git a/platform/otto-gateway/quota.yaml b/platform/otto-gateway/quota.yaml
new file mode 100644
index 000000000..bf81d2800
--- /dev/null
+++ b/platform/otto-gateway/quota.yaml
@@ -0,0 +1,28 @@
+# Half of the crew#191 fence (network-policy.yaml is the other half). Sized for what this
+# area actually runs: two door pods, one surge pod during a rolling update, and one database
+# pod. A runaway process still cannot starve the node, and a rollout is never forbidden by
+# its own ceiling -- the main-62 roll wedged on exactly that.
+apiVersion: v1
+kind: LimitRange
+metadata:
+  name: otto-gateway-defaults
+  namespace: otto-gateway
+spec:
+  limits:
+    - type: Container
+      default: { cpu: 200m, memory: 256Mi }
+      defaultRequest: { cpu: 50m, memory: 128Mi }
+      max: { cpu: 500m, memory: 512Mi }
+---
+apiVersion: v1
+kind: ResourceQuota
+metadata:
+  name: otto-gateway-ceiling
+  namespace: otto-gateway
+spec:
+  hard:
+    requests.cpu: 300m
+    requests.memory: 640Mi
+    limits.cpu: 1200m
+    limits.memory: 1536Mi
+    pods: "6"
