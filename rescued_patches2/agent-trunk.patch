+
+def test_scrub_blind_when_ledger_missing(tmp_path, monkeypatch):
+    monkeypatch.setenv("ESTATE_DB", str(tmp_path / "never.db"))
+    s = scrub._scrub("2026-09-22")
+    assert s["available"] is False
