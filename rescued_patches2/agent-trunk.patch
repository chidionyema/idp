@@ -0,0 +1,88 @@
+name: mac-provision-test
+
+# Why this exists (per docs/reference/security-architecture.md):
+# the founder's Mac provisioning is declared in infra/macos/Brewfile +
+# infra/macos/LaunchDaemons + bin/idp-mac-provision. The whole install
+# path converges from zero, hands-off, on a fresh machine — and the only
+# way to prove that is to run it on a fresh machine. There is no founder
+# interaction in this CI lane; the renderer substitutes empty strings for
+# SPIRE secrets so SPIRE never connects.
+
+on:
+  pull_request:
+    paths:
+      - "infra/macos/**"
+      - "bin/idp-mac-provision"
+      - ".github/workflows/mac-provision-test.yml"
+  push:
+    branches: [main]
+    paths:
+      - "infra/macos/**"
+      - "bin/idp-mac-provision"
+      - ".github/workflows/mac-provision-test.yml"
+
+jobs:
+  provision:
+    runs-on: macos-14
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v7
+
+      - name: Homebrew is present (macos-14 runner has it)
+        run: |
+          brew --version
+          HOMEBREW_NO_AUTO_UPDATE=1 brew update --auto-update=false || true
+
+      - name: bin/idp-mac-provision self-test (parses, files present)
+        run: bin/idp-mac-provision self-test
+
+      - name: brew bundle install --no-upgrade against infra/macos/Brewfile
+        # Idempotent on a clean macos-14 runner. Catches any drift in the
+        # Brewfile (a published tap disappearing, a formula renamed, a
+        # version pulled). Whatever fails here, no founder Mac installs.
+        run: |
+          brew bundle install --file infra/macos/Brewfile --no-upgrade
+          brew bundle check --file infra/macos/Brewfile --verbose
+
+      - name: bin/idp-mac-provision install (dry-run path via IDP_MAC_PROVISION_DRY=1)
+        env:
+          IDP_MAC_PROVISION_DRY: "1"
+        # The dry-run path renders templates and lays plists under
+        # /tmp/idp-mac-provision-test/ so the test is observable in
+        # artifacts but never touches the runner's real LaunchAgent dir
+        # or /etc/spire. Real install runs against a founder Mac on a
+        # properly-tailneted machine.
+        run: |
+          mkdir -p /tmp/idp-mac-provision-test
+          IDP_MAC_PROVISION_DRY=1 bin/idp-mac-provision install 2>&1 | tee /tmp/install.log
+
+      - name: bin/idp-mac-provision status (JSON on stdout)
+        run: bin/idp-mac-provision status
+
+      - name: bin/idp-mac-provision status parses + every component reports a structured field
+        # Catches breakage in the status contract — the consumer of this
+        # JSON is the dashboard at mumchimp.com/devices, which reads the
+        # status and renders a green/red row per component.
+        run: |
+          json=$(bin/idp-mac-provision status)
+          echo "$json" | python3 -c "
+import json, sys
+d = json.load(sys.stdin)
+required = ['brew', 'tailscale', 'spire', 'executor', 'renew']
+for k in required:
+    assert k in d, f'missing component: {k}'
+    assert 'installed' in d[k], f'missing installed field on {k}'
+    assert 'status' in d[k], f'missing status field on {k}'
+    assert isinstance(d[k]['installed'], int), f'installed must be int on {k}'
+print('OK status contract holds for', len(d), 'components')
+"
+
+      - name: bin/idp-mac-provision uninstall + install re-runs converge (idempotency)
+        # The whole point of declarative provisioning: install → uninstall →
+        # install converges to the same state, with no diff. A regression
+        # here means the templates drift on re-render and the founder's
+        # Mac accumulates state across re-runs.
+        run: |
+          bin/idp-mac-provision uninstall
+          IDP_MAC_PROVISION_DRY=1 bin/idp-mac-provision install
+          IDP_MAC_PROVISION_DRY=1 bin/idp-mac-provision install  # must be a no-op
diff --git a/.github/workflows/shadow-verify.yml b/.github/workflows/shadow-verify.yml
new file mode 100644
index 000000000..33e25caf3
--- /dev/null
+++ b/.github/workflows/shadow-verify.yml
@@ -0,0 +1,108 @@
+# button: Prove a change runs before it merges
+# founder: Builds a throwaway Kubernetes cluster, lets Flux deploy the change into it, and fails the pull request unless the workload really starts and stays up. The cluster is destroyed afterwards and can never reach production.
+# shadow-verify -- the environment proves the change, on a cluster that did not exist before the job.
+#
+# Founder, 2026-09-21: "we going for mathematical guarantees" / "agents are not deploying, the
+# environment is" / "i dont want agents anywhere near production cluster" / "they do their work,
+# handover to environment to verify and deploy".
+#
+# This job is that handover. It holds NO estate credential and never speaks to OKE. It creates a
+# throwaway k3d cluster, installs Flux -- the same reconciler that runs production -- serves this
+# PR's tree on the runner's loopback, and pins a Flux GitRepository to the head commit. From that
+# point Flux applies the change and Flux decides whether it converged; the job only reads the
+# result back out of the API server and grades it fail-closed (bin/idp-shadow-verify).
+#
+# What it replaces: until today `shadow-verify` was a check name with nothing behind it.
+# bin/idp-pr-landable:154 already required it before a type:auto-remediation PR could merge, and
+# deploy-when-green.yml already consumed it, so every such PR returned SKIP forever -- fail-closed
+# and safe, but the loop never closed. The producer was bin/idp-shadow-run, which minted the green
+# line from a JSON observation handed to it on the command line. That file is deleted with this
+# commit; a proof a process writes about its own work is not a proof.
+name: shadow-verify
+# NO paths: filter, deliberately. This check is REQUIRED on the default branch, and GitHub never
+# reports a path-filtered check on a PR that does not match its filter -- the PR then waits forever
+# on a check that will never arrive. The job therefore always runs and decides its own scope: when
+# the diff touches no directory the environment would have to accept, it says so and passes,
+# which is a real verdict about a real (empty) scope, not a skip.
+on:
+  pull_request:
+  workflow_dispatch:
+    inputs:
+      paths:
+        description: 'space-separated dirs to reconcile (default: what the diff changed)'
+        required: false
+
+concurrency:
+  group: shadow-verify-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  shadow-verify:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          # The shadow proves the head commit itself, so the tree must be the head, not a
+          # merge commit GitHub synthesised, and the history must reach the base to diff it.
+          ref: ${{ github.event.pull_request.head.sha || github.sha }}
+          fetch-depth: 0
+
+      - name: Which directories is this change asking the environment to accept?
+        id: scope
+        run: |
+          set -euo pipefail
+          if [ -n "${{ github.event.inputs.paths }}" ]; then
+            dirs="${{ github.event.inputs.paths }}"
+          else
+            base="${{ github.event.pull_request.base.sha }}"
+            [ -n "$base" ] || base="$(git rev-parse HEAD~1)"
+            # One owner for this list already exists; a second would disagree with it (crew#623).
+            dirs="$(bin/idp-kyverno-dirs "$base" --narrow | tr '\n' ' ')"
+          fi
+          echo "dirs=$dirs" >> "$GITHUB_OUTPUT"
+          if [ -z "${dirs// /}" ]; then
+            echo "no platform directory changed; nothing for the environment to accept"
+          else
+            echo "the environment is asked to accept: $dirs"
+          fi
+
+      - name: Install k3d and Flux
+        if: steps.scope.outputs.dirs != ''
+        run: |
+          set -euo pipefail
+          curl -sSL https://raw.githubusercontent.com/k3d-io/k3d/main/install.sh | bash
+          curl -sSL https://fluxcd.io/install.sh | sudo bash
+          k3d version && flux --version
+
+      - name: Stand up the shadow cluster and put the environment in it
+        if: steps.scope.outputs.dirs != ''
+        run: bin/idp-shadow up
+
+      - name: Hand the commit to Flux and read back what really happened
+        if: steps.scope.outputs.dirs != ''
+        env:
+          IDP_SHADOW_TIMEOUT: '900'
+        run: |
+          set -euo pipefail
+          args=""
+          for d in ${{ steps.scope.outputs.dirs }}; do args="$args --path $d"; done
+          bin/idp-shadow verify --head "${{ github.event.pull_request.head.sha || github.sha }}" $args
+
+      - name: What the environment saw, when it refused
+        if: failure()
+        run: |
+          kubectl get kustomizations -n flux-system -o wide || true
+          kubectl get events -A --sort-by=.lastTimestamp | tail -40 || true
+          kubectl get pods -A -o wide || true
+          for p in $(kubectl get pods -A -o jsonpath='{range .items[?(@.status.phase!="Running")]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}' 2>/dev/null | head -10); do
+            echo "--- logs $p"
+            kubectl logs -n "${p%%/*}" "${p##*/}" --tail=50 --all-containers 2>&1 | tail -50 || true
+          done
+
+      - name: Tear the shadow down
+        if: always()
+        run: bin/idp-shadow down || true
