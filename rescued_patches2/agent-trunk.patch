+
+  policy-violation:
+    when: >-
+      Does this change violate a documented contribution policy, a gate, or a law stated
+      in this repository's AGENTS.md?
+    weight: 3
+
+  oversized:
+    when: >-
+      Is this patch unusually large, or is its file-type mix of the kind correlated with
+      abandoned or high-maintenance pull requests in this repository?
+    weight: 1
+
+  gate-weakening:
+    when: >-
+      Does this change remove, weaken, quarantine, or skip an existing test, gate, or check
+      rather than fixing the failure it reports?
+    weight: 3
+
+  credentials:
+    when: >-
+      Does this change introduce a credential, token, key, or secret value anywhere other
+      than a reference to its name?
+    weight: 3
