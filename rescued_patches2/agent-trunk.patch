+# The declared host tool set -- what must exist on a machine that runs this estate.
+#
+# Read by `bin/idp-host-drift`, which measures this list against what is actually present and
+# reports three counters: missing (declared, absent), shadowed (present twice, PATH resolving
+# to the undeclared one), and undeclared (present and working, but no row here names it).
+#
+# WHY A FILE. Before this, the declared set lived in `bin/idp-install-deps` as local shell
+# variables -- a list that KNOWS what should exist and is never compared against what does.
+# The 2026-09-23 audit found eight hand-installed items on the founder's Mac, three of them
+# load-bearing for gates that pass: ruff (the gate's own checker), jsonschema (a runtime
+# import of voice_media.py), and /usr/local/bin/timeout (the executor's wrapper).
+#
+# `paths` is tried in order; the first existing file wins. `version_command` is run only when
+# present, and its failure is reported, never raised -- a broken binary is a finding, not an
+# exception.
+tools:
+  - name: ruff
+    paths:
+      - ~/Library/Python/3.9/bin/ruff
+      - ~/.cache/estate-tools/ruff
+    version: "0.15.18"
+    version_command: [python3, -m, ruff, --version]
+    why: bin/idp-ruff and the pre-push gate both invoke it as a module.
+
+  - name: jsonschema
+    paths: []
+    version: "4.26.0"
+    version_command: [python3, -c, "import jsonschema; print(jsonschema.__version__)"]
+    why: runtime import of backstage/plugins/fleetview-backend/src/voice_media.py.
+
+  - name: kyverno
+    paths: [~/.cache/estate-tools/kyverno]
+    version: "1.19.0"
+    version_command: [~/.cache/estate-tools/kyverno, version]
+    why: policy admission render, pinned by bin/idp-install-deps.
+
+  - name: conftest
+    paths:
+      - ~/.cache/estate-tools/conftest
+      - ~/.local/bin/conftest
+    version: "0.62.0"
+    version_command: [~/.cache/estate-tools/conftest, --version]
+    why: policy tests. Two copies present on 2026-09-23 -- the shadowed case.
+
+  - name: helm
+    paths:
+      - ~/.cache/estate-tools/helm
+      - ~/.rd/bin/helm
+    version: "3.19.0"
+    version_command: [~/.cache/estate-tools/helm, version, --short]
+    why: manifest render. Rancher Desktop ships its own; PATH may resolve to it.
+
+  - name: flux
+    paths: [~/.cache/estate-tools/flux]
+    version: "2.9.4"
+    version_command: [~/.cache/estate-tools/flux, --version]
+    why: Flux CLI, pinned by bin/idp-install-deps.
+
+  - name: kustomize
+    paths: [~/.cache/estate-tools/kustomize]
+    version: "5.7.1"
+    version_command: [~/.cache/estate-tools/kustomize, version]
+    why: Kustomization build, pinned by bin/idp-install-deps.
+
+  - name: kubeconform
+    paths: [~/.cache/estate-tools/kubeconform]
+    version: "0.8.0"
+    version_command: [~/.cache/estate-tools/kubeconform, -v]
+    why: schema validation, pinned by bin/idp-install-deps.
+
+  - name: timeout
+    paths: [/usr/local/bin/timeout, /opt/homebrew/bin/gtimeout]
+    why: >-
+      the executor daemon's 60s wrapper. Its absence stops EVERY command capability --
+      measured 2026-09-23, when it reported ECONNREFUSED-adjacent 127 errors on every job.
diff --git a/infra/macos/Brewfile b/infra/macos/Brewfile
new file mode 100644
index 000000000..07af1c1fb
--- /dev/null
+++ b/infra/macos/Brewfile
@@ -0,0 +1,68 @@
+# infra/macos/Brewfile — declarative dependency list for the founder's Mac.
+#
+# Why a Brewfile and not the curl recipes in bin/idp-workstation-bootstrap:
+#
+#   brew bundle install is the enterprise-Mac idiom. It is idempotent (a present
+#   keg is a no-op), it is version-controlled, it survives a clean `git clone` of
+#   this repo, it converges on a fresh Mac in one command, and it is testable in
+#   CI on `macos-14` (where the founder installed Homebrew takes <2 min). The curl
+#   recipes were the opposite of every one of those properties, and the founder's
+#   2026-09-23 "we have memory systems, documents, code yet no one knows how
+#   anything works" was the bill.
+#
+# Idempotency model:
+#
+#   * Every formula is pinned to an exact version. `brew bundle install` will not
+#     upgrade a present keg; out-of-date deps stay pinned until a deliberate
+#     `brew bundle upgrade --formula=X` lands. This makes "what does this Mac
+#     have on it" reproducible from the file.
+#
+#   * The CI rung `infra-macos-bundle` (in bin/idp-ci) runs `brew bundle check
+#     --verbose` after every PR that touches this file. A missing dep is FAIL.
+#
+#   * `brew bundle dump --file infra/macos/Brewfile --force` is the one command
+#     that overwrites this file from the live install; the CI rung will refuse
+#     any PR that runs the same command against an unchanged dep set.
+#
+# Install-from-source rows (spire, tailscale) use the official upstream recipe.
+# Where a stable tap exists (fluxcd/tap/flux) the Brewfile names it explicitly;
+# building from head is never the right default.
+
+# --- Taps ---
+tap "fluxcd/tap"
+
+# --- CLI formulae, pinned ---
+brew "jq",    "1.7.1"
+brew "yq",    "4.40.5"
+brew "gh",    "2.50.0"
+brew "kubectl", "1.30.0"
+brew "helm",  "3.14.0"
+brew "flux",  "2.3.0"   # from fluxcd/tap
+brew "sops",  "3.8.1"
+brew "age",   "1.2.1"
+brew "mas",   "1.8.7"   # Mac App Store CLI for App Store casks
+brew "shellcheck", "0.9.0"
+brew "shfmt",      "3.7.0"
+brew "actionlint", "1.6.27"
+
+# --- SPIRE / SPIFFE primary ---
+# The cluster SPIRE control plane + agent run in the cluster (platform/spire);
+# the Workload API socket + JWT-SVID minting runs on this Mac via this row.
+# Built from the upstream GitHub source because the official homebrew-core
+# formula is the server+agent both; we want the agent pinned to the same
+# version as the cluster's helmrelease.
+brew "spire", "1.15.3"
+
+# --- GUI / system-extension casks ---
+# Tailscale installs the daemon (`tailscaled`) plus the Mac system extension that
+# the OS approves per-machine. The .pkg-install system extension approval is
+# the one Mac GUI prompt in the whole install path; `idp-mac-provision install`
+# invokes `tailscaled` once via launchctl after brew lays the binary, and
+# the user-facing approval happens when the .app is first opened from /Applications.
+cask "tailscale"
+
+# --- Mac App Store ---
+# No MAS apps today. Add here when one ships. `mas signin` once, then
+# `mas install <id>` on every Mac. CI test skips this row because the
+# runner is signed out of MAS.
+# mas "Example App Name", id: 1234567890
diff --git a/infra/macos/LaunchDaemons/com.estate.jit-device-renew.plist b/infra/macos/LaunchDaemons/com.estate.jit-device-renew.plist
