index 000000000..4a86b69a9
--- /dev/null
+++ b/platform/unified-memory-server/oke-unified-memory.yaml
@@ -0,0 +1,169 @@
+---
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: memory-server-config
+data:
+  TUDUDI_HOSTED_MODE: "true"
+  # LAW 4: DATABASE_URL is injected from a Secret (SOPS + age via estate-secrets),
+  # never committed as a literal. The connection string carries the password.
+---
+apiVersion: v1
+kind: Secret
+metadata:
+  name: memory-db-secret
+stringData:
+  DATABASE_URL: "postgresql://matrix_admin:$(DB_PASSWORD)@memory-db-service:5432/agent_memory"
+  POSTGRES_USER: "matrix_admin"
+  POSTGRES_PASSWORD: "$(DB_PASSWORD)"
+  POSTGRES_DB: "agent_memory"
+---
+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: pgvector-block-pvc
+spec:
+  accessModes:
+    - ReadWriteOnce
+  storageClassName: oci-bv
+  resources:
+    requests:
+      storage: 50Gi
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: unified-memory-db
+spec:
+  replicas: 1
+  selector:
+    matchLabels:
+      app: unified-memory-db
+  template:
+    metadata:
+      labels:
+        app: unified-memory-db
+    spec:
+      nodeSelector:
+        kubernetes.io/arch: arm64
+      containers:
+        - name: pgvector
+          image: pgvector/pgvector:pg16
+          ports:
+            - containerPort: 5432
+          env:
+            - name: POSTGRES_USER
+              valueFrom:
+                secretKeyRef:
+                  name: memory-db-secret
+                  key: POSTGRES_USER
+            - name: POSTGRES_PASSWORD
+              valueFrom:
+                secretKeyRef:
+                  name: memory-db-secret
+                  key: POSTGRES_PASSWORD
+            - name: POSTGRES_DB
+              valueFrom:
+                secretKeyRef:
+                  name: memory-db-secret
+                  key: POSTGRES_DB
+          resources:
+            requests:
+              cpu: "1000m"
+              memory: "4Gi"
+            limits:
+              cpu: "2000m"
+              memory: "8Gi"
+          volumeMounts:
+            - name: pgdata
+              mountPath: /var/lib/postgresql/data
+      volumes:
+        - name: pgdata
+          persistentVolumeClaim:
+            claimName: pgvector-block-pvc
+---
