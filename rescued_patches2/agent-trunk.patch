+# ghcr-pull for this namespace, mirrored from backstage/ghcr-pull through the ClusterSecretStore
+# ghcr-pull (platform/image-automation/pull-secret.yaml, crew#396 step 2). Same shape as
+# platform/temporal/pull-secret.yaml, which is the first namespace to have done this.
+#
+# This namespace pulls its first private ghcr image with zeroedge.yaml. bin/idp-flux-bootstrap
+# writes the pull secret from a laptop into a fixed list of namespaces (backstage, prospector,
+# edge, flux-system) and llm is not one of them -- a namespace that pulls from ghcr must not
+# need a laptop, which is the whole point of the ClusterSecretStore.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: ghcr-pull
+  namespace: llm
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: ghcr-pull }
+  target:
+    name: ghcr-pull
+    creationPolicy: Owner
+    template:
+      type: kubernetes.io/dockerconfigjson
+  data:
+    - secretKey: .dockerconfigjson
+      remoteRef: { key: ghcr-pull, property: .dockerconfigjson }
