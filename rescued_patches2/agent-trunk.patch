new file mode 100755
index 000000000..3d84c2455
--- /dev/null
+++ b/bin/idp-pr-risk
@@ -0,0 +1,94 @@
+#!/usr/bin/env python3
+"""idp-pr-risk -- score a change BEFORE it is pushed: will this be rejected?
+
+THE LAYER THIS IS. Every other PR check in this estate runs after the branch exists and CI
+has already spent minutes on it. This one answers the author's actual question, from the
+diff, with no CI run and no pull request opened. It ADVISES; it refuses nothing. The refusal
+at push time is `bin/idp-pr-risk-gate`, and a decision to override it is a person's.
+
+    bin/idp-pr-risk                 # advise: tier + the conditions that drove it
+    bin/idp-pr-risk --json          # machine-readable, for a hook or an agent
+    bin/idp-pr-risk --base main     # score against another base ref
+
+EXIT CODES. 0 for low/medium, 1 for high. `--json` keeps the same codes, so a caller can
+read the tier AND branch on the exit status without parsing prose.
+
+FAIL-OPEN, STATED PLAINLY. The conditions live in `jev-pr-risk.yml`; if it is missing or
+unreadable the tool says so and returns tier `low` with `config_error` set -- a gate that
+cannot read its own rules is not evidence the change is risky, so it does not manufacture a
+refusal. The same is true of an unreachable decision layer: the conditions it could not
+answer count as LIKELY (a reason to look), never as cleared.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import json
+import sys
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parent.parent
+JEV = REPO / "mcp" / "plugins" / "jev.py"
+
+
+def _load_jev():
+    """Load jev.py by path, the way every sibling MCP plugin is loaded (see idp-affected)."""
+    spec = importlib.util.spec_from_file_location("idp_jev_pr_risk", JEV)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {JEV}")
+    module = importlib.util.module_from_spec(spec)
+    sys.modules["idp_jev_pr_risk"] = module
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description="pre-submission PR risk")
+    ap.add_argument("--repo", default=str(REPO))
+    ap.add_argument("--base", default="origin/main")
+    ap.add_argument("--json", action="store_true", help="machine-readable output")
+    args = ap.parse_args()
+
+    jev = _load_jev()
+    result = jev.jev_pr_risk(args.repo, args.base)
+
+    if args.json:
+        print(json.dumps(result, indent=2))
+        return 1 if result["tier"] == jev.PR_RISK_BLOCK_TIER else 0
+
+    if result.get("config_error"):
+        print(
+            f"idp-pr-risk: config: {result['config_error']} (advising low)",
+            file=sys.stderr,
+        )
+    if result.get("diff_error"):
+        print(f"idp-pr-risk: diff: {result['diff_error']}", file=sys.stderr)
+    if result.get("escalated"):
+        print(
+            "idp-pr-risk: note -- a condition escalated; it counts as likely",
+            file=sys.stderr,
+        )
+
+    print(
+        f"idp-pr-risk: base={result['base']} tier={result['tier']} score={result['score']}"
+    )
+    for c in result["conditions"]:
+        mark = "LIKELY" if c["contributed"] else "clear "
+        prob = "" if c["probability"] is None else f" P={float(c['probability']):.3f}"
+        print(f"  {mark} (w={c['weight']}) {c['name']}{prob}")
+        if c["contributed"]:
+            print(f"         {c['when']}")
+
+    if result["tier"] == jev.PR_RISK_BLOCK_TIER:
+        print(
+            "idp-pr-risk: HIGH -- a person should read this before it is pushed. "
+            "Override deliberately, not by habit.",
+            file=sys.stderr,
+        )
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bin/idp-pr-risk-gate b/bin/idp-pr-risk-gate
new file mode 100755
index 000000000..cdeb8634e
--- /dev/null
+++ b/bin/idp-pr-risk-gate
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# bin/idp-pr-risk-gate: the push-time caller of `bin/idp-pr-risk`.
+#
+# WHY THIS FILE EXISTS SEPARATELY FROM idp-pr-risk. The scorer is an ADVISOR: it prints a
+# tier and exits 1 at `high`, and a person (or an agent) may read it and proceed. This is the
+# hook-facing wrapper, and it is the only place a push is refused -- so the place that can
+# stop someone is one small, greppable file rather than buried in the scorer.
+#
+# IT REFUSES AT `high` ONLY, and only when a decision layer is actually reachable. If the
+# scorer cannot read `jev-pr-risk.yml`, or the layer is unreachable, the tier it returns is
+# not evidence of risk -- and a fence a correct machine cannot satisfy is an outage (LAW 38).
+# In those cases this prints the reason and ALLOWS the push.
+#
+# OVERRIDE, deliberately, never by habit:
+#   IDP_PR_RISK_GATE=0 git push
+#
+#   bin/idp-pr-risk-gate            # refuse only at high
+#   bin/idp-pr-risk-gate --advise   # never refuse; print the tier
+set -euo pipefail
+
+IDP="$(cd "$(dirname "$0")/.." && pwd)"
+ADVISE=0
+for arg in "$@"; do
+	case "$arg" in
+	--advise) ADVISE=1 ;;
+	*) echo "unknown argument: $arg" >&2; exit 2 ;;
+	esac
+done
+
+if [ "${IDP_PR_RISK_GATE:-1}" = "0" ]; then
+	echo "idp-pr-risk-gate: overridden by IDP_PR_RISK_GATE=0 -- a person owns this push"
+	exit 0
+fi
+
+set +e
+out="$(cd "$IDP" && bin/idp-pr-risk --json 2>/dev/null)"
+rc=$?
+set -e
+
+# No JSON at all means the scorer could not run. That is BLIND, not risky.
+if [ -z "$out" ]; then
+	echo "idp-pr-risk-gate: scorer produced nothing (rc=$rc); not refusing on a blind check" >&2
+	exit 0
+fi
+
+tier="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tier",""))' 2>/dev/null || echo "")"
+config_error="$(printf '%s' "$out" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("config_error") or "")' 2>/dev/null || echo "")"
+
+if [ -n "$config_error" ]; then
+	echo "idp-pr-risk-gate: cannot score -- $config_error (not refusing on a blind check)" >&2
+	exit 0
+fi
+
+# A REFUSAL REQUIRES AT LEAST ONE REAL PROBABILITY. When the decision layer is unreachable
+# every condition reports probability:null and the score is a statement about the LAYER, not
+# about the change -- refusing then would block every push on a machine whose layer is down,
+# which is an outage rather than enforcement (LAW 38). Count the conditions that actually
+# answered; zero of them means there is no evidence to refuse on.
+scored="$(printf '%s' "$out" | python3 -c 'import json,sys; print(sum(1 for c in json.load(sys.stdin).get("conditions",[]) if c.get("probability") is not None))' 2>/dev/null || echo 0)"
+
+if [ "$scored" = "0" ]; then
+	echo "idp-pr-risk-gate: no condition could be scored (layer unreachable); tier=$tier is advisory only" >&2
+	echo "idp-pr-risk-gate: push allowed -- a blind check is not evidence of risk" >&2
+	exit 0
+fi
+
+if [ "$tier" = "high" ] && [ "$ADVISE" = "0" ]; then
+	echo "REFUSED: idp-pr-risk scored this change HIGH before submission." >&2
+	(cd "$IDP" && bin/idp-pr-risk 2>&1 | sed 's/^/  /' >&2) || true
+	echo "  override deliberately:  IDP_PR_RISK_GATE=0 git push" >&2
+	exit 1
+fi
+
+echo "idp-pr-risk-gate: tier=$tier -- push allowed"
+exit 0
diff --git a/bin/idp-pr-scope-audit b/bin/idp-pr-scope-audit
