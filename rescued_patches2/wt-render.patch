-  template:
-    metadata:
-      labels: { app.kubernetes.io/name: balloon, app.kubernetes.io/part-of: idp }
-    spec:
-      priorityClassName: balloon
-      terminationGracePeriodSeconds: 0
-      automountServiceAccountToken: false
-      securityContext:
-        runAsNonRoot: true
-        runAsUser: 65535
-        runAsGroup: 65535
-        seccompProfile: { type: RuntimeDefault }
-      containers:
-        - name: pause
-          image: registry.k8s.io/pause:3.10
-          resources:
