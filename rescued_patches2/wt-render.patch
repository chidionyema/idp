diff --git a/bin/bind-audit b/bin/bind-audit
deleted file mode 100755
index 3e7d0bcc3..000000000
--- a/bin/bind-audit
+++ /dev/null
@@ -1,154 +0,0 @@
-#!/usr/bin/env bash
-# bind-audit -- list every process on this machine listening on a non-loopback
-# address and fail if one of them is not on the allow-list below.
-#
-# Why this exists. On 2026-08-24 the local Kubernetes cluster in
-# platform/k3d/estate.yaml was created without a `kubeAPI:` block. k3d's default
-# is to publish the API server on 0.0.0.0 at a port the kernel picks, so the
-# control plane of the cluster was reachable from every interface of the laptop
-# for 40 minutes: `docker port` read `6443/tcp -> 0.0.0.0:53145`. Nothing on the
-# machine looked for it. The config file was reviewed, merged and CI-green.
-#
-# The class of mistake is not "one missing YAML key". It is: a config file that
-# publishes a port is trusted to say where it binds, and nothing ever reads back
-# what actually ended up listening. This script reads back what actually ended
-# up listening.
-#
-# Founder ruling R20 (2026-08-24): the gateway is the only process that binds a
-# non-loopback address. Everything else is 127.0.0.1 or nothing.
-#
-# Tool considered and rejected: osquery, whose `listening_ports` table is the
-# mature answer to the enumeration half of this. It is not installed here, it
-# wants a resident daemon (osqueryd) on a machine the founder has twice this
-# week said is too slow to work on, and it supplies no policy -- the allow-list
-# below is the part that has to be written either way. If osquery arrives on
-# this estate for other reasons, replace the `lsof` line and keep the rest.
-#
-# Usage:
-#   bin/bind-audit             audit this machine; exit 1 on any unknown bind
-#   bin/bind-audit --selftest  prove the check both refuses and permits, then exit
-#   bin/bind-audit --table F   audit a recorded lsof table instead of this machine,
-#                              which is how CI runs it on a Linux runner that has
-#                              neither this laptop's processes nor its lsof
-#
-# Exit codes: 0 clean, 1 an unknown non-loopback listener, 2 the audit could not
-# see (LAW: a guard that loses its evidence reports BLIND, never a verdict).
-
-set -uo pipefail
-
-# ---------------------------------------------------------------------------
-# The allow-list. One row per thing that is allowed to face the network, with
-# the reason it is allowed. A listener that matches no row FAILS -- there is no
-# silent pass branch, because an allow-list with a silent miss case is how ten
-# criticals went undelivered for 18 hours on this estate.
-#
-# Fields: COMMAND-prefix | port | why
-# COMMAND-prefix is matched against lsof's COMMAND column, which macOS truncates
-# to nine characters, so "ControlCe" and not "ControlCenter".
-# ---------------------------------------------------------------------------
-ALLOW=(
-  "rapportd|49248|macOS Continuity/Handoff. Apple-owned, not ours to move; turning it off costs the founder Handoff between his own devices."
-  "ControlCe|7000|macOS AirPlay Receiver. Apple-owned. Disabled under System Settings > General > AirDrop & Handoff if it is ever unwanted."
-  "ControlCe|5000|macOS AirPlay Receiver, second port. Same owner as 7000."
-  "limactl|53|colima's lima hostagent DNS resolver for the Docker VM. Removing it breaks name resolution inside every container on this machine."
-  "ssh|8080|prospector-edge, the gateway. R20 names the gateway as the one process allowed a non-loopback address. Published through colima's ssh mux, which is why the COMMAND column says ssh and not docker."
-  "ssh|8443|prospector-edge TLS, same gateway as 8080."
-)
-
-selftest_table() {
-  # A synthetic lsof table: one row that must pass, one that must fail.
-  # Format matches the columns this script reads: COMMAND PID USER FD TYPE DEV SIZE NODE NAME
-  cat <<'EOF'
-rapportd    447 chidionyema    8u  IPv4 0x0 0t0 TCP *:49248 (LISTEN)
-k3d-proxy 99999 chidionyema    9u  IPv4 0x0 0t0 TCP *:53145 (LISTEN)
-EOF
-}
-
-real_table() {
-  lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null
-}
-
-# Reads an lsof table on stdin and prints one line per non-loopback listener,
-# prefixed OK or UNKNOWN. It prints only; the caller counts. The count is not
-# returned in a global because this function is always on the right of a pipe,
-# which puts it in a subshell where an assignment is lost -- that bug made the
-# first version of this script exit 1 on a clean machine.
-audit() {
-  local line cmd addr port hit row acmd aport why
-  while read -r line; do
-    # lsof's own header, blank lines, and the '#' comments the recorded fixture
-    # tables carry. Without the '#' arm a fixture's explanatory prose parsed as
-    # five listeners called "#", and the good fixture failed its own check.
-    case "$line" in COMMAND*|'#'*|"") continue ;; esac
-    cmd=$(printf '%s\n' "$line" | awk '{print $1}')
-    addr=$(printf '%s\n' "$line" | awk '{print $9}')
-    # Loopback is the compliant case and is not reported.
-    case "$addr" in
-      127.0.0.1:*|'[::1]:'*) continue ;;
-    esac
-    port=${addr##*:}
-    hit=""
-    for row in "${ALLOW[@]}"; do
-      acmd=${row%%|*}
-      aport=$(printf '%s\n' "$row" | cut -d'|' -f2)
-      why=${row#*|*|}
-      if [ "$cmd" = "$acmd" ] && [ "$port" = "$aport" ]; then hit="$why"; break; fi
-    done
-    if [ -n "$hit" ]; then
-      printf 'OK       %-12s %-22s %s\n' "$cmd" "$addr" "$hit"
-    else
-      printf 'UNKNOWN  %-12s %-22s not on the allow-list. Bind it to 127.0.0.1, or add a row to bin/bind-audit saying why it may face the network.\n' "$cmd" "$addr"
-    fi
-  done
-}
-
-# lsof prints one row per file descriptor, so a process listening on both IPv4
-# and IPv6 appears twice on the same port. Collapse to one row per finding.
-dedupe() { awk '!seen[$1 FS $2 FS $3]++'; }
-
-if [ "${1:-}" = "--selftest" ]; then
-  echo "== selftest: the check must REFUSE an unknown bind =="
-  out=$(selftest_table | audit | dedupe)
-  printf '%s\n' "$out"
-  n=$(printf '%s\n' "$out" | grep -c '^UNKNOWN')
-  if [ "$((n + 0))" -ne 1 ]; then
-    echo "SELFTEST FAILED: expected exactly 1 unknown, got $n"; exit 1
-  fi
-  echo "refused 1 of 2 rows, as required"
-  echo
-  echo "== selftest: the check must PERMIT a known bind =="
-  # A guard only ever seen refusing has never been shown to permit (LAW 38).
-  out=$(selftest_table | grep rapportd | audit | dedupe)
-  printf '%s\n' "$out"
-  n=$(printf '%s\n' "$out" | grep -c '^UNKNOWN')
-  if [ "$((n + 0))" -ne 0 ]; then
-    echo "SELFTEST FAILED: allow-listed row was refused"; exit 1
-  fi
-  echo "permitted 1 of 1 rows, as required"
-  echo
-  echo "SELFTEST PASS -- the check refuses and permits"
-  exit 0
-fi
-
-if [ "${1:-}" = "--table" ]; then
-  [ -f "${2:-}" ] || { echo "BLIND: no such table file: ${2:-}" >&2; exit 2; }
-  TABLE=$(cat "$2")
-else
-  TABLE=$(real_table)
-fi
-if [ -z "$TABLE" ]; then
-  echo "BLIND: lsof returned nothing. This is not a pass; the audit could not see." >&2
-  exit 2
-fi
-
-echo "== non-loopback listeners on ${2:-$(hostname -s)} =="
-OUT=$(printf '%s\n' "$TABLE" | audit | dedupe)
-printf '%s\n' "$OUT"
-SEEN=$(printf '%s\n' "$OUT" | grep -c '^\(OK\|UNKNOWN\)')
-BAD=$(printf '%s\n' "$OUT" | grep -c '^UNKNOWN')
-echo
-if [ "$((BAD + 0))" -gt 0 ]; then
-  echo "FAIL: $BAD of $SEEN non-loopback listeners are not allow-listed."
-  exit 1
-fi
-echo "PASS: all $SEEN non-loopback listeners are allow-listed."
diff --git a/bin/build-image b/bin/build-image
deleted file mode 100755
index 931b9a38d..000000000
--- a/bin/build-image
+++ /dev/null
@@ -1,32 +0,0 @@
-#!/usr/bin/env bash
-# build-image: the one way an estate image gets built (ruling R24).
-#
-#   bin/build-image --push -t ghcr.io/OWNER/NAME:TAG [-f Dockerfile] CONTEXT
-#   bin/build-image --load -t NAME:TAG            [-f Dockerfile] CONTEXT
-#
-# --push builds linux/amd64 AND linux/arm64 and pushes one manifest list. A
-# `--platform` naming anything else is refused: that is the single-arch push
-# R24 forbids. --load builds for the machine you are on only, because the docker
-# driver cannot load a manifest list into a local daemon (buildx limitation);
-# it never pushes, so nothing single-arch can leave the machine through here.
-set -euo pipefail
-PLATFORMS="linux/amd64,linux/arm64"
-mode=""; args=()
-while [ $# -gt 0 ]; do
-  case "$1" in
-    --push) mode=push ;;
-    --load) mode=load ;;
-    --platform|--platform=*)
-      v="${1#--platform=}"; [ "$v" = "$1" ] && { shift; v="$1"; }
-      if [ "$mode" != load ] && [ "$(tr ',' '\n' <<<"$v" | sort | paste -sd, -)" != "$PLATFORMS" ]; then
-        echo "build-image: refused: --platform $v is not $PLATFORMS (R24: one tag, two architectures)" >&2; exit 2
-      fi ;;
-    *) args+=("$1") ;;
-  esac; shift
-done
-[ -n "$mode" ] || { echo "build-image: choose --push (multi-arch to a registry) or --load (native only, local)" >&2; exit 2; }
-if [ "$mode" = push ]; then
-  exec docker buildx build --platform "$PLATFORMS" --push "${args[@]}"
-else
-  exec docker buildx build --load "${args[@]}"
-fi
diff --git a/bin/catalog-gen b/bin/catalog-gen
deleted file mode 100755
index 24bd14453..000000000
--- a/bin/catalog-gen
+++ /dev/null
@@ -1,711 +0,0 @@
-#!/usr/bin/env python3
-"""Estate inventory -> Backstage catalog entities.
-
-A thin adapter, deliberately. It reads the inventory LAW 39 already produces and
-writes catalog-info.yaml in the Backstage entity format -- an open, documented
-schema that Backstage, Port and Roadie all ingest and that anything else can parse
-as plain YAML. Nothing about the estate is stored HERE; this file only translates.
-
-That is the whole point. The catalogue is the asset, the portal is a renderer, and
-a renderer you can replace in one command is not a dependency. If Backstage is
-wrong in a year, this adapter changes its output format and the estate does not.
-"""
-import json, os, re, subprocess, sys
-
-# INV and OUT can be overridden so CI can run this against a fixture (bin/idp-ci).
-INV = os.environ.get("INV") or os.path.expanduser("~/.estate/state/inventory.json")
-OUT = os.environ.get("OUT") or os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "catalog")
-OWNER = "group:default/platform"
-SYSTEM = "system:default/estate"
-
-# ENVIRONMENT. Founder, 2026-08-24: "backstge call this nachine production, this is dev not
-# prod. ens dev, stage prod". Every Component this file emitted carried a literal
-# `lifecycle: production`, so the portal told anyone who opened it that a laptop was the
-# production estate. That is the worst class of catalog error: it is wrong, and it is wrong
-# in the direction that makes someone comfortable.
-#
-# Resolution order, and none of it is a literal in this file (LAW 46):
-#   1. $ESTATE_ENV
-#   2. the first line of $ESTATE_ENV_FILE, else ~/.estate/env
-#   3. "dev"
-# The fallback is "dev" on purpose. If the environment cannot be established, the safe lie is
-# the one that makes you careful, not the one that makes you relaxed.
-VALID_ENVS = ("dev", "stage", "prod")
-# Backstage's own vocabulary for spec.lifecycle is experimental | production | deprecated, so
-# the estate env is mapped onto it rather than invented. The precise env stays readable on the
-# entity as an annotation, which is what anything machine-driven should key off.
-LIFECYCLE_FOR = {"dev": "experimental", "stage": "experimental", "prod": "production"}
-
-
-def resolve_env() -> str:
-    e = (os.environ.get("ESTATE_ENV") or "").strip().lower()
-    if not e:
-        f = os.environ.get("ESTATE_ENV_FILE") or os.path.expanduser("~/.estate/env")
-        try:
-            e = open(f).readline().strip().lower()
-        except OSError:
-            e = ""
-    if not e:
-        return "dev"
-    if e not in VALID_ENVS:
-        sys.exit(f"catalog-gen: ESTATE_ENV={e!r} is not one of {VALID_ENVS}. "
-                 "Refusing to label the estate with an environment nobody defined.")
-    return e
-
-
-ENV = resolve_env()
-LIFECYCLE = LIFECYCLE_FOR[ENV]
-
-# Backstage names: ^[a-zA-Z0-9]([-_.a-zA-Z0-9]*[a-zA-Z0-9])?$, 63 chars max.
-def slug(s: str) -> str:
-    s = re.sub(r"[^a-zA-Z0-9._-]", "-", str(s)).strip("-._")
-    s = re.sub(r"-{2,}", "-", s) or "unnamed"
-    return s[:63].strip("-._")
-
-def github_slug(remote):
-    """owner/repo out of a git remote, or None when it is not github.com.
-
-    This exact shape is what Backstage's github.com/project-slug annotation
-    wants, and every GitHub-aware widget in the portal keys off it.
-    https://backstage.io/docs/features/software-catalog/well-known-annotations
-    """
-    if not remote or remote == "(none)":
-        return None
-    m = re.match(r"^(?:https://github\.com/|git@github\.com:)([^/]+/[^/]+?)(?:\.git)?/?$",
-                 str(remote))
-    return m.group(1) if m else None
-
-# kind of estate asset -> (Backstage kind, spec.type)
-MAP = {
-    "repo":          ("Component", "service"),
-    "scheduled_job": ("Resource",  "scheduled-job"),
-    "guard":         ("Resource",  "guard"),
-    "ledger":        ("Resource",  "ledger"),
-    "data":          ("Resource",  "data-store"),
-    "drill":         ("Resource",  "drill"),
-    "container":     ("Resource",  "container"),
-    "listener":      ("Resource",  "port"),
-}
-
-def y(v):
-    """YAML scalar, quoted when it could be misread.
-
-    Numbers are quoted too. Backstage's entity envelope requires every
-    annotation value to be a string, and an unquoted 12.4 or 3 parses as a
-    number, so the entity is rejected with "Malformed envelope, ... must be
-    string". Measured 2026-08-24: 141 of 194 entities lost this way, and the
-    catalogue still rendered, which is why it looked fine.
-    """
-    s = str(v)
-    if s == "" or re.search(r"[:#\-{}\[\]&*?|>%@`'\"\n]", s) or s.lower() in (
-            "true", "false", "null", "yes", "no", "on", "off") \
-            or re.fullmatch(r"[+-]?(\d[\d_]*)(\.\d*)?([eE][+-]?\d+)?", s) \
-            or re.fullmatch(r"0[xXoObB][0-9a-fA-F_]+", s):
-        return "'" + s.replace("'", "''") + "'"
-    return s
-
-def entity(kind, name, title, etype, annotations, tags, links=(), depends_on=(),
-           system=None, description=""):
-    # Founder, 2026-08-27: "cant have components that cannt self describe". An entity
-    # without a description is refused here, not tagged, so the catalogue cannot be
-    # written with one. Measured before this change: 349 of 362 entities had none.
-    if not str(description).strip():
-        sys.exit(f"catalog-gen: {kind} {name} has no description; refusing to publish an asset that cannot describe itself")
-    out = [
-        "apiVersion: backstage.io/v1alpha1",
-        f"kind: {kind}",
-        "metadata:",
-        f"  name: {y(name)}",
-        f"  title: {y(title)}",
-        f"  description: {y(str(description).strip())}",
-    ]
-    if annotations:
-        out.append("  annotations:")
-        # A key with a slash is already namespaced -- backstage.io/techdocs-ref is
-        # read by the TechDocs plugin and must not be rewritten. Everything else is
-        # ours and gets the estate/ prefix so it cannot collide with Backstage's.
-        for k, v in sorted(annotations.items()):
-            if v in (None, ""):
-                continue
-            out.append(f"    {k if '/' in k else 'estate/' + k}: {y(v)}")
-    if tags:
-        out.append("  tags:")
-        out += [f"    - {y(slug(t).lower())}" for t in tags if t]
-    if links:
-        out.append("  links:")
-        for t, u in links:
-            out += [f"    - title: {y(t)}", f"      url: {y(u)}"]
-    out += ["spec:", f"  type: {etype}", f"  owner: {OWNER}",
-            f"  system: {system or SYSTEM}"]
-    if kind == "Component":
-        out.append(f"  lifecycle: {LIFECYCLE}")
-    # sorted() and not the discovery order. Founder, 2026-08-24: "we need to take
