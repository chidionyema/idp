-def _coerce(spec: KeySpec, raw: Any) -> Any:
-    if raw is None:
-        return None
-    if spec.type == "int":
-        return int(raw)
-    if spec.type == "float":
-        return float(raw)
-    if spec.type == "bool":
-        if isinstance(raw, bool):
-            return raw
-        return str(raw).strip().lower() in ("1", "true", "yes", "on")
-    if spec.type == "list":
-        if isinstance(raw, list):
-            return raw
-        return [x.strip() for x in str(raw).split(",") if x.strip()]
-    if spec.type == "path":
-        return str(raw)
-    return str(raw)
