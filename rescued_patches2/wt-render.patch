-      enabled: false
-    nodeExporter:
-      enabled: false
-    kubeEtcd:
-      enabled: false
-    kubeScheduler:
-      enabled: false
-    kubeControllerManager:
-      enabled: false
-    kubeProxy:
-      enabled: false
-    defaultRules:
-      create: true
-      rules:
