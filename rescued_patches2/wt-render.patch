-                      - name: manager
-                        securityContext:
-                          readOnlyRootFilesystem: true
-                          seccompProfile: { type: RuntimeDefault }
-                      - name: kube-rbac-proxy
-                        securityContext:
-                          readOnlyRootFilesystem: true
-                          seccompProfile: { type: RuntimeDefault }
-                        livenessProbe:
-                          tcpSocket: { port: https }
-                          initialDelaySeconds: 10
-                          periodSeconds: 30
-                        readinessProbe:
-                          tcpSocket: { port: https }
-                          initialDelaySeconds: 5
-                          periodSeconds: 10
-  values:
