-# A Gherkin tag line is one or more @tags: `@cp12 @v2 @branch-budget-10pct`.
-_TAG_LINE_RE = re.compile(r"^[ \t]*(@\S+(?:[ \t]+@\S+)*)[ \t]*$", re.MULTILINE)
