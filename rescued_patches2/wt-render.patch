-        pytest.skip(f"{overlay.relative_to(ROOT)} does not render here: {out.stderr.strip()[:200]}")
-    return [d for d in yaml.safe_load_all(out.stdout) if d]
-
-
-def _pod_specs(docs):
-    for d in docs:
-        spec = (d.get("spec", {}).get("template", {}) or {}).get("spec")
