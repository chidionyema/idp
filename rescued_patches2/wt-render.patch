-def _load_toml_flat() -> dict[str, Any]:
-    if not ESTATE_TOML.exists():
-        return {}
-    try:
-        with open(ESTATE_TOML, "rb") as f:
-            data = tomllib.load(f)
-    except (OSError, tomllib.TOMLDecodeError):
-        return {}
-    return _flatten(data)
