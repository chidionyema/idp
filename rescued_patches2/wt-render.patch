-    auditor compares against the log they were handed."""
-    chain = receipts_mod.verify()
-    root_hash = main_root()
-    dag_result = dag.verify(root_hash)
-    ok = bool(chain.get("ok")) and bool(dag_result["verified"])
-    reason = None
-    if not chain.get("ok"):
