-    policies.kyverno.io/category: crew#539 scheduling immunity
-    policies.kyverno.io/severity: high
-    policies.kyverno.io/subject: Pod
-    policies.kyverno.io/description: >-
-      infrastructure-critical pods are kept off nodes labelled estate.io/capacity=preemptible (required);
-      every other pod in an idp namespace prefers them (weight 50). Nothing in the rule names a provider.
-spec:
-  background: false
-  rules:
-    - name: radio-room-stays-off-preemptible
-      match:
-        any:
-          - resources:
-              kinds: [Pod]
-      preconditions:
-        all:
-          - key: "{{ request.object.spec.priorityClassName || '' }}"
-            operator: Equals
-            value: infrastructure-critical
-      mutate:
-        patchStrategicMerge:
-          spec:
-            affinity:
-              nodeAffinity:
-                requiredDuringSchedulingIgnoredDuringExecution:
-                  nodeSelectorTerms:
-                    - matchExpressions:
-                        - key: estate.io/capacity
-                          operator: NotIn
-                          values: [preemptible]
-    - name: everything-else-prefers-preemptible
-      match:
-        any:
-          - resources:
-              kinds: [Pod]
-              namespaceSelector:
-                matchLabels: { app.kubernetes.io/part-of: idp }
-      preconditions:
-        all:
-          - key: "{{ request.object.spec.priorityClassName || '' }}"
-            operator: NotEquals
-            value: infrastructure-critical
-      mutate:
-        patchStrategicMerge:
-          spec:
-            affinity:
-              nodeAffinity:
-                preferredDuringSchedulingIgnoredDuringExecution:
-                  - weight: 50
-                    preference:
-                      matchExpressions:
-                        - key: estate.io/capacity
-                          operator: In
-                          values: [preemptible]
