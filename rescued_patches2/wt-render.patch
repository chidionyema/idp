-  namespace: healing
-spec:
-  interval: 1h
-  timeout: 10m
-  chart:
-    spec:
-      chart: k8sgpt-operator
-      version: 0.2.29
-      sourceRef:
-        kind: HelmRepository
-        name: k8sgpt
-  install:
-    remediation: { retries: 3 }
-    crds: CreateReplace
-  upgrade:
-    remediation: { retries: 3 }
-    crds: CreateReplace
