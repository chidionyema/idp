-metadata:
-  name: healthchecks-enrol
-  namespace: healthchecks
-data:
-  # Idempotent: one founder user, one project named "estate", its ping key = the vault entry.
-  enrol.py: |
-    import os
-    from django.contrib.auth.models import User
-    from hc.accounts.models import Profile, Project
-    email = os.environ["FOUNDER_EMAIL"]
-    user = User.objects.filter(email=email).first()
-    if user is None:
-        user = User.objects.create(username=email[:150], email=email)
-        Profile.objects.get_or_create(user=user)
-    project = Project.objects.filter(owner=user).order_by("id").first()
-    if project is None:
-        project = Project(owner=user)
-    project.name = "estate"
-    project.ping_key = os.environ["PING_KEY"]
-    project.save()
-    print("enrolled", project.name, "for", email)
----
-apiVersion: apps/v1
-kind: Deployment
-metadata:
-  name: healthchecks
-  namespace: healthchecks
-  labels: { app.kubernetes.io/name: healthchecks, app.kubernetes.io/part-of: idp }
-spec:
-  replicas: 2   # crew#539: one pod is one node event away from a 503
-  strategy:
-    type: RollingUpdate
-    rollingUpdate: { maxUnavailable: 0, maxSurge: 1 }
-  selector:
-    matchLabels: { app.kubernetes.io/name: healthchecks }
-  template:
-    metadata:
-      labels: { app.kubernetes.io/name: healthchecks, app.kubernetes.io/part-of: idp }
-    spec:
-      automountServiceAccountToken: false
-      # Two replicas on one node are one replica. DoNotSchedule, not ScheduleAnyway: a
-      # best-effort spread silently collapses onto one node exactly when the cluster is tight,
-      # which is the moment the spread was for.
-      topologySpreadConstraints:
-        - maxSkew: 1
-          topologyKey: kubernetes.io/hostname
-          whenUnsatisfiable: DoNotSchedule
-          labelSelector:
-            matchLabels: { app.kubernetes.io/name: healthchecks }
-      securityContext:
-        runAsNonRoot: true
