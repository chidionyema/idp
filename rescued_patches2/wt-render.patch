-    return {
-        "ok": ok,
-        "entries": int(chain.get("count", 0)),
-        "first_broken_counter": chain.get("first_broken_counter"),
-        "reason": reason,
-        "chain": chain,
-        "dag": dag_result,
-    }
-
-
-def audit_at(receipt_hash: str) -> dict[str, Any] | None:
-    """Who did what, when, under which policy, and which trust backend
