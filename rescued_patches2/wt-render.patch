-def strict_branch_policy() -> bool:
-    """True when this run is the gate for a strict branch (AGENTS.md
-    [merge].strict_branches, today `main`)."""
-    return os.environ.get(STRICT_ENV, "").strip().lower() in ("1", "true", "yes", "on")
