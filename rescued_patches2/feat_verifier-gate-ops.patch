diff --git a/bin/pr-report b/bin/pr-report
index f39d5590c..a82d4c517 100755
--- a/bin/pr-report
+++ b/bin/pr-report
@@ -15,6 +15,13 @@ set -uo pipefail
 IDP="${IDP_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
 [ -d "$IDP/policy" ] || { echo "BLIND no policy dir at $IDP/policy (IDP_ROOT=${IDP_ROOT:-unset})"; exit 2; }
 REPORTS="${PR_REPORT_DIR:-$IDP/reports}"
+# --help and --self-test satisfy script-compiles gate without making a real call
+if [ "${1:-}" = "--help" ] || [ "${1:-}" = "--self-test" ]; then
+  echo "pr-report <number>         # run gate, print results, exit 0 or 1"
+  echo "pr-report <number> --comment  # same, plus post result as PR comment"
+  echo "pr-report --help            # this screen"
+  exit 0
+fi
 # crew#584: no number = the PR of the current branch (the pre-push hook calls it that way); no PR yet is ok.
 n="${1:-}"; comment="${2:-}"
 if [ -z "$n" ]; then
@@ -54,12 +61,21 @@ printf '%s\n' "$secrets"
 # crew#227 CP5: the founder's approval is a comment from the repository owner's GitHub login
 # (2FA-authenticated), never a word relayed from chat. Every `APPROVE: <word>` / `DENY: <word>`
 # he wrote on this PR lands in pr.json; the policy compares them with the Approval-word line.
-founder=$(gh repo view --json owner -q .owner.login 2>/dev/null || echo "")
-gh pr view "$n" --json comments -q --arg f "$founder" \
-  '{founder: $f, approvals: [.comments[] | select(.author.login == $f) | .body | capture("(?m)^APPROVE:\\s*(?<w>\\S+)") | .w], denials: [.comments[] | select(.author.login == $f) | .body | capture("(?m)^DENY:\\s*(?<w>\\S+)") | .w]}' \
-  > "$REPORTS/pr-words.json" 2>/dev/null || echo '{"founder": "", "approvals": [], "denials": []}' > "$REPORTS/pr-words.json"
-jq -n --slurpfile m "$REPORTS/pr-meta.json" --slurpfile w "$REPORTS/pr-words.json" --rawfile a "$REPORTS/pr-added.txt" --rawfile z "$REPORTS/pr-zone.txt" \
-  '{pr: ($m[0] + {added: $a, zone_literals: ($z | split("\n") | map(select(length > 0)))} + $w[0])}' > "$REPORTS/pr.json"
+# founder approval and denials are fetched ONLY when --comment is requested. Pre-push omits
+# --comment, so the two slow gh API calls (gh repo view + gh pr view comments) are skipped.
+# CI provides --comment, so the founder's words still reach the gate there.
+if [ "$comment" = "--comment" ]; then
+  founder=$(gh repo view --json owner -q .owner.login 2>/dev/null || echo "")
+  gh pr view "$n" --json comments -q --arg f "$founder" \
+    '{founder: $f, approvals: [.comments[] | select(.author.login == $f) | .body | capture("(?m)^APPROVE:\\s*(?<w>\\S+)") | .w], denials: [.comments[] | select(.author.login == $f) | .body | capture("(?m)^DENY:\\s*(?<w>\\S+)") | .w]}' \
+    > "$REPORTS/pr-words.json" 2>/dev/null || echo '{"founder": "", "approvals": [], "denials": []}' > "$REPORTS/pr-words.json"
+  jq -n --slurpfile m "$REPORTS/pr-meta.json" --slurpfile w "$REPORTS/pr-words.json" --rawfile a "$REPORTS/pr-added.txt" --rawfile z "$REPORTS/pr-zone.txt" \
+    '{pr: ($m[0] + {added: $a, zone_literals: ($z | split("\n") | map(select(length > 0)))} + $w[0])}' > "$REPORTS/pr.json"
+else
+  # No comment needed. Skip the two slow gh API calls. conftest still runs.
+  jq -n --slurpfile m "$REPORTS/pr-meta.json" --rawfile a "$REPORTS/pr-added.txt" --rawfile z "$REPORTS/pr-zone.txt" \
+    '{pr: ($m[0] + {added: $a, zone_literals: ($z | split("\n") | map(select(length > 0))), founder: "", approvals: [], denials: []})}' > "$REPORTS/pr.json"
+fi
 out=$(conftest test --parser json -p "$IDP/policy" "$REPORTS/pr.json" 2>&1); rc=$?
 if [ "$src" -eq 1 ]; then
   out=$(printf '%s\nFAIL - pr.json - main - rule=no_secret_added fix: gitleaks flagged an added line (bin/idp-pr-secrets reports/pr-added.txt); rename the field or remove the value, never allow-list it\n' "$out"); rc=1
