+# crew#722: the canary seed on a GitHub runner died with OCI "keyId cannot be an empty string"
+# (oke-check run 33353772359) because a new secret's vault and key came only from `tofu output`,
+# and the runner has no tofu -- the empty string went straight to the API. Resolution order,
+# loud at the end: 1) ESTATE_VAULT_OCID / ESTATE_VAULT_KEY_OCID, 2) the metadata every ACTIVE
+# sibling secret in the compartment already carries (no state read; works wherever oci works),
+# 3) tofu state where a machine has it, 4) BLIND -- an empty id never reaches the API again.
+resolve_vault_and_key() { # needs $C; sets V and K, or exits 2 (BLIND)
+  local sv="" sk=""
+  V=${ESTATE_VAULT_OCID:-}; K=${ESTATE_VAULT_KEY_OCID:-}
+  if [ -z "$V" ] || [ -z "$K" ]; then
+    read -r sv sk < <(oci vault secret list --compartment-id "$C" --all --output json 2>/dev/null | python3 -c '
+import collections, json, sys
+rows = [r for r in (json.load(sys.stdin).get("data") or [])
+        if r.get("lifecycle-state") == "ACTIVE" and r.get("key-id") and r.get("vault-id")]
+if rows:
+    vault = collections.Counter(r["vault-id"] for r in rows).most_common(1)[0][0]
+    print(vault, next(r["key-id"] for r in rows if r["vault-id"] == vault))
+' 2>/dev/null) || true
+    V=${V:-$sv}; K=${K:-$sk}
+  fi
+  if { [ -z "$V" ] || [ -z "$K" ]; } && command -v tofu >/dev/null 2>&1; then
+    [ -n "$V" ] || V=$(cd "$MAIN/platform/oci" && tofu output -raw vault_id 2>/dev/null) || V=""
+    [ -n "$K" ] || K=$(cd "$MAIN/platform/oci" && tofu output -raw vault_key_id 2>/dev/null) || K=""
+  fi
+  [ -n "$V" ] && [ -n "$K" ] || blind "no vault key for a new secret: no ACTIVE sibling secret in the compartment carries one, tofu state is not readable here, and ESTATE_VAULT_OCID/ESTATE_VAULT_KEY_OCID are unset"
+}
