+# ACG (Asymmetric Compute Grid) image automation.
+# build-multiarch in chidionyema/acg pushes main-<run>-<sha> to ghcr.io/chidionyema/idp
+# (bare Dockerfile at repo root → image name = repo name = "idp" per bin/dockerfiles rule).
+# TODO: rename Dockerfile to acg.Dockerfile so future builds push to ghcr.io/chidionyema/acg.
+# The {"$imagepolicy"} marker in platform/acg/acg.yaml is what image-automation-controller rewrites.
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImageRepository
+metadata:
+  name: acg
+  namespace: flux-system
+spec:
+  image: ghcr.io/chidionyema/idp
+  interval: 5m
+  secretRef:
+    name: ghcr-pull
+---
+apiVersion: image.toolkit.fluxcd.io/v1
+kind: ImagePolicy
+metadata:
+  name: acg
+  namespace: flux-system
+spec:
+  imageRepositoryRef:
+    name: acg
+  filterTags:
+    pattern: '^main-(?P<run>[0-9]+)-[0-9a-f]{40}$'
+    extract: '$run'
+  policy:
+    numerical:
+      order: asc
