diff --git a/backstage/app-config.container.yaml b/backstage/app-config.container.yaml
new file mode 100644
index 000000000..85922daa1
--- /dev/null
+++ b/backstage/app-config.container.yaml
@@ -0,0 +1,96 @@
+# What changes when the catalogue runs in a container instead of `yarn start`.
+#
+# Layered on top of app-config.yaml, which stays the source for everything that
+# is the same in both. Backstage replaces arrays rather than merging them, so
+# every `catalog.locations` entry has to be restated here, not just the one that
+# moves.
+
+app:
+  # One origin. Under `yarn start` the app was a separate dev server on 3100 and
+  # the backend was on 7107, which is why this repo carried two ports, two
+  # health probes and a CORS rule between its own halves. The image runs
+  # @backstage/plugin-app-backend, so the backend serves the UI: one process,
+  # one port, one bind, and CORS between the app and its own API stops being a
+  # thing that can be misconfigured.
+  baseUrl: http://localhost:3100
+
+auth:
+  providers:
+    guest:
+      # The image sets NODE_ENV=production, and Backstage refuses the guest
+      # provider outside development unless this is set. Measured on the first
+      # container boot, 2026-08-24: `POST /api/auth/guest/refresh` returned 403
+      # and every catalog read returned 401, while `GET /` returned 200 -- a
+      # portal that renders, serves no data, and cannot be signed into. Under
+      # `yarn start` NODE_ENV was development and this never appeared, which is
+      # the kind of difference containerising exists to surface.
+      #
+      # The flag is named "dangerously" because it makes anyone who can reach
+      # the port a signed-in user. Here that is decided one layer out, not by
+      # this file: compose publishes 127.0.0.1 only, and ADR 0003 puts identity
+      # at the gateway, which is what enforces OIDC in front of the tailnet
+      # address. This container is behind that boundary, not acting as it. When
+      # Phase 2 moves the catalogue into k3s the gateway is still the boundary,
+      # and this stays until the OIDC provider is wired directly.
+      dangerouslyAllowOutsideDevelopment: true
+
+backend:
+  baseUrl: http://localhost:3100
+  listen:
+    port: 3100
+    # 0.0.0.0 INSIDE the container, 127.0.0.1 on the host. These are not in
+    # conflict and the distinction is the whole point of R20 (the gateway is the
+    # only process that binds a non-loopback address).
+    #
+    # The container's network namespace is not the host's. A process that binds
+    # 127.0.0.1 inside a container is reachable only from that container -- the
+    # published port cannot forward to it and `docker compose up` produces a
+    # service nothing can reach. What R20 governs is the HOST bind, and compose.yml
+    # publishes `127.0.0.1:3100:3100`, so `lsof` on this machine sees the loopback
+    # and nothing on the LAN can reach the catalogue.
+    #
+    # It also removes the [::1] versus 127.0.0.1 split that made `curl
+    # 127.0.0.1:3100` return 000 while a browser on the same machine got 200.
+    host: 0.0.0.0
+  csp:
+    connect-src: ["'self'", 'http:', 'https:']
+  database:
+    # Postgres, not the in-memory sqlite of app-config.yaml. Two reasons, and
+    # neither is preference. `:memory:` means every restart re-ingests the whole
+    # estate from files and serves an empty catalogue until it finishes --
+    # measured 2026-08-24, ingestion took 124 seconds after boot, during which
+    # the portal renders and looks correct with nothing in it. And Postgres is
+    # what the k8s deployment will use, so Phase 2 changes where the database
+    # runs, not which database it is.
+    client: pg
+    connection:
+      host: ${POSTGRES_HOST}
+      port: ${POSTGRES_PORT}
+      user: ${POSTGRES_USER}
+      password: ${POSTGRES_PASSWORD}
+      database: ${POSTGRES_DB}
+
+catalog:
+  locations:
+    # The estate. Generated on the host by bin/catalog-gen from the LAW 39
+    # inventory, and bind-mounted read-only at /estate. It is deliberately not
+    # baked into the image: the image is a build artefact that Phase 2 ships to
+    # k8s unchanged, and the inventory changes hourly. Baking it in would make
+    # every inventory refresh an image rebuild.
+    - type: file
+      target: /estate/catalog-info.yaml
+      rules:
+        - allow: [Component, Resource, Domain, System, Group]
+
+    # The only scaffolder template the portal offers.
+    - type: file
+      target: /app/templates/estate-component/template.yaml
+      rules:
+        - allow: [Template]
+
+    # user:default/guest. The guest auth provider resolves it through the
+    # catalog, so this is sign-in, not example data.
+    - type: file
+      target: /app/examples/org.yaml
+      rules:
+        - allow: [User, Group]
diff --git a/backstage/compose.yml b/backstage/compose.yml
new file mode 100644
index 000000000..add45e119
--- /dev/null
+++ b/backstage/compose.yml
@@ -0,0 +1,92 @@
+# The estate catalogue. Interim local deployment, 2026-08-24.
+#
+# THIS FILE IS TEMPORARY AND SAYS SO ON PURPOSE. Founder directive the same day:
+# the k3s cluster is being brought up in another lane and will be the final
+# home in about 48 hours. Until it is green, the catalogue still has to run, and
+# `nohup yarn start` was not an acceptable way to run it (see backstage/Dockerfile).
+#
+# The bridge is only legitimate because the artefact does not change. The image
+# built here is the image the Kustomize manifests will reference; Phase 2 points
+# ArgoCD at those manifests and this file is deleted. Nothing is ported, nothing
+# is rewritten, and removing the interim is one `git rm`. An interim that fails
+# that test is a second platform, which is the thing we are not building.
+#
+# WHAT IS PUBLISHED. 127.0.0.1:3100 and nothing else. Postgres has no `ports:`
+# key at all -- it is reachable on the compose network by the catalogue and by
+# nothing else on this machine (LAW 21, default closed). The catalogue is a map
+# of every asset the estate owns; it does not go on the LAN.
+#
+# SECRETS. backstage/.env, generated by bin/idp-up with `openssl rand` if it does
+# not exist, chmod 600, never printed and never committed -- idp/.gitignore has
+# covered `**/.env` since the llm/.env near-miss. There is no default password in
+# this file to forget to change.
+
+name: backstage
+
+services:
+  catalogue:
+    build:
+      context: .
+      dockerfile: Dockerfile
+    image: idp/backstage:local
+    # Build it, never try to fetch it. `idp/backstage` is not a registry
+    # namespace anyone owns, so the default policy sent compose to Docker Hub
+    # and `docker compose up` died on "pull access denied for idp/backstage"
+    # (measured 2026-08-24) even with the `build:` block right above. Phase 2
+    # publishes the image to a registry and this line goes with the file.
+    pull_policy: build
+    restart: unless-stopped
+    depends_on:
+      postgres:
+        condition: service_healthy
+    env_file: .env
+    environment:
+      POSTGRES_HOST: postgres
+      POSTGRES_PORT: '5432'
+      POSTGRES_USER: backstage
+      POSTGRES_DB: backstage
+    ports:
+      # host:container. The host half is pinned to the loopback address; the
+      # container half is the 0.0.0.0 bind explained in app-config.container.yaml.
+      - '127.0.0.1:3100:3100'
+    volumes:
+      # Read-only. The catalogue reads the estate inventory; it has no business
+      # writing to it, and :ro is the cheapest way to make that unrepresentable.
+      - ../catalog/catalog-info.yaml:/estate/catalog-info.yaml:ro
+    extra_hosts:
+      # colima, not Docker Desktop. Without this the container cannot resolve
+      # the host, which is how every other stack in this repo reaches the otel
+      # collector on 127.0.0.1:4318.
+      - 'host.docker.internal:host-gateway'
+    healthcheck:
+      # /healthcheck is served by the backend itself. `wget` because this is a
+      # slim image with no curl, and node -e would start a second Node runtime
+      # per check.
+      test: ['CMD-SHELL', 'wget -qO- http://127.0.0.1:3100/healthcheck || exit 1']
+      interval: 15s
+      timeout: 5s
+      start_period: 120s
+      retries: 5
+    mem_limit: 1g
+
+  postgres:
+    # Pinned to a minor, not `:latest` and not `:17`. An image tag that can move
+    # under a running service is the same class of defect as a floating version
+    # range in a manifest.
+    image: postgres:17.6-alpine
+    restart: unless-stopped
+    env_file: .env
+    environment:
+      POSTGRES_USER: backstage
+      POSTGRES_DB: backstage
+    volumes:
+      - pgdata:/var/lib/postgresql/data
+    healthcheck:
+      test: ['CMD-SHELL', 'pg_isready -U backstage -d backstage']
+      interval: 10s
+      timeout: 5s
+      retries: 10
+    mem_limit: 512m
+
+volumes:
+  pgdata:
