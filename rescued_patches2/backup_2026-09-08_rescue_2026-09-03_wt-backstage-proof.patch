 # "put this JSON array in a table", which is the one thing sqlite-utils exists
diff --git a/bin/idp-down b/bin/idp-down
index 4270789f2..e021a5e9a 100755
--- a/bin/idp-down
+++ b/bin/idp-down
@@ -1,5 +1,5 @@
 #!/usr/bin/env bash
-# Stop both renderers and unpublish both ports. The off switch LAW 32 requires,
+# Stop the catalogue and unpublish its ports. The off switch LAW 32 requires,
 # and the one thing the founder should be able to run without reading anything.
 #
 # It stops processes and removes tailscale listeners. It deletes nothing: the
@@ -30,10 +30,19 @@ kill_port() {
   stopped=$((stopped + 1))
 }
 
-echo "RENDERERS"
-kill_port 3100 "Backstage app"
-kill_port 7107 "Backstage backend"
-kill_port 8001 "Datasette"
+echo "CATALOGUE"
+# `down`, not `down -v`. The Postgres volume holds the ingested catalogue and
+# survives on purpose: bringing the portal back should not mean waiting two
+# minutes for it to re-read the estate. Deleting the data is `docker compose -f
+# backstage/compose.yml down -v`, which is a deliberate sentence to type.
+if [ -f "$IDP/backstage/compose.yml" ]; then
+  docker compose -f "$IDP/backstage/compose.yml" down 2>&1 | sed 's/^/  /'
+  stopped=$((stopped + 1))
+fi
+# The pre-container leftovers. Harmless when nothing holds these; kept because
+# a machine that ran the old bin/idp-up before this change still has them.
+kill_port 3100 "Backstage app (pre-container)"
+kill_port 7107 "Backstage backend (pre-container)"
 
 echo
 echo "PUBLISHED PORTS"
diff --git a/bin/idp-status b/bin/idp-status
index ca5f4ff4c..40554f602 100755
--- a/bin/idp-status
+++ b/bin/idp-status
@@ -14,12 +14,24 @@ probe() {
   case "$c" in ""|000) echo "down" ;; *) echo "$c" ;; esac
 }
 
-primary=$(probe http://127.0.0.1:3100)
-fallback=$(probe http://127.0.0.1:8001/-/versions.json)
+# `localhost`, deliberately, and the reason changed today -- keep the name.
+#
+# It was written because the `yarn start` dev server bound [::1] only, so a
+# v4 probe returned 000 and this command called the catalogue down while a
+# browser on the same machine was reading it. That server is gone: the
+# catalogue is a container now, and compose publishes 127.0.0.1:3100, which
+# is v4. So the original reason is dead and the opposite failure is the live
+# one -- a hardcoded [::1] probe would now be the broken half.
+#
+# `localhost` survives both because it resolves to both families and curl
+# tries each in turn. That is the point: this probe should not encode which
+# address family today's deployment happens to use, because it has already
+# been wrong in both directions inside one day. Measured 2026-08-24 against
+# the container: curl 127.0.0.1:3100/healthcheck -> 200, curl localhost -> 200.
+catalogue=$(probe http://localhost:3100)
 
-echo "RENDERER   LOCAL                  HTTP   PUBLISHED"
-printf "%-10s %-22s %-6s %s\n" "primary"  "127.0.0.1:3100 backstage" "$primary"  "http://$host:8443/"
