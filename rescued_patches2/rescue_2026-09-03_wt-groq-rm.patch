--- /dev/null
+++ b/llm/config.base.yaml
@@ -0,0 +1,88 @@
+# LiteLLM routing. This file replaces the chain-building half of prospector/operator.py.
+#
+# Standard: crew/docs/STANDARDS.md "LLM providers" (LiteLLM, adopted 2026-08-24).
+#
+# The names on the left are the ONLY thing prospector sees. They are deliberately the same
+# tier names config.yaml already uses (`operator:`, `noncritical_operator:`), so the
+# migration is a `providers:` block pointing at 127.0.0.1:4000 and not a rewrite.
+#
+# WHAT IS NOT HERE. `claude_cli` and `gemini_cli` are absent on purpose. They are local CLI
+# binaries spending a SUBSCRIPTION, not HTTP endpoints spending an API key, and a proxy
+# cannot drive them. They stay in prospector, they stay the trusted `moat_primary` tier,
+# and they stay the EUR 0 path (R14).
+
+model_list:
+  # @vendor-lanes@
+
+  # Local, free, and the only tier that survives every credential expiring at once.
+  - model_name: ollama
+    litellm_params:
+      model: ollama/qwen2.5-coder:7b
+      api_base: http://host.docker.internal:11434
+      timeout: 300
+      # Keep the weights resident. Ollama unloads a model 5 minutes after its last
+      # call, and reloading 7B cost the consensus vote its 30 s deadline every time
+      # (measured 2026-08-26: 30.8 s cold, 16.9 s warm, crew#284 CP2). The proxy is
+      # the only caller, so it owns the residency.
+      keep_alive: 24h
+  # routing.vision in AGENTS.md (sovereign model.vision, R8: an alias, never a
+  # provider model name). gemma3:4b is multimodal and is already pulled locally.
+  # Through Ollama's OpenAI-compatible endpoint, not the ollama/ provider: the
+  # litellm-database image ships without Pillow, and the ollama/ provider needs
+  # it to pass an image ("ollama image conversion failed", 2026-08-26). The
+  # OpenAI route sends the data URL through untouched.
+  - model_name: ollama-vision
+    litellm_params:
+      model: openai/gemma3:4b
+      api_base: http://host.docker.internal:11434/v1
+      api_key: ollama
+      timeout: 300
+  # Second local voter for the kernel's 3-model consensus (kini spec 4.2:
+  # "Ollama handles 2/3 quorum load"); a different family from `ollama`, so two
+  # local votes are not one model voting twice.
+  - model_name: ollama-llama
+    litellm_params:
+      model: ollama/llama3.2:latest
+      api_base: http://host.docker.internal:11434
+      timeout: 300
+      keep_alive: 24h
+
+router_settings:
+  # The chain prospector's `noncritical_operator:` already declares, expressed once here
+  # instead of in FallbackOperator. `minimax -> minimax_m27` is the documented failover;
+  # ollama is last because it is local and cannot run out of credit.
+  fallbacks:
+    # crew#506 CP1 (2026-08-27): the first hop is the other funded direct vendor. OpenRouter sat
+    # at ~2,400 tokens of credit and Google prepaid was empty, so the crew#284 order (OpenRouter
+    # first) walked every turn through 402/429 before reaching a lane that answers. Consensus
+    # still survives any one account dry. Every chain not headed by the cheap model ends in it
+    # (sovereign cp30). The OpenRouter lanes stay in model_list for crew#506 CP4 (free lanes,
+    # job aliases) but sit in no chain while the account is unfunded: a hop that always
+    # answers 402 is latency, not redundancy.
+    # @vendor-fallbacks@
+  num_retries: 2
+  # A tier that keeps failing is taken out of the chain rather than retried into the
+  # ground. This is the circuit breaker prospector/breaker.py hand-rolls.
+  allowed_fails: 3
+  cooldown_time: 60
+
+litellm_settings:
+  # Traces to the collector that already runs. No second store.
+  callbacks: ["otel"]
+  drop_params: true
+  # Never log the prompt or the completion body. Spans carry model, latency, tokens and
+  # cost — which is what an audit trail needs — and not the content of a customer's
+  # document (LAW 21).
+  turn_off_message_logging: true
+
+general_settings:
+  master_key: os.environ/LITELLM_MASTER_KEY
+  # A CEILING, not a budget. R14 is zero spend without founder sign-off; this number is
+  # the thing that refuses a runaway loop at 03:00, not permission to spend it. Raising it
+  # is a founder decision, and the proxy is where that decision is enforced rather than
+  # hoped for.
+  max_budget: 5.0
+  budget_duration: 1d
+  # Health checks cost a call per upstream. Off by default; `litellm-status` probes
+  # liveliness, which is free.
+  background_health_checks: false
