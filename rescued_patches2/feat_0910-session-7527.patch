-# Cyrus agent orchestration deployment (crew#834).
-apiVersion: apps/v1
-kind: Deployment
-metadata:
-  name: cyrus
-  namespace: cyrus
-  labels:
-    app.kubernetes.io/name: cyrus
-    app.kubernetes.io/part-of: idp
-spec:
-  replicas: 1
-  # RollingUpdate with maxSurge 0 and maxUnavailable 1 is Recreate for one replica: the old pod
-  # goes before the new one comes. Recreate itself cannot land here: the live object carries a
-  # rollingUpdate block server-side apply never drops (kustomize strips the `null` that would),
-  # and Recreate plus rollingUpdate is Invalid on every dry-run (2026-09-09, #2714 and #2719).
-  # This shape also satisfies require-availability's a-rollout-can-always-free-a-node.
-  strategy:
-    type: RollingUpdate
-    rollingUpdate: { maxSurge: 0, maxUnavailable: 1 }
-  selector:
-    matchLabels:
-      app.kubernetes.io/name: cyrus
-  template:
-    metadata:
-      labels:
-        app.kubernetes.io/name: cyrus
-        app.kubernetes.io/part-of: idp
-      # Reloader is explicitly off for this pod, never merely absent. The cyrus-github
-      # external-secret is a GithubAccessToken generator on a 10m refresh: ESO rewrites the
-      # mounted secret every ten minutes. Cyrus reads the token dynamically through GIT_ASKPASS
-      # (entrypoint.sh), so a rotation needs NO restart. With Reloader on (auto: true was drifted
-      # onto the deployment, 643 revisions / 11 ReplicaSets in 90 min), every mint rolled the pod
-      # and wiped the /repo and /worktrees emptyDir, killing any run longer than the gap. Disabling
-      # it lets a roll happen only on a real image/config change, not on every token mint.
-      annotations:
-        reloader.stakater.com/auto: "false"
-    spec:
-      serviceAccountName: cyrus
-      # crew#539: every platform workload names a class so the scheduler can rank it under pressure.
-      priorityClassName: platform-batch
-      automountServiceAccountToken: false
-      imagePullSecrets:
-        - name: ghcr-pull
-      securityContext:
-        runAsNonRoot: true
-        runAsUser: 10001
-        runAsGroup: 10001
-        fsGroup: 10001
-        seccompProfile:
-          type: RuntimeDefault
-      initContainers:
-        # GitService never clones. It runs `git worktree add` with cwd set to
-        # repositoryPath and reports `<path> is not a git repository` when that path is
-        # absent (GitService.js:476), while the repos volume is an emptyDir that starts
-        # empty on every restart. The three repositories in config.json therefore have to
-        # be cloned before cyrus starts. It runs here rather than in the main container
-        # because a clone that outlasts initialDelaySeconds would be killed by the
-        # liveness probe halfway through.
-        - name: clone-repos
-          image: ghcr.io/chidionyema/cyrus
-          args: ["clone"]
-          env:
-            - name: HOME
-              value: /var/lib/cyrus
-            - name: CYRUS_CONFIG_JSON
-              value: /etc/cyrus/config.json
-          volumeMounts:
-            - name: config
-              mountPath: /etc/cyrus
-              readOnly: true
-            - name: github-secret
-              mountPath: /secrets/github
-              readOnly: true
-            - name: repos
-              mountPath: /repo
-            - name: tmp
-              mountPath: /tmp
-            - name: home
-              mountPath: /var/lib/cyrus
-          resources:
-            requests: { cpu: 100m, memory: 256Mi }
-            limits: { cpu: "1", memory: 1Gi }
-          securityContext:
-            allowPrivilegeEscalation: false
-            readOnlyRootFilesystem: true
-            capabilities:
-              drop: ["ALL"]
-      containers:
-        - name: cyrus
-          image: ghcr.io/chidionyema/cyrus
-          env:
-            # Cyrus resolves its state directory from HOME. The container runs as uid 10001,
-            # which has no passwd entry, so node resolved HOME to "/" and the first thing
-            # cyrus does on boot -- ensureRequiredDirectories() -- tried to mkdir /.cyrus/repos
-            # on a read-only root and exited:
-            #   [ERROR] [CLI] Failed to create directory /.cyrus/repos: ENOENT
-            # A writable volume for this was already mounted; nothing pointed HOME at it.
-            # It is /var/lib/cyrus and not a path under the users' home tree because the
-            # hardcode gate refuses any /home/<name>/ literal (LAW 46) and is right to: a
-            # per-user home path in a manifest is the exact shape that broke 17 scripts.
-            - name: HOME
-              value: /var/lib/cyrus
-            # The four *_FILE variables that stood here are gone. Cyrus 0.2.71 reads none
-            # of them -- grepping the installed dist for GH_TOKEN_FILE,
-            # LINEAR_WEBHOOK_SECRET_FILE, LINEAR_API_TOKEN_FILE and
-            # GITHUB_WEBHOOK_SECRET_FILE returns zero files -- so the pod ran with no
-            # credentials while the manifest read as though it had four. GH_TOKEN_FILE also
-            # named /secrets/github/token, and the ExternalSecret writes the key
-            # CYRUS_GITHUB_TOKEN, so even a cyrus that read the variable would have found
-            # nothing there. entrypoint.sh reads the files and exports the names cyrus
-            # does read; the secrets never enter this manifest, which is what the edge
-            # policy is protecting.
-            #
-            # Claude runs on the Max subscription through `claude -p`. The estate holds no
-            # Anthropic API key, so none is set here and none is pulled from the vault.
-            #
-            # Self-hosted: GitHub and Linear deliver to this pod through the gateway, so
-            # cyrus verifies their signatures itself. Without this flag it registers every
-            # transport in "proxy mode", which expects a bearer token from cyrus's own
-            # hosted service and verifies no signature at all (EdgeWorker.js:566).
-            - name: CYRUS_HOST_EXTERNAL
-              value: "true"
-            # The flag above moved GitHub to signature mode. It does nothing for Linear:
-            # EdgeWorker.js:477 reads a different variable entirely, and without it the Linear
-            # transport verifies deliveries against CYRUS_API_KEY -- the bearer token of cyrus's
-            # own hosted service, which this estate does not use and does not have --
-            # instead of against the Linear HMAC.
-            #   const useDirectWebhooks =
-            #       process.env.LINEAR_DIRECT_WEBHOOKS?.toLowerCase() === "true";
-            #   const secret = useDirectWebhooks
-            #       ? process.env.LINEAR_WEBHOOK_SECRET || ""
-            #       : process.env.CYRUS_API_KEY || "";
-            # Measured on the running pod before this line existed: "Linear event transport
-            # registered (proxy mode)" beside "GitHub event transport registered (signature
-            # mode)". The signing secret is already mounted and already exported -- the pod
-            # logs no "not readable" line for any of the four -- so this is the only thing
-            # standing between a Linear delivery and its own signature check.
-            - name: LINEAR_DIRECT_WEBHOOKS
-              value: "true"
-            # Direct mode also turns on a source-IP allowlist (EdgeWorker.js:243, on by
-            # default whenever CYRUS_HOST_EXTERNAL is true). The address it grades is the one
-            # traefik forwards, and behind the OCI load balancer that is the node the
-            # connection landed on, not Linear. Measured 2026-09-08 22:58Z on the running pod,
-            # first delivery ever to reach it:
-            #   [WARN ] [LinearEventTransport] Rejected Linear webhook from unauthorized IP: 10.0.159.197
-            # The HMAC check over the body (LinearEventTransport.js, verifySignature) is the
-            # authentication; the allowlist can only ever refuse a delivery the signature
-            # would accept. Off, by the variable the code reads for it (EdgeWorker.js:244).
-            - name: WEBHOOK_IP_VALIDATION
-              value: "false"
-            # CYRUS_CONFIG_PATH was set here and is read by nothing: `cyrus` resolves its
-            # config from --cyrus-home, which defaults to ~/.cyrus (dist/src/app.js), and the
-            # ConfigMap was mounted at /config where nothing looked for it. The pod started,
-            # logged "Edge worker started successfully", and then said "No repositories
-            # configured" with three repositories sitting in the ConfigMap. The mount below
-            # puts config.json where cyrus actually reads it.
-            - name: CYRUS_SERVER_PORT
-              value: "3456"
-            # The two writable volumes this pod already carries, named explicitly rather than
-            # left to default under ~/.cyrus on an emptyDir.
-            - name: CYRUS_REPOS_DIR
-              value: /repo
-            - name: CYRUS_WORKTREES_DIR
-              value: /worktrees
-            # The public URL Linear and GitHub deliver to. The zone is substituted by Flux from
-            # estate-config; a literal hostname here would be a hardcoded machine name (LAW 46).
-            - name: CYRUS_BASE_URL
-              value: "https://cyrus.${ESTATE_ZONE}"
-            # The estate router's lane key for this consumer (bin/idp-estate-seed ROUTER_PLAN row
-            # `cyrus`) is a mounted file at /secrets/router (secrets-not-from-env-vars); the
-            # entrypoint exports it as LITELLM_API_KEY and OpenCode reads {env:LITELLM_API_KEY}
-            # in the provider block of configmap.yaml. No vendor key reaches this pod (LAW 34).
-            - name: LITELLM_BASE_URL
-              value: http://litellm.llm.svc:4000/v1
-          volumeMounts:
-            # The ConfigMap mounts at its own read-only path and the entrypoint links it
-            # into ~/.cyrus. The obvious shape -- a subPath mount straight at
-            # ~/.cyrus/config.json -- was tried and crash-looped the pod: kubelet creates
-            # the intermediate ~/.cyrus for a subPath mount owned by root and not
-            # group-writable, fsGroup does not reach it, and cyrus exited on its first
-            # action with
-            #   EACCES: permission denied, mkdir '/var/lib/cyrus/.cyrus/mcp-configs'
-            # because it creates repos, worktrees and mcp-configs beside that file.
-            - name: config
-              mountPath: /etc/cyrus
-              readOnly: true
-            - name: github-secret
-              mountPath: /secrets/github
-              readOnly: true
-            - name: router-secret
-              mountPath: /secrets/router
-              readOnly: true
-            - name: webhook-secret
-              mountPath: /secrets/webhook
-              readOnly: true
-            - name: linear-oauth
-              mountPath: /secrets/linear-oauth
-              readOnly: true
-            - name: worktrees
-              mountPath: /worktrees
-            - name: repos
-              mountPath: /repo
-            - name: tmp
-              mountPath: /tmp
-            - name: home
-              mountPath: /var/lib/cyrus
-            - name: npm-cache
-              mountPath: /.npm
-          # /status, not /health: cyrus serves no /health. EdgeWorker registers GET /status
-          # and GET /version and the shared server registers the webhook and OAuth routes;
-          # nothing answers /health, so both probes were 404 from the first second.
-          # A socket, not GET /status: while the entrypoint runs `cyrus self-auth` the same port
-          # is served by a one-route server that answers only /callback, and a 404 on /status
-          # there would have the kubelet kill the pod and the Service drop the endpoint the
-          # consent redirect has to reach. Both phases listen on 3456; the socket is the probe
-          # they share.
