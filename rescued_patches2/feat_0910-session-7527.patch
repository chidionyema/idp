index b126afec1..000000000
--- a/platform/cyrus/external-secret.yaml
+++ /dev/null
@@ -1,165 +0,0 @@
-# Cyrus credentials from the vault, mounted as files (edge policy refuses env vars).
-# 1. GitHub: installation token of the estate-agents App, narrowed to the repositories
-#    Cyrus is authorized to work on. The mint lives in the same pattern as infra-crew.
-apiVersion: external-secrets.io/v1
-kind: ExternalSecret
-metadata:
-  name: cyrus-github
-  namespace: cyrus
-spec:
-  refreshInterval: 10m
-  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
-  target:
-    name: cyrus-github
-    creationPolicy: Owner
-    template:
-      # Incident 2026-09-08, Deployment revision 654: this token is re-minted every
-      # refreshInterval, platform/edge/require-auto-reload.yaml stamps every workload
-      # reloader.stakater.com/auto=true at admission, so Reloader rolled Cyrus on every mint --
-      # one new ReplicaSet every ten minutes, a pod that never lived long enough to finish a
-      # job, and a public door that timed out. The mint is right; the roll is the defect.
-      # entrypoint.sh reads this file on every git and gh call, so a rotated token reaches the
-      # pod without a restart (the kubelet refreshes the mounted file in place). Same fix and
-      # same sentence as platform/backstage/overlays/oke/github-token.yaml (crew#307).
-      # tests/test_incident_cyrus654_a_minted_secret_is_never_a_silent_reload_trigger.py refuses
-      # a generator-minted Secret that says neither this nor idp.platform/reload-on-mint.
-      metadata:
-        annotations:
-          reloader.stakater.com/ignore: "true"
-  dataFrom:
-    - sourceRef:
-        generatorRef:
-          apiVersion: generators.external-secrets.io/v1alpha1
-          kind: GithubAccessToken
-          name: cyrus-github
-      rewrite:
-        - transform: { template: "CYRUS_GITHUB_TOKEN" }
----
-apiVersion: generators.external-secrets.io/v1alpha1
-kind: GithubAccessToken
-metadata:
-  name: cyrus-github
-  namespace: cyrus
-spec:
-  appID: ${githubAppIDQuoted}
-  installID: ${githubAppInstallationIDQuoted}
-  # Narrowed permissions: read/write contents, pull requests, issues.
-  # No workflows, no admin, no secrets.
-  permissions:
-    contents: write
-    pull_requests: write
-    issues: write
-  auth:
-    privateKey:
-      secretRef:
-        name: github-app-pem
-        key: key
----
-# The App's private key for the generator.
-apiVersion: external-secrets.io/v1
-kind: ExternalSecret
-metadata:
-  name: cyrus-github-app-pem
-  namespace: cyrus
-spec:
-  refreshInterval: 10m
-  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
-  target:
-    name: github-app-pem
-    creationPolicy: Owner
-    template:
-      engineVersion: v2
-      data:
-        key: "{{ .pem_b64 | b64dec }}"
-  dataFrom:
-    - extract: { key: github-app }
----
-
----
-# 2. Webhook signing secrets. Cyrus verifies the HMAC on every delivery before it acts on it:
-#    Linear signs with `linear-signature`, GitHub's App signs with `X-Hub-Signature-256`.
-#    These two secrets ARE the authentication on the /webhook route (httproute.yaml), so the
-#    route is refused by the front-door gate without them.
-apiVersion: external-secrets.io/v1
-kind: ExternalSecret
-metadata:
-  name: cyrus-webhook
-  namespace: cyrus
-spec:
-  refreshInterval: 10m
-#
-#    Both roads feed this one Secret, which is the point. The estate has two secret stores and a
-#    client gets the choice of either (decision 0017); a capability nothing uses is not a
-#    capability a buyer can see. Measured 2026-09-05: 89 ExternalSecrets on estate-vault, 6 on
-#    ghcr-pull, and ZERO on human-vault, while the human-vault ClusterSecretStore has been
-#    Valid/ReadWrite/True for three days. This row is the first user of the human road.
-#
-#    The split follows where the credential is born, not preference:
-#      - The GitHub App's webhook secret is minted by machines and lives on the machine road,
-#        estate-vault, with the rest of the App's material.
-#      - The Linear personal API key is born in a person's browser and can be born nowhere else.
-#        It rides the human road, Bitwarden, so the founder holds it in his own vault and the
-#        cluster reads it there. No copy of it is ever typed into an estate env file.
-#      - The Linear webhook signing secret is minted by code, through Linear's `webhookCreate`
-#        mutation using that key, so it is machine material the moment it exists and rides the
-#        machine road with everything else code mints. The human visits the console once and
-#        never returns (R52).
-  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
-  target: { name: cyrus-webhook, creationPolicy: Owner }
-  data:
-    - secretKey: linear-api-token
-      sourceRef:
-        storeRef: { kind: ClusterSecretStore, name: human-vault }
-      remoteRef: { key: cyrus-linear-api-token }
-    - secretKey: linear-webhook-secret
-      remoteRef: { key: cyrus-linear, property: webhook_secret }
-    - secretKey: github-webhook-secret
-      remoteRef: { key: github-app, property: webhook_secret }
-
-# Claude Code runs on the founder's Max subscription through `claude -p`. The estate holds no
-# Anthropic API key and no vault entry for one, so this namespace pulls none: the first version
-# of this file mirrored `claude-max-token` into ANTHROPIC_API_KEY, which is the exact thing the
-# standing ruling forbids.
-
----
-# 3. The Linear OAuth client. Measured 2026-09-05 (README, wall 8): Linear refuses a personal API
-#    key sent as `Authorization: Bearer`, which is the only shape @linear/sdk sends, so the key in
-#    row 2 can never open the Linear door. The door is an OAuth access token, and an OAuth token
-#    is minted by `cyrus self-auth` from a client id and client secret plus one consent click in
-#    the founder's browser. Linear publishes no create-API for an OAuth application, so the pair
-#    is born in a browser and rides the human road like the key, as two plain Secrets Manager
-#    entries, `cyrus-linear-client-id` and `cyrus-linear-client-secret`: one value each, typed
-#    on a phone, never JSON (founder 2026-09-09: every founder action comes with clear steps;
-#    a JSON value with two fields is a step that needs a back-and-forth). Its own Secret, and mounted `optional`:
-#    until the item exists the pod must still come up on the GitHub transport, and a single
-#    ExternalSecret with one missing property stops syncing every key it carries.
-apiVersion: external-secrets.io/v1
-kind: ExternalSecret
-metadata:
-  name: cyrus-linear-oauth
-  namespace: cyrus
-spec:
-  refreshInterval: 10m
-  secretStoreRef: { kind: ClusterSecretStore, name: human-vault }
-  target: { name: cyrus-linear-oauth, creationPolicy: Owner }
-  data:
-    - secretKey: client-id
-      remoteRef: { key: cyrus-linear-client-id }
-    - secretKey: client-secret
-      remoteRef: { key: cyrus-linear-client-secret }
----
-# The router lane key (founder 2026-09-09: every model through the one proxy). Minted by
-# bin/idp-estate-seed from the ROUTER_PLAN row `cyrus`, the road agent-workforce-router walks.
-# Rotation is ROUTER_ROTATE=cyrus on the seed, never a console (LAW 52).
-apiVersion: external-secrets.io/v1
-kind: ExternalSecret
-metadata:
-  name: cyrus-router
-  namespace: cyrus
-spec:
-  refreshInterval: 10m
-  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
-  target: { name: cyrus-router, creationPolicy: Owner }
-  data:
-    - secretKey: LITELLM_API_KEY
-      remoteRef: { key: cyrus, property: LITELLM_API_KEY }
