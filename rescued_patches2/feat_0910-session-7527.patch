+            rows = list(
+                con.execute(
+                    "select node_id, from_status, to_status, at from node_events "
+                    "where node_id like ? order by at desc, id desc limit 50",
+                    (f"%{args.history}%",),
+                )
+            )
+        else:
+            rows = list(
+                con.execute(
+                    "select node_id, from_status, to_status, at from node_events "
+                    "order by at desc, id desc limit 50",
+                )
+            )
