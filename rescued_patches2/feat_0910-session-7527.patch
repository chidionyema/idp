+            )
+        )
+        # Evidence, counted and named rather than listed: 240 warning events ranked above a
+        # crash-looping pod is how a dead list stops being read.
+        evidence = list(
+            con.execute(
+                "select type, count(*) from nodes where domain='runtime' "
+                "and type in ('event','diagnosis','alert','flux') group by 1 order by 2 desc"
+            )
+        )
+        # G6: a dead list with no freshness reads as current even when it is days old.
+        # Read the state BEFORE closing: the connection is the only thing that can answer.
+        try:
+            state, sentence = domain_state(con, "runtime")
+        except sqlite3.OperationalError:
+            state, sentence = "UNKNOWN", "no freshness table; this list may be stale"
+        con.close()
+        if not rows:
+            print(f"  [{state}] {sentence}")
+            print("nothing is dead")
+            return 0
+        print(f"  [{state}] {sentence}")
+        workloads = [r for r in rows if r[1] in ("deployment", "statefulset")]
+        pods = [r for r in rows if r[1] not in ("deployment", "statefulset")]
+        for node_id, _type, status, metadata in workloads + pods:
+            m = json.loads(metadata)
+            extra = ""
+            if m.get("replicas") is not None and m.get("ready") is not None:
+                extra += f" ready={m['ready']}/{m['replicas']}"
+            if m.get("restarts"):
+                extra += f" restarts={m['restarts']}"
+            if m.get("reasons"):
+                extra += f" reason={','.join(m['reasons'])}"
+            if m.get("age_s"):
+                extra += f" age={m['age_s'] // 60}m"
+            print(f"  {status:13s} {node_id}{extra}")
+        if evidence:
+            print(
+                "  also recorded, as evidence rather than failure: "
+                + ", ".join(f"{n} {t}" for t, n in evidence)
+            )
+        return 0
+
+    try:
+        con = sqlite3.connect(db)
+    except Exception as e:
+        print(f"estate-twin-runtime: cannot open {db}: {e}", file=sys.stderr)
+        return 2
+
+    counts = sweep(con)
+    if args.code:
+        counts.update(sweep_code(con))
+    if args.domains:
+        counts.update(sweep_domains(con))
+    total = sum(v for k, v in counts.items() if k != "source" and isinstance(v, int))
+    if total == 0:
+        con.close()
+        print(
+            "estate-twin-runtime: nothing was read; nothing was written",
+            file=sys.stderr,
+        )
+        return 1
+
+    src = counts.pop("source", "?")
+    detail = ", ".join(f"{k}={v}" for k, v in counts.items() if v)
+    print(f"ok      estate-twin-runtime  source={src} {detail} -> {db}")
+
+    if args.publish:
+        sent = publish(events_for(con))
+        print(f"        published {sent} event(s) to the estate bus")
+
+    con.close()
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
