-# The one path Linear and GitHub POST webhook deliveries to (crew#834 CP3).
-# No oauth2-proxy on purpose: the caller is Linear's and GitHub's delivery fleet, not a browser,
-# and neither can follow an OAuth redirect. The door is not open though -- Cyrus verifies the
-# HMAC signature on every delivery (Linear's `linear-signature`, GitHub's `X-Hub-Signature-256`)
-# against the secrets in external-secret.yaml, and drops anything that does not match. The route
-# therefore exposes exactly /webhook and nothing else.
-# sovereign/tests/bdd/test_gate_front_door_login.py holds the proof behind the annotation.
-apiVersion: gateway.networking.k8s.io/v1
-kind: HTTPRoute
-metadata:
-  name: cyrus
-  namespace: cyrus
-  labels:
-    app.kubernetes.io/part-of: idp
-    backstage.io/kubernetes-id: layer-cyrus
-  annotations:
-    idp.estate/auth: webhook-hmac-signature
-spec:
-  # The estate has one Gateway and it is prospector/prospector-edge; `edge/gateway`, which
-  # this route named when it merged, exists in no manifest in either repository, so the
-  # route attached to nothing and no webhook could ever have arrived. The https-cyrus
-  # listener and its certificate are the prospector repository's side of this.
-  parentRefs:
-    - name: prospector-edge
-      namespace: prospector
-      sectionName: https-cyrus
-  hostnames:
-    - "cyrus.${ESTATE_ZONE}"
-  rules:
-    - matches:
-        - path: { type: Exact, value: /linear-webhook }
-        - path: { type: Exact, value: /github-webhook }
-        # The deprecated alias, kept until the Linear webhook registration is moved to
-        # /linear-webhook, so the two changes are never in flight at the same moment.
-        - path: { type: Exact, value: /webhook }
-        # Linear redirects the founder's consent here with a one-time code; the code is worthless
-        # without the client secret the pod alone holds, so the route carries no extra check.
-        - path: { type: Exact, value: /callback }
-      backendRefs:
-        - name: cyrus
-          port: 3456
