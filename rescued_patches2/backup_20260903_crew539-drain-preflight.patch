+        "  *'-l app.kubernetes.io/name=alertmanager'*) printf '';;",
+        "  *'-l app.kubernetes.io/name=alertmanager'*) printf alertmanager-0;;\n"
+        "  *'amtool'*'silence add'*) echo sil-4242;;\n"
+        "  *) cat >/dev/null 2>&1; echo ok;;"))
