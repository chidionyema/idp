+# button: Estate Topology DAG
+# founder: Auto-regenerate infrastructure dependency graph on every commit to platform/oci
+
+name: Generate Estate Topology DAG
+
+on:
+  push:
+    paths:
+      - 'platform/oci/**'
+      - '.github/workflows/estate-dag-gen.yml'
+      - 'bin/estate-dag-gen'
+  workflow_dispatch:
+
+jobs:
+  generate-dag:
+    runs-on: ubuntu-latest
+    name: Generate and commit DAG artifacts
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@11bd71901afe3a98589b0a1d744f7275f4f2aff0  # v4.2.2
+
+      - uses: actions/setup-python@f677139edd7d37f56ec0f7cb50f3d8b6e29c0f69  # v5.0.0
+        with:
+          python-version: '3.12'
+
+      - name: Generate DAG artifacts
+        run: bin/estate-dag-gen
+
+      - name: Commit DAG if changed
+        run: |
+          cd "$GITHUB_WORKSPACE"
+          if git diff --quiet docs/diagrams/; then
+            echo "No changes to DAG"
+            exit 0
+          fi
+
+          git config user.name "estate-bot"
+          git config user.email "estate-bot@estate.local"
+          git add docs/diagrams/estate-dag.dot docs/diagrams/estate-topology.json
+          git commit -m "chore(estate-dag): regenerate topology DAG from infrastructure state
+
+Generated by: estate-dag-gen
+Files: estate-dag.dot (Terraform resources), estate-topology.json (runtime stub)
+Phase: 1 (deploy-time), 2 (runtime - pending Cilium integration)"
+          git push origin "${GITHUB_REF#refs/heads/}"
