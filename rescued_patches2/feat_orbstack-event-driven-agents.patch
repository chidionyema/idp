--- /dev/null
+++ b/platform/idp_agent/k8s/gateway-deployment.yaml
@@ -0,0 +1,84 @@
+# The webhook receiver. See docs/specs/orbstack-event-driven-agents.md.
+# GITHUB_WEBHOOK_SECRET arrives as a file, same reasoning as GH_TOKEN in
+# engine-deployment.yaml (Kyverno's secrets-not-from-env-vars).
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: idp-gateway
+  namespace: idp-agent
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: idp-gateway
+    creationPolicy: Owner
+    template:
+      engineVersion: v2
+      data:
+        GITHUB_WEBHOOK_SECRET: "{{ .GITHUB_WEBHOOK_SECRET }}"
+  dataFrom:
+    - extract: { key: idp-gateway }
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: idp-gateway
+  namespace: idp-agent
+  labels: { app.kubernetes.io/name: idp-gateway }
+spec:
+  replicas: 2
+  selector:
+    matchLabels: { app.kubernetes.io/name: idp-gateway }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: idp-gateway }
+    spec:
+      serviceAccountName: idp-gateway
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 65532
+        fsGroup: 65532
+        seccompProfile: { type: RuntimeDefault }
+      containers:
+        - name: gateway
+          image: ghcr.io/chidionyema/idp-gateway
+          command: [python3, platform/idp_agent/gateway.py]
