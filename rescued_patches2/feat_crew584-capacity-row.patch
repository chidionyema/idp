--- a/platform/edge/dev-loop-policy.yaml
+++ /dev/null
@@ -1,48 +0,0 @@
-# Playbook Phase 3 (crew#584 CP-E, founder 2026-08-29): a developer's laptop may join the cluster
-# through mirrord, and the fence is admission, not a doc. A mirrord agent pod (image
-# ghcr.io/metalbear-co/mirrord) is admitted only into a namespace labelled
-# idp.platform/dev-loop=allowed. Production namespaces never carry the label, so a laptop cannot
-# attach to a production pod at all; the staging cluster's hermes-agent namespace carries it
-# (platform/hermes-agent is the same manifest on both clusters; the label is a cluster overlay).
-# Proof it refuses and passes: tests/test_incident_crew584_mirrord_agent_only_where_allowed.py.
-apiVersion: kyverno.io/v1
-kind: ClusterPolicy
-metadata:
-  name: dev-loop-mirrord-fence
-  annotations:
-    policies.kyverno.io/title: mirrord agents only where the namespace allows the dev loop
-    policies.kyverno.io/category: crew#584 dev loop
-    policies.kyverno.io/severity: critical
-    policies.kyverno.io/subject: Pod
-    policies.kyverno.io/description: >-
-      A mirrord agent may attach to a pod only in a namespace labelled
-      idp.platform/dev-loop=allowed. Production carries no such label.
-spec:
-  background: true
-  rules:
-    - name: mirrord-agent-needs-dev-loop-namespace
-      match:
-        any:
-          - resources:
-              kinds: [Pod]
-              operations: [CREATE, UPDATE]   # idp#694: a DELETE is never judged; the fence is for admission only
-      exclude:
-        any:
-          - resources:
-              namespaceSelector:
-                matchLabels:
-                  idp.platform/dev-loop: allowed
-      validate:
-        failureAction: Enforce
-        message: >-
-          crew#584: a mirrord agent (ghcr.io/metalbear-co/mirrord) is admitted only in a namespace
-          labelled idp.platform/dev-loop=allowed; this one is not. Point your kubeconfig at the
-          staging cluster.
-        foreach:
-          - list: request.object.spec.containers
-            deny:
-              conditions:
-                any:
-                  - key: "{{ element.image }}"
-                    operator: Equals
-                    value: "ghcr.io/metalbear-co/mirrord*"
