@@ -0,0 +1,52 @@
+# Every external account the estate depends on, who owns the login, and who else can get in.
+# crew#227 CP7. Founder, 2026-08-25: "this whole estate is tied to a single gmail account, needs
+# to be configurable and we need to think of how to do this seamlessly." This file is the
+# inventory that makes the exposure a number; bin/owner-account-gate reads it. A provider row is
+# "single owner" when second_owner is none or its recovery route lands in the same mailbox.
+# Identities are labels, never addresses: founder-gmail is the founder's personal Google account.
+providers:
+  - name: github            # org chidionyema; every repo, CI, OIDC issuer for OCI
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: source, CI, packages, the OIDC identity the cluster check runs under
+  - name: oracle-cloud      # tenancy owner; OKE cluster, object storage state bucket
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: the platform's compute, state and identity domain
+  - name: cloudflare        # DNS for mumchimp.com, R2
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: DNS, TLS edge, R2 object storage
+  - name: google            # the mailbox itself
+    login: founder-gmail
+    second_owner: none
+    recovery: phone
+    used_for: recovery route for every other row
+  - name: stripe
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: payments (prospector)
+  - name: anthropic
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: agent sessions
+  - name: openrouter
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: fallback model routing (no-anthropic drill)
+  - name: apple-id          # the Mac, FileVault recovery, keychain sync
+    login: founder-gmail
+    second_owner: none
+    recovery: founder-gmail
+    used_for: the only workstation
+  - name: telegram
+    login: phone
+    second_owner: none
+    recovery: phone
+    used_for: operator alerts
