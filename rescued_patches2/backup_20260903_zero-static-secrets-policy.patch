+++ b/bin/owner-account-gate
@@ -0,0 +1,30 @@
+#!/usr/bin/env python3
+"""owner-account-gate [FILE]: how many external providers the estate depends on have a single
+owner. Reads docs/reference/owner-accounts.yaml (crew#227 CP7). A provider is single-owner when
+second_owner is none, or when its recovery route is the same identity as its login (losing the
+mailbox loses the account and its recovery at once). Last line:
+  ok|FAIL|BLIND    owner-account-gate: N of M providers have a single owner; target 0
+exit 0 when N is 0, 1 when N > 0, 2 when the file cannot be read (BLIND, LAW 45 residual)."""
+import sys, os
+try:
+    import yaml
+except ImportError:
+    print("BLIND    owner-account-gate: pyyaml missing"); sys.exit(2)
+path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "docs/reference/owner-accounts.yaml")
+try:
+    rows = yaml.safe_load(open(path))["providers"]
+except Exception as e:  # noqa: BLE001
+    print(f"BLIND    owner-account-gate: cannot read {path}: {e}"); sys.exit(2)
+single = []
+for r in rows:
+    for k in ("name", "login", "second_owner", "recovery"):
+        if k not in r:
+            print(f"BLIND    owner-account-gate: {r.get('name','?')} lacks {k}"); sys.exit(2)
+    why = []
+    if str(r["second_owner"]).lower() == "none": why.append("no second owner")
+    if r["recovery"] == r["login"]: why.append(f"recovery is the login ({r['login']})")
+    if why:
+        single.append(r["name"]); print(f"single   {r['name']:<14} {'; '.join(why)}")
+n, m = len(single), len(rows)
+print(f"{'ok' if n == 0 else 'FAIL':<8} owner-account-gate: {n} of {m} providers have a single owner; target 0 (crew#227 CP7)")
+sys.exit(0 if n == 0 else 1)
