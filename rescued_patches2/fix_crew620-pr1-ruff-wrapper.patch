diff --git a/.githooks/pre-commit b/.githooks/pre-commit
new file mode 100644
index 000000000..de116cf88
--- /dev/null
+++ b/.githooks/pre-commit
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+# crew#620: refuse a commit that violates the estate Python standard on staged .py
+# files only. Without this hook a "ruff format" failure surfaces in CI as a 1950-
+# pattern embarrassment instead of at the keyboard. Install once via
+# bin/idp-install-hooks; idempotent on every commit.
+#
+# The rule set lives in pyproject.toml. Both this hook and .github/workflows/ruff-
+# required.yml call bin/idp-ruff / bin/idp-ruff-format — they are the same binary, so
+# "the local hook and CI disagree" cannot happen. One source of truth.
+set -euo pipefail
+
+staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
+[ -z "$staged" ] && exit 0
+
+# Use the wrapper, not python3 -m ruff, so the rule set is read from pyproject.toml
+# in both places. The wrapper refuses if ruff or pyproject.toml is missing.
+hook_dir="$(cd "$(dirname "$0")" && pwd)"
+repo_root="$(git rev-parse --show-toplevel)"
+
+echo "  checking: $(echo "$staged" | tr '\n' ' ')"
+printf '%s\n' "$staged" | xargs "$hook_dir/../bin/idp-ruff-format" --check --quiet || {
+  echo "pre-commit: ruff format failed" >&2
+  echo "  fix: bin/idp-ruff-format $staged" >&2
+  exit 1
+}
+
+printf '%s\n' "$staged" | xargs "$hook_dir/../bin/idp-ruff" || {
+  echo "pre-commit: ruff check failed" >&2
+  echo "  fix: bin/idp-ruff --fix $staged" >&2
+  exit 1
+}
diff --git a/.github/workflows/ruff-required.yml b/.github/workflows/ruff-required.yml
new file mode 100644
index 000000000..2d1997066
--- /dev/null
+++ b/.github/workflows/ruff-required.yml
@@ -0,0 +1,50 @@
+# crew#620: the server-side enforcement of the Python standard. The local hook
+# (bin/idp-ruff + .githooks/pre-commit) gives fast feedback; this workflow is the
+# boundary that refuses a merge if any .py file added by this PR violates pyproject.toml
+# [tool.ruff]. Required status check on main makes the refusal server-side, not
+# developer-memory. Without this PR the loop is advisory; with it, the next regression
+# is refused automatically.
+name: ruff-required
+on:
+  pull_request:
+    branches: [main]
+  merge_group:
+jobs:
+  ruff-required:
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: read
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with: { fetch-depth: 0 }
+      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
+        with: { python-version: "3.12" }
+      - run: pip install -q ruff==0.15.18
+      - name: ruff format --check on the PR diff
+        env:
+          BASE: ${{ github.event.pull_request.base.sha }}
+        run: |
+          set -euo pipefail
+          # origin/main...HEAD lists every path the PR touched, including deletions; filter
+          # to files that still exist on disk so xargs doesn't pass stale paths to ruff.
+          files=$(git diff --name-only "${BASE}...HEAD" -- '*.py' | grep -v '\.git/' | while read -r f; do [ -f "$f" ] && echo "$f"; done || true)
+          if [ -z "$files" ]; then
+            echo "no python files changed in this PR"
+            exit 0
+          fi
+          echo "checking:"
+          printf '  %s\n' "$files"
+          echo "$files" | xargs bin/idp-ruff-format --check
+      - name: ruff check on the PR diff
+        env:
+          BASE: ${{ github.event.pull_request.base.sha }}
+        run: |
+          set -euo pipefail
+          files=$(git diff --name-only "${BASE}...HEAD" -- '*.py' | grep -v '\.git/' | while read -r f; do [ -f "$f" ] && echo "$f"; done || true)
+          [ -z "$files" ] && exit 0
+          echo "$files" | xargs bin/idp-ruff
+      - name: emit ratchet count
+        run: |
+          echo "ratchet: files off-standard on HEAD"
+          python3 -m ruff check --statistics . 2>/dev/null | tail -n 20 || true
diff --git a/bin/idp-ruff b/bin/idp-ruff
new file mode 100755
index 000000000..bce04467e
--- /dev/null
+++ b/bin/idp-ruff
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+# crew#620: the single source of truth for the Python standard. Reads pyproject.toml
+# [tool.ruff] and runs ruff check. Hook and CI both call this; if the rule set changes
+# it changes in one place. Fail-closed: missing python3, missing config, missing ruff
+# are refused, not silenced.
+set -euo pipefail
+
+[ -f pyproject.toml ] || { echo "FAIL: pyproject.toml missing"; exit 1; }
+command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 missing"; exit 1; }
+python3 -m ruff --version >/dev/null 2>&1 || { echo "FAIL: ruff not installed (pip install ruff)"; exit 1; }
+
+exec python3 -m ruff check --config pyproject.toml "$@"
diff --git a/bin/idp-ruff-format b/bin/idp-ruff-format
new file mode 100755
index 000000000..3ee68ed58
--- /dev/null
+++ b/bin/idp-ruff-format
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# crew#620: formatter counterpart to bin/idp-ruff. Same fail-closed contract; reads
+# pyproject.toml [tool.ruff]. Use for `format`, `format --check`, and `format --diff`.
+set -euo pipefail
+
+[ -f pyproject.toml ] || { echo "FAIL: pyproject.toml missing"; exit 1; }
+command -v python3 >/dev/null 2>&1 || { echo "FAIL: python3 missing"; exit 1; }
+python3 -m ruff --version >/dev/null 2>&1 || { echo "FAIL: ruff not installed (pip install ruff)"; exit 1; }
+
+exec python3 -m ruff format --config pyproject.toml "$@"
diff --git a/bin/idp-ruff-ratchet b/bin/idp-ruff-ratchet
new file mode 100755
index 000000000..1fcfb7af9
--- /dev/null
+++ b/bin/idp-ruff-ratchet
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# crew#620: visible ratchet. Prints the count of files that would still fail the
+# Python standard on HEAD. The number should monotonically shrink; if it grows the
+# pre-commit hook let one through and the operator sees it here, not in two weeks.
+# Exit code is 0 — this is a signal, not a gate. The gate is bin/idp-ruff.
+set -euo pipefail
+
+count=$(python3 -m ruff check --config pyproject.toml --statistics . 2>/dev/null \
+  | grep -cE '^[A-Z][0-9]+' || true)
+echo "ratchet: $count file(s) off-standard on HEAD"
