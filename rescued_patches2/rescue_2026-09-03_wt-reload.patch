diff --git a/platform/edge/require-auto-reload.yaml b/platform/edge/require-auto-reload.yaml
new file mode 100644
index 000000000..524c5fe0b
--- /dev/null
+++ b/platform/edge/require-auto-reload.yaml
@@ -0,0 +1,89 @@
+# crew#684, and the founder blueprint of 2026-08-30 that closed it
+# (~/.claude/docs/founder/2026-08-30T2326Z-1-delete-the-enumerated-list-secret-reloader-stakater-4ca529a0.md):
+# "an assertion a developer can green by editing the expectation is not a control ... controls have
+# to sit outside the blast radius of the thing they guard". The invariant "this workload restarts
+# when the Secret it reads changes" lived three times as a hand-kept list of Secret names in an
+# annotation, `secret.reloader.stakater.com/reload: "a,b,c"`, checked by a test in the same repo,
+# same pull request and same reviewer as the change that broke it. It went stale silently every
+# time (idp#955 hermes-agent, crew#684 healthchecks and the portal): a list that omits the Secret
+# added yesterday reads exactly like a list that is complete.
+#
+# Rung 0 of the ladder in that blueprint is delete the surface: `reloader.stakater.com/auto: "true"`
+# has no names in it, so it cannot be stale. Reloader discovers every Secret and ConfigMap the pod
+# actually references -- envFrom, secretKeyRef/configMapKeyRef, volumes and projected sources
+# (stakater/Reloader chart-v2.2.16, internal/pkg/handler/upgrade.go getVolumeMountName).
+#
+# Rung 1 is this file: make the wrong state inexpressible. Rule 1 injects the annotation at
+# admission on every workload the estate runs, so a new service cannot forget it and a service
+# repo no longer decides. Rule 2 refuses the enumerated list outright, so the deleted surface
+# cannot come back. Opting out is possible and deliberate: an author who writes
+# `reloader.stakater.com/auto: "false"` in git keeps it (the `+()` anchor only adds a key that is
+# absent) and the estate guard, tests/test_every_workload_restarts_on_a_config_change.py, then
+# demands `idp.platform/reload-opt-out-reason` beside it. Silence is not an opt-out; a sentence is.
+#
+# Scope note (this is the crew#684 failure, not a detail): an annotation in a namespace Reloader
+# does not watch does nothing at all. platform/reloader/reloader.yaml sets `watchGlobally: true`
+# so the estate has one watcher over every namespace, with `autoReloadAll: false` so only the
+# workloads this policy annotates are rolled. The system namespaces below are excluded for the
+# same reason they are excluded in require-catalogue-entity.yaml: Kyverno, Flux and the secret
+# store are the machinery that would have to be running to apply the mutation to themselves.
+#
+# Proof the control works, run before this file was merged and quoted in the pull request body:
+# `kyverno apply platform/edge/require-auto-reload.yaml --resource <the pre-fix manifests>` refuses
+# all three of the workloads that carried a hand-kept list, and passes them once the list is gone.
+apiVersion: kyverno.io/v1
+kind: ClusterPolicy
+metadata:
+  name: require-auto-reload
+  annotations:
+    policies.kyverno.io/title: Every workload restarts when its config changes
+    policies.kyverno.io/category: founder blueprint 2026-08-30, configuration
+    policies.kyverno.io/severity: high
+    policies.kyverno.io/subject: Deployment, StatefulSet, DaemonSet
+    policies.kyverno.io/description: >-
+      Every workload is annotated reloader.stakater.com/auto="true" at admission, so a rotated
+      Secret or an edited ConfigMap reaches the running pod without anyone maintaining a list of
+      names. A hand-kept secret.reloader.stakater.com/reload list is refused: it is the surface
+      that went stale in idp#955 and crew#684.
+spec:
+  background: true
+  rules:
+    - name: workload-reloads-on-its-own-config
+      match:
+        any:
+          - resources:
+              kinds: [Deployment, StatefulSet, DaemonSet]
+              operations: [CREATE, UPDATE]
+      exclude:
+        any:
+          - resources:
+              namespaces: [kube-system, flux-system, kyverno, cert-manager, spire-mgmt, metrics-server, reloader, keda, external-secrets]
+      mutate:
+        patchStrategicMerge:
+          metadata:
+            annotations:
+              # `+()` is Kyverno's add-if-absent anchor: a workload that already carries the key --
+              # "true" or an explicit "false" with a reason -- is left exactly as its author wrote it.
+              +(reloader.stakater.com/auto): "true"
+    - name: no-hand-kept-reload-list
+      match:
+        any:
+          - resources:
+              kinds: [Deployment, StatefulSet, DaemonSet]
+              operations: [CREATE, UPDATE]
+              annotations:
+                secret.reloader.stakater.com/reload: "*"
+          - resources:
+              kinds: [Deployment, StatefulSet, DaemonSet]
+              operations: [CREATE, UPDATE]
+              annotations:
+                configmap.reloader.stakater.com/reload: "*"
+      validate:
+        failureAction: Enforce
+        message: >-
+          {{ request.object.kind }} {{ request.object.metadata.name }} names the Secrets or
+          ConfigMaps it reloads on by hand. That list is the bug surface: it went stale silently in
+          idp#955 and crew#684, because a list missing yesterday's Secret looks like a complete
+          one. Delete it. reloader.stakater.com/auto="true" is injected by this policy and
+          discovers every Secret and ConfigMap the pod references.
+        deny: {}
