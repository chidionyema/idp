diff --git a/platform/infra-crew/cronjob.yaml b/platform/infra-crew/cronjob.yaml
new file mode 100644
index 000000000..2e97afe25
--- /dev/null
+++ b/platform/infra-crew/cronjob.yaml
@@ -0,0 +1,193 @@
+# The crew's identity in the cluster is a name and nothing else. No Role, no RoleBinding, no
+# ClusterRoleBinding anywhere names this account, and the token is never mounted: the crew has
+# no cluster hand by construction (founder 2026-09-01: no agent touches the cluster again).
+# tests/test_crew729_infra_crew_workload.py refuses any binding that names it.
+apiVersion: v1
+kind: ServiceAccount
+metadata:
+  name: infra-crew
+  namespace: infra-crew
+automountServiceAccountToken: false
+---
+# crewAI memory and knowledge stores (INFRA_CREW_STORAGE_DIR). A volume that outlives the pod,
+# the same reason platform/hermes-agent keeps HERMES_HOME on one (idp#365): a founder ruling
+# ingested once is recalled on every run, never lost with a finished Job.
+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: infra-crew-data
+  namespace: infra-crew
+spec:
+  accessModes: [ReadWriteOnce]
+  resources:
+    requests:
+      storage: 5Gi
+---
+# Every 15 minutes: with no argument the crew takes the oldest open `lane:infra` ticket on the
+# board that has no plan comment yet, and exits `idle` when there is none. One run at a time
+# (Forbid), so two Jobs never claim one ticket. The image is the newest main of
+# chidionyema/infra-crew (its image workflow publishes every main commit as :main); the tag
+# moves on the vendor side, so the pull policy is Always.
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: infra-crew
+  namespace: infra-crew
+  labels:
+    # The catalogue Component the Backstage Kubernetes plugin reads this workload under
+    # (backstage/platform/catalog-info.yaml, generated by bin/catalog-platform).
+    backstage.io/kubernetes-id: infra-crew
+spec:
+  schedule: "*/15 * * * *"
+  concurrencyPolicy: Forbid
+  successfulJobsHistoryLimit: 1
+  failedJobsHistoryLimit: 2
+  startingDeadlineSeconds: 600
+  jobTemplate:
+    spec:
+      # crew#396: finished Jobs are removed an hour later so their pods never haunt the receipt
+      ttlSecondsAfterFinished: 3600
+      backoffLimit: 0                # a failed run is a red Job to read, never a silent retry
+      activeDeadlineSeconds: 3000    # one ticket, under the 15-minute period times three; then the Job is killed and read
+      template:
+        metadata:
+          labels:
+            backstage.io/kubernetes-id: infra-crew
+        spec:
+          # crew#584 CP-I: a batch job is seated by preempting one balloon pod, so it asks for at
+          # most what one balloon pod holds (platform/scheduling/balloon.yaml) and is never
+          # standing capacity.
+          priorityClassName: platform-batch
+          serviceAccountName: infra-crew
+          automountServiceAccountToken: false
+          restartPolicy: Never
+          imagePullSecrets:
+            - name: ghcr-pull
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            runAsGroup: 10001
+            fsGroup: 10001
+            seccompProfile: { type: RuntimeDefault }
+          initContainers:
+            # The law files the crew's knowledge base is built from, fetched from the repositories
+            # that version them into INFRA_CREW_LAWS_DIR, producing exactly the four names the
+            # crew's knowledge.py expects. All four repositories are public, so no token is
+            # needed; the owner comes from estate-config (LAW 46), never a literal here.
+            # Same pinned image as every estate CronJob (platform/state/cluster-state.yaml): it
+            # ships python3, so no git and no second image.
+            - name: laws
+              image: ghcr.io/oracle/oci-cli:20260826
+              command: ["/bin/sh", "-c"]
+              args:
+                - |
+                  set -eu
+                  exec python3 - <<'PY'
+                  import os, sys, urllib.request
+                  owner = os.environ["LAWS_OWNER"]
+                  out = os.environ["INFRA_CREW_LAWS_DIR"]
+                  sources = {
+                      "AGENTS.md": ("claude-guards", "laws/AGENTS.md"),
+                      "AGENTS-FULL.md": ("claude-guards", "laws/AGENTS-FULL.md"),
+                      "STANDARDS.md": ("crew", "docs/STANDARDS.md"),
+                      "definition-of-done.md": ("idp", "docs/reference/policy/definition-of-done.md"),
+                  }
+                  failed = 0
+                  for name, (repo, path) in sources.items():
+                      url = f"https://raw.githubusercontent.com/{owner}/{repo}/main/{path}"
+                      try:
+                          with urllib.request.urlopen(url, timeout=30) as r:
+                              body = r.read()
+                      except Exception as why:  # noqa: BLE001 - every miss is named, none is hidden
+                          print(f"FAIL laws {name} <- {url}: {why}")
+                          failed += 1
+                          continue
+                      with open(os.path.join(out, name), "wb") as fh:
+                          fh.write(body)
+                      print(f"ok   laws {name} {len(body)} bytes <- {repo}/{path}")
+                  sys.exit(1 if failed else 0)
+                  PY
+              env:
+                - { name: LAWS_OWNER, value: "${ESTATE_GITHUB_OWNER}" }
+                - { name: INFRA_CREW_LAWS_DIR, value: /laws }
+                - { name: HOME, value: /tmp }
+              volumeMounts:
+                - { name: laws, mountPath: /laws }
+                - { name: tmp, mountPath: /tmp }
+              resources:
+                requests: { cpu: 50m, memory: 64Mi }
+                limits: { cpu: 250m, memory: 128Mi }
+              securityContext:
+                runAsNonRoot: true
+                runAsUser: 10001
+                runAsGroup: 10001
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: ["ALL"] }
+                seccompProfile: { type: RuntimeDefault }
+          containers:
+            - name: crew
+              image: ghcr.io/chidionyema/infra-crew:main
+              imagePullPolicy: Always
+              # No argument: queue mode (the next unplanned `lane:infra` ticket, or `idle`).
+              args: []
+              env:
+                # The one model router (LAW 34); bare aliases, rows in platform/llm/config.yaml (the crew
+                # adds the openai/ provider prefix itself, so a prefixed value reaches the router as a
+                # name it does not have). The verifier runs on a different alias from the builder so it
+                # never grades with the builder's brain. `embed` is the router's embedding row.
+                - { name: LITELLM_BASE_URL, value: "http://litellm.llm.svc:4000" }
+                - { name: INFRA_CREW_MODEL, value: "minimax" }
+                - { name: INFRA_CREW_VERIFIER_MODEL, value: "deepseek" }
+                - { name: INFRA_CREW_EMBED_MODEL, value: "embed" }
+                # The estate collector (LAW 50): one value in clusters/oke/estate-config.yaml.
+                - { name: OTEL_EXPORTER_OTLP_ENDPOINT, value: "${OTLP_ENDPOINT}" }
+                - { name: OTEL_SERVICE_NAME, value: infra-crew }
+                - { name: LANGFUSE_BASE_URL, value: "http://langfuse-web.observability.svc:3000" }
+                - { name: INFRA_CREW_REPO_OWNER, value: "${ESTATE_GITHUB_OWNER}" }
+                - { name: INFRA_CREW_BOARD_REPO, value: crew }
+                - { name: INFRA_CREW_PLATFORM_REPO, value: idp }
+                - { name: INFRA_CREW_QUEUE_LABEL, value: "lane:infra" }
+                - { name: INFRA_CREW_LAWS_DIR, value: /laws }
+                - { name: INFRA_CREW_STORAGE_DIR, value: /var/lib/infra-crew }
+                - { name: CREWAI_STORAGE_DIR, value: /var/lib/infra-crew }
+                - { name: CREWAI_DISABLE_TELEMETRY, value: "true" }
+                - { name: HOME, value: /tmp }
+                # Secrets are files (kyverno secrets-not-from-env-vars); the crew reads NAME_FILE.
+                - { name: INFRA_CREW_GITHUB_TOKEN_FILE, value: /run/secrets/infra-crew/INFRA_CREW_GITHUB_TOKEN }
+                - { name: LITELLM_API_KEY_FILE, value: /run/secrets/infra-crew/LITELLM_API_KEY }
+                - { name: LANGFUSE_PUBLIC_KEY_FILE, value: /run/secrets/infra-crew/LANGFUSE_PUBLIC_KEY }
+                - { name: LANGFUSE_SECRET_KEY_FILE, value: /run/secrets/infra-crew/LANGFUSE_SECRET_KEY }
+              volumeMounts:
+                - { name: laws, mountPath: /laws, readOnly: true }
+                - { name: data, mountPath: /var/lib/infra-crew }
+                - { name: secrets, mountPath: /run/secrets/infra-crew, readOnly: true }
+                - { name: tmp, mountPath: /tmp }
+              resources:
+                requests: { cpu: 250m, memory: 768Mi }
+                limits: { cpu: "1", memory: 1536Mi }
+              securityContext:
+                runAsNonRoot: true
+                runAsUser: 10001
+                runAsGroup: 10001
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: ["ALL"] }
+                seccompProfile: { type: RuntimeDefault }
+          volumes:
+            - name: laws
+              emptyDir: {}
+            - name: tmp
+              emptyDir: {}
+            - name: data
+              persistentVolumeClaim:
+                claimName: infra-crew-data
+            # One directory, three Secrets: the App token the generator mints, the Langfuse pair
+            # and the router key. A projected volume, the same shape as hermes-agent's env dir.
+            - name: secrets
+              projected:
+                defaultMode: 0440
+                sources:
+                  - secret: { name: infra-crew-github }
+                  - secret: { name: infra-crew-langfuse }
+                  - secret: { name: infra-crew-router }
diff --git a/platform/infra-crew/external-secret.yaml b/platform/infra-crew/external-secret.yaml
new file mode 100644
index 000000000..97aad57d7
--- /dev/null
+++ b/platform/infra-crew/external-secret.yaml
@@ -0,0 +1,113 @@
+# Every credential the crew holds, minted or mirrored in-cluster by external-secrets and mounted
+# as files (platform/edge/kyverno-secrets-policy.yaml refuses a secret in an env var). The crew
+# reads each one through its NAME_FILE convention (src/infra_crew/estate.py in
+# chidionyema/infra-crew) and refuses to boot when any is missing: a crew that cannot be seen
+# does not run (LAW 50).
+#
+# 1. GitHub: an installation token of the estate-agents App, narrowed to the infra-crew lane of
+#    platform/github-app/lanes.json (idp#1098): read metadata, write contents, pull requests and
+#    issues, read actions and checks. No workflows, no admin, no secrets -- a buyer's engineer
+#    reads the whole hand in six lines. The mint lives where the consumer lives, exactly as
+#    platform/hermes-agent/gateway.yaml does it: no workflow, no script, no vault hop, and a
+#    10-minute refresh keeps every token inside its 60-minute life.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: infra-crew-github
+  namespace: infra-crew
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: infra-crew-github, creationPolicy: Owner }
+  dataFrom:
+    - sourceRef:
+        generatorRef:
+          apiVersion: generators.external-secrets.io/v1alpha1
+          kind: GithubAccessToken
+          name: infra-crew-github
+      rewrite:
+        - transform: { template: "INFRA_CREW_GITHUB_TOKEN" }
+---
+# ${githubAppIDQuoted} / ${githubAppInstallationIDQuoted} are substituted by Flux from the
+# flux-system/github-app Secret (platform/alerts-github/github-app.yaml; this row's substituteFrom
+# in clusters/oke/platform.yaml). The Quoted variants carry their own double quotes because
+# kustomize build re-emits every scalar plain and a bare numeral types spec.appID as an int
+# (idp#1027). Account identifiers are never typed in git (LAW 46).
+apiVersion: generators.external-secrets.io/v1alpha1
+kind: GithubAccessToken
+metadata:
+  name: infra-crew-github
+  namespace: infra-crew
+spec:
+  appID: ${githubAppIDQuoted}
+  installID: ${githubAppInstallationIDQuoted}
+  # Mirrors the infra-crew lane in platform/github-app/lanes.json. Suspending the App's
+  # installation (docs/runbooks/infra-crew.md, kill switch 1) makes this mint fail and every
+  # run after it refuse to boot.
+  permissions:
+    metadata: read
+    contents: write
+    pull_requests: write
+    issues: write
+    actions: read
+    checks: read
+  auth:
+    privateKey:
+      secretRef:
+        name: github-app-pem
+        key: key
+---
+# The App's private key for the generator, from the one vault entry `github-app` that
+# bin/idp-github-app writes; same template as platform/hermes-agent/gateway.yaml.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: infra-crew-github-app-pem
+  namespace: infra-crew
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target:
+    name: github-app-pem
+    creationPolicy: Owner
+    template:
+      engineVersion: v2
+      data:
+        key: "{{ .pem_b64 | b64dec }}"
+  dataFrom:
+    - extract: { key: github-app }
+---
+# 2. Langfuse: the project keys Langfuse was initialised with (platform/observability, vault
+#    entries langfuse-init-public-key / langfuse-init-secret-key), the same pair LiteLLM and
+#    Hermes trace with (platform/llm/external-secret.yaml, platform/hermes-agent/langfuse-key.yaml).
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: infra-crew-langfuse
+  namespace: infra-crew
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: infra-crew-langfuse, creationPolicy: Owner }
+  data:
+    - secretKey: LANGFUSE_PUBLIC_KEY
+      remoteRef: { key: langfuse-init-public-key }
+    - secretKey: LANGFUSE_SECRET_KEY
+      remoteRef: { key: langfuse-init-secret-key }
+---
+# 3. The model router key. The vault holds no per-consumer virtual key yet, so this reads the
+#    router's own key from the `litellm-upstream` entry (platform/llm/external-secret.yaml).
+#    A virtual key minted for this crew alone, with its own budget, replaces this line the day
+#    the router's key management is on (docs/runbooks/infra-crew.md, "Not done").
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: infra-crew-router
+  namespace: infra-crew
+spec:
+  refreshInterval: 10m
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: infra-crew-router, creationPolicy: Owner }
+  data:
+    - secretKey: LITELLM_API_KEY
+      remoteRef: { key: litellm-upstream, property: LITELLM_MASTER_KEY }
