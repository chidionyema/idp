diff --git a/platform/otto-golden/registration-reconciler.yaml b/platform/otto-golden/registration-reconciler.yaml
new file mode 100644
index 000000000..ed0630223
--- /dev/null
+++ b/platform/otto-golden/registration-reconciler.yaml
@@ -0,0 +1,231 @@
+# Registration reconciler (build order step 6, docs/specs/otto-platform-v1/EVENT-GATEWAY-TENANCY.md
+# receipt layer 3, "vendor registration"): every 5 minutes a Job-owned pod asks Telegram's own
+# API -- getWebhookInfo -- whether the webhook this estate registered is still the one Telegram
+# holds, and how many updates are queued behind it. That is the vendor's own truth, not a guess
+# from our side of the wire (crew#516 comment 5451926212: "so we solve the problem once" applies
+# here too -- the same otto-staging-telegram vault entry telegram-secret.yaml already mounts is
+# read again here, never a second vault entry, never a literal token in this file or in a log
+# line).
+#
+# The metric names and shape are locked by the spec: channel_registration_ok (0/1) and
+# channel_pending_updates (a count), each carrying tenant_id and channel attributes so a second
+# tenant or a second channel plugin adds a row, never a second file. Pushed as OTLP metrics to
+# the SAME collector every other workload in this estate already sends to (LAW 50, LAW 43 -- no
+# second metrics sink): platform/otto-golden/deployment.yaml's OTEL_EXPORTER_OTLP_ENDPOINT, over
+# HTTP with the JSON encoding the collector's otlphttp receiver already accepts (no SDK, no pip
+# install, no extra image -- python's standard library is enough for one POST, the same
+# stdlib-only shape as platform/observability/telemetry-coverage.yaml's collect.py).
+#
+# Today there is one binding (tenant: estate, channel: telegram; docs/specs/otto-platform-v1/
+# EVENT-GATEWAY-TENANCY.md, "binding row #1"), so OTTO_TENANT_ID/OTTO_CHANNEL are the two
+# plain-config env vars below rather than a database read -- the channel_binding store itself is
+# a separate, in-flight piece of work (hermes-v2 branch otto/event-gateway). When that store
+# ships, this job's one call becomes a loop over its rows; the metric shape does not change.
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: otto-registration-reconciler-script
+  namespace: otto-golden
+data:
+  # Line 1 is the graded receipt line (ok/FAIL/BLIND, never printed with the token); the process
+  # exit code mirrors it so `kubectl get jobs` (or a Job-watching drill) can tell an outage from
+  # a healthy poll without reading the log at all.
+  check.py: |
+    import json
+    import os
+    import ssl
+    import sys
+    import time
+    import urllib.error
+    import urllib.request
+
+    TENANT = os.environ.get("OTTO_TENANT_ID", "estate")
+    CHANNEL = os.environ.get("OTTO_CHANNEL", "telegram")
+    TOKEN_FILE = os.environ.get(
+        "OTTO_TELEGRAM_TOKEN_FILE",
+        "/run/secrets/otto-staging-telegram/OTTO_TELEGRAM_BOT_TOKEN",
+    )
+    OTLP_ENDPOINT = os.environ.get(
+        "OTEL_EXPORTER_OTLP_ENDPOINT", "http://signoz-otel-collector.observability.svc:4318"
+    )
+    TIMEOUT_S = 15
+
+    def get_webhook_info(token):
+        # The vendor's own truth (spec receipt layer 3): never our side's guess at whether the
+        # webhook is still registered. The token rides the URL path exactly as Telegram's Bot
+        # API requires; it is never logged, never included in an exception message we print.
+        url = f"https://api.telegram.org/bot{token}/getWebhookInfo"
+        req = urllib.request.Request(url, headers={"Accept": "application/json"})
+        ctx = ssl.create_default_context()
+        with urllib.request.urlopen(req, context=ctx, timeout=TIMEOUT_S) as r:
+            return json.load(r)
+
+    def _gauge(name, value, at_nano):
+        return {
+            "name": name,
+            "gauge": {
+                "dataPoints": [
+                    {
+                        "asDouble": float(value),
+                        "timeUnixNano": str(at_nano),
+                        "attributes": [
+                            {"key": "tenant_id", "value": {"stringValue": TENANT}},
+                            {"key": "channel", "value": {"stringValue": CHANNEL}},
+                        ],
+                    }
+                ]
+            },
+        }
+
+    def push_metrics(registration_ok, pending_updates, at_nano):
+        body = {
+            "resourceMetrics": [
+                {
+                    "resource": {
+                        "attributes": [
+                            {
+                                "key": "service.name",
+                                "value": {"stringValue": "otto-registration-reconciler"},
+                            }
+                        ]
+                    },
+                    "scopeMetrics": [
+                        {
+                            "scope": {"name": "otto.registration.reconciler"},
+                            "metrics": [
+                                _gauge("channel_registration_ok", registration_ok, at_nano),
+                                _gauge("channel_pending_updates", pending_updates, at_nano),
+                            ],
+                        }
+                    ],
+                }
+            ]
+        }
+        data = json.dumps(body).encode()
+        req = urllib.request.Request(
+            OTLP_ENDPOINT.rstrip("/") + "/v1/metrics",
+            data=data,
+            headers={"Content-Type": "application/json"},
+            method="POST",
+        )
+        with urllib.request.urlopen(req, timeout=TIMEOUT_S) as r:
+            r.read()
+
+    def main():
+        at_nano = time.time_ns()
+        registration_ok = 0
+        pending_updates = -1  # -1: could not be determined this run, never confused with a real 0
+        try:
+            with open(TOKEN_FILE) as f:
+                token = f.read().strip()
+            info = get_webhook_info(token)
+            result = info.get("result", {}) if info.get("ok") else {}
+            registered = bool(result.get("url"))
+            registration_ok = 1 if info.get("ok") and registered else 0
+            pending_updates = result.get("pending_update_count", -1)
+            verdict = "ok" if registration_ok else "FAIL"
+            print(
+                f"{verdict} registration-reconciler tenant={TENANT} channel={CHANNEL} "
+                f"registration_ok={registration_ok} pending_updates={pending_updates}"
+            )
+        except OSError as e:
+            print(
+                f"FAIL registration-reconciler tenant={TENANT} channel={CHANNEL} "
+                f"could not read the token file: {type(e).__name__}"
+            )
+        except (urllib.error.URLError, TimeoutError, ValueError) as e:
+            print(
+                f"FAIL registration-reconciler tenant={TENANT} channel={CHANNEL} "
+                f"getWebhookInfo unreachable: {type(e).__name__}"
+            )
+        try:
+            push_metrics(registration_ok, pending_updates, at_nano)
+        except Exception as e:  # a collector that will not take the metric is BLIND, never a pass
+            print(
+                f"BLIND registration-reconciler tenant={TENANT} channel={CHANNEL} "
+                f"metric push failed: {type(e).__name__}"
+            )
+            sys.exit(1)
+        if registration_ok != 1:
+            sys.exit(1)
+
+    if __name__ == "__main__":
+        main()
+---
+apiVersion: batch/v1
+kind: CronJob
+metadata:
+  name: otto-registration-reconciler
+  namespace: otto-golden
+spec:
+  schedule: "*/5 * * * *"
+  concurrencyPolicy: Forbid
+  successfulJobsHistoryLimit: 3
+  failedJobsHistoryLimit: 3
+  jobTemplate:
+    spec:
+      backoffLimit: 1
+      activeDeadlineSeconds: 60
+      ttlSecondsAfterFinished: 300
+      template:
+        spec:
+          automountServiceAccountToken: false
+          restartPolicy: Never
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 10001
+            runAsGroup: 10001
+            seccompProfile: { type: RuntimeDefault }
+          containers:
+            - name: check
+              # Standard library only (json, ssl, urllib) -- no pip install, no second image
+              # to keep patched (LAW 43); same interpreter tag the estate already runs in
+              # platform/llm/spend-breaker-digest.yaml's digest job.
+              image: docker.io/library/python:3.11-slim
+              command: ["python3", "/scripts/check.py"]
+              env:
+                - name: OTTO_TENANT_ID
+                  value: "estate"
+                - name: OTTO_CHANNEL
+                  value: "telegram"
+                # LAW 50: every workload emits to the central collector; same endpoint as
+                # platform/otto-golden/deployment.yaml.
+                - name: OTEL_EXPORTER_OTLP_ENDPOINT
+                  value: "http://signoz-otel-collector.observability.svc:4318"
+              volumeMounts:
+                - name: scripts
+                  mountPath: /scripts
+                  readOnly: true
+                - name: telegram-token
+                  mountPath: /run/secrets/otto-staging-telegram
+                  readOnly: true
+                - name: tmp
+                  mountPath: /tmp
+              securityContext:
+                allowPrivilegeEscalation: false
+                privileged: false
+                readOnlyRootFilesystem: true
+                runAsNonRoot: true
+                capabilities: { drop: ["ALL"] }
+                seccompProfile: { type: RuntimeDefault }
+              resources:
+                # crew#584: this job wakes for one HTTP call every 5 minutes and sleeps the rest
+                # of the time, so reserving standing CPU for it around the clock would be the
+                # paper-vs-real gap crew#584 exists to close. cpu carries no request (an honest
+                # zero, not a gap the namespace's LimitRange would silently fill with its 50m
+                # default -- explicit "0" beats an implicit default) and a small burst limit
+                # caps a single run. memory keeps requests == limits (Guaranteed for memory,
+                # since an OOM here is a false FAIL on a fact-finding check, not a saving).
+                requests: { cpu: "0", memory: 64Mi }
+                limits: { cpu: 25m, memory: 64Mi }
+          volumes:
+            - name: scripts
+              configMap:
+                name: otto-registration-reconciler-script
+                defaultMode: 0o555
+            - name: telegram-token
+              # The SAME Secret telegram-secret.yaml's ExternalSecret already renders from vault
+              # entry otto-staging-telegram -- never a second vault entry, never a literal token.
+              secret: { secretName: otto-staging-telegram }
+            - name: tmp
+              emptyDir: {}
diff --git a/tests/test_otto_registration_reconciler.py b/tests/test_otto_registration_reconciler.py
new file mode 100644
index 000000000..77e93e9c4
--- /dev/null
+++ b/tests/test_otto_registration_reconciler.py
@@ -0,0 +1,198 @@
+"""Registration reconciler (build order step 6, docs/specs/otto-platform-v1/
+EVENT-GATEWAY-TENANCY.md, receipt layer 3 "vendor registration"): a scheduled job in
+platform/otto-golden/ calls Telegram's own getWebhookInfo with the vault-mounted token
+(the SAME Secret telegram-secret.yaml already renders, never a second vault entry, never a
+literal token anywhere in the manifest) and reports two metrics per tenant/channel:
+channel_registration_ok (0/1) and channel_pending_updates (a count).
+
+Rung 2 properties over the checkout (no network, no cluster): the manifest parses, the
+schedule and retry shape are sane, the token never appears as a literal, the metric names
+match the spec exactly, and the reconciler's own script never prints the token it reads.
+"""
+
+import pathlib
+import re
+
+import yaml
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+MANIFEST = ROOT / "platform" / "otto-golden" / "registration-reconciler.yaml"
+KUSTOMIZATION = ROOT / "platform" / "otto-golden" / "kustomization.yaml"
+
+# The estate's own live-shaped Telegram bot token pattern (see telegram-secret.yaml's docstring
+# and GHSA-3vpc-7q5r-276h): a real token is digits, a colon, then 35 base64url-ish characters.
+LIVE_TOKEN_RE = re.compile(r"\b\d{6,12}:[A-Za-z0-9_-]{30,}\b")
+
+
+def _docs():
+    return [d for d in yaml.safe_load_all(MANIFEST.read_text()) if d]
+
+
+def _configmap():
+    return next(d for d in _docs() if d["kind"] == "ConfigMap")
+
+
+def _script():
+    return _configmap()["data"]["check.py"]
+
+
+def _cronjob():
+    return next(d for d in _docs() if d["kind"] == "CronJob")
+
+
+def _container():
+    return _cronjob()["spec"]["jobTemplate"]["spec"]["template"]["spec"]["containers"][
+        0
+    ]
+
+
+def test_manifest_parses_as_a_configmap_and_a_cronjob():
+    kinds = {d["kind"] for d in _docs()}
+    assert kinds == {"ConfigMap", "CronJob"}
+
+
+def test_cronjob_runs_every_five_minutes():
+    cj = _cronjob()
+    assert cj["metadata"]["namespace"] == "otto-golden"
+    assert cj["spec"]["schedule"] == "*/5 * * * *"
+
+
+def test_cronjob_retry_and_deadline_shape_is_sane():
+    """A stuck run must not pile up behind the next one, and a hung getWebhookInfo call must
+    not run forever."""
+    spec = _cronjob()["spec"]
+    assert spec["concurrencyPolicy"] == "Forbid"
+    job = spec["jobTemplate"]["spec"]
+    assert 0 < job["backoffLimit"] <= 3
+    assert 0 < job["activeDeadlineSeconds"] <= 300, (
+        "a schedule of 5 minutes needs a deadline well under 5 minutes"
+    )
+    assert job["ttlSecondsAfterFinished"] <= 3600
+
+
+def test_the_token_is_mounted_from_the_existing_secret_never_a_second_vault_entry():
+    volumes = {
+        v["name"]: v
+        for v in _cronjob()["spec"]["jobTemplate"]["spec"]["template"]["spec"][
+            "volumes"
+        ]
+    }
+    token_vol = volumes["telegram-token"]
+    assert token_vol["secret"]["secretName"] == "otto-staging-telegram", (
+        "must reuse the same Secret telegram-secret.yaml already renders from vault, "
+        "never a second, hand-minted entry"
+    )
+    container = _container()
+    mount = next(m for m in container["volumeMounts"] if m["name"] == "telegram-token")
+    assert mount["readOnly"] is True
+    assert mount["mountPath"] == "/run/secrets/otto-staging-telegram"
+
+
+def test_no_literal_secret_anywhere_in_the_manifest():
+    raw = MANIFEST.read_text()
+    assert not LIVE_TOKEN_RE.search(raw), "a live-shaped Telegram bot token literal"
+    assert "valueFrom" not in raw or "secretKeyRef" not in raw, (
+        "Kyverno secrets-not-from-env-vars refuses env.valueFrom.secretKeyRef on a Pod (crew#341)"
+    )
+    container = _container()
+    env_names = {e["name"] for e in container.get("env", [])}
+    assert "OTTO_TELEGRAM_BOT_TOKEN" not in env_names, (
+        "the token is a mounted file the script reads itself, never a pod env var"
+    )
+
+
+def test_the_script_never_prints_the_token_it_reads():
+    script = _script()
+    assert "print(token" not in script
+    assert 'print(f"{token' not in script
+    # the token variable is used only to build the request URL and read the file; it must never
+    # be interpolated into anything the script writes to stdout.
+    print_lines = [ln for ln in script.splitlines() if "print(" in ln]
+    for ln in print_lines:
+        assert "token" not in ln, f"a print statement names the token variable: {ln!r}"
+
+
+def test_metric_names_match_the_spec_exactly():
+    script = _script()
+    assert '"channel_registration_ok"' in script
+    assert '"channel_pending_updates"' in script
+    # the spec's two metrics only, no drift to a third name or a renamed one
+    metric_literals = set(re.findall(r'_gauge\("([a-z_]+)"', script))
+    assert metric_literals == {"channel_registration_ok", "channel_pending_updates"}
+
+
+def test_metrics_carry_tenant_and_channel_attributes():
+    script = _script()
+    assert '"key": "tenant_id"' in script
+    assert '"key": "channel"' in script
+
+
+def test_metrics_are_pushed_to_the_estates_one_existing_collector():
+    """LAW 43: no second metrics sink. Same endpoint as platform/otto-golden/deployment.yaml's
+    OTEL_EXPORTER_OTLP_ENDPOINT."""
+    container = _container()
+    env = {e["name"]: e["value"] for e in container["env"] if "value" in e}
+    assert (
+        env["OTEL_EXPORTER_OTLP_ENDPOINT"]
+        == "http://signoz-otel-collector.observability.svc:4318"
+    )
+    script = _script()
+    assert "/v1/metrics" in script
+    assert "OTEL_EXPORTER_OTLP_ENDPOINT" in script
+
+
+def test_container_is_locked_down_like_every_other_workload_here():
+    container = _container()
+    sc = container["securityContext"]
+    assert sc["allowPrivilegeEscalation"] is False
+    assert sc["readOnlyRootFilesystem"] is True
+    assert sc["runAsNonRoot"] is True
+    assert sc["capabilities"]["drop"] == ["ALL"]
+    pod_sc = _cronjob()["spec"]["jobTemplate"]["spec"]["template"]["spec"][
+        "securityContext"
+    ]
+    assert pod_sc["runAsNonRoot"] is True
+    assert (
+        _cronjob()["spec"]["jobTemplate"]["spec"]["template"]["spec"][
+            "automountServiceAccountToken"
+        ]
+        is False
+    )
+
+
+def test_resources_fit_the_namespaces_existing_quota_headroom():
+    """otto-golden-ceiling (quota.yaml) already reserves requests.cpu=200m/requests.memory=384Mi
+    against the two-replica Deployment (50m/256Mi requested, 400m/512Mi limited at most three
+    pods during a rollout); this job must fit the remaining headroom without a quota bump, so it
+    ships with no increase to a recurring bill.
+
+    crew#584: a job that wakes for one HTTP call every 5 minutes reserves no standing CPU
+    (requests.cpu is an honest "0", never an unset field the namespace's LimitRange would
+    silently default to 50m). memory keeps requests == limits -- Guaranteed for memory, since an
+    OOM here is a false FAIL on a fact-finding check, not a real saving."""
+    container = _container()
+    req = container["resources"]["requests"]
+    lim = container["resources"]["limits"]
+    assert req["cpu"] == "0", (
+        "no standing CPU reservation for a job idle 299 of every 300 seconds"
+    )
+    assert req["memory"] == lim["memory"], "Guaranteed QoS for memory"
+    cpu_limit_millis = int(str(lim["cpu"]).rstrip("m"))
+    mem_mi = int(req["memory"].rstrip("Mi"))
+    assert cpu_limit_millis <= 100, (
+        "must fit the ~150m of headroom left under requests.cpu"
+    )
+    assert mem_mi <= 100, "must fit the ~128Mi of headroom left under requests.memory"
+
+
