diff --git a/platform/edge/kyverno-secrets-policy.yaml b/platform/edge/kyverno-secrets-policy.yaml
new file mode 100644
index 000000000..a68941768
--- /dev/null
+++ b/platform/edge/kyverno-secrets-policy.yaml
@@ -0,0 +1,55 @@
+# crew#341: no policy blocked a container from reading a secret via env vars. Confirmed
+# absent 2026-08-26 -- today's platform/observability/langfuse.yaml happens to do secrets
+# correctly (ExternalSecret -> volume mount) by authorial care, not enforcement. Nothing
+# stopped a future chart's env.valueFrom.secretKeyRef/envFrom.secretRef default from
+# shipping. This is the upstream Kyverno community policy (kyverno/policies,
+# other-cel/disallow-secrets-from-env-vars), not hand-rolled -- LAW 19/43: use the mature
+# tool, verified against the real upstream manifest before writing this file.
+#
+# Audit, not Enforce, on first landing: this repo's own enforce.yaml (tests/fixtures/
+# kyverno/upstream/) flips every upstream PSS policy from Audit to Enforce for exactly
+# this reason (LAW 28, an instrument nobody reads is not an instrument) -- but that flip
+# happens after an audit pass confirms zero existing violations. Flip this one to Enforce
+# once bin/idp-ci's kyverno-secrets-audit row (added below) reports zero live violations.
+apiVersion: kyverno.io/v1
+kind: ClusterPolicy
+metadata:
+  name: secrets-not-from-env-vars
+  annotations:
+    policies.kyverno.io/title: Disallow Secrets from Env Vars in CEL expressions
+    policies.kyverno.io/category: Sample, EKS Best Practices in CEL
+    policies.kyverno.io/severity: medium
+    policies.kyverno.io/subject: Pod, Secret
+    kyverno.io/kyverno-version: 3.9.0
+    policies.kyverno.io/description: >-
+      Secrets used as environment variables containing sensitive information may, if not
+      carefully controlled, be printed in log output which could be visible to unauthorized
+      people and captured in forwarding applications. This policy disallows using Secrets as
+      environment variables.
+spec:
+  validationFailureAction: Audit
+  background: true
+  rules:
+    - name: secrets-not-from-env-vars
+      match:
+        any:
+          - resources:
+              kinds:
+                - Pod
+              operations:
+                - CREATE
+                - UPDATE
+      validate:
+        cel:
+          expressions:
+            # Upstream (kyverno/policies, other-cel/disallow-secrets-from-env-vars) uses
+            # nested .orValue() optional-chaining: container.?env.orValue([]).all(env,
+            # env.?valueFrom.?secretKeyRef.orValue(true)). That form threw "no such
+            # overload" against local `kyverno apply` (CLI 1.19.0) on the real must-fail
+            # fixture -- confirmed via `kyverno apply` against tests/fixtures/kyverno-secrets/,
+            # not assumed. Rewritten with has()/exists(), verified identical pass/fail
+            # behaviour on all 5 fixtures (2 must-fail, 3 must-pass) before landing.
+            - expression: "object.spec.containers.all(c, !c.?env.orValue([]).exists(e, has(e.valueFrom) && has(e.valueFrom.secretKeyRef)))"
+              message: "Secrets must be mounted as volumes, not as environment variables."
+            - expression: "object.spec.containers.all(c, !c.?envFrom.orValue([]).exists(ef, has(ef.secretRef)))"
+              message: "Secrets must not come from envFrom statements."
