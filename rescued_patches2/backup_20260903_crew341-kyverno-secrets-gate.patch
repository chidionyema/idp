--- /dev/null
+++ b/tests/fixtures/kyverno-secrets/pod-plain-configmap-env.good.yaml
@@ -0,0 +1,21 @@
+# must-pass, real edge case: env vars sourced from a ConfigMap (not a Secret) must be
+# allowed -- this is the actual risk of a guard written too broadly (LAW 38): if it
+# refuses configMapKeyRef too, it blocks correct, non-sensitive config injection.
+apiVersion: v1
+kind: Pod
+metadata:
+  name: good-configmap-env
+  namespace: default
+spec:
+  containers:
+    - name: app
+      image: example/app:latest
+      env:
+        - name: LOG_LEVEL
+          valueFrom:
+            configMapKeyRef:
+              name: app-config
+              key: log_level
+      envFrom:
+        - configMapRef:
+            name: app-config-bulk
