@@ -0,0 +1,40 @@
+# crew#341: proves the secrets-not-from-env-vars Kyverno policy still refuses the real
+# must-fail fixtures and still passes the real must-pass fixtures. No live cluster
+# needed -- this is a local `kyverno apply` against tests/fixtures/kyverno-secrets/,
+# same command a session ran by hand before landing the policy (PR #259).
+name: kyverno-secrets-drill
+on:
+  schedule:
+    - cron: "41 7 * * *"   # daily; a policy regression here is a real security gap, not urgent-hourly
+  workflow_dispatch: {}
+  push:
+    branches: [main]
+    paths:
+      - platform/edge/kyverno-secrets-policy.yaml
+      - tests/fixtures/kyverno-secrets/**
+      - tests/test_incident_crew341_kyverno_secrets_from_env_vars.py
+      - .github/workflows/kyverno-secrets-drill.yml
+permissions:
+  contents: read
+concurrency:
+  group: kyverno-secrets-drill
+  cancel-in-progress: false
+jobs:
+  kyverno-secrets-drill:
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with: { python-version: "3.12" }
+      - name: install kyverno CLI
+        run: |
+          set -euo pipefail
+          curl -sL https://github.com/kyverno/kyverno/releases/download/v1.19.0/kyverno-cli_v1.19.0_linux_x86_64.tar.gz -o /tmp/kyverno.tar.gz
+          tar -xzf /tmp/kyverno.tar.gz -C /tmp
+          sudo mv /tmp/kyverno /usr/local/bin/kyverno
+          kyverno version
+      - name: install pytest
+        run: python3 -m pip install --quiet pytest pyyaml
+      - name: run the drill (real kyverno apply, 5 fixtures, 2 must-fail + 3 must-pass)
+        run: python3 -m pytest tests/test_incident_crew341_kyverno_secrets_from_env_vars.py -v
