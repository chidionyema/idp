+# must-pass: the real, already-shipped pattern -- platform/observability/langfuse.yaml's
+# own approach. Secrets arrive as a real Kubernetes Secret (synced by ExternalSecret from
+# OCI Vault) and are mounted as a volume, never referenced in env/envFrom at all.
+apiVersion: v1
+kind: Pod
+metadata:
+  name: good-vault-mounted-secret
+  namespace: observability
+spec:
+  containers:
+    - name: langfuse-web
+      image: example/langfuse-web:latest
+      env:
+        - name: NODE_ENV
+          value: production
+      volumeMounts:
+        - name: langfuse-secrets
+          mountPath: /run/secrets/langfuse
+          readOnly: true
+  volumes:
+    - name: langfuse-secrets
+      secret:
+        secretName: langfuse-init
