-        {
-            "session_id": session_id,
-            "kind": str(ck.get("shadow.auth_receipt_kind")),
-            "by": "shadow-founder",
-            "text": line,
-            "step": int(step),
-            "status": "running",
-            "boundary": auth.boundary.kind,
-            "op": auth.op.name,
-            "confidence": float(auth.confidence),
-            "refill": int(auth.boundary.refill),
-            "steps_covered": int(auth.boundary.steps_covered),
