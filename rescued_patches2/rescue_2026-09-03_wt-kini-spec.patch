-def _commit_marker(wt: Path, branch: str, task: str, step: int, output: str) -> str:
-    marker = wt / str(ck.get("branch.marker_filename"))
-    marker.write_text(f"# {branch}\n\ntask: {task}\nstep: {step}\n\n{output}\n")
-    _git(wt, "add", "--", marker.name)
