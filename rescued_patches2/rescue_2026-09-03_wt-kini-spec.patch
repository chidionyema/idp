-    threshold = float(min_confidence if min_confidence is not None else config.get("shadow.min_confidence").value)
-    if conf >= threshold:
-        return ShadowAuth(boundary, op, conf)
-    return Ask(boundary, boundary.card_text, "low_confidence")
