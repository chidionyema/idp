-        parent=parent_hash,
-        timestamp=int(inp["timestamp"]),
-        budget_remaining=int(inp.get("budget", 0)),
-    )
-    return {"fork_commit": fork_commit, "fork_hash": fork_hash, "branches": branches}
-
-
-@activity.defn
-async def branch_fork(inp: dict[str, Any]) -> dict[str, Any]:
