-
-@dataclass
-class Session:
-    session_id: str
-    remaining: int
-    predicted_costs: list[int]
-    status: str = "running"
-    asking: str | None = None
-    pending: Boundary | None = None
-    step: int = 0
-    asks: int = 0
-    steps_run: int = 0
-    verdict: Verdict | None = None
