--- a/observability/otel-collector.yaml
+++ /dev/null
@@ -1,61 +0,0 @@
-# The one OpenTelemetry Collector pipeline for the estate (crew#258, STANDARDS row "Observability").
-#
-# One receiver per source. The key under `receivers:` is the name that
-# crew science/sources.json cites in its `receiver` field (crew#253), so the
-# registry and this pipeline can be checked against each other by a gate.
-# Every layer of the God View proposal lands here; nothing writes telemetry
-# around this file.
-#
-# Exporters: SigNoz (ClickHouse) for metrics, traces and logs; Langfuse for a
-# copy of the GenAI traces. Both endpoints come from the environment, never a
-# literal (LAW 46).
-#
-# Status: skeleton. Receivers are declared with the mature component that
-# serves them; each is enabled by the checkpoint on crew#258 that wires it.
-
-receivers:
-  otlp:                       # layer 1: agents (GenAI semconv), any OTLP producer
-    protocols:
-      http:
-        endpoint: ${env:OTEL_OTLP_HTTP_ENDPOINT}
-  # Receivers below are added by the crew#258 checkpoint that configures them.
-  # A receiver with an empty config makes the collector refuse to start, so
-  # none is declared before it is wired. Planned keys (the contract with
-  # crew science/sources.json `receiver`):
-  #   kubeletstats  layer 4: pod CPU throttling, memory, restarts        CP3
-  #   k8s_cluster   layer 4: OOMKills, ImagePullBackOff, readiness        CP3
-  #   postgresql    layer 3: deadlocks, pool saturation, slow queries     CP3
-  #   prometheus    layer 3: Flux reconcile latency, drift                CP3
-  #   github        layer 3: Actions queue depth, step time, retries      CP3
-  #   layer 2 (ingress, Cloudflare Logpush, Ephemeral Library) via otlp   CP4
-  #   layer 5 (founder approvals, alert click-through) via otlp events    CP4
-
-processors:
-  memory_limiter:
-    check_interval: 5s
-    limit_mib: 256
-    spike_limit_mib: 64
-  batch: {}
-
-exporters:
-  otlphttp/signoz:
-    endpoint: ${env:SIGNOZ_OTLP_ENDPOINT}
-  otlphttp/langfuse:
-    endpoint: ${env:LANGFUSE_OTLP_ENDPOINT}
-    headers:
-      Authorization: ${env:LANGFUSE_OTLP_AUTH}
-
-service:
-  pipelines:
-    traces:
-      receivers: [otlp]
-      processors: [memory_limiter, batch]
-      exporters: [otlphttp/signoz, otlphttp/langfuse]
-    metrics:
-      receivers: [otlp]
-      processors: [memory_limiter, batch]
-      exporters: [otlphttp/signoz]
-    logs:
-      receivers: [otlp]
-      processors: [memory_limiter, batch]
-      exporters: [otlphttp/signoz]
