-    image:
-      registry: docker.io
-    resources:
-      requests: { cpu: 50m, memory: 128Mi }
-      limits: { cpu: 250m, memory: 512Mi }
-    persistence:
-      size: 2Gi
-signoz:
-  replicaCount: 1
-  resources:
-    requests: { cpu: 100m, memory: 256Mi }
-    limits: { cpu: 500m, memory: 1Gi }
-  persistence:
-    size: 1Gi
-  ingress:
-    enabled: false
-otelCollector:
-  replicaCount: 1
-  resources:
-    requests: { cpu: 100m, memory: 200Mi }
-    limits: { cpu: 500m, memory: 512Mi }
-telemetryStoreMigrator:
-  resources:
-    requests: { cpu: 50m, memory: 128Mi }
-    limits: { cpu: 500m, memory: 512Mi }
