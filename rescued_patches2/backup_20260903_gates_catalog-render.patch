+#!/usr/bin/env python3
+"""catalog-render: put the live architecture page on main on a schedule, through a pull request.
+
+crew#236 row 2, second half. bin/catalog-gen and bin/estate-diagram already turn the inventory
+into catalog/catalog-info.yaml and docs/architecture/live.md; this job runs them after every
+inventory run (scheduler/schedule.yml: com.estate.catalog-render, after: com.estate.inventory)
+and lands the page on main. Nothing here is a new collector or renderer.
+
+Why a script at all: the scheduler needs one command, and main is protected by required
+checks with no bypass actor, so a direct push is refused. The proven pieces used are a
+detached git worktree at origin/main (the same shape as crew's estate-snapshot), a branch
+push, `gh pr create` and GitHub's own auto-merge, which lands the change the moment
+security-scan and spec-gate pass. What was rejected: pushing straight to main (refused by
+the ruleset), a bypass actor (a hole a buyer's engineer finds in one sitting), and a launchd
+plist (the estate scheduler is the one scheduler, LAW 19a/20b).
+
+    catalog-render             render, commit, push, open or refresh the PR with auto-merge on
+    catalog-render --dry-run   render and print the diff; touch nothing on origin
+
+Exit 0 when the page is on its way to main or unchanged, 1 naming the step that failed,
+3 BLIND when there is no inventory to render from.
+"""
+from __future__ import annotations
+
+import os
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+WT = Path(os.environ.get("IDP_STATE_WORKTREE") or ROOT.parent / ".idp-state")
+BRANCH = "state/live-diagram"
+PAGE = "docs/architecture/live.md"
+INV = Path(os.environ.get("INV") or os.path.expanduser("~/.estate/state/inventory.json"))
+
+
+def sh(cmd: list[str], cwd: Path, timeout: int = 120) -> tuple[int, str]:
+    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
+    return p.returncode, (p.stdout + p.stderr).strip()
+
+
+def step(label: str, cmd: list[str], cwd: Path, timeout: int = 120) -> str:
+    rc, out = sh(cmd, cwd, timeout)
+    if rc != 0:
+        print(f"FAIL  catalog-render: {label}: {out[:300]}")
+        sys.exit(1)
+    return out
+
+
+def main(argv: list[str]) -> int:
+    dry = "--dry-run" in argv
+    if not INV.is_file():
+        print(f"BLIND catalog-render: no inventory at {INV}; com.estate.inventory has not run", file=sys.stderr)
+        return 3
+    step("fetch origin main", ["git", "fetch", "-q", "origin", "main"], ROOT)
+    if not (WT / ".git").exists():
+        sh(["git", "worktree", "prune"], ROOT)
+        step("create worktree", ["git", "worktree", "add", "--detach", "-q", str(WT), "origin/main"], ROOT)
+    step("move worktree to origin/main", ["git", "checkout", "-q", "--detach", "origin/main"], WT)
+    step("catalog-gen", [sys.executable, str(WT / "bin" / "catalog-gen")], WT, 300)
+    step("estate-diagram", [sys.executable, str(WT / "bin" / "estate-diagram")], WT)
+    rc, diff = sh(["git", "diff", "--stat", "--", PAGE], WT)
+    if not diff:
+        print("catalog-render: page unchanged since the last render; nothing to commit")
+        return 0
+    if dry:
+        print(f"catalog-render --dry-run: would commit\n{diff}")
+        return 0
+    taken = step("inventory time", ["sed", "-n", "s/^# inventory taken: //p", "catalog/catalog-info.yaml"], WT)
+    step("stage", ["git", "add", PAGE], WT)
+    step("commit", ["git", "commit", "-q", "-m", f"docs(architecture): live estate page, inventory taken {taken}\n\nAuthor-session: com.estate.catalog-render"], WT)
+    step("push", ["git", "push", "-q", "--force-with-lease", "origin", f"HEAD:refs/heads/{BRANCH}"], WT)
+    rc, existing = sh(["gh", "pr", "list", "--head", BRANCH, "--state", "open", "--json", "number", "--jq", ".[0].number"], WT)
+    if not existing:
+        step("open PR", ["gh", "pr", "create", "--base", "main", "--head", BRANCH,
+                         "--title", "docs(architecture): live estate page from the scheduled render",
+                         "--body", f"No-Issue: scheduled render of {PAGE} from the catalogue (crew#236 row 2).\n\n"
+                                   f"Author-session: com.estate.catalog-render\nStandard: Service catalog row, docs/STANDARDS.md\n\n"
+                                   "Generated by bin/catalog-render after com.estate.inventory. Auto-merge is on; "
+                                   "it lands when security-scan and spec-gate pass."], WT)
+        rc, existing = sh(["gh", "pr", "list", "--head", BRANCH, "--state", "open", "--json", "number", "--jq", ".[0].number"], WT)
+    step("auto-merge", ["gh", "pr", "merge", existing, "--auto", "--squash"], WT)
+    print(f"catalog-render: {PAGE} pushed to {BRANCH}, PR #{existing} set to auto-merge")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
