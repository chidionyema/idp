+    set +e
+    main_rc=0
+    main_out=$("$IDP/bin/idp-main-green-gate" 2>&1); main_rc=$?
+    set -e
+    echo "$main_out"
+    [ "$main_rc" = 1 ] && exit 1
+    set +e
+    wip_rc=0
+    wip_out=$("$IDP/bin/idp-wip-gate" 2>&1); wip_rc=$?
+    set -e
+    echo "$wip_out"
+    [ "$wip_rc" = 1 ] && exit 1
+fi
