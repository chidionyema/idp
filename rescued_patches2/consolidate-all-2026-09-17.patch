 # of them 841 files deleted (crew#584). The tests run in a clean git environment, always.
 for v in $(compgen -e | grep '^GIT_' || true); do unset "$v"; done
+# Founder 2026-09-17 (Andon cord): every branch drawn from a broken main inherits its failures,
+# and agents that open new PRs while existing ones are red compound the pile-up. These two gates
+# fire ONLY on the first push of a new branch (remote sha = 000...000) so they never block a fix
+# being pushed onto an existing branch. BLIND (no gh / no network) exits 2 and does NOT refuse.
+new_branch=false
+while read -r _local_ref _local_sha remote_ref _remote_sha; do
+    if [ "$_remote_sha" = "0000000000000000000000000000000000000000" ]; then
+        new_branch=true
+    fi
+done
