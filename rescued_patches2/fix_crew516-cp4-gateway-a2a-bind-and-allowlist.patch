index 315b39f32..9c7437de4 100644
--- a/platform/hermes-agent/gateway.yaml
+++ b/platform/hermes-agent/gateway.yaml
@@ -47,6 +47,41 @@ spec:
   dataFrom:
     - extract: { key: hermes-agent-env }
 ---
+# crew#516 CP4 (2026-08-27, receipt 33116314460): the a2a adapter binds 127.0.0.1 unless a bearer
+# token is configured (hermes-agent plugins/platforms/a2a/security.py resolve_bind_host), so the
+# kubelet's probe on the pod IP was "connection refused" 151 times and the pod was killed every five
+# minutes. The token is generated once in the cluster by ESO's Password generator, never seeded,
+# never in git, and projected into the same env dir the entrypoint exports.
+apiVersion: generators.external-secrets.io/v1alpha1
+kind: Password
+metadata:
+  name: hermes-agent-a2a
+  namespace: hermes-agent
+spec:
+  length: 48
+  digits: 8
+  symbols: 0
+  symbolCharacters: ""
+  noUpper: false
+  allowRepeat: true
+---
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: hermes-agent-a2a
+  namespace: hermes-agent
+spec:
+  refreshInterval: "0"   # generated once; a rotation under a running gateway is a deliberate change
+  target: { name: hermes-agent-a2a, creationPolicy: Owner }
+  dataFrom:
+    - sourceRef:
+        generatorRef:
+          apiVersion: generators.external-secrets.io/v1alpha1
+          kind: Password
+          name: hermes-agent-a2a
+      rewrite:
+        - transform: { template: "A2A_BEARER_TOKEN" }
+---
 # HERMES_HOME. 5Gi is the Mac's checkout today (state.db, sessions, hindsight, kanban) with room.
 apiVersion: v1
 kind: PersistentVolumeClaim
@@ -82,7 +117,7 @@ metadata:
   annotations:
     # Reloader (platform/reloader) rolls the pod when the vault entry lands through ESO (1h refresh),
     # the same way litellm picks up litellm-upstream: the swap seeds TELEGRAM_BOT_TOKEN and the pod restarts.
-    secret.reloader.stakater.com/reload: "hermes-agent-env"
+    secret.reloader.stakater.com/reload: "hermes-agent-env,hermes-agent-a2a"
   labels:
     app: hermes-agent-gateway
     app.kubernetes.io/name: hermes-agent-gateway
@@ -131,6 +166,11 @@ spec:
               value: http://hindsight-api.hindsight.svc:8888
             - name: PYTHONUNBUFFERED
               value: "1"
+            # crew#516 CP4: bind a2a on the pod IP so the probes below reach it; A2A_BEARER_TOKEN
+            # (hermes-agent-a2a, above) is what lets the adapter leave loopback. The agent card is
+            # public by design; every POST needs the token.
+            - name: A2A_HOST
+              value: 0.0.0.0
           ports:
             - containerPort: 9900
               name: a2a
@@ -190,6 +230,9 @@ spec:
         - name: tmp
           emptyDir: {}
         - name: env
-          secret: { secretName: hermes-agent-env }
+          projected:
+            sources:
+              - secret: { name: hermes-agent-env }
+              - secret: { name: hermes-agent-a2a }   # crew#516 CP4: A2A_BEARER_TOKEN
         - name: estate
           configMap: { name: hermes-agent-estate }
