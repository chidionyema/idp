diff --git a/platform/alerts-secret/kustomization.yaml b/platform/alerts-secret/kustomization.yaml
new file mode 100644
index 000000000..e338dd432
--- /dev/null
+++ b/platform/alerts-secret/kustomization.yaml
@@ -0,0 +1,8 @@
+# The alerts row's own credential (crew#284, 2026-08-26). It lived in platform/secret-store, whose
+# `wait: true` made one failing ExternalSecret hold llm, identity, alerts and image-automation
+# behind it (llm.<zone> NXDOMAIN 14:59Z-21:50Z). secret-store now carries only the store; each
+# consumer waits for its own secret.
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - flux-telegram.yaml
