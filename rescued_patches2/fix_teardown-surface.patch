index 4339a0d73..f0ddea759 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -234,6 +234,60 @@ jobs:
       - run: cd platform/messaging && go vet ./... && go test ./...
       - run: bin/idp-messaging-demo all
 
+  # crew#459, 2026-08-31. The portal's own test suite was run by nothing. Every workflow that
+  # mentions backstage grades the *running* one -- verdict-backstage proves the deployed pod,
+  # login-drill signs in to it, build-multiarch builds the image -- and the image build runs
+  # `yarn tsc` and `yarn build:all`, never `yarn test`. So a unit test under packages/app was an
+  # instrument nobody reads (LAW 28): it could only ever go red on a laptop, and only if someone
+  # remembered to run it. The colour-contrast guard added with this job is exactly the kind of
+  # defect a type-check and a build cannot see -- every state border in the portal failed WCAG
+  # 2.2 SC 1.4.11 for months while CI was green -- so the guard is worth nothing without a lane
+  # that runs it. Only on changes under backstage/: the install is the slow part and nothing else
+  # in the repository can move these tests.
+  portal-app:
+    needs: fast-gate
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with: { fetch-depth: 0 }   # `repo lint --since origin/main` and `repo test` diff the base
+      - name: did this change touch the portal at all
+        id: touched
+        run: |
+          base="${{ github.event.pull_request.base.sha || github.event.before }}"
+          # a first push to a branch reports an all-zero before-sha; grade the whole thing then
+          case "$base" in ''|0000000000000000000000000000000000000000) echo "yes=true" >> "$GITHUB_OUTPUT"; exit 0;; esac
+          if git diff --name-only "$base"...HEAD -- backstage/ | grep -q .; then
+            echo "yes=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "yes=false" >> "$GITHUB_OUTPUT"
+          fi
+      - uses: actions/setup-node@2028fbc5c25fe9cf00d9f06a71cc4710d4507903 # v6.0.0
+        if: steps.touched.outputs.yes == 'true'
+        with:
+          # backstage/package.json declares engines.node "22 || 24" and the image is node:24.
+          # Pinning the same major here means a green lane and a green image agree about the
+          # runtime; the host's node 26 is outside that range on purpose.
+          node-version: "24"
+      - name: yarn, the version package.json pins
+        if: steps.touched.outputs.yes == 'true'
+        run: corepack enable && corepack prepare yarn@4.13.0 --activate
+      - name: install exactly what yarn.lock holds
+        if: steps.touched.outputs.yes == 'true'
+        working-directory: backstage
+        run: yarn install --immutable
+      - name: type-check
+        if: steps.touched.outputs.yes == 'true'
+        working-directory: backstage
+        run: yarn tsc
+      - name: lint
+        if: steps.touched.outputs.yes == 'true'
+        working-directory: backstage
+        run: yarn lint
+      - name: the app's tests, including the contrast guard
+        if: steps.touched.outputs.yes == 'true'
+        working-directory: backstage
+        run: yarn test --ci --watchAll=false
+
   bdd:
     needs: bdd-suites
     if: always()   # a red leg must report a red `bdd`, not a skipped one the rule would wait on forever
