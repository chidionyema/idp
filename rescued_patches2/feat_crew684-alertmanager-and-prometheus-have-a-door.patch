diff --git a/platform/monitoring/edge-manners.yaml b/platform/monitoring/edge-manners.yaml
new file mode 100644
index 000000000..33cc3163e
--- /dev/null
+++ b/platform/monitoring/edge-manners.yaml
@@ -0,0 +1,42 @@
+# Edge manners (crew#307 follow-up, founder 2026-08-29: a user saw Traefik's raw "no available
+# server" on the catalogue -- "amateur"). Two of Traefik's built-in middlewares, attached to every
+# rule on this namespace's routes that fronts an application:
+#   friendly-errors  502/503/504 from a backend (pod restarting, namespace rebuilding, node gone)
+#                    are answered by the status page in platform/edge/status-page.yaml, which says
+#                    in plain English that the door is starting and retries itself.
+#   edge-headers     HSTS, nosniff, same-origin framing, referrer policy, and the backend's
+#                    Server / X-Powered-By banners removed, so no door tells a stranger which
+#                    web server or framework sits behind it.
+# A Middleware is an ExtensionRef filter and must live in the route's namespace (Traefik Gateway
+# API reference); the errors service lives in edge, which is why providers.kubernetesCRD
+# .allowCrossNamespace is on in platform/edge/traefik.yaml.
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: friendly-errors
+  namespace: monitoring
+spec:
+  errors:
+    status: ["502-504"]
+    service:
+      name: status-page
+      namespace: edge
+      port: 80
+    query: "/{status}.html"
+---
+apiVersion: traefik.io/v1alpha1
+kind: Middleware
+metadata:
+  name: edge-headers
+  namespace: monitoring
+spec:
+  headers:
+    stsSeconds: 63072000
+    stsIncludeSubdomains: true
+    stsPreload: true
+    contentTypeNosniff: true
+    customFrameOptionsValue: SAMEORIGIN
+    referrerPolicy: strict-origin-when-cross-origin
+    customResponseHeaders:
+      Server: ""
+      X-Powered-By: ""
diff --git a/platform/monitoring/httproute.yaml b/platform/monitoring/httproute.yaml
new file mode 100644
index 000000000..33b4438a0
--- /dev/null
+++ b/platform/monitoring/httproute.yaml
@@ -0,0 +1,115 @@
+# The two monitoring doors (crew#684; founder 2026-08-30: "first i need all cluster monitoring tools
+# now ... top right of screen backstage ... all monitoring tools"). For 43 hours the catalogue read
+# "no public address yet" on both: kube-prometheus-stack was installed as an alert evaluator only
+# and nobody built a hostname for the console the alerts fire from or the store the numbers live in.
+# Same shape as signoz (platform/observability/httproute.yaml): the login callback path goes to
+# oauth2-proxy, everything else passes the one login (login-forward-auth) and reaches the chart's
+# Service. Grafana stays off in kube-prometheus-stack.yaml; SigNoz is the dashboard screen.
+# Service names: fullnameOverride `kps` + cleanPrometheusOperatorObjectNames, so kps-alertmanager
+# (9093) and kps-prometheus (9090), the same two the langfuse-alert-drill asks.
+---
+# Alertmanager: every firing alert, its silences, and the route that reaches your Telegram.
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  labels:
+    backstage.io/kubernetes-id: founder-alerts
+  name: alertmanager
+  namespace: monitoring
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-alertmanager
+  hostnames:
+    - "alertmanager.${ESTATE_ZONE}"
+  rules:
+    - matches:
+        - path: { type: PathPrefix, value: /oauth2/ }
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: oauth2-proxy
+          namespace: identity
+          port: 80
+    - filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: login-forward-auth
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: kps-alertmanager
+          port: 9093
+---
+# Prometheus: the numbers behind every alert, the rules, and which targets are being scraped.
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  labels:
+    backstage.io/kubernetes-id: founder-metrics
+  name: prometheus
+  namespace: monitoring
+spec:
+  parentRefs:
+    - name: prospector-edge
+      namespace: prospector
+      sectionName: https-prometheus
+  hostnames:
+    - "prometheus.${ESTATE_ZONE}"
+  rules:
+    - matches:
+        - path: { type: PathPrefix, value: /oauth2/ }
+      filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: oauth2-proxy
+          namespace: identity
+          port: 80
+    - filters:
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: login-forward-auth
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: friendly-errors
+        - type: ExtensionRef
+          extensionRef:
+            group: traefik.io
+            kind: Middleware
+            name: edge-headers
+      backendRefs:
+        - name: kps-prometheus
+          port: 9090
