+name: device-provision-test
+
+# Why two jobs (matrix strategy=fail-fast): the founder's Mac
+# (idp/infra/macos/*, brew bundle, launchd plists) and any enterprise
+# Linux box (idp/infra/linux/*, apt-get install, systemd units) are two
+# install surfaces and two runtimes. Failing one path fast is more
+# useful than waiting on both. Both jobs run the same idp-device-provision
+# orchestrator -- the dispatch lives in the script, not in CI.
+
+on:
+  pull_request:
+    paths:
+      - "infra/**"
+      - "bin/idp-device-provision"
+      - ".github/workflows/device-provision-test.yml"
+  push:
+    branches: [main]
+    paths:
+      - "infra/**"
+      - "bin/idp-device-provision"
+
+jobs:
+  macos:
+    runs-on: macos-14
+    steps:
+      - uses: actions/checkout@v7
+      - run: bin/idp-device-provision self-test
+      - run: IDP_DEVICE_PROVISION_DRY=1 bin/idp-device-provision install
+      - run: bin/idp-device-provision status | jq -e '.platform == "macos"'
+      - run: bin/idp-device-provision uninstall
+      - run: IDP_DEVICE_PROVISION_DRY=1 bin/idp-device-provision install
+
+  linux:
+    runs-on: ubuntu-24.04
+    steps:
+      - uses: actions/checkout@v7
+      - run: bin/idp-device-provision self-test
+      - run: IDP_DEVICE_PROVISION_DRY=1 bin/idp-device-provision install
+      - run: bin/idp-device-provision status | jq -e '.platform == "linux"'
+      - run: bin/idp-device-provision uninstall
+      - run: IDP_DEVICE_PROVISION_DRY=1 bin/idp-device-provision install
diff --git a/.github/workflows/notify-failure.yml b/.github/workflows/notify-failure.yml
new file mode 100644
index 000000000..fe1fea8d8
--- /dev/null
+++ b/.github/workflows/notify-failure.yml
@@ -0,0 +1,60 @@
+# The founder does not watch CI; CI tells him when it is red. One Telegram message per
+# failed run of a founder-facing workflow, to the otto_mumu channel -- not the home
+# channel (2026-08-29, founder: "how do i get anything done with 6vnessages").
+#
+# Flux deploy failures are covered in the cluster, not here: platform/alerts (Provider
+# telegram + Alert broken-workload) posts every failed reconcile to the same channel.
+#
+# Chat id resolution: TELEGRAM_MUMU_CHAT_ID when set, else the alerts group chat id that
+# already seeds the cluster's flux-telegram Secret. A run with neither secret does not
+# fail -- a notification lane must never take a pipeline down with it (LAW 38).
+#
+# New founder-facing workflows: add their `name:` to the list below. workflow_run takes
+# explicit names, not wildcards; a name not listed here fails silently, which is the
+# defect this comment exists to prevent.
+name: notify-failure
+
+on:
+  workflow_run:
+    workflows:
+      - ci
+      - fast-gate
+      - build-multiarch
+      - deploy-when-green
+      - catalog-render
+      - oke-check
+    types: [completed]
+
+permissions:
+  actions: read
+
+concurrency:
+  group: notify-failure-${{ github.event.workflow_run.id }}
+  cancel-in-progress: false
+
+jobs:
+  tell:
+    if: ${{ github.event.workflow_run.conclusion == 'failure' || github.event.workflow_run.conclusion == 'timed_out' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 2
+    steps:
+      - name: send one Telegram message
+        env:
+          TOKEN: ${{ secrets.SEED_TELEGRAM_ALERTS_BOT_TOKEN }}
+          CHAT_ID: ${{ secrets.TELEGRAM_MUMU_CHAT_ID || secrets.SEED_TELEGRAM_ALERTS_CHAT_ID }}
+          WF: ${{ github.event.workflow_run.name }}
+          BRANCH: ${{ github.event.workflow_run.head_branch }}
+          CONCLUSION: ${{ github.event.workflow_run.conclusion }}
+          URL: ${{ github.event.workflow_run.html_url }}
+        run: |
+          set -euo pipefail
+          if [ -z "${TOKEN:-}" ] || [ -z "${CHAT_ID:-}" ]; then
+            echo "BLIND notify-failure: telegram secrets unset; the red run is $URL"
+            exit 0
+          fi
+          text=$(printf 'CI red: %s on %s (%s)\n%s' "$WF" "$BRANCH" "$CONCLUSION" "$URL")
+          curl -fsS -X POST "https://api.telegram.org/bot${TOKEN}/sendMessage" \
+            --data-urlencode "chat_id=${CHAT_ID}" \
+            --data-urlencode "text=${text}" \
+            --data-urlencode "disable_web_page_preview=true" >/dev/null
+          echo "ok    notify-failure  founder told: $WF on $BRANCH is $CONCLUSION"
