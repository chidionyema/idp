+<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<!--
+  com.idp.spire-agent.plist — the SPIRE agent runs as a user LaunchDaemon under
+  the founder's uid. The agent's only job on this Mac is to:
+
+    * attest against the SPIRE control plane over tailnet (100.74.93.65:8443),
+    * mint X.509-SVIDs + JWT-SVIDs over the Workload API Unix socket,
+    * expose health endpoints on localhost:8080 (/live, /ready).
+
+  install path : infra/macos/LaunchDaemons/com.idp.spire-agent.plist
+  owner       : the founder (loaded by `idp-mac-provision install`)
+  never loaded by an agent session — per AGENTS.md SPIFFE primary rule 3, the
+  agent never runs `launchctl load` for the user. `idp-mac-provision install`
+  is the one place this plist is loaded; that script is the orchestrator, not
+  the agent.
+
+  trust model : - keepalive + ProcessType=Interactive drives launchd to keep
+                  this running between reboots without root ownership.
+                - StandardOutPath/StandardErrorPath go to ~/Library/Logs,
+                  one file each, that the bootstrap's verify rung tails.
+                - SPIRE agent reads agent.conf from /etc/spire/agent.conf,
+                  which `idp-mac-provision install` writes from a template
+                  in infra/macos/spire-agent.conf.template. The template's
+                  only secrets are the SPIRE trust bundle URL and the join
+                  token, both of which `idp-mac-provision install` fetches
+                  from the estate vault via the JIT broker.
+-->
+<plist version="1.0">
+<dict>
+    <key>Label</key>
+    <string>com.idp.spire-agent</string>
+
+    <key>ProgramArguments</key>
+    <array>
+        <string>/opt/homebrew/bin/spire-agent</string>
+        <string>run</string>
+        <string>-config</string>
+        <string>/etc/spire/agent.conf</string>
+        <string>-expandEnv</string>
+        <string>-logLevel</string>
+        <string>INFO</string>
+    </array>
+
+<key>EnvironmentVariables</key>
+    <dict>
+        <key>ESTATE_ZONE</key>
+        <string>mumchimp.com</string>
+        <key>SPIRE_SERVER_ADDRESS</key>
+        <string>spire-server.jit.svc.cluster.local</string>
+        <key>SPIRE_SERVER_PORT</key>
+        <string>8443</string>
+    </dict>
+
+
+    <key>RunAtLoad</key>
+    <true/>
+
+    <key>KeepAlive</key>
+    <dict>
+        <key>SuccessfulExit</key>
+        <false/>
+        <key>Crashed</key>
+        <true/>
+    </dict>
+
+    <key>ProcessType</key>
+    <string>Interactive</string>
+
+    <key>ThrottleInterval</key>
+    <integer>10</integer>
+
+    <key>StandardOutPath</key>
+    <string>/Users/Shared/Logs/com.idp.spire-agent.out.log</string>
+
+    <key>StandardErrorPath</key>
+    <string>/Users/Shared/Logs/com.idp.spire-agent.err.log</string>
+
+    <key>SoftResourceLimits</key>
+    <dict>
+        <key>NumberOfFiles</key>
+        <integer>65536</integer>
+    </dict>
+</dict>
+</plist>
diff --git a/infra/macos/spire-agent.conf.template b/infra/macos/spire-agent.conf.template
new file mode 100644
index 000000000..65fc7c50b
--- /dev/null
+++ b/infra/macos/spire-agent.conf.template
@@ -0,0 +1,73 @@
+# infra/macos/spire-agent.conf.template
+#
+# This is the SPIRE agent configuration template that `bin/idp-mac-provision
+# install` renders into /etc/spire/agent.conf on every founder Mac. The
+# template uses ${VAR} substitution; the rendered file MUST be readable
+# only by the agent's user uid because the trust bundle URL + join token are
+# the only secrets in it.
+#
+# The rendered config is owned by `_idp_executor` only when the launchd
+# daemon form is used (root LaunchDaemon). On the founder's Mac the agent
+# runs under the founder's uid, so the rendered file is owned by the
+# founder and chmod 600'd by `idp-mac-provision install`.
+#
+# Why a template and not a checked-in agent.conf:
+#
+#   The join token must NOT be checked into the repo (it is per-machine
+#   and per-trust-domain-federation; rotating it would invalidate every
+#   enrolled agent simultaneously). The trust bundle URL is environment-
+#   specific (Estate Zone). The cert URI is per-trust-domain. Templating
+#   is the only sane way to ship a checked-in config that doesn't leak
+#   secrets or bind the wrong environment.
+
+agent {
+    trust_domain = "${SPIRE_TRUST_DOMAIN}"            # estate.internal
+    server_address = "${SPIRE_SERVER_ADDRESS}"        # tailnet host: spire-server.jit.svc.cluster.local
+    server_port = "${SPIRE_SERVER_PORT}"              # 8443 over tailnet
+    socket_path = "/tmp/spire-agent/public/api.sock"   # the Workload API socket (default per spire-agent config reference)
+    admin_socket_path = "/tmp/spire-agent/private/admin.sock"
+    data_dir = "${SPIRE_DATA_DIR}"                    # ~/.spire/agent.data on the founder Mac
+    log_level = "INFO"
+    log_format = "text"
+    trust_bundle_path = "${SPIRE_TRUST_BUNDLE_PATH}"  # ~/.spire/initial-bundle.crt, written by idp-mac-provision
+    # SVID cache settings sized for one founder laptop — the defaults are
+    # tuned for cluster nodes carrying thousands of workload identities.
+    x509_svid_cache_max_size = 16
+    jwt_svid_cache_max_size = 32
+    # Health endpoint so the gateway (or any external monitor) can probe
+    # the agent without going through the Workload API.
+    health_checks {
+        listener_enabled = true
+        bind_address = "127.0.0.1"
+        bind_port = "8080"
+        live_path = "/live"
+        ready_path = "/ready"
+    }
+}
+
+plugins {
+    # NodeAttestor: a Tailscale node-key attestor reads the node's tailscaled
+    # state file (/var/lib/tailscale/node-key or its macOS equivalent) and
+    # proves the node to the cluster SPIRE server without a human-supplied
+    # join token. The custom plugin lives in its own repo; the binary the
+    # Brewfile installs is named `spire-tailscale-nodeattestor` and lands
+    # in /opt/homebrew/bin.
+    NodeAttestor "tailscale" {
+        plugin_cmd = "/opt/homebrew/bin/spire-tailscale-nodeattestor"
+        plugin_data {
+            tailscaled_socket = "/var/run/tailscale/tailscaled.sock"
+        }
+    }
+    # WorkloadAttestor: unix selectors. The Workload API authenticates
+    # callers by OS-level socket peer credentials (UID, PID, GID); every
+    # SPIFFE-issued SVID carries the unix:uid and unix:gid selectors that
+    # match the calling process. There is no human in this loop.
+    WorkloadAttestor "unix" {
+        plugin_data {}
+    }
+    KeyManager "disk" {
+        plugin_data {
+            directory = "${SPIRE_DATA_DIR}"
+        }
+    }
+}
