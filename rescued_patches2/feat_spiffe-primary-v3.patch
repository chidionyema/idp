+#!/usr/bin/env python3
+"""The end-to-end composition. One demo that proves the architecture works.
+
+Drives every layer in-process so it runs without the daemon being live:
+  - CRDT shadow memory (Phase B)
+  - Math sieve with reverifier (Phase C)
+  - Judge loop scoring transcripts (Phase C)
+  - RedTeam loop defeating payloads (Phase C)
+  - Typed work tuples with role gates (Phase D)
+  - Sandbox dispatcher (Phase H)
+  - Glass-box trace ledger + metrics (Phase I)
+
+Usage:
+    bin/idp-demo-compose              # default run
+    bin/idp-demo-compose --keep       # leave state on disk for inspection
+    bin/idp-demo-compose --json       # machine-readable output
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import sys
+import tempfile
+from pathlib import Path
+
+REPO = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO / "platform" / "executor"))
+sys.path.insert(0, str(REPO / "sovereign"))
+
+import daemon as _daemon  # noqa: E402
+import sandbox as _sandbox  # noqa: E402
+
+
+def _step(name: str, ok: bool, detail: str = "") -> dict:
+    return {"step": name, "ok": ok, "detail": detail}
+
+
+def _with_temp_runs() -> tuple[Path, callable]:
+    runs = Path(tempfile.mkdtemp(prefix="idp-compose-"))
+    os.environ["IDP_EXECUTOR_RUNS"] = str(runs)
+    return runs, lambda: shutil.rmtree(runs, ignore_errors=True)
+
+
+def _reset_daemon_state() -> None:
+    """Reset all module-level state so a re-run is deterministic."""
+    with _daemon._REPLICAS_LOCK:
+        _daemon._REPLICAS.clear()
+    with _daemon._TUPLES_LOCK:
+        _daemon._TUPLES.clear()
+    _daemon._VERIFIER_STATS.update({"folded": 0, "passed": 0, "failed": 0, "errors": 0})
+    _daemon._JUDGE_STATS.update({"scored": 0, "errors": 0})
+    _daemon._REDTEAM_STATS.update({"defeated": 0, "errors": 0})
+    with _daemon._VERIFIER_SEEN_LOCK:
+        _daemon._VERIFIER_SEEN_KEYS.clear()
+    with _daemon._JUDGE_LOCK:
+        _daemon._JUDGE_SEEN.clear()
+    with _daemon._REDTEAM_LOCK:
+        _daemon._REDTEAM_SEEN.clear()
+    _daemon._TRACE_BUFFER.clear()
+    _daemon._TRACE_LAST_HASH = ""
+
+
+def compose() -> dict:
+    steps = []
+
+    runs, _cleanup = _with_temp_runs()
+    _reset_daemon_state()
+
+    replica = "compose-worker-1"
+    target_file = runs / "auth.py"
+    target_file.write_text(
+        "def login(u, p):\n    return u == 'admin' and p == 'secret'\n"
+    )
+
+    steps.append(
+        _step(
+            "setup",
+            True,
+            f"runs={runs}, replica={replica}, sandbox={_sandbox.detect_backend()}",
+        )
+    )
+
+    sample_content = (
+        "def login(username, password):\n"
+        "    if not username or not password:\n"
+        "        return False\n"
+        "    return username == 'admin' and password == 'secret'\n"
+    )
+
+    steps.append(
+        _step("put_triplet(code)", True, f"queued code mutation for {target_file}")
+    )
+
+    sm = _daemon._get_or_load_replica(replica)
+    sm.add(
+        action=f"code::{target_file}",
+        result=sample_content,
+        takeaway="login refactor",
+        symbol="code",
+    )
+    _daemon._persist_triplet(
+        replica, f"code::{target_file}", sample_content, "login refactor", "code"
+    )
+
+    steps.append(
+        _step(
+            "math_sieve_fold",
+            True,
+            f"backend={_sandbox.detect_backend()}, gauntlet ran",
+        )
+    )
+
+    _daemon._verifier_fold_one(
+        replica_id=replica,
+        action=f"code::{target_file}",
+        result=sample_content,
+        takeaway="login refactor",
+        symbol="code",
+    )
+
+    passed = _daemon._get_or_load_replica("verifier").top_k(symbol="verifier_pass", k=8)
+    failed = _daemon._get_or_load_replica("verifier").top_k(symbol="verifier_fail", k=8)
+    steps.append(
+        _step(
+            "verifier_wrote_verdict",
+            bool(passed or failed),
+            f"verifier_pass={len(passed)}, verifier_fail={len(failed)}",
+        )
+    )
+
+    _daemon._get_or_load_replica("transcript").add(
+        action="transcript::login_refactor",
+        result="tool_call tool_call",
+        takeaway="worker transcript",
+        symbol="transcript",
+    )
+    _daemon._persist_triplet(
+        "transcript",
+        "transcript::login_refactor",
+        "tool_call tool_call",
+        "worker transcript",
+        "transcript",
+    )
+    judge = _daemon.Handler.__new__(_daemon.Handler)._judge_score(
+        {"replica_id": "transcript"}
+    )
+    steps.append(
+        _step(
+            "judge_scored_transcript",
+            judge.get("ok") and judge.get("scored", 0) > 0,
+            f"scored={judge.get('scored')}",
+        )
+    )
+
+    redteam = _daemon.Handler.__new__(_daemon.Handler)._redteam_defeat(
+        {"replica_id": replica}
+    )
+    steps.append(
+        _step(
+            "redteam_defeated_payloads",
+            redteam.get("ok"),
+            f"defeated={redteam.get('defeated')}",
+        )
+    )
+
+    put_resp = _daemon.put_tuple("test", {"path": "test_login.py"}, role="qa")
+    steps.append(
+        _step(
+            "put_tuple(test, qa)",
+            put_resp.get("ok"),
+            f"tuple_id={put_resp.get('tuple_id')}",
+        )
+    )
+
+    take_resp = _daemon.take_tuple("test", role="engine")
+    steps.append(
+        _step(
+            "take_tuple(test, engine)",
+            take_resp.get("ok") and take_resp.get("tuple") is not None,
+            f"tuple_id={take_resp.get('tuple', {}).get('tuple_id')}",
+        )
+    )
+
+    take_blocked = _daemon.take_tuple("test", role="coder")
+    steps.append(
+        _step(
+            "role_gate_blocks_coder_from_test",
+            not take_blocked.get("ok"),
+            take_blocked.get("error", ""),
+        )
+    )
+
+    sandbox_status = _sandbox.status()
+    sandbox_test = _sandbox.run_in_sandbox(
+        ["python3", "-c", "print('sandbox says: ' + __import__('sys').platform)"],
+        str(runs),
+        timeout_sec=10,
+    )
+    steps.append(
+        _step(
+            "sandbox_dispatch",
+            sandbox_test[0] == 0,
+            f"backend={sandbox_status['backend']}, exit={sandbox_test[0]}",
+        )
+    )
+
+    _daemon._trace_event("compose_end", {"replica_id": replica}, {"ok": True})
+
+    trace = _daemon._trace_tail(20)
+    metrics = _daemon.Handler.__new__(_daemon.Handler)._metrics({})
+    status = _daemon.Handler.__new__(_daemon.Handler)._system_status({})
+
+    overall = all(s["ok"] for s in steps)
+
+    return {
+        "ok": overall,
+        "sandbox": sandbox_status,
+        "steps": steps,
+        "metrics": metrics.get("metrics", {}),
+        "trace_tail": trace,
+        "system_status": {
+            "sandbox": status.get("sandbox", {}).get("backend"),
+            "verifier_passed": status.get("verifier", {})
+            .get("stats", {})
+            .get("passed"),
+            "verifier_failed": status.get("verifier", {})
+            .get("stats", {})
+            .get("failed"),
+            "judge_scored": status.get("judge", {}).get("stats", {}).get("scored"),
+            "redteam_defeated": status.get("redteam", {})
+            .get("stats", {})
+            .get("defeated"),
+            "replica_count": status.get("shadow", {}).get("replica_count"),
+            "total_triplets": status.get("shadow", {}).get("total_triplets"),
+        },
+    }
+
+
+def main() -> int:
+    as_json = "--json" in sys.argv
+    keep = "--keep" in sys.argv
+    result = compose()
+    if as_json:
+        print(json.dumps(result, indent=2, default=str))
+    else:
+        print("=== End-to-end composition ===")
+        print(f"overall: {'PASS' if result['ok'] else 'FAIL'}")
+        print(f"sandbox backend: {result['sandbox']['backend']}")
+        print()
+        for s in result["steps"]:
+            mark = "OK  " if s["ok"] else "FAIL"
+            print(f"[{mark}] {s['step']:<35}  {s['detail']}")
+        print()
+        print("=== System status ===")
+        for k, v in result["system_status"].items():
+            print(f"  {k}: {v}")
+        print()
+        print("=== Metrics ===")
+        for k, v in result["metrics"].items():
+            print(f"  {k}: {v}")
+        print()
+        print(f"=== Trace tail (last {len(result['trace_tail'])} events) ===")
+        for e in result["trace_tail"]:
+            ts = e.get("ts", 0)
+            verb = e.get("verb", "?")
+            ok = e.get("ok", False)
+            h = e.get("hash", "")
+            print(f"  {ts}  {'OK ' if ok else 'ERR'}  {verb}  hash={h}")
+    if not keep:
+        runs = Path(os.environ.get("IDP_EXECUTOR_RUNS", ""))
+        if runs.exists():
+            shutil.rmtree(runs, ignore_errors=True)
+    return 0 if result["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
