diff --git a/platform/otto-gateway/deployment.yaml b/platform/otto-gateway/deployment.yaml
index da5f94953..c476e88f8 100644
--- a/platform/otto-gateway/deployment.yaml
+++ b/platform/otto-gateway/deployment.yaml
@@ -141,8 +141,16 @@ spec:
             # Claude capacity here is the Pro Max subscription reached through `claude -p`.
             # Leaving the default in place is what routed every message to needs_human.
             - { name: OTTO_ROUTER_LANE_JUDGMENT_MODEL, value: "minimax" }
-            - { name: OTTO_ROUTER_LANE_BULK_MODEL, value: "fast" }
-            - { name: OTTO_ROUTER_LANE_VERIFY_MODEL, value: "gemini" }
+            # `kimi` and `minimax` are the only two models the estate router actually serves:
+            # `GET /model/info` with this pod's own key returns exactly those two, measured from
+            # inside this pod on 2026-09-05. `fast` and `gemini` are rows in llm/config.yaml that
+            # are not in the running router, and `fast` is in no family mapping either, so
+            # otto/router/config.py refused the whole configuration on every inbound message:
+            # "policy defect: model 'fast' is in no family mapping". That refusal is why Otto
+            # answered nothing. Bulk and verify may share a family; only judgment must differ
+            # from each of them, and judgment is minimax.
+            - { name: OTTO_ROUTER_LANE_BULK_MODEL, value: "kimi" }
+            - { name: OTTO_ROUTER_LANE_VERIFY_MODEL, value: "kimi" }
             - { name: PYTHONUNBUFFERED, value: "1" }
           ports:
             - { containerPort: 8080, name: http }
diff --git a/platform/otto-golden/deployment.yaml b/platform/otto-golden/deployment.yaml
index a868c4217..dc3b90d0e 100644
--- a/platform/otto-golden/deployment.yaml
+++ b/platform/otto-golden/deployment.yaml
@@ -121,11 +121,12 @@ spec:
             # as webhook.pipeline_error and answered nothing. Measured from inside the pod
             # on 2026-09-04 against image main-68-ce246e2. Bulk is not on the Telegram path
             # (default_lane is judgment), so it is the lane that moves.
-            # gemini, not deepseek, since 2026-09-04: the deepseek lane answers 401 at the vendor
-            # and its row has left the rendered config, so bulk pointed at nothing. `fast` is a
-            # different model family from minimax, which is what the refusal above is about.
+            # kimi, not `fast`, since 2026-09-05: `fast` is a row in llm/config.yaml that the
+            # running router does not serve and that config.py's family map does not know, so it
+            # refused the whole configuration. kimi is served (measured with GET /model/info from
+            # inside the gateway pod) and its family is moonshot, distinct from minimax.
             - name: OTTO_ROUTER_LANE_BULK_MODEL
-              value: fast
+              value: kimi
             # The estate's memory (platform/hindsight), one bank for every surface, so a
             # person remembered from Telegram is remembered on the next channel too.
             # otto/memory/hindsight.py: unset is a no-op, unreachable never costs an answer.
