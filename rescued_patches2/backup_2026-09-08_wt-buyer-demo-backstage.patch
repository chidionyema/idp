+# Generated by bin/idp-ns-fence-gen from platform/ns-fences/allowances.yaml (crew#839).
+# Do not edit: the next run overwrites this file. Change the input and re-run.
+apiVersion: v1
+kind: LimitRange
+metadata:
+  name: ns-defaults
+  namespace: crossplane-system
+spec:
+  limits:
+  - type: Container
+    defaultRequest:
+      cpu: 25m
+      memory: 64Mi
+---
+apiVersion: v1
+kind: ResourceQuota
