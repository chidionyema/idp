@@ -0,0 +1,30 @@
+# This Secret holds no secret. Under Workload Identity the credentials blob is a two-key statement
+# of which authentication mode to use and where the tenancy is; the identity itself arrives from
+# the kubelet as a projected token the provider exchanges with OCI IAM. It is in git because it is
+# configuration, and bin/static-secret-gate is right to scan for the case where it is not: if this
+# file ever grows a private_key, a fingerprint or a user_ocid, the authentication mode has silently
+# changed back to API keys and the estate has a static credential on disk again.
+apiVersion: v1
+kind: Secret
+metadata:
+  name: oci-creds
+  namespace: crossplane-system
+type: Opaque
+stringData:
+  credentials: |
+    {
+      "auth": "OKEWorkloadIdentity",
+      "region": "${ESTATE_OCI_REGION}"
+    }
+---
+apiVersion: oci.upbound.io/v1beta1
+kind: ProviderConfig
+metadata:
+  name: default
+spec:
+  credentials:
+    source: Secret
+    secretRef:
+      name: oci-creds
+      namespace: crossplane-system
+      key: credentials
diff --git a/platform/crossplane/providers/providers.yaml b/platform/crossplane/providers/providers.yaml
new file mode 100644
index 000000000..102363ebd
--- /dev/null
+++ b/platform/crossplane/providers/providers.yaml
@@ -0,0 +1,30 @@
+# The family provider is first and the order is not cosmetic. Oracle's own quickstart: "Always
+# install the family provider first ... Installing sub-provider first creates a missing dependency
+# issue, which the crossplane package-manager always resolves by pulling latest family provider
+# image" -- which is to say, install them the other way round and the pinned version in this file
+# stops being the version that runs. Flux applies a Kustomization's objects in one pass, so the
+# ordering that matters is dependency ordering, and the family provider is what the sub-provider
+# depends on. The name oracle-provider-family-oci is required, not chosen: crossplane resolves the
+# package image from (organization)-(provider-name).
+apiVersion: pkg.crossplane.io/v1
+kind: Provider
+metadata:
+  name: oracle-provider-family-oci
+spec:
+  package: ghcr.io/oracle/provider-family-oci:v1.3.0
+  runtimeConfigRef:
+    name: oci-workload-identity
+---
+# One sub-provider, deliberately. A Crossplane provider installs the CRDs for everything it can
+# manage, and the OCI family covers most of the console; installing the ones nothing asks for
+# would put hundreds of unused CRDs in the API server and widen what a compromised control plane
+# could reach. Object storage is what decision 0026's step 3 emits, so object storage is what is
+# installed. The next capability adds the next sub-provider, in the pull request that needs it.
+apiVersion: pkg.crossplane.io/v1
+kind: Provider
+metadata:
+  name: provider-oci-objectstorage
+spec:
+  package: ghcr.io/oracle/provider-oci-objectstorage:v1.3.0
+  runtimeConfigRef:
+    name: oci-workload-identity
diff --git a/platform/crossplane/providers/runtime.yaml b/platform/crossplane/providers/runtime.yaml
new file mode 100644
index 000000000..39cb670a5
--- /dev/null
+++ b/platform/crossplane/providers/runtime.yaml
@@ -0,0 +1,46 @@
+# How the provider proves who it is, and the reason nothing here is a credential.
+#
+# OKE Workload Identity: the pod presents its own service account to OCI IAM, and an IAM policy
+# names that exact cluster, namespace and service account as the thing allowed to act. There is no
+# key to mint, none to store, none to rotate, and none that keeps working if it leaks -- a token
+# minted this way is worthless off this cluster. That is R52 read literally: one root per provider,
+# set once, and code mints the rest.
+#
+# serviceAccountTemplate is the load-bearing line. Crossplane names a provider's service account
+# after the package by default, with a hash, and an IAM policy cannot match a name that changes.
+# Pinning it makes the policy in platform/oci/crossplane.tf a statement about a name that will
+# still be true after the next package upgrade.
+apiVersion: pkg.crossplane.io/v1beta1
+kind: DeploymentRuntimeConfig
+metadata:
+  name: oci-workload-identity
+spec:
+  serviceAccountTemplate:
+    metadata:
+      name: crossplane-provider-oci
+  deploymentTemplate:
+    spec:
+      selector: {}
+      template:
+        spec:
+          # The provider pods land in the same restricted namespace as the core chart. Crossplane
+          # gives a provider deployment a sane default securityContext, but not a seccomp profile,
+          # and a default the upstream can change is not a fence -- so it is stated here.
+          securityContext:
+            runAsNonRoot: true
+            runAsUser: 65532
+            runAsGroup: 65532
+            seccompProfile: { type: RuntimeDefault }
+          containers:
+            - name: package-runtime
+              securityContext:
+                allowPrivilegeEscalation: false
+                readOnlyRootFilesystem: true
+                capabilities: { drop: [ALL] }
+              env:
+                - { name: OCI_RESOURCE_PRINCIPAL_VERSION, value: "2.2" }
+                - { name: OCI_RESOURCE_PRINCIPAL_REGION, value: "${ESTATE_OCI_REGION}" }
+                - { name: OCI_RESOURCE_PRINCIPAL_WORKLOAD_IDENTITY, value: "1" }
+              resources:
+                requests: { cpu: 50m, memory: 128Mi }
+                limits: { cpu: 500m, memory: 512Mi }
