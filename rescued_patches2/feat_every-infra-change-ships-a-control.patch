+# A command can exit 0 having measured nothing. A pytest run whose tests all skip -- no conftest,
+# no kyverno, no cluster credential -- exits 0, and until 2026-08-31 this file read that as `ok`:
+# on PR #1042 the gate test for `control_shipped` reported "ok ... 9 skipped in 0.11s" and had
+# judged not one thing. That is the estate's silent-green class (4 on the ledger), and it is worse
+# than a red because it is quiet. A claim that measured nothing is BLIND, and BLIND is never green.
+BLIND_RUN = re.compile(r"^\s*(?:\d+ skipped|no tests ran)", re.M)
+
+
+def measured_nothing(r: dict) -> bool:
+    if r["exit"] != 0:
+        return False
+    out = r.get("out") or ""
+    if re.search(r"\b\d+ (?:passed|failed)\b", out):
+        return False
+    return bool(BLIND_RUN.search(out))
+
+
