-                continue
-            if t.split("/")[0] in SIBLINGS:
-                continue                              # another repo; not checked out here
-            if _escapes(t):
-                dead.setdefault(doc, []).append(t)    # see _OUTSIDE
-                continue
-            if (ROOT / t).exists() or (p.parent / t).exists():
-                continue
-            if _is_generated(t):
-                continue
-            dead.setdefault(doc, []).append(t)
-    return dead
