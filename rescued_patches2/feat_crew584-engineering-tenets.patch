 }
-
-# crew#503: Langfuse sits behind the front door (ForwardAuth) but ran its own email+password
-# sign-in behind it, so the "one login" was two. This app lets Langfuse's built-in OIDC client
-# (AUTH_CUSTOM_*) sign the founder in through the same identity domain; with the IDCS session
-# already open from the front door the second hop is a silent redirect, never a second form.
-resource "oci_identity_domains_app" "langfuse" {
-  idcs_endpoint = var.idcs_endpoint
-  schemas       = ["urn:ietf:params:scim:schemas:oracle:idcs:App"]
-  display_name  = "estate-langfuse"
-  description   = "Langfuse at langfuse.${var.zone}; managed by platform/oci/identity, never by hand"
-  based_on_template {
-    value = "CustomWebAppTemplateId"
-  }
-  active                    = true
-  is_oauth_client           = true
-  client_type               = "confidential"
-  allowed_grants            = ["authorization_code"]
-  bypass_consent            = true
-  redirect_uris             = ["https://langfuse.${var.zone}/api/auth/callback/custom"]
-  post_logout_redirect_uris = ["https://langfuse.${var.zone}/"]
-  show_in_my_apps           = false
-  attribute_sets            = ["all"]
-  lifecycle {
-    ignore_changes = [schemas]
-  }
-}
-
-resource "oci_identity_domains_grant" "langfuse_founder" {
-  for_each        = data.oci_identity_domains_users.founder
-  idcs_endpoint   = var.idcs_endpoint
-  schemas         = ["urn:ietf:params:scim:schemas:oracle:idcs:Grant"]
-  grant_mechanism = "ADMINISTRATOR_TO_USER"
-  grantee {
-    type  = "User"
-    value = one(each.value.users).id
-  }
-  app {
-    value = oci_identity_domains_app.langfuse.id
-  }
-}
-
-resource "oci_vault_secret" "langfuse_sso_client_id" {
-  compartment_id = var.compartment_ocid
-  vault_id       = var.vault_ocid
-  key_id         = var.key_ocid
-  secret_name    = "langfuse-sso-client-id"
-  secret_content {
-    content_type = "BASE64"
-    content      = base64encode(oci_identity_domains_app.langfuse.name)
-  }
-}
-resource "oci_vault_secret" "langfuse_sso_client_secret" {
-  compartment_id = var.compartment_ocid
-  vault_id       = var.vault_ocid
-  key_id         = var.key_ocid
-  secret_name    = "langfuse-sso-client-secret"
-  secret_content {
-    content_type = "BASE64"
-    content      = base64encode(oci_identity_domains_app.langfuse.client_secret)
-  }
-}
-
-# The login drill walks the second hop too (bin/idp-login-drill, crew#503): its user needs the
-# same grant the founder has or IDCS stops it at "not assigned", which reads like a second form.
-resource "oci_identity_domains_grant" "langfuse_drill" {
-  idcs_endpoint   = var.idcs_endpoint
-  schemas         = ["urn:ietf:params:scim:schemas:oracle:idcs:Grant"]
-  grant_mechanism = "ADMINISTRATOR_TO_USER"
-  grantee {
-    type  = "User"
-    value = oci_identity_domains_user.drill.id
-  }
-  app {
-    value = oci_identity_domains_app.langfuse.id
-  }
-}
-
-output "langfuse_client_id" {
-  value = oci_identity_domains_app.langfuse.name
-}
