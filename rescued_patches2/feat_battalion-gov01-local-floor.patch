diff --git a/platform/llm/ollama.yaml b/platform/llm/ollama.yaml
new file mode 100644
index 000000000..2c0706810
--- /dev/null
+++ b/platform/llm/ollama.yaml
@@ -0,0 +1,125 @@
+# The free local lane Pillar 1 of the founder's routing sketch calls for: a tiny
+# quantized model that absorbs deterministic, high-volume calls (formatting, tool-call
+# routing, classification) at zero marginal cost, so those calls stop paying groq/minimax
+# rates. Until now `llm/config.yaml`'s three ollama/* entries pointed at
+# http://host.docker.internal:11434 -- the founder's own Mac, which he killed on
+# 2026-09-10 ("no i killed ollama because machine is slow", platform/otto-gateway/
+# three-homes.yaml:28-29). Every call routed there has been silently falling through
+# the fallback chain to a paid model since. This runs the same free floor in-cluster,
+# on the always-free Ampere pool, instead of a laptop that can be turned off.
+#
+# Model is 1.5B, not the 7B llm/config.yaml names, because the whole always-free A1
+# allowance is 2 OCPU / 12 GB (docs/reference/oci-tenancy.md:18), shared with litellm
+# (2 replicas), redis, postgres, temporal-worker, langfuse and signoz already running
+# in this cluster -- there is no room for a 7B model's working set here. 1.5B is the
+# size Pillar 1 itself named ("Qwen-2.5-Coder 1.5B") for exactly this gatekeeper role.
+apiVersion: v1
+kind: PersistentVolumeClaim
+metadata:
+  name: ollama-models
+  namespace: llm
+spec:
+  accessModes: [ReadWriteOnce]
+  resources: {requests: {storage: 5Gi}}
+---
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: ollama
+  namespace: llm
+  labels: { app.kubernetes.io/name: ollama, app.kubernetes.io/part-of: idp }
+spec:
+  replicas: 1   # local free floor, not a load-bearing tier -- a fallback chain behind it
+                # already exists in llm/config.yaml if this pod is down
+  strategy: { type: Recreate }   # the PVC is ReadWriteOnce; a rolling second pod can't mount it
+  selector:
+    matchLabels: { app.kubernetes.io/name: ollama }
+  template:
+    metadata:
+      labels: { app.kubernetes.io/name: ollama, app.kubernetes.io/part-of: idp }
+    spec:
+      automountServiceAccountToken: false
+      securityContext:
+        runAsNonRoot: true
+        runAsUser: 10001
+        runAsGroup: 10001
+        fsGroup: 10001
+        seccompProfile: { type: RuntimeDefault }
+      initContainers:
+        # ollama has no "pull on deploy" step of its own; a pod that only ran `ollama
+        # serve` would lazy-pull the model on the FIRST real request, off the litellm
+        # 300s timeout budget, unpredictably. Pull once here so the pod is only Ready
+        # once the model is actually on disk.
+        - name: pull-model
+          image: docker.io/ollama/ollama:0.3.14
+          command: ["/bin/sh", "-c"]
+          args:
+            - |
+              set -eu
+              ollama serve &
+              pid=$!
+              for i in $(seq 1 60); do
+                wget -q -O- http://127.0.0.1:11434/ >/dev/null 2>&1 && break
+                sleep 1
+              done
+              ollama pull qwen2.5-coder:1.5b
+              kill "$pid"
+          env:
+            - { name: HOME, value: /tmp }
+            - { name: OLLAMA_MODELS, value: /models }
+          volumeMounts:
+            - { name: models, mountPath: /models }
+            - { name: tmp, mountPath: /tmp }
+          resources:
+            requests: { cpu: 250m, memory: 512Mi }
+            limits: { cpu: 1500m, memory: 2Gi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+      containers:
+        - name: ollama
+          image: docker.io/ollama/ollama:0.3.14
+          ports:
+            - { name: http, containerPort: 11434 }
+          env:
+            - { name: HOME, value: /tmp }
+            - { name: OLLAMA_MODELS, value: /models }
+            - { name: OLLAMA_KEEP_ALIVE, value: 24h }   # crew#284 CP2: cold load measured 30.8s, warm 16.9s
+            - { name: OTEL_EXPORTER_OTLP_ENDPOINT, value: "http://signoz-otel-collector.observability.svc:4318" }
+          volumeMounts:
+            - { name: models, mountPath: /models }
+            - { name: tmp, mountPath: /tmp }
+          resources:
+            # 1.5B q4 weights are ~1GB resident; 2Gi limit leaves headroom for context.
+            requests: { cpu: 200m, memory: 768Mi }
+            limits: { cpu: 1500m, memory: 2Gi }
+          securityContext:
+            allowPrivilegeEscalation: false
+            readOnlyRootFilesystem: true
+            capabilities: { drop: [ALL] }
+          readinessProbe:
+            httpGet: { path: /, port: http }
+            periodSeconds: 10
+            failureThreshold: 3
+          livenessProbe:
+            httpGet: { path: /, port: http }
+            periodSeconds: 30
+            timeoutSeconds: 5
+            failureThreshold: 3
+      volumes:
+        - name: models
+          persistentVolumeClaim: { claimName: ollama-models }
+        - name: tmp
+          emptyDir: { sizeLimit: 256Mi }
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: ollama
+  namespace: llm
+  labels: { app.kubernetes.io/name: ollama, backstage.io/kubernetes-id: founder-model-router }
+spec:
+  selector: { app.kubernetes.io/name: ollama }
+  ports:
+    - { name: http, port: 11434, targetPort: http }
diff --git a/platform/llm/routing-matrix.yaml b/platform/llm/routing-matrix.yaml
new file mode 100644
index 000000000..f4d5f9079
--- /dev/null
+++ b/platform/llm/routing-matrix.yaml
@@ -0,0 +1,87 @@
+# The routing matrix (idp#3525 CP3, ROUTE-02/ROUTE-05).
+#
+# "The working-method axes SHALL be independent config dimensions: resource tier (Rung 0-3) x
+# candidate volume N x selection method (gate | weighted-vote | multi-verifier) x escalation
+# pattern (route | cascade | hybrid). Changing any cell SHALL be a config edit only, and every
+# cell SHALL be individually enable/disable-able at runtime without a redeploy."
+#
+# sovereign/engine/routing_matrix.py reads this file and this file alone; a cell is a row below,
+# never a branch in that module. Adding, removing or disabling a cell is an edit here.
+#
+# resource_tier names a rung from platform/llm/cost-ladder.yaml (COST-03) by name, not by
+# duplicating its price -- one ladder, referenced, never a second one.
+#
+# filter_depth (ROUTE-05): semantic intent routing (LiteLLM semantic router / RouteLLM / vLLM
+# router) is a NAMED GAP (spec S3 section 4), not a built feature. It exists here ONLY as a
+# toggleable axis, default off, because misclassification ships a wrong answer on the cheap
+# path -- a real cost, not a free filter. No cell below turns it on.
+#
+# pillar2_execute_python / pillar3_grind_tool / pillar4_darwin_machines (idp#3525 CP7, CFG-01):
+# "Pillar 2/3/4 on/off once built" -- OFF-02, GRIND-01 and DARWIN-01 are each still a NAMED GAP
+# (CP5 evidence), so these three axes exist ONLY as toggles, default off, for the day one of
+# them is built. Flipping one to true without the underlying capability existing is a config
+# error this file cannot itself catch -- routing_matrix.validate_schema() only enforces the
+# toggle's presence and its off-by-default floor, same discipline as filter_depth above.
+#
+# This file is CFG-01's "ONE config document": every axis this spec names -- resource tier,
+# candidate volume, selection method, escalation pattern, filter_depth, and the three pillar
+# gaps -- is a field here, nowhere else. sovereign/engine/config_schema_check.py checks this
+# file's axis keys against CFG-01's own sentence in the spec, so the two cannot drift apart
+# silently (CFG-02).
+version: 2
+
+axes:
+  resource_tier:
+    - rung0_local_free
+    - rung1_router_metered
+    - rung2_flat_rate_apple_silicon
+    - rung3_gpu_burst
+  candidate_volume: [1, 3, 5]
+  selection_method: [gate, weighted_vote, multi_verifier]
+  escalation_pattern: [route, cascade, hybrid]
+  filter_depth:
+    enabled: false
+    values: [off, shallow, deep]
+    gap: "ROUTE-05 named gap, spec S3 section 4: semantic intent routing. Not built; this is the toggle."
+  pillar2_execute_python:
+    enabled: false
+    gap: "OFF-02 named gap, idp#3525 CP5: execute_python CPU sandbox. Not built; this is the toggle for once it is (CFG-01)."
+  pillar3_grind_tool:
+    enabled: false
+    gap: "GRIND-01 named gap, idp#3525 CP5: overnight grind worker CronJob. Not built; this is the toggle for once it is (CFG-01)."
+  pillar4_darwin_machines:
+    enabled: false
+    gap: "DARWIN-01 named gap, idp#3525 CP5: Darwin Machines meta-optimizer. Not built; this is the toggle for once it is (CFG-01)."
+
+cells:
+  - config_id: baseline_gate
+    resource_tier: rung1_router_metered
+    candidate_volume: 1
+    selection_method: gate
+    escalation_pattern: route
+    filter_depth: off
+    enabled: true
+
+  - config_id: three_candidate_vote
+    resource_tier: rung1_router_metered
+    candidate_volume: 3
+    selection_method: weighted_vote
+    escalation_pattern: cascade
+    filter_depth: off
+    enabled: true
+
+  - config_id: five_candidate_verifier
+    resource_tier: rung2_flat_rate_apple_silicon
+    candidate_volume: 5
+    selection_method: multi_verifier
+    escalation_pattern: hybrid
+    filter_depth: off
+    enabled: true
+
+  - config_id: local_floor_only
+    resource_tier: rung0_local_free
+    candidate_volume: 1
+    selection_method: gate
+    escalation_pattern: route
+    filter_depth: off
+    enabled: true
