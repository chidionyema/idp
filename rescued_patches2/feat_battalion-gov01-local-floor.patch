+            "ErrorFromServer/NotFound"
+        ),
+    },
+}
+
+ECHO_INVERSE_ENVELOPE = {
+    "mutation_id": "ldg-mutdoor-echo",
+    "target": "deployment/mutdoor",
+    "forward": {
+        "action": "apply_manifest",
+        "parameters": {"path": "mutdoor_deploy.yaml", "replicas": 3},
+    },
+    "inverse_spec": {
