+            "  python3 -m venv /tmp/tkvenv && /tmp/tkvenv/bin/pip install tiktoken\n"
+            "  /tmp/tkvenv/bin/python bin/estate-efficiency-experiment.py",
+            file=sys.stderr,
+        )
