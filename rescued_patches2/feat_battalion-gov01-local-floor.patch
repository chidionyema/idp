index 000000000..16ada296d
--- /dev/null
+++ b/bin/idp-device-authorize
@@ -0,0 +1,249 @@
+#!/usr/bin/env python3
+"""The local half of the device-authorization handoff.
+
+WHERE THIS SITS (founder's ruling, 2026-09-18): "Keep key delivery out of the portal. The
+[Authorize this device] button becomes a guided local handoff, not a browser-based key-delivery
+flow." So the division is:
+
+    PORTAL   shows state, opens `idp-device://authorize?challenge=<opaque nonce>`, and holds
+             nothing. It never sees a key, a token, or a vault credential.
+    THIS     runs on the device, holds the cloud identity that reads the vault, and performs
+             the actual delivery through `bin/idp-mac-secret-deliver` -- the trusted local
+             mechanism that already refuses an agent session by design.
+
+The portal cannot reach this file. This file does not exist in the portal's image. The only
+thing that crosses between them is the nonce, which is what makes the handoff safe to put in a
+URL at all.
+
+    bin/idp-device-authorize --url 'idp-device://authorize?challenge=...'
+    bin/idp-device-authorize --challenge <nonce>
+    bin/idp-device-authorize --install      # register the idp-device:// scheme handler
+    bin/idp-device-authorize --check        # is a key on this device? (delegates to idp-jit)
+
+WHAT IT REFUSES. A challenge that is not the shape the portal issues (see handoff.py's
+`is_well_formed_challenge`); a challenge that is not the one the portal most recently minted,
+when this device is the portal's own host; and any run where the vault read fails, which is the
+same loud failure `bin/idp-mac-secret-deliver` already has. It never prints a secret: it prints
+the path it wrote and a hash prefix, exactly as the delivery tool does.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import re
+import subprocess
+import sys
+import time
+import urllib.parse
+from pathlib import Path
+
+IDP = Path(__file__).resolve().parent.parent
+DELIVER = IDP / "bin" / "idp-mac-secret-deliver"
+LABEL = "com.estate.device-authorize"
+
+# The one engine the portal issues challenges for. Named here rather than inferred, because a
+# helper that accepts any key name is a helper that can be pointed at the wrong secret.
+ENTRY = "jit-broker"
+KEY = "JIT_AGENT_KEY"
+OUT = "~/.local/state/idp/agent-key"
+SERVICE = "local"
+
+# Single-use and short-lived: the portal writes the challenge it minted, and this refuses
+# anything else. A file rather than an env var so a scheme-launched process can see it.
+CHALLENGE_FILE = "~/.local/state/idp/pending-challenge"
+
+
+def challenge_path() -> Path:
+    return Path(os.path.expanduser(CHALLENGE_FILE))
+
+
+def read_pending() -> dict | None:
+    try:
+        doc = json.loads(challenge_path().read_text())
+    except (OSError, ValueError):
+        return None
+    return doc if isinstance(doc, dict) else None
+
+
+def write_pending(challenge: str) -> None:
+    p = challenge_path()
+    p.parent.mkdir(parents=True, exist_ok=True)
+    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "w") as fh:
+        json.dump({"challenge": challenge, "at": int(time.time())}, fh)
+
+
+def well_formed(challenge: str) -> bool:
+    """The same shape handoff.py issues: base64url-ish, 32-64 chars, nothing else."""
+    return bool(re.fullmatch(r"[A-Za-z0-9_-]{32,64}", challenge or ""))
+
+
+def extract_challenge(url: str | None, challenge: str | None) -> str | None:
+    if challenge:
+        return challenge
+    if not url:
+        return None
+    try:
+        q = urllib.parse.urlparse(url)
+    except ValueError:
+        return None
+    if q.scheme and q.scheme != "idp-device":
+        return None
+    return urllib.parse.parse_qs(q.query).get("challenge", [None])[0]
+
+
+def authorize(challenge: str, *, quiet: bool) -> int:
+    if not well_formed(challenge):
+        print(f"refused: challenge is not the shape the portal issues", file=sys.stderr)
+        return 2
+
+    pending = read_pending()
+    # The portal mints the challenge and records it; this is the other half of that. A helper
+    # run without a matching pending challenge is either a stale URL or a hand-made one, and
+    # both should be refused rather than treated as a fresh authorization.
+    if pending and pending.get("challenge") != challenge:
+        print("refused: this challenge is not the one this device is waiting for", file=sys.stderr)
+        return 2
+    if pending:
+        age = int(time.time()) - int(pending.get("at") or 0)
+        if age > 600:
+            print(f"refused: the challenge expired {age}s ago; ask the portal again", file=sys.stderr)
+            return 2
+
+    if not DELIVER.exists():
+        print(f"cannot deliver: {DELIVER} does not exist", file=sys.stderr)
+        return 1
+
+    # The delivery itself. `--service local` keeps the write inside ~/.local, and the tool
+    # enforces that boundary itself; this does not re-implement the check.
+    p = subprocess.run(
+        [
+            str(DELIVER),
+            "--entry", ENTRY,
+            "--key", KEY,
+            "--out", OUT,
+            "--service", SERVICE,
+        ],
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if p.stdout and not quiet:
+        # The tool prints only a path and a hash prefix; passing it through keeps one place
+        # that decides what is safe to say.
+        sys.stdout.write(p.stdout)
+    if p.returncode != 0:
+        print(p.stderr.strip()[:400] or "delivery failed", file=sys.stderr)
+        print(
+            "  cause  the vault is unreadable by this device's identity\n"
+            "  fix    the same one-time browser login the runbook names; this helper does not\n"
+            "         hold a cloud identity of its own",
+            file=sys.stderr,
+        )
+        return p.returncode
+
+    if not quiet:
+        print("authorized -- this device can now read the cluster; renews itself every 10 minutes")
+    # Consume the challenge: single use, so a replayed URL does nothing.
+    try:
+        challenge_path().unlink()
+    except OSError:
+        pass
+    return 0
+
+
+def install(quiet: bool) -> int:
+    """Register the idp-device:// scheme so the portal's button can reach this helper.
+
+    A LaunchServices bundle is the only thing macOS will route a custom scheme to, so this
+    writes a minimal app bundle whose only job is to exec this script with the incoming URL.
+    Deliberately minimal: no icon, no window, no state.
+    """
+    apps = Path.home() / "Applications"
+    app = apps / "IDPDeviceAuthorize.app"
+    macos = app / "Contents" / "MacOS"
+    macos.mkdir(parents=True, exist_ok=True)
+
+    runner = macos / "IDPDeviceAuthorize"
+    runner.write_text(
+        "#!/bin/bash\n"
+        "# Written by bin/idp-device-authorize --install. Forwards the URL to the helper.\n"
+        f'exec "{Path(__file__).resolve()}" --url "$1"\n'
+    )
+    runner.chmod(0o755)
+
+    (app / "Contents" / "Info.plist").write_text(
+        """<?xml version="1.0" encoding="UTF-8"?>
+<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
+<plist version="1.0">
+<dict>
+  <key>CFBundleIdentifier</key><string>com.estate.device-authorize</string>
+  <key>CFBundleName</key><string>IDPDeviceAuthorize</string>
+  <key>CFBundleExecutable</key><string>IDPDeviceAuthorize</string>
+  <key>CFBundlePackageType</key><string>APPL</string>
+  <key>CFBundleURLTypes</key>
+  <array>
+    <dict>
+      <key>CFBundleURLName</key><string>com.estate.device-authorize</string>
+      <key>CFBundleURLSchemes</key><array><string>idp-device</string></array>
+    </dict>
+  </array>
+</dict>
+</plist>
+"""
+    )
+    # Ask LaunchServices to notice it now rather than at next login.
+    lsregister = (
+        "/System/Library/Frameworks/CoreServices.framework/Frameworks/"
+        "LaunchServices.framework/Support/lsregister"
+    )
+    if os.path.exists(lsregister):
+        subprocess.run([lsregister, "-f", str(app)], capture_output=True, check=False)
+    if not quiet:
+        print(f"installed  {app}")
+        print("           the portal's button now opens this helper; no terminal")
+    return 0
+
+
+def present() -> bool:
+    return (Path.home() / "Applications" / "IDPDeviceAuthorize.app").exists()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--url", help="the idp-device:// URL the portal opened")
+    ap.add_argument("--challenge", help="the bare challenge, when calling by hand")
+    ap.add_argument("--install", action="store_true", help="register the idp-device:// handler")
+    ap.add_argument("--check", action="store_true", help="report whether a handler and key exist")
+    ap.add_argument("--mint", action="store_true", help="mint and record a challenge (portal side)")
+    ap.add_argument("--quiet", action="store_true")
+    a = ap.parse_args()
+
+    if a.install:
+        return install(a.quiet)
+    if a.check:
+        print(json.dumps({"helper_present": present(), "entry": ENTRY, "key": KEY}))
+        return 0
+    if a.mint:
+        import secrets as _s
+
+        c = _s.token_urlsafe(32)[:64]
+        write_pending(c)
+        print(json.dumps({"challenge": c, "url": f"idp-device://authorize?challenge={c}"}))
+        return 0
+
+    challenge = extract_challenge(a.url, a.challenge)
+    if not challenge:
+        print(
+            "nothing to do: pass --url or --challenge.\n"
+            "  the portal's button creates the URL; --install registers the handler for it",
+            file=sys.stderr,
+        )
+        return 2
+    return authorize(challenge, quiet=a.quiet)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bin/idp-directive-consume b/bin/idp-directive-consume
new file mode 100755
index 000000000..5ac423404
--- /dev/null
+++ b/bin/idp-directive-consume
@@ -0,0 +1,352 @@
+#!/usr/bin/env python3
+"""Consume pending steering directives and record that they were read.
+
+THE MISSING HALF (measured 2026-09-18). `signals.py` writes a steer or a stop to
+`~/.claude/state/directives/<session>.json` and records `ok=true`, which means THE FILE WAS
+WRITTEN. The board renders that as "steered". Nothing read the file. Measured:
+
+    ~/.claude/state/directives/
+        abc123def456.json          23:33   (written 2026-09-17)
+        fleet-live-001.json        13:51   (written 2026-09-18)
+
+Two files, both still pending, no reader anywhere in the repo -- `grep -rl directives` found
+only test fixtures. So the button that says "steered" was reporting a mailbox, not a message
+received, and SPEC CP8's own done-condition ("a steer reaches a live session ... each
+acknowledges it, and the newest audit row names the press") was unmet on its second clause.
+
+WHAT THIS IS. The consumer. It runs at a pause point -- a Claude Code SessionStart/PostCompact
+hook, or a pi turn boundary -- reads any pending directive for THIS session, and appends an
+acknowledgement row so the board can show "read at 13:51:20" instead of guessing.
+
+WHY AN APPEND-ONLY LEDGER AND NOT A FILE DELETE. A deleted directive is indistinguishable from
+one that was never written, which is exactly the ambiguity being removed. The directive is
+marked consumed in place (`.consumed`) and the ack is recorded as a row; both survive, so
+"written, never read" stays distinguishable from "written, read, acted on".
+
+CONFIG (LAW 46):
+  ESTATE_STATE_PATH_PREFIX   ledger root; the directives dir is derived as <root>/../directives/
+  ESTATE_DB                  the audit table lives with every other signal row
+  ESTATE_SESSION_ID          the session this hook is running for; falls back to --session
+
+USAGE
+  bin/idp-directive-consume --session <id>          # consume for one session
+  bin/idp-directive-consume --session <id> --peek   # show what is pending, consume nothing
+  bin/idp-directive-consume --install               # print the hook wiring
+"""
+
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import json
+import os
+import sqlite3
+import sys
+from pathlib import Path
+from typing import Any
+
+DEFAULT_LEDGER_ROOT = "~/.claude/state/prompt-ledger/"
+CONSUMED_SUFFIX = ".consumed"
+
+
+def _directives_dir() -> Path:
+    """`<ledger_root>/../directives/` -- the same derivation signals.py writes with.
+
+    Duplicated rather than imported because signals.py is a plugin module loaded by path and
+    this is a hook that must not depend on the plugin's load order. The two must agree, so the
+    test suite asserts they resolve to the same directory for the same environment.
+    """
+    root = Path(
+        os.environ.get("ESTATE_STATE_PATH_PREFIX")
+        or os.path.expanduser(DEFAULT_LEDGER_ROOT)
+    )
+    return root.parent / "directives"
+
+
+def _db_path() -> Path:
+    from_env = os.environ.get("ESTATE_DB")
+    if from_env:
+        return Path(from_env)
+    return Path(__file__).resolve().parent.parent / "catalog" / "estate.db"
+
+
+def _now() -> str:
+    return dt.datetime.now(dt.timezone.utc).isoformat()
+
+
+def _raw_uuid(session_id: str) -> str:
+    """The directive filename is the session id after the last colon -- signals.py's own rule."""
+    return session_id.rsplit(":", 1)[-1]
+
+
+def pending_for(session_id: str) -> list[dict[str, Any]]:
+    """Every directive written for this session that has not been consumed.
+
+    A directive is consumed when a sibling `<name>.consumed` marker exists. The marker rather
+    than a rewrite of the directive keeps the original bytes intact, so what the founder sent is
+    still readable after the fact.
+    """
+    d = _directives_dir()
+    if not d.is_dir():
+        return []
+    name = _raw_uuid(session_id)
+    out: list[dict[str, Any]] = []
+    # The exact name first (the common case), then any file whose own `session_id` matches, so
+    # a session whose id changed shape still gets its message rather than silently never
+    # receiving it.
+    candidates = [d / f"{name}.json"]
+    if d.is_dir():
+        candidates += [p for p in sorted(d.glob("*.json")) if p.name != f"{name}.json"]
+    for path in candidates:
+        if not path.is_file():
+            continue
+        if Path(str(path) + CONSUMED_SUFFIX).exists():
+            continue
+        try:
+            doc = json.loads(path.read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            continue
+        if not isinstance(doc, dict):
+            continue
+        sid = str(doc.get("session_id") or "")
+        if sid and sid != session_id and path.name != f"{name}.json":
+            continue
+        out.append({"path": path, "doc": doc})
+    return out
+
+
+def _ensure_ack_column(con: sqlite3.Connection) -> None:
+    """Add `read_at` to fleetview_signals if an older table lacks it.
+
+    An additive migration on a table this tool reads: `signals.py` owns the schema, and a column
+    it does not know about is harmless to it -- whereas refusing to run until the owner ships a
+    migration would leave the loop open, which is the state being fixed. `ALTER TABLE ... ADD
+    COLUMN` is idempotent-guarded by reading the table's own columns first.
+    """
+    try:
+        cols = {r[1] for r in con.execute("PRAGMA table_info(fleetview_signals)")}
+    except sqlite3.Error:
+        return
+    if cols and "read_at" not in cols:
+        try:
+            con.execute("ALTER TABLE fleetview_signals ADD COLUMN read_at TEXT")
+            con.commit()
+        except sqlite3.Error:
+            pass
+
+
+def _mark_read(con: sqlite3.Connection, session_id: str, when: str) -> int:
+    """Stamp every unread signal row for this session. Returns how many were stamped.
+
+    The board's ack state is derived from this column: a signal with `read_at` set has been
+    seen by the agent, and one without is still pending. That is the distinction `ok` cannot
+    carry, because `ok` describes the WRITE and this describes the READ.
+    """
+    try:
+        cur = con.execute(
+            "UPDATE fleetview_signals SET read_at = ? "
+            "WHERE session_id = ? AND kind IN ('steer','stop','approve','deny') "
+            "AND (read_at IS NULL OR read_at = '')",
+            (when, session_id),
+        )
+        con.commit()
+        return cur.rowcount or 0
+    except sqlite3.Error:
+        return 0
+
+
+def hook_output(session_id: str) -> int:
+    """Emit pending steers as hook context, and consume them.
+
+    THE MID-TURN DELIVERY POINT. A `PreToolUse` hook fires before EVERY tool call, so this runs
+    many times inside a single turn -- which is the difference between a steer that lands while
+    the agent is working and one that waits for it to finish. `SessionStart`/`PostCompact` alone
+    give "next-turn delivery": the estate's own words for a steer that arrives after the work it
+    was meant to change.
+
+    Printed on stdout as the hook contract expects, so the words enter the agent's context rather
+    than only the audit table. A steer nobody reads is the failure this whole file exists to
+    remove, and a consumed directive that never reaches the context is that same failure wearing
+    a different hat.
+    """
+    items = pending_for(session_id)
+    if not items:
+        # Silence when there is nothing to say: a hook that prints on every tool call would fill
+        # the agent's context with noise, and the noise would hide the steer that mattered.
+        return 0
+
+    lines = []
+    for item in items:
+        doc = item["doc"]
+        kind = doc.get("kind") or "steer"
+        who = doc.get("by") or "operator"
+        text = (doc.get("text") or "").strip()
+        when = doc.get("written_at") or ""
+        if kind == "stop":
+            lines.append(
+                f"[estate steer] {who} sent STOP at {when}. Finish the current tool call and "
+                f"stop what you are doing; then say what you stopped and why."
+            )
+        else:
+            lines.append(
+                f"[estate steer] {who} sent at {when}: {text}"
+            )
+
+    # Consume first, print second: if printing fails the marker still records that it was read,
+                # and a crash between the two leaves "read but not shown", which a person can see and
+    # repair. The reverse loses the message.
+    consume(session_id, peek=False, quiet=True)
+
+    payload = {
+        "hookSpecificOutput": {
+            "hookEventName": "PreToolUse",
+            # `additionalContext` is the field the tool-call path reads.
+            "additionalContext": "\n".join(lines),
+        }
+    }
+    print(json.dumps(payload))
+    return 0
+
+
+def consume(session_id: str, *, peek: bool, quiet: bool) -> int:
+    items = pending_for(session_id)
+    if not items:
+        if not quiet:
+            print(json.dumps({"session": session_id, "pending": 0, "consumed": 0}))
+        return 0
+
+    if peek:
+        print(
+            json.dumps(
+                {
+                    "session": session_id,
+                    "pending": len(items),
+                    "directives": [
+                        {
+                            "kind": i["doc"].get("kind"),
+                            "by": i["doc"].get("by"),
+                            "written_at": i["doc"].get("written_at"),
+                            "text": (i["doc"].get("text") or "")[:200],
+                        }
+                        for i in items
+                    ],
+                },
+                indent=2,
+            )
+        )
+        return 0
+
+    when = _now()
+    con = None
+    try:
+        con = sqlite3.connect(str(_db_path()))
+        _ensure_ack_column(con)
+        stamped = _mark_read(con, session_id, when)
+    except sqlite3.Error:
+        stamped = 0
+    finally:
+        if con is not None:
+            con.close()
+
+    consumed = 0
+    for item in items:
+        path: Path = item["path"]
+        try:
+            # The marker is written BEFORE the directive is treated as read, so a crash between
+            # the two leaves a marker for a directive the ledger has not stamped -- which reads
+            # as 'read but unstamped', a state a person can see and repair. The reverse order
+            # would silently lose the message.
+            Path(str(path) + CONSUMED_SUFFIX).write_text(
+                json.dumps({"read_at": when, "by": "hook"}), encoding="utf-8"
+            )
+            consumed += 1
+        except OSError:
+            continue
+
+    if not quiet:
+        print(
+            json.dumps(
+                {
+                    "session": session_id,
+                    "pending": len(items),
+                    "consumed": consumed,
+                    "audit_rows_stamped": stamped,
+                }
+            )
+        )
+    return 0
+
+
+def install_guidance() -> int:
+    """Print the wiring rather than writing someone else's hook file.
+
+    Deliberately does not edit `~/.claude/settings.json`: that file holds every hook on this
+    machine, and a tool that rewrites it is a tool that can disable the estate's fences by
+    accident. The snippet below is the whole change, and it is one line.
+    """
+    script = Path(__file__).resolve()
+    print("Add this to the SessionStart and PostCompact hook arrays in")
+    print("  ~/.claude/settings.json   (and the pi equivalent at a turn boundary)")
+    print()
+    print(
+        json.dumps(
+            {
+                "hooks": {
+                    "SessionStart": [
+                        {
+                            "hooks": [
+                                {
+                                    "type": "command",
+                                    "command": (
+                                        f"{sys.executable} {script} "
+                                        '--session "$CLAUDE_SESSION_ID" --quiet'
+                                    ),
+                                }
+                            ]
+                        }
+                    ]
+                }
+            },
+            indent=2,
+        )
+    )
+    print()
+    print("It is deliberately fail-open: a hook that cannot read the mailbox says nothing and")
+    print("exits 0, so a broken consumer never blocks a session from starting.")
+    return 0
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--session", default=os.environ.get("ESTATE_SESSION_ID")
+                    or os.environ.get("CLAUDE_SESSION_ID"))
+    ap.add_argument("--peek", action="store_true", help="show pending; consume nothing")
+    ap.add_argument("--quiet", action="store_true")
+    ap.add_argument("--install", action="store_true", help="print the hook wiring")
+    ap.add_argument(
+        "--hook",
+        action="store_true",
+        help="mid-turn mode: emit pending steers as PreToolUse context and consume them",
+    )
+    a = ap.parse_args()
+
+    if a.install:
+        return install_guidance()
+
+    if not a.session:
+        # Fail-open with a reason. A session-start hook that dies because an id is missing takes
+        # the session with it, which is a far worse failure than a missed directive.
+        if not a.quiet:
+            print(
+                "no session id: pass --session or set ESTATE_SESSION_ID."
+                " Nothing consumed.",
+                file=sys.stderr,
+            )
+        return 0
+    if a.hook:
+        return hook_output(a.session)
+    return consume(a.session, peek=a.peek, quiet=a.quiet)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
