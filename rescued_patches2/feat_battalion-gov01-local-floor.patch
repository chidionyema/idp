+        sovereignty: 'anywhere',
+        fallbacks: [],
+        reason: 'test',
+      },
+      {
+        kind: 'unavailable',
+        message: 'provider down',
+        retryable: true,
+        at: Date.now(),
+      },
+    );
+    // Health should now mark 'a' as down for a while.
+    expect(health.isHealthy(asModelId('a'))).toBe(false);
+  });
+});
