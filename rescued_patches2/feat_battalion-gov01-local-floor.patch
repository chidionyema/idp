index 000000000..d8b15114d
--- /dev/null
+++ b/bin/idp-room-prove
@@ -0,0 +1,224 @@
+#!/usr/bin/env python3
+"""Prove the fleet room renders, by driving a real browser. Run it, do not ask.
+
+WHY THIS EXISTS. Four times in one session a claim was made about the page from a
+terminal and was wrong -- a curl says the API answers and says nothing about what a
+person sees. Then a probe that read the DOM said the agent list was on the page when it
+was invisible, and another said it was hidden when it was not. The only instrument that
+has never lied about this page is a screenshot and a pixel count.
+
+So this drives Chrome, loads /fleet, waits for the build, and asserts eight things a
+person would notice. It exits non-zero on any failure, so it can be run after every change
+without asking anyone to reload a page by hand.
+
+WHAT IT ASSERTS, and each is a defect that actually happened:
+  * the canvas exists                                        -- it once measured 1168x0
+  * it has real height                                       -- 100% of a parent with no height
+  * it is visible without scrolling                          -- it once began at y=380
+  * it has drawn pixels                                      -- a blank canvas passes a DOM check
+  * no page errors                                           -- 'useRef is not defined' rendered blank
+  * the accessible list exists                               -- the fleet as text, for a screen reader
+  * the accessible list OCCUPIES NO SPACE                    -- it once ran 24 visible lines down the page
+  * real agents reached it                                   -- 24, from the API, not seeded stubs
+
+Usage:  bin/idp-room-prove            # exits 0 when the room renders, 1 when it does not
+        bin/idp-room-prove --json
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
+PORTAL = os.environ.get("PORTAL_URL", "http://localhost:3100")
+# The bundle takes about 15s to compile on a cold start and the page needs a moment to draw.
+# 14s was the guest-wall settle, and it alone was half the budget. The wall clears in about 8s
+# when the estate is up, so 9 gives the same proof with 5 seconds of headroom for a slower machine
+# -- and a machine that needs longer has a different problem than this script can report.
+SETTLE_MS = int(os.environ.get("ROOM_SETTLE_MS", "4000"))
+
+SCRIPT = r"""
+import { chromium } from 'playwright-core';
+const PORTAL = process.env.PORTAL_URL;
+const SETTLE = Number(process.env.ROOM_SETTLE_MS);
+
+// ATTACH TO THE LONG-LIVED BROWSER when one is up, instead of launching a new one.
+//
+// A cold Chrome launch plus guest sign-in plus first paint was measured at about ten seconds --
+// for ONE look. The 30-second ceiling is a ceiling, not a budget, and a proof that costs ten
+// seconds is a proof that gets run once and then trusted. bin/room-eye keeps a browser alive on
+// :9222, so this attaches and the whole check runs in about two.
+const CDP = process.env.ROOM_EYE_PORT || '9222';
+const b = await (async () => {
+  try {
+    return await chromium.connectOverCDP(`http://127.0.0.1:${CDP}`);
+  } catch {
+    return await chromium.launch({
+      executablePath: process.env.CHROME_PATH,
+      headless: true,
+    });
+  }
+})();
+// REUSE THE PAGE IF ONE IS ALREADY ON THE ROOM. Connecting over CDP gives back the browser, and
+// asking it for a NEW page opens a blank tab -- which is why eight checks reported "no canvas" and
+// took 13 seconds doing it while the room was open in the tab next door. The first page that is
+// not `about:blank` is the room; otherwise make one.
+const pages = b.contexts().flatMap((c) => c.pages());
+const existing = pages.find((x) => x.url().includes('/fleet'));
+const p = existing ?? await b.newPage({ viewport: { width: 1440, height: 900 } });
+await p.setViewportSize({ width: 1440, height: 900 }).catch(() => {});
+const errs = [];
+p.on('pageerror', e => errs.push(e.message.slice(0, 160)));
+p.on('console', m => {
+  if (m.type() === 'error' && !/findDOMNode|401|DevTools/.test(m.text())) errs.push(m.text().slice(0, 160));
+});
+
+const out = { checks: [], errors: errs };
+const ok = (name, pass, detail) => out.checks.push({ name, pass: !!pass, detail: String(detail) });
+
+try {
+  // EVERY WAIT HERE IS BOUNDED, and the 30-second ceiling is a CEILING, NOT A BUDGET.
+  //
+  // Measured 2026-09-19: this sequence was 12s navigation + 4s settle + 9s wall = 25 seconds
+  // before the first of eight checks had run, and the subprocess was allowed 24, so it was killed
+  // mid-proof. That is a script which technically obeys a 30s limit while spending the founder's
+  // clock to the last drop -- and the founder's correction was exact: "i said no command may
+  // exceed 30s, big difference."
+  //
+  // So the waits are now sized to what the work ACTUALLY takes rather than to how long we might
+  // get away with. domcontentloaded on a warm dev server is ~2s; the guest wall clears in ~2s.
+  // Waiting is only useful up to the point the page is ready, and past that it is just delay.
+  // `commit`, NOT `domcontentloaded`. Identical to the fix in bin/room-eye, and found the same way:
+  // webpack-dev-server serves the HTML instantly and then compiles the bundle, so the document is
+  // not "loaded" while the build runs and a 6s wait on that event times out against a page that
+  // curl fetches in 1.7ms. Readiness is the canvas, asserted below, not a lifecycle event.
+  await p.goto(`${PORTAL}/fleet`, { waitUntil: 'commit', timeout: 8000 });
+  // WAIT FOR THE ROOM, NOT FOR A CLOCK. When this attaches to a browser whose page is already on
+  // /fleet, the navigation is a no-op and a fixed 1.5s sleep is a guess -- which is how the run
+  // above reported "no canvas element" against a page that had one. The canvas IS the readiness
+  // signal; waiting for it is both faster when the page is warm and correct when it is cold.
+  await p.waitForSelector('canvas', { timeout: 8000 }).catch(() => {});
+  await p.waitForTimeout(600);
+  // The estate signs a guest in on the way through; if the wall is up, press it once.
+  const wall = await p.$('button:has-text("Enter")');
+  if (wall) {
+    await wall.click();
+    // ONLY PAY THE SETTLE WHEN THERE WAS A WALL. The profile bin/room-eye keeps is already signed
+    // in, so the wall is usually absent -- and sleeping 4s for it anyway was most of this script's
+    // runtime. Wait for the canvas instead, which is the thing the checks actually need.
+    await p.waitForSelector('canvas', { timeout: Math.min(SETTLE, 5000) }).catch(() => {});
+  }
+
+  const cv = await p.evaluate(() => {
+    const c = document.querySelector('canvas');
+    if (!c) return null;
+    const b = c.getBoundingClientRect();
+    return { w: Math.round(b.width), h: Math.round(b.height), y: Math.round(b.y) };
+  });
+  ok('canvas exists', !!cv, cv ? JSON.stringify(cv) : 'no canvas element');
+  ok('canvas has real height', cv && cv.h > 300, cv ? `${cv.h}px` : 'n/a');
+  ok('canvas visible without scrolling', cv && cv.y < 900, cv ? `y=${cv.y}` : 'n/a');
+
+  const lit = await p.evaluate(() => {
+    const c = document.querySelector('canvas');
+    if (!c) return 0;
+    const ctx = c.getContext('2d');
+    const d = ctx.getImageData(0, 0, c.width, c.height).data;
+    let n = 0;
+    for (let i = 3; i < d.length; i += 4 * 53) if (d[i] > 12) n++;
+    return n;
+  });
+  ok('canvas has drawn pixels', lit > 500, `${lit} lit samples`);
+
+  const list = await p.evaluate(() => {
+    const ul = document.querySelector('[data-testid="room-agents"]');
+    if (!ul) return null;
+    const items = Array.from(ul.querySelectorAll('li'));
+    const sized = items.filter(li => {
+      const b = li.getBoundingClientRect();
+      return b.width > 4 && b.height > 4;
+    });
+    return { items: items.length, sizedVisible: sized.length };
+  });
+  ok('accessible list present', !!list, list ? JSON.stringify(list) : 'absent');
+  ok('accessible list takes no space', list && list.sizedVisible === 0,
+     list ? `${list.sizedVisible} items occupy space` : 'n/a');
+  ok('real agents reached it', list && list.items >= 20, list ? `${list.items} items` : 'n/a');
+  ok('no page errors', errs.length === 0, errs.slice(0, 2).join(' | ') || 'none');
+} catch (e) {
+  ok('browser drive completed', false, String(e).slice(0, 200));
+}
+out.ok = out.checks.every(c => c.pass);
+console.log(JSON.stringify(out));
+await b.close();
+"""
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--json", action="store_true")
+    args = ap.parse_args()
+
+    if not Path(CHROME).exists():
+        print(f"BLIND room-prove  no Chrome at {CHROME}", file=sys.stderr)
+        return 2
+    # playwright-core resolves from the app package, and the script must live where it can.
+    # playwright-core is hoisted to the workspace root (backstage/node_modules), not installed
+    # per-package -- so the check looks where it actually is. A guard that checks the wrong path
+    # reports BLIND on a machine where the tool is present, which trains a reader to ignore BLIND.
+    app = ROOT / "backstage" / "packages" / "app"
+    have_pw = (ROOT / "backstage" / "node_modules" / "playwright-core").exists() or (
+        app / "node_modules" / "playwright-core"
+    ).exists()
+    if not have_pw:
+        print("BLIND room-prove  playwright-core is not installed under backstage/", file=sys.stderr)
+        return 2
+
+    with tempfile.NamedTemporaryFile("w", suffix=".mjs", dir=str(app), delete=False) as fh:
+        fh.write(SCRIPT)
+        script = fh.name
+    try:
+        proc = subprocess.run(
+            ["node", str(Path(script).relative_to(app))],
+            cwd=str(app),
+            capture_output=True,
+            text=True,
+            timeout=20,  # ceiling, not a budget; this proof should finish in ~6s
+            env={
+                **os.environ,
+                "PORTAL_URL": PORTAL,
+                "CHROME_PATH": CHROME,
+                "ROOM_SETTLE_MS": str(SETTLE_MS),
+            },
+        )
+    finally:
+        shutil.move(script, "/dev/null") if False else Path(script).unlink(missing_ok=True)
+
+    line = (proc.stdout or "").strip().splitlines()[-1] if proc.stdout.strip() else ""
+    try:
+        result = json.loads(line)
+    except ValueError:
+        print(f"BLIND room-prove  the driver produced no result\n{proc.stdout[-300:]}\n{proc.stderr[-300:]}", file=sys.stderr)
+        return 2
+
+    if args.json:
+        print(json.dumps(result, indent=2))
+    else:
+        for c in result["checks"]:
+            print(f"  {'PASS' if c['pass'] else 'FAIL'}  {c['name']:<36} {c['detail']}")
+        passed = sum(1 for c in result["checks"] if c["pass"])
+        total = len(result["checks"])
+        print(f"\n{'ok' if result['ok'] else 'FAIL'}    room-prove  {passed}/{total} checks")
+    return 0 if result["ok"] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/bin/idp-router-egress-gate b/bin/idp-router-egress-gate
new file mode 100755
index 000000000..aebf9559c
--- /dev/null
+++ b/bin/idp-router-egress-gate
@@ -0,0 +1,190 @@
+#!/usr/bin/env python3
+"""Guard against a second, undeclared LiteLLM router config landing outside the reviewed set
+(idp#3525 CP3, ROUTE-01).
+
+ROUTE-01: "All model calls SHALL traverse the standardized model-agnostic router with mandatory
+fallback chains. Direct provider calls are rogue per crew policy." ACCEPT (spec section 3):
+"network policy denies egress to provider APIs except router; bypass attempt alerts."
+
+Kubernetes NetworkPolicy in this cluster (Calico, iptables/VXLAN dataplane) filters by IP/CIDR/
+port only, never by domain name -- measured against platform/ns-fences/allowances.yaml, where
+`egress_internet: [443]` is a raw internet hole on that port, not a "provider APIs blocked,
+router allowed" distinction. So the network layer alone cannot enforce ROUTE-01's first clause;
+the only place a second router is visible at all is the config that names it. A `model_list`
+block whose `litellm_params.api_key` is `os.environ/<...>_API_KEY` IS a LiteLLM router -- the
+shape platform/llm/config.yaml (the estate router) and platform/otto-gateway/three-homes.yaml
+(Otto's founder-ordered lifeboat, homes 2/3) both use. three-homes.yaml's own header says it
+straight: "This is not a second platform router. The estate keeps one router and home 1 is it."
+
+This gate is the review gate for THE HEADLINE's "Shared layers ... exist once": every model_list
+config the repo carries must belong to a namespace on the reviewed ledger below, with a reason. A
+third one appearing in an unreviewed namespace is the rogue direct-provider path ROUTE-01 names,
+caught here, in the pull request, before it reaches a cluster where NetworkPolicy cannot tell it
+apart from the router's own traffic.
+
+Runtime bypass-attempt alerting -- ROUTE-01's other ACCEPT clause -- is a separate, pre-existing,
+already-tracked gap: bin/idp-calico-deny-log parses Calico's own deny-flow evidence, but its own
+rules.yaml row already records `live_gap: chidionyema/idp#2452 -- no real deny feed is collected
+anywhere`. This gate does not claim to close #2452 (a live cluster-integration gap, out of this
+gate's reach), and #2452 could not have caught this class of bypass either way: an already-
+allowed egress_internet hole produces no deny flow, and Calico sees an IP, never a router's name.
+"""
+
+from __future__ import annotations
+
+import pathlib
+import re
+import sys
+
+import yaml
+
+# namespace -> why it is allowed to hold a model_list-shaped LiteLLM config (i.e. to run a
+# second router instance). Reviewed here, by a human reading the code each one points at --
+# never discovered or inferred by this gate.
+REVIEWED_ROUTER_NAMESPACES = {
+    "llm": "the estate router itself (platform/llm/config.yaml, platform/llm/litellm.yaml)",
+    "otto-gateway": (
+        "founder-ordered lifeboat (2026-09-09/10, 'otto must have 3 homes'): a non-database "
+        "litellm sidecar carrying homes 2/3 for Otto alone, on 127.0.0.1 in Otto's own pod -- "
+        "see platform/otto-gateway/three-homes.yaml's own header"
+    ),
+}
+
+_API_KEY = re.compile(r"os\.environ/\w*_API_KEY\w*")
+
+
+def _yaml_docs(text: str):
+    try:
+        docs = yaml.safe_load_all(text)
+        yield from (d for d in docs if isinstance(d, dict))
+    except yaml.YAMLError:
+        return
+
+
+def is_router_config(doc: dict) -> bool:
+    """A dict is a LiteLLM router config iff it declares model_list rows with an
+    os.environ-sourced api_key -- the shape both known routers share."""
+    rows = doc.get("model_list")
+    if not isinstance(rows, list):
+        return False
+    for row in rows:
+        params = (row or {}).get("litellm_params") or {}
+        if _API_KEY.search(str(params.get("api_key", ""))):
+            return True
+    return False
+
+
+def namespace_of(doc: dict, path: pathlib.Path) -> str | None:
+    ns = (doc.get("metadata") or {}).get("namespace")
+    if ns:
+        return ns
+    # A bare litellm proxy config carries no k8s metadata at all (platform/llm/config.yaml,
+    # config.base.yaml): the directory it lives in IS its deployment, per litellm.yaml's own
+    # Deployment mounting it from platform/llm/.
+    if path.parent.name == "llm":
+        return "llm"
+    return None
+
+
+def router_configs(root: pathlib.Path):
+    """Yield (path, namespace, doc) for every LiteLLM-shaped model_list config under root,
+    whether it is a bare proxy config or embedded as a ConfigMap's string data field."""
+    files = sorted(root.rglob("*.yaml")) if root.is_dir() else [root]
+    for f in files:
+        if f.name == "kustomization.yaml":
+            continue
+        try:
+            text = f.read_text(encoding="utf-8")
+        except (UnicodeDecodeError, OSError):
+            continue
+        for doc in _yaml_docs(text):
+            if is_router_config(doc):
+                yield f, namespace_of(doc, f), doc
+            data = doc.get("data")
+            if not isinstance(data, dict):
+                continue
+            ns = namespace_of(doc, f)
+            for value in data.values():
+                if not isinstance(value, str) or "model_list" not in value:
+                    continue
+                for nested in _yaml_docs(value):
+                    if is_router_config(nested):
+                        yield f, ns, nested
+
+
+def check(path: str) -> int:
+    root = pathlib.Path(path)
+    if not root.exists():
+        print(f"idp-router-egress-gate: nothing at {path}")
+        return 2
+
+    found_ns: dict[str, list[str]] = {}
+    for f, ns, _doc in router_configs(root):
+        found_ns.setdefault(ns or "<unknown>", []).append(str(f))
+
+    bad = 0
+    for ns, paths in sorted(found_ns.items()):
+        listed = ", ".join(sorted(set(paths)))
+        if ns in REVIEWED_ROUTER_NAMESPACES:
+            print(
+                f"ok      router-egress-gate  {ns}: {REVIEWED_ROUTER_NAMESPACES[ns]}  ({listed})"
+            )
+            continue
+        bad += 1
+        print(
+            f"FAIL    router-egress-gate  a LiteLLM router config lives in namespace "
+            f"{ns!r}, which is on no reviewed list ({listed}): a rogue direct-provider "
+            f"router (ROUTE-01)"
+        )
+
+    if bad:
+        print(f"idp-router-egress-gate: {bad} unreviewed router namespace(s) refused")
+        return 1
+    if not found_ns:
+        print(
+            f"idp-router-egress-gate: no LiteLLM router config found under {path}; nothing was graded"
+        )
+    print("verdict router-egress-gate PASS")
+    return 0
+
+
+def _usage() -> str:
+    return (
+        "usage: idp-router-egress-gate <path>   grade a fixture file or a directory tree\n"
+        "       idp-router-egress-gate --self-test\n"
+        "       idp-router-egress-gate --help"
+    )
+
+
+def _self_test() -> int:
+    """LAW 45: this script has not run until --self-test proves it, against its own fixtures."""
+    root = pathlib.Path(__file__).resolve().parent.parent
+    good = root / "tests/fixtures/router-egress/good.yaml"
+    bad = root / "tests/fixtures/router-egress/bad.yaml"
+    if not good.exists() or not bad.exists():
+        print(f"SKIP router-egress-gate --self-test: fixtures not found under {root}")
+        return 0
+    if check(str(good)) != 0:
+        print(f"FAIL router-egress-gate --self-test: {good} should pass and did not")
+        return 1
+    if check(str(bad)) == 0:
+        print(
+            f"FAIL router-egress-gate --self-test: {bad} should be refused and passed"
+        )
+        return 1
+    print(
+        "ok   router-egress-gate --self-test: good fixture passes, bad fixture refused"
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    if len(sys.argv) == 2 and sys.argv[1] in ("--help", "-h"):
+        print(_usage())
+        sys.exit(0)
+    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
+        sys.exit(_self_test())
+    if len(sys.argv) != 2:
+        print("idp-router-egress-gate: expected one fixture path (file or directory)")
+        sys.exit(2)
+    sys.exit(check(sys.argv[1]))
