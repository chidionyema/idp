@@ -0,0 +1,87 @@
+# crew#284 CP1/CP2, crew#248: the estate vault is seeded from GitHub secrets by the machine identity.
+# The laptop path is closed (crew#227 deleted the OCI API key; crew#247: infra is never Mac-bound),
+# so the two vault entries the platform waits on (litellm-upstream, prospector-engine-env) are
+# written here from repository secrets named SEED_<KEY>. litellm-upstream is written by the oke-check apply
+# step (idp#241); this workflow carries the entries oke-check does not: prospector-engine-env and github-app. Values travel from the secret store to
+# the runner's process to the vault and are never printed; bin/idp-vault-put reads them in-process.
+# Runs from the phone: gh workflow run vault-seed.yml -f entry=all
+name: vault-seed
+on:
+  workflow_dispatch:
+    inputs:
+      entry:
+        description: "which vault entry to write"
+        type: choice
+        options: [all, prospector-engine-env, github-app]
+        default: all
+permissions:
+  id-token: write   # the OIDC token this job trades for OCI access
+  contents: read
+concurrency: { group: oke-check, cancel-in-progress: false }   # shares the state bucket with oke-check
+jobs:
+  seed:
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with: { python-version: "3.12" }
+      - uses: opentofu/setup-opentofu@592200bd4b9bbf4772ace78f887668b1aee8f716 # v1.0.5
+        with: { tofu_version: "1.12.6", tofu_wrapper: false }
+      - name: oci cli
+        run: pip install -q oci-cli
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+      - name: bin/idp-vault-put ${{ inputs.entry }}
+        env:
+          ENTRY: ${{ inputs.entry }}
+          OCI_CI: "1"
+          OCI_CLI_AUTH: security_token
+          OCI_TENANCY_OCID: ${{ secrets.OCI_TENANCY_OCID }}
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+          OCI_OS_NAMESPACE: ${{ vars.OCI_OS_NAMESPACE }}
+          OCI_S3_ACCESS_KEY: ${{ secrets.OCI_S3_ACCESS_KEY }}
+          OCI_S3_SECRET_KEY: ${{ secrets.OCI_S3_SECRET_KEY }}
+          OKE_SSH_PUBKEY_TEXT: ${{ vars.OKE_SSH_PUBKEY }}
+          OKE_ALLOWED_CIDRS: ${{ vars.OKE_ALLOWED_CIDRS }}
+          ESTATE_FOUNDER_EMAIL: ${{ vars.ESTATE_FOUNDER_EMAIL }}
+          SEED_MINIMAX_API_KEY: ${{ secrets.SEED_MINIMAX_API_KEY }}
+          SEED_DEEPSEEK_API_KEY: ${{ secrets.SEED_DEEPSEEK_API_KEY }}
+          SEED_OPENROUTER_API_KEY: ${{ secrets.SEED_OPENROUTER_API_KEY }}
+          SEED_ANTHROPIC_API_KEY: ${{ secrets.SEED_ANTHROPIC_API_KEY }}
+          SEED_EXA_API_KEY: ${{ secrets.SEED_EXA_API_KEY }}
+          SEED_STORE_API_URL: ${{ secrets.SEED_STORE_API_URL }}
+          SEED_STORE_INTERNAL_API_KEY: ${{ secrets.SEED_STORE_INTERNAL_API_KEY }}
+          SEED_R2_ACCESS_KEY_ID: ${{ secrets.SEED_R2_ACCESS_KEY_ID }}
+          SEED_R2_ACCOUNT_ID: ${{ secrets.SEED_R2_ACCOUNT_ID }}
+          SEED_R2_BUCKET: ${{ secrets.SEED_R2_BUCKET }}
+          SEED_R2_SECRET_ACCESS_KEY: ${{ secrets.SEED_R2_SECRET_ACCESS_KEY }}
+          SEED_GITHUB_APP_ID: ${{ secrets.SEED_GITHUB_APP_ID }}
+          SEED_GITHUB_APP_SLUG: ${{ secrets.SEED_GITHUB_APP_SLUG }}
+          SEED_GITHUB_APP_CLIENT_ID: ${{ secrets.SEED_GITHUB_APP_CLIENT_ID }}
+          SEED_GITHUB_APP_PEM_B64: ${{ secrets.SEED_GITHUB_APP_PEM_B64 }}
+        run: |
+          set -euo pipefail
+          bin/idp-oci-login --check
+          (cd platform/oci && tofu init -input=false -reconfigure -no-color >/dev/null)
+          # the operator env file bin/idp-vault-put expects, assembled from SEED_* in this process
+          export ESTATE_ENV_FILE="$RUNNER_TEMP/seed.env"; umask 077
+          env | sed -n 's/^SEED_//p' > "$ESTATE_ENV_FILE"
+          put() { bin/idp-vault-put "$@"; }
+          if [ "$ENTRY" = all ] || [ "$ENTRY" = prospector-engine-env ]; then
+            put prospector-engine-env MINIMAX_API_KEY=MINIMAX_API_KEY DEEPSEEK_API_KEY=DEEPSEEK_API_KEY EXA_API_KEY=EXA_API_KEY \
+              OPENROUTER_API_KEY=OPENROUTER_API_KEY ANTHROPIC_API_KEY=ANTHROPIC_API_KEY \
+              STORE_API_URL=STORE_API_URL STORE_INTERNAL_API_KEY=STORE_INTERNAL_API_KEY \
+              R2_ACCESS_KEY_ID=R2_ACCESS_KEY_ID R2_ACCOUNT_ID=R2_ACCOUNT_ID R2_BUCKET=R2_BUCKET R2_SECRET_ACCESS_KEY=R2_SECRET_ACCESS_KEY
+          fi
+          if [ "$ENTRY" = all ] || [ "$ENTRY" = github-app ]; then
+            # the four keys bin/idp-github-app convert writes; installation_id is added by the oke-check installation step
+            put github-app app_id=GITHUB_APP_ID slug=GITHUB_APP_SLUG client_id=GITHUB_APP_CLIENT_ID pem_b64=GITHUB_APP_PEM_B64
+          fi
+          rm -f "$ESTATE_ENV_FILE"
