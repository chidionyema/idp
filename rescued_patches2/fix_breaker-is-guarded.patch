+    # A SUCCESSFUL COMMAND IS NOT A FINDING. Without this, `echo alive` and `ls` carry a digest,
+    # and repeating one three times locks the session -- which is exactly what happened.
+    if not _SIGNAL.search(body):
+        return None
+
     return "sha:" + hashlib.sha256(body.encode()).hexdigest()[:16]
 
 
