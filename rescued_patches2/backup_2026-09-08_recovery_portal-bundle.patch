+      input_cost_per_token: 0.0000003
+      output_cost_per_token: 0.0000012
+    model_info:
+      # M2.7 reads 204,800 tokens, a fifth of the primary's window. Capped here so an
+      # oversized turn is refused by the estate rather than by the vendor mid-failover.
+      max_input_tokens: 204800
 
