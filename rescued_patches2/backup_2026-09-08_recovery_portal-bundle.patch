+        for a in sorted(set(row.get("ingress_from") or [])):
+            src = flows.get(a)
+            if src is not None and b not in (src.get("egress") or []):
+                bad.append(f"{b} admits {a}, but {a} never declares egress to {b}")
+    return bad
