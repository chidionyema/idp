diff --git a/bin/idp-sleep-ban b/bin/idp-sleep-ban
new file mode 100755
index 000000000..4e3e41573
--- /dev/null
+++ b/bin/idp-sleep-ban
@@ -0,0 +1,145 @@
+#!/usr/bin/env python3
+"""Time is not a synchronisation primitive. A wait longer than 5 seconds is a missing event.
+
+    bin/idp-sleep-ban [paths...]     # grade scripts; default the tree
+
+WHY THIS EXISTS, and the founder said it first: an agent that writes `sleep 420` to wait for a
+state change has not understood the environment it is running in. A fixed sleep is wrong in both
+directions and there is no value of it that is right:
+
+  the work finished in 30s   -> 6.5 minutes of wall clock thrown away, and the session looks
+                                hung to the person watching it (measured 2026-09-12: the whole
+                                evening was punctuated by turns that produced nothing for
+                                minutes at a time)
+  the work took 421s         -> the sleep returns too early and the next command acts on state
+                                that is not there yet
+
+The estate already owns the event-driven answer for the case that caused this: GitHub's own
+merge queue. `gh pr merge --squash --auto` arms the merge and returns in 200ms; GitHub watches
+the checks and merges the instant they are green, or cancels if one fails. No polling, no
+guessing, no blocked thread.
+
+WHAT IS ALLOWED, because a ban that refuses correct work is an outage (R38):
+
+  sleep 5 and shorter       a yield, not a wait. Covers backoff between retries of a call that
+                            has already failed.
+  sleep with a marker       a line carrying `# sleep-ok: <reason>` is accepted, so a genuine
+                            fixed interval (a rate limit the API documents, a protocol heartbeat)
+                            can be written down instead of hidden. The reason is required: the
+                            marker is a place to state the case, not a way to silence the gate.
+  in a container manifest   a `sleep` inside a Kubernetes command that keeps a pod alive is not
+                            a synchronisation wait; those are excluded by path.
+
+WHAT IS REFUSED: a bare sleep of 10 seconds or more, waiting for something outside this process
+to change.
+"""
+
+from __future__ import annotations
+
+import argparse
+import pathlib
+import re
+import sys
+
+ROOT = pathlib.Path(__file__).resolve().parents[1]
+
+# The largest gap that is a yield rather than a wait.
+MAX_YIELD_S = 5
+
+# A sleep this long is unambiguously waiting on external state.
+BAN_S = 10
+
+SLEEP = re.compile(r"\bsleep\s+(?P<arg>[0-9]+(?:\.[0-9]+)?)(?P<rest>[^\n]*)")
+ALLOW_MARK = re.compile(r"#\s*sleep-ok\s*:\s*\S", re.I)
+
+# Paths where a sleep is a liveness device, not a wait for state.
+EXEMPT_PARTS = ("/migrations/", "manifests/", "fixtures/")
+
+SKIP_DIRS = {".git", "node_modules", ".venv", "__pycache__", ".crew", "run", "scratchpad"}
+
+
+def scans(p: pathlib.Path) -> bool:
+    if any(part in SKIP_DIRS or part.startswith("wt-") or part.startswith(".wt-") for part in p.parts):
+        return False
+    return not any(x in str(p) for x in EXEMPT_PARTS)
+
+
+def grade(path: pathlib.Path) -> list[str]:
+    findings: list[str] = []
+    try:
+        lines = path.read_text(errors="replace").splitlines()
+    except OSError:
+        return findings
+    # A COMMENT OR A DOCSTRING IS NOT A COMMAND. This rule's own docstring quotes `sleep 420` as
+    # the example it refuses, so the gate refused itself the first time it ran -- prose about a
+    # sleep is not a sleep. The spans below are found rather than guessed: a triple-quoted block
+    # opens and closes, and every line between them is text.
+    prose: set[int] = set()
+    inside: str | None = None
+    for i, line in enumerate(lines, 1):
+        stripped = line.lstrip()
+        if inside is None:
+            for q in ('"""', "'''"):
+                if stripped.startswith(q) and not stripped[len(q):].rstrip().endswith(q):
+                    inside, _ = q, prose.add(i)
+                    break
+            else:
+                if stripped.startswith("#") or stripped.startswith("//"):
+                    prose.add(i)
+        else:
+            prose.add(i)
+            if inside in line:
+                inside = None
+
+    for n, line in enumerate(lines, 1):
+        if n in prose or ALLOW_MARK.search(line):
+            continue
+        m = SLEEP.search(line)
+        if not m:
+            continue
+        try:
+            secs = float(m.group("arg"))
+        except ValueError:
+            continue
+        if secs < BAN_S:
+            continue
+        findings.append(f"{path}:{n}: sleep {m.group('arg')} -- {line.strip()[:70]}")
+    return findings
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("paths", nargs="*")
+    args = ap.parse_args()
+
+    roots = [pathlib.Path(p) for p in args.paths] or [ROOT / "bin", ROOT / "platform"]
+    files: list[pathlib.Path] = []
+    for r in roots:
+        r = r if r.is_absolute() else ROOT / r
+        if r.is_file():
+            files.append(r)
+        elif r.is_dir():
+            files += [f for f in r.rglob("*") if f.is_file() and scans(f)]
+
+    findings: list[str] = []
+    for f in sorted(set(files)):
+        findings += grade(f)
+
+    if findings:
+        print(f"FAIL  sleep-ban: {len(findings)} wait(s) on a clock instead of an event")
+        for f in findings[:12]:
+            print(f"      {f}")
+        print()
+        print("      a wait longer than 10s is a missing event. The estate's own answer for CI is")
+        print("      GitHub's merge queue:  gh pr merge <n> --squash --auto")
+        print("      for anything else the native reconciler is the waiter: Flux, a Kubernetes Job's")
+        print("      backoffLimit, a webhook. State the case with `# sleep-ok: <reason>` only when a")
+        print("      documented rate limit or protocol heartbeat forces a fixed interval.")
+        return 1
+
+    print(f"ok    sleep-ban: {len(set(files))} file(s) scanned, no wait on a clock")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
