diff --git a/llm/config.yaml b/llm/config.yaml
new file mode 100644
index 000000000..9e55b2ac9
--- /dev/null
+++ b/llm/config.yaml
@@ -0,0 +1,94 @@
+# LiteLLM routing. This file replaces the chain-building half of prospector/operator.py.
+#
+# Standard: crew/docs/STANDARDS.md "LLM providers" (LiteLLM, adopted 2026-08-24).
+#
+# The names on the left are the ONLY thing prospector sees. They are deliberately the same
+# tier names config.yaml already uses (`operator:`, `noncritical_operator:`), so the
+# migration is a `providers:` block pointing at 127.0.0.1:4000 and not a rewrite.
+#
+# WHAT IS NOT HERE. `claude_cli` and `gemini_cli` are absent on purpose. They are local CLI
+# binaries spending a SUBSCRIPTION, not HTTP endpoints spending an API key, and a proxy
+# cannot drive them. They stay in prospector, they stay the trusted `moat_primary` tier,
+# and they stay the EUR 0 path (R14).
+
+model_list:
+  # --- the moat's cheap primary --------------------------------------------------------
+  # MiniMax has no first-class LiteLLM provider; it is OpenAI-compatible, so it is declared
+  # with an explicit api_base rather than a provider prefix.
+  - model_name: minimax
+    litellm_params:
+      model: openai/MiniMax-M2
+      api_base: https://api.minimax.io/v1
+      api_key: os.environ/MINIMAX_API_KEY
+      timeout: 300
+      max_tokens: 8192
+
+  # The failover tier: same account and adapter, different model. It is a failover, never
+  # a routing choice — see prospector config.yaml on `minimax_m27`.
+  - model_name: minimax_m27
+    litellm_params:
+      model: openai/MiniMax-Text-01
+      api_base: https://api.minimax.io/v1
+      api_key: os.environ/MINIMAX_API_KEY
+      timeout: 300
+
+  - model_name: deepseek
+    litellm_params:
+      model: deepseek/deepseek-chat
+      api_key: os.environ/DEEPSEEK_API_KEY
+      timeout: 300
+
+  - model_name: openrouter
+    litellm_params:
+      model: openrouter/deepseek/deepseek-chat
+      api_key: os.environ/OPENROUTER_API_KEY
+      timeout: 300
+
+  - model_name: gemini
+    litellm_params:
+      model: gemini/gemini-2.5-flash
+      api_key: os.environ/GEMINI_API_KEY
+      timeout: 300
+
+  # Local, free, and the only tier that survives every credential expiring at once.
+  - model_name: ollama
+    litellm_params:
+      model: ollama/llama3.1
+      api_base: http://host.docker.internal:11434
+      timeout: 300
+
+router_settings:
+  # The chain prospector's `noncritical_operator:` already declares, expressed once here
+  # instead of in FallbackOperator. `minimax -> minimax_m27` is the documented failover;
+  # ollama is last because it is local and cannot run out of credit.
+  fallbacks:
+    - minimax: [minimax_m27, deepseek, ollama]
+    - deepseek: [minimax, ollama]
+    - openrouter: [minimax, ollama]
+    - gemini: [minimax, ollama]
+  num_retries: 2
+  # A tier that keeps failing is taken out of the chain rather than retried into the
+  # ground. This is the circuit breaker prospector/breaker.py hand-rolls.
+  allowed_fails: 3
+  cooldown_time: 60
+
+litellm_settings:
+  # Traces to the collector that already runs. No second store.
+  callbacks: ["otel"]
+  drop_params: true
+  # Never log the prompt or the completion body. Spans carry model, latency, tokens and
+  # cost — which is what an audit trail needs — and not the content of a customer's
+  # document (LAW 21).
+  turn_off_message_logging: true
+
+general_settings:
+  master_key: os.environ/LITELLM_MASTER_KEY
+  # A CEILING, not a budget. R14 is zero spend without founder sign-off; this number is
+  # the thing that refuses a runaway loop at 03:00, not permission to spend it. Raising it
+  # is a founder decision, and the proxy is where that decision is enforced rather than
+  # hoped for.
+  max_budget: 5.0
+  budget_duration: 1d
+  # Health checks cost a call per upstream. Off by default; `litellm-status` probes
+  # liveliness, which is free.
+  background_health_checks: false
diff --git a/llm/litellm.yml b/llm/litellm.yml
new file mode 100644
index 000000000..226601d37
--- /dev/null
+++ b/llm/litellm.yml
@@ -0,0 +1,96 @@
+# LiteLLM proxy — the estate's one model router, self-hosted, sized for a laptop.
+#
+# Standard: crew/docs/STANDARDS.md "LLM providers". That row said LiteLLM was a CANDIDATE
+# and prospector's operator.py was the component. Founder ruling 2026-08-24 closed it:
+# "the decision is final" — LiteLLM is the router, operator.py's transport half retires.
+#
+# Rejected: keeping operator.py's HTTP layer. It is ~2,100 lines of hand-written urllib,
+# SSE stall detection, per-provider retry and circuit breaking, and every provider schema
+# change is internal dev time. That is the maintenance drag an acquirer prices in.
+# Rejected: OpenRouter as the single upstream — it is one vendor in front of the others,
+# which is the provider SPOF R8 bans. LiteLLM is ours, in our process, on our disk.
+#
+# WHAT STAYS IN PROSPECTOR, AND WHY LITELLM CANNOT TAKE IT.
+#   claude_cli.py (619 lines) and gemini_cli.py (254) drive locally-installed CLI binaries
+#   on a SUBSCRIPTION, not an API key. LiteLLM is an HTTP proxy to APIs; it has no way to
+#   shell out to `claude -p`. That path is the EUR 0 lane R14 depends on, and it is also
+#   `moat_primary`'s trusted tier. It is not debt, it is the moat.
+#   The JSON repair in operator.py (ParseError, balanced-brace recovery) is an output
+#   contract, not routing. A proxy returns whatever the model said; making that parse is
+#   still ours.
+#
+# WHAT IS PUBLISHED. 127.0.0.1:4000 and nothing else. Postgres is not published — LiteLLM
+# needs it for spend accounting and virtual keys, and nothing outside this project reads it
+# (LAW 21, default closed). Upstream's compose publishes it; that is a door we do not need.
+#
+# WHERE TRACES GO. To the collector that already runs, at 127.0.0.1:4318 on the host — the
+# otel-fallback receiver in observability/langfuse.yml. No second database, no second
+# dashboard, no second anything. `host.docker.internal` is pinned via extra_hosts so this
+# works on colima as well as Docker Desktop.
+#
+# MEMORY. observability/langfuse.yml already claims 3.63 GiB of ceilings. These two add
+# 768m, so check `docker stats` before raising either.
+#
+# Secrets come from llm/.env, which bin/litellm-up decrypts from the age vault and chmods
+# 600. It is gitignored and never printed.
+
+name: litellm
+
+services:
+  litellm:
+    image: ghcr.io/berriai/litellm-database:main-v1.61.20
+    container_name: litellm-proxy
+    restart: unless-stopped
+    mem_limit: 512m
+    command: ["--config", "/app/config.yaml", "--port", "4000"]
+    volumes:
+      - ./config.yaml:/app/config.yaml:ro
+    environment:
+      DATABASE_URL: postgresql://litellm:${LITELLM_DB_PASSWORD}@litellm-db:5432/litellm
+      LITELLM_MASTER_KEY: ${LITELLM_MASTER_KEY}
+      LITELLM_SALT_KEY: ${LITELLM_SALT_KEY}
+      # Upstreams. Every one of these names is already in the age vault; none has a
+      # default here, because a default that works is a credential nobody sets.
+      MINIMAX_API_KEY: ${MINIMAX_API_KEY}
+      DEEPSEEK_API_KEY: ${DEEPSEEK_API_KEY}
+      OPENROUTER_API_KEY: ${OPENROUTER_API_KEY}
+      GEMINI_API_KEY: ${GEMINI_API_KEY}
+      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY}
+      # Traces to the receiver that already exists.
+      OTEL_EXPORTER_OTLP_ENDPOINT: http://host.docker.internal:4318
+      OTEL_EXPORTER_OTLP_PROTOCOL: http/protobuf
+      OTEL_SERVICE_NAME: litellm
+    extra_hosts:
+      - "host.docker.internal:host-gateway"
+    ports:
+      - 127.0.0.1:4000:4000
+    depends_on:
+      litellm-db:
+        condition: service_healthy
+    healthcheck:
+      # /health/liveliness needs no key; /health probes every upstream and costs money.
+      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:4000/health/liveliness',timeout=4).status==200 else 1)\""]
+      interval: 15s
+      timeout: 6s
+      retries: 5
+      start_period: 40s
+
+  litellm-db:
+    image: docker.io/postgres:17-alpine
+    container_name: litellm-db
+    restart: unless-stopped
+    mem_limit: 256m
+    environment:
+      POSTGRES_USER: litellm
+      POSTGRES_PASSWORD: ${LITELLM_DB_PASSWORD}
+      POSTGRES_DB: litellm
+    volumes:
+      - litellm_db_data:/var/lib/postgresql/data
+    healthcheck:
+      test: ["CMD-SHELL", "pg_isready -U litellm -d litellm"]
+      interval: 5s
+      timeout: 5s
+      retries: 10
+
+volumes:
+  litellm_db_data: {driver: local}
diff --git a/observability/clickhouse-low-memory.xml b/observability/clickhouse-low-memory.xml
index 7980b46d4..fe1d0d155 100644
--- a/observability/clickhouse-low-memory.xml
+++ b/observability/clickhouse-low-memory.xml
@@ -36,6 +36,29 @@
     <background_common_pool_size>4</background_common_pool_size>
     <max_concurrent_queries>16</max_concurrent_queries>
 
+    <!--
+      Shrinking background_pool_size alone is not safe. ClickHouse runs a sanity
+      check at startup and REFUSES TO BOOT if the MergeTree pool reservations
+      exceed the pool that now exists:
+
+        Code: 36. DB::Exception: The value of
+        'number_of_free_entries_in_pool_to_execute_mutation' setting (20) is
+        greater than the value of
+        'background_pool_size'*'background_merges_mutations_concurrency_ratio'
+        (8). This indicates incorrect configuration because mutations cannot
+        work with these settings. (BAD_ARGUMENTS)
+
+      Those two defaults, 20 and 8, are sized against the default pool of 16.
+      With a pool of 4 and a ratio of 2 there are 8 slots, so both reservations
+      have to come down with it. They are the number of slots kept free, so 2
+      leaves 6 usable and still lets a mutation run.
+    -->
+    <merge_tree>
+        <number_of_free_entries_in_pool_to_execute_mutation>2</number_of_free_entries_in_pool_to_execute_mutation>
+        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>2</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
+        <number_of_free_entries_in_pool_to_execute_optimize_entire_partition>2</number_of_free_entries_in_pool_to_execute_optimize_entire_partition>
+    </merge_tree>
+
     <!-- Logs otherwise grow without bound in a volume nobody looks at. -->
     <logger>
         <level>warning</level>
