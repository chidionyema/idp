+# still reads it, and 3.0.1 is not a replacement, it is the regulator's ask.
 log "sbom      scanning $TARGET"
 syft scan "dir:$TARGET" --select-catalogers "+javascript-package-cataloger" \
                         -o json="$OUT/sbom.syft.json" \
                         -o spdx-json="$OUT/sbom.spdx.json" \
+                        -o spdx-json@3="$OUT/sbom.spdx3.json" \
                         -o cyclonedx-json="$OUT/sbom.cyclonedx.json" -q
 n=$(/usr/local/bin/jq '.artifacts|length' "$OUT/sbom.syft.json")
 lic=$(/usr/local/bin/jq '[.artifacts[]|select((.licenses|length)>0)]|length' "$OUT/sbom.syft.json")
-log "sbom      $n packages, $lic with a declared licence -> reports/sbom.{syft,spdx,cyclonedx}.json"
+log "sbom      $n packages, $lic with a declared licence -> reports/sbom.{syft,spdx,spdx3,cyclonedx}.json"
+log "sbom      sbom.spdx3.json is SPDX-3.0.1, unvalidated -- no tool on this machine checks it (crew#96 AC4)"
+
+# --- 1b. does the SBOM validate --------------------------------------------
+# A 12MB CycloneDX file nothing checks is a metadata slot, not a self-
+# describing asset (crew#96). --fail-on-errors is not optional: without it
+# cyclonedx validate passes on warnings silently. This one is a real gate --
+# set -e stops the script here if the BOM is invalid. sbomqs score and
+# --bsi-v2 compliance are reported, same as the vuln counts below, because
+# neither tool exits non-zero on a low score -- the number is the signal.
+log "sbom      validating against the CycloneDX schema"
+cyclonedx validate --input-file "$OUT/sbom.cyclonedx.json" --fail-on-errors
+score=$(sbomqs score "$OUT/sbom.cyclonedx.json" | head -1 | grep -oE '[0-9]+\.[0-9]+/10\.0' | head -1)
+bsi=$(sbomqs compliance --bsi-v2 --basic "$OUT/sbom.cyclonedx.json" | tail -1)
+log "sbom      valid, quality $score, $bsi"
 
 # --- 2. vulnerabilities -------------------------------------------------------
 # Scanning the SBOM, not the directory again. Same answer, seconds instead of
