@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+# What the router is, what it is routing, and what it has spent.
+#
+# Standard: bin/langfuse-status's contract -- exit non-zero only when the thing is actually
+# down, because a status command that returns 0 either way cannot be used as a check
+# (LAW 28).
+# Rejected: `docker ps | grep litellm`, which reports that a container exists and not that
+# the proxy answers. A running container with a refused config is the exact failure this
+# has to catch.
+set -uo pipefail
+
+IDP="$HOME/dev/code/idp"
+LLM="$IDP/llm"
+ENVF="$LLM/.env"
+
+probe() {
+  local c
+  c=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "$1" 2>/dev/null || true)
+  case "$c" in "" | 000) echo "down" ;; *) echo "$c" ;; esac
+}
+
+live=$(probe http://127.0.0.1:4000/health/liveliness)
+echo "PROXY      LOCAL                          HTTP   BASE URL FOR EVERY AGENT"
+printf "%-10s %-30s %-6s %s\n" "litellm" "127.0.0.1:4000" "$live" "http://127.0.0.1:4000/v1"
+
+echo
+echo "MODELS IT SERVES"
+if [ "$live" = "200" ] && [ -r "$ENVF" ]; then
+  # The master key authenticates; it is passed on stdin-ish via the environment and never
+  # echoed. `grep -m1` reads one line out of a 600 file into this process only.
+  key=$(grep -m1 '^LITELLM_MASTER_KEY=' "$ENVF" | cut -d= -f2-)
+  curl -sS --max-time 6 -H "Authorization: Bearer $key" http://127.0.0.1:4000/v1/models 2>/dev/null \
+    | python3 -c 'import json,sys
+try:
+    d = json.load(sys.stdin)
+except Exception:
+    print("  could not parse the model list"); raise SystemExit
+for m in d.get("data", []):
+    print("  " + m.get("id", "?"))' || echo "  none returned"
+else
+  echo "  proxy is not answering -- bin/litellm-up"
+fi
+
+echo
+echo "CONTAINERS"
+names=$(docker ps --filter 'label=com.docker.compose.project=litellm' --format '{{.Names}}' 2>/dev/null)
+if [ -n "$names" ]; then
+  # shellcheck disable=SC2086
+  docker stats --no-stream --format '  {{.Name}}\t{{.MemUsage}}\t{{.CPUPerc}}' $names 2>/dev/null \
+    | sort | expand -t 34,58
+  echo "  ---"
+  echo "  ceilings: litellm 512m + litellm-db 256m = 768m"
+else
+  echo "  none running -- bin/litellm-up"
+fi
+
+echo
+echo "WHAT STILL DOES NOT GO THROUGH THIS PROXY, ON PURPOSE"
+echo "  claude_cli   local CLI on a subscription, not an API key -- prospector/claude_cli.py"
+echo "  gemini_cli   same -- prospector/gemini_cli.py"
+
+[ "$live" = "200" ] || exit 1
+exit 0
diff --git a/bin/litellm-up b/bin/litellm-up
new file mode 100755
index 000000000..addc580e3
--- /dev/null
+++ b/bin/litellm-up
@@ -0,0 +1,100 @@
+#!/usr/bin/env bash
+# Start the LiteLLM proxy. Safe to run repeatedly.
+#
+# Standard: this is bin/langfuse-up's shape, deliberately. The estate has one way to bring
+# a compose stack up on this laptop -- validate the config the service will refuse, build a
+# 600 .env nothing prints, then `compose up -d` -- and a second shape would be the
+# stitching the headline of $HOME/AGENTS.md bans.
+# Rejected: `docker compose up` typed by hand, because it skips the config validation below
+# and because the founder does not run scripts with six flags (LAW 31).
+#
+# SECRETS. Every upstream key comes out of the age vault at run time and lands in llm/.env
+# at mode 600, gitignored, never printed (LAW 21). The proxy's own three secrets are
+# generated once with openssl and never regenerated -- LITELLM_SALT_KEY rotates the
+# encryption of every stored virtual key, so overwriting it makes them unreadable.
+set -euo pipefail
+
+IDP="$HOME/dev/code/idp"
+LLM="$IDP/llm"
+ENVF="$LLM/.env"
+AGE_BLOB="$HOME/dev/code/prospector-main/deploy/secrets.env.age"
+AGE_ID="$HOME/.config/prospector/age-key.txt"
+COMPOSE=(docker compose --env-file "$ENVF" -f "$LLM/litellm.yml")
+
+log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }
+
+command -v docker >/dev/null || { echo "docker is not installed"; exit 2; }
+docker info >/dev/null 2>&1 || {
+  echo "FAIL  the docker daemon is not reachable, so nothing can start."
+  echo "      context: $(docker context show 2>/dev/null)"
+  echo "      This is an outage to route, not a thing to restart blindly (crew#85)."
+  exit 2
+}
+
+# Validate the config the service will refuse to start without.
+#
+# The class, not the instance: a config file whose syntax is never checked before the
+# service that reads it starts. ClickHouse cost three hours to a double hyphen in an XML
+# comment, and it presented as containers stuck in Created -- which reads like "not reached
+# yet", not like a fault. LiteLLM fails the same way: a malformed config.yaml exits the
+# container before it binds, and compose reports it as restarting.
+CFG="$LLM/config.yaml"
+if python3 -c 'import yaml' >/dev/null 2>&1; then
+  if ! python3 -c "import sys,yaml; yaml.safe_load(open(sys.argv[1]))" "$CFG" 2>/tmp/litellm-yaml.$$; then
+    echo "FAIL  $CFG is not valid YAML, so LiteLLM would refuse it and exit:"
+    sed 's/^/        /' /tmp/litellm-yaml.$$
+    rm -f /tmp/litellm-yaml.$$
+    exit 2
+  fi
+  rm -f /tmp/litellm-yaml.$$
+  log "config.yaml is valid YAML"
+else
+  # A guard that cannot reach its evidence says so rather than returning a verdict.
+  log "BLIND  pyyaml is not importable, so $CFG was NOT validated"
+fi
+
+# --- secrets ------------------------------------------------------------------
+umask 077
+if [ ! -f "$ENVF" ]; then
+  [ -r "$AGE_BLOB" ] || { echo "FAIL  no age vault at $AGE_BLOB"; exit 2; }
+  [ -r "$AGE_ID" ]   || { echo "FAIL  no age identity at $AGE_ID"; exit 2; }
+  command -v age >/dev/null || { echo "FAIL  age is not installed"; exit 2; }
+  # Only the upstream keys this proxy needs. Decrypting 22 secrets into a file that only
+  # needs 5 is a blast radius nobody chose.
+  age -d -i "$AGE_ID" "$AGE_BLOB" \
+    | grep -E '^(MINIMAX_API_KEY|DEEPSEEK_API_KEY|OPENROUTER_API_KEY|GEMINI_API_KEY|ANTHROPIC_API_KEY)=' \
+    > "$ENVF"
+  {
+    echo "LITELLM_MASTER_KEY=sk-$(openssl rand -hex 24)"
+    echo "LITELLM_SALT_KEY=sk-$(openssl rand -hex 24)"
+    echo "LITELLM_DB_PASSWORD=$(openssl rand -hex 24)"
+  } >> "$ENVF"
+  chmod 600 "$ENVF"
+  log "wrote $ENVF (mode 600, gitignored, never printed)"
+else
+  log "$ENVF exists, reusing it"
+fi
+
+# Which upstreams actually have a credential. NAMES only -- a missing key is a routing
+# fact the operator needs, and the value is never the way to report it.
+log "upstream credentials present:"
+for k in MINIMAX_API_KEY DEEPSEEK_API_KEY OPENROUTER_API_KEY GEMINI_API_KEY ANTHROPIC_API_KEY; do
+  if grep -q "^$k=." "$ENVF"; then echo "    $k    present"; else echo "    $k    MISSING - that tier will fail over"; fi
+done
+
+log "starting"
+"${COMPOSE[@]}" up -d --remove-orphans
+
+log "waiting for the proxy to answer"
+for _ in $(seq 1 40); do
+  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 3 http://127.0.0.1:4000/health/liveliness 2>/dev/null || true)
+  if [ "$code" = "200" ]; then
+    log "up: http://127.0.0.1:4000  (bin/litellm-status for what it is routing)"
+    exit 0
+  fi
+  sleep 3
+done
+
+echo "FAIL  the proxy did not answer on 127.0.0.1:4000 within 120s."
+echo "      $("${COMPOSE[@]}" ps --format '{{.Name}} {{.State}} {{.Status}}' 2>/dev/null | tr '\n' '; ')"
+exit 1
