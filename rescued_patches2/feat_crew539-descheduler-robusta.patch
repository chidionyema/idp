@@ -0,0 +1,14 @@
+# The Telegram bot and home channel Robusta posts to: the same vault entry the Flux alerts
+# Provider reads (`flux-telegram`, keys token and channel), through the one ClusterSecretStore.
+# No literal names a bot or a chat (LAW 46); the runner reads both as env vars.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: robusta-telegram
+  namespace: robusta
+spec:
+  refreshInterval: 1h
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: robusta-telegram, creationPolicy: Owner }
+  dataFrom:
+    - extract: { key: flux-telegram }
