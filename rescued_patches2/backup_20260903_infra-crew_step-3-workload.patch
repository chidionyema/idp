+# ghcr-pull for this namespace, mirrored from backstage/ghcr-pull through the ClusterSecretStore
+# ghcr-pull (platform/image-automation/pull-secret.yaml, crew#396 step 2), the same way
+# platform/mcp/pull-secret.yaml does it.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
