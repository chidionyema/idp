diff --git a/bin/idp-oci-login b/bin/idp-oci-login
index ef419582a..db03b8370 100755
--- a/bin/idp-oci-login
+++ b/bin/idp-oci-login
@@ -24,6 +24,10 @@ if [ "${OCI_CI:-}" = 1 ]; then
   AUTH=SecurityToken; PROFILE="${OCI_CLI_PROFILE:-DEFAULT}"; export OCI_CLI_AUTH=security_token OCI_CLI_PROFILE="$PROFILE"
   grep -q '^security_token_file' "$HOME/.oci/config" 2>/dev/null || { echo "BLIND oci     OCI_CI=1 but ~/.oci/config holds no session token: run the token exchange step first"; exit 2; }
 else
+  # crew#227 CP2 residual (2026-08-26): the laptop path no longer renders the API key. The
+  # platform is checked, planned and applied from Actions on a machine identity (R26: infra
+  # is never Mac-bound). OCI_LAPTOP_KEY=1 is the transition escape until the key is deleted.
+  [ "${OCI_LAPTOP_KEY:-}" = 1 ] || { echo "BLIND oci     laptop runs render no key; run the platform from Actions: gh workflow run oke-check.yml -f mode=check|apply (OCI_LAPTOP_KEY=1 to override until crew#227 deletes the key)"; exit 2; }
   command -v sops >/dev/null || { echo "BLIND sops missing"; exit 2; }
   vget() { sops -d --extract "[\"$1\"]" "$VAULT/secrets/$ENV_NAME/$1.yaml" 2>/dev/null; }
   [ -e "$VAULT/secrets/$ENV_NAME/OCI_FINGERPRINT.yaml" ] || { echo "BLIND oci     no API key in the vault yet; run bin/idp-oci-bootstrap"; exit 2; }
diff --git a/features/self-aware-platform/cp7_token_receipt.feature b/features/self-aware-platform/cp7_token_receipt.feature
index d3c48cae2..93161ca97 100644
--- a/features/self-aware-platform/cp7_token_receipt.feature
+++ b/features/self-aware-platform/cp7_token_receipt.feature
@@ -31,3 +31,11 @@ Feature: Token receipt — the waste the founder named, measured before and afte
       for before-tool-calls, after-tool-calls, before-tokens, after-tokens
     And the script's exit code is nonzero if any "after" row fails to
       complete, so a broken measurement cannot print a comparison
+
+  Scenario: The laptop path renders no key
+    Given bin/idp-oci-login runs without OCI_CI=1
+    And OCI_LAPTOP_KEY is not set
+    Then it prints BLIND naming gh workflow run oke-check.yml as the way to run the platform
+    And no file is written under ~/.oci
+    When OCI_LAPTOP_KEY=1 is set
+    Then the API key path still renders, until crew#227 deletes the key
