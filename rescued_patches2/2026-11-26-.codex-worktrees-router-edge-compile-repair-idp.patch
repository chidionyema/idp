+# Drop-in patch for platform/estate/governance/laws.yaml
+context_governance_laws:
+  - id: LAW_CONTEXT_BUDGET_COHERENCE
+    version: "1.0.0"
+    enforcement: PHASED_SHADOW_TO_HARD_FAIL_CLOSED
+    applies_to: [lane_1_cloudflare, lane_2_oci, lane_3_github_actions, cline, codex, opencode, agent_sandbox]
+    invariant: >
+      All fleet agents route exclusively through meridian-router-edge (BudgetLedgerDO) with
