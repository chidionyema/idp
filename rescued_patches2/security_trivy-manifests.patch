@@ -506,6 +506,13 @@ gvisor_cell_fence_gate() { python3 "$IDP/bin/gvisor-cell-fence-gate" "$1" >/dev/
 # TTL past the ceiling, or no rate limit. Takes one fixture path so the rung proves it both ways in
