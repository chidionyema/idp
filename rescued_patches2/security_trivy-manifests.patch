 # WJ.8: grades ONE pull request against the glass-break set -- the broker, its catalogue, the RBAC
 # floor, bin/idp-kube and the gates. An agent that can edit those does not need to ask the broker
@@ -563,6 +570,19 @@ else
   say "FAIL  jitgrant idp-jit-grants cannot tell a time-boxed grant from a route to admin (WJ.5)"; fail=1
 fi
 
+# 6b-bis. WJ.5 applied to the broker's own ClusterRole. Without `escalate` and `bind`, Kubernetes'
+#     escalation-prevention rule caps every Role the broker writes at the permissions the broker
+#     already holds -- that is the whole difference between "may mint what it holds" and "may mint
+#     anything", and it is why KSV-0050 is an accepted risk on that file rather than a defect.
+#     Graded on the live floor as well as both fixtures, so the waiver cannot outlive its reason.
+if ! jit_broker_role_gate "$IDP/tests/fixtures/jit-broker-role/bad.yaml" \
+   && jit_broker_role_gate "$IDP/tests/fixtures/jit-broker-role/good.yaml" \
+   && jit_broker_role_gate "$IDP/platform/jit/rbac.yaml"; then
+  say "ok    jitfloor the broker mints only what it already holds: no escalate, no bind, no cluster-wide binding"
+else
+  say "FAIL  jitfloor the broker's own ClusterRole could mint more than it holds (WJ.5, KSV-0050)"; fail=1
