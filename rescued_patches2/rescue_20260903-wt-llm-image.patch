-                sleep 120
-              done
-          env:
-            - { name: HOME, value: /tmp }   # the CLI writes its cache under HOME; the root fs is read-only
-          readinessProbe:
-            exec: { command: ["test", "-f", "/tmp/ok"] }
-            initialDelaySeconds: 5
-            periodSeconds: 30
-          livenessProbe:
-            exec: { command: ["test", "-f", "/tmp/ok"] }
-            initialDelaySeconds: 30
-            periodSeconds: 60
-          volumeMounts:
-            - { name: canary, mountPath: /canary, readOnly: true }
-            - { name: tmp, mountPath: /tmp }
-          resources:
-            requests: { cpu: 25m, memory: 64Mi }
-            limits: { cpu: 100m, memory: 128Mi }
-          securityContext:
-            allowPrivilegeEscalation: false
-            readOnlyRootFilesystem: true
-            capabilities: { drop: [ALL] }
-      volumes:
-        - name: canary
-          secret: { secretName: rotation-canary }
-        - name: tmp
-          emptyDir: {}
