-    except (OSError, ValueError) as e:
-        print(f"SKIP    cannot read {argv[0]}: {e}")
-        return 0
-    v, why = verdict(pr, required_contexts())
-    print(f"{v}    {why}")
-    return 0
-
-
-if __name__ == "__main__":
-    sys.exit(main(sys.argv[1:]))
