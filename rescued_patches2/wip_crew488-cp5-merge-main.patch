+# The OKE shape of the portal's namespace: the base plus the label that arms admission.
+#
+# The label is here and not in the base for the reason the backstage overlay gave when it carried
+# this patch: `platform/scheduling/require-availability.yaml` refuses a Deployment below the
+# standard in any namespace carrying it, and the base is the k3d shape -- one node, one replica --
+# where that policy would refuse correct work (LAW 38).
+apiVersion: kustomize.config.k8s.io/v1beta1
+kind: Kustomization
+resources:
+  - ../../base
+patches:
+  - target:
+      kind: Namespace
+      name: backstage
+    patch: |
+      - op: add
+        path: /metadata/labels/availability.idp~1tier
+        value: founder-facing
