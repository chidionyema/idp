+++ b/platform/edge/external-dns-exception.yaml
@@ -0,0 +1,22 @@
+# crew#488 CP5: external-dns (chart 1.21.1) is a singleton controller: one process owns the
+# TXT-registry writes and the chart has no leader election, so two replicas would race each other
+# on the same records (upstream docs, "External DNS runs as a single pod"). It renders into namespace
+# edge, which is tier founder-facing for the front door (traefik), so require-availability denied it
+# on the 2026-08-28 drill (run 33214748124: "[founder-facing-runs-two] fail (blocked)"). Scoped to
+# the one Deployment; traefik keeps both rules. Lives here because Kyverno honours exceptions from
+# namespace kyverno only (crew#325).
+apiVersion: kyverno.io/v2
+kind: PolicyException
+metadata:
+  name: external-dns-singleton
+  namespace: kyverno
+spec:
+  exceptions:
+    - policyName: require-availability
+      ruleNames: [founder-facing-runs-two, founder-facing-spreads-across-nodes]
+  match:
+    any:
+      - resources:
+          kinds: [Deployment]
+          namespaces: [edge]
+          names: [external-dns]
