+while read -r repo; do apply_spec "$repo" "$DEFAULT"; done < <(gh repo list "$OWNER" --limit 200 --no-archived --json name -q '.[].name' | sort)
+for f in "$IDP"/platform/github/ruleset.*.*.json; do
+  [ -e "$f" ] || break
+  r="$(basename "$f")"; r="${r#ruleset.}"; r="${r%%.*}"
+  apply_spec "$r" "$f"
+done
+echo "$([ $drift = 0 ] && echo 'ok  ' || echo FAIL)  rulesets $ok in place, $drift missing or drifted, $blocked private repos blocked by plan"
