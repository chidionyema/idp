                 row["tags"] = (st.get("lastScanResult") or {}).get("tagCount")
             flux.append(row)
     flux_not_ready = [r for r in flux if not r["ready"]]
+    # crew#401 CP4: the hostnames the cluster publishes (HTTPRoute). bin/idp-catalogue-drift diffs
