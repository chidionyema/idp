+# button: Put the open models into the cluster
+# founder: Takes every model that has been fetched and starts it running in the cluster, one small program each. Re-running it after a new model is fetched is the whole job.
+# button, above, is the header bin/idp-portal-buttons turns into a Backstage template. Every
+# founder-facing workflow carries the pair, and the gate refuses one without it.
+#
+# WHY A WORKFLOW AND NOT A LAPTOP. `bin/idp-expert-manifest` reads GHCR and writes one Deployment
+# per published artifact; `kubectl apply` puts them in the cluster. Both need the cluster's
+# credentials, which a runner gets from the estate's own OIDC path -- not from somebody's shell.
+name: deploy-models
+
+on:
+  workflow_dispatch:
+    inputs:
+      replicas:
+        description: "how many of each model to run (0 stops them all)"
+        required: false
+        default: "1"
+
+permissions:
+  contents: read
+  id-token: write
+  packages: read
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: "3.12"
+
+      - name: generate one Deployment per published artifact
+        id: gen
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          set -euo pipefail
+          bin/idp-expert-manifest
+          COUNT=$(grep -c '^kind: Deployment' platform/edge-runtime/deploy/experts-generated.yaml || true)
+          echo "count=$COUNT" >> "$GITHUB_OUTPUT"
+          echo "ok      generated $COUNT Deployment(s) from the artifacts in GHCR"
+          # A run that generates NOTHING must not report success: an empty manifest applies cleanly
+          # and would look exactly like a deployment that worked.
+          [ "$COUNT" -gt 0 ] || { echo "FAIL no model artifacts found in GHCR; run the fetch button first"; exit 1; }
+
+      - name: the manifest must not be stale
+        run: |
+          set -euo pipefail
+          # --check compares the generated bytes with what is committed. A drift means somebody
+          # fetched a model and did not commit the manifest, and the apply below would silently use
+          # the older file.
+          cp platform/edge-runtime/deploy/experts-generated.yaml /tmp/generated.yaml
+          bin/idp-expert-manifest --check || {
+            echo "FAIL experts-generated.yaml is stale; commit the regenerated file"; exit 1; }
+
+      - name: trivy on the manifest
+        run: |
+          set -euo pipefail
+          curl -sSL -o /tmp/trivy.tgz \
+            https://github.com/aquasecurity/trivy/releases/download/v0.74.0/trivy_0.74.0_Linux-64bit.tar.gz
+          sudo tar -xz -C /usr/local/bin -f /tmp/trivy.tgz trivy
+          # The SAME severity floor the estate's own security-scan uses. A HIGH here is a pod that
+          # will be refused by admission, discovered after a 4 GB pull instead of before it.
+          trivy config --severity HIGH,CRITICAL --exit-code 1 platform/edge-runtime/deploy/
+          echo "ok      no HIGH or CRITICAL misconfiguration in the generated manifest"
+
+      - name: reach the cluster
+        uses: ./.github/actions/k3d-estate   # the estate's own path to credentials; never a pasted kubeconfig
+        with:
+          mode: reach
+
+      - name: apply
+        env:
+          REPLICAS: ${{ inputs.replicas }}
+        run: |
+          set -euo pipefail
+          kubectl apply -f platform/edge-runtime/deploy/experts-generated.yaml
+          if [ "$REPLICAS" != "1" ]; then
+            for d in $(kubectl get deploy -n edge-runtime -o name | grep expert-); do
+              kubectl scale "$d" -n edge-runtime --replicas="$REPLICAS"
+            done
+          fi
+          kubectl get pods -n edge-runtime
+
+      - name: they must actually become ready
+        run: |
+          set -euo pipefail
+          # A green apply is not a working model. This waits for readiness, and a timeout is a FAIL
+          # -- the difference between "the manifest was accepted" and "the model answers".
+          kubectl wait --for=condition=Ready pod -l app \
+            -n edge-runtime --all --timeout=600s \
+            || { echo "FAIL a model did not become Ready in 10 minutes:"; kubectl describe pods -n edge-runtime | tail -60; exit 1; }
+          echo "ok      every model is Ready"
