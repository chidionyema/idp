@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# Print, one per line, the drills/catalogue.yaml copies the operating-model gate may judge a
+# `Drill: <name>` line against: the catalogue on IDP_ROOT (main) and the catalogue at the pull
+# request's head.
+#
+# The head copy is fetched UNCONDITIONALLY. It used to be fetched only when the pull request's
+# own diff touched drills/catalogue.yaml, which refused correct work in two shapes: idp#191
+# named the row it added, and idp#1014 named `otto-parity`, a row its branch carried from an
+# ancestor (edcf54d4/#1013) that had not yet reached main — run 33330388899 judged against
+# f92233e4. A guard that refuses correct work is an outage (LAW 38).
+#
+# A head copy that cannot be fetched (no network, no such path on that ref) is skipped and
+# named on stderr; bin/idp-drill-names treats a missing file as adding nothing.
+#
+# Usage: idp-pr-catalogues <pr-number> <idp-root> <out-file>
+set -euo pipefail
+on_exit() {
+	rc=$?
+	case $rc in 0) ;; *) printf 'FAIL    pr-catalogues exit %s\n' "$rc" >&2 ;; esac
+}
+trap on_exit EXIT
+
+n=${1:?pr number}
+idp=${2:?idp root}
+out=${3:?out file}
+
+printf '%s\n' "$idp/drills/catalogue.yaml"
+
+head_sha=$(gh pr view "$n" --json headRefOid -q .headRefOid 2>/dev/null || true)
+repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
+if [ -z "$head_sha" ] || [ -z "$repo" ]; then
+	echo "idp-pr-catalogues: no head sha or repo for #$n; head catalogue skipped" >&2
+	exit 0
+fi
+if gh api "repos/$repo/contents/drills/catalogue.yaml?ref=$head_sha" \
+	-H 'Accept: application/vnd.github.raw+json' >"$out" 2>/dev/null; then
+	printf '%s\n' "$out"
+else
+	echo "idp-pr-catalogues: no drills/catalogue.yaml at $head_sha; head catalogue skipped" >&2
+fi
