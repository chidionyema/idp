+++ b/platform/hermes-agent/langfuse-key.yaml
@@ -0,0 +1,20 @@
+# crew#717 wave 1 (founder 2026-08-30 "i need otto sorted once and for all"): every Otto turn
+# is a trace in the estate's Langfuse (LAW 50). The keys are the project keys Langfuse was
+# initialised with (platform/observability, vault entries langfuse-init-public-key /
+# langfuse-init-secret-key — the same pair LiteLLM traces with, platform/llm). Projected into
+# the pod's env dir; the hermes observability/langfuse plugin gates itself on them, so a pod
+# without the secret still boots and the otto-parity row is the thing that goes red.
+apiVersion: external-secrets.io/v1
+kind: ExternalSecret
+metadata:
+  name: hermes-agent-langfuse
+  namespace: hermes-agent
+spec:
+  refreshInterval: 1h
+  secretStoreRef: { kind: ClusterSecretStore, name: estate-vault }
+  target: { name: hermes-agent-langfuse, creationPolicy: Owner }
+  data:
+    - secretKey: LANGFUSE_PUBLIC_KEY
+      remoteRef: { key: langfuse-init-public-key }
+    - secretKey: LANGFUSE_SECRET_KEY
+      remoteRef: { key: langfuse-init-secret-key }
