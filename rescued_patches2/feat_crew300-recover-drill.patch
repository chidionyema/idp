index 000000000..53b462f22
--- /dev/null
+++ b/.github/workflows/recover-drill.yml
@@ -0,0 +1,66 @@
+# crew#300 / crew#516 CP8: the estate comes back on a machine that has never seen it.
+#
+# A clean ubuntu runner exchanges its GitHub OIDC token for a one-hour OCI session as the service
+# user estate-ci (the identity oke-check.yml and verify-drill.yml already run on), then
+# bin/idp-recover-drill clones every load-bearing repo with an App token, reads back and verifies
+# every escrow bundle in R2, and boots the platform's own drill from the fresh clone. The receipt
+# is the artifact; the drills row recover-clean-machine grades its age. Weekly, and on any PR that
+# touches the drill, so the change ships with its green run (LAW 22). Cost: £0, GitHub runner.
+name: recover-drill
+on:
+  schedule:
+    - cron: "41 4 * * 0"   # weekly; drills/catalogue.yaml row recover-clean-machine
+  workflow_dispatch: {}
+  pull_request:
+    paths:
+      - .github/workflows/recover-drill.yml
+      - bin/idp-recover-drill
+      - bin/idp-github-app
+      - platform/github-app/lanes.json
+permissions:
+  id-token: write   # the OIDC token this job trades for OCI access
+  contents: read
+concurrency:
+  group: recover-drill-${{ github.ref }}
+  cancel-in-progress: true
+jobs:
+  recover:
+    if: github.actor != 'dependabot[bot]'
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
+      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
+        with: { python-version: "3.12" }
+      - name: oci cli and rclone (the bundle reader the Mac's escrow job also uses)
+        run: |
+          pip install -q oci-cli
+          sudo apt-get install -y -qq rclone >/dev/null
+          rclone version | head -1
+      - name: OCI session token from the GitHub OIDC token
+        uses: gtrevorrow/oci-token-exchange-action@e8b0200e63131e48bc425ea4abf99135201b1e40 # v2
+        with:
+          oidc_client_identifier: ${{ secrets.OIDC_CLIENT_IDENTIFIER }}
+          domain_base_url: ${{ vars.DOMAIN_BASE_URL }}
+          oci_tenancy: ${{ secrets.OCI_TENANCY_OCID }}
+          oci_region: ${{ vars.OCI_REGION }}
+      - name: bin/idp-recover-drill
+        env:
+          OCI_CLI_AUTH: security_token   # every oci call in the run uses the exchanged session token
+          OCI_COMPARTMENT_OCID: ${{ vars.OCI_COMPARTMENT_OCID }}
+          OCI_REGION: ${{ vars.OCI_REGION }}
+          OCI_OS_NAMESPACE: ${{ vars.OCI_OS_NAMESPACE }}
+          RECOVER_RECEIPT_DIR: ${{ github.workspace }}/receipt
+          RECOVER_BOOT_GH_TOKEN: ${{ github.token }}   # boot only: the fresh clone's drills row reads run history (run 33133083820: 'gh is not authenticated'); clones stay on the App lane
+        run: |
+          set -o pipefail
+          bin/idp-recover-drill 2>&1 | tee drill.out
+      - name: the verdict is on the run summary, pass or fail
+        if: always()
+        run: |
+          printf '### recover-drill\n```\n%s\n```\n' "$(cat drill.out 2>/dev/null || echo 'no verdict: the drill died before printing one')" >> "$GITHUB_STEP_SUMMARY"
+      - uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4.6.2
+        if: always()
+        with:
+          name: recover-receipt
+          path: receipt/
