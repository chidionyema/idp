diff --git a/bin/idp-pr-secrets b/bin/idp-pr-secrets
new file mode 100755
index 000000000..58a6a29b7
--- /dev/null
+++ b/bin/idp-pr-secrets
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# idp-pr-secrets: gitleaks over the lines a pull request ADDS, before the PR is opened.
+#
+# Incident, 2026-08-27 (crew#539, idp#485): a vault-seed line `put k8sgpt key=<NAME>_LLM_API_KEY`
+# named a field, not a value, but gitleaks reads `key=<UPPER>_API_KEY` as a generic-api-key and
+# (this comment spells it with a placeholder because the literal form fails this very gate) and
+# the security-scan job went red on the PR (and, with fetch-depth 0, on every open PR until
+# idp#494). The line had passed bin/pr-report, which ran conftest only. LAW 45: the local gate
+# now runs the same detector over the same lines CI will read, so a flagged line is refused on
+# the laptop, never in a job log.
+#
+#   idp-pr-secrets FILE      FILE holds the added lines of the diff (bin/pr-report writes
+#                            reports/pr-added.txt); stdin when FILE is -
+#
+# Prints one line: `ok      secrets   gitleaks <version>: no leaks in N added lines`, or
+# `FAIL    secrets   gitleaks found N leak(s) in the added lines` followed by the redacted
+# findings, or `BLIND   secrets   gitleaks not on PATH (brew install gitleaks)`.
+# Exit 0 ok, 1 FAIL, 2 BLIND. BLIND is never a pass: pr-report exits 2 on it, the same way it
+# does for a missing gh or conftest, so CI installs gitleaks (operating-model-gate.yml) and a
+# laptop without it is told what to install.
+set -uo pipefail
+f="${1:?added-lines file, or -}"
+command -v gitleaks >/dev/null || { echo "BLIND   secrets   gitleaks not on PATH (brew install gitleaks)"; exit 2; }
+if [ "$f" = "-" ]; then f=$(mktemp); cat > "$f"; fi
+[ -r "$f" ] || { echo "BLIND   secrets   cannot read $f"; exit 2; }
+n=$(wc -l < "$f" | tr -d ' ')
+out=$(gitleaks stdin --no-banner --redact --exit-code 1 < "$f" 2>&1); rc=$?
+if [ "$rc" -eq 0 ]; then
+  echo "ok      secrets   gitleaks $(gitleaks version 2>/dev/null): no leaks in $n added lines"; exit 0
+elif [ "$rc" -eq 1 ]; then
+  leaks=$(printf '%s\n' "$out" | grep -oE 'leaks found: [0-9]+' | grep -oE '[0-9]+' | tail -1)
+  echo "FAIL    secrets   gitleaks found ${leaks:-?} leak(s) in the added lines"
+  printf '%s\n' "$out" | grep -E '^(Finding|RuleID|Line):' | sed 's/^/        /'
+  exit 1
+else
+  echo "BLIND   secrets   gitleaks exited $rc"; printf '%s\n' "$out" | tail -5 | sed 's/^/        /'; exit 2
+fi
