# Names only. Values come from the deployment's secret store.
# See README.md for what each one does.

CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Native Mailjet delivery (alternative to existing webhook and Telegram routes).
# Do not invent addresses. Sender must be verified on the Mailjet account.
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MERDIAN_ENQUIRIES_FROM=
MERDIAN_ENQUIRIES_TO=

# Optional private Telegram delivery (dedicated authorised channel only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
