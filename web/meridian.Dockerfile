# syntax=docker/dockerfile:1
# The Meridian Intelligence site as the cluster runs it.
#
# Found by bin/dockerfiles as image `meridian` with context `web/` (a `<name>.Dockerfile`
# is named by its stem), so a change to web/package.json or web/app/** rebuilds exactly
# this image and nothing else. The build runs `npm run build`, which is voice-lint && next
# build: the copy rules and the site cannot come apart, because an image that fails the
# voice gate is never produced.
#
# Standalone output (web/next.config.mjs) is what makes this small: Next traces the files
# the server actually imports and emits server.js plus the used modules, so the runtime
# stage carries no node_modules tree and no build toolchain.
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS run
WORKDIR /app
# 65532 is the uid every workload in this estate runs as (platform/jit/deployment.yaml), and
# the namespace enforces restricted pod security: no root, no capabilities, no privilege gain.
RUN addgroup -g 65532 -S meridian && adduser -u 65532 -S meridian -G meridian
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=8080 \
    HOSTNAME=0.0.0.0
COPY --from=build --chown=65532:65532 /app/.next/standalone ./
COPY --from=build --chown=65532:65532 /app/.next/static ./.next/static
COPY --from=build --chown=65532:65532 /app/public ./public
USER 65532:65532
EXPOSE 8080
# server.js is generated by the standalone output; the site itself is the health check
# (GET / renders the homepage), so there is no second health endpoint to drift from it.
CMD ["node", "server.js"]
