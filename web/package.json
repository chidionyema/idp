{
  "name": "meridian-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/voice-lint.mjs && next build",
    "start": "next start --port 3000",
    "voice": "node scripts/voice-lint.mjs",
    "voice:report": "node scripts/voice-lint.mjs --report",
    "voice:self-test": "node scripts/voice-lint.mjs --self-test",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/contact.test.ts",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "verify": "npm run typecheck && npm run voice && npm run lint && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "^8.5.23"
  }
}
