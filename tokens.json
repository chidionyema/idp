{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "The estate's one design source (crew#694 CP2). Seeded from backstage/packages/app/src/modules/theme/tokens.ts (crew#459 'quiet instrument') and Store.Web Brand v3. Every front end imports the built output; no product carries a colour, size or easing literal of its own.",
  "color": {
    "light": {
      "canvas":        { "$type": "color", "$value": "#ffffff" },
      "surface-1":     { "$type": "color", "$value": "#f9fafb" },
      "surface-2":     { "$type": "color", "$value": "#ffffff" },
      "surface-3":     { "$type": "color", "$value": "#f2f4f7" },
      "border-subtle": { "$type": "color", "$value": "#edeff2" },
      "border":        { "$type": "color", "$value": "#e4e7ec" },
      "border-strong": { "$type": "color", "$value": "#8791a3", "$description": "Raised from #d0d5dd (1.47:1) to clear 3:1 on canvas, SC 1.4.11; measured by guards/contrast.mjs 2026-09-30." },
      "text":          { "$type": "color", "$value": "#0b0c0e" },
      "text-2":        { "$type": "color", "$value": "#4a515c" },
      "text-muted":    { "$type": "color", "$value": "#5f6b7a", "$description": "Raised from #667085 so it clears 4.5:1 on surface-3 (measured by guards/contrast.mjs)." },
      "accent":        { "$type": "color", "$value": "#175cd3" },
      "accent-pressed":{ "$type": "color", "$value": "#0f4bb5" },
      "accent-soft":   { "$type": "color", "$value": "#eff8ff" },
      "on-accent":     { "$type": "color", "$value": "#ffffff" },
      "state-red-ink":     { "$type": "color", "$value": "#b42318" },
      "state-red-bg":      { "$type": "color", "$value": "#fef3f2" },
      "state-needs-ink":   { "$type": "color", "$value": "#b54708" },
      "state-needs-bg":    { "$type": "color", "$value": "#fffaeb" },
      "state-running-ink": { "$type": "color", "$value": "#175cd3" },
      "state-running-bg":  { "$type": "color", "$value": "#eff8ff" },
      "state-good-ink":    { "$type": "color", "$value": "#067647" },
      "state-good-bg":     { "$type": "color", "$value": "#ecfdf3" },
      "state-stale-ink":   { "$type": "color", "$value": "#6941c6" },
      "state-stale-bg":    { "$type": "color", "$value": "#f4f3ff" },
      "state-blind-ink":   { "$type": "color", "$value": "#475467" },
      "state-blind-bg":    { "$type": "color", "$value": "#f9fafb" }
    },
    "dark": {
      "canvas":        { "$type": "color", "$value": "#0b0c0e" },
      "surface-1":     { "$type": "color", "$value": "#121316" },
      "surface-2":     { "$type": "color", "$value": "#17191d" },
      "surface-3":     { "$type": "color", "$value": "#1c1f24" },
      "border-subtle": { "$type": "color", "$value": "#232629" },
      "border":        { "$type": "color", "$value": "#2e3238" },
      "border-strong": { "$type": "color", "$value": "#5f6774", "$description": "Raised from #3b4048 (1.88:1) to clear 3:1 on canvas, SC 1.4.11." },
      "text":          { "$type": "color", "$value": "#f2f4f7" },
      "text-2":        { "$type": "color", "$value": "#a8afba" },
      "text-muted":    { "$type": "color", "$value": "#8891a0", "$description": "Raised from #7a828e so it clears 4.5:1 on surface-3." },
      "accent":        { "$type": "color", "$value": "#4c8dff" },
      "accent-pressed":{ "$type": "color", "$value": "#3b79e6" },
      "accent-soft":   { "$type": "color", "$value": "#101a2e" },
      "on-accent":     { "$type": "color", "$value": "#0b0c0e" },
      "state-red-ink":     { "$type": "color", "$value": "#ff5c5c" },
      "state-red-bg":      { "$type": "color", "$value": "#2a1214" },
      "state-needs-ink":   { "$type": "color", "$value": "#ffb020" },
      "state-needs-bg":    { "$type": "color", "$value": "#2a1e08" },
      "state-running-ink": { "$type": "color", "$value": "#4c8dff" },
      "state-running-bg":  { "$type": "color", "$value": "#101a2e" },
      "state-good-ink":    { "$type": "color", "$value": "#3ecf8e" },
      "state-good-bg":     { "$type": "color", "$value": "#0e241b" },
      "state-stale-ink":   { "$type": "color", "$value": "#a78bfa" },
      "state-stale-bg":    { "$type": "color", "$value": "#1c1730" },
      "state-blind-ink":   { "$type": "color", "$value": "#8a93a0" },
      "state-blind-bg":    { "$type": "color", "$value": "#1a1c20" }
    }
  },
  "font": {
    "sans":    { "$type": "fontFamily", "$value": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", Inter, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif" },
    "display": { "$type": "fontFamily", "$value": "\"Schibsted Grotesk\", -apple-system, \"Helvetica Neue\", Arial, sans-serif" },
    "serif":   { "$type": "fontFamily", "$value": "\"Source Serif 4\", Georgia, \"Times New Roman\", serif" },
    "mono":    { "$type": "fontFamily", "$value": "ui-monospace, SFMono-Regular, \"SF Mono\", \"JetBrains Mono\", Menlo, monospace" }
  },
  "type": {
    "$description": "Six steps. A size outside this list is refused by guards/purity.mjs.",
    "xs":   { "$type": "dimension", "$value": "0.8125rem", "$extensions": { "estate": { "lineHeight": "1.4", "note": "13px, meta only, never body" } } },
    "sm":   { "$type": "dimension", "$value": "0.9375rem", "$extensions": { "estate": { "lineHeight": "1.5" } } },
    "md":   { "$type": "dimension", "$value": "1.0625rem", "$extensions": { "estate": { "lineHeight": "1.55", "note": "17px body" } } },
    "lg":   { "$type": "dimension", "$value": "1.25rem",   "$extensions": { "estate": { "lineHeight": "1.4" } } },
    "xl":   { "$type": "dimension", "$value": "1.75rem",   "$extensions": { "estate": { "lineHeight": "1.2", "letterSpacing": "-0.015em" } } },
    "2xl":  { "$type": "dimension", "$value": "2.75rem",   "$extensions": { "estate": { "lineHeight": "1.08", "letterSpacing": "-0.02em" } } }
  },
  "weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium":  { "$type": "fontWeight", "$value": 500 },
    "bold":    { "$type": "fontWeight", "$value": 700 }
  },
  "space": {
    "$description": "4px base. Eight steps.",
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "12":{ "$type": "dimension", "$value": "3rem" },
    "16":{ "$type": "dimension", "$value": "4rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "3px" },
    "md": { "$type": "dimension", "$value": "6px" },
    "pill":{ "$type": "dimension", "$value": "999px" }
  },
  "motion": {
    "ease":  { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
    "fast":  { "$type": "duration", "$value": "120ms" },
    "base":  { "$type": "duration", "$value": "200ms" }
  },
  "size": {
    "tap-min":  { "$type": "dimension", "$value": "44px", "$description": "WCAG 2.5.8 / audit 2026-09-30: 29 of 49 home controls were under this." },
    "measure":  { "$type": "dimension", "$value": "68ch" },
    "content":  { "$type": "dimension", "$value": "1040px" },
    "gutter":   { "$type": "dimension", "$value": "16px" }
  },
  "breakpoint": {
    "phone":   { "$type": "dimension", "$value": "600px" },
    "desktop": { "$type": "dimension", "$value": "1024px" }
  }
}
