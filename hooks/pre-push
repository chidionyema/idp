#!/usr/bin/env bash
# hooks/pre-push — mutation testing PR gate (informational, non-blocking)
# Always exits 0. Mutation testing is informational, never blocks a push.
set -uo pipefail  # NOTE: -e removed — this hook never blocks

ORCH="$HOME/.estate/bin/mutation-orchestrator"
REPO_ROOT="$(git rev-parse --show-toplevel)"
BASE="${1:-origin/main}"
PR_TIMEOUT=60  # hard cap — push always proceeds after this

ALL_FILES=$(git diff --name-only "${BASE}...HEAD" \
  | grep -E '\.(py|rs|ts|tsx|go|cs)$' || true)

if [ -z "$ALL_FILES" ]; then
  echo "mutation-pr: no testable files — pass"
  exit 0
fi

FILE_COUNT=$(echo "$ALL_FILES" | wc -l | tr -d ' ')
echo "mutation-pr: base=$BASE, ${FILE_COUNT} files, timeout=${PR_TIMEOUT}s"

# Run mutation testing with hard timeout
# timeout sends SIGKILL (9) after PR_TIMEOUT seconds
MUTOUT=$(timeout "$PR_TIMEOUT" python3 "$ORCH" --tier=pr --stdin --cwd="$REPO_ROOT" <<< "$ALL_FILES" 2>&1) \
  || MUT_RC=$?

if [ "${MUT_RC:-0}" -eq 139 ]; then  # 128+11=SIGSEGV
  echo "mutation-pr: CRASH (SIGSEGV) — allowing push"
elif [ "${MUT_RC:-0}" -eq 137 ]; then  # 128+9=SIGKILL (timeout)
  echo "mutation-pr: TIMEOUT after ${PR_TIMEOUT}s — allowing push"
elif [ "${MUT_RC:-0}" -eq 0 ]; then
  echo "mutation-pr: mutation score check complete"
else
  echo "mutation-pr: done (rc=${MUT_RC:-0}, informational)"
fi

echo "mutation-pr: push proceeds regardless of mutation results"
exit 0
