#!/usr/bin/env bash
# hooks/pre-push — mutation testing PR gate (informational)
# Non-blocking: always exits 0 even if mutation testing times out.
set -euo pipefail

ORCH="$HOME/.estate/bin/mutation-orchestrator"
REPO_ROOT="$(git rev-parse --show-toplevel)"
BASE="${1:-origin/main}"
PR_TIMEOUT=60  # hard cap in seconds — push always proceeds

ALL_FILES=$(git diff --name-only "${BASE}...HEAD" \
  | grep -E '\.(py|rs|ts|tsx|go|cs)$' || true)

if [ -z "$ALL_FILES" ]; then
  echo "mutation-pr: no testable files changed — pass"
  exit 0
fi

echo "mutation-pr: base=$BASE (timeout=${PR_TIMEOUT}s)"
echo "mutation-pr: files:"
echo "$ALL_FILES" | while read f; do echo "  $f"; done

# Run with hard timeout; push proceeds regardless of result
set +e  # don't fail the hook
timeout "$PR_TIMEOUT" python3 "$ORCH" --tier=pr --stdin --cwd="$REPO_ROOT" <<< "$ALL_FILES"
RC=$?
set -e

if [ $RC -eq 124 ]; then
  echo "mutation-pr: TIMEOUT after ${PR_TIMEOUT}s — push allowed (informational)"
elif [ $RC -eq 0 ]; then
  echo "mutation-pr: PASS (rc=0)"
else
  echo "mutation-pr: done (rc=$RC, informational)"
fi

exit 0
