#!/usr/bin/env bash
# hooks/pre-push — mutation testing PR gate (informational, non-blocking)
# Always exits 0. Mutation testing is informational, never blocks a push.
set -uo pipefail

ORCH="$HOME/.estate/bin/mutation-orchestrator"
REPO_ROOT="$(git rev-parse --show-toplevel)"
BASE="${1:-origin/main}"
PR_TIMEOUT=60

ALL_FILES=$(git diff --name-only "${BASE}...HEAD" \
  | grep -E '\.(py|rs|ts|tsx|go|cs)$' || true)

if [ -z "$ALL_FILES" ]; then
  echo "mutation-pr: no testable files — pass"
  exit 0
fi

FILE_COUNT=$(echo "$ALL_FILES" | wc -l | tr -d ' ')
echo "mutation-pr: base=$BASE, ${FILE_COUNT} files, timeout=${PR_TIMEOUT}s"

# Run in subshell so SIGALRM/SIGKILL from timeout can't kill the parent
(
  exec timeout "$PR_TIMEOUT" python3 "$ORCH" --tier=pr --stdin --cwd="$REPO_ROOT" <<< "$ALL_FILES"
) > /tmp/mutation-pr-output.txt 2>&1
MUT_RC=$?

if [ $MUT_RC -eq 137 ] || [ $MUT_RC -eq 139 ]; then
  echo "mutation-pr: TIMEOUT/CRASH after ${PR_TIMEOUT}s — allowing push"
elif [ $MUT_RC -eq 0 ]; then
  echo "mutation-pr: complete"
else
  echo "mutation-pr: done (rc=$MUT_RC, informational)"
fi

echo "mutation-pr: push proceeds"
exit 0
