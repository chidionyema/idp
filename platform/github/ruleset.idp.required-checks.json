{
  "name": "idp-required-checks",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {
            "context": "bdd"
          },
          {
            "context": "bdd-suites (tests)"
          },
          {
            "context": "bdd-suites (acceptance)"
          },
          {
            "context": "security-scan"
          },
          {
            "context": "fast-gate / fast-gate"
          },
          {
            "context": "executes-gate"
          },
          {
            "context": "portal-app"
          },
          {
            "context": "messaging-demo"
          },
          {
            "context": "offline-gate"
          }
        ]
      }
    }
  ]
}
