{
  "name": "idp-main-writer",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": "${GITHUB_APP_ID}",
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "update",
      "parameters": {
        "update_allows_fetch_and_merge": false
      }
    }
  ]
}
