{
  "zone_env": "ESTATE_ZONE",
  "zone_default": "mumchimp.com",
  "note": "The estate's critical lanes, as data. A home is a failure domain: a place the service runs that can die without taking the others with it (docs/explanation/otto-survival-matrix.md). Adding a home is a line in this file; bin/idp-estate-homes asks the questions and files what is down.",
  "services": [
    {
      "service": "llm-router",
      "what_breaks": "every agent that talks to a model, the founder's voice loop, and every surface that streams",
      "selectors": [
        {
          "name": "laptop front :4000",
          "fate": ["host:laptop"],
          "reaches": ["cloud (OKE LiteLLM)", "laptop front"],
          "note": "every local agent's base URL (bin/litellm-status). platform/llm/front.py dials the cloud and its own slots only: not the lifeboat, not the floor."
        }
      ],
      "legs": [
        {
          "name": "cloud (OKE LiteLLM)",
          "provider": "oracle-oke",
          "fate": ["provider:oracle-oke"],
          "role": "default",
          "url": "https://llm.{zone}/health/liveliness",
          "expect": [200]
        },
        {
          "name": "lifeboat (Cloudflare edge)",
          "provider": "cloudflare",
          "fate": ["provider:cloudflare"],
          "role": "cross-provider",
          "url": "https://lifeboat-llm.{zone}/health",
          "expect": [200]
        },
        {
          "name": "groq free tier",
          "provider": "groq",
          "fate": ["provider:groq"],
          "role": "floor",
          "url": "https://api.groq.com/openai/v1/models",
          "secret": "GROQ_API_KEY",
          "headers": {"Authorization": "Bearer ${GROQ_API_KEY}"},
          "expect": [200]
        },
        {
          "name": "laptop front",
          "provider": "laptop",
          "fate": ["host:laptop"],
          "role": "in-house fallback",
          "url": "http://127.0.0.1:4000/health/liveliness",
          "expect": [200]
        }
      ]
    },
    {
      "service": "otto",
      "what_breaks": "the founder's own assistant, the one surface that must never be silent",
      "legs": [
        {
          "name": "cluster (otto-gateway)",
          "provider": "oracle-oke",
          "role": "default",
          "url": "https://otto.{zone}/healthz",
          "expect": [200]
        },
        {
          "name": "lifeboat (Cloudflare edge)",
          "provider": "cloudflare",
          "role": "cross-provider",
          "url": "https://lifeboat-llm.{zone}/health",
          "expect": [200]
        },
        {
          "name": "groq free tier",
          "provider": "groq",
          "role": "floor",
          "url": "https://api.groq.com/openai/v1/models",
          "secret": "GROQ_API_KEY",
          "headers": {"Authorization": "Bearer ${GROQ_API_KEY}"},
          "expect": [200]
        }
      ]
    },
    {
      "service": "estate-doors",
      "what_breaks": "every published hostname: the portal, the catalogue, the API, identity, traces, the voice router",
      "note": "These doors are asked with expect_any: the question is only 'does this name answer at all'. A door that answers 404 is up; a door that does not answer is a hole in the estate's surface.",
      "legs": [
        {"name": "api", "provider": "oracle-oke", "url": "https://api.{zone}/", "expect_any": true},
        {"name": "auth", "provider": "oracle-oke", "url": "https://auth.{zone}/", "expect_any": true},
        {"name": "catalogue", "provider": "oracle-oke", "url": "https://catalogue.{zone}/", "expect_any": true},
        {"name": "cyrus", "provider": "oracle-oke", "url": "https://cyrus.{zone}/", "expect_any": true},
        {"name": "hc", "provider": "oracle-oke", "url": "https://hc.{zone}/", "expect_any": true},
        {"name": "langfuse", "provider": "oracle-oke", "url": "https://langfuse.{zone}/", "expect_any": true},
        {"name": "llm", "provider": "oracle-oke", "url": "https://llm.{zone}/", "expect_any": true},
        {"name": "mcp", "provider": "oracle-oke", "url": "https://mcp.{zone}/", "expect_any": true},
        {"name": "meridian", "provider": "oracle-oke", "url": "https://meridian.{zone}/", "expect_any": true},
        {"name": "otto", "provider": "oracle-oke", "url": "https://otto.{zone}/", "expect_any": true},
        {"name": "sandbox", "provider": "oracle-oke", "url": "https://sandbox.{zone}/", "expect_any": true},
        {"name": "signoz", "provider": "oracle-oke", "url": "https://signoz.{zone}/", "expect_any": true},
        {"name": "superset", "provider": "oracle-oke", "url": "https://superset.{zone}/", "expect_any": true},
        {"name": "www", "provider": "oracle-oke", "url": "https://www.{zone}/", "expect_any": true}
      ]
    }
  ]
}
