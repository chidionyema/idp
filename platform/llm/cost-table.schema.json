{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://idp.internal/schema/cost-table.json",
  "title": "Hosting cost table (idp#3525 CP1, COST-04)",
  "description": "Every hosting tier row SHALL carry a receipt grade, or it fails schema.",
  "type": "object",
  "required": ["version", "rows"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "grade", "receipt"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "grade": {
            "type": "string",
            "enum": ["vendor-doc", "survey", "founder-supplied-unverified"]
          },
          "receipt": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
