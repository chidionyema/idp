{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idp.bytesync.dev/estate-state/1.json",
  "title": "estate-state",
  "description": "The one structured document every session ingests at start (crew#648). Five sections, the same five the Backstage entity page uses (crew#627, founder 2026-08-30: adopt the categorisation so it is intuitive what belongs where): overview, delivery, runtime, docs_apis, security. Version 2 fields (founder 2026-09-03, docs/founder/estate-snapshot-is-mandatory.md) sit inside those five: decisions, founder_blockers, open_prs, last_apply, changes, router_lanes, incidents, vendor_roots.",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "overview",
    "delivery",
    "runtime",
    "docs_apis",
    "security"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC, RFC 3339; the server compares it to now to set stale"
    },
    "generated_by": {
      "type": "string",
      "description": "workflow run URL or job name that produced the document (never a Mac)"
    },
    "overview": {
      "type": "object",
      "required": [
        "freeze",
        "rulings",
        "sessions",
        "board",
        "decisions",
        "founder_blockers"
      ],
      "additionalProperties": false,
      "properties": {
        "freeze": {
          "type": "object",
          "required": [
            "active"
          ],
          "additionalProperties": false,
          "properties": {
            "active": {
              "type": "boolean"
            },
            "since": {
              "type": "string",
              "format": "date-time"
            },
            "reason": {
              "type": "string"
            },
            "record": {
              "type": "string",
              "description": "issue or comment URL that declared it"
            }
          }
        },
        "rulings": {
          "type": "array",
          "description": "standing founder rulings, newest last",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date"
              },
              "text": {
                "type": "string"
              },
              "record": {
                "type": "string"
              }
            }
          }
        },
        "sessions": {
          "type": "array",
          "description": "active sessions and their lanes, from the feed",
          "items": {
            "type": "object",
            "required": [
              "id",
              "lane",
              "last_handoff_at"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "lane": {
                "type": "string"
              },
              "last_handoff_at": {
                "type": "string",
                "format": "date-time"
              },
              "blocked": {
                "type": "string"
              },
              "active": {
                "type": "string"
              }
            }
          }
        },
        "board": {
          "type": "array",
          "description": "open board issues by owner",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "number",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "priority": {
                "type": "string"
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "description": "recent decisions and changes of direction (founder 2026-09-03): rulings dated inside the window and commits that touched a decision or founder record",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "at",
              "title"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "ruling",
                  "record"
                ]
              },
              "id": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "at": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "record": {
                "type": "string"
              }
            }
          }
        },
        "founder_blockers": {
          "type": "array",
          "description": "everything waiting on the founder: a session's Blocked line that names him, or an open issue labelled founder-request",
          "items": {
            "type": "object",
            "required": [
              "source",
              "since",
              "waits_for"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "enum": [
                  "session",
                  "issue"
                ]
              },
              "session": {
                "type": "string"
              },
              "lane": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer"
              },
              "since": {
                "type": "string"
              },
              "waits_for": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": [
        "open_p0",
        "failed_runs",
        "open_prs",
        "last_apply",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "open_p0": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "number",
              "title",
              "opened_at"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "opened_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "failed_runs": {
          "type": "array",
          "description": "workflow runs red in the last window, one row per workflow",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "workflow",
              "failed",
              "window_hours"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "workflow": {
                "type": "string"
              },
              "failed": {
                "type": "integer"
              },
              "window_hours": {
                "type": "integer"
              },
              "last_run": {
                "type": "string"
              }
            }
          }
        },
        "main_sha": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "repo -> head sha of main at generation"
        },
        "open_prs": {
          "type": "array",
          "description": "open pull requests per repo with their check counts and merge state",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "number",
              "title",
              "branch",
              "checks",
              "merge_state",
              "updated_at"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer"
              },
              "title": {
                "type": "string"
              },
              "branch": {
                "type": "string"
              },
              "draft": {
                "type": "boolean"
              },
              "url": {
                "type": "string"
              },
              "checks": {
                "type": "object",
                "required": [
                  "ok",
                  "fail",
                  "pending"
                ],
                "additionalProperties": false,
                "properties": {
                  "ok": {
                    "type": "integer"
                  },
                  "fail": {
                    "type": "integer"
                  },
                  "pending": {
                    "type": "integer"
                  }
                }
              },
              "merge_state": {
                "type": "string"
              },
              "updated_at": {
                "type": "string"
              }
            }
          }
        },
        "last_apply": {
          "type": "object",
          "description": "the newest oke-check run that ran the vendor seeder (mode apply): its verdict, the steps that failed and every FAIL or BLIND line it printed",
          "required": [
            "conclusion",
            "failed_steps",
            "lines"
          ],
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "integer"
            },
            "url": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "conclusion": {
              "type": "string"
            },
            "failed_steps": {
              "type": "array",
              "description": "job and step that failed",
              "items": {
                "type": "object",
                "required": [
                  "job",
                  "step"
                ],
                "additionalProperties": false,
                "properties": {
                  "job": {
                    "type": "string"
                  },
                  "step": {
                    "type": "string"
                  }
                }
              }
            },
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "changes": {
          "type": "array",
          "description": "every commit that reached main inside the window, per repo",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "sha",
              "title",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "sha": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "at": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "clusters",
        "surfaces",
        "router_lanes",
        "incidents"
      ],
      "additionalProperties": false,
      "properties": {
        "clusters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "role",
              "flux_rows"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "production",
                  "staging",
                  "other"
                ]
              },
              "state": {
                "type": "string",
                "enum": [
                  "ok",
                  "FAIL",
                  "BLIND"
                ],
                "description": "bin/idp-cluster-state verdict"
              },
              "revision": {
                "type": "string"
              },
              "flux_rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "namespace",
                    "name",
                    "ready"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              },
              "reconcile": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "kind",
                    "namespace",
                    "name",
                    "ready"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "namespace": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "ready": {
                      "type": "boolean"
                    },
                    "since": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "revision": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "surfaces": {
          "type": "array",
          "description": "routed doors and the last drill verdict",
          "items": {
            "type": "object",
            "required": [
              "name",
              "verdict"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "ok",
                  "FAIL",
                  "BLIND"
                ]
              },
              "checked_at": {
                "type": "string",
                "format": "date-time"
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "router_lanes": {
          "type": "array",
          "description": "each lane of the estate router with its last measured answer (one call, one token)",
          "items": {
            "type": "object",
            "required": [
              "lane",
              "verdict",
              "detail",
              "measured_at"
            ],
            "additionalProperties": false,
            "properties": {
              "lane": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "ok",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "status": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "detail": {
                "type": "string"
              },
              "measured_at": {
                "type": "string"
              },
              "ms": {
                "type": "integer"
              }
            }
          }
        },
        "incidents": {
          "type": "array",
          "description": "incidents from the ledger that are open or were detected inside the window, with their classes so a repeat is matched before anyone investigates",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title",
              "detected"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "surface": {
                "type": "string"
              },
              "detected": {
                "type": "string"
              },
              "resolved": {
                "type": "string"
              },
              "classes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "docs_apis": {
      "type": "object",
      "required": [
        "standards_page",
        "diagrams"
      ],
      "additionalProperties": false,
      "properties": {
        "standards_page": {
          "type": "string",
          "description": "where the standards rows live"
        },
        "diagrams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "generated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        "runbooks_index": {
          "type": "string"
        }
      }
    },
    "security": {
      "type": "object",
      "required": [
        "open_findings",
        "vendor_roots"
      ],
      "additionalProperties": false,
      "properties": {
        "open_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "repo",
              "severity",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "repo": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "count": {
                "type": "integer"
              },
              "source": {
                "type": "string"
              }
            }
          }
        },
        "secrets_in_git": {
          "type": "integer",
          "description": "open gitleaks findings (crew#240)"
        },
        "vendor_roots": {
          "type": "array",
          "description": "each vendor root (SEED secret): when it was last set and the last apply run's verdict on it, in the vendor's own words",
          "items": {
            "type": "object",
            "required": [
              "vendor",
              "secret",
              "verdict",
              "detail"
            ],
            "additionalProperties": false,
            "properties": {
              "vendor": {
                "type": "string"
              },
              "secret": {
                "type": "string"
              },
              "set_at": {
                "type": "string"
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "ok",
                  "FAIL",
                  "UNKNOWN"
                ]
              },
              "detail": {
                "type": "string"
              },
              "measured_at": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
