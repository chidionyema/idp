#!/usr/bin/env python3
"""estate-mcp — MCP server with enforcement for diagnosis tasks.

LAYERS (research-backed):
  1. Tool surface: only hypotheses.race for diagnosis tasks
  2. Commitment device: agent declares diagnosis type at session start
  3. Exit gate: blocks conclusions without a race call
  4. Per-action validation: every tool call checked against policy
  5. Audit: every call logged to ~/.estate/logs/mcp.jsonl

Research: telling is not enough. Runtime enforcement adds 41pp over prompting.
Ablating the commitment mechanism flips goal-abandonment from 0.00 to 1.00.
"""
from __future__ import annotations

import json
import subprocess
import sys
import time
import uuid
from pathlib import Path

# ----- paths -----------------------------------------------------------------
HOME = Path.home()
ESTATE_BIN = HOME / ".estate" / "bin" / "estate-execute"
INTENTS_DIR = HOME / ".estate" / "intents"
LOG_DIR = HOME / ".estate" / "logs"
LOG_DIR.mkdir(parents=True, exist_ok=True)
MCP_LOG = LOG_DIR / "mcp.jsonl"

# ----- session state --------------------------------------------------------
class Session:
    def __init__(self, id: str) -> None:
        self.id = id
        self.raced = False          # hypotheses.race was called
        self.race_results: dict | None = None  # results from the race
        self.task_type: str | None = None      # "diagnosis" or None
        self.calls: list[dict] = []            # audit trail
        self.concluded = False                  # agent tried to end session
        self.commitment_declared = False       # agent committed to diagnosis

    def enforce(self, tool: str, args: dict) -> str | None:
        """Return refusal message or None if allowed."""
        self.calls.append({"ts": time.time(), "tool": tool, "args": args})

        # --- Diagnosis tasks require commitment first ---
        if tool == "estate_invoke":
            intent = args.get("name", "")

            # Track task type from the first intent call
            if self.task_type is None:
                DIAGNOSIS_INTENTS = {
                    "k8s.debug", "hypotheses.race", "code-review",
                    "litellm-status", "spire-proof-run", "flux-reconcile",
                    "ci.errors", "ledger-verify",
                }
                if intent in DIAGNOSIS_INTENTS:
                    self.task_type = "diagnosis"

            # hypotheses.race MUST be called before any other diagnosis intent
            if intent == "hypotheses.race":
                self.raced = True
                return None

            if self.task_type == "diagnosis" and not self.raced:
                if intent != "hypotheses.race":
                    self.concluded = True
                    return (
                        "REFUSED: diagnosis task requires hypotheses.race first.\n"
                        "Steps:\n"
                        "  1. Declare hypotheses with priors (sum ~1.0)\n"
                        "  2. Write to /tmp/hypotheses.json\n"
                        "  3. estate_invoke(hypotheses.race, file=/tmp/h.json)\n"
                        "  4. Act on ranked results\n"
                        "This is enforced. Sequential testing is not permitted."
                    )

            # Exit gate: agent cannot conclude a diagnosis without racing
            if self.concluded and not self.raced:
                return (
                    "BLOCKED: no hypotheses.race before concluding.\n"
                    "Call hypotheses.race first."
                )

        return None


# Sessions keyed by MCP session id
SESSIONS: dict[str, Session] = {}

# ----- audit ----------------------------------------------------------------
def log_entry(session, tool, refused, reason="", result="") -> None:
    entry = {
        "ts": time.time(),
        "session": session.id if session else "unknown",
        "tool": tool,
        "refused": refused,
    }
    if reason:
        entry["reason"] = reason
    if session:
        entry["task_type"] = session.task_type
        entry["raced"] = session.raced
        entry["calls"] = session.calls[-1:]
    with MCP_LOG.open("a") as fh:
        fh.write(json.dumps(entry) + "\n")


# ----- estate integration ---------------------------------------------------
def list_intents() -> list[dict]:
    out = []
    for f in sorted(INTENTS_DIR.glob("*.yaml")):
        try:
            import yaml
            d = yaml.safe_load(f.read_text())
            out.append({
                "name": d.get("name", f.stem),
                "description": (d.get("description") or "").strip()[:120],
            })
        except Exception:
            out.append({"name": f.stem, "description": ""})
    return out


def invoke_intent(name: str, args: dict) -> str:
    cmd = [str(ESTATE_BIN), "pi", f"--intent={name}"]
    for k, v in (args or {}).items():
        cmd.append(f"--{k}={v}")
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        return (r.stdout or "") + (r.stderr or "")
    except subprocess.TimeoutExpired:
        return f"[timeout] intent {name} timed out after 300s"
    except Exception as e:
        return f"[error] intent {name}: {e}"


# ----- MCP protocol ---------------------------------------------------------
def send(obj: dict) -> None:
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


def make_tools_response() -> dict:
    return {
        "tools": [
            {
                "name": "estate_list",
                "description": "List all available estate intents",
                "inputSchema": {"type": "object", "properties": {}},
            },
            {
                "name": "estate_show",
                "description": "Show one intent's definition by name",
                "inputSchema": {
                    "type": "object",
                    "properties": {"name": {"type": "string"}},
                    "required": ["name"],
                },
            },
            {
                "name": "estate_invoke",
                "description": (
                    "Run an estate intent. For DIAGNOSIS tasks: enumerate "
                    "hypotheses, call hypotheses.race first. Sequential testing "
                    "is not permitted. The harness refuses if you skip the race."
                ),
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "name": {"type": "string"},
                        "args": {"type": "object"},
                    },
                    "required": ["name"],
                },
            },
            {
                "name": "estate_declare",
                "description": (
                    "Declare task type: 'diagnosis' requires hypotheses.race, "
                    "'other' has no restrictions. Required before diagnosis work."
                ),
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "task_type": {"type": "string", "enum": ["diagnosis", "other"]},
"hypotheses_count": {"type": "integer", "description": "Number of hypotheses"},
                    },
                    "required": ["task_type"],
                },
            },
            {
                "name": "estate_commit",
                "description": (
                    "Commit to the hypotheses.race protocol. Must be called before "
                    "any diagnosis work. This is the Ulysses Contract: once committed, "
                    "sequential testing is refused by the harness."
                ),
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "hypotheses": {"type": "array", "items": {"type": "object"}},
                    },
                    "required": ["hypotheses"],
                },
            },
        ]
    }


def handle(req: dict) -> dict:
    method = req.get("method", "")
    params = req.get("params", {})
    # --- initialize: new session ---
    if method == "initialize":
        session_id = str(uuid.uuid4())
        session = Session(session_id)
        SESSIONS[session_id] = session
        log_entry(session, "initialize", False)
        return {
            "protocolVersion": "2024-11-05",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "estate-mcp", "version": "2.0"},
            "session": session_id,
        }

    # --- session ---
    session_id = (
        params.get("_meta", {}).get("session")
        or params.get("session")
        or (list(SESSIONS.keys())[0] if SESSIONS else "default")
    )
    session = SESSIONS.get(session_id) or Session(session_id)
    if session_id not in SESSIONS:
        SESSIONS[session_id] = session

    # --- tools/list ---
    if method == "tools/list":
        return make_tools_response()

    # --- tools/call ---
    if method == "tools/call":
        tool = params.get("name", "")
        args = params.get("arguments", {})

        # Check enforcement before executing
        refusal = session.enforce(tool, args)
        if refusal:
            log_entry(session, tool, True, refusal)
            return {
                "content": [{"type": "text", "text": f"[REFUSED] {refusal}"}],
                "isError": True,
            }

        # Execute the tool
        if tool == "estate_list":
            items = list_intents()
            text = "\n".join(f"- {i['name']}: {i['description']}" for i in items)
            result = text or "(no intents found)"

        elif tool == "estate_show":
            name = args.get("name", "")
            f = INTENTS_DIR / f"{name}.yaml"
            if f.exists():
                result = f.read_text()
            else:
                result = f"[not found] intent: {name}"

        elif tool == "estate_invoke":
            name = args.get("name", "")
            result = invoke_intent(name, args.get("args", {}))

            # If this was a race, store results
            if name == "hypotheses.race":
                session.race_results = result

        elif tool == "estate_declare":
            session.task_type = args.get("task_type", "other")
            session.commitment_declared = True
            result = f"[committed] task_type={session.task_type}"

        elif tool == "estate_commit":
            # Ulysses contract: agent explicitly commits to race protocol
            session.raced = True  # bypass race check — they've committed
            result = "[committed] Ulysses Contract registered."

        else:
            result = f"[unknown tool] {tool}"

        log_entry(session, tool, False, result=result[:200])
        return {"content": [{"type": "text", "text": result}]}

    # --- notifications ---
    if method == "notifications/initialized":
        return None

    return {}


def main() -> None:
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            req = json.loads(line)
        except Exception:
            continue
        if not isinstance(req, dict):
            continue
        if "id" not in req:
            continue
        try:
            result = handle(req)
        except Exception as exc:
            result = {"error": {"code": -32603, "message": str(exc)}}
        send({"jsonrpc": "2.0", "id": req["id"], "result": result})


if __name__ == "__main__":
    main()
