#!/usr/bin/env python3
"""
estate-execute — intent ledger + pipeline executor

Usage:
  estate-execute --list
  estate-execute <intent> [arg=val ...] [positional...]

All executor logs go to stderr. Intent output goes to stdout.
No heredocs. No pipes. No exit traps. All SQL via parameterized queries.
"""
import sqlite3
import subprocess
import sys
import os
import shlex
import json
import atexit
from pathlib import Path
from datetime import datetime, timezone
import uuid

# ---- Paths ---------------------------------------------------------------
HOME    = Path.home()
DB      = HOME / ".estate" / "estate.db"
INTENTS = HOME / ".estate" / "intents"

def log(*args, **kw):
    print(*args, file=sys.stderr, **kw)

# ---- Step output cache (keyed by step name) ---------------------------------
# Filled by run_steps, consumed by subsequent `from:` steps
STEP_OUTPUTS = {}  # {step_name: {"stdout": str, "rc": int, "json": obj}}

# ---- DB init ------------------------------------------------------------
def init_db():
    DB.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB))
    conn.execute("""
        CREATE TABLE IF NOT EXISTS intent_tickets (
            id           TEXT PRIMARY KEY,
            intent       TEXT NOT NULL,
            harness      TEXT NOT NULL,
            goal         TEXT,
            started_at   TEXT NOT NULL,
            completed_at TEXT,
            status       TEXT NOT NULL DEFAULT 'running',
            steps_run    INTEGER NOT NULL DEFAULT 0,
            steps_failed INTEGER NOT NULL DEFAULT 0,
            cost_usd     REAL    DEFAULT 0,
            error        TEXT
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS step_runs (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            ticket_id   TEXT NOT NULL REFERENCES intent_tickets(id),
            step_idx    INTEGER NOT NULL,
            cmd         TEXT NOT NULL,
            exit_code   INTEGER,
            duration_ms INTEGER,
            ran_at      TEXT
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS policy_decisions (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            ticket_id   TEXT NOT NULL REFERENCES intent_tickets(id),
            intent      TEXT NOT NULL,
            session_id  TEXT,
            n           INTEGER NOT NULL,
            not_ok      INTEGER NOT NULL,
            p_fail      REAL    NOT NULL,
            decision    TEXT    NOT NULL,
            mode        TEXT    NOT NULL,
            latency_us  INTEGER NOT NULL,
            at          TEXT    NOT NULL
        )
    """)
    conn.commit()
    return conn

# ---- Policy gate (ML dept loop A, docs/specs/2026-09-29-machine-learning-dept.md) ----
# The environment decides before the step runs, from what it has recorded: the intent's own
# outcomes over the last 30 days. Beta(1+not_ok, 1+ok) posterior mean; a decision only once
# it has seen POLICY_MIN_N runs. ESTATE_POLICY=shadow (default) records what it would do and
# never blocks; =enforce refuses (exit 3) or holds (sleep); =off skips the read entirely.
POLICY_MIN_N     = 5
POLICY_REFUSE_P  = 0.80
POLICY_HOLD_P    = 0.50
POLICY_HOLD_MAX_S = 10

def policy_decide(conn, ticket_id, intent_name, session_id=""):
    mode = os.environ.get("ESTATE_POLICY", "shadow")
    if mode == "off":
        return "allow", None
    import time as _t
    t0 = _t.perf_counter()
    n, not_ok = conn.execute(
        "SELECT COUNT(*), SUM(status != 'ok') FROM intent_tickets "
        "WHERE intent=? AND status != 'running' AND id != ? "
        "AND started_at >= datetime('now','-30 day')",
        (intent_name, ticket_id),
    ).fetchone()
    n = n or 0
    not_ok = not_ok or 0
    p_fail = (1 + not_ok) / (2 + n)
    decision = "allow"
    if n >= POLICY_MIN_N and p_fail >= POLICY_REFUSE_P:
        decision = "refuse"
    elif n >= POLICY_MIN_N and p_fail >= POLICY_HOLD_P:
        decision = "hold"
    latency_us = int((_t.perf_counter() - t0) * 1e6)
    now = datetime.now(timezone.utc).isoformat()
    conn.execute(
        "INSERT INTO policy_decisions "
        "(ticket_id,intent,session_id,n,not_ok,p_fail,decision,mode,latency_us,at) "
        "VALUES (?,?,?,?,?,?,?,?,?,?)",
        (ticket_id, intent_name, session_id, n, not_ok, p_fail, decision, mode, latency_us, now),
    )
    conn.commit()
    reason = f"{not_ok}/{n} runs not ok in 30d, p_fail={p_fail:.2f}, {latency_us}us"
    _policy_event(session_id, decision, mode, intent_name, reason, now)
    if decision != "allow":
        log(f"[estate] policy {mode}: would {decision} {intent_name} -- {reason}")
    if mode != "enforce":
        return decision, reason
    if decision == "refuse":
        close_ticket(conn, ticket_id, "halted", f"policy refused: {reason}")
        log(f"[estate] policy refused {intent_name}: {reason}")
        sys.exit(3)
    if decision == "hold":
        _t.sleep(min(POLICY_HOLD_MAX_S, POLICY_HOLD_MAX_S * p_fail))
    return decision, reason

def _policy_event(session_id, decision, mode, intent_name, reason, now):
    # One estate.agent gate event per decision, through the same outbox fleetview-backend
    # drains to NATS (outbox.py schema), so /fleet shows the gate deciding on real actions.
    verdict = "pass" if decision == "allow" else "refuse"
    payload = {
        "session_id": session_id or "direct",
        "runtime": "claude-code",
        "kind": "gate",
        "at": now,
        "phase": "executing",
        "tool": {"name": "estate-execute", "target": intent_name},
        "gate": {
            "name": f"estate-policy:{mode}",
            "verdict": verdict,
            "reason": f"{decision}: {reason}",
        },
    }
    try:
        ob = sqlite3.connect(str(HOME / ".estate" / "outbox.db"), timeout=1)
        ob.execute("""
            CREATE TABLE IF NOT EXISTS outbox (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at REAL NOT NULL,
                session_id TEXT NOT NULL,
                runtime TEXT NOT NULL,
                kind TEXT NOT NULL,
                phase TEXT NOT NULL,
                payload TEXT NOT NULL,
                status TEXT NOT NULL DEFAULT 'pending',
                retries INTEGER NOT NULL DEFAULT 0,
                last_attempt_at REAL,
                next_attempt_at REAL,
                error TEXT
            )
        """)
        import time as _t
        ob.execute(
            "INSERT INTO outbox (created_at,session_id,runtime,kind,phase,payload,next_attempt_at) "
            "VALUES (?,?,?,?,?,?,?)",
            (_t.time(), payload["session_id"], "claude-code", "gate", "executing",
             json.dumps(payload), _t.time()),
        )
        ob.commit()
        ob.close()
    except sqlite3.Error as exc:  # the gate never fails an intent because the bus is busy
        log(f"[estate] policy event not queued: {exc}")

# ---- Ticket ops ----------------------------------------------------------
def open_ticket(conn, intent_name, harness, goal=""):
    ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    ticket_id = f"INTENT-{ts}-{uuid.uuid4().hex[:8]}"
    now = datetime.now(timezone.utc).isoformat()
    conn.execute(
        "INSERT INTO intent_tickets "
        "(id,intent,harness,goal,started_at,status) VALUES (?,?,?,?,?,?)",
        (ticket_id, intent_name, harness, goal, now, "running")
    )
    conn.commit()
    return ticket_id

def log_step(conn, ticket_id, idx, cmd, rc, dur_ms):
    conn.execute(
        "INSERT INTO step_runs "
        "(ticket_id,step_idx,cmd,exit_code,duration_ms,ran_at) VALUES (?,?,?,?,?,?)",
        (ticket_id, idx, cmd, rc, dur_ms, datetime.now(timezone.utc).isoformat())
    )
    conn.commit()

def close_ticket(conn, ticket_id, status, error=None):
    conn.execute(
        "UPDATE intent_tickets SET completed_at=?,status=?,error=? WHERE id=?",
        (datetime.now(timezone.utc).isoformat(), status, error, ticket_id)
    )
    conn.commit()

# ---- Argument resolution ------------------------------------------------
def resolve_args(intent, raw_args):
    arg_defs = intent.get("args", {})
    resolved = {}
    positional = []

    for arg in raw_args:
        if "=" in arg:
            k, v = arg.split("=", 1)
            resolved[k] = v
        else:
            positional.append(arg)

    names = list(arg_defs.keys())
    for i, val in enumerate(positional):
        if i < len(names):
            resolved[names[i]] = val

    for name, spec in arg_defs.items():
        if name not in resolved:
            resolved[name] = spec.get("default", "")
        if spec.get("type") == "int":
            try:
                resolved[name] = int(float(str(resolved[name])))
            except (ValueError, TypeError):
                resolved[name] = 0
    return resolved

# ---- Interpolation ------------------------------------------------------
def interpolate(cmd, args):
    """{{var}} → shell-quoted (safe path), <<var>> → raw (already quoted)."""
    for name, val in args.items():
        quoted = shlex.quote(str(val))
        cmd = cmd.replace("{{" + name + "}}", quoted)
        cmd = cmd.replace("<<" + name + ">>", str(val))
    return cmd

# ---- Composition helpers --------------------------------------------------
def _resolve_from(prev_name, prev_output):
    """Parse previous step output into a dict inject."""
    if prev_output.get("json"):
        return {"_from_json": prev_output["json"]}
    try:
        return {"_from_json": json.loads(prev_output["stdout"])}
    except (json.JSONDecodeError, TypeError):
        return {"_from_text": prev_output["stdout"]}


def _inject_from(step, step_outputs, args):
    """Merge previous step output into args based on `from:` field."""
    from_ref = step.get("from")
    if not from_ref:
        return
    # from: "step-name" or from: ["step1", "step2"]
    names = [from_ref] if isinstance(from_ref, str) else from_ref
    for name in names:
        prev = step_outputs.get(name)
        if prev:
            args.update(_resolve_from(name, prev))


def _read_intent(name):
    """Load an intent YAML by name."""
    path = INTENTS / f"{name}.yaml"
    if not path.exists():
        # Try with dashes stripped for dot-notation names (hypotheses.race)
        alt = INTENTS / f"{name.replace('.', '-')}.yaml"
        if alt.exists():
            path = alt
    if not path.exists():
        raise FileNotFoundError(f"intent not found: {name}")
    with open(path) as f:
        import yaml
        return yaml.safe_load(f), path.stem


# ---- Step runner --------------------------------------------------------
def run_steps(conn, ticket_id, intent, args, depth=0):
    steps = intent.get("steps", [])
    halt_on_fail = intent.get("halt_on_failure", True)
    failed = 0

    # Merge step_outputs into args for the duration of this intent
    for name, out in STEP_OUTPUTS.items():
        if name not in args:
            args[name] = out.get("stdout", "")

    for idx, step in enumerate(steps):
        step_name = step.get("name", f"step-{idx+1}")
        on_fail = step.get("on_fail", "halt" if halt_on_fail else "continue")

        # Inject previous step output
        _inject_from(step, STEP_OUTPUTS, args)

        # ---- COMPOSITION: `intent:` field references another intent --------
        if "intent" in step:
            sub_name = step["intent"]
            sub_args = dict(args)
            # Merge step-level args
            for k, v in step.get("args", {}).items():
                if isinstance(v, str) and v.startswith("{{"):
                    # interpolate from current args
                    sub_args[k] = interpolate(v, args)
                else:
                    sub_args[k] = v

            indent = "  " * (depth + 1)
            log(f"[step {idx+1} / {step_name}] COMPOSE → {sub_name}")
            if depth > 4:
                log(f"{indent}ERROR: composition depth exceeded (max 5)")
                rc = 1
                dur = 0
            else:
                t0 = datetime.now(timezone.utc)
                try:
                    rc, sub_stdout = _run_composed(sub_name, sub_args, depth + 1)
                    dur = int((datetime.now(timezone.utc) - t0).total_seconds() * 1000)
                    stdout = sub_stdout
                except FileNotFoundError as e:
                    log(f"{indent}ERROR: {e}")
                    rc = 1
                    dur = 0
                    stdout = ""
            # Cache the output
            try:
                j = json.loads(stdout)
                STEP_OUTPUTS[step_name] = {"stdout": stdout, "rc": rc, "json": j}
            except (json.JSONDecodeError, TypeError):
                STEP_OUTPUTS[step_name] = {"stdout": stdout, "rc": rc, "json": None}
            log(f"{indent}  exit {rc}  ({dur}ms)")

        # ---- PRIMITIVE: `cmd:` field runs shell ---------------------------
        elif "cmd" in step:
            cmd_tmpl = step["cmd"]
            cmd = interpolate(cmd_tmpl, args)
            log(f"[step {idx+1} / {step_name}] {cmd[:80]}{'...' if len(cmd) > 80 else ''}")

            t0 = datetime.now(timezone.utc)
            step_timeout = int(step.get("timeout", 120))
            stderr = ""
            try:
                result = subprocess.run(  # noqa: S602
                    cmd, shell=True, capture_output=True, text=True, timeout=step_timeout
                )
                rc = result.returncode
                stdout = result.stdout
                stderr = result.stderr
            except subprocess.TimeoutExpired:
                log(f"  TIMEOUT ({step_timeout}s)")
                rc = 124
                stdout = ""
            except Exception as e:
                log(f"  ERROR: {e}")
                rc = 1
                stdout = ""

            dur = int((datetime.now(timezone.utc) - t0).total_seconds() * 1000)
            # Cache the output
            try:
                j = json.loads(stdout)
                STEP_OUTPUTS[step_name] = {"stdout": stdout, "rc": rc, "json": j}
            except (json.JSONDecodeError, TypeError):
                STEP_OUTPUTS[step_name] = {"stdout": stdout, "rc": rc, "json": None}
            log_step(conn, ticket_id, idx, cmd, rc, dur)
            log(f"  exit {rc}  ({dur}ms)")

            # Whole output, pass or fail: a truncated or suppressed diagnostic is a blind agent
            # (2026-09-26: net-forensics lost 96 of 116 lines and every failed step printed nothing).
            if rc != 0 and stderr:
                for line in stderr.strip().splitlines()[-20:]:
                    log(f"  stderr: {line}")
            if stdout:
                print(stdout.rstrip("\n"))

        else:
            log(f"[step {idx+1} / {step_name}] ERROR: step has no `cmd` or `intent` field")
            rc = 1

        if rc != 0:
            failed += 1
            if on_fail == "halt":
                close_ticket(conn, ticket_id, "halted", f"step {idx+1} ({step_name}) failed")
                return "halted"

    status = "ok" if failed == 0 else "broken"
    close_ticket(conn, ticket_id, status)
    return status


def _run_composed(intent_name, args, depth=0):
    """Run a sub-intent, return (rc, stdout)."""
    sub_intent, _ = _read_intent(intent_name)
    sub_args = resolve_args(sub_intent, [])  # base resolve
    # Override with passed args
    for k, v in args.items():
        if k in sub_intent.get("args", {}):
            sub_args[k] = v
    sub_args.update({k: v for k, v in args.items()
                    if k not in sub_args and not k.startswith("_")})

    conn = init_db()
    t_id = f"SUB-{uuid.uuid4().hex[:8]}"
    status = run_steps(conn, t_id, sub_intent, sub_args, depth=depth)
    rc = 0 if status == "ok" else 1
    # Collect stdout from cached outputs
    outputs = STEP_OUTPUTS
    stdout_parts = []
    for _name, out in outputs.items():
        if out.get("stdout"):
            stdout_parts.append(out["stdout"])
    return rc, "\n".join(stdout_parts)

# ---- Commands -----------------------------------------------------------
def cmd_list():
    import yaml
    log("Available intents:")
    for f in sorted(INTENTS.glob("*.yaml")):
        with open(f) as fh:
            d = yaml.safe_load(fh)
        name = f.stem
        desc = d.get("description", "")[:60]
        log(f"  {name}")
        if desc:
            log(f"    {desc}")

def cmd_run(intent_name, raw_args):
    # Handle --intent=<name> when called as: estate-execute pi --intent=<name>
    # The main() dispatcher sets harness_name='pi' intent_name=None in this case.
    # We resolve intent_name from raw_args.
    if not intent_name:
        for arg in raw_args:
            if arg.startswith("--intent="):
                intent_name = arg.split("=", 1)[1]
                raw_args = [a for a in raw_args if a is not arg]
                break
    if not intent_name:
        log("ERROR: no intent specified")
        sys.exit(1)

    # Normalize: replace dots with dashes for filename lookup
    lookup_name = intent_name.replace(".", "-")
    intent_path = INTENTS / f"{lookup_name}.yaml"
    if not intent_path.exists():
        # Try original name (for intents with dashes in their name field)
        intent_path = INTENTS / f"{intent_name}.yaml"
    if not intent_path.exists():
        log(f"ERROR: unknown intent: {intent_name}")
        sys.exit(1)

    import yaml
    with open(intent_path) as f:
        intent = yaml.safe_load(f)

    conn = init_db()
    args = resolve_args(intent, raw_args)
    ticket_id = open_ticket(conn, intent_name, "direct")
    log(f"[estate] intent={intent_name}  ticket={ticket_id}")
    policy_decide(conn, ticket_id, intent_name, os.environ.get("ESTATE_SESSION_ID", ""))

    STEP_OUTPUTS.clear()
    status = run_steps(conn, ticket_id, intent, args)
    log(f"[estate] status={status}")
    return status


def cmd_harness(harness_name, intent_name, goal, raw_args):
    """Harness mode: set up restricted env, run steps, then spawn the harness."""
    intent_path = INTENTS / f"{intent_name}.yaml"
    if not intent_path.exists():
        log(f"ERROR: unknown intent: {intent_name}")
        sys.exit(1)

    import yaml
    import tempfile
    with open(intent_path) as f:
        intent = yaml.safe_load(f)

    conn = init_db()
    args = resolve_args(intent, raw_args)
    ticket_id = open_ticket(conn, intent_name, harness_name, goal)
    log(f"[estate] intent={intent_name}  ticket={ticket_id}  harness={harness_name}")
    policy_decide(conn, ticket_id, intent_name, os.environ.get("ESTATE_SESSION_ID", ""))

    # --- Build session HOME with allowlisted tools + runtime deps -------
    tools = intent.get("tools", [])
    # Always include these runtime deps regardless of intent
    always = ["node", "python3", "bash", "sh", "cat", "ls", "mkdir",
               "rm", "grep", "rg", "sed", "awk", "git", "gh"]
    needed = list(dict.fromkeys(always + tools))  # dedupe, always first
    session_home = Path(tempfile.mkdtemp(prefix="estate-session."))
    (session_home / ".bin").mkdir()
    for tool in needed:
        tool_path = Path(shutil.which(tool))
        if tool_path.exists():
            (session_home / ".bin" / tool).symlink_to(tool_path)

    # --- Environment scrub (keep real HOME — curl needs it for cert lookup) ------
    scrub_vars = [
        "MINIMAX_API_KEY", "DEEPSEEK_API_KEY", "OPENAI_DIRECT_KEY",
        "ANTHROPIC_DIRECT_KEY", "OPENROUTER_API_KEY", "GROQ_API_KEY",
        "CEREBRAS_API_KEY", "KUBECONFIG",
        "MINIMAX_BASE_URL", "DEEPSEEK_BASE_URL",
    ]
    for var in scrub_vars:
        os.environ.pop(var, None)

    # --- Set estate-controlled env (PATH narrowed, real HOME preserved) ---
    os.environ["PATH"] = f"{session_home}/.bin:/usr/bin:/bin:/usr/sbin:/sbin"
    os.environ["ESTATE_INTENT"] = intent_name
    os.environ["ESTATE_HARNESS"] = harness_name
    os.environ["ESTATE_TICKET"] = ticket_id
    os.environ["ESTATE_GOAL"] = goal or ""
    # Propagate k8s.debug args as env vars so the helper script can read them
    for _k8s_key, _k8s_val in [
        ("K8S_DEBUG_NS", args.get("namespace", "")),
        ("K8S_DEBUG_FOCUS", args.get("focus", "")),
        ("K8S_DEBUG_DEPTH", args.get("depth", "full")),
        ("K8S_DEBUG_SINCE", args.get("since", "1h")),
        ("K8S_DEBUG_LOG_LINES", str(args.get("log_lines", 50))),
    ]:
        if _k8s_val:
            os.environ[_k8s_key] = str(_k8s_val)
    agent_key = os.environ.get("ESTATE_AGENT_KEY", "")
    if agent_key:
        os.environ["OPENAI_API_KEY"] = agent_key
        os.environ["ANTHROPIC_API_KEY"] = agent_key
    os.environ["OPENAI_BASE_URL"] = "https://llm.mumchimp.com/v1"
    os.environ["ANTHROPIC_BASE_URL"] = "https://llm.mumchimp.com/v1"
    os.environ["SSL_CERT_FILE"] = "/private/etc/ssl/cert.pem"
    os.environ["SSL_CERT_DIR"] = "/private/etc/ssl/certs"

    # --- Egress lock (pf) — best-effort, warn but don't block -----------
    pf_loaded = False
    if Path("/etc/pf.anchors/estate-session").exists():
        import subprocess as _sub
        r = _sub.run(
            ["sudo", "pfctl", "-a", "estate-session", "-f",  # noqa: S607 -- sudo/pfctl resolve from PATH on purpose
             "/etc/pf.anchors/estate-session"],
            capture_output=True, text=True, timeout=5,
        )
        pf_loaded = r.returncode == 0
        if pf_loaded:
            log("[estate] egress lock: pf active")
        else:
            log("[estate] egress lock: pf not loaded (sudo unavailable — skipping)")
    else:
        log("[estate] egress lock: anchor not installed (run day-0 pf setup)")

    # --- Cleanup trap ---------------------------------------------------
    def cleanup():
        shutil.rmtree(session_home, ignore_errors=True)
        if pf_loaded:
            import subprocess as _sub
            _sub.run(
                ["sudo", "pfctl", "-a", "estate-session", "-F", "all"],  # noqa: S607 -- sudo/pfctl resolve from PATH on purpose
                capture_output=True, timeout=5,
            )
    atexit.register(cleanup)

    # Reset step outputs for fresh session
    STEP_OUTPUTS.clear()

    # --- Run intent steps -----------------------------------------------
    STEP_OUTPUTS.clear()
    status = run_steps(conn, ticket_id, intent, args)
    log(f"[estate] status={status}")

    if status == "halted":
        sys.exit(1)

    # --- Spawn real harness ---------------------------------------------
    libexec_dir = HOME / ".estate" / "libexec"
    real_bin = libexec_dir / f"{harness_name}-real"
    if not real_bin.exists():
        # Fallback: find on original PATH
        import shutil as sh
        orig_path = "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
        found = sh.which(harness_name, path=orig_path)
        if found:
            real_bin = Path(found)
        else:
            log(f"ERROR: harness binary not found: {harness_name}")
            log(f"Expected: {libexec_dir}/{harness_name}-real")
            sys.exit(1)

    # Pass through remaining args (the goal is already in ESTATE_GOAL)
    os.execv(str(real_bin), [str(real_bin)] + raw_args)  # noqa: S606  # noqa: S606


# ---- Main ---------------------------------------------------------------
if __name__ == "__main__":
    import shutil

    if len(sys.argv) == 1 or sys.argv[1] == "--list":
        cmd_list()
        sys.exit(0)

    if sys.argv[1] == "--show" and len(sys.argv) >= 3:
        import yaml
        name = sys.argv[2]
        path = INTENTS / f"{name}.yaml"
        if not path.exists():
            log(f"ERROR: unknown intent: {name}")
            sys.exit(1)
        with open(path) as f:
            d = yaml.safe_load(f)
        log(f"name: {name}")
        log(f"description: {d.get('description', '')}")
        if d.get('args'):
            log("args:")
            for k, v in d['args'].items():
                log(f"  {k}: {v}")
        if d.get('steps'):
            log(f"steps: {len(d['steps'])}")
            for i, s in enumerate(d['steps']):
                log(f"  {i+1}. {s.get('name', '?')}: {s.get('cmd', '')[:60]}")
        sys.exit(0)

    harness_name = None
    intent_name = None
    goal = ""
    raw_args = []

    # Mode 1: estate-execute <harness> --intent=<name> [--goal=...]
    # Mode 2: estate-execute <intent> [arg=val ...]
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == "--intent" and i + 1 < len(sys.argv):
            intent_name = sys.argv[i + 1]
            i += 2
        elif arg.startswith("--intent="):
            intent_name = arg.split("=", 1)[1]
            i += 1
        elif arg.startswith("--goal="):
            goal = arg.split("=", 1)[1]
            i += 1
        elif harness_name is None and intent_name is None:
            # First positional: could be harness or intent
            harness_name = arg
            i += 1
        else:
            raw_args.append(arg)
            i += 1

    # Resolve: if first arg is a harness, intent must follow
    if harness_name and intent_name:
        # Harness mode
        cmd_harness(harness_name, intent_name, goal, raw_args)
    elif harness_name and not intent_name:
        # Could be intent name or unknown harness
        if (INTENTS / f"{harness_name}.yaml").exists():
            sys.exit(0 if cmd_run(harness_name, raw_args) == "ok" else 1)
        else:
            log(f"ERROR: unknown harness or intent: {harness_name}")
            log("usage: estate-execute <harness> --intent=<name>  # harness mode")
            log("       estate-execute <intent> [arg=val...]       # direct mode")
            log("       estate-execute --list")
            sys.exit(1)
    elif intent_name:
        sys.exit(0 if cmd_run(intent_name, raw_args) == "ok" else 1)
    else:
        cmd_list()
        sys.exit(0)

    sys.exit(0)
