#!/usr/bin/env python3
"""
estate-execute — intent ledger + pipeline executor

Usage:
  estate-execute --list
  estate-execute <intent> [arg=val ...] [positional...]

All executor logs go to stderr. Intent output goes to stdout.
No heredocs. No pipes. No exit traps. All SQL via parameterized queries.
"""
import sqlite3
import subprocess
import sys
import os
import shlex
from pathlib import Path
from datetime import datetime, timezone
import uuid

# ---- Paths ---------------------------------------------------------------
HOME    = Path.home()
DB      = HOME / ".estate" / "estate.db"
INTENTS = HOME / ".estate" / "intents"

def log(*args, **kw):
    print(*args, file=sys.stderr, **kw)

# ---- DB init ------------------------------------------------------------
def init_db():
    DB.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB))
    conn.execute("""
        CREATE TABLE IF NOT EXISTS intent_tickets (
            id           TEXT PRIMARY KEY,
            intent       TEXT NOT NULL,
            harness      TEXT NOT NULL,
            goal         TEXT,
            started_at   TEXT NOT NULL,
            completed_at TEXT,
            status       TEXT NOT NULL DEFAULT 'running',
            steps_run    INTEGER NOT NULL DEFAULT 0,
            steps_failed INTEGER NOT NULL DEFAULT 0,
            cost_usd     REAL    DEFAULT 0,
            error        TEXT
        )
    """)
    conn.execute("""
        CREATE TABLE IF NOT EXISTS step_runs (
            id          INTEGER PRIMARY KEY AUTOINCREMENT,
            ticket_id   TEXT NOT NULL REFERENCES intent_tickets(id),
            step_idx    INTEGER NOT NULL,
            cmd         TEXT NOT NULL,
            exit_code   INTEGER,
            duration_ms INTEGER,
            ran_at      TEXT
        )
    """)
    conn.commit()
    return conn

# ---- Ticket ops ----------------------------------------------------------
def open_ticket(conn, intent_name, harness, goal=""):
    ts = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    ticket_id = f"INTENT-{ts}-{uuid.uuid4().hex[:8]}"
    now = datetime.now(timezone.utc).isoformat()
    conn.execute(
        "INSERT INTO intent_tickets "
        "(id,intent,harness,goal,started_at,status) VALUES (?,?,?,?,?,?)",
        (ticket_id, intent_name, harness, goal, now, "running")
    )
    conn.commit()
    return ticket_id

def log_step(conn, ticket_id, idx, cmd, rc, dur_ms):
    conn.execute(
        "INSERT INTO step_runs "
        "(ticket_id,step_idx,cmd,exit_code,duration_ms,ran_at) VALUES (?,?,?,?,?,?)",
        (ticket_id, idx, cmd, rc, dur_ms, datetime.now(timezone.utc).isoformat())
    )
    conn.commit()

def close_ticket(conn, ticket_id, status, error=None):
    conn.execute(
        "UPDATE intent_tickets SET completed_at=?,status=?,error=? WHERE id=?",
        (datetime.now(timezone.utc).isoformat(), status, error, ticket_id)
    )
    conn.commit()

# ---- Argument resolution ------------------------------------------------
def resolve_args(intent, raw_args):
    arg_defs = intent.get("args", {})
    resolved = {}
    positional = []

    for arg in raw_args:
        if "=" in arg:
            k, v = arg.split("=", 1)
            resolved[k] = v
        else:
            positional.append(arg)

    names = list(arg_defs.keys())
    for i, val in enumerate(positional):
        if i < len(names):
            resolved[names[i]] = val

    for name, spec in arg_defs.items():
        if name not in resolved:
            resolved[name] = spec.get("default", "")
        if spec.get("type") == "int":
            try:
                resolved[name] = int(float(str(resolved[name])))
            except (ValueError, TypeError):
                resolved[name] = 0
    return resolved

# ---- Interpolation ------------------------------------------------------
def interpolate(cmd, args):
    """{{var}} → shell-quoted (safe path), <<var>> → raw (already quoted)."""
    for name, val in args.items():
        quoted = shlex.quote(str(val))
        cmd = cmd.replace("{{" + name + "}}", quoted)
        cmd = cmd.replace("<<" + name + ">>", str(val))
    return cmd

# ---- Step runner --------------------------------------------------------
def run_steps(conn, ticket_id, intent, args):
    steps = intent.get("steps", [])
    halt_on_fail = intent.get("halt_on_failure", True)
    failed = 0

    for idx, step in enumerate(steps):
        cmd_tmpl = step.get("cmd", "")
        on_fail = step.get("on_fail", "halt" if halt_on_fail else "continue")

        cmd = interpolate(cmd_tmpl, args)
        log(f"[step {idx+1}] {cmd[:80]}{'...' if len(cmd) > 80 else ''}")

        t0 = datetime.now(timezone.utc)
        try:
            result = subprocess.run(  # noqa: S602
                cmd, shell=True, capture_output=True, text=True, timeout=120
            )
            rc = result.returncode
        except subprocess.TimeoutExpired:
            log("  TIMEOUT (120s)")
            rc = 124
        except Exception as e:
            log(f"  ERROR: {e}")
            rc = 1

        dur = int((datetime.now(timezone.utc) - t0).total_seconds() * 1000)
        log_step(conn, ticket_id, idx, cmd, rc, dur)

        if rc != 0:
            failed += 1
            log(f"  exit {rc}  ({dur}ms)")
            if result.stderr:
                for line in result.stderr.strip().splitlines()[:5]:
                    log(f"  stderr: {line}")
            if on_fail == "halt":
                close_ticket(conn, ticket_id, "halted", f"step {idx+1} failed")
                return "halted"
        else:
            log(f"  ok  ({dur}ms)")
            if result.stdout:
                for line in result.stdout.strip().splitlines()[:20]:
                    print(line)  # stdout — agent captures this

    status = "ok" if failed == 0 else "broken"
    close_ticket(conn, ticket_id, status)
    return status

# ---- Commands -----------------------------------------------------------
def cmd_list():
    import yaml
    log("Available intents:")
    for f in sorted(INTENTS.glob("*.yaml")):
        with open(f) as fh:
            d = yaml.safe_load(fh)
        name = f.stem
        desc = d.get("description", "")[:60]
        log(f"  {name}")
        if desc:
            log(f"    {desc}")

def cmd_run(intent_name, raw_args):
    intent_path = INTENTS / f"{intent_name}.yaml"
    if not intent_path.exists():
        log(f"ERROR: unknown intent: {intent_name}")
        sys.exit(1)

    import yaml
    with open(intent_path) as f:
        intent = yaml.safe_load(f)

    conn = init_db()
    args = resolve_args(intent, raw_args)
    ticket_id = open_ticket(conn, intent_name, "direct")
    log(f"[estate] intent={intent_name}  ticket={ticket_id}")

    status = run_steps(conn, ticket_id, intent, args)
    log(f"[estate] status={status}")
    return status


def cmd_harness(harness_name, intent_name, goal, raw_args):
    """Harness mode: set up restricted env, run steps, then spawn the harness."""
    intent_path = INTENTS / f"{intent_name}.yaml"
    if not intent_path.exists():
        log(f"ERROR: unknown intent: {intent_name}")
        sys.exit(1)

    import yaml
    import tempfile
    with open(intent_path) as f:
        intent = yaml.safe_load(f)

    conn = init_db()
    args = resolve_args(intent, raw_args)
    ticket_id = open_ticket(conn, intent_name, harness_name, goal)
    log(f"[estate] intent={intent_name}  ticket={ticket_id}  harness={harness_name}")

    # --- Build session HOME with allowlisted tools + runtime deps -------
    tools = intent.get("tools", [])
    # Always include these runtime deps regardless of intent
    always = ["node", "python3", "bash", "sh", "cat", "ls", "mkdir",
               "rm", "grep", "rg", "sed", "awk", "git", "gh"]
    needed = list(dict.fromkeys(always + tools))  # dedupe, always first
    session_home = Path(tempfile.mkdtemp(prefix="estate-session."))
    (session_home / ".bin").mkdir()
    for tool in needed:
        tool_path = Path(shutil.which(tool))
        if tool_path.exists():
            (session_home / ".bin" / tool).symlink_to(tool_path)

    # --- Environment scrub (keep real HOME — curl needs it for cert lookup) ------
    scrub_vars = [
        "MINIMAX_API_KEY", "DEEPSEEK_API_KEY", "OPENAI_DIRECT_KEY",
        "ANTHROPIC_DIRECT_KEY", "OPENROUTER_API_KEY", "GROQ_API_KEY",
        "CEREBRAS_API_KEY", "KUBECONFIG",
        "MINIMAX_BASE_URL", "DEEPSEEK_BASE_URL",
    ]
    for var in scrub_vars:
        os.environ.pop(var, None)

    # --- Set estate-controlled env (PATH narrowed, real HOME preserved) ---
    os.environ["PATH"] = f"{session_home}/.bin:/usr/bin:/bin:/usr/sbin:/sbin"
    os.environ["ESTATE_INTENT"] = intent_name
    os.environ["ESTATE_HARNESS"] = harness_name
    os.environ["ESTATE_TICKET"] = ticket_id
    os.environ["ESTATE_GOAL"] = goal or ""
    agent_key = os.environ.get("ESTATE_AGENT_KEY", "")
    if agent_key:
        os.environ["OPENAI_API_KEY"] = agent_key
        os.environ["ANTHROPIC_API_KEY"] = agent_key
    os.environ["OPENAI_BASE_URL"] = "https://llm.mumchimp.com/v1"
    os.environ["ANTHROPIC_BASE_URL"] = "https://llm.mumchimp.com/v1"
    os.environ["SSL_CERT_FILE"] = "/private/etc/ssl/cert.pem"
    os.environ["SSL_CERT_DIR"] = "/private/etc/ssl/certs"

    # --- Cleanup trap ---------------------------------------------------
    def cleanup():
        shutil.rmtree(session_home, ignore_errors=True)
    atexit.register(cleanup)

    # --- Run intent steps -----------------------------------------------
    status = run_steps(conn, ticket_id, intent, args)
    log(f"[estate] status={status}")

    if status == "halted":
        sys.exit(1)

    # --- Spawn real harness ---------------------------------------------
    libexec_dir = HOME / ".estate" / "libexec"
    real_bin = libexec_dir / f"{harness_name}-real"
    if not real_bin.exists():
        # Fallback: find on original PATH
        import shutil as sh
        orig_path = "/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin"
        found = sh.which(harness_name, path=orig_path)
        if found:
            real_bin = Path(found)
        else:
            log(f"ERROR: harness binary not found: {harness_name}")
            log(f"Expected: {libexec_dir}/{harness_name}-real")
            sys.exit(1)

    # Pass through remaining args (the goal is already in ESTATE_GOAL)
    os.execv(str(real_bin), [str(real_bin)] + raw_args)  # noqa: S606  # noqa: S606


# ---- Main ---------------------------------------------------------------
if __name__ == "__main__":
    import shutil
    import atexit

    if len(sys.argv) == 1 or sys.argv[1] == "--list":
        cmd_list()
        sys.exit(0)

    harness_name = None
    intent_name = None
    goal = ""
    raw_args = []

    # Mode 1: estate-execute <harness> --intent=<name> [--goal=...]
    # Mode 2: estate-execute <intent> [arg=val ...]
    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == "--intent" and i + 1 < len(sys.argv):
            intent_name = sys.argv[i + 1]
            i += 2
        elif arg.startswith("--intent="):
            intent_name = arg.split("=", 1)[1]
            i += 1
        elif arg.startswith("--goal="):
            goal = arg.split("=", 1)[1]
            i += 1
        elif harness_name is None and intent_name is None:
            # First positional: could be harness or intent
            harness_name = arg
            i += 1
        else:
            raw_args.append(arg)
            i += 1

    # Resolve: if first arg is a harness, intent must follow
    if harness_name and intent_name:
        # Harness mode
        cmd_harness(harness_name, intent_name, goal, raw_args)
    elif harness_name and not intent_name:
        # Could be intent name or unknown harness
        if (INTENTS / f"{harness_name}.yaml").exists():
            cmd_run(harness_name, raw_args)
        else:
            log(f"ERROR: unknown harness or intent: {harness_name}")
            log("usage: estate-execute <harness> --intent=<name>  # harness mode")
            log("       estate-execute <intent> [arg=val...]       # direct mode")
            log("       estate-execute --list")
            sys.exit(1)
    elif intent_name:
        cmd_run(intent_name, raw_args)
    else:
        cmd_list()
        sys.exit(0)

    sys.exit(0)
