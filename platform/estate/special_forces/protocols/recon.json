{
  "name": "recon",
  "version": 1,
  "max_retries_per_stage": 2,
  "stages": [
    {"name": "map_edges", "budget_tokens": 20000, "validator": "json_nonempty",
     "contract_stage": "address_edgecases",
     "writes": ["work/{claim}/edge_cases.json"]},
    {"name": "second_order", "budget_tokens": 20000, "validator": "json_nonempty",
     "contract_stage": "address_2nd_order_effects",
     "writes": ["work/{claim}/second_order.json"]},
    {"name": "write_bdd", "budget_tokens": 30000, "validator": "covers_edges", "edge_stage": "map_edges",
     "contract_stage": "add_bdd",
     "writes": ["specs/{claim}.feature"]}
  ]
}
