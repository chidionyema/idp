{
  "name": "ops",
  "version": 1,
  "requires_prove_cmd": true,
  "max_retries_per_stage": 2,
  "stages": [
    {"name": "plan", "budget_tokens": 15000, "validator": "json_nonempty",
     "contract_stage": "declare_plan",
     "writes": ["work/{claim}/plan.json"]},
    {"name": "wire", "budget_tokens": 60000, "validator": "json_nonempty",
     "contract_stage": "implement",
     "writes": ["work/{claim}/wiring.json", "src/*", "bin/*", "platform/*", "config/*"]},
    {"name": "prove", "budget_tokens": 20000, "validator": "claim_command", "timeout": 600,
     "contract_stage": "complete_goal",
     "writes": ["work/{claim}/proof.json"]}
  ]
}
