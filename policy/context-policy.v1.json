      "mission_aggregate_cap": 48000,
      "reasoning_effort_clamp": "low",
      "soft_context_cap": 16000,
      "turn_1_prefix_cap": 6000
    },
    "role:sandbox-legion": {
      "description": "Lane 3 agent-sandbox and Legion 8 sub-agent swarm",
      "hard_context_cap": 48000,
