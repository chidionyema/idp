{
  "name": "@fleetview/voice",
  "version": "0.1.0",
  "description": "FleetView voice SDK - voice control in 3 minutes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "voice",
    "speech",
    "asr",
    "tts",
    "vad",
    "whisper",
    "kokoro",
    "silero",
    "fleetview"
  ],
  "author": "FleetView",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fleetview/voice.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@xenova/transformers": "^2.17.0",
    "kokoro-js": "^1.0.0",
    "onnxruntime-web": "^1.17.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "overrides": {
    "sharp": "^0.35.4",
    "@huggingface/transformers": "^4.3.0"
  }
}
