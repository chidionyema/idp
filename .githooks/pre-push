#!/usr/bin/env bash
# .githooks/pre-push -- the estate hook router (core.hooksPath, ~/.estate/guards/hooks) runs this
# before every push from idp, then nothing else: a repo hook replaces the shared LAW 32 default, so
# this file must run that gate itself (last).
#
# crew#584 CP2 (founder 2026-08-28, "the loop is a hook, not a habit"): 13 failing commits in the
# last 100 CI runs, 2 of them a wall-clock fixture since fixed, 11 real reds that a laptop could have
# refused in seconds -- offline-gate/bdd (the tests) 40 of 55 failed jobs, the PR-body gates 9.
# Mean 8 commits per merged PR, 7.2 min per CI run. This hook runs, in order:
#   1. bin/idp-push-on-green   refuses a push to a branch whose PR is already green (2.2s measured)
#   2. bin/pr-report           the PR-body gates CI's operating-model-gate/spec-gate would refuse (7.8s)
#   3. bin/idp-kyverno-render  the cluster's own admission policies over the changed platform dirs
#   4. the shared LAW 32 gate the router would have run
# A red refuses the push. No test rung: R58 makes this hook lint-only, and the tests are CI's.
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
# Incident 2026-08-28: git exports GIT_DIR/GIT_INDEX_FILE/GIT_PREFIX to hooks, so every test that builds a
# throwaway repo (git init in tmp) committed into THIS branch when run from here -- five junk commits, one
# of them 841 files deleted (crew#584). The tests run in a clean git environment, always.
for v in $(compgen -e | grep '^GIT_' || true); do unset "$v"; done
# crew#584 (idp#628, 2026-08-28): a green PR is merged, not pushed to -- three re-pushes turned a
# 7-minute PR into 21 minutes. Runs first: it is instant and it is the only rung that refuses work.
"$IDP/bin/idp-push-on-green"
# bin/idp-tests-for used to run here and no longer does (founder 2026-08-31, doc
# ~/.claude/docs/founder/2026-08-31T0234Z-cccou-are-right-to-be-furious-i-was-274594b7.md:
# "The heavy integration tests (the 397 files) must be physically removed from the local pre-push
# hook and shifted exclusively to GitHub Actions", and R58: local hooks are lint-only, under 5s).
# Measured on this repo the night it was removed: a 13-file diff selected 397 test files and ran
# 1,628 tests in 33m34s, and all 14 of its failures were `subprocess.TimeoutExpired after 60
# seconds` -- failures the selection's own load invented, with zero real reds underneath. A gate
# that manufactures its own red is not a gate. The tool stays and CI runs it with the blanket on
# (bin/idp-tests-for sets it from $CI); run it by hand here when you want it.
"$IDP/bin/pr-report"
# crew#623 (founder 2026-08-29, "why did you not investigate cluster before starting"): the money
# layer was written from a chart's values file and reasoned about, and its render failed 128 of the
# cluster's own admission rules -- found by CI, 7 minutes and a red pull request later. The judge
# that finds it in seconds was already here (bin/idp-kyverno-render, offline, no cluster, no
# secrets); nothing local ran it. Scoped to the dirs this push changes, so it stays seconds.
# BLIND (helm, kyverno or kubectl absent) does not refuse a push: a fence a correct machine cannot
# satisfy is an outage (LAW 38), and CI still judges. A failing render does refuse.
kyv_base="$(git rev-parse --verify --quiet origin/main || true)"
if [ -n "$kyv_base" ]; then
	kyv_dirs="$("$IDP/bin/idp-kyverno-dirs" "$kyv_base" --narrow | tr '\n' ' ')"
	if [ -n "${kyv_dirs// /}" ]; then
		set +e
		kyv_out="$("$IDP/bin/idp-kyverno-render" $kyv_dirs 2>&1)"
		kyv_rc=$?
		set -e
		case "$kyv_rc" in
		0) echo "ok    kyverno  $kyv_dirs render clean against the cluster's admission policies" ;;
		2) echo "BLIND kyverno  the judge did not run here; CI judges $kyv_dirs" ;;
		*)
			echo "FAIL  kyverno  a render in $kyv_dirs is refused by admission policy"
			printf '%s\n' "$kyv_out" | grep -vE '^ok ' | tail -40
			exit 1
			;;
		esac
	fi
fi
shared="$(git config --get core.hooksPath 2>/dev/null || true)/law32-default"
if [ -x "$shared" ]; then exec "$shared" "$@"; fi
exit 0
