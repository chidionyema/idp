#!/usr/bin/env bash
# Layer 0: STRUCTURAL — model- and harness-agnostic enforcement (AGENTS.md R6)
# Refuses any push that introduces or retains a .claude/, claude-code/ or .pi/ path.
# The estate is model- and harness-agnostic. One execution boundary: ~/.estate/.
# A second boundary (a harness's own per-project folder) is stitching and gets deleted.
# This layer runs before everything else and cannot be bypassed by the agent it guards.
# Protocol: git pre-push stdin = "<local ref> <local sha> <remote ref> <remote sha>" per ref.
#
# This is a client-side backstop only. bin/idp-ci-guarded-paths enforces the same ban server-side
# on the required `guarded-paths` CI check, which a bot commit, a hookless machine or a GitHub-UI
# merge cannot skip the way they skip this hook.

_no_claude_guard() {
  blocked=0
  while IFS= read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    changed=$(git diff-tree --name-only -r "$remote_sha" "$local_sha" 2>/dev/null) || continue
    if echo "$changed" | grep -qE '(\.claude/|/\.claude/|claude-code/|\.pi/|/\.pi/)'; then
      blocked=1
    fi
  done
  if [ "$blocked" = 1 ]; then
    echo "FAIL [.githooks/pre-push] push contains a .claude/, claude-code/ or .pi/ path" >&2
    echo "The estate is model- and harness-agnostic. Canonical home: ~/.estate/" >&2
    echo "Migrate hooks to ~/.estate/hooks/ and rewrite bootstrap for ~/.estate/" >&2
    return 1
  fi
  echo "ok    Layer 0 (no-claude): clean"
}

# Run Layer 0 inline — exit 1 here exits the whole hook, not a subshell
if ! _no_claude_guard; then
  exit 1
fi

# Idempotent protection against fast-gate / python-strict failures reaching the OKE CI.
# Refuses the push if `bin/idp-ci` (fast mode) reports red. This is the 29% class: ruff
# E9/F/B/S, hardcode scan, shellcheck. They have hit the remote CI 33 times in the last
# 3 months across both `ci` and `build-multiarch` workflows and added nothing actionable;
# all of them are caught locally by the same script on the same files before commit.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# crew#1194: syntax gate on the push diff. Parse-only checks, no execution.
# A file with bad syntax on main makes main red. Main must be green.
# Layer 1 of 3: pre-push | CI offline-gate | CI fast-gate.
while IFS= read -r _ _ _ remote_sha; do
  [ -n "$remote_sha" ] || continue
  break
done
refs=""
while IFS= read -r local_ref local_sha remote_ref remote_sha; do
  refs="${refs}${local_ref} ${local_sha} ${remote_ref} ${remote_sha}"$'\n'
done
while IFS= read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$remote_sha" ] && continue
  diff_files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || true)
  # Layer 1a: bash -n on shell files
  for f in $diff_files; do
    case "$f" in
    *.sh|*.bash) is_shell=1 ;;           # shell extension
    bin/*|.githooks/*) is_shell=1 ;;           # shebang convention
    *) is_shell=0 ;;                          # skip non-shell
    esac
    if [ "$is_shell" = 1 ] && [ -f "$f" ]; then
      if ! bash -n "$f" 2>&1; then
        bash -n "$f" >&2
        echo "pre-push REFUSED: syntax error in $f" >&2
        exit 1
      fi
    fi
  done
  # Layer 1b: python3 -m py_compile on Python files
  for f in $diff_files; do
    case "$f" in
    *.py) is_py=1 ;;                      # python extension
    *) is_py=0 ;;                         # skip non-python
    esac
    if [ "$is_py" = 1 ] && [ -f "$f" ]; then
      if ! python3 -m py_compile "$f" 2>&1; then
        python3 -m py_compile "$f" >&2
        echo "pre-push REFUSED: syntax error in $f" >&2
        exit 1
      fi
    fi
  done
  # Layer 1c: no non-ASCII bytes on any tracked file
  for f in $diff_files; do
    [ -f "$f" ] || continue
    if python3 -c "
import sys
with open('$f', 'rb') as fh:
    for i, b in enumerate(fh.read()):
        if b > 127:
            sys.exit(i + 1)
sys.exit(0)
" 2>&1; then
      : # clean
    else
      python3 -c "
with open('$f', 'rb') as fh:
    data = fh.read()
    positions = [(i+1, b) for i, b in enumerate(data) if b > 127]
print('non-ASCII byte(s) at:', positions[:5], '(first 5)')
" >&2
      echo "pre-push REFUSED: non-ASCII bytes in $f" >&2
      exit 1
    fi
  done
done <<<"$refs"

# Read-only force pushes and the WIP-gate override are out of scope for this rung --
# the andon-cord pre-push has its own override (IDP_WIP_GATE=0) and that is not ours.
# This rung only refuses the fast-gate class; everything else still flows.
#
# NO OFF SWITCH (founder, 2026-09-23). `IDP_FAST_GATE=0` used to sit here and exit 0. It was
# used -- by this session -- to push past the rung, which is how four pushes went out in
# nineteen minutes each revealing one more failure: a bypass that makes the gate report green
# on a tree the gate never read is worse than no gate, because the green is believed.
#
# The two rules are enforced server-side instead, where no local action can skip them:
# `bin/idp-main-green-gate` and `bin/idp-wip-gate` are wired in below, and the estate's
# required-checks ruleset refuses on the server. A local hook is a convenience that saves a CI
# cycle; it is never the guarantee, and it must not pretend to be one.

if [ ! -x "$repo_root/bin/idp-ci" ]; then
  # No local CI script on this checkout (e.g. a partial clone). The remote is the
  # only enforcement; nothing to refuse here.
  echo "idp-fast-gate: bin/idp-ci not present, skipping"
  exit 0
fi

echo "🛡️  idp-fast-gate: running IDP_CI_FAST=1 bin/idp-ci ..."
if ! IDP_CI_FAST=1 "$repo_root/bin/idp-ci"; then
  cat <<'EOF' >&2

❌ pre-push REFUSED: idp-fast-gate caught errors.

   The remote CI cannot run faster than your laptop, and the failure class this
   gate catches (29% of all OKE failures in the last 3 months) has never produced
   actionable signal in CI -- only noise.

   Fix:
     1) bin/idp-ci            # see the failures in full
     2) re-run IDP_CI_FAST=1 bin/idp-ci until green
     3) git push

   The two rules that must never be bypassed are enforced SERVER-SIDE:
     bin/idp-main-green-gate   refuses a push while main's last CI run is red
     bin/idp-wip-gate          refuses a new PR past the 3-failing-PR cap
   Their overrides are typed deliberately for genuine emergencies, and they are the
   only overrides this hook has. This rung has none.

EOF
  exit 1
fi

echo "✅ idp-fast-gate: green"

# ---------------------------------------------------------------------------
# TRUNK ROUTING (advice, never a refusal).
#
# The dual-trunk model puts agent work on `agent-trunk`, which needs no PR, and leaves
# `main` protected for batched review only. A push of a feature branch is CORRECT under
# the model too -- the branch is incidental, and `agent-trunk-batch.yml` batches whatever
# reaches agent-trunk. So this prints what trunk a push is aimed at and does not block:
# a fence that refused every branch push would be an outage, not enforcement (LAW 38).
#
# The enforcement is elsewhere and is real: the ruleset on `main` (no direct push, no
# force, no deletion), the ruleset on `agent-trunk` (no force, no deletion, linear), and
# the gate above, which is what actually refuses a red push.
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/main)
		echo "⚠️  pre-push: pushing directly to main. Batch agent work to agent-trunk instead:"
		echo "      git push origin HEAD:agent-trunk   # then agent-trunk-batch.yml opens one PR"
		;;
	esac
done

exit 0
