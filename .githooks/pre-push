#!/usr/bin/env bash
# .githooks/pre-push -- the estate hook router (core.hooksPath, ~/.estate/guards/hooks) runs this
# before every push from idp, then nothing else: a repo hook replaces the shared LAW 32 default, so
# this file must run that gate itself (last).
#
# crew#584 CP2 (founder 2026-08-28, "the loop is a hook, not a habit"): 13 failing commits in the
# last 100 CI runs, 2 of them a wall-clock fixture since fixed, 11 real reds that a laptop could have
# refused in seconds -- offline-gate/bdd (the tests) 40 of 55 failed jobs, the PR-body gates 9.
# Mean 8 commits per merged PR, 7.2 min per CI run. This hook runs, in order:
#   0. bin/idp-main-green-gate  on a new branch: refuses if main CI is red (founder 2026-09-17)
#      bin/idp-wip-gate         on a new branch: refuses if >= 3 PRs are already failing (founder 2026-09-17)
#   1. bin/idp-push-on-green   refuses a push to a branch whose PR is already green (2.2s measured)
#   2. bin/pr-report           gitleaks over the lines this push adds, the estate-zone literals
#                              among them, and the five content rules of policy/operating_model.rego.
#                              It used to run eight PR-body prose gates too, naming two workflows
#                              deleted on 2026-09-04; those went on refusing pushes for four more
#                              days and were deleted here on 2026-09-08.
#   3. bin/idp-kyverno-render  the cluster's own admission policies over the changed platform dirs
#   4. the shared LAW 32 gate the router would have run
# A red refuses the push. No test rung: R58 makes this hook lint-only, and the tests are CI's.
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
# bin/idp-install-deps installs tools to ~/.cache/estate-tools/; ensure they're on PATH.
export PATH="$HOME/.cache/estate-tools:$PATH"
# Artifact 3 (founder 2026-09-17): a push against an unverified tree is refused.
# bin/idp-ci --full runs the complete matrix, requires all tools, and writes
# ~/.cache/idp-ci-verified/<HEAD-sha> on success. Without it, this hook exits 1.
# Override for genuine emergencies: IDP_CI_FULL_VERIFIED=1 git push
_HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo unknown)
_SENTINEL="$HOME/.cache/idp-ci-verified/$_HEAD_SHA"
if [ "${IDP_CI_FULL_VERIFIED:-0}" != "1" ] && [ ! -f "$_SENTINEL" ]; then
  echo "REFUSE pre-push: full CI matrix has not been run against this tree."
  echo "       Run: bin/idp-ci --full"
  echo "       (install missing tools first if needed: bin/idp-install-deps)"
  echo "       Emergency override: IDP_CI_FULL_VERIFIED=1 git push"
  exit 1
fi
# Incident 2026-08-28: git exports GIT_DIR/GIT_INDEX_FILE/GIT_PREFIX to hooks, so every test that builds a
# throwaway repo (git init in tmp) committed into THIS branch when run from here -- five junk commits, one
# of them 841 files deleted (crew#584). The tests run in a clean git environment, always.
for v in $(compgen -e | grep '^GIT_' || true); do unset "$v"; done
# Founder 2026-09-17 (Andon cord): every branch drawn from a broken main inherits its failures,
# and agents that open new PRs while existing ones are red compound the pile-up. These two gates
# fire ONLY on the first push of a new branch (remote sha = 000...000) so they never block a fix
# being pushed onto an existing branch. BLIND (no gh / no network) exits 2 and does NOT refuse.
new_branch=false
while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [ "$_remote_sha" = "0000000000000000000000000000000000000000" ]; then
        new_branch=true
    fi
done
if [ "$new_branch" = true ]; then
    set +e
    main_rc=0
    main_out=$("$IDP/bin/idp-main-green-gate" 2>&1); main_rc=$?
    set -e
    echo "$main_out"
    [ "$main_rc" = 1 ] && exit 1
    set +e
    wip_rc=0
    wip_out=$("$IDP/bin/idp-wip-gate" 2>&1); wip_rc=$?
    set -e
    echo "$wip_out"
    [ "$wip_rc" = 1 ] && exit 1
fi
# crew#584 (idp#628, 2026-08-28): a green PR is merged, not pushed to -- three re-pushes turned a
# 7-minute PR into 21 minutes. Runs first: it is instant and it is the only rung that refuses work.
"$IDP/bin/idp-push-on-green"
# bin/idp-tests-for used to run here and no longer does (founder 2026-08-31, doc
# ~/.claude/docs/founder/2026-08-31T0234Z-cccou-are-right-to-be-furious-i-was-274594b7.md:
# "The heavy integration tests (the 397 files) must be physically removed from the local pre-push
# hook and shifted exclusively to GitHub Actions", and R58: local hooks are lint-only, under 5s).
# Measured on this repo the night it was removed: a 13-file diff selected 397 test files and ran
# 1,628 tests in 33m34s, and all 14 of its failures were `subprocess.TimeoutExpired after 60
# seconds` -- failures the selection's own load invented, with zero real reds underneath. A gate
# that manufactures its own red is not a gate. The tool stays and CI runs it with the blanket on
# (bin/idp-tests-for sets it from $CI); run it by hand here when you want it.
"$IDP/bin/pr-report"
# The session plane of rules.yaml, over the files this push changes (bin/idp-rules session).
# The same registry the offline gate reads; the rows that carry planes: [ci, session] are the ones
# a laptop can judge on a file it just wrote -- a hardcoded checkout path (LAW 46), a shell
# expansion Flux would rewrite (incident 2026-09-06), a test that pins prose (R76). Seconds, and
# lint-only (R58). A rule grades only the paths its session_glob claims, so it can never refuse
# correct work in a file it does not understand (LAW 38).
sess_base="$(git rev-parse --verify --quiet origin/main || true)"
if [ -n "$sess_base" ]; then
	sess_files="$(git diff --name-only --diff-filter=d "$sess_base"...HEAD | tr '\n' ' ')"
	if [ -n "${sess_files// /}" ]; then
		# shellcheck disable=SC2086  # the file list is meant to split
		python3 "$IDP/bin/idp-rules" session --files $sess_files || exit 1
	fi
fi
# crew#623 (founder 2026-08-29, "why did you not investigate cluster before starting"): the money
# layer was written from a chart's values file and reasoned about, and its render failed 128 of the
# cluster's own admission rules -- found by CI, 7 minutes and a red pull request later. The judge
# that finds it in seconds was already here (bin/idp-kyverno-render, offline, no cluster, no
# secrets); nothing local ran it. Scoped to the dirs this push changes, so it stays seconds.
# BLIND (helm, kyverno or kubectl absent) does not refuse a push: a fence a correct machine cannot
# satisfy is an outage (LAW 38), and CI still judges. A failing render does refuse.
kyv_base="$(git rev-parse --verify --quiet origin/main || true)"
if [ -n "$kyv_base" ]; then
	kyv_dirs="$("$IDP/bin/idp-kyverno-dirs" "$kyv_base" --narrow | tr '\n' ' ')"
	if [ -n "${kyv_dirs// /}" ]; then
		set +e
		kyv_out="$("$IDP/bin/idp-kyverno-render" $kyv_dirs 2>&1)"
		kyv_rc=$?
		set -e
		case "$kyv_rc" in
		0) echo "ok    kyverno  $kyv_dirs render clean against the cluster's admission policies" ;;
		2)
			# bin/idp-install-deps installs helm+kyverno; fail if they're still absent after PATH is set.
			# Other exit-2 causes (kubectl missing, policy fetch failed) are BLIND per LAW 38.
			if ! command -v kyverno >/dev/null 2>&1 || ! command -v helm >/dev/null 2>&1; then
				echo "FAIL  kyverno  helm or kyverno not installed; run bin/idp-install-deps then retry"; exit 1
			fi
			echo "BLIND kyverno  render skipped (kubectl or policies unavailable); CI enforces the same gate"
			;;
		*)
			echo "FAIL  kyverno  a render in $kyv_dirs is refused by admission policy"
			printf '%s\n' "$kyv_out" | grep -vE '^ok ' | tail -40
			exit 1
			;;
		esac
	fi
fi
# Deterministic Verifier gate (founder 2026-09-13, "no unverified change can land"). The lint
# gates above and law32-gate below are fast and catch most defects; this rung mints a
# Sigstore-attested verifier receipt for the push diff and refuses the push unless that
# receipt carries claim_verdict=VERIFIED. R58 says hooks stay lint-only under 5s; this rung
# adds 5-10s because cosign + Sigstore are unavoidable. The MCP endpoint is the one named
# in ADR 0006 (mcp/__init__.py) so a future CI job reads the same ledger without a second
# trust boundary.
remote_name="${1:-origin}"
branch_name="$(git rev-parse --abbrev-ref HEAD)"
# 2026-09-17: in-process verifier — no daemon, no MCP service, no founder install step.
# sovereign/verifier.py is a pure library; call it directly. Eliminates the BLIND condition
# that existed because the MCP server at 127.0.0.1:8001 was never running.
# Design rule: every enforcement point is a git hook or CI job. No service required.
set +e
python3 - "$IDP" "$remote_name" "$branch_name" <<'PYVERIFY'
import sys, subprocess, importlib.util, pathlib, json

idp, remote, branch = sys.argv[1], sys.argv[2], sys.argv[3]
sovereign = pathlib.Path(idp) / "sovereign"
if not sovereign.is_dir():
    print("BLIND verifier  sovereign/ not found; skipping in-process verify")
    sys.exit(0)

# Load verifier as library — no daemon, no socket, no service.
spec = importlib.util.spec_from_file_location("verifier", sovereign / "verifier.py")
mod = importlib.util.module_from_spec(spec)
sys.modules["verifier"] = mod  # required: verifier.py references itself by name
try:
    spec.loader.exec_module(mod)
except Exception as e:
    print(f"BLIND verifier  could not load verifier.py: {e}")
    sys.exit(0)

# Get the diff of this push.
diff = subprocess.run(
    ["git", "diff", f"{remote}/{branch}", "HEAD", "--diff-algorithm=myers"],
    capture_output=True, text=True, cwd=idp,
).stdout
if not diff.strip():
    print("ok    verifier  no diff to verify")
    sys.exit(0)

# Propose and verify in-process.
try:
    import tempfile, uuid
    files = mod.parse_unified_diff(diff)
    if not files:
        print("ok    verifier  no Python files in diff")
        sys.exit(0)
    ledger_id = str(uuid.uuid4())
    ledger_dir = pathlib.Path(tempfile.mkdtemp()) / ledger_id
    ledger_dir.mkdir(parents=True, exist_ok=True)
    # Default tests: test_verifier_hooks.py (same default as bin/idp-prepush-verify).
    test_src = ""
    default_tests = pathlib.Path(idp) / "tests" / "test_verifier_hooks.py"
    if default_tests.exists():
        test_src = default_tests.read_text()
    ledger = mod.Ledger(
        ledger_id=ledger_id,
        ledger_dir=ledger_dir,
        files=files,
        tests=test_src,
        claim="pre-push gate",
    )
    result = mod.verify(ledger)
    verdict = result.get("claim_verdict", "FAILED")
    admissible = result.get("admissible", False)
    if verdict == "VERIFIED" and admissible:
        print(f"ok    verifier  {verdict}; push allowed")
        sys.exit(0)
    else:
        stages = result.get("stages", {})
        failing = [s for s, v in stages.items() if not v.get("passed", True)]
        print(f"FAIL  verifier  {verdict} admissible={admissible} failing_stages={failing}")
        sys.exit(1)
except Exception as e:
    print(f"BLIND verifier  in-process verify raised {type(e).__name__}: {e}")
    sys.exit(0)
PYVERIFY
verifier_rc=$?
set -e
[ "$verifier_rc" = 1 ] && exit 1
set +e
law32_out="$(python3 "$IDP/bin/law32-gate" 2>&1)"
law32_rc=$?
set -e
echo "$law32_out"
[ "$law32_rc" = 1 ] && exit 1
exit 0
