#!/usr/bin/env bash
# Layer 0: STRUCTURAL — model-agnostic enforcement (AGENTS.md R6)
# Refuses any push that introduces or retains .claude/ or claude-code paths.
# The estate is model-agnostic. One execution boundary: ~/.estate/.
# A second boundary (.claude/) is stitching and gets deleted.
# This layer runs before everything else and cannot be bypassed by the agent it guards.
# Protocol: git pre-push stdin = "<local ref> <local sha> <remote ref> <remote sha>" per ref.

_no_claude_guard() {
  blocked=0
  while IFS=" " read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_ref" ] && continue
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    changed=$(git diff-tree --name-only -r "$remote_sha" "$local_sha" 2>/dev/null) || continue
    if echo "$changed" | grep -qE '(\.claude/|/\.claude/|claude-code/)'; then
      blocked=1
    fi
  done
  if [ "$blocked" = 1 ]; then
    echo "FAIL [.githooks/pre-push] push contains .claude/ or claude-code paths" >&2
    echo "The estate is model-agnostic. Canonical home: ~/.estate/" >&2
    echo "Migrate hooks to ~/.estate/hooks/ and rewrite bootstrap for ~/.estate/" >&2
    return 1
  fi
  echo "ok    Layer 0 (no-claude): clean"
}

# The refs arrive once on stdin; read them once. idp#5611: Layer 0 used to read stdin itself,
# which left every later `while read` here with nothing. Layer 1 below still reads stdin, so it
# still sees nothing -- unchanged on purpose: switching it on would start refusing pushes on a
# non-ASCII rule this very file breaks. That is its own decision.
push_refs="$(cat)"

# Run Layer 0 inline — exit 1 here exits the whole hook, not a subshell
if ! _no_claude_guard <<<"$push_refs"; then
  exit 1
fi

# idp#5611: a pushed branch is judged by the claim-gate CI runs, before it leaves the laptop.
# PR #5606 went out by hand (git push + gh pr create, no lane-submit), carried no Claim line,
# and was first refused in the merge queue, a batch later. A lane commit must carry
# `Claim: <owner>/<repo>#<n>` and `Agent: <name>`, and the issue a live CLAIM comment.
# When the gate cannot judge (offline, no gh) the push goes through BLIND; CI is the guarantee.
_claim_guard() {
  local root out rc repo base
  root="$(git rev-parse --show-toplevel)"
  [ -x "$root/bin/claim-gate" ] || { echo "BLIND claim-gate: not in this checkout"; return 0; }
  repo="${GITHUB_REPOSITORY:-$(git remote get-url origin 2>/dev/null | sed -E 's#\.git$##; s#^.*[:/]([^/]+/[^/]+)$#\1#')}"
  while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    # Every branch, not only lane/*: CI runs claim-gate on every pull request. Measured 2026-10-14:
    # each claim-gate failure in the last 100 CI runs came from a branch this guard skipped
    # (fix/*, perf/*, voice-estate-memory, mem-wire-all-agents). main and queue/* are the
    # Greenlane's own pushes, judged per lane in CI.
    case "$remote_ref" in refs/heads/main | refs/heads/queue/*) continue ;; refs/heads/*) ;; *) continue ;; esac
    [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
    lane_branch="${remote_ref#refs/heads/}"
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null)" || {
      echo "BLIND claim-gate: no origin/main to judge ${remote_ref#refs/heads/} against"
      continue
    }
    rc=0
    out="$(GITHUB_REPOSITORY="$repo" "$root/bin/claim-gate" "$base" "$local_sha" 2>&1)" || rc=$?
    if [ "$rc" = 0 ]; then
      echo "$out"
    elif grep -q '^FAIL  claim-gate' <<<"$out"; then
      grep '^FAIL  claim-gate' <<<"$out" >&2
      cat <<EOF >&2

pre-push REFUSED: ${remote_ref#refs/heads/} does not land on a live claim (AGENTS.md §5).
   CI's claim-gate would refuse it in the merge queue, a batch later. Fix:
     one command: bin/claim-open --title "<what you are building>"   (or --issue <n>)
   It opens the issue, posts the CLAIM comment covering exactly the files you changed, stamps
   the two trailers, and runs claim-gate to prove it. What claim-gate itself checks:
     1) a commit on the lane carries:   Claim: $repo#<issue>   and   Agent: <name>
     2) the issue is open, and carries a comment
        CLAIM agent=<name> paths=<glob,glob> heartbeat=<UTC ISO time>
        that is the newest CLAIM on that issue, with paths covering every file the lane touches
   (No \`in-progress\` label any more, and the \`model\` field is optional, since 2026-10-10.)
   platform/estate/bin/estate-execute lane-submit checks the same before it pushes.
EOF
      return 1
    else
      echo "BLIND claim-gate could not judge ${remote_ref#refs/heads/}: $(tail -1 <<<"$out")"
    fi
  done <<<"$push_refs"
}

lane_branch=""
if ! _claim_guard; then
  exit 1
fi

# Idempotent protection against fast-gate / python-strict failures reaching the OKE CI.
# Refuses the push if `bin/idp-ci` (fast mode) reports red. This is the 29% class: ruff
# E9/F/B/S, hardcode scan, shellcheck. They have hit the remote CI 33 times in the last
# 3 months across both `ci` and `build-multiarch` workflows and added nothing actionable;
# all of them are caught locally by the same script on the same files before commit.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# crew#1194: syntax gate on the push diff. Parse-only checks, no execution.
# A file with bad syntax on main makes main red. Main must be green.
# Layer 1 of 3: pre-push | CI offline-gate | CI fast-gate.
# #7434: the refs were read once at the top. Reading stdin again here yielded nothing, so every
# layer below judged zero refs and passed.
refs="$push_refs"
while IFS=" " read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$remote_sha" ] && continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  # #7434: a new branch arrives with remote sha 0000, whose diff is empty; judge it against main.
  from="$remote_sha"
  [ "$from" = "0000000000000000000000000000000000000000" ] && from="$(git merge-base origin/main "$local_sha" 2>/dev/null || git rev-parse origin/main 2>/dev/null || echo "")"
  diff_files=$(git diff --name-only --diff-filter=ACMR "$from" "$local_sha" 2>/dev/null || true)
  # Layer 1c (#7434): ruff on the pushed Python, with the system ruff, so it runs in every
  # checkout -- sparse worktrees carry no bin/idp-ci, and the fast gate below skips there.
  py_files=$(printf '%s\n' $diff_files | grep -E '\.py$' | while read -r f; do [ -f "$f" ] && echo "$f"; done || true)
  if [ -n "$py_files" ] && command -v ruff >/dev/null; then
    # The estate's own ruff config (per-file ignores: asserts in tests), even in a sparse checkout.
    ruff_cfg=""; [ -f pyproject.toml ] || ruff_cfg="--config $HOME/.estate/runtime/idp/pyproject.toml"
    if ! ruff check $ruff_cfg --select E9,F,B,S $py_files >&2 || ! ruff format $ruff_cfg --check $py_files >&2; then
      echo "pre-push REFUSED: ruff (E9,F,B,S or format) on the pushed Python; fix: ruff check --select E9,F,B,S --fix <files>; ruff format <files>" >&2
      exit 1
    fi
    echo "ok    Layer 1c (ruff): $(printf '%s\n' $py_files | wc -l | tr -d ' ') pushed Python file(s) clean"
  fi
  # Layer 1a + 1b: one syntax gate, one classification, by SHEBANG (#7468).
  # The old rule classified by path: everything under bin/ and .githooks/ was shell, so
  # `bash -n` ran on the estate's own Python entry points (bin/idp-python-strict,
  # bin/capability-index) and every push that touched one was refused with a bash syntax
  # error -- the guard meant to protect the estate refused the estate's code. Measured
  # 2026-10-29: `bin/idp-python-strict: line 54: syntax error near unexpected token '('`.
  # The shebang says what the file IS; the path only guesses. One rule, used by both layers.
  _file_kind() {
    local first
    first="$(head -n 1 "$1" 2>/dev/null || true)"
    case "$first" in
      '#!'*python*) echo python; return 0 ;;
      '#!'*bash*|'#!'*/sh|'#!'*zsh|'#!'*ksh*) echo shell; return 0 ;;
    esac
    case "$1" in
      *.py) echo python ;;
      *.sh|*.bash) echo shell ;;
      *) echo unknown ;;
    esac
  }
  for f in $diff_files; do
    [ -f "$f" ] || continue
    kind="$(_file_kind "$f")"
    if [ "$kind" = "python" ]; then
      if ! python3 -m py_compile "$f" 2>&1; then
        python3 -m py_compile "$f" >&2
        echo "pre-push REFUSED: syntax error in $f" >&2
        exit 1
      fi
      continue
    fi
    if [ "$kind" = "shell" ]; then
      if ! bash -n "$f" 2>&1; then
        bash -n "$f" >&2
        echo "pre-push REFUSED: syntax error in $f" >&2
        exit 1
      fi
      continue
    fi
    # Unknown: no shebang, not a known extension. Accept it when EITHER parser reads it --
    # a file with no shebang is still one of the two languages, and refusing it would be the
    # same defect in the other direction.
    if bash -n "$f" >/dev/null 2>&1 || python3 -m py_compile "$f" >/dev/null 2>&1; then
      continue
    fi
    echo "pre-push REFUSED: $f is readable as neither shell nor Python" >&2
    exit 1
  done
  # Layer 1c: no non-ASCII bytes in the ADDED lines of the diff.
  # The old check read the whole file, so it refused any push that touched a file that
  # already held one -- this hook's own emoji, for one. It measured history, not the change:
  # a file that has been clean for years could not be edited again. The rule is about what a
  # push introduces, so it reads the added lines.
  for f in $diff_files; do
    [ -f "$f" ] || continue
    added=$(git diff --no-color -U0 "$from" "$local_sha" -- "$f" 2>/dev/null | grep '^+' | grep -v '^+++' || true)
    [ -n "$added" ] || continue
    if printf '%s' "$added" | python3 -c "
import sys
data = sys.stdin.buffer.read()
bad = [i + 1 for i, b in enumerate(data) if b > 127]
sys.exit(1 if bad else 0)
" 2>&1; then
      : # clean
    else
      printf '%s' "$added" | python3 -c "
import sys
data = sys.stdin.buffer.read()
bad = [i + 1 for i, b in enumerate(data) if b > 127]
print('non-ASCII byte(s) at added line offset:', bad[:5], '(first 5)')
" >&2
      echo "pre-push REFUSED: non-ASCII bytes added in $f" >&2
      exit 1
    fi
  done
done <<<"$refs"

# Read-only force pushes and the WIP-gate override are out of scope for this rung --
# the andon-cord pre-push has its own override (IDP_WIP_GATE=0) and that is not ours.
# This rung only refuses the fast-gate class; everything else still flows.
#
# NO OFF SWITCH (founder, 2026-09-23). `IDP_FAST_GATE=0` used to sit here and exit 0. It was
# used -- by this session -- to push past the rung, which is how four pushes went out in
# nineteen minutes each revealing one more failure: a bypass that makes the gate report green
# on a tree the gate never read is worse than no gate, because the green is believed.
#
# The two rules are enforced server-side instead, where no local action can skip them:
# `bin/idp-main-green-gate` and `bin/idp-wip-gate` are wired in below, and the estate's
# required-checks ruleset refuses on the server. A local hook is a convenience that saves a CI
# cycle; it is never the guarantee, and it must not pretend to be one.

if [ ! -x "$repo_root/bin/idp-ci" ]; then
  # No local CI script on this checkout (e.g. a partial clone). The remote is the
  # only enforcement; nothing to refuse here.
  echo "idp-fast-gate: bin/idp-ci not present, skipping"
  exit 0
fi

# Graded against main, as CI grades the pull request (2026-10-14). With no IDP_CI_BASE every
# path-gated rung reads "no base" as "everything changed": a push touching no Backstage file ran
# tsc over backstage (175 s) and yamllint over all 1134 YAML files (100 s), 290 s against the 50 s
# lane-submit gives its push. The queue's six checks still grade the whole tree on the server.
base=$(git -C "$repo_root" merge-base HEAD origin/main 2>/dev/null || true)
# A fresh clone or worktree that never fetched main has no origin/main to measure from, and an empty
# base is the full sweep. Fetch it once and ask again; offline, the empty base stays and the push is
# graded whole -- slow, never wrong.
if [ -z "$base" ]; then
  git -C "$repo_root" fetch -q origin main 2>/dev/null \
    && base=$(git -C "$repo_root" merge-base HEAD origin/main 2>/dev/null || true)
fi
# A worktree checked out from main (fresh feature branch at origin/main) has no diff to gate.
# Skip the gate in that case: nothing to lint, nothing to type-check.
local_head=$(git -C "$repo_root" rev-parse HEAD)
remote_main=$(git -C "$repo_root" rev-parse origin/main 2>/dev/null || true)
if [ -n "$remote_main" ] && [ "$local_head" = "$remote_main" ]; then
  echo "ok    idp-fast-gate: no diff from origin/main (worktree at same commit); gate skipped"
elif [ -n "$base" ]; then
  echo "🛡️  idp-fast-gate: running IDP_CI_FAST=1 IDP_CI_BASE=${base:0:12} bin/idp-ci ..."
  if ! IDP_CI_FAST=1 IDP_CI_BASE="$base" GITHUB_HEAD_REF="${lane_branch:-}" "$repo_root/bin/idp-ci"; then
  cat <<'EOF' >&2

❌ pre-push REFUSED: idp-fast-gate caught errors.

   The remote CI cannot run faster than your laptop, and the failure class this
   gate catches (29% of all OKE failures in the last 3 months) has never produced
   actionable signal in CI -- only noise.

   Fix:
     1) bin/idp-ci            # see the failures in full
     2) re-run IDP_CI_FAST=1 bin/idp-ci until green
     3) git push

   The two rules that must never be bypassed are enforced SERVER-SIDE:
     bin/idp-main-green-gate   refuses a push while main's last CI run is red
     bin/idp-wip-gate          refuses a new PR past the 3-failing-PR cap
   Their overrides are typed deliberately for genuine emergencies, and they are the
   only overrides this hook has. This rung has none.

EOF
  exit 1
  fi
fi

echo "✅ idp-fast-gate: green"

# ---------------------------------------------------------------------------
# JEV ADVISORY (advice, never a refusal).
#
# `bin/idp-pr-risk` scores the pushed diff against the natural-language conditions in
# `jev-pr-risk.yml`, and `bin/idp-pr-risk-gate` is the one place allowed to refuse (at the `high`
# tier, and only when the layer actually answered). NOTHING CALLED EITHER OF THEM: measured
# 2026-10-18, `rg -n pr-risk-gate .githooks/ scripts/` found nothing, so the estate's single
# decision layer had never seen a push leave the laptop -- the founder's "I don't see evidence of
# use". `--advise` cannot refuse, so this records a decision on every push without adding a new
# way for a correct push to fail (a layer that is unreachable prints its reason and passes).
if [ -x "$repo_root/bin/idp-pr-risk-gate" ]; then
  case "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)" in
  main) ;;
  *)
    timeout 20 "$repo_root/bin/idp-pr-risk-gate" --advise 2>&1 | sed 's/^/jev   /' || true
    ;;
  esac
fi

# ---------------------------------------------------------------------------
# TRUNK ROUTING (advice, never a refusal).
#
# The dual-trunk model puts agent work on `agent-trunk`, which needs no PR, and leaves
# `main` protected for batched review only. A push of a feature branch is CORRECT under
# the model too -- the branch is incidental, and `agent-trunk-batch.yml` batches whatever
# reaches agent-trunk. So this prints what trunk a push is aimed at and does not block:
# a fence that refused every branch push would be an outage, not enforcement (LAW 38).
#
# The enforcement is elsewhere and is real: the ruleset on `main` (no direct push, no
# force, no deletion), the ruleset on `agent-trunk` (no force, no deletion, linear), and
# the gate above, which is what actually refuses a red push.
while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/heads/main)
		echo "⚠️  pre-push: pushing directly to main. Batch agent work to agent-trunk instead:"
		echo "      git push origin HEAD:agent-trunk   # then agent-trunk-batch.yml opens one PR"
		;;
	esac
done

exit 0
