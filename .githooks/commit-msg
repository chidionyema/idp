#!/usr/bin/env bash
# .githooks/commit-msg — stamps every commit with X-Idp-Signed so that the guarded-paths CI check
# can refuse commits that bypassed the hooks with --no-verify. The stamp is an HMAC of the commit
# message body, keyed by a per-checkout secret that lives in .git/idp-hook-secret (never on the
# tree). Any commit made without the hooks installed will lack this trailer and be refused server-
# side. bin/idp-install-hooks provisions the secret.
set -euo pipefail

msg_file="$1"
secret_path="$(git rev-parse --git-path idp-hook-secret 2>/dev/null || echo)"
[ -n "$secret_path" ] || { echo "REFUSE: cannot resolve git dir for hook secret" >&2; exit 1; }
if [ ! -f "$secret_path" ]; then
  echo "REFUSE: hook secret missing at $secret_path -- run bin/idp-install-hooks" >&2
  exit 1
fi
secret="$(cat "$secret_path")"
[ -n "$secret" ] || { echo "REFUSE: hook secret at $secret_path is empty" >&2; exit 1; }

# Do not stamp merge commits produced by git itself; the parent commits already carry stamps.
# Do not double-stamp if the trailer is already present (idempotent for amend flows).
if grep -qE '^X-Idp-Signed: ' "$msg_file"; then
  exit 0
fi

body="$(cat "$msg_file")"
# $NF, not $2. `openssl dgst` prints "HMAC-SHA256(stdin)= <hex>" on some builds and the bare hex
# on others -- LibreSSL 3.3.x, which is what macOS ships, prints one field. $2 was then empty,
# every commit on that machine died on "HMAC computation failed", and the only way to commit was
# --no-verify, which is exactly what this hook exists to make impossible. A guard that cannot run
# is not a guard. The last field is the digest under both formats.
sig="$(printf '%s' "$body" | openssl dgst -sha256 -hmac "$secret" 2>/dev/null | awk '{print $NF}')"
[ -n "$sig" ] || { echo "REFUSE: HMAC computation failed" >&2; exit 1; }

# Place the stamp so that git actually parses it AS a trailer, which is the whole point: the
# guarded-paths check reads it with `%(trailers:key=X-Idp-Signed)`, and git only recognises a
# trailer block that is the last paragraph of the message.
#
# Two ways the old one-line `printf '\nX-Idp-Signed: ...'` got that wrong (both seen 2026-09-22 on
# consolidate/fix-everything):
#
#   1. `git merge --no-edit` writes .git/MERGE_MSG with NO trailing newline. Appending "\n<stamp>"
#      then merely terminated the subject line and put the stamp on line 2 with no blank line
#      between -- so git read a two-line subject and no trailer, and guarded-paths refused HEAD as
#      "unsigned (--no-verify bypass detected)" on a commit that had in fact run this hook. A hook
#      whose output the checker cannot see is not a signature.
#   2. When the message already ended in a trailer block (`Co-Authored-By:`), the unconditional
#      blank line opened a SECOND block. git reads only the last one, so the stamp was found but
#      the co-authorship was cut out of the trailers and stopped being attributed.
#
# So: guarantee a final newline first, then start a new paragraph only when the message is not
# already ending in one.
[ -s "$msg_file" ] && [ -n "$(tail -c1 "$msg_file")" ] && printf '\n' >>"$msg_file"
if sed -e '/^#/d' -e '/^[[:space:]]*$/d' "$msg_file" | tail -n1 | grep -qE '^[A-Za-z][A-Za-z0-9-]*: '; then
  printf 'X-Idp-Signed: %s\n' "$sig" >> "$msg_file"   # extend the trailer block that is there
else
  printf '\nX-Idp-Signed: %s\n' "$sig" >> "$msg_file" # open one
fi
