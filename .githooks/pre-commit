#!/usr/bin/env bash
# One hook, three guards. Each refuses a class of failure that has reached CI in
# this repo and burned cycles: ruff-formatted .py, ruff-checked .py, tsc-clean .ts/.tsx.
# Class-level refusal — once a guard exists, the failure is impossible to commit.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)
staged_ts=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' || true)

# 1. ruff format --check on staged .py
if [ -n "$staged_py" ]; then
  if command -v python3 >/dev/null 2>&1 && python3 -m ruff --version >/dev/null 2>&1; then
    echo "  ruff format --check: $(echo "$staged_py" | tr '\n' ' ')"
    echo "$staged_py" | xargs python3 -m ruff format --check --quiet || {
      echo "pre-commit: ruff format failed. fix: python3 -m ruff format $staged_py" >&2
      exit 1
    }
  else
    echo "pre-commit: ruff unavailable, skipping format check (CI enforces)" >&2
  fi
fi

# 2. ruff check on staged .py — uses pyproject.toml's [tool.ruff.lint] select via
# bin/idp-ruff (the same binary bin/idp-ci runs). One rule set, not two.
if [ -n "$staged_py" ]; then
  if [ -x "$repo_root/bin/idp-ruff" ]; then
    echo "  ruff check (pyproject.toml select)"
    echo "$staged_py" | xargs "$repo_root/bin/idp-ruff" || {
      echo "pre-commit: ruff check failed (pyproject.toml rule set)" >&2
      exit 1
    }
  fi
fi

# 3. tsc --noEmit on staged .ts/.tsx. Use the project tsconfig so --jsx is set;
#    per-file tsc invocation needs flags the project tsconfig already provides.
#    If only test files are staged, run against their tsconfig if it exists.
if [ -n "$staged_ts" ]; then
  if [ -x "$repo_root/backstage/node_modules/.bin/tsc" ]; then
    echo "  tsc --noEmit (whole project, catches staged)"
    (cd "$repo_root/backstage" && ./node_modules/.bin/tsc --noEmit) || {
      echo "pre-commit: tsc failed (project-wide). fix unused identifiers or run yarn tsc in backstage/" >&2
      exit 1
    }
  else
    echo "pre-commit: backstage/node_modules/.bin/tsc not found, skipping TS check (CI enforces)" >&2
  fi
fi

exit 0
