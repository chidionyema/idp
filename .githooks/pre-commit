#!/usr/bin/env bash
set -euo pipefail
# .githooks/pre-commit
# Enforces 3 Independent Machine Proofs on every local commit before it is created.
# Pre-admission, not discovery: the defects a machine can repair are repaired here, in
# this order, and the proofs then judge the repaired tree. 2026-11-19: a release failed
# on ruff formatting and a stale registry that bin/idp-ci --fix repairs in under a second.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=($(git diff --cached --name-only --diff-filter=ACMR))

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

# 1. Repair, then re-stage. --fix exits 3 when it changed a file and 0 when it did not.
set +e
FIX_OUT="$(bash "${REPO_ROOT}/bin/idp-ci" --fix 2>&1)"
FIX_RC=$?
set -e
[ -n "${FIX_OUT}" ] && printf '%s\n' "${FIX_OUT}"
if [ "${FIX_RC}" -eq 3 ]; then
  for f in "${STAGED_FILES[@]}" catalog/estate-capability-registry.json; do
    [ -e "${REPO_ROOT}/${f}" ] && git add -- "${f}"
  done
elif [ "${FIX_RC}" -ne 0 ]; then
  echo "bin/idp-ci --fix exited ${FIX_RC}; refusing the commit" >&2
  exit 1
fi


python3 "${REPO_ROOT}/bin/verify_three_proofs.py" \
  --repo-root "${REPO_ROOT}" \
  --commit-sha "HEAD" \
  --timestamp "$(date +%s)" \
  --staged \
  --files "${STAGED_FILES[@]}"
