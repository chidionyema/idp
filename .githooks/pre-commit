#!/usr/bin/env bash
# crew#584 CP-B (founder, 2026-08-29): "A lint warning should fail in 400 milliseconds on your
# laptop, not 13 minutes later in CI." Dispatched by ~/.estate/guards/hooks/_router as pre-commit.
#
# Runs on STAGED files only, the same checks bin/idp-ci runs first in the offline gate, so the
# SC2034 that cost a full CI cycle on idp#659 is refused before the commit exists:
#   bin/*            bash -n + shellcheck -S warning   (bin/idp-ci step 1, identical flags)
#   *.py             ruff check                         (syntax + unused names, under a second)
# With pre-commit installed (repo venv has it) the same checks come from .pre-commit-config.yaml.
# Then the estate's shared config-syntax default, which this file would otherwise shadow.
# Fails open on a missing tool: a gate that refuses correct work is an outage (LAW 38).
# PRE_COMMIT_SKIP=1 bypasses for a WIP commit; the push gate and CI still run.
set -euo pipefail
[ -n "${PRE_COMMIT_SKIP:-}" ] && exit 0
top="$(git rev-parse --show-toplevel)"
cd "$top"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -eq 0 ] && exit 0

# 178 files in this tree are generated and committed, and CI grades several of them by exact match
# -- but until 2026-09-08 nothing regenerated them at commit time. The only reminder that a
# derivative had gone stale was a red check ten minutes later, on another machine: idp#2477 and
# idp#2495 both failed on the same generator within the same hour, and neither failure was a
# mistake in the change, only in remembering a command. A gate that can compute the right answer
# should write it, not refuse the commit and make a person type it -- the estate's python guard
# already reformats and re-stages on this same hook rather than refusing.
#
# Each row is: a name, the staged paths that make an output stale, the generator, and the paths to
# re-stage after it runs. The generator is the authority; the tree follows it.
regen() {
  local name=$1 inputs=$2 gen=$3 outs=$4
  printf '%s\n' "${staged[@]}" | grep -qE "$inputs" || return 0
  [ -x "$top/${gen%% *}" ] || return 0     # LAW 38: no tool, no verdict -- never a refusal
  # shellcheck disable=SC2086  # $gen and $outs are this file's own words, split on purpose
  if ! (cd "$top" && python3 $gen >/dev/null 2>&1); then
    echo "pre-commit: $gen failed; run it by hand to see why"; return 1
  fi
  # shellcheck disable=SC2086
  git add -- $outs 2>/dev/null || true
  if ! git diff --cached --quiet -- $outs; then
    echo "pre-commit: regenerated and staged $name ($outs)"
  fi
}

# The inputs include each generator's own output: a hand-edit of a generated file is drift too,
# and every one of these files says so in its own banner. The generator settles it either way.
regen portal-buttons '^(\.github/workflows/|backstage/templates/founder-actions/)' \
  'bin/idp-portal-buttons' 'backstage/templates/founder-actions' || exit 1
regen agents-md '^(rules\.yaml|AGENTS\.md)$' \
  'bin/idp-rules render-agents-md' 'AGENTS.md' || exit 1
regen vendor-render '^(platform/vendors/consoles\.yaml|llm/config(\.base)?\.yaml|platform/llm/config(\.base)?\.yaml)$' \
  'bin/idp-vendor-render' 'llm/config.yaml platform/llm/config.yaml' || exit 1

# The rows above can add files, and everything below grades the staged set.
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)

# Phase 1 of the founder's playbook names pre-commit; when it is installed and the repo carries
# .pre-commit-config.yaml, that config is the checks (same ruff and shellcheck, repo: local).
pc="$(command -v pre-commit || true)"; [ -x "$top/.venv/bin/pre-commit" ] && pc="$top/.venv/bin/pre-commit"
if [ -n "$pc" ] && [ -f "$top/.pre-commit-config.yaml" ]; then
  PATH="$top/.venv/bin:$PATH" "$pc" run --files "${staged[@]}" || { echo "pre-commit: fix the lines above, or PRE_COMMIT_SKIP=1 for a WIP commit"; exit 1; }
  shared="${ESTATE_HOOKS:-$HOME/.estate/guards/hooks}/config-syntax-default"
  [ -x "$shared" ] && exec "$shared" "$@"
  exit 0
fi

rc=0
for f in "${staged[@]}"; do
  case "$f" in
    bin/*)
      [ -f "$f" ] || continue
      head -c 200 "$f" | grep -q '^#!.*\b\(ba\)\?sh' || continue
      if ! bash -n "$f"; then echo "pre-commit: $f does not parse"; rc=1; continue; fi
      if command -v shellcheck >/dev/null && ! shellcheck -S warning "$f"; then
        echo "pre-commit: shellcheck -S warning refused $f (same flags as bin/idp-ci)"; rc=1
      fi;;
    *.py)
      if command -v ruff >/dev/null; then
        ruff check --quiet --select E9,F "$f" || { echo "pre-commit: ruff refused $f"; rc=1; }
      elif ! python3 -m py_compile "$f"; then echo "pre-commit: $f does not compile"; rc=1; fi;;
  esac
done
[ "$rc" -eq 0 ] || { echo "pre-commit: fix the lines above, or PRE_COMMIT_SKIP=1 for a WIP commit"; exit "$rc"; }

shared="${ESTATE_HOOKS:-$HOME/.estate/guards/hooks}/config-syntax-default"
[ -x "$shared" ] && exec "$shared" "$@"
exit 0
