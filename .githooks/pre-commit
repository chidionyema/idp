#!/usr/bin/env bash
set -euo pipefail
# .githooks/pre-commit
# Enforces 3 Independent Machine Proofs on every local commit before it is created.

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED_FILES=($(git diff --cached --name-only --diff-filter=ACMR))

if [ ${#STAGED_FILES[@]} -eq 0 ]; then
  exit 0
fi

# 1b. The capability witness is an ARTIFACT: regenerate it at write time (2026-11-15).
# fast-gate refuses a lane with "registry the committed capability witness is not the generator's
# output; fix: bin/capability-index emit --write" -- measured on PR #8159 (run 43767741379), 18
# records added. A gate that names the one command which fixes it should have run that command,
# not asked a human to. Staged only when the emit actually changes the file.
if [ -x "${REPO_ROOT}/bin/capability-index" ]; then
  _w="${REPO_ROOT}/catalog/estate-capability-registry.json"
  _before="$(shasum -a 256 "$_w" 2>/dev/null | awk '{print $1}')"
  if ( cd "${REPO_ROOT}" && bin/capability-index emit --write >/dev/null 2>&1 ); then
    _after="$(shasum -a 256 "$_w" 2>/dev/null | awk '{print $1}')"
    if [ -n "$_after" ] && [ "$_before" != "$_after" ]; then
      echo "  capability witness: regenerated and staged"
      git -C "${REPO_ROOT}" add -- catalog/estate-capability-registry.json
    fi
  fi
fi

# 1c. ruff format on staged .py -- APPLIED, not just checked (2026-11-15). The tracked hook lost
# this rung: `.githooks/pre-commit` on main is 589 bytes of three-proofs only, so every agent's
# Python reached CI unformatted and fast-gate refused it (measured: batch b5803, run 43776329241,
# "FAIL ruff-fmt the Python this push touches"). A check that knows the fix should apply it.
if [ -z "${SKIP_RUFF_FORMAT:-}" ]; then
  _py="$(printf '%s\n' "${STAGED_FILES[@]}" | grep -E '\.py$' || true)"
  if [ -n "$_py" ] && python3 -m ruff --version >/dev/null 2>&1; then
    echo "$_py" | xargs python3 -m ruff format --quiet || true
    echo "$_py" | xargs git -C "${REPO_ROOT}" add -- || true
    echo "$_py" | xargs python3 -m ruff format --check --quiet || {
      echo "pre-commit: ruff format could not format a staged file (partly staged?)" >&2
      exit 1
    }
  fi
fi

SEAL_FLAG=""
if [ "${FOUNDER_DIRECT_SEAL:-0}" = "1" ]; then
  SEAL_FLAG="--founder-seal"
fi

python3 "${REPO_ROOT}/bin/verify_three_proofs.py" \
  --repo-root "${REPO_ROOT}" \
  --commit-sha "HEAD" \
  --timestamp "$(date +%s)" \
  ${SEAL_FLAG} \
  --files "${STAGED_FILES[@]}"
