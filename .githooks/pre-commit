#!/usr/bin/env bash
# One hook, five guards. Each refuses a class of failure that has reached CI in
# this repo and burned cycles: ruff-formatted .py, ruff-checked .py, tsc-clean .ts/.tsx,
# a shell file shellcheck rejects, a YAML file yamllint rejects.
# Class-level refusal — once a guard exists, the failure is impossible to commit.
#
# Guards 4-5 (shellcheck, yamllint) were already enforced, but only at push time
# (.githooks/pre-push -> IDP_CI_FAST=1 bin/idp-ci) and in CI (fast-gate.yml). Founder,
# 2026-09-28: wants tests/lint/shellcheck to run automatically "on save, on commit, etc."
# so the agent never has to remember -- this shifts that existing check left to commit
# time instead of building a second one. Detection logic mirrors bin/idp-ci --check
# exactly (shell = *.sh/*.bash extension or bin/*, .githooks/* path; YAML = *.yaml/*.yml)
# so this hook and the CI gate can never disagree about what counts as a shell or YAML file.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' || true)
# ruff format cannot parse intentionally-invalid Python (tests/fixtures/projection/broken.py
# is the SyntaxError test case for bin/catalog-projection). Exclude it from formatting.
staged_py=$(echo "$staged_py" | grep -v 'tests/fixtures/projection/broken.py' || true)
staged_ts=$(git diff --cached --name-only --diff-filter=ACM -- '*.ts' '*.tsx' || true)
# A whole-workspace typecheck may only be asked about the files that project includes.
# backstage/tsconfig.json includes `packages/*` and `plugins/*` under backstage/ and nothing else,
# so a staged .ts anywhere else (extensions/estate-capabilities/index.ts, a script under bin/)
# used to start a typecheck that could not see it. On 2026-10-23 that stopped work outright: the
# whole-workspace tsc does not finish inside the executor's 100s ceiling, so three `git commit`
# calls were SIGTERMed at the door and their staged work thrown away -- leaving `--no-verify` or
# flailing as the only ways to land a change. bin/idp-ts-owner answers "which of these does this
# project own?" so the guard keeps its full strength for its own files and says out loud what it
# is not checking. Detection lives in one testable place rather than in the hook's control flow.
staged_ts_owned=$(printf '%s\n' "$staged_ts" | "$repo_root/bin/idp-ts-owner" || true)
if [ -n "$staged_ts_owned" ]; then
  staged_ts_other=$(printf '%s\n' "$staged_ts" | grep -vxF -f <(printf '%s\n' "$staged_ts_owned") || true)
else
  staged_ts_other="$staged_ts"
fi
staged_all=$(git diff --cached --name-only --diff-filter=ACM || true)
# bin/idp-always-on-guard etc: extensionless files under bin/ or .githooks/ are not all shell
# (a Python script with no .py extension matched here and was shellchecked as bash -- SC1071).
# .sh/.bash are trivially shell; anything under bin/ or .githooks/ with a real extension other
# than .sh/.bash is trivially not; an extensionless file goes by its actual shebang.
staged_sh=""
while IFS= read -r f; do
  [ -z "$f" ] && continue
  case "$f" in
  *.sh | *.bash) staged_sh="$staged_sh
$f" ;;
  bin/* | .githooks/*)
    base=$(basename "$f")
    case "$base" in
    *.*) continue ;; # has a non-sh/bash extension already ruled in above -- skip
    esac
    [ -f "$f" ] || continue
    if head -1 "$f" | grep -qE '^#!.*\b(bash|sh|dash|ksh)\b'; then
      staged_sh="$staged_sh
$f"
    fi
    ;;
  esac
done <<<"$staged_all"
staged_sh=$(printf '%s\n' "$staged_sh" | grep -v '^$' || true)
staged_yaml=$(printf '%s\n' "$staged_all" | grep -E '\.(yaml|yml)$' || true)

# 1. ruff format on staged .py -- APPLIED, not just checked. A check that fails and prints the
#    fix made every agent pay a failed commit and a retry for a change the hook already knew how
#    to make. A file staged whole is formatted and re-staged, so the commit lands formatted. A
#    file with unstaged edits too is left alone and refused as before: re-staging it would sweep
#    those edits into the commit unseen. pre-push (bin/idp-ci) and CI still --check as backstop.
if [ -n "$staged_py" ]; then
  if command -v python3 >/dev/null 2>&1 && python3 -m ruff --version >/dev/null 2>&1; then
    echo "  ruff format: $(echo "$staged_py" | tr '\n' ' ')"
    partial=$(echo "$staged_py" | xargs git diff --name-only -- || true)
    whole=$(printf '%s\n' "$staged_py" | grep -vxF -f <(printf '%s\n' "$partial") || true)
    if [ -n "$whole" ]; then
      echo "$whole" | xargs python3 -m ruff format --quiet
      echo "$whole" | xargs git add --
    fi
    echo "$staged_py" | xargs python3 -m ruff format --check --quiet || {
      echo "pre-commit: ruff format failed on a partly staged file. fix: python3 -m ruff format $partial" >&2
      exit 1
    }
  else
    echo "pre-commit: ruff unavailable, skipping format check (CI enforces)" >&2
  fi
fi

# 2. ruff check on staged .py — uses pyproject.toml's [tool.ruff.lint] select via
# bin/idp-ruff (the same binary bin/idp-ci runs). One rule set, not two.
if [ -n "$staged_py" ]; then
  if [ -x "$repo_root/bin/idp-ruff" ]; then
    echo "  ruff check (pyproject.toml select)"
    echo "$staged_py" | xargs "$repo_root/bin/idp-ruff" || {
      echo "pre-commit: ruff check failed (pyproject.toml rule set)" >&2
      exit 1
    }
  fi
fi

# 3. tsc --noEmit on staged .ts/.tsx that backstage's project owns. Use the project tsconfig so
#    --jsx is set; per-file tsc invocation needs flags the project tsconfig already provides.
#    If only test files are staged, run against their tsconfig if it exists.
if [ -n "$staged_ts_owned" ]; then
  # No skip: a worktree borrows the main checkout's node_modules; with none, the commit is refused.
  echo "  tsc --noEmit (backstage workspace, catches staged)"
  "$repo_root/bin/idp-backstage-tsc" || {
    echo "pre-commit: tsc red or blind (project-wide). fix the types, or yarn install in backstage/" >&2
    exit 1
  }
fi
# Named, not silent: a .ts file inside no project's tsconfig is not typechecked here, and the
# commit says so rather than implying a check that did not run.
if [ -n "$staged_ts_other" ]; then
  echo "  tsc: no tsconfig owns these, so not typechecked here: $(printf '%s ' $staged_ts_other)"
fi

# 4. shellcheck on staged shell files (same detection as bin/idp-ci --check: *.sh/*.bash
#    extension, or the bin/ / .githooks/ shebang convention).
if [ -n "$staged_sh" ]; then
  if command -v shellcheck >/dev/null 2>&1; then
    sh_fail=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      [ -f "$f" ] || continue
      # bin/ holds python too: only a *.sh/*.bash name or a shell shebang is a shell file.
      case "$f" in *.sh | *.bash) ;; *) head -1 "$f" | grep -qE '^#!.*[/ ](ba|z|da)?sh( |$)' || continue ;; esac
      if ! shellcheck -S warning "$f" >/dev/null 2>&1; then
        echo "  FAIL shellcheck $f"
        sh_fail=1
      fi
    done <<<"$staged_sh"
    if [ "$sh_fail" = 1 ]; then
      echo "pre-commit: shellcheck failed. fix: shellcheck -S warning <file>" >&2
      exit 1
    fi
    echo "  shellcheck: $(printf '%s\n' "$staged_sh" | tr '\n' ' ')"
  else
    echo "pre-commit: shellcheck unavailable, skipping (CI enforces via fast-gate.yml)" >&2
  fi
fi

# 5. yamllint on staged YAML files (same detection as bin/idp-ci --check: *.yaml/*.yml).
if [ -n "$staged_yaml" ]; then
  if command -v yamllint >/dev/null 2>&1; then
    yaml_fail=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      [ -f "$f" ] || continue
      if ! yamllint -c .yamllint "$f" >/dev/null 2>&1; then
        echo "  FAIL yamllint $f"
        yaml_fail=1
      fi
    done <<<"$staged_yaml"
    if [ "$yaml_fail" = 1 ]; then
      echo "pre-commit: yamllint failed. fix: yamllint -c .yamllint <file>" >&2
      exit 1
    fi
    echo "  yamllint: $(printf '%s\n' "$staged_yaml" | tr '\n' ' ')"
  else
    # Refused, not skipped (2026-10-14): CI's fast-gate installed yamllint and never ran it, so
    # "CI enforces" was not true, and a duplicated key sat in a kyverno fixture for seven weeks.
    echo "pre-commit: yamllint is not installed. fix: bin/idp-install-deps" >&2
    exit 1
  fi
fi

exit 0
