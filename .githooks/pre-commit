#!/usr/bin/env bash
# crew#584 CP-B (founder, 2026-08-29): "A lint warning should fail in 400 milliseconds on your
# laptop, not 13 minutes later in CI." Dispatched by ~/.estate/guards/hooks/_router as pre-commit.
#
# Runs on STAGED files only, the same checks bin/idp-ci runs first in the offline gate, so the
# SC2034 that cost a full CI cycle on idp#659 is refused before the commit exists:
#   bin/* .githooks/* scripts/*   bash -n + bin/idp-shell-strict (shellcheck -S warning, shfmt -d,
#                                 set -euo pipefail, a trap -- crew#620, same rules as CI's
#                                 shell-strict job)
#   *.py             ruff check                         (syntax + unused names, under a second)
# With pre-commit installed (repo venv has it) the same checks come from .pre-commit-config.yaml.
# Then the estate's shared config-syntax default, which this file would otherwise shadow.
# Fails open on a missing tool: a gate that refuses correct work is an outage (LAW 38).
# PRE_COMMIT_SKIP=1 bypasses for a WIP commit; the push gate and CI still run.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
[ -n "${PRE_COMMIT_SKIP:-}" ] && exit 0
top="$(git rev-parse --show-toplevel)"
cd "$top"
mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ "${#staged[@]}" -eq 0 ] && exit 0

# Phase 1 of the founder's playbook names pre-commit; when it is installed and the repo carries
# .pre-commit-config.yaml, that config is the checks (same ruff and shellcheck, repo: local).
pc="$(command -v pre-commit || true)"
[ -x "$top/.venv/bin/pre-commit" ] && pc="$top/.venv/bin/pre-commit"
if [ -n "$pc" ] && [ -f "$top/.pre-commit-config.yaml" ]; then
	PATH="$top/.venv/bin:$PATH" "$pc" run --files "${staged[@]}" || {
		echo "pre-commit: fix the lines above, or PRE_COMMIT_SKIP=1 for a WIP commit"
		exit 1
	}
	shared="${ESTATE_HOOKS:-$HOME/.estate/guards/hooks}/config-syntax-default"
	[ -x "$shared" ] && exec "$shared" "$@"
	exit 0
fi

rc=0
shell_staged=()
for f in "${staged[@]}"; do
	case "$f" in
	bin/* | .githooks/* | scripts/*)
		[ -f "$f" ] || continue
		shell_staged+=("$f")
		;;
	*.py)
		if command -v ruff >/dev/null; then
			ruff check --quiet --select E9,F "$f" || {
				echo "pre-commit: ruff refused $f"
				rc=1
			}
		elif ! python3 -m py_compile "$f"; then
			echo "pre-commit: $f does not compile"
			rc=1
		fi
		;;
	esac
done

# crew#620: every staged shell file under bin/, .githooks/, scripts/ -- shellcheck -S warning,
# shfmt -d, `set -euo pipefail`, a trap. bin/idp-shell-strict itself filters non-shell paths out
# (a stray *.py in $shell_staged is a no-op), and fails open when shellcheck/shfmt are missing
# (LAW 38): a gate that refuses correct work for want of a linter binary is an outage.
if [ "${#shell_staged[@]}" -gt 0 ] && [ -x "$top/bin/idp-shell-strict" ]; then
	py="$(command -v python3 || true)"
	[ -x "$top/.venv/bin/python" ] && py="$top/.venv/bin/python"
	if [ -n "$py" ]; then
		"$py" "$top/bin/idp-shell-strict" --files "${shell_staged[@]}" || {
			echo "pre-commit: shell-strict refused a staged file (same rules as CI's shell-strict job, crew#620)"
			rc=1
		}
	fi
fi

[ "$rc" -eq 0 ] || {
	echo "pre-commit: fix the lines above, or PRE_COMMIT_SKIP=1 for a WIP commit"
	exit "$rc"
}

shared="${ESTATE_HOOKS:-$HOME/.estate/guards/hooks}/config-syntax-default"
[ -x "$shared" ] && exec "$shared" "$@"
exit 0
