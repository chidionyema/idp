#!/bin/sh
# idp-bootstrap — installs everything on a fresh Mac.
# Downloads pre-built Backstage from GitHub Releases, installs fleetview-backend,
# configures and starts all services.
#
# Run: /usr/local/bin/idp-bootstrap
#
set -euo pipefail

ok()   { printf '\033[1;32m✓\033[0m %s\n' "$*"; }
info() { printf '\033[1;34m→\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m⚠\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

REPO="chidionyema/idp"
BACKSTAGE_APP="/Applications/IDP Estate/Backstage.app"
ESTATE="$HOME/Library/Application Support/ai.estate"
STATE="$HOME/.estate"
TMP="$(mktemp -d)"

cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT

# ── platform check ───────────────────────────────────────────────────────────
[ "$(uname -s)" = "Darwin" ] || die "macOS only"
MAJOR="$(sw_vers -productVersion | cut -d. -f1)"
[ "$MAJOR" -ge 13 ] || die "macOS 13+ required (Ventura or later)"

# ── Xcode CLT (needed for Homebrew/MacPorts) ─────────────────────────────────
if ! xcode-select -p >/dev/null 2>&1; then
    info "installing Xcode Command Line Tools..."
    xcode-select --install 2>/dev/null || true
    sleep 5
fi

# ── Node.js 22 (Backstage needs Node) ────────────────────────────────────────
install_node() {
    info "installing Node.js 22..."
    if command -v brew >/dev/null 2>&1; then
        brew install node@22 2>&1 | tail -3
    elif command -v port >/dev/null 2>&1; then
        sudo port install nodejs22 2>&1 | tail -3
    else
        # Download Node binary directly
        local ARCH; ARCH="$(uname -m)"
        [ "$ARCH" = "arm64" ] && ARCH="darwin-arm64" || ARCH="darwin-x64"
        local NODE_URL="https://nodejs.org/dist/v22.12.0/node-v22.12.0-${ARCH}.tar.gz"
        curl -fsSL "$NODE_URL" | tar -xz -C /usr/local --strip-components=1
    fi
    export PATH="/usr/local/bin:$PATH"
    if [ -d "/opt/homebrew/opt/node@22/bin" ]; then
        export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
    fi
    ok "Node.js $(node --version 2>&1) ready"
}

if ! node --version 2>/dev/null | grep -q "^v22"; then
    install_node
fi
export PATH="/usr/local/bin:$PATH"
[ -d "/opt/homebrew/opt/node@22/bin" ] && export PATH="/opt/homebrew/opt/node@22/bin:$PATH"
ok "Node.js $(node --version) ready"

# ── Python 3.12 (fleetview-backend needs it) ─────────────────────────────────
install_python() {
    info "installing Python 3.12..."
    if command -v brew >/dev/null 2>&1; then
        brew install python@3.12 2>&1 | tail -3
        export PATH="/opt/homebrew/opt/python@3.12/bin:$PATH"
    elif command -v port >/dev/null 2>&1; then
        sudo port install python312 2>&1 | tail -3
        export PATH="/opt/local/bin:/opt/local/sbin:$PATH"
    fi
}
PYTHON="/opt/homebrew/bin/python3.12"
[ -x "$PYTHON" ] || PYTHON="/opt/local/bin/python3.12"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3.12 2>/dev/null || true)"
if [ -z "$PYTHON" ] || ! "$PYTHON" -c "import sys; sys.exit(0 if sys.version_info >= (3,12) else 1)" 2>/dev/null; then
    install_python
fi
PYTHON="${PYTHON:-$(command -v python3.12 2>/dev/null || command -v python3 2>/dev/null || echo python3)}"
PIP="$("$PYTHON" -m pip --version 2>/dev/null | awk '{print $2}' | tr -d '()')"
[ -n "$PIP" ] || PIP="$("$PYTHON" -m ensurepip --default-pip 2>/dev/null && echo "$("$PYTHON" -m pip --version | awk '{print $2}')")"
ok "Python $($PYTHON --version 2>&1 | awk '{print $2}') ready"

# ── Backstage ────────────────────────────────────────────────────────────────
download_backstage() {
    info "finding latest Backstage build..."
    # Get the latest release from GitHub
    local LATEST; LATEST=$(curl -sf "https://api.github.com/repos/$REPO/releases/latest" 2>/dev/null | \
        python3 -c "import sys,json; d=json.load(sys.stdin); [print(a['browser_download_url']) for a in d.get('assets',[]) if 'app.tar.gz' in a.get('name','')]" 2>/dev/null || true)

    if [ -z "$LATEST" ]; then
        warn "no pre-built Backstage found in releases"
        warn "Building from source (this takes ~30 min)..."
        build_backstage_from_source
        return
    fi

    info "downloading Backstage (~200MB)..."
    mkdir -p "$(dirname "$BACKSTAGE_APP")"
    curl -L --progress-bar "$LATEST" | tar -xz -C "$TMP"
    mv "$TMP/Backstage.app" "$BACKSTAGE_APP" 2>/dev/null || true

    # If tarball has a different structure
    if [ ! -d "$BACKSTAGE_APP" ]; then
        local APP_IN_TMP; APP_IN_TMP=$(find "$TMP" -name "*.app" -type d 2>/dev/null | head -1)
        if [ -n "$APP_IN_TMP" ]; then
            mv "$APP_IN_TMP" "$BACKSTAGE_APP"
        else
            die "Backstage tarball did not contain an .app bundle"
        fi
    fi
    ok "Backstage installed at $BACKSTAGE_APP"
}

build_backstage_from_source() {
    info "cloning Backstage source..."
    local BS_DIR="$TMP/backstage-src"
    git clone --depth=1 "https://github.com/$REPO" "$BS_DIR" 2>&1 | tail -3
    cd "$BS_DIR"
    yarn install --frozen-lockfile 2>&1 | tail -5
    yarn build 2>&1 | tail -5
    tar -czvf "$BACKSTAGE_APP.tar.gz" -C packages/app dist/
    mkdir -p "$(dirname "$BACKSTAGE_APP")"
    tar -xzvf "$BACKSTAGE_APP.tar.gz" -C "$(dirname "$BACKSTAGE_APP")/"
    ok "Backstage built from source"
}

if [ -d "$BACKSTAGE_APP" ]; then
    ok "Backstage already installed at $BACKSTAGE_APP"
else
    download_backstage
fi

# ── fleetview-backend Python package ─────────────────────────────────────────
info "installing fleetview-backend Python package..."
"$PYTHON" -m pip install --upgrade pip -q 2>&1 | tail -1
for pkg in fastapi uvicorn[standard] httpx pydantic 'asyncio-nats-client>=0.11.0'; do
    "$PYTHON" -m pip install "$pkg" -q 2>&1 | tail -1
done

# Install fleetview_backend from the repo if available
ESTATE_IDP="$ESTATE/idp"
if [ -d "$ESTATE_IDP" ]; then
    "$PYTHON" -m pip install -e "$ESTATE_IDP/backstage/plugins/fleetview-backend/" -q 2>&1 | tail -1
fi
ok "fleetview-backend installed"

# ── Configure app-config ──────────────────────────────────────────────────────
info "configuring Backstage..."
mkdir -p "$ESTATE"
cat > "$ESTATE/backstage-env.sh" << ENVEOF
#!/bin/sh
export BACKSTAGE_APP="$BACKSTAGE_APP"
export ESTATE_STATE="$STATE"
export PATH="/usr/local/bin:$PATH"
[ -d "/opt/homebrew/opt/node@22/bin" ] && export PATH="/opt/homebrew/opt/node@22/bin:\$PATH"
[ -d "/opt/homebrew/opt/python@3.12/bin" ] && export PATH="/opt/homebrew/opt/python@3.12/bin:\$PATH"
ENVEOF
chmod +x "$ESTATE/backstage-env.sh"
ok "config written to $ESTATE/backstage-env.sh"

# ── Start services ───────────────────────────────────────────────────────────
info "starting services..."

# fleetview-backend
if [ -f "$HOME/Library/LaunchAgents/ai.estate.fleetview-backend.plist" ]; then
    launchctl bootout "gui/$(id -u)/ai.estate.fleetview-backend" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" \
        "$HOME/Library/LaunchAgents/ai.estate.fleetview-backend.plist" 2>/dev/null || true
    sleep 2
    if curl -sf --max-time 3 http://127.0.0.1:18790/healthz >/dev/null 2>&1; then
        ok "fleetview-backend running at http://127.0.0.1:18790"
    else
        warn "fleetview-backend not responding yet"
    fi
fi

# Backstage
if [ -d "$BACKSTAGE_APP" ]; then
    open "$BACKSTAGE_APP" 2>/dev/null && ok "Backstage opened" || warn "could not open Backstage"
fi

ok "Bootstrap complete!"
echo ""
echo "  Backstage:     open $BACKSTAGE_APP"
echo "  fleetview:     http://127.0.0.1:18790"
echo "  estate state:  $STATE"
echo ""
echo "  Update:  /usr/local/bin/idp-install-all"
echo "  Config:  $ESTATE/backstage-env.sh"
