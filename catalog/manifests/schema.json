{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "idp job manifest (crew#186 CP5)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "name",
    "image",
    "health"
  ],
  "properties": {
    "action": {
      "enum": [
        "up",
        "down"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "image": {
      "type": "string",
      "pattern": "^[a-z0-9./_-]+:(?!latest$)[A-Za-z0-9._-]+$",
      "description": "pinned tag; :latest is refused"
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "container"
        ],
        "properties": {
          "host": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "container": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "bind": {
            "enum": [
              "127.0.0.1"
            ]
          }
        }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "migration": {
      "type": "string",
      "description": "path of an R19 script; must pass bin/migration-gate before apply"
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 5,
          "maximum": 300
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[mg]$"
        },
        "cpus": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        }
      }
    },
    "caps": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NET_BIND_SERVICE",
          "CHOWN",
          "SETUID",
          "SETGID"
        ]
      },
      "description": "the only capabilities a manifest may add back; everything else stays dropped"
    }
  }
}
