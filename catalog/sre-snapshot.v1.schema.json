{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://idp.bytesync.dev/estate/sre-snapshot/1.0.0.json",
  "title": "Estate SRE snapshot",
  "description": "One freshness-aware projection over the estate's existing authorities. BLIND, STALE, NOT_HERE and CONFLICT never count as healthy evidence.",
  "type": "object",
  "required": [
    "schemaVersion",
    "contractId",
    "release",
    "generatedAt",
    "vantage",
    "state",
    "coveragePercent",
    "sources",
    "sourceStates",
    "planes",
    "blindSpots",
    "findings",
    "slos",
    "prediction",
    "agent",
    "founder",
    "integrity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "estate.sre.v1"
    },
    "contractId": {
      "const": "estate.sre"
    },
    "release": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "vantage": {
      "enum": ["laptop", "cloud", "sandbox"]
    },
    "state": {
      "enum": ["HEALTHY", "DEGRADED", "CRITICAL", "BLIND", "STALE", "CONFLICT"]
    },
    "headline": {
      "type": "string"
    },
    "coveragePercent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "summary",
          "observedAt",
          "vantage",
          "failureDomain",
          "required",
          "evidence"
        ],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": ["string", "null"]},
          "state": {
            "enum": ["OK", "DEGRADED", "DOWN", "BLIND", "STALE", "NOT_HERE", "CONFLICT"]
          },
          "summary": {"type": "string"},
          "observedAt": {"type": "string", "format": "date-time"},
          "ageSeconds": {"type": ["number", "null"]},
          "vantage": {"type": "string"},
          "failureDomain": {"type": "string"},
          "required": {"type": "boolean"},
          "evidence": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "sourceStates": {
      "type": "object",
      "additionalProperties": {
        "enum": ["OK", "DEGRADED", "DOWN", "BLIND", "STALE", "NOT_HERE", "CONFLICT"]
      }
    },
    "planes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["title", "weight", "critical", "state", "sources"],
        "properties": {
          "title": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0},
          "critical": {"type": "boolean"},
          "state": {
            "enum": ["OK", "DEGRADED", "DOWN", "BLIND", "STALE", "NOT_HERE", "CONFLICT"]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "state"],
              "properties": {
                "id": {"type": "string"},
                "state": {
                  "enum": ["OK", "DEGRADED", "DOWN", "BLIND", "STALE", "NOT_HERE", "CONFLICT"]
                },
                "summary": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blindSpots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "state", "summary", "vantage"],
        "properties": {
          "source": {"type": "string"},
          "state": {"enum": ["BLIND", "STALE", "NOT_HERE"]},
          "summary": {"type": "string"},
          "vantage": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "title",
          "detail",
          "failureDomain",
          "planes",
          "sources",
          "affected",
          "action",
          "evidence"
        ],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["critical", "high", "medium", "low"]},
          "title": {"type": "string"},
          "detail": {"type": "string"},
          "failureDomain": {"type": "string"},
          "planes": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string"}},
          "affected": {"type": "array", "items": {"type": "string"}},
          "action": {"type": "string"},
          "evidence": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "topAction": {
      "type": "string"
    },
    "slos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "target",
          "windowHours",
          "state",
          "samples",
          "minimumSamples",
          "observedAvailability",
          "burnRate",
          "confidence",
          "sources"
        ],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "target": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "windowHours": {"type": "number", "exclusiveMinimum": 0},
          "state": {"enum": ["LEARNING", "HEALTHY", "BREACHING"]},
          "samples": {"type": "integer", "minimum": 0},
          "minimumSamples": {"type": "integer", "minimum": 1},
          "observedAvailability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
          "burnRate": {"type": ["number", "null"], "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "sources": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "prediction": {
      "type": "object",
      "required": ["historySamples", "minimumSamples", "state"],
      "properties": {
        "historySamples": {"type": "integer", "minimum": 0},
        "minimumSamples": {"type": "integer", "minimum": 1},
        "state": {"enum": ["LEARNING", "ACTIVE"]}
      },
      "additionalProperties": false
    },
    "agent": {
      "$ref": "#/$defs/projection"
    },
    "founder": {
      "type": "object",
      "required": [
        "state",
        "headline",
        "confidence",
        "blindSpotCount",
        "freshnessSeconds",
        "topRisks",
        "snapshotHash"
      ],
      "properties": {
        "state": {"type": "string"},
        "headline": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blindSpotCount": {"type": "integer", "minimum": 0},
        "freshnessSeconds": {"type": "number", "minimum": 0},
        "topRisks": {"type": "array"},
        "snapshotHash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "projection": {
      "type": "object",
      "required": ["state", "headline", "topAction", "canClaimHealthy", "snapshotHash"],
      "properties": {
        "state": {"type": "string"},
        "headline": {"type": "string"},
        "topAction": {"type": "string"},
        "canClaimHealthy": {"type": "boolean"},
        "snapshotHash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
