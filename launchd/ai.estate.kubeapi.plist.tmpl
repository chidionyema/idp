<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The cluster's API on the tailnet, so a phone app can read the cluster.
     Always on: it must already be running when something breaks. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.estate.kubeapi</string>
  <key>ProgramArguments</key>
  <array>
    <string>${IDP}/bin/idp-kubeapi-mac</string>
  </array>
  <key>WorkingDirectory</key><string>${IDP}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>${IDP}/run/kubeapi-launchd.log</string>
  <key>StandardErrorPath</key><string>${IDP}/run/kubeapi-launchd.log</string>
</dict>
</plist>
