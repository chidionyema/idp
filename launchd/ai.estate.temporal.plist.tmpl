<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Temporal dev server backing Sovereign Bus. launchd runs it directly in
  the foreground and restarts it on any exit -- this is the process, not a
  wrapper around it, so KeepAlive actually supervises Temporal itself.

  Install:    bin/idp-install-launchd
  Remove:     launchctl bootout gui/$(id -u)/ai.estate.temporal
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>${PATH}</string>
		<key>HOME</key>
		<string>${HOME}</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.temporal</string>
	<key>ProgramArguments</key>
	<array>
		<string>temporal</string>
		<string>server</string>
		<string>start-dev</string>
		<string>--db-filename</string>
		<string>${HOME}/.estate/temporal/dev.db</string>
		<string>--namespace</string>
		<string>estate</string>
		<string>--headless</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>${HOME}/.estate/sovereign/logs/temporal-launchd.log</string>
	<key>StandardOutPath</key>
	<string>${HOME}/.estate/sovereign/logs/temporal-launchd.log</string>
	<key>WorkingDirectory</key>
	<string>${IDP}</string>
</dict>
</plist>
