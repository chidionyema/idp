<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Delivers a vault secret to a Mac-hosted service, on a schedule, without a paste.

  Why this and not the service reading its own secret: the estate's rule for this machine
  (bin/idp-bootstrap-macrun) is that the Mac holds no cloud identity and nobody pastes a secret.
  So the value is written to a file by a tool that holds the identity, and the service reads the
  file. This job is the "on a schedule" half of that, so a rotation in Secrets Manager reaches the
  running service within the interval rather than at the next human action.

  Why NOT the estate scheduler: launchd/ai.estate.scheduler.plist.tmpl's own header says it is
  "the only launchd job that should ever run a scheduled estate script again", and that Dagster
  schedules everything else from scheduler/schedule.yml. This job is deliberately the exception
  it describes, for the reason that rule exists: Dagster is a cluster service, and a job that
  delivers a credential to the Mac cannot depend on the cluster being up. When the cluster is
  down is exactly when the Mac needs to still be able to answer Twilio -- and bin/idp-one-scheduler
  is the gate that would otherwise fold this in, so that exemption is recorded rather than
  discovered.

  --check first, and only writes when it differs: a delivery that rewrites the file every five
  minutes would restart nothing (no consumer watches it) but would churn the mtime, and the
  secret's own value is the thing under test, not its freshness.

  Install: bin/idp-install-launchd
  Remove:  launchctl bootout gui/$(id -u)/ai.estate.concierge-secrets
-->
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>${PATH}</string>
		<key>HOME</key>
		<string>${HOME}</string>
	</dict>
	<key>Label</key>
	<string>ai.estate.concierge-secrets</string>
	<key>Nice</key>
	<integer>10</integer>
	<key>ProgramArguments</key>
	<array>
		<string>${IDP}/bin/idp-mac-secret-deliver</string>
		<string>--entry</string>
		<string>concierge-twilio</string>
		<string>--key</string>
		<string>TWILIO_AUTH_TOKEN</string>
		<string>--out</string>
		<string>${HOME}/.concierge/secrets/TWILIO_AUTH_TOKEN</string>
		<string>--service</string>
		<string>concierge</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>300</integer>
	<key>StandardErrorPath</key>
	<string>${IDP}/run/concierge-secrets.log</string>
	<key>StandardOutPath</key>
	<string>${IDP}/run/concierge-secrets.log</string>
	<key>WorkingDirectory</key>
	<string>${IDP}</string>
</dict>
</plist>
