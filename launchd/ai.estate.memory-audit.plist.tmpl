<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Live memory audit on the Mac, every 4 hours. Run from ~/.estate/bin (launchd cannot run anything
     under ~/Documents: TCC), same rule as ai.estate.graph-drain. The runner copies the checked-out
     bin/estate-memory-audit and catalog/memory-register.json there; it audits a CLEAN clone of main
     (never the working checkout, which agents hop branches in). Alerts: events.jsonl is tailed by
     telegram_alert.py; the audit itself sends nothing. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.estate.memory-audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>__HOME__/.estate/bin/estate-memory-audit</string>
    <string>audit</string>
    <string>--root</string><string>__HOME__/.estate/runtime/idp</string>
    <string>--register</string><string>__HOME__/.estate/runtime/idp/catalog/memory-register.json</string>
    <string>--home</string><string>__HOME__</string>
    <string>--out</string><string>__HOME__/.estate/memory/audit</string>
  </array>
  <key>StartInterval</key><integer>14400</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/.estate/memory/audit/last-run.txt</string>
  <key>StandardErrorPath</key><string>__HOME__/.estate/memory/audit/last-run.err</string>
</dict>
</plist>
