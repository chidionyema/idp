<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Voice asks litellm-local (bin/litellm-local), not llm.${ESTATE_ZONE}: the Fleet page must answer when the cluster is down. -->
<plist version="1.0"><dict>
  <key>Label</key><string>ai.estate.fleetview-backend</string>
  <!-- Interactive, never Background/Nice: this serves live voice. Background throttled it; measured
       2026-09-26, /voice/voices 10-17s in the service vs 0.5s for the same code in a shell. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>ProgramArguments</key><array>
    <!-- bin/fleetview-launchd loads LITELLM_API_KEY from the vault by name, then execs
         fleetview_backend.serve: litellm-local 401s every keyed lane without it. -->
    <string>${PYTHON_BIN}</string>
    <string>${IDP}/bin/fleetview-launchd</string>
    <string>18790</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>HOME</key><string>${HOME}</string>
    <key>ESTATE_ZONE</key><string>${ESTATE_ZONE}</string>
    <key>LITELLM_HOST</key><string>http://127.0.0.1:4000</string>
    <key>VOICE_ROUTER_MODEL</key><string>voice</string>
    <key>NATS_URL</key><string>nats://127.0.0.1:4222</string>
  </dict>
  <key>WorkingDirectory</key><string>${IDP}</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${HOME}/.estate/fleetview-backend.out.log</string>
  <key>StandardErrorPath</key><string>${HOME}/.estate/fleetview-backend.err.log</string>
</dict></plist>
