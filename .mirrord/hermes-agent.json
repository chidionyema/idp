{
  "target": {
    "path": "deployment/hermes-agent-gateway",
    "namespace": "hermes-agent"
  },
  "agent": {
    "namespace": "hermes-agent",
    "ttl": 60,
    "resources": {
      "requests": {
        "cpu": "10m",
        "memory": "32Mi"
      },
      "limits": {
        "cpu": "200m",
        "memory": "128Mi"
      }
    }
  },
  "feature": {
    "env": true,
    "fs": "read",
    "network": {
      "incoming": {
        "mode": "mirror",
        "port_mapping": [
          [
            9900,
            9900
          ]
        ]
      },
      "outgoing": true,
      "dns": true
    }
  }
}
