{
  "target": "targetless",
  "agent": {
    "namespace": "staging",
    "ttl": 60,
    "resources": {
      "requests": {
        "cpu": "10m",
        "memory": "32Mi"
      },
      "limits": {
        "cpu": "200m",
        "memory": "128Mi"
      }
    }
  },
  "feature": {
    "env": false,
    "fs": "local",
    "network": {
      "incoming": "off",
      "outgoing": true,
      "dns": true
    }
  }
}
