{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/idp-session-bootstrap",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/idp-reasoning-gateway-hook --hook",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "piAgent": {
    "defaultProvider": "estate",
    "defaultModel": "minimax_m27",
    "defaultThinkingLevel": "high",
    "availableProviders": ["local", "estate"],
    "fallbackChain": {
      "generation": ["local", "estate"],
      "verification": ["local", "estate"]
    },
    "packages": [
      "npm:pi-web-access",
      "npm:pi-llm-council",
      "npm:pi-codex-goal",
      "npm:pi-subagents",
      "npm:pi-agents",
      "git:github.com/tomsej/pi-ext",
      "npm:pi-loop-mode",
      "git:github.com/nicobailon/pi-review-loop",
      "npm:pi-crew",
      "npm:pi-context-prune",
      "npm:@cgaravitoq/pi-claude-code-auth"
    ],
    "theme": "dark",
    "hideThinkingBlock": true,
    "steeringMode": "one-at-a-time"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 4096,
    "keepRecentTokens": 16000
  },
  "vcc": {
    "overrideDefaultCompaction": false,
    "smartKeepTail": true,
    "continueAfterThresholdCompact": true,
    "debug": false
  },
  "scripts": {
    "binCount": 310,
    "binPath": "$CLAUDE_PROJECT_DIR/bin",
    "piAgentScripts": ["canary.sh", "edit_workflow.py", "impl_plan.py", "incremental.py", "learning_loop.py", "model_router.py", "project_context.py", "run-ultimate.sh", "test_spec.py"],
    "piAgentExtensions": ["breaker", "dispatch", "executor-door", "feed-guard.ts", "pi-crew", "pi-delegate", "pi-governance"],
    "piAgentWorkflows": ["pev.yaml", "probe-devstral-solo.yaml", "probe-m3x2.yaml", "probe-turns.yaml", "recon.yaml", "review-fanout.yaml", "ultimate-code.workflow.json"]
  }
}
