# Generated. Both are rebuilt from ~/.estate/state/inventory.json on every
# bin/idp-up, so a committed copy is a stale copy that reads as a record.
catalog/catalog-info.yaml
catalog/estate.db
catalog/estate.db.tmp

# Runtime
logs/
*.pid

# Installed, not authored
.venv/
node_modules/
dist-types/
.yarn/cache/

# Denied to agent sessions on this machine; nothing load-bearing lives here.
run/

# Langfuse secrets. Generated by bin/langfuse-up, chmod 600, never committed.
observability/.env

# Generated by bin/supply-chain on demand. A committed SBOM is a stale SBOM.
reports/

# Any .env, anywhere in this repo. The narrow rule was `observability/.env`,
# which silently did not cover llm/.env when the second stack arrived. A secrets
# rule scoped to one directory is a rule that fails the moment a directory is added.
.env
**/.env
site/
architecture/out/

# Compiled Python. CPython writes bytecode next to the source on every import,
# so `git add scheduler/` sweeps it in and nothing here said otherwise. One had
# already reached main: scheduler/estate_scheduler/__pycache__/definitions.cpython-314.pyc,
# bytecode for interpreter 3.14, which another machine may not have. Measured in
# the working checkout: 546 __pycache__ directories, 545 of them inside
# node_modules and virtualenvs, 1 in the source tree.
__pycache__/
*.py[cod]
platform/oci/.terraform/
platform/oci/*.tfvars
platform/oci/*.tfstate*
