# Generated. Both are rebuilt from ~/.estate/state/inventory.json on every
# bin/idp-up, so a committed copy is a stale copy that reads as a record.
catalog/catalog-info.yaml
catalog/estate.db
catalog/estate.db.tmp

# Runtime
logs/
*.pid

# Installed, not authored
.venv/
node_modules/
dist-types/
.yarn/cache/

# Denied to agent sessions on this machine; nothing load-bearing lives here.
run/

# Langfuse secrets. Generated by bin/langfuse-up, chmod 600, never committed.
observability/.env

# Generated by bin/supply-chain on demand, at the repo root. A committed SBOM is a stale
# SBOM. Anchored to the root on purpose: the unanchored rule also swallowed docs/reports
# (the published Reports pages) and every publisher died at `git add`, one by one
# (runs 33701059541, 33704425141). Same class as the .env note below, other direction.
/reports/

# Any .env, anywhere in this repo. The narrow rule was `observability/.env`,
# which silently did not cover llm/.env when the second stack arrived. A secrets
# rule scoped to one directory is a rule that fails the moment a directory is added.
.env
**/.env
site/
architecture/out/

# Compiled Python. CPython writes bytecode next to the source on every import,
# so `git add scheduler/` sweeps it in and nothing here said otherwise. One had
# already reached main: scheduler/estate_scheduler/__pycache__/definitions.cpython-314.pyc,
# bytecode for interpreter 3.14, which another machine may not have. Measured in
# the working checkout: 546 __pycache__ directories, 545 of them inside
# node_modules and virtualenvs, 1 in the source tree.
__pycache__/
*.py[cod]
platform/oci/.terraform/
platform/oci/*.tfvars
platform/oci/*.tfstate*
platform/oci/*.tfplan

# sb attach writes runtime state here (mount hash, receipts); never committed
.estate/
platform/oci/backend_override.tf
platform/**/backend_override.tf

platform/oci/identity/backend_override.tf
platform/oci/identity/.terraform*
platform/oci/identity/*.tfstate*

# CI checks prospector's ClusterPolicies out here so idp-kyverno-render judges all 26 (crew#539).

# Every session works in a git worktree checked out at .wt-<name>/ in this directory; 33 of them
# were registered on 2026-08-29. They are checkouts of this same repository, graded on their own
# branches when those branches are pushed. Untracked and unignored, they were scanned by every
# root-level tool run here, so `IDP_CI_FAST=1 bin/idp-ci` on a clean branch read
# `FAIL ruff` for three F821s in .wt-keyless, .wt-p0 and .wt-stale -- another session's
# work-in-progress refusing this session's push, and a red that says nothing about either branch.
/.wt-*/
# generated at docs build by bin/mkdocs_hooks/incident_register.py (crew#679 CP2); never committed, never stale
docs/reference/incident-register.yaml

# Vale downloads the Microsoft style on `vale sync`; only the estate boundary (styles/Estate, styles/config) is ours
styles/Microsoft/

# migrate-domain keeps a resumable state file here, per run (crew#838 CP1).
.migration/
