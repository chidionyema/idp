# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_TOKEN: Optional fine-grained GitHub token (Contents: Read/Write, Pull requests: Read/Write)
# for direct server-side Greenlane branch sync to private chidionyema/argon.
GITHUB_TOKEN=""

# CLIENT_ID & CLIENT_SECRET: Optional GitHub OAuth App credentials for popup OAuth sync to chidionyema/argon.
CLIENT_ID=""
CLIENT_SECRET=""

# ESTATE_RECEIPT_KEY: Optional >=16-char secret for persistent Optimus HMAC-SHA256 signing across restarts.
ESTATE_RECEIPT_KEY=""

