import argparse, base64, hashlib, json, os, shutil, sqlite3, subprocess, sys, time, zlib
from pathlib import Path

HOME = Path.home()
DB_PATH = Path(os.environ.get("ESTATE_DB_PATH", str(HOME / ".estate/estate.db")))
SPORE_PATH = Path(os.environ.get("GENESIS_SPORE_PATH", str(HOME / ".estate/GENESIS_SPORE.dna")))
IDP_MEMORY_DIR = HOME / "Documents/code/idp/platform/estate/memory"
DISK_FLOOR_MB = 1500

def free_disk_mb() -> int:
    target = "/System/Volumes/Data" if os.path.exists("/System/Volumes/Data") else "/"
    return int(shutil.disk_usage(target).free // (1024 * 1024))

def open_synapse_db() -> sqlite3.Connection:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(str(DB_PATH), timeout=5.0)
    conn.row_factory = sqlite3.Row
    conn.executescript("""
    PRAGMA journal_mode = WAL;
    PRAGMA synchronous = NORMAL;
    PRAGMA busy_timeout = 5000;

    CREATE TABLE IF NOT EXISTS swarm_fencing_state (
        id INTEGER PRIMARY KEY CHECK(id = 1),
        authoritative_token INTEGER NOT NULL DEFAULT 45
    );
    INSERT OR IGNORE INTO swarm_fencing_state (id, authoritative_token) VALUES (1, 45);

    CREATE TABLE IF NOT EXISTS mycelium_task_queue (
        task_id TEXT PRIMARY KEY,
        prompt_payload TEXT NOT NULL DEFAULT '',
        status TEXT NOT NULL CHECK(status IN ('OPEN', 'LEASED', 'COMPLETED', 'FAILED')),
        leased_by TEXT,
        lease_expires_at INTEGER,
        fencing_token INTEGER NOT NULL DEFAULT 45,
        result_json TEXT,
        updated_at INTEGER NOT NULL
    );

    CREATE TABLE IF NOT EXISTS catechism_antibodies (
        antibody_id TEXT PRIMARY KEY,
        failure_class_signature TEXT NOT NULL UNIQUE,
        remediation_cmd TEXT NOT NULL,
        ed25519_signature TEXT NOT NULL,
        created_at INTEGER NOT NULL
    );

    CREATE TABLE IF NOT EXISTS realtime_event_ring (
        seq_id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts_ns INTEGER NOT NULL,
        fencing_token INTEGER NOT NULL,
        topic TEXT NOT NULL,
        source_node TEXT NOT NULL,
        prev_merkle_root TEXT NOT NULL,
        merkle_root TEXT NOT NULL,
        payload_json TEXT NOT NULL
    );
    """)
    conn.commit()
    return conn

def append_ring_event(conn: sqlite3.Connection, topic: str, source: str, payload: dict) -> dict:
    now_ns = time.time_ns()
    token = conn.execute("SELECT authoritative_token FROM swarm_fencing_state WHERE id = 1").fetchone()[0]
    prev_row = conn.execute("SELECT merkle_root FROM realtime_event_ring ORDER BY seq_id DESC LIMIT 1").fetchone()
    prev_root = prev_row["merkle_root"] if prev_row else ("0" * 64)
    payload_str = json.dumps(payload, separators=(",", ":"), sort_keys=True)

    h = hashlib.sha256()
    h.update(b"\x01" + prev_root.encode() + str(now_ns).encode() + str(token).encode() + topic.encode() + payload_str.encode())
    merkle_root = h.hexdigest()

    cur = conn.execute(
        """
        INSERT INTO realtime_event_ring
        (ts_ns, fencing_token, topic, source_node, prev_merkle_root, merkle_root, payload_json)
        VALUES (?, ?, ?, ?, ?, ?, ?)
        """,
        (now_ns, token, topic, source, prev_root, merkle_root, payload_str),
    )
    conn.commit()
    return {"seq_id": cur.lastrowid, "fencing_token": token, "merkle_root": merkle_root}

def write_to_memory_door(fact_text: str, kind: str = "fact") -> bool:
    if not IDP_MEMORY_DIR.is_dir():
        return False
    if str(IDP_MEMORY_DIR) not in sys.path:
        sys.path.insert(0, str(IDP_MEMORY_DIR))
    os.environ.setdefault("ESTATE_MEMORY_NAMESPACE", "estate")
    try:
        import door  # type: ignore
        res = door.post({"kind": kind, "text": fact_text})
        return bool(res and res.get("written"))
    except Exception:
        return False

def repack_4kb_spore(conn: sqlite3.Connection) -> dict:
    latest = conn.execute("SELECT seq_id, merkle_root FROM realtime_event_ring ORDER BY seq_id DESC LIMIT 1").fetchone()
    seq_id = latest["seq_id"] if latest else 0
    merkle = latest["merkle_root"] if latest else ("0" * 64)
    token = conn.execute("SELECT authoritative_token FROM swarm_fencing_state WHERE id = 1").fetchone()[0]

    antibodies = [
        {"id": r["antibody_id"], "sig": r["failure_class_signature"], "cmd": r["remediation_cmd"]}
        for r in conn.execute("SELECT antibody_id, failure_class_signature, remediation_cmd FROM catechism_antibodies ORDER BY created_at DESC LIMIT 12")
    ]
    recent_intel = [
        json.loads(r["payload_json"])
        for r in conn.execute("SELECT payload_json FROM realtime_event_ring WHERE topic IN ('swarm.yield', 'swarm.antibody') ORDER BY seq_id DESC LIMIT 8")
    ]

    dna_obj = {
        "v": "0.7.0-RT",
        "seq": seq_id,
        "fencing_token": token,
        "merkle": merkle,
        "disk_free_mb": free_disk_mb(),
        "canonical_doors": {
            "memory": str(IDP_MEMORY_DIR / "door.py"),
            "realtime_bus": "http://127.0.0.1:4001/api/realtime/ws",
            "projector": "http://127.0.0.1:3000/#projector",
        },
        "antibodies": antibodies,
        "peer_intel": recent_intel,
    }
    compressed = zlib.compress(json.dumps(dna_obj, separators=(",", ":")).encode("utf-8"), level=9)
    b64 = base64.urlsafe_b64encode(compressed).decode("ascii")
    digest = hashlib.sha256(compressed).hexdigest()[:16]
    spore_str = (
        f"#!/usr/bin/env python3\n"
        f"# GENESIS_SPORE.dna v0.7.0-RT | SEQ:{seq_id} | FENCE:{token} | SHA256:{digest}\n"
        f"import base64,json,zlib;DNA=json.loads(zlib.decompress(base64.urlsafe_b64decode('{b64}')))\n"
        f"if __name__=='__main__':print(json.dumps(DNA,indent=2))\n"
    )
    raw = spore_str.encode("utf-8")
    assert len(raw) <= 4096, f"Spore exceeded 4KB cap: {len(raw)}B"
    SPORE_PATH.parent.mkdir(parents=True, exist_ok=True)
    SPORE_PATH.write_bytes(raw)
    return {"spore_bytes": len(raw), "seq_id": seq_id, "fencing_token": token, "sha256_prefix": digest}

def cmd_hydrate(conn: sqlite3.Connection, agent_id: str, layer: str, failure_sig: str | None) -> dict:
    mb = free_disk_mb()
    if mb < DISK_FLOOR_MB:
        return {"status": "HALT_DISK_FLOOR", "disk_free_mb": mb, "allowed_to_proceed": False}

    # 1. Check Pass-0 Antibody First (0 LLM passes if known)
    if failure_sig:
        ab = conn.execute(
            "SELECT antibody_id, remediation_cmd FROM catechism_antibodies WHERE failure_class_signature = ?",
            (failure_sig,),
        ).fetchone()
        if ab:
            return {
                "status": "PASS_0_ANTIBODY_HIT",
                "antibody_id": ab["antibody_id"],
                "remediation_cmd": ab["remediation_cmd"],
                "agent_diag_passes": 0,
                "allowed_to_proceed": False,
                "instruction": "Execute remediation_cmd directly; do not spend LLM tokens diagnosing.",
            }

    # 2. Check Stigmergic Lease Table (Prevent concurrent sessions from colliding on the same layer)
    now_sec = int(time.time())
    existing = conn.execute("SELECT * FROM mycelium_task_queue WHERE task_id = ?", (layer,)).fetchone()
    if existing:
        if existing["status"] == "COMPLETED":
            return {
                "status": "ALREADY_LANDED_BY_PEER",
                "layer": layer,
                "leased_by": existing["leased_by"],
                "result": json.loads(existing["result_json"] or "{}"),
                "allowed_to_proceed": False,
                "instruction": "Abandon duplicate work; peer already solved and landed this layer.",
            }
        if existing["status"] == "LEASED" and existing["lease_expires_at"] > now_sec and existing["leased_by"] != agent_id:
            return {
                "status": "LOCKED_BY_ACTIVE_PEER",
                "layer": layer,
                "leased_by": existing["leased_by"],
                "lease_expires_in_sec": existing["lease_expires_at"] - now_sec,
                "allowed_to_proceed": False,
                "instruction": "Do not touch this layer; another session holds an active lease.",
            }

    # 3. Grant Fenced Lease (Monotonic Fencing Token incremented per Kleppmann DDIA)
    conn.execute("UPDATE swarm_fencing_state SET authoritative_token = authoritative_token + 1 WHERE id = 1")
    token = conn.execute("SELECT authoritative_token FROM swarm_fencing_state WHERE id = 1").fetchone()[0]
    conn.execute(
        """
        INSERT OR REPLACE INTO mycelium_task_queue
        (task_id, prompt_payload, status, leased_by, lease_expires_at, fencing_token, result_json, updated_at)
        VALUES (?, ?, 'LEASED', ?, ?, ?, NULL, ?)
        """,
        (layer, failure_sig or "", agent_id, now_sec + 300, token, now_sec),
    )
    conn.commit()
    spore_meta = repack_4kb_spore(conn)
    return {
        "status": "LEASE_GRANTED",
        "layer": layer,
        "agent_id": agent_id,
        "fencing_token": token,
        "disk_free_mb": mb,
        "spore": spore_meta,
        "allowed_to_proceed": True,
    }

def cmd_yield(
    conn: sqlite3.Connection,
    agent_id: str,
    layer: str,
    fencing_token: int,
    commit_sha: str,
    learned_fact: str,
    antibody_sig: str | None,
    antibody_cmd: str | None,
) -> dict:
    # 1. Enforce Dual-Yield Law: No work delivery is accepted without a learned fact/invariant
    if not learned_fact or len(learned_fact.strip()) < 15:
        raise SystemExit("REFUSED_BY_DUAL_YIELD_LAW: Every yield must include a substantive --fact (<root-cause/intel>) for the swarm.")

    # 2. Verify Fencing Token (Reject zombie/stale sessions whose lease was superseded)
    row = conn.execute("SELECT fencing_token, leased_by FROM mycelium_task_queue WHERE task_id = ?", (layer,)).fetchone()
    if row and fencing_token < row["fencing_token"]:
        raise SystemExit(
            f"FENCED_OUT_STALE_SESSION: token {fencing_token} < authoritative layer token {row['fencing_token']} (held by {row['leased_by']})"
        )

    now_sec = int(time.time())
    result_obj = {"commit_sha": commit_sha, "learned_fact": learned_fact, "agent_id": agent_id, "ts": now_sec}
    conn.execute(
        """
        UPDATE mycelium_task_queue
        SET status = 'COMPLETED', result_json = ?, updated_at = ?
        WHERE task_id = ?
        """,
        (json.dumps(result_obj), now_sec, layer),
    )

    # 3. Optional Pass-0 Antibody Synthesis
    antibody_id = None
    if antibody_sig and antibody_cmd:
        antibody_id = f"AB-{hashlib.sha256(antibody_sig.encode()).hexdigest()[:8].upper()}"
        sig_hex = hashlib.sha256(f"{antibody_id}:{antibody_sig}:{antibody_cmd}:{commit_sha}".encode()).hexdigest()
        conn.execute(
            """
            INSERT OR REPLACE INTO catechism_antibodies
            (antibody_id, failure_class_signature, remediation_cmd, ed25519_signature, created_at)
            VALUES (?, ?, ?, ?, ?)
            """,
            (antibody_id, antibody_sig, antibody_cmd, sig_hex, now_sec),
        )

    # 4. Write to Local-First Memory Door + Broadcast to Real-Time Ring + Repack 4KB Spore
    door_ok = write_to_memory_door(f"[{layer} @ {commit_sha[:12]}] {learned_fact}", kind="decision")
    ring_env = append_ring_event(
        conn,
        topic="swarm.yield",
        source=agent_id,
        payload={
            "layer": layer,
            "commitSha": commit_sha,
            "learnedFact": learned_fact,
            "antibodyId": antibody_id,
            "memoryDoorSynced": door_ok,
        },
    )
    spore_meta = repack_4kb_spore(conn)
    return {
        "status": "DUAL_YIELD_COMMITTED",
        "ring_envelope": ring_env,
        "memory_door_written": door_ok,
        "antibody_registered": antibody_id,
        "spore": spore_meta,
    }

