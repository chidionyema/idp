def _keystream_xor(data: bytes, enc_key: bytes, nonce: bytes) -> bytes:
    out = bytearray(len(data))
    block_Count = (len(data) + 31) // 32
    for counter in range(block_Count):
        blk = hmac.new(enc_key, nonce + struct.pack(">Q", counter), hashlib.sha256).digest()
        start = counter * 32
        end = min(start + 32, len(data))
        for i in range(start, end):
            out[i] = data[i] ^ blk[i - start]
    return bytes(out)


def encrypt_soma_payload(plaintext: bytes, passphrase: str) -> bytes:
    salt = os.urandom(16)
    nonce = os.urandom(16)
    derived = hashlib.pbkdf2_hmac("sha256", passphrase.encode("utf-8"), salt, 200000, dklen=64)
    enc_key, mac_key = derived[:32], derived[32:]
    ciphertext = _keystream_xor(plaintext, enc_key, nonce)
    tag = hmac.new(mac_key, salt + nonce + ciphertext, hashlib.sha256).digest()
    return b"GENVAULT1" + salt + nonce + tag + ciphertext


def decrypt_soma_payload(blob: bytes, passphrase: str) -> bytes:
    if not blob.startswith(b"GENVAULT1"):
        raise ValueError("Invalid vault magic header")
    salt = blob[9:25]
    nonce = blob[25:41]
    tag = blob[41:73]
    ciphertext = blob[73:]
    derived = hashlib.pbkdf2_hmac("sha256", passphrase.encode("utf-8"), salt, 200000, dklen=64)
    enc_key, mac_key = derived[:32], derived[32:]
    expected_tag = hmac.new(mac_key, salt + nonce + ciphertext, hashlib.sha256).digest()
    if not hmac.compare_digest(tag, expected_tag):
        raise ValueError("VAULT_MAC_VERIFICATION_FAILED: Tampered shard or wrong key")
    return _keystream_xor(ciphertext, enc_key, nonce)


