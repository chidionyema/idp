GF_EXP = [0] * 512
GF_LOG = [0] * 256


def _init_gf256() -> None:
    x = 1
    for i in range(255):
        GF_EXP[i] = x
        GF_LOG[x] = i
        x <<= 1
        if x & 0x100:
            x ^= 0x11D
    for i in range(255, 512):
        GF_EXP[i] = GF_EXP[i - 255]


_init_gf256()


def gf_mul(a: int, b: int) -> int:
    if a == 0 or b == 0:
        return 0
    return GF_EXP[GF_LOG[a] + GF_LOG[b]]


def gf_inv(a: int) -> int:
    if a == 0:
        raise ZeroDivisionError("GF(256) inverse of 0")
    return GF_EXP[255 - GF_LOG[a]]


def gf_matrix_invert(matrix: list[list[int]]) -> list[list[int]]:
    """Inverts a k x k matrix in GF(2^8) via Gauss-Jordan elimination."""
    k = len(matrix)
    aug = [row[:] + [1 if i == j else 0 for j in range(k)] for i, row in enumerate(matrix)]
    for col in range(k):
        pivot = col
        while pivot < k and aug[pivot][col] == 0:
            pivot += 1
        if pivot == k:
            raise ValueError("Singular matrix in GF(256) reconstruction")
        aug[col], aug[pivot] = aug[pivot], aug[col]
        inv_p = gf_inv(aug[col][col])
        aug[col] = [gf_mul(val, inv_p) for val in aug[col]]
        for row in range(k):
            if row != col and aug[row][col] != 0:
                factor = aug[row][col]
                aug[row] = [aug[row][c] ^ gf_mul(factor, aug[col][c]) for c in range(2 * k)]
    return [row[k:] for row in aug]


def rs_encode_k3_n8(data: bytes) -> list[bytes]:
    """Splits payload into k=3 data shards and computes 5 parity shards (total n=8)."""
    orig_len = len(data)
    header = struct.pack(">I", orig_len)
    stream = header + data
    pad_len = (K_SHARDS - (len(stream) % K_SHARDS)) % K_SHARDS
    stream += b"\x00" * pad_len
    chunk_size = len(stream) // K_SHARDS

    data_shards = [bytearray(stream[i * chunk_size : (i + 1) * chunk_size]) for i in range(K_SHARDS)]
    shards: list[bytes] = []

    # Row 0..k-1: Identity matrix (systematic data shards)
    # Row k..n-1: Vandermonde rows (x^(j) where x = row_idx + 1)
    for row_idx in range(N_SHARDS):
        if row_idx < K_SHARDS:
            shards.append(bytes(data_shards[row_idx]))
        else:
            x = row_idx + 1
            coeffs = [1, x, gf_mul(x, x)]
            parity = bytearray(chunk_size)
            for c_idx, coeff in enumerate(coeffs):
                src = data_shards[c_idx]
                for b_idx in range(chunk_size):
                    parity[b_idx] ^= gf_mul(coeff, src[b_idx])
            shards.append(bytes(parity))
    return shards


def rs_decode_any_3(available_shards: dict[int, bytes]) -> bytes:
    """Reconstructs original payload from any 3 of the 8 shards."""
    if len(available_shards) < K_SHARDS:
        raise ValueError(f"Need at least {K_SHARDS} shards, found {len(available_shards)}")

    selected_indices = sorted(available_shards.keys())[:K_SHARDS]
    chunk_size = len(available_shards[selected_indices[0]])

    mat: list[list[int]] = []
    for idx in selected_indices:
        if idx < K_SHARDS:
            row = [1 if c == idx else 0 for c in range(K_SHARDS)]
        else:
            x = idx + 1
            row = [1, x, gf_mul(x, x)]
        mat.append(row)

    inv_mat = gf_matrix_invert(mat)
    reconstructed: list[bytearray] = [bytearray(chunk_size) for _ in range(K_SHARDS)]

    for d_idx in range(K_SHARDS):
        for s_pos, shard_idx in enumerate(selected_indices):
            coeff = inv_mat[d_idx][s_pos]
            if coeff == 0:
                continue
            src = available_shards[shard_idx]
            target = reconstructed[d_idx]
            for b_idx in range(chunk_size):
                target[b_idx] ^= gf_mul(coeff, src[b_idx])

    raw_stream = b"".join(bytes(r) for r in reconstructed)
    orig_len = struct.unpack(">I", raw_stream[:4])[0]
    return raw_stream[4 : 4 + orig_len]


