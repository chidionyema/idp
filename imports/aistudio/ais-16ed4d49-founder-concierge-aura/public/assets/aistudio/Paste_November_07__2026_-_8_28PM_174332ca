import React, { useEffect, useState } from "react";
import {
  SurfaceRoute,
  VerifiedSurfaceState,
  InstructionExecutionResult,
  probeVerifiedSurfaceState,
  submitAuthenticatedInstruction,
} from "../engine/protocolEngine";

function resolveRouteFromHash(): SurfaceRoute {
  const hash = window.location.hash.replace(/^#\/?/, "").split("/")[0].toLowerCase();
  if (hash === "otto" || hash === "concierge" || hash === "") return "concierge";
  if (hash === "greenlane") return "greenlane";
  if (hash === "fleet" || hash === "optimus") return "fleet";
  if (hash === "decisions" || hash === "omega") return "decisions";
  return "concierge";
}

export const FounderConciergeSurface: React.FC = () => {
  const [route, setRoute] = useState<SurfaceRoute>(resolveRouteFromHash);
  const [surfaceState, setSurfaceState] = useState<VerifiedSurfaceState | null>(null);
  const [intentInput, setIntentInput] = useState<string>("");
  const [submitting, setSubmitting] = useState<boolean>(false);
  const [executionResult, setExecutionResult] = useState<InstructionExecutionResult | null>(null);

  useEffect(() => {
    const syncHash = () => setRoute(resolveRouteFromHash());
    window.addEventListener("hashchange", syncHash);
    return () => window.removeEventListener("hashchange", syncHash);
  }, []);

  useEffect(() => {
    probeVerifiedSurfaceState().then(setSurfaceState);
  }, []);

  const switchRoute = (target: SurfaceRoute) => {
    window.location.hash = `#${target}`;
    setRoute(target);
  };

  const canIssueCommand =
    Boolean(surfaceState?.reachable) &&
    Boolean(surfaceState?.capabilities.sessionWritable) &&
    Boolean(surfaceState?.capabilities.modelCredentialPresent);

  const handleDispatch = async () => {
    if (!intentInput.trim() || !canIssueCommand) return;
    setSubmitting(true);
    setExecutionResult(null);
    const result = await submitAuthenticatedInstruction(intentInput.trim());
    setExecutionResult(result);
    setSubmitting(false);
  };

  return (
    <div className="min-h-screen bg-[#06080E] text-slate-100 flex flex-col justify-between p-6 font-sans">
      <header className="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-4">
        <div className="flex items-center gap-3">
          <span
            className={`h-2.5 w-2.5 rounded-full ${
              canIssueCommand ? "bg-emerald-400" : "bg-rose-500"
            }`}
          />
          <span className="text-sm font-semibold tracking-wide">GENESIS FOUNDER CONCIERGE</span>
          <span className="text-xs font-mono text-slate-400 border border-white/10 px-2 py-0.5 rounded">
            BUILD: {surfaceState?.provenanceCommit || "PROBING..."}
          </span>
        </div>

        <nav className="flex items-center gap-2">
          {(["concierge", "greenlane", "fleet", "decisions"] as SurfaceRoute[]).map((tab) => (
            <button
              key={tab}
              onClick={() => switchRoute(tab)}
              className={`px-3 py-1.5 rounded-lg text-xs uppercase tracking-wider font-mono ${
                route === tab
                  ? "bg-white/15 text-white border border-white/30"
                  : "text-slate-400 hover:text-white"
              }`}
            >
              #{tab}
            </button>
          ))}
        </nav>
      </header>

      {surfaceState && !canIssueCommand && (
        <div className="my-4 p-4 rounded-xl bg-rose-950/50 border border-rose-500/40 text-rose-200 text-xs font-mono space-y-1">
          <div className="font-bold uppercase tracking-wider text-rose-300">
            COMMERCIAL RELEASE STATUS: BLOCKED — CAPABILITIES UNAVAILABLE
          </div>
          <div>
            HTTP {surfaceState.httpStatus} · {surfaceState.errorCode}: {surfaceState.errorMessage}
          </div>
          <div className="flex flex-wrap gap-4 pt-2 text-[11px]">
            <span>
              Writable Backend (Argon #20):{" "}
              {surfaceState.capabilities.sessionWritable ? "CONNECTED" : "UNAVAILABLE"}
            </span>
            <span>
              Model Lane Credential:{" "}
              {surfaceState.capabilities.modelCredentialPresent ? "PRESENT" : "MISSING"}
            </span>
            <span>
              Voice Gateway (IDP #7664):{" "}
              {surfaceState.capabilities.voiceGatewayConnected ? "CONNECTED" : "UNAVAILABLE"}
            </span>
            <span>
              Greenlane Projection:{" "}
              {surfaceState.capabilities.greenlaneProjectionAttached ? "ATTACHED" : "UNAVAILABLE"}
            </span>
          </div>
        </div>
      )}

      <main className="my-auto max-w-2xl w-full mx-auto space-y-6">
        {route === "concierge" && (
          <div className="p-6 rounded-2xl bg-white/[0.03] border border-white/10 space-y-4">
            <div className="flex items-center justify-between">
              <h1 className="text-base font-medium text-white">Issue Founder Instruction</h1>
              <span className="text-xs font-mono text-slate-400">
                Voice Gateway:{" "}
                {surfaceState?.capabilities.voiceGatewayConnected
                  ? "READY"
                  : "UNAVAILABLE (IDP #7664 PENDING)"}
              </span>
            </div>

            <div className="flex gap-2">
              <input
                type="text"
                value={intentInput}
                onChange={(e) => setIntentInput(e.target.value)}
                disabled={!canIssueCommand || submitting}
                placeholder={
                  canIssueCommand
                    ? "Speak or type an instruction..."
                    : "Command input disabled until writable backend and model credentials are verified."
                }
                className="flex-1 bg-black/40 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white placeholder-slate-500 disabled:opacity-50"
              />
              <button
                onClick={handleDispatch}
                disabled={!canIssueCommand || submitting || !intentInput.trim()}
                className="px-5 py-2.5 rounded-xl bg-emerald-500 text-black font-semibold text-xs uppercase tracking-wider disabled:opacity-30 disabled:cursor-not-allowed"
              >
                {submitting ? "Executing..." : "Execute"}
              </button>
            </div>

            {executionResult && (
              <div
                className={`p-4 rounded-xl border text-xs font-mono space-y-1.5 ${
                  executionResult.ok
                    ? "bg-emerald-950/30 border-emerald-500/40 text-emerald-200"
                    : "bg-rose-950/40 border-rose-500/40 text-rose-200"
                }`}
              >
                {executionResult.ok ? (
                  <>
                    <div>ID: {executionResult.instructionId}</div>
                    <div>PROPOSED ACTION: {executionResult.proposedAction}</div>
                    <div>STATE: {executionResult.executionStatus}</div>
                    <div>VERIFIED OUTCOME: {executionResult.verifiedOutcome}</div>
                  </>
                ) : (
                  <>
                    <div>EXECUTION REJECTED (HTTP {executionResult.httpStatus})</div>
                    <div>
                      {executionResult.errorCode}: {executionResult.errorMessage}
                    </div>
                  </>
                )}
              </div>
            )}
          </div>
        )}

        {route !== "concierge" && (
          <div className="p-6 rounded-2xl bg-white/[0.03] border border-white/10 text-xs font-mono text-slate-300 space-y-2">
            <div className="text-sm font-semibold text-white uppercase">
              #{route} Supporting Telemetry
            </div>
            <div>
              No seeded or fixture data is permitted on this view (Argon #7 assurance gate). Live projection will render only when the upstream service reports verified state.
            </div>
          </div>
        )}
      </main>

      <footer className="flex items-center justify-between text-xs font-mono text-slate-500 border-t border-white/10 pt-4">
        <span>ZERO SEEDED FIXTURES · FAIL-CLOSED GATEWAY</span>
        <span>ROUTE: #{route}</span>
      </footer>
    </div>
  );
};
