const VALID_ROUTES: SurfaceRoute[] = ["otto", "greenlane", "optimus", "fleet", "omega"];

function parseHashRoute(): SurfaceRoute {
  const raw = window.location.hash.replace(/^#\/?/, "").split("/")[0].toLowerCase();
  return VALID_ROUTES.includes(raw as SurfaceRoute) ? (raw as SurfaceRoute) : "otto";
}

