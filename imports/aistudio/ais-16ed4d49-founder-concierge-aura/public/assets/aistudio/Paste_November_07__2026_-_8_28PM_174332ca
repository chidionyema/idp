  const [visemeEnergy, setVisemeEnergy] = useState<number>(0.18);
  const [ephemeralPrompt, setEphemeralPrompt] = useState<string>("");
  const [dispatchReceipt, setDispatchReceipt] = useState<string | null>(null);
  const recognitionRef = useRef<any>(null);

