export interface Env {
  ESTATE_UPSTREAM_URL?: string;         // Verified upstream concierge gateway (IDP #7664)
  CF_ACCESS_TEAM_DOMAIN?: string;       // e.g. https://833labs.cloudflareaccess.com
  CF_ACCESS_AUD?: string;               // Cloudflare Access Application Audience (AUD) tag
  FOUNDER_ED25519_PUBLIC_KEY?: string;  // Hex-encoded Ed25519 public key for signed commands
  GIT_COMMIT_SHA?: string;              // Injected at build/deploy time by CI
}

const ALLOWED_ORIGIN = "https://genesis-founder-surface.pages.dev";

function buildCorsHeaders(requestOrigin: string | null): Record<string, string> {
  const origin = requestOrigin === ALLOWED_ORIGIN ? ALLOWED_ORIGIN : "null";
  return {
    "Access-Control-Allow-Origin": origin,
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers":
      "Content-Type, Cf-Access-Jwt-Assertion, X-Genesis-Signature, X-Genesis-Timestamp",
    "Vary": "Origin",
  };
}

async function verifyFounderAuth(
  request: Request,
  env: Env,
  rawBody: string
): Promise<{ authenticated: boolean; reason?: string }> {
  // Path A: Cloudflare Access Zero-Trust JWT
  const cfJwt = request.headers.get("Cf-Access-Jwt-Assertion");
  if (cfJwt && env.CF_ACCESS_TEAM_DOMAIN && env.CF_ACCESS_AUD) {
    try {
      const jwksRes = await fetch(`${env.CF_ACCESS_TEAM_DOMAIN}/cdn-cgi/access/certs`);
      if (jwksRes.ok) {
        const parts = cfJwt.split(".");
        if (parts.length === 3) {
          const payload = JSON.parse(atob(parts[1]));
          const now = Math.floor(Date.now() / 1000);
          const audMatch = Array.isArray(payload.aud)
            ? payload.aud.includes(env.CF_ACCESS_AUD)
            : payload.aud === env.CF_ACCESS_AUD;
          if (audMatch && payload.exp && payload.exp > now) {
            return { authenticated: true };
          }
        }
      }
    } catch (_) {
      return { authenticated: false, reason: "INVALID_CF_ACCESS_JWT" };
    }
  }

  // Path B: Ed25519 Detached Request Signature (60-second replay window)
  const signatureHex = request.headers.get("X-Genesis-Signature");
  const timestampStr = request.headers.get("X-Genesis-Timestamp");
  if (signatureHex && timestampStr && env.FOUNDER_ED25519_PUBLIC_KEY) {
    const ts = Number(timestampStr);
    const nowSec = Math.floor(Date.now() / 1000);
    if (!Number.isFinite(ts) || Math.abs(nowSec - ts) > 60) {
      return { authenticated: false, reason: "SIGNATURE_TIMESTAMP_EXPIRED" };
    }
    try {
      const pubKeyBytes = new Uint8Array(
        env.FOUNDER_ED25519_PUBLIC_KEY.match(/.{1,2}/g)!.map((b) => parseInt(b, 16))
      );
      const sigBytes = new Uint8Array(
        signatureHex.match(/.{1,2}/g)!.map((b) => parseInt(b, 16))
      );
      const key = await crypto.subtle.importKey("raw", pubKeyBytes, { name: "Ed25519" }, false, [
        "verify",
      ]);
      const url = new URL(request.url);
      const canonicalPayload = `${request.method}:${url.pathname}:${timestampStr}:${rawBody}`;
      const valid = await crypto.subtle.verify(
        "Ed25519",
        key,
        sigBytes,
        new TextEncoder().encode(canonicalPayload)
      );
      if (valid) return { authenticated: true };
    } catch (_) {
      return { authenticated: false, reason: "ED25519_VERIFICATION_FAILED" };
    }
  }

  return { authenticated: false, reason: "MISSING_OR_INVALID_FOUNDER_AUTH" };
}

export const onRequest: PagesFunction<Env> = async (context) => {
  const { request, env } = context;
  const url = new URL(request.url);
  const path = url.pathname.replace(/^\/api/, "");
  const corsHeaders = buildCorsHeaders(request.headers.get("Origin"));

  if (request.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: corsHeaders });
  }

  // Fail-Closed Upstream Check: Never synthesize fake data if upstream is unconfigured
  if (!env.ESTATE_UPSTREAM_URL) {
    return Response.json(
      {
        ok: false,
        status: "backend-unconfigured",
        error: "UPSTREAM_BACKEND_NOT_CONFIGURED",
        message: "ESTATE_UPSTREAM_URL is not bound on this Cloudflare Pages deployment.",
        provenanceCommit: env.GIT_COMMIT_SHA || "UNVERIFIED_BUILD",
        capabilities: {
          sessionWritable: false,
          voiceGatewayConnected: false,
          modelCredentialPresent: false,
          greenlaneProjectionAttached: false,
        },
      },
      { status: 503, headers: corsHeaders }
    );
  }

  // Enforce Founder authentication on all write operations and voice streams
  const isMutationOrVoice =
    (request.method !== "GET" && request.method !== "HEAD") || path.startsWith("/voice/");
  const rawBody =
    request.method !== "GET" && request.method !== "HEAD" ? await request.text() : "";

  if (isMutationOrVoice) {
    const auth = await verifyFounderAuth(request, env, rawBody);
    if (!auth.authenticated) {
      return Response.json(
        { ok: false, error: "UNAUTHORIZED_FOUNDER_ACTION", reason: auth.reason },
        { status: 401, headers: corsHeaders }
      );
    }
  }

  // Transparent Proxy to IDP #7664 Gateway
  try {
    const upstreamUrl = `${env.ESTATE_UPSTREAM_URL}${url.pathname}${url.search}`;
    const upstreamHeaders = new Headers(request.headers);
    upstreamHeaders.set("X-Forwarded-Surface", "genesis-founder-surface");

    const upstreamRes = await fetch(upstreamUrl, {
      method: request.method,
      headers: upstreamHeaders,
      body: rawBody ? rawBody : undefined,
    });

    return new Response(upstreamRes.body, {
      status: upstreamRes.status,
      headers: {
        "Content-Type": upstreamRes.headers.get("Content-Type") || "application/json",
        ...corsHeaders,
      },
    });
  } catch (err: any) {
    return Response.json(
      {
        ok: false,
        status: "upstream-unreachable",
        error: "UPSTREAM_GATEWAY_UNREACHABLE",
        detail: err?.message || "Connection to ESTATE_UPSTREAM_URL failed",
      },
      { status: 502, headers: corsHeaders }
    );
  }
};
