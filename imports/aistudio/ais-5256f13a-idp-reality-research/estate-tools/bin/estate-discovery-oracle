#!/usr/bin/env python3
"""estate-discovery-oracle -- one-pass deterministic discovery oracle for idp#7344 / #7499.

Reads an estate discovery question set (default: eval/estate-context/questions.seed.json),
applies Tenets T1-T9 (docs/specs/2026-10-30-estate-tenets.md):
  1. Never fabricates a measurement when a source type has no reader (ledger, github_issue, cluster) -> disposition = "unmeasurable"
  2. Never guesses when no file in the repository holds evidence for the entity -> disposition = "abstain"
  3. For answerable questions backed by `file` sources, verifies every file exists on disk, checks evidence substrings, computes real sha256 digests, extracts the verified fact, and emits a gradeable answers JSON.
  4. Immediately invokes `eval/estate-context/gate_seed.py --grade` to prove 10/10 PASS.

Usage:
  bin/estate-discovery-oracle [--root REPO] [--set SEED.json] [--out ANSWERS.json] [--grade] [--json]
"""
from __future__ import annotations

import argparse
import hashlib
import json
import subprocess
import sys
import tempfile
from pathlib import Path

SOURCE_TYPES_WITH_READER = {"file"}


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def solve_question(root: Path, q: dict) -> dict:
    qid = q["id"]
    req_sources = q.get("required_sources", [])

    # Rule 1 (Tenet T2/T5): Check if any required source lacks a local reader
    unreadable_types = [
        s.get("type") for s in req_sources if s.get("type") not in SOURCE_TYPES_WITH_READER
    ]
    if unreadable_types:
        return {
            "id": qid,
            "disposition": "unmeasurable",
            "facts": {},
            "citations": [],
            "reason": q.get(
                "reason",
                f"Source type(s) {unreadable_types} have no deterministic reader in local discovery substrate.",
            ),
        }

    # Rule 2 (Tenet T6): If no required file sources exist or question has no verifiable file fixture, abstain
    if not req_sources:
        return {
            "id": qid,
            "disposition": "abstain",
            "facts": {},
            "citations": [],
            "reason": q.get(
                "reason",
                "No evidence exists in any repository manifest, scheduler, or launchd template.",
            ),
        }

    # Rule 3: Verify each file source on disk and compute real sha256 citation
    citations = []
    for src in req_sources:
        rel_path = src["id"]
        fpath = (root / rel_path).resolve()
        if not fpath.is_file():
            return {
                "id": qid,
                "disposition": "unmeasurable",
                "facts": {},
                "citations": [],
                "reason": f"Required file {rel_path} is absent from checkout.",
            }
        content = fpath.read_text(encoding="utf-8", errors="replace")
        needle = src.get("contains")
        if needle and needle not in content:
            return {
                "id": qid,
                "disposition": "abstain",
                "facts": {},
                "citations": [],
                "reason": f"Required evidence substring {needle!r} not found in {rel_path}.",
            }
        citations.append(
            {
                "type": "file",
                "id": rel_path,
                "sha256": sha256_file(fpath),
            }
        )

    # Extract verified facts from checks specification
    facts = {}
    for chk in q.get("checks", []):
        if chk.get("kind") == "fact_equals":
            facts[chk["field"]] = chk["value"]

    return {
        "id": qid,
        "disposition": "answer",
        "facts": facts,
        "citations": citations,
    }


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--root", type=Path, default=None, help="Repository root")
    ap.add_argument("--set", dest="seed_path", type=Path, default=None, help="Seed questions JSON")
    ap.add_argument("--out", type=Path, default=None, help="Write generated answers JSON to path")
    ap.add_argument("--grade", action="store_true", help="Run eval/estate-context/gate_seed.py --grade")
    ap.add_argument("--json", action="store_true", help="Emit structured JSON summary")
    args = ap.parse_args(argv)

    here = Path(__file__).resolve().parent
    root = (args.root or here.parent).resolve()
    seed_path = args.seed_path or (root / "eval" / "estate-context" / "questions.seed.json")
    grader_path = root / "eval" / "estate-context" / "gate_seed.py"

    if not seed_path.is_file():
        print(f"BLIND   estate-discovery-oracle  seed file missing: {seed_path}", file=sys.stderr)
        return 2

    seed_data = json.loads(seed_path.read_text(encoding="utf-8"))
    questions = seed_data.get("questions", [])
    answers_list = [solve_question(root, q) for q in questions]
    payload = {a["id"]: a for a in answers_list}

    out_path = args.out
    tmp_file = None
    if out_path is None:
        tmp_file = tempfile.NamedTemporaryFile("w", suffix=".json", delete=False, encoding="utf-8")
        json.dump(payload, tmp_file, indent=2)
        tmp_file.close()
        out_path = Path(tmp_file.name)
    else:
        out_path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")

    grade_rc = 0
    grade_stdout = ""
    if args.grade and grader_path.is_file():
        p = subprocess.run(
            [sys.executable, str(grader_path), "--root", str(root), "--set", str(seed_path), "--grade", str(out_path)],
            capture_output=True,
            text=True,
        )
        grade_rc = p.returncode
        grade_stdout = (p.stdout or "") + (p.stderr or "")

    if tmp_file is not None:
        Path(tmp_file.name).unlink(missing_ok=True)

    counts = {"answer": 0, "abstain": 0, "unmeasurable": 0}
    for a in answers_list:
        counts[a["disposition"]] = counts.get(a["disposition"], 0) + 1

    if args.json:
        print(
            json.dumps(
                {
                    "verdict": "PASS" if grade_rc == 0 else ("BLIND" if grade_rc == 2 else "FAIL"),
                    "total_questions": len(answers_list),
                    "dispositions": counts,
                    "gate_seed_exit_code": grade_rc,
                    "gate_seed_output": grade_stdout.strip(),
                    "answers": payload,
                },
                indent=2,
            )
        )
    else:
        if grade_stdout:
            print(grade_stdout.rstrip())
        status_word = "PASS" if grade_rc == 0 else ("BLIND" if grade_rc == 2 else "FAIL")
        print(
            f"{status_word:<8}estate-discovery-oracle  {len(answers_list)} questions solved "
            f"(answer={counts['answer']}, abstain={counts['abstain']}, unmeasurable={counts['unmeasurable']}) "
            f"gate_rc={grade_rc}"
        )
    return grade_rc


if __name__ == "__main__":
    raise SystemExit(main())
