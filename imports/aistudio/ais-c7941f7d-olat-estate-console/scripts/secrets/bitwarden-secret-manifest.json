{
  "schemaVersion": "genesis.secrets.bitwarden-sync.v1",
  "zeroSecretSprawlPolicy": "NEVER_COMMIT_SECRET_VALUES_ONLY_BITWARDEN_ITEM_NAMES",
  "targetGithubRepositories": [
    "chidionyema/argo-sync",
    "chidionyema/argon"
  ],
  "managedSecrets": [
    {
      "envVarName": "ARGO_SYNC_PAT",
      "bitwardenItemNames": ["ARGO_SYNC_PAT", "argo-sync-pat", "github-pat", "GITHUB_TOKEN"],
      "targetSurfaces": ["AI_STUDIO_SECRETS", "GITHUB_ACTIONS_REPO_SECRET"],
      "required": true,
      "purpose": "Fine-grained GitHub PAT (Contents & Secrets RW on chidionyema/argo-sync and chidionyema/argon) for zero-touch container pushes and cross-repo promotion."
    },
    {
      "envVarName": "ARGON_GITHUB_PAT",
      "bitwardenItemNames": ["ARGON_GITHUB_PAT", "ARGO_SYNC_PAT", "github-pat"],
      "targetSurfaces": ["AI_STUDIO_SECRETS", "GITHUB_ACTIONS_REPO_SECRET"],
      "required": false,
      "purpose": "Alias of ARGO_SYNC_PAT for chidionyema/argon headless mirroring."
    },
    {
      "envVarName": "GEMINI_API_KEY",
      "bitwardenItemNames": ["GEMINI_API_KEY", "gemini-api-key"],
      "targetSurfaces": ["GITHUB_ACTIONS_REPO_SECRET"],
      "required": false,
      "purpose": "Optional Gemini API key for CI evaluation workflows (auto-injected inside AI Studio)."
    },
    {
      "envVarName": "VITE_TELEGRAM_BOT_WEBHOOK_PUBLIC_KEY",
      "bitwardenItemNames": ["VITE_TELEGRAM_BOT_WEBHOOK_PUBLIC_KEY", "telegram-bot-ed25519-pubkey"],
      "targetSurfaces": ["AI_STUDIO_SECRETS", "GITHUB_ACTIONS_REPO_SECRET"],
      "required": false,
      "purpose": "Optional Ed25519 public key for live Telegram BotFather OTT command webhook."
    }
  ]
}
