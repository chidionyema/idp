#!/bin/sh
# estate api-port-guard PATH shim for launchctl: execvp callers skip shell functions, so they land here.
# Only a verdict (exit 2) refuses; any fault runs the real launchctl.
G="${ESTATE_GUARD:-$HOME/.estate/hooks/api-port-guard}"
if [ -r "$G" ]; then
    /usr/bin/python3 -I "$G" --argv launchctl "$@"
    [ $? -eq 2 ] && exit 1
fi
exec /bin/launchctl "$@"
