#!/usr/bin/env bash
# Render every C4 view in workspace.dsl and assemble the page the portal serves.
#
# No local install. structurizr/cli is EOL -- its own banner says so, and it exits 0
# while writing nothing, which is why this uses the consolidated image it points at.
#
# Two rules, both learned the hard way:
#
#   1. The closing fence goes on its OWN line. structurizr writes each .mmd WITHOUT a
#      trailing newline, so `cat "$f"` ends on "  end" and a bare `echo '```'` lands
#      glued to it -- "  end```". GitHub then reads the whole page as ONE unterminated
#      mermaid block and renders nothing. That is the bug this script's own output used
#      to have, on every view.
#   2. The view list is read FROM THE RENDER, never written out by hand. A hand-written
#      list is a promise about the bytes; a directory listing is a fact about them. A new
#      view in the model now appears on the page without anyone editing this script, and
#      a renamed view can never be silently dropped from the page.
#
# Usage:
#   architecture/render            render and write the page
#   architecture/render --check    exit 1 when the committed page is not what the model says
set -euo pipefail
here="$(cd "$(dirname "$0")" && pwd)"
out="$here/out"
page="$here/../docs/explanation/architecture/index.md"
mode="${1:-write}"

# Clear the previous render first. The view list below is read from this directory, so a
# .mmd left behind by a view that no longer exists would otherwise be embedded on the page
# as a ghost -- a diagram of something the model stopped declaring. This has to happen
# BEFORE the render, because the render writes into the same directory.
#
# But a FAILED render must not destroy the previous .mmd output: `rm -rf "$out"` before
# the render wiped it, so a render that could not run at all -- no docker, no image, no
# network -- left the tree with NO diagrams and the next reader saw an empty page
# instead of the last good one. The old output is kept until the new one exists, and it
# is restored if the render fails.
backup="$here/out.previous.$$"
rm -rf "$backup"
if [ -d "$out" ]; then
  mv "$out" "$backup"
fi
mkdir -p "$out"
restore_output() {
  status=$?
  if [ "$status" -ne 0 ] && [ -d "$backup" ]; then
    rm -rf "$out"
    mv "$backup" "$out"
  fi
  rm -rf "$backup"
  exit "$status"
}
trap restore_output EXIT

# The model contains non-ASCII characters (em dashes). Structurizr parses the workspace with
# the JVM's default charset, so a host whose locale is not UTF-8 fails with
# "StructurizrDslParserException: Input length = 1" -- which reads like a broken DSL and is
# not. Pin the locale for the render, and pass it INTO the container, so the page renders
# the same way on a laptop, in CI and in the cloud.
export LANG=C.UTF-8 LC_ALL=C.UTF-8

docker run --rm -e LANG=C.UTF-8 -e LC_ALL=C.UTF-8 -v "$here":/work -w /work structurizr/structurizr \
  export -workspace workspace.dsl -format mermaid -output /work/out >/dev/null

test -n "$(ls -A "$out"/*.mmd 2>/dev/null)" || { echo "render produced no diagrams"; exit 1; }

rm -rf "$backup"
trap - EXIT

# The views, in the order THE MODEL DECLARES THEM -- the C4 reading order (Context, then
# Containers, then the deployment views). A hand-written list is a promise about the bytes;
# the model's own declaration order is a fact about them. A new view in the model now
# reaches the page without anyone editing this script, and a renamed view can no longer be
# silently dropped from the page.
model_views=$(grep -oE '^[[:space:]]*(systemContext|container|component|deployment|dynamic)[[:space:]].*"[^"]*"[[:space:]]*\{' "$here/workspace.dsl" \
  | grep -oE '"[^"]*"[[:space:]]*\{$' | sed 's/"[[:space:]]*{$//; s/^"//; s/"$//' | tr '\n' ' ')
test -n "$model_views" || { echo "the model declares no views"; exit 1; }
for name in $model_views; do
  test -f "$out/structurizr-$name.mmd" || { echo "the model declares view $name but the render produced no $name.mmd"; exit 1; }
done
# And nothing may be on the page that the model does not declare.
for f in "$out"/structurizr-*.mmd; do
  name="$(basename "$f" .mmd)"; name="${name#structurizr-}"
  case " $model_views " in
    *" $name "*) ;;
    *) echo "the render produced view $name, which the model does not declare"; exit 1 ;;
  esac
done

render_page() {
  {
    echo "# Architecture"
    echo
    echo "Generated by \`architecture/render\` from \`architecture/workspace.dsl\`. Do not edit this"
    echo "file. Edit the model and run \`make diagrams\`."
    echo
    echo "The model is C4. Each heading below is one view of the same model, so the boxes cannot"
    echo "disagree with each other the way four hand-drawn pictures do."
    echo
    for name in $model_views; do
      f="$out/structurizr-$name.mmd"
      echo "## $name"
      echo
      echo '```mermaid'
      cat "$f"
      printf '\n'
      echo '```'
      echo
    done
    echo "Decision: [0002 - documentation is code and the portal renders it](../decisions/0002-documentation-is-code-and-the-portal-renders-it.md)"
  }
}

if [ "$mode" = "--check" ]; then
  if [ ! -f "$page" ]; then
    echo "FAIL architecture/render: $page is missing; run architecture/render"; exit 1
  fi
  if render_page | diff -u "$page" - > /tmp/architecture-render.diff 2>&1; then
    echo "ok    architecture/render: $page matches the model"
    exit 0
  fi
  echo "FAIL architecture/render: $page is not what architecture/workspace.dsl says; run architecture/render"
  sed -n '1,40p' /tmp/architecture-render.diff
  exit 1
fi

render_page > "$page"
echo "rendered $(echo "$model_views" | wc -w | tr -d ' ') views -> $page"
