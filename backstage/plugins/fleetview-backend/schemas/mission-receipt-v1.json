{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleetview.dev/schemas/mission-receipt-v1.json",
  "title": "Estate mission receipt v1",
  "description": "A read-only projection of ONE dispatched cloud mission (a GitHub-hosted `agent-sandbox` run), read from GitHub's own records. The receipt is not a ledger: nothing in it is stored, and every field can be re-derived from the linked sources. A consumer that needs to know whether the mission PRODUCED WORK, was epistemically GRADED and LANDED reads `verification.status`; a consumer that needs to know whether anything is OPERATIONAL reads `operational.status`, which is NOT VERIFIED until a live effect can be evidenced. A green run with no output is NOT VERIFIED, by design.",
  "type": "object",
  "required": [
    "schema",
    "instruction_id",
    "run",
    "model",
    "source_sha",
    "lane",
    "stage",
    "stages",
    "verification",
    "operational",
    "provenance",
    "freshness",
    "sources"
  ],
  "properties": {
    "schema": { "const": "estate.mission-receipt/1" },
    "instruction_id": {
      "type": ["string", "null"],
      "description": "The issue that carried the mission (the instruction of record). Null when no instruction could be read; the receipt then carries the code `instruction-unknown`.",
      "maxLength": 32
    },
    "instruction_url": {
      "type": ["string", "null"],
      "description": "Authoritative link to the instruction issue.",
      "maxLength": 300
    },
    "title": {
      "type": "string",
      "description": "The mission as the run's own title records it, truncated.",
      "maxLength": 300
    },
    "harness": {
      "type": ["string", "null"],
      "description": "The harness the run asked for (pi, claude-code, gemini). This is the REQUEST; `model.provider` is the one that actually ran.",
      "maxLength": 32
    },
    "run": {
      "type": "object",
      "description": "The GitHub Actions run: the canonical record of the mission.",
      "required": ["run_id", "url", "status", "conclusion"],
      "properties": {
        "run_id": { "type": ["integer", "null"] },
        "url": { "type": "string", "description": "The real runner/action URL.", "maxLength": 300 },
        "event": { "type": ["string", "null"], "maxLength": 32 },
        "status": { "type": "string", "enum": ["queued", "in_progress", "completed", "waiting", "requested", "pending"] },
        "conclusion": { "type": ["string", "null"], "maxLength": 32 },
        "head_sha": { "type": ["string", "null"], "description": "The exact source SHA the worker started from.", "maxLength": 64 },
        "created_at": { "type": ["string", "null"], "maxLength": 40 },
        "updated_at": { "type": ["string", "null"], "maxLength": 40 },
        "triggered_by": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "model": {
      "type": "object",
      "description": "The provider that ACTUALLY ran, and the model name only where it is evidenced.",
      "properties": {
        "provider": { "type": ["string", "null"], "maxLength": 32 },
        "provider_source": { "type": ["string", "null"], "maxLength": 200 },
        "name": { "type": ["string", "null"], "maxLength": 64 },
        "name_source": { "type": ["string", "null"], "maxLength": 200 },
        "fallback": { "type": "boolean" },
        "failed_provider": { "type": ["string", "null"], "maxLength": 32 },
        "failure_class": { "type": ["string", "null"], "maxLength": 64 },
        "name_unknown_reason": { "type": "string", "maxLength": 300 }
      }
    },
    "source_sha": {
      "type": ["string", "null"],
      "description": "The exact source SHA of the run (the commit the worker started from).",
      "maxLength": 64
    },
    "lane": {
      "type": "object",
      "description": "The lane the work reached, and the files it changed.",
      "properties": {
        "branch": { "type": ["string", "null"], "maxLength": 200 },
        "commit": { "type": ["string", "null"], "maxLength": 64 },
        "url": { "type": ["string", "null"], "maxLength": 300 },
        "files_changed": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "maxLength": 200 },
              "status": { "type": ["string", "null"], "maxLength": 32 },
              "additions": { "type": ["integer", "null"] },
              "deletions": { "type": ["integer", "null"] }
            }
          }
        }
      }
    },
    "stage": {
      "type": "string",
      "enum": ["queued", "started", "patch_produced", "cif_passed", "greenlane_landed", "live_effect"],
      "description": "The furthest stage the mission reached, with evidence."
    },
    "stages": {
      "type": "object",
      "description": "Every rung of the ladder, so a consumer sees what is still open.",
      "properties": {
        "queued": { "type": "boolean" },
        "started": { "type": "boolean" },
        "patch_produced": { "type": "boolean" },
        "cif_passed": { "type": "boolean" },
        "greenlane_landed": { "type": "boolean" },
        "live_effect": { "type": "boolean" }
      }
    },
    "stage_evidence": {
      "type": "object",
      "description": "Per stage, the source that put it there."
    },
    "verification": {
      "type": "object",
      "required": ["status", "codes", "reasons"],
      "properties": {
        "status": { "type": "string", "enum": ["VERIFIED", "NOT VERIFIED"] },
        "scope": { "type": "string", "maxLength": 300 },
        "codes": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string" },
          "description": "Machine-readable reasons, e.g. worker-did-not-start, no-output, firewall-refused, not-landed, conflict-run-succeeded-without-output, in-flight."
        },
        "reasons": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 300 } }
      }
    },
    "failure_class": {
      "type": ["string", "null"],
      "description": "The provider failure class, when one was evidenced (e.g. capacity-or-rate-limit).",
      "maxLength": 64
    },
    "recovery": {
      "type": "array",
      "maxItems": 20,
      "description": "What to do next, per reason: an executable door, not an intention.",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "maxLength": 80 },
          "why": { "type": "string", "maxLength": 300 },
          "next": {
            "type": "object",
            "properties": {
              "action": { "type": "string", "maxLength": 80 },
              "target": { "type": "string", "maxLength": 300 },
              "note": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "operational": {
      "type": "object",
      "description": "Whether anything is OPERATIONAL. A merge is not a live effect.",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["VERIFIED", "NOT VERIFIED"] },
        "code": { "type": "string", "maxLength": 80 },
        "reason": { "type": "string", "maxLength": 300 }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Ownership: the claim of record (role and scope) on the instruction issue.",
      "properties": {
        "role": { "type": ["string", "null"], "maxLength": 80 },
        "scope": { "type": ["array", "null"], "items": { "type": "string", "maxLength": 200 }, "maxItems": 50 },
        "claim_url": { "type": ["string", "null"], "maxLength": 300 },
        "claim_heartbeat": { "type": ["string", "null"], "maxLength": 40 },
        "claim_age_s": { "type": ["number", "null"] },
        "claim_live": { "type": ["boolean", "null"] },
        "claim_source": { "type": "string", "maxLength": 200 }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["read_at", "stale_after_s", "stale"],
      "properties": {
        "read_at": { "type": "string", "maxLength": 40 },
        "run_updated_at": { "type": ["string", "null"], "maxLength": 40 },
        "age_s": { "type": ["number", "null"] },
        "stale_after_s": { "type": "number" },
        "stale": { "type": "boolean" }
      }
    },
    "sources": {
      "type": "array",
      "description": "Every URL the receipt was read from, so any single claim can be checked.",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string", "maxLength": 40 },
          "url": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
