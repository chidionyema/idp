#!/usr/bin/env python3
"""crew#439 row 1: an open pull request armed for auto-merge that will never merge is a FAIL row.

idp#298 sat CONFLICTING for two hours with auto-merge armed and nothing said so; the branch push
workflow printed ok. That is what this row was written for, and it graded `mergeable`.

crew#516, 2026-08-28: it graded the wrong field, and the case it missed was the expensive one.
idp#486 -- flux/image-updates, the PR every image in this estate travels through -- was armed at
2026-08-27 20:57Z and MERGEABLE the whole time. It had no conflict. It had a required check that
could never go green: the branch was cut from an older main and ran 166 commits behind, so it
still carried ancestors whose leaking commits main had rewritten away, and `security-scan` reads
the whole history (`--log-opts=HEAD`) rather than the diff. GitHub reports that in
`mergeStateStatus`, never in `mergeable`, so this row printed `ok  0 stuck of 1 armed` for 12
hours while backstage, estate-mcp, sovereign-worker and hermes-agent stayed frozen on the images
they had -- including the hermes image whose missing `anthropic` extra was why The Architect
answered nobody on Telegram.

So the row asks the question it meant to ask: will this merge on its own? Auto-merge fires when
every required check passes. A check that has already CONCLUDED red will not pass without a push,
so an armed PR carrying one is stuck by definition -- no timer, and no false positive on a PR
whose checks are merely still running.

    ok      automerge-stuck  0 stuck of N armed
    FAIL    automerge-stuck  M stuck: #486 security-scan FAILURE, #298 CONFLICTING   -- exit 1
    BLIND   automerge-stuck  <why>                                                   -- exit 2, nothing graded

    bin/idp-automerge-stuck                 ask gh for the open pull requests of GITHUB_REPOSITORY (or this repo)
    bin/idp-automerge-stuck --input FILE    grade a `gh pr list --json ...` body on disk (the tests)
"""
from __future__ import annotations

import json
import os
import subprocess
import sys

ROW = "automerge-stuck"
FIELDS = "number,autoMergeRequest,mergeable,statusCheckRollup"

# A check in one of these states has finished and finished red. Auto-merge waits for a required
# check to pass, so one of these on an armed PR means the merge is waiting on a push that nobody
# has been told to make. PENDING/IN_PROGRESS (a null conclusion) is a PR that is simply still
# running, and SKIPPED/NEUTRAL satisfy a required check rather than blocking it.
RED = {"FAILURE", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE", "STALE"}


def live() -> list[dict]:
    repo = os.environ.get("GITHUB_REPOSITORY")
    cmd = ["gh", "pr", "list", "--state", "open", "--limit", "200",
           "--json", FIELDS] + (["-R", repo] if repo else [])
    try:
        return json.loads(subprocess.run(cmd, check=True, capture_output=True, text=True).stdout)
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        print(f"BLIND   {ROW}  gh pr list failed: {str(exc)[:200]}"); sys.exit(2)


def red_checks(pr: dict) -> list[str]:
    """The names of the checks that have concluded red on this PR, in the order gh returned them.

    A rollup entry is either a check run (name, conclusion) or a commit status (context, state);
    both shapes appear on the same PR, so both are read. An entry with neither name is reported
    under its conclusion alone rather than dropped -- a nameless red check is still a red check,
    and this estate's recorded failure mode is an allow-list with a silent miss case.
    """
    out = []
    for c in pr.get("statusCheckRollup") or []:
        if not isinstance(c, dict):
            continue
        state = (c.get("conclusion") or c.get("state") or "").upper()
        if state in RED:
            out.append(f"{c.get('name') or c.get('context') or '(unnamed)'} {state}")
    return out


def why_stuck(pr: dict) -> str | None:
    """Why this armed PR will not merge on its own, or None when nothing says it is stuck."""
    if pr.get("mergeable") != "MERGEABLE":
        return str(pr.get("mergeable"))
    red = red_checks(pr)
    return ", ".join(red) if red else None


def grade(prs: list[dict]) -> int:
    armed = [p for p in prs if p.get("autoMergeRequest")]
    stuck = [(p, w) for p in armed if (w := why_stuck(p))]
    if stuck:
        print(f"FAIL    {ROW}  {len(stuck)} stuck: "
              + ", ".join(f"#{p['number']} {w}" for p, w in stuck))
        return 1
    print(f"ok      {ROW}  0 stuck of {len(armed)} armed")
    return 0


def main() -> int:
    if "--input" in sys.argv:
        with open(sys.argv[sys.argv.index("--input") + 1], encoding="utf-8") as fh:
            return grade(json.load(fh))
    return grade(live())


if __name__ == "__main__":
    sys.exit(main())
