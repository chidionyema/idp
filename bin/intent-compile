#!/usr/bin/env python3
"""The deterministic estate compiler (Diamond Standard, founder 2026-09-01).

Agents no longer write configuration files. They emit typed JSON intents (schema/intent/*.schema.json)
whose vocabulary contains no estate name: no zone, no registry, no provider, no namespace layout.
This compiler — plain Python, no model anywhere in it — merges an intent with the founder's DNA
(the data: block of clusters/*/estate-config.yaml) and emits the manifests. Change the DNA, run the
compiler, and every compiled workload follows; the agents never notice.

Founder doc: ~/.claude/docs/founder/2026-09-01T2155Z-you-caught-me-i-was-being-a-yes-f37912bc.md and
2026-09-01T2210Z-diamond-standard-jit-estate-compiler.md. Decision record:
docs/decisions/2026-09-01-diamond-standard-jit-compiler.md.

The `secret` capability (founder 2026-09-08: "we need to standardise, dont like these half baked
inconsistent solutions ... we need to be enterprise ready yesterday") is why there is no per-workload
hand-written .tf for a credential any more. One intent names the workload and the key; the compiler
decides the vault entry, the ExternalSecret, the birth path and the row in the root-trust register,
so a credential cannot be added without the register learning about it in the same commit. A secret
VALUE never appears in an intent -- there is no field for one, and a generated credential is born
inside OpenTofu where no human reads it (LAW 21, R52).

Three refusals, in order:
  1. an intent with vocabulary outside its schema (additionalProperties: false) — "provider",
     "dns_zone", anything — is refused naming the field;
  2. an intent that SPEAKS any DNA value (the zone, the registry, an endpoint) anywhere in its
     text is refused: blindness is checked, not assumed;
  3. an intent whose capability has no schema is refused.
Output is deterministic: sorted keys, no timestamps; bin/idp-ci proves two runs byte-identical.
Emitted manifests reference estate values only as ${ESTATE_*} for Flux postBuild to substitute,
so the compiled files themselves stay estate-name-free and estate-zone-gate-clean by construction.
Exit 0 compiled, 1 refused, 2 BLIND (no DNA found).
"""

import argparse
import json
import pathlib
import sys

import jsonschema
import yaml

HERE = pathlib.Path(__file__).resolve().parents[1]
HDR = "# generated by bin/intent-compile from {src} -- do not edit; edit the intent (crew#804)\n"
SIZES = {
    "s": ({"cpu": "50m", "memory": "64Mi"}, {"cpu": "200m", "memory": "256Mi"}),
    "m": ({"cpu": "100m", "memory": "128Mi"}, {"cpu": "500m", "memory": "512Mi"}),
    "l": ({"cpu": "250m", "memory": "256Mi"}, {"cpu": "1000m", "memory": "1Gi"}),
}


def load_dna(root: pathlib.Path) -> dict[str, str]:
    dna: dict[str, str] = {}
    for f in sorted((root / "clusters").rglob("estate-config.yaml")):
        doc = yaml.safe_load(f.read_text())
        dna.update({k: str(v) for k, v in (doc or {}).get("data", {}).items()})
    return dna


def load_schemas(root: pathlib.Path) -> dict[str, dict]:
    out = {}
    for f in sorted((root / "schema" / "intent").glob("*.schema.json")):
        s = json.loads(f.read_text())
        out[s["properties"]["capability"]["const"]] = s
    return out


def spoken_dna(text: str, dna: dict[str, str]) -> list[str]:
    """DNA values the intent text speaks. Values under 6 chars are skipped: 'oci' is a substring
    of ordinary words, and a check that fires on noise is a fence that refuses correct work."""
    low = text.lower()
    return sorted(k for k, v in dna.items() if len(v) >= 6 and v.lower() in low)


def dump(path: pathlib.Path, doc: dict, src: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    body = yaml.safe_dump(doc, sort_keys=True, default_flow_style=False, width=100)
    path.write_text(HDR.format(src=src) + body)


def compile_workload(i: dict, out: pathlib.Path, src: str) -> list[str]:
    name, ns = i["name"], i["name"]
    labels = {"app.kubernetes.io/name": name, "app.kubernetes.io/part-of": "idp"}
    req, lim = SIZES[i.get("size", "s")]
    env = [{"name": "OTEL_EXPORTER_OTLP_ENDPOINT", "value": "${OTLP_ENDPOINT}"},
           {"name": "OTEL_SERVICE_NAME", "value": name}]
    env += [{"name": k, "value": v} for k, v in sorted(i.get("env", {}).items())]
    port = i.get("port", 8080)
    container = {
        "name": name,
        "image": "${ESTATE_REGISTRY}/" + i["component"],
        "ports": [{"name": "http", "containerPort": port}],
        "env": env,
        "resources": {"requests": req, "limits": lim},
        "securityContext": {
            "allowPrivilegeEscalation": False,
            "readOnlyRootFilesystem": True,
            "capabilities": {"drop": ["ALL"]},
        },
    }
    dump(out / name / "deployment.yaml", {
        "apiVersion": "apps/v1", "kind": "Deployment",
        "metadata": {"name": name, "namespace": ns, "labels": labels,
                     "annotations": {"reloader.stakater.com/auto": "true"}},
        "spec": {
            "replicas": max(2, i.get("replicas", 2)),
            "strategy": {"type": "RollingUpdate",
                         "rollingUpdate": {"maxUnavailable": 0, "maxSurge": 1}},
            "selector": {"matchLabels": {"app.kubernetes.io/name": name}},
            "template": {
                "metadata": {"labels": labels},
                "spec": {
                    "automountServiceAccountToken": False,
                    "imagePullSecrets": [{"name": "ghcr-pull"}],
                    "securityContext": {"runAsNonRoot": True, "runAsUser": 10001,
                                        "runAsGroup": 10001,
                                        "seccompProfile": {"type": "RuntimeDefault"}},
                    "topologySpreadConstraints": [{
                        "maxSkew": 1, "topologyKey": "kubernetes.io/hostname",
                        "whenUnsatisfiable": "DoNotSchedule",
                        "labelSelector": {"matchLabels": {"app.kubernetes.io/name": name}},
                    }],
                    "containers": [container],
                },
            },
        },
    }, src)
    dump(out / name / "service.yaml", {
        "apiVersion": "v1", "kind": "Service",
        "metadata": {"name": name, "namespace": ns, "labels": labels},
        "spec": {"selector": {"app.kubernetes.io/name": name},
                 "ports": [{"name": "http", "port": port, "targetPort": port}]},
    }, src)
    files = ["deployment.yaml", "service.yaml"]
    if "public_host" in i:
        dump(out / name / "httproute.yaml", {
            "apiVersion": "gateway.networking.k8s.io/v1", "kind": "HTTPRoute",
            "metadata": {"name": name, "namespace": ns, "labels": labels},
            "spec": {
                "parentRefs": [{"name": "prospector-edge", "namespace": "prospector"}],
                "hostnames": [i["public_host"] + ".${ESTATE_ZONE}"],
                "rules": [{"matches": [{"path": {"type": "PathPrefix", "value": "/"}}],
                           "backendRefs": [{"name": name, "port": port}]}],
            },
        }, src)
        files.append("httproute.yaml")
    dump(out / name / "kustomization.yaml", {
        "apiVersion": "kustomize.config.k8s.io/v1beta1", "kind": "Kustomization",
        "namespace": ns, "resources": sorted(files),
    }, src)
    return [f"{name}/{f}" for f in sorted(files) + ["kustomization.yaml"]]


def compile_storage(i: dict, out: pathlib.Path, src: str, dna: dict[str, str]) -> list[str]:
    provider = dna.get("ESTATE_STORAGE_PROVIDER", "")
    if provider != "oci":
        raise SystemExit(f"BLIND: ESTATE_STORAGE_PROVIDER={provider!r} has no storage backend yet")
    access = {"private": "NoPublicAccess", "public-read": "ObjectRead"}[i.get("access", "private")]
    tf = (
        HDR.format(src=src)
        + "# Self-contained module: the founder wires it into an apply he runs (agents never\n"
        + "# deploy, permanent ruling 2026-09-01). Flipping ESTATE_STORAGE_PROVIDER in the DNA\n"
        + "# recompiles this to the new provider; the stored bytes still need a copy job.\n"
        + 'variable "compartment_ocid" { type = string }\n'
        + 'data "oci_objectstorage_namespace" "ns" {}\n'
        + f'resource "oci_objectstorage_bucket" "{i["name"]}" {{\n'
        + "  compartment_id = var.compartment_ocid\n"
        + f'  name           = "{i["name"]}"\n'
        + "  namespace      = data.oci_objectstorage_namespace.ns.namespace\n"
        + f'  access_type    = "{access}"\n'
        + f'  freeform_tags  = {{ purpose = "{i["purpose"]}", size_gb = "{i["size_gb"]}" }}\n'
        + "}\n"
    )
    path = out / i["name"] / "storage.tf"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(tf)
    return [f"{i['name']}/storage.tf"]


REGISTER_OPEN = ("<!-- compiled-intent-rows: written by bin/intent-compile from intents/*.json. "
                 "Do not edit these rows; edit the intent and re-run. -->")
REGISTER_SHUT = "<!-- /compiled-intent-rows -->"
# bin/idp-root-trust accepts a MEETS row whose last cell names a file under bin/, or one of its two
# in-estate birth paths. A vendor credential is written once by the estate's vendor bootstrapper; a
# generated one is born by the OpenTofu this compiler emits and no human is ever shown it.
BIRTH = {
    "vendor": ("Supplier", "`bin/idp-bootstrap-vendors`"),
    "generated": ("Operator", "Terraform `oci_vault_secret`, compiled from `{src}`"),
}


def compile_secret(i: dict, out: pathlib.Path, src: str, dna: dict[str, str]) -> list[str]:
    """A credential's three halves, from one intent: where it is born, how the cluster reads it,
    and the register row that makes bin/idp-root-trust able to see it."""
    provider = dna.get("ESTATE_STORAGE_PROVIDER", "")
    origin = i.get("origin", "vendor")
    if origin == "generated" and provider != "oci":
        raise SystemExit(f"BLIND: ESTATE_STORAGE_PROVIDER={provider!r} has no vault backend yet")
    name, ns = i["name"], i["workload"]
    keys = sorted(i["keys"], key=lambda k: k["key"])
    files = ["external-secret.yaml"]
    # Kyverno refuses a secret in an env var (platform/edge/kyverno-secrets-policy.yaml), so the
    # compiled Secret exists to be mounted; the consumer reads <KEY>_FILE, the estate's convention.
    dump(out / name / "external-secret.yaml", {
        "apiVersion": "external-secrets.io/v1", "kind": "ExternalSecret",
        "metadata": {"name": name, "namespace": ns,
                     "labels": {"app.kubernetes.io/name": ns, "app.kubernetes.io/part-of": "idp"}},
        "spec": {
            "refreshInterval": "1h",
            "secretStoreRef": {"kind": "ClusterSecretStore", "name": "estate-vault"},
            "target": {"name": name, "creationPolicy": "Owner"},
            "data": [{"secretKey": k["key"], "remoteRef": {"key": name, "property": k["key"]}}
                     for k in keys],
        },
    }, src)
    if origin == "generated":
        rot = i.get("rotation_days", 90)
        tf = [HDR.format(src=src),
              "# Self-contained module: the founder wires it into an apply he runs (agents never\n"
              "# deploy, permanent ruling 2026-09-01). The value is minted here and read by nobody:\n"
              "# no console step, no founder paste, no key in a transcript (R52, LAW 21).\n",
              'variable "vault_ocid" { type = string }',
              'variable "key_ocid" { type = string }', ""]
        for k in keys:
            slug = k["key"].lower().replace("_", "-")
            tf += [f'resource "random_password" "{slug}" {{',
                   "  length  = 48",
                   "  special = false",
                   "}", "",
                   f'resource "oci_vault_secret" "{slug}" {{',
                   "  compartment_id = var.compartment_ocid",
                   "  vault_id       = var.vault_ocid",
                   "  key_id         = var.key_ocid",
                   f'  secret_name    = "{name}-{slug}"',
                   "  secret_content {",
                   '    content_type = "BASE64"',
                   f"    content      = base64encode(random_password.{slug}.result)",
                   "  }",
                   f'  freeform_tags = {{ workload = "{ns}", rotation_days = "{rot}" }}',
                   "}", ""]
        tf.insert(4, 'variable "compartment_ocid" { type = string }')
        path = out / name / "secret.tf"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text("\n".join(tf).replace("\n\n\n", "\n\n"))
        files.append("secret.tf")
    dump(out / name / "kustomization.yaml", {
        "apiVersion": "kustomize.config.k8s.io/v1beta1", "kind": "Kustomization",
        "namespace": ns, "resources": ["external-secret.yaml"],
    }, src)
    return [f"{name}/{f}" for f in sorted(files) + ["kustomization.yaml"]]


def register_row(i: dict, src: str) -> str:
    """The row bin/idp-root-trust grades. Emitting it here is the point: a credential cannot be
    added to the estate without the register learning about it in the same commit."""
    origin = i.get("origin", "vendor")
    owner, birth = BIRTH[origin]
    consumer = f"platform/compiled/{i['name']}/external-secret.yaml"
    provider = "vendor" if origin == "vendor" else "estate"
    how = ("issued by the vendor, written once into the vault by the estate's vendor bootstrapper"
           if origin == "vendor" else
           "minted inside OpenTofu and never shown to a person")
    return (f"| `{i['name']}` | {consumer} | {provider} | {owner} | {how}; "
            f"rotation {i.get('rotation_days', 90)}d | MEETS | {birth.format(src=src)} |")


def write_register(path: pathlib.Path, rows: list[str]) -> None:
    """Idempotent: the block is replaced whole, rows sorted, so two runs are byte-identical."""
    block = "\n".join([REGISTER_OPEN] + sorted(rows) + [REGISTER_SHUT])
    text = path.read_text() if path.is_file() else ""
    if REGISTER_OPEN in text and REGISTER_SHUT in text:
        head = text[:text.index(REGISTER_OPEN)]
        tail = text[text.index(REGISTER_SHUT) + len(REGISTER_SHUT):]
        text = head + block + tail
    else:
        text = (text.rstrip("\n") + "\n\n" + block + "\n") if text else block + "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--intents", default=str(HERE / "intents"), help="directory of *.json intents")
    ap.add_argument("--out", default=str(HERE / "platform" / "compiled"))
    ap.add_argument("--dna", default=str(HERE), help="checkout holding clusters/*/estate-config.yaml")
    ap.add_argument("--register", default=str(HERE / "docs" / "reference" / "policy" / "root-trust.md"),
                    help="root-trust register the secret rows are written into, between markers")
    a = ap.parse_args()
    dna = load_dna(pathlib.Path(a.dna))
    if not dna.get("ESTATE_ZONE"):
        print("BLIND: no clusters/*/estate-config.yaml with ESTATE_ZONE under " + a.dna)
        return 2
    schemas = load_schemas(HERE)
    intents = sorted(pathlib.Path(a.intents).glob("*.json"))
    if not intents:
        print(f"BLIND: no *.json intents in {a.intents}")
        return 2
    refused, emitted, rows = 0, [], []
    for f in intents:
        text = f.read_text()
        i = json.loads(text)
        cap = i.get("capability", "")
        if cap not in schemas:
            print(f"REFUSED {f.name}: capability {cap!r} has no schema; the vocabulary does not exist")
            refused += 1
            continue
        errs = sorted(jsonschema.Draft202012Validator(schemas[cap]).iter_errors(i),
                      key=lambda e: str(e.path))
        if errs:
            for e in errs:
                where = ".".join(str(p) for p in e.path) or "(root)"
                print(f"REFUSED {f.name}: {where}: {e.message}")
            refused += 1
            continue
        spoken = spoken_dna(text, dna)
        if spoken:
            print(f"REFUSED {f.name}: speaks estate DNA ({', '.join(spoken)}); "
                  "agents are blind to those values, the compiler injects them")
            refused += 1
            continue
        out = pathlib.Path(a.out)
        if cap == "workload":
            emitted += compile_workload(i, out, f.name)
        elif cap == "storage":
            emitted += compile_storage(i, out, f.name, dna)
        elif cap == "secret":
            emitted += compile_secret(i, out, f.name, dna)
            rows.append(register_row(i, f.name))
        else:
            raise SystemExit(f"BLIND: capability {cap!r} has a schema and no emitter")
    if rows:
        write_register(pathlib.Path(a.register), rows)
    verdict = "FAIL" if refused else "ok"
    print(f"{verdict}    intent   {len(intents) - refused} intent(s) compiled to {a.out} "
          f"({len(emitted)} file(s)), {len(rows)} register row(s), {refused} refused")
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main())
