#!/usr/bin/env python3
"""idp-jit -- how an agent asks for ten minutes of write access, and how it waits.

WJ.2 says an agent that hits the wall "does not fail and it does not report back". This is
the command that makes that true: it blocks until the founder taps, then either performs
nothing (because the broker already did the change) or hands back a token that dies on its
own. WJ.12 is the other half -- when the approved action makes things worse, the failure
comes back here in words, so the agent does not ask for the same grant twice.

    idp-jit ask --grant raise-memory-limit --namespace backstage \
                --workload backstage --memory 2Gi \
                --why "the Backstage pod is OOM crashing" --ttl 10m

The layers below Kubernetes work the same way and read the same way (WJ.15); they only ever
hand back an outcome, never a credential, so there is nothing to export afterwards:

    idp-jit ask --grant oci-scale-node-pool --node_pool "$POOL" --size 5 \
                --why "nothing will schedule; the pool is full" --ttl 10m

    idp-jit grants        every grant, its layer and what it takes

Both `ask` and `identity` present the same one secret this device holds, JIT_AGENT_KEY, and
the broker refuses either door without it. It is not what buys the access -- only the
founder's tap does that -- it is what says the ask came from an agent of this estate at all,
so that the name he reads on his phone is worth reading.

Exit codes are the contract: 0 granted, 3 denied, 4 refused before he was asked, 5 the
approved change failed, 6 he never answered. Anything an agent scripts around can tell
those apart without parsing English.
"""

from __future__ import annotations

import argparse
import glob
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

IN_CLUSTER = "http://jit-broker.jit.svc.cluster.local:8080"
# The hostname platform/jit/deployment.yaml gives the broker's tailnet device
# (`tailscale.com/hostname`). The two must agree or the lookup below finds nothing.
TAILNET_HOSTNAME = "jit-broker"
# What the edge puts in front of every path on the public door, and what serve.py strips back
# off. One value, here and in platform/jit/public-door.yaml; the test grades that they agree.
PUBLIC_PREFIX = "/jit"
# Every parameter any grant in platform/jit/grants.yaml declares, so the agent can write
# --namespace rather than --param namespace=. WJ.15 added the three layers below Kubernetes,
# and their parameters are here for the same reason.
KNOWN_PARAMS = (
    "namespace", "workload", "memory", "tag", "pod",
    "node_pool", "size", "record", "record_type", "target", "repository", "run_id",
)
CODES = {"granted": 0, "denied": 3, "refused": 4, "failed": 5, "timeout": 6}


def _tailnet_door() -> str | None:
    """The broker's address on the tailnet, asked of the local daemon rather than written down.

    A literal here would name this estate's tailnet domain, which is a machine fact and exactly
    what LAW 46 keeps out of files; `tailscale status --json` already knows it. No tailscale
    client, no daemon, or no such peer all mean the same thing -- there is no tailnet door from
    here -- and all answer None rather than raising, because a laptop that is simply not on the
    tailnet is the ordinary case and not an error.
    """
    exe = shutil.which("tailscale")
    if exe is None:
        return None
    try:
        out = subprocess.run([exe, "status", "--json"], capture_output=True, text=True,
                             timeout=10, check=True).stdout
        peers = (json.loads(out).get("Peer") or {}).values()
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError, AttributeError):
        return None
    for peer in peers:
        name = (peer.get("DNSName") or "").rstrip(".")
        if name and name.split(".", 1)[0] == TAILNET_HOSTNAME:
            return f"http://{name}:8080"
    return None


def _estate_zone() -> str | None:
    """The estate's DNS zone, read from the one place it is written.

    a literal here would name this estate's machine facts in a file, and
    `bin/estate-zone-gate` refuses exactly that. ESTATE_ZONE first, because an agent on a
    cloud runner has no checkout of this repository and the environment is all it has; then
    clusters/*/estate-config.yaml, which is where the value actually lives.
    """
    from_env = os.environ.get("ESTATE_ZONE")
    if from_env:
        return from_env.strip() or None
    root = os.environ.get("IDP_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    for name in sorted(glob.glob(os.path.join(root, "clusters", "*", "estate-config.yaml"))):
        try:
            with open(name) as fh:
                for line in fh:
                    key, _, value = line.strip().partition(":")
                    if key == "ESTATE_ZONE" and value.strip():
                        return value.strip()
        except OSError:
            continue
    return None


def _public_door() -> str | None:
    """The broker's address from anywhere, over the estate's own front door.

    The shared Gateway listener carries one hostname, `otto.${ESTATE_ZONE}`, and this broker
    does not get one of its own -- so the route is a path prefix on that host and the broker
    strips it (platform/jit/public-door.yaml, and Handler.public_prefix in serve.py). Last of
    the three doors on purpose: in-cluster and tailnet both stay inside the estate, and this
    one crosses the public internet to reach the same port. What makes crossing it acceptable
    is that every door behind it takes the agent key, so a stranger who finds the URL gets a
    401 and learns nothing -- not which grants exist, not whether a request id is real.
    """
    zone = _estate_zone()
    return f"https://otto.{zone}{PUBLIC_PREFIX}" if zone else None


def _doors() -> list[str]:
    """Every address the broker might answer on, nearest first.

    Two of them, and the second is why this function exists. Inside the cluster the Service
    name resolves and nothing more is needed. Outside it -- which is where the agents actually
    run -- that name resolves to nothing, and until 2026-09-07 there was no second address at
    all: platform/jit/fence.yaml admitted namespaces `agents` and `edge`, and the public route
    carries the Telegram webhook alone (`POST https://otto.${ESTATE_ZONE}/ask` answered 404,
    measured that day). So an agent on the founder's Mac could not ask for a grant, and one
    did not: the CNI cutover needed 97 pods restarted, `restart-workload` in grants.yaml is
    exactly that grant, and there was no reachable way to request it. That is the wall WJ.2
    says an agent asks its way through, with no door to ask at.

    JIT_BROKER_URL, when set, is the only address tried: a caller that named one meant it, and
    silently falling through to another broker would be the worst kind of helpful.
    """
    named = os.environ.get("JIT_BROKER_URL")
    if named:
        return [named]
    return [IN_CLUSTER] + [d for d in (_tailnet_door(), _public_door()) if d]


def _post(path: str, body: dict, headers: dict | None = None) -> tuple[int, dict]:
    # Every door the broker answers takes the agent key -- ask, state, grants and identity --
    # so it is attached here rather than at four call sites, and a caller that named its own
    # Authorization header still wins. A device with no key sends none and is refused, which
    # is what a device with no key should be.
    key = _agent_key()
    if key and not (headers or {}).get("Authorization"):
        headers = {"Authorization": f"Bearer {key}", **(headers or {})}
    tried = []
    for door in _doors():
        req = urllib.request.Request(door + path, data=json.dumps(body).encode(),  # noqa: S310 -- an http URL from the environment or the local tailscale daemon
                                     headers={"Content-Type": "application/json", **(headers or {})})
        try:
            with urllib.request.urlopen(req, timeout=30) as fh:  # noqa: S310 -- same request object, already constrained
                return fh.status, json.load(fh)
        except urllib.error.HTTPError as exc:
            # The broker answered. A 4xx is its verdict and belongs to the caller; trying the
            # next door would ask a different broker the same question and report whichever
            # one happened to be kinder.
            return exc.code, json.loads(exc.read() or b"{}")
        except OSError as exc:
            tried.append(f"{door} ({exc})")
    # The broker being unreachable is the ordinary case on a laptop and during a rollout, and
    # it is not the agent's mistake. A stack trace here reads as a bug in the caller and
    # teaches nothing; the exit code says "refused before he was asked", which is the truth --
    # the founder was never woken.
    return 0, {
        "unreachable": True,
        "reason": "the broker is not answering on " + ", ".join(tried),
    }


def _get(path: str) -> tuple[int, dict]:
    """A keyless GET, for the one door that has no key yet: /enroll/nonce.

    Kept separate from `_post` rather than folding a `key_optional` flag into it, so the ask
    path -- which MUST carry a key -- cannot accidentally be reached without one by a caller
    that wanted the nonce door. A device with no key has exactly one thing it may fetch, and
    this is it.
    """
    tried = []
    for door in _doors():
        req = urllib.request.Request(door + path)  # noqa: S310 -- an http URL from the environment or the local tailscale daemon
        try:
            with urllib.request.urlopen(req, timeout=30) as fh:  # noqa: S310 -- same request object, already constrained
                return fh.status, json.load(fh)
        except urllib.error.HTTPError as exc:
            return exc.code, json.loads(exc.read() or b"{}")
        except OSError as exc:
            tried.append(f"{door} ({exc})")
    return 0, {"unreachable": True, "reason": "the broker is not answering on " + ", ".join(tried)}


def _age_secret():
    """The estate age identity as an X25519 private key, from SOPS_AGE_KEY_FILE or the default path.

    The file holds a native age identity (`AGE-SECRET-KEY-1...`), which is bech32 over the
    32-byte X25519 scalar. This decodes it and hands back the private key object; the secret is
    never printed and never leaves this process. Raises RuntimeError with a reason a person can
    act on, because "no age key" at enrollment is the one failure the person still owns (Level 1
    of bin/idp-workstation-bootstrap).
    """
    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey

    path = os.environ.get("SOPS_AGE_KEY_FILE") or os.path.expanduser("~/.config/prospector/age-key.txt")
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError as exc:
        raise RuntimeError(f"no age identity at {path}; restore it before enrolling ({exc})") from None

    chi = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("AGE-SECRET-KEY-1"):
            continue
        body = line[len("AGE-SECRET-KEY-1"):].lower()
        try:
            values = [chi.index(c) for c in body]
        except ValueError:
            break
        out = bytearray()
        acc = bits = 0
        for v in values[:-6]:  # the trailing six groups are the bech32 checksum
            acc = (acc << 5) | v
            bits += 5
            while bits >= 8:
                bits -= 8
                out.append((acc >> bits) & 0xFF)
        if len(out) == 32:
            return X25519PrivateKey.from_private_bytes(bytes(out))
        break
    raise RuntimeError(f"no native age identity in {path}; enrollment reads the AGE-SECRET-KEY-1 line")


def enroll() -> int:
    """Trade this device's age identity for a key of its own, then write it where _agent_key reads.

    This is the door a fresh machine uses, and the only one it can use: every other door takes
    the key this one mints. The proof is an X25519 agreement, not a signature -- a native age
    key has no signing half -- and the age secret never leaves the device.
    """
    try:
        secret = _age_secret()
    except RuntimeError as exc:
        print(f"BLOCKED  {exc}", file=sys.stderr)
        return CODES["refused"]

    code, nonce = _get("/enroll/nonce")
    if nonce.get("unreachable"):
        print(f"BLOCKED  {nonce['reason']}", file=sys.stderr)
        return CODES["refused"]
    if code != 200 or not nonce.get("nonce"):
        print(f"refused: the broker would not hand out a nonce ({code})", file=sys.stderr)
        return CODES["refused"]

    import hashlib
    import hmac as _hmac

    from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PublicKey

    ephemeral = bytes.fromhex(nonce["ephemeral"])
    shared = secret.exchange(X25519PublicKey.from_public_bytes(ephemeral))
    proof = {
        "nonce": nonce["nonce"],
        "ephemeral": ephemeral.hex(),
        "mac": _hmac.new(shared, nonce["nonce"].encode(), hashlib.sha256).hexdigest(),
    }
    # No Authorization header: this device holds no key. _post would attach one if it had it,
    # and sending a stale key here would be harmless but misleading in a log.
    code, body = _post("/enroll", proof, {"Authorization": ""})
    if body.get("unreachable"):
        print(f"BLOCKED  {body['reason']}", file=sys.stderr)
        return CODES["refused"]
    if code != 200 or not body.get("key"):
        print(f"refused: {body.get('error', 'the broker did not accept this device')}",
              file=sys.stderr)
        return CODES["refused"]

    state = os.environ.get("IDP_KUBE_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "idp")
    out = os.path.join(state, "agent-key")
    os.makedirs(state, mode=0o700, exist_ok=True)
    fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        os.write(fd, (body["key"] + "\n").encode())
    finally:
        os.close(fd)
    print(f"enrolled; this device now holds its own key ({body['fingerprint']}) at {out}",
          file=sys.stderr)
    return 0


def _agent_key() -> str | None:
    """The one secret a device holds. Environment first, then a file mode 600 under the same
    state directory bin/idp-kube caches in.

    Something has to be the root and no design removes that. What the estate gets for this
    one is the difference between a device that can read this cluster for an hour and a
    device that can administer the tenancy: before WJ.1 the second was what sat on the
    laptop, as an OCI API key with no expiry at all.
    """
    from_env = os.environ.get("JIT_AGENT_KEY")
    if from_env:
        return from_env
    state = os.environ.get("IDP_KUBE_STATE") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "idp")
    try:
        with open(os.path.join(state, "agent-key")) as fh:
            return fh.read().strip() or None
    except OSError:
        return None


def _kubeconfig_path() -> str:
    """Where the agent kubeconfig lives. One path, so every reader agrees on the state."""
    return os.environ.get("IDP_AGENT_KUBECONFIG") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
        "idp", "agent.kubeconfig")


def _token_expiry(path: str) -> float | None:
    """When the token in this kubeconfig dies, as a unix timestamp, or None.

    Read from the JWT's own `exp` claim rather than from a file mtime, because the file is
    rewritten on renewal and an mtime would report the renewal, not the expiry. A token that
    cannot be parsed is reported as None (unknown), never as expired -- guessing a security
    state is the one thing worse than not showing it.
    """
    import base64
    import time as _time
    try:
        with open(path) as fh:
            doc = json.load(fh)
        tok = (doc.get("users") or [{}])[0].get("user", {}).get("token", "")
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        claims = json.loads(base64.urlsafe_b64decode(payload))
        exp = claims.get("exp")
        return float(exp) if exp else None
    except Exception:  # noqa: BLE001 - an unreadable token is 'unknown', not an exception
        return None


def _status() -> int:
    """What this device's access is, as JSON. Never mints, never writes, never needs a tap.

    This is the one command the portal tile reads. It answers in the only three states a
    reader has to distinguish, and it answers them WITHOUT contacting the broker when the
    key is absent -- a device that holds no key is not provisioned, full stop, and a status
    call that needs the network to say so would be a status call that lies when offline.

      not_provisioned -- no agent key on this device. Only the owner can fix this, once.
      active          -- key present AND a live token with time left on it.
      expiring        -- live token, under 10 minutes left; the daemon's cue to renew.
      expired         -- key present, token dead or unreadable. One renew fixes it.
    """
    import time as _time

    key = _agent_key()
    kc = _kubeconfig_path()
    exp = _token_expiry(kc)
    now = _time.time()

    if not key:
        state = "not_provisioned"
    elif exp is None:
        state = "expired" if os.path.exists(kc) else "not_provisioned"
    elif exp <= now:
        state = "expired"
    elif exp - now < 600:
        state = "expiring"
    else:
        state = "active"

    out = {
        "state": state,
        "scope": "read-only",
        "subject": "system:serviceaccount:agents:agent-reader",
        "has_key": bool(key),
        "kubeconfig": kc,
        "expires_at": exp,
        "expires_in": (int(exp - now) if exp else None),
    }
    print(json.dumps(out))
    return 0


def _renew(path: str, quiet: bool) -> int:
    """Mint a fresh token and rewrite the kubeconfig. The zero-touch path.

    Deliberately the same `_identity()` the interactive path uses, so the daemon, the tile's
    Renew button and a human at a terminal all exercise one piece of code. A second renewal
    implementation is a second place for the identity check to drift.
    """
    rc = _identity(path)
    if rc == 0 and quiet:
        return 0
    if rc == 0:
        print(f"renewed {path}")
    return rc


def _identity(path: str | None) -> int:
    """WJ.1's client half: become an agent of this estate without the founder's credential.

    What comes back is everything a device needs to reach the cluster and nothing more --
    a one-hour read-only token, the API address, and the CA. No `oci` CLI, no founder login,
    no laptop. Written as a kubeconfig here rather than parsed in shell so that exactly one
    place in the estate knows the shape of the file.
    """
    key = _agent_key()
    if not key:
        print("BLOCKED  this device holds no agent key. Set JIT_AGENT_KEY, or put it in "
              "$XDG_STATE_HOME/idp/agent-key", file=sys.stderr)
        return CODES["refused"]
    code, body = _post("/identity", {}, {"Authorization": f"Bearer {key}"})
    if body.get("unreachable"):
        print(f"BLOCKED  {body['reason']}", file=sys.stderr)
        return CODES["refused"]
    if code != 200:
        print(f"refused: {body.get('error', 'the broker would not identify this device')}",
              file=sys.stderr)
        return CODES["refused"]
    if not path:
        print(body["token"])
        return 0
    doc = {
        "apiVersion": "v1", "kind": "Config", "current-context": "estate",
        "clusters": [{"name": "estate", "cluster": {
            "server": body["server"], "certificate-authority-data": body["ca"]}}],
        "users": [{"name": "agent-reader", "user": {"token": body["token"]}}],
        "contexts": [{"name": "estate",
                      "context": {"cluster": "estate", "user": "agent-reader"}}],
    }
    # Written through a private temporary file and renamed, so a reader never sees a
    # half-written kubeconfig and the token is never briefly world-readable.
    tmp = f"{path}.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(doc, fh)
    os.replace(tmp, path)
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="idp-jit")
    sub = ap.add_subparsers(dest="cmd", required=True)

    a = sub.add_parser("ask", help="ask the founder for time-boxed write access")
    a.add_argument("--grant", required=True, help="an id from platform/jit/grants.yaml")
    a.add_argument("--why", required=True, help="one plain sentence; he reads it on a phone")
    a.add_argument("--ttl", default="10m")
    a.add_argument("--wait", type=int, default=900, help="seconds to wait for the tap")
    a.add_argument("--param", action="append", default=[], metavar="k=v")
    for known in KNOWN_PARAMS:
        a.add_argument(f"--{known}")

    sub.add_parser("grants", help="list what may be asked for")

    i = sub.add_parser("identity", help="become this estate's read-only agent on any device")
    i.add_argument("--kubeconfig", help="write a kubeconfig here instead of printing the token")

    sub.add_parser("enroll", help="prove the age identity and receive this device's own key")

    s = sub.add_parser("status", help="what this device's access IS, as JSON, without minting")
    s.add_argument("--json", action="store_true", help="always JSON; kept for symmetry")

    r = sub.add_parser("renew", help="mint a fresh token now; the zero-touch path calls this")
    r.add_argument("--kubeconfig", required=True,
                   help="rewrite this kubeconfig; a renew with nowhere to write is pointless")
    r.add_argument("--quiet", action="store_true", help="print nothing on success")

    args, extra = ap.parse_known_args(argv)

    if args.cmd == "status":
        return _status()

    if args.cmd == "renew":
        return _renew(args.kubeconfig, args.quiet)

    if args.cmd == "identity":
        return _identity(args.kubeconfig)

    if args.cmd == "enroll":
        return enroll()

    if args.cmd == "grants":
        code, body = _post("/grants", {})
        if body.get("unreachable"):
            print(f"BLOCKED  {body['reason']}", file=sys.stderr)
            return CODES["refused"]
        for g in body.get("grants", []):
            layer = g.get("provider", "kubernetes")
            print(f"{g['id']:28} {layer:12} {g.get('mode',''):16} {g.get('describes','')}")
        return 0

    params = dict(kv.split("=", 1) for kv in args.param if "=" in kv)
    for known in KNOWN_PARAMS:
        if getattr(args, known, None):
            params[known] = getattr(args, known)

    # Same credential the identity door takes, and for the same reason: without it, anything
    # that can open a socket to the broker can put any name on an ask and make the founder's
    # phone buzz with it. He taps every one either way, so this is provenance rather than
    # access -- and the design is only as good as his trust in the name on the screen.
    key = _agent_key()
    if not key:
        print("BLOCKED  this device holds no agent key, so the broker will not take an ask "
              "from it. Set JIT_AGENT_KEY, or put it in $XDG_STATE_HOME/idp/agent-key",
              file=sys.stderr)
        return CODES["refused"]
    code, body = _post("/ask", {"grant": args.grant, "params": params, "why": args.why,
                                "ttl": args.ttl, "asked_by": os.environ.get("JIT_AGENT", "agent")},
                       {"Authorization": f"Bearer {key}"})
    if body.get("unreachable"):
        print(f"BLOCKED  {body['reason']}", file=sys.stderr)
        return CODES["refused"]
    if code != 200:
        print(f"refused: {body.get('error', 'the broker would not take the ask')}", file=sys.stderr)
        return CODES["refused"]

    rid = body["request"]
    print(f"asked; waiting up to {args.wait}s for the founder to tap ({rid[:8]})", file=sys.stderr)
    deadline = time.time() + args.wait
    while time.time() < deadline:
        time.sleep(3)
        code, body = _post("/state", {"request": rid})
        state = body.get("state")
        if state == "granted":
            result = body.get("result", {})
            if result.get("mode") == "broker-applies":
                print(result.get("applied", "applied"), file=sys.stderr)
            else:
                print(result.get("token", ""))
            return 0
        if state == "denied":
            print("denied", file=sys.stderr)
            return CODES["denied"]
        if state == "failed":
            print(f"the change was approved and then failed: {body.get('reason')}", file=sys.stderr)
            return CODES["failed"]
    print("he did not answer; a silence is a no (WJ.3)", file=sys.stderr)
    return CODES["timeout"]


if __name__ == "__main__":
    sys.exit(main())
