#!/usr/bin/env python3
"""estate-claim-check -- a fact is stored only if it can be re-executed.

THE INVARIANT (this is the whole design, and it is inductive):

    1. `add` has no way to accept a number. It accepts an instrument, runs it,
       and stores what it printed. A value that was not produced by a command
       cannot enter the store (write path is closed).
    2. `verify` re-runs every stored instrument and refuses anything it cannot
       reproduce now. So the store cannot drift away from its evidence
       (read path fails closed).

Base case: an empty store passes. Step: every write is filtered by (1), every
read is filtered by (2). Therefore no served fact is one that nothing can
re-derive. That is the guarantee. It is a guarantee about *verifiability*, not
about truth: an instrument can be the wrong instrument. The mitigation is
`also` -- independent instruments that must agree, so a mis-typed instrument
contradicts a second measurement instead of passing alone.

THREE KINDS, THREE RUNGS (docs/research/2026-10-23-claims-carry-their-checker.md):

    fact      R1-exec        an instrument re-runs and must print the same thing.
    artefact  R2-evidence    a named file is digested; if it changes, the claim dies.
    judgment  R3-attributed  no measurement exists; the row carries who said it, where.

A judgment is not a fact with a softer check: it is a claim whose rung is visible,
so "the founder prefers prose" can be stored *as an attributed statement* and never
be mistaken for something a command proved. Anything that fits no rung is refused.

`probe` grades ONE claim without storing it, so a claim can earn its rung wherever it is
written -- the memory door (mcp/plugins/estate_memory.py) shells out to this verb instead of
re-implementing `_run`, its timeout or its quoting. There is one checker: a claim that is not
verified here is not verified anywhere, and `probe` exits 0 only when the claim is verified
now (a judgment is attributed, never verified).

What this store cannot do on its own: force every claim through it (closure). That is the
memory write path, and it was not a fact of this tool until the door called it: see
`platform/estate/memory/` for what stores a memory and `bin/memory-gate` for the rung that
proves a false claim cannot come back verified.

Exit codes: 0 all PASS, 1 any failure, 2 usage/store error. For `probe`: 0 verified, 1 not.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

PASS, STALE, CONTRADICTED, UNWITNESSED, TAMPERED, RETIRED = (
    "PASS",
    "STALE",
    "CONTRADICTED",
    "UNWITNESSED",
    "TAMPERED",
    "RETIRED",
)
FAILURES = (STALE, CONTRADICTED, UNWITNESSED, TAMPERED)
DEFAULT_STORE = "~/.estate/facts.jsonl"
TIMEOUT_S = 20

# claim_kind -> the rung of the ladder its evidence sits on. Absent on old rows, which
# were all facts, so the default is the rung they were written at.
RUNG = {"fact": "R1-exec", "artefact": "R2-evidence", "judgment": "R3-attributed"}


def _now() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _run(cmd: str) -> tuple[bool, str]:
    """Run an instrument. Returns (ok, output-or-error). No value is parsed here:
    the caller compares the literal text, so a command that prints a banner fails."""
    try:
        p = subprocess.run(
            ["bash", "-c", cmd],
            capture_output=True,
            text=True,
            timeout=TIMEOUT_S,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return False, f"instrument exceeded {TIMEOUT_S}s"
    if p.returncode != 0:
        blob = (p.stderr or "") + (p.stdout or "")
        if "No such file or directory" in blob:
            # A missing input file is NO EVIDENCE from this tree, not counter-evidence
            # (2026-10-25: operator-store instruments carry checkout-relative paths, so a
            # verify from any other checkout FileNotFound'd facts and redded every lane).
            # The sentinel prefix is a verdict channel, never a value: verify_row maps it
            # to UNWITNESSED before it can reach a value comparison.
            return False, "UNWITNESSED: the instrument's input is not in this tree"
        return False, f"instrument exited {p.returncode}: {p.stderr.strip()[:200]}"
    out = p.stdout.strip()
    if not out:
        # An instrument that prints nothing has measured nothing. Without this, a silent
        # command stored an empty value and then reproduced it forever: a fact nothing can
        # contradict is exactly the defect this tool exists to refuse.
        return (
            False,
            "instrument printed nothing: nothing was measured, so nothing is witnessed",
        )
    return True, out


def _same(a: str, b: str, tol: float) -> bool:
    if a == b:
        return True
    try:
        return abs(float(a) - float(b)) <= tol
    except ValueError:
        return False


def _sha(s: str) -> str:
    return hashlib.sha256(s.encode()).hexdigest()[:12]


def _digest(path: str) -> str | None:
    """The digest of an artefact, or None if there is no artefact there.

    Rung 2 exists because most claims an agent makes are about something that happened
    rather than something a command recomputes: a deploy, a production log line, a
    screenshot. Those cannot be re-executed, but they can be bound to bytes. A stored
    digest dies the moment the artefact changes, so "it deployed" cannot outlive the
    evidence for it.
    """
    p = os.path.expanduser(path)
    if not os.path.isfile(p):
        return None
    h = hashlib.sha256()
    with open(p, "rb") as fh:
        for chunk in iter(lambda: fh.read(65536), b""):
            h.update(chunk)
    return "sha256:" + h.hexdigest()


def load(store: str) -> list[dict]:
    if not os.path.exists(store):
        return []
    rows = []
    with open(store, encoding="utf-8") as fh:
        for n, line in enumerate(fh, 1):
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except json.JSONDecodeError as exc:
                raise SystemExit(f"store corrupt at line {n}: {exc}")
    return rows


def _chain_hash(row: dict) -> str:
    """The fingerprint of a row as it was written, excluding its own hash."""
    body = {k: v for k, v in row.items() if k != "hash"}
    return hashlib.sha256(
        json.dumps(body, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def chain_state(rows: list[dict]) -> tuple[str, str]:
    """Walk the hash chain. Returns (verdict, detail). Empty means intact.

    Re-execution answers "is this still true?". The chain answers a different question,
    "is this still the record?" -- an edited or deleted fact re-executes its instrument
    happily against someone else's number, so without this the store could be made to
    agree with any claim simply by rewriting its history.
    """
    prev = ""
    for i, row in enumerate(rows, 1):
        if row.get("prev") != prev:
            return (
                "TAMPERED",
                f"line {i} ({row.get('id')}) follows {prev[:12] or 'nothing'!r} but records {str(row.get('prev'))[:12]!r}",
            )
        if row.get("hash") != _chain_hash(row):
            return (
                "TAMPERED",
                f"line {i} ({row.get('id')}) does not hash to what it records: the row was edited",
            )
        prev = row["hash"]
    return PASS, ""


def _append(store: str, row: dict) -> dict:
    """Append with the chain extended, under a lock so two agents cannot fork the history.

    The lock is taken next to the store and removed again: a lockfile left behind is a file
    git will happily commit, and it did exactly that on 2026-10-23 -- facts/estate.jsonl.lock
    reached the branch and the claim gate refused the change, correctly. An unlocked store is
    still safe against a torn append (one write, one flush, one fsync); the lock only stops two
    writers computing the same prev from the same last row.
    """
    path = os.path.expanduser(store)
    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
    lockpath = path + ".lock"
    try:
        lockfh = open(lockpath, "w", encoding="utf-8")
    except OSError:
        lockfh = None  # a read-only store still appends; it just cannot be locked
    try:
        if lockfh is not None:
            fcntl.flock(lockfh, fcntl.LOCK_EX)
        rows = load(path)
        row["prev"] = rows[-1]["hash"] if rows else ""
        row["hash"] = _chain_hash(row)
        with open(path, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
            fh.flush()
            os.fsync(fh.fileno())
    finally:
        if lockfh is not None:
            lockfh.close()
            try:
                os.unlink(lockpath)
            except OSError:
                pass
    return row


def _window(row: dict) -> tuple[str | None, str]:
    """The expiry check every rung shares: a claim that has aged out is STALE, not checked.

    A validity of 0 is a real window ("expires immediately"); only an absent window is
    unwitnessed. `not row.get(...)` conflated the two and made an expired fact report as
    unchecked, which the test suite caught.
    """
    if row.get("valid_for_s") is None:
        return UNWITNESSED, "no validity window: this claim cannot be checked"
    measured = row.get("measured_at") or ""
    try:
        at = datetime.strptime(measured, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=timezone.utc
        )
    except ValueError:
        return UNWITNESSED, f"measured_at is not a timestamp: {measured!r}"
    age = time.time() - at.timestamp()
    if age > float(row["valid_for_s"]):
        return STALE, f"measured {int(age)}s ago, valid for {int(row['valid_for_s'])}s"
    return None, ""


def verify_row(row: dict, tol: float) -> tuple[str, str]:
    kind = row.get("claim_kind") or "fact"

    if kind == "judgment":
        # Rung 3: never executed. The only thing checkable is that the row says who
        # asserted it and where the assertion lives; the verdict says so out loud, so a
        # judgment cannot ride into a report looking like a measurement.
        authority = row.get("authority")
        if not authority:
            return UNWITNESSED, "judgment with no authority: nobody is named for it"
        expired, why = _window(row)
        if expired:
            return expired, why
        return PASS, f"attributed, not verified: {authority}"

    if kind == "artefact":
        # Rung 2: the claim is bound to bytes. Re-execution is impossible for an event, but
        # silent replacement of the evidence is not.
        evidence = row.get("evidence")
        if not evidence:
            return UNWITNESSED, "artefact claim with no evidence path: nothing is bound"
        expired, why = _window(row)
        if expired:
            return expired, why
        now = _digest(evidence)
        if now is None:
            return CONTRADICTED, f"the artefact is gone: {evidence}"
        if now != str(row.get("value")):
            return CONTRADICTED, (
                f"the artefact changed: stored {row.get('value')!r}, now {now!r} ({evidence})"
            )
        return PASS, f"{evidence} is unchanged ({now})"

    instrument = row.get("instrument")
    # An absent witness is UNWITNESSED whatever the clock says: a claim with nothing to
    # check must not be reported as merely expired, which would suggest it once had a check.
    if not instrument:
        return (
            UNWITNESSED,
            "no instrument or no validity window: this fact cannot be checked",
        )
    expired, why = _window(row)
    if expired:
        return expired, why

    ok, out = _run(instrument)
    if not ok:
        if out.startswith("UNWITNESSED:"):
            return UNWITNESSED, out
        return CONTRADICTED, out
    if not _same(out, str(row.get("value")), tol):
        return (
            CONTRADICTED,
            f"stored {row.get('value')!r}, instrument now prints {out!r}",
        )
    for alt in row.get("also") or []:
        ok2, out2 = _run(alt)
        if not ok2:
            if out2.startswith("UNWITNESSED:"):
                return UNWITNESSED, out2
            return CONTRADICTED, f"independent instrument failed: {out2}"
        if not _same(out2, str(row.get("value")), tol):
            return CONTRADICTED, (
                f"independent instrument disagrees: stored {row.get('value')!r}, {out2!r} "
                f"from {alt!r} -- one of the two instruments is the wrong instrument"
            )
    return PASS, out


def _probe_result(verdict: str, rung: str, verified: bool, detail: str) -> dict:
    return {
        "verdict": verdict,
        "rung": rung,
        "verified": bool(verified),
        "detail": detail,
    }


def probe_claim(
    kind: str = "",
    instrument: str = "",
    evidence: str = "",
    authority: str = "",
    expect: str | None = None,
    tol: float = 0.0,
) -> dict:
    """Grade one claim without storing it: {verdict, rung, verified, detail}.

    The rung is earned here, not asserted by the caller: `verified` is true only when a
    measurement actually ran and reproduced (R1) or the named bytes are there now (R2). A
    judgment comes back PASS at R3-attributed and NEVER verified -- that is the whole reason
    the ladder exists, and a caller that reads only `verified` cannot mistake it for a
    measurement.
    """
    kind = kind or (
        "fact"
        if instrument
        else "artefact"
        if evidence
        else "judgment"
        if authority
        else ""
    )
    if kind == "fact":
        if not instrument:
            return _probe_result(
                UNWITNESSED, RUNG["fact"], False, "a fact needs an instrument: nothing ran"
            )
        ok, out = _run(instrument)
        if not ok:
            verdict = UNWITNESSED if out.startswith("UNWITNESSED:") else CONTRADICTED
            return _probe_result(verdict, RUNG["fact"], False, out)
        if expect is not None and not _same(out, expect, tol):
            return _probe_result(
                CONTRADICTED,
                RUNG["fact"],
                False,
                f"instrument prints {out!r}, the claim says {expect!r}",
            )
        return _probe_result(PASS, RUNG["fact"], True, out)

    if kind == "artefact":
        if not evidence:
            return _probe_result(
                UNWITNESSED,
                RUNG["artefact"],
                False,
                "an artefact claim needs an evidence path: nothing is bound",
            )
        now = _digest(evidence)
        if now is None:
            return _probe_result(
                UNWITNESSED,
                RUNG["artefact"],
                False,
                f"no artefact at {evidence}: nothing was witnessed",
            )
        return _probe_result(PASS, RUNG["artefact"], True, f"{evidence} is {now}")

    if kind == "judgment":
        if not authority:
            return _probe_result(
                UNWITNESSED,
                RUNG["judgment"],
                False,
                "judgment with no authority: nobody is named for it",
            )
        return _probe_result(
            PASS, RUNG["judgment"], False, f"attributed, not verified: {authority}"
        )

    return _probe_result(
        UNWITNESSED,
        "",
        False,
        "no rung: name an instrument (R1), an evidence path (R2) or an authority (R3)",
    )


def cmd_probe(a) -> int:
    """Exit 0 only when the claim is verified now. A judgment is PASS and not verified."""
    result = probe_claim(
        a.kind or "",
        a.instrument or "",
        a.evidence or "",
        a.authority or "",
        a.expect,
        a.tolerance,
    )
    if a.json:
        print(json.dumps(result, sort_keys=True))
    else:
        print(
            f"{result['verdict']:13} {result['rung'] or 'no-rung':13} "
            f"verified={'true' if result['verified'] else 'false'} {result['detail']}"
        )
    return 0 if result["verified"] else 1


def cmd_add(a) -> int:
    kind = a.kind
    anchor = ""
    if kind == "fact":
        if not a.instrument:
            print(
                "REFUSED: a fact needs --instrument. A value with no command behind it is "
                "the defect this tool exists to refuse.",
                file=sys.stderr,
            )
            return 2
        ok, out = _run(a.instrument)
        if not ok:
            print(f"REFUSED: {out}", file=sys.stderr)
            return 2
        if a.expect is not None and not _same(out, a.expect, a.tolerance):
            print(
                f"REFUSED: instrument prints {out!r} but you expect {a.expect!r}. "
                "Fix the instrument or the expectation; nothing is stored.",
                file=sys.stderr,
            )
            return 2
        anchor = a.instrument
    elif kind == "artefact":
        if not a.evidence:
            print(
                "REFUSED: an artefact claim needs --evidence <path>. Without the bytes "
                "there is nothing to bind the claim to.",
                file=sys.stderr,
            )
            return 2
        out = _digest(a.evidence)
        if out is None:
            print(
                f"REFUSED: no artefact at {a.evidence}. Nothing was witnessed, so nothing "
                "is stored.",
                file=sys.stderr,
            )
            return 2
        anchor = os.path.expanduser(a.evidence)
    else:  # judgment
        if not a.authority:
            print(
                "REFUSED: a judgment is stored only when attributed. Name who asserted it "
                "and where (--authority 'founder, 2026-09-30, AGENTS.md section 5').",
                file=sys.stderr,
            )
            return 2
        if a.instrument:
            print(
                "REFUSED: a judgment is not measured. Store what the command proves as a "
                "fact, and keep the judgment beside it as attributed.",
                file=sys.stderr,
            )
            return 2
        out = a.authority
        anchor = a.authority
    row = {
        "id": a.id or _sha(a.subject + anchor),
        "subject": a.subject,
        "unit": a.unit,
        "value": out,
        "claim_kind": kind,
        "instrument": a.instrument if kind == "fact" else None,
        "evidence": os.path.expanduser(a.evidence) if kind == "artefact" else None,
        "authority": a.authority if kind == "judgment" else None,
        "also": (a.also or []) if kind == "fact" else [],
        "measured_at": _now(),
        "valid_for_s": a.valid_for,
        "store_version": 1,
    }
    store = os.path.expanduser(a.store)
    stored = _append(store, row)
    print(
        f"STORED {stored['id']}  [{RUNG[kind]}] {a.subject} = {out} {a.unit}  "
        f"({a.instrument or a.evidence or a.authority})"
    )
    return 0


def cmd_retire(a) -> int:
    """Retire a fact without deleting it.

    The store is append-only because the history is the evidence, so a fact that is no longer
    the right question (a row count of a ledger that appends continuously) is retired with its
    reason rather than removed. verify then stops grading it and still proves nobody edited the
    past. Retiring a fact that is not there is refused: a typo must not silently ungrade a live
    fact.
    """
    store = os.path.expanduser(a.store)
    rows = load(store)
    # Retirement is ordered, not a set: the same subject and instrument measured again is the same
    # fact id (the id is a hash of both), so a re-measurement after a retirement must be live. A
    # set would retire the re-measurement too -- which it did, on 2026-10-23, hiding a live fact.
    retired_now = set()
    seen = set()
    for r in rows:
        if r.get("kind") == "retire":
            retired_now.add(r["target"])
        else:
            seen.add(r["id"])
            retired_now.discard(r["id"])
    if a.id not in seen:
        print(f"REFUSED: no fact {a.id!r} in {a.store}", file=sys.stderr)
        return 2
    if a.id in retired_now:
        print(f"REFUSED: {a.id} is already retired", file=sys.stderr)
        return 2
    _append(
        store,
        {
            "kind": "retire",
            "target": a.id,
            "reason": a.reason,
            "retired_at": _now(),
            "store_version": 1,
        },
    )
    print(f"RETIRED {a.id}: {a.reason}")
    return 0


def cmd_verify(a) -> int:
    rows = load(os.path.expanduser(a.store))
    if not rows:
        print(f"no facts in {a.store}; nothing to verify (this is a pass, not a proof)")
        return 0
    chain, why = chain_state(rows)
    worst = 1 if chain != PASS else 0
    retired = {}
    results = []
    if chain != PASS:
        results.append(
            {"id": "-", "subject": "the store itself", "verdict": chain, "detail": why}
        )
    # Only the newest row per fact id is graded: a re-measurement of the same subject and
    # instrument is the same id, and it supersedes the row it replaces. Retirement is ordered and
    # applies only to rows before it, so a re-measured fact is live again. As a plain set of
    # retired ids this hid a live fact (verify said 0/0 active) on 2026-10-23.
    last_seen = {}
    for i, r in enumerate(rows):
        if r.get("kind") != "retire":
            last_seen[r.get("id")] = i
    retired_after = {}
    for i, r in enumerate(rows):
        if r.get("kind") == "retire":
            retired_after[r["target"]] = i
    for i, row in enumerate(rows):
        if row.get("kind") == "retire":
            continue
        detail = f"retired {row.get('retired_at')}: {row.get('reason')}"
        if i < last_seen.get(row.get("id"), i):
            results.append(
                {
                    "id": row.get("id"),
                    "subject": row.get("subject"),
                    "verdict": RETIRED,
                    "detail": "superseded by a later measurement of the same fact",
                }
            )
            continue
        ridx = retired_after.get(row.get("id"), -1)
        if ridx > i:
            rrow = rows[ridx]
            results.append(
                {
                    "id": row.get("id"),
                    "subject": row.get("subject"),
                    "verdict": RETIRED,
                    "detail": f"retired {rrow.get('retired_at')}: {rrow.get('reason')}",
                }
            )
            continue
        verdict, detail = verify_row(row, a.tolerance)
        results.append(
            {
                "id": row.get("id"),
                "subject": row.get("subject"),
                "verdict": verdict,
                "detail": detail,
            }
        )
        if verdict in FAILURES:
            worst = 1
    rungs = {
        r.get("id"): RUNG.get(r.get("claim_kind") or "fact", "R1-exec")
        for r in rows
        if r.get("kind") != "retire"
    }
    for r in results:
        r["rung"] = rungs.get(r["id"], "")
    if a.json:
        print(
            json.dumps(
                {"verdict": "PASS" if worst == 0 else "FAIL", "facts": results},
                indent=2,
            )
        )
    else:
        for r in results:
            print(
                f"{r['verdict']:13} {r['id']:<14} {r['rung']:<14} {r['subject']}: {r['detail']}"
            )
        n_pass = sum(1 for r in results if r["verdict"] == PASS)
        n_ret = sum(1 for r in results if r["verdict"] == RETIRED)
        print(
            f"\n{n_pass}/{len(results) - n_ret} active facts re-executed"
            f" ({n_ret} retired). verdict: {'PASS' if worst == 0 else 'FAIL'}"
        )
    return worst


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    ap.add_argument("--store", default=DEFAULT_STORE)
    ap.add_argument("--tolerance", type=float, default=0.0)
    ap.add_argument("--json", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)

    ad = sub.add_parser(
        "add", help="measure or attest a claim and store it (there is no --value flag)"
    )
    ad.add_argument("--subject", required=True)
    ad.add_argument("--unit", default="")
    ad.add_argument(
        "--kind",
        default="fact",
        choices=("fact", "artefact", "judgment"),
        help="fact=R1 exec, artefact=R2 evidence, judgment=R3 attributed",
    )
    ad.add_argument(
        "--instrument", help="the exact command that produces the value (kind=fact)"
    )
    ad.add_argument(
        "--evidence", help="the file the claim is about; its digest is stored"
    )
    ad.add_argument(
        "--authority", help="who asserted it and where, for a judgment that cannot be measured"
    )
    ad.add_argument(
        "--also",
        action="append",
        help="an independent instrument that must agree (repeatable)",
    )
    ad.add_argument("--valid-for", type=int, default=86400, dest="valid_for")
    ad.add_argument(
        "--expect", help="pin the value; refuse to store if the instrument disagrees"
    )
    ad.add_argument("--id")
    ad.set_defaults(func=cmd_add)

    ve = sub.add_parser(
        "verify", help="re-execute every stored instrument and fail closed"
    )
    ve.set_defaults(func=cmd_verify)

    pr = sub.add_parser(
        "probe",
        help="grade ONE claim without storing it; exit 0 only when it is verified now",
    )
    pr.add_argument(
        "--kind",
        default="",
        choices=("", "fact", "artefact", "judgment"),
        help="omit to infer from the evidence supplied",
    )
    pr.add_argument("--instrument", help="the command that must reproduce the claim (R1)")
    pr.add_argument("--evidence", help="the file the claim is bound to (R2)")
    pr.add_argument("--authority", help="who asserted it and where (R3)")
    pr.add_argument("--expect", help="the value the claim asserts; a mismatch is CONTRADICTED")
    # SUPPRESS so `probe --json` and `--json probe` both mean the same thing; the parent's
    # default would otherwise be overwritten by this parser's.
    pr.add_argument("--json", action="store_true", default=argparse.SUPPRESS)
    pr.set_defaults(func=cmd_probe)

    re_ = sub.add_parser(
        "retire", help="stop grading a fact, keeping it and its reason on record"
    )
    re_.add_argument("--id", required=True)
    re_.add_argument("--reason", required=True)
    re_.set_defaults(func=cmd_retire)

    a = ap.parse_args(argv)
    return a.func(a)


if __name__ == "__main__":
    sys.exit(main())
