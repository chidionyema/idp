#!/usr/bin/env python3
"""incident-register: the incident corpus as one machine-readable register (crew#679 CP1).

Founder, 2026-08-30: "take incident as input, use it to generate chaos experiments/drills".
The input is every tests/test_incident_*.py: its module docstring names the date, the board
item, what broke and the guard. This reads them all and writes docs/reference/incident-register.yaml,
one row per incident, never hand-typed, with a fault class the chaos generator (CP3) keys on.

    bin/incident-register            write the register, print the class counts
    bin/incident-register --check    exit 1 when the committed register is stale (the CP5 gate)

Fault classes are keyword rules over the docstring; a row that matches none is `unclassified`
and listed as such (LAW 28: a row that cannot be generated is named, not hidden).
"""

from __future__ import annotations

import ast
import re
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
TESTS = ROOT / "tests"
OUT = ROOT / "docs" / "reference" / "incident-register.yaml"

# order matters: the first class whose pattern matches wins; the chaos tool can inject the
# first seven, the rest are process incidents a gate closes and a drill cannot recreate.
CLASSES: list[tuple[str, str, bool]] = [
    (
        "pod-crash",
        r"crash.?loop|oomkill|restart(ed|ing|s)? (the |a )?pod|pod (was )?killed|backoff",
        True,
    ),
    (
        "rollout-stall",
        r"stalled|rollout|helmrelease .*(fail|stuck)|reconcil|flux (refused|failed)|suspend",
        True,
    ),
    (
        "network",
        r"dns|timeout|unreachable|connection refused|502|503|504|tunnel|ingress|tls|certificate",
        True,
    ),
    (
        "secret-rotation",
        r"secret|credential|token|kubeconfig|oauth|api key|vault",
        True,
    ),
    (
        "capacity",
        r"disk|memory|cpu|node pool|load \d+|out of space|quota|free.?tier|16 gb",
        True,
    ),
    ("clock", r"clock|1970|epoch|timestamp|bst|utc", True),
    ("scheduler", r"dagster|scheduler|cron|launchd|circuit breaker|breaker", True),
    (
        "ci-pipeline",
        r"workflow|ci\.yml|runner|github actions|gate|pre-push|hook|pull request|pr #|idp#\d+",
        False,
    ),
    ("process", r"founder|ruling|law \d+|board|handoff|session", False),
]


def classify(text: str) -> tuple[str, bool]:
    low = text.lower()
    for name, pat, injectable in CLASSES:
        if re.search(pat, low):
            return name, injectable
    return "unclassified", False


def rows() -> list[dict]:
    out = []
    for f in sorted(TESTS.glob("test_incident_*.py")):
        doc = ast.get_docstring(ast.parse(f.read_text())) or ""
        head = " ".join(doc.split())
        date = re.search(r"20\d\d-\d\d-\d\d", head)
        refs = sorted(set(re.findall(r"(?:crew|idp|hermes-v2|cg)#\d+", head)))
        cls, inj = classify(head)
        out.append(
            {
                "id": f.stem.removeprefix("test_incident_"),
                "test": str(f.relative_to(ROOT)),
                "date": date.group(0) if date else None,
                "refs": refs,
                "fault_class": cls,
                "injectable": inj,
                "summary": head[:240],
            }
        )
    return out


def render(items: list[dict]) -> str:
    counts: dict[str, int] = {}
    for r in items:
        counts[r["fault_class"]] = counts.get(r["fault_class"], 0) + 1
    body = {
        "generated_by": "bin/incident-register",
        "source": "tests/test_incident_*.py module docstrings",
        "incidents": len(items),
        "by_class": dict(sorted(counts.items())),
        "rows": items,
    }
    return (
        "# GENERATED by bin/incident-register; edit the incident test, not this file.\n"
        + yaml.safe_dump(body, sort_keys=False, width=120, allow_unicode=True)
    )


def main(argv: list[str]) -> int:
    text = render(rows())
    if "--check" in argv:
        if OUT.exists() and OUT.read_text() == text:
            print(
                f"ok      incident-register   {OUT.relative_to(ROOT)} matches {len(rows())} incident tests"
            )
            return 0
        print(
            f"FAIL    incident-register   {OUT.relative_to(ROOT)} is stale; run bin/incident-register and commit it"
        )
        return 1
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(text)
    body = yaml.safe_load(text)
    print(f"wrote {OUT.relative_to(ROOT)}: {body['incidents']} incidents")
    for k, v in body["by_class"].items():
        print(f"  {k:16s} {v}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
