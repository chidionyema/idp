#!/usr/bin/env bash
# provider-adapter: oci — this file IS the provider door (session sign-in / tenancy-root IAM); it is not a caller of one. Every other bin/idp-* goes through bin/idp-cloud (crew#66).
# Grade the live estate-operators grants against platform/oci/policy/estate-operators.statements.json.
# crew#311 / crew#301: the tenancy-root policy is written only by bin/idp-oci-bootstrap (a founder
# browser sign-in). Since idp#227 the compartment-scoped lines of the file are ALSO applied from CI by
# platform/oci/iam.tf as the compartment policy estate-operators-compartment, so a statement is live
# when EITHER policy carries it. This grader unions both; grading the tenancy policy alone failed the
# first apply after #227 (run 32988930880) on a grant that was live in the compartment policy.
#   ok      iam-policy  22 statements, live matches platform/oci/policy/estate-operators.statements.json
#   ok      iam-policy  ... (1 stale tenancy line superseded: allow ... read buckets ...)
#   FAIL    iam-policy  1 missing from the live policy: ... | fix: founder runs bin/idp-oci-bootstrap
#   FAIL    iam-policy  1 live statement(s) not in the file: ... | fix: add to the file or remove with bin/idp-oci-bootstrap
#   BLIND   iam-policy  <reason>                 (cannot read a policy: never a verdict, LAW 45)
# A live line that is a weaker verb (inspect<read<use<manage) of a wanted line on the same resource and
# scope is stale, not drift: the bootstrap wrote it before the file was raised and only the founder can
# delete it. It is named in the ok row so the next bootstrap run clears it.
# Usage: idp-iam-policy-drift [<statements.json>]
#   env: OCI_TENANCY_OCID (required), OCI_COMPARTMENT_OCID (optional: also read the compartment policy),
#        POLICY_NAME (default below), COMPARTMENT_POLICY_NAME (default estate-operators-compartment)
set -euo pipefail
set -u
trap 'echo "$0: exit $?" >&2' EXIT
HERE="$(cd "$(dirname "$0")/.." && pwd)"
FILE="${1:-$HERE/platform/oci/policy/estate-operators.statements.json}"
NAME="${POLICY_NAME:-estate-operators-manage-estate}"
CNAME="${COMPARTMENT_POLICY_NAME:-estate-operators-compartment}"
[ -f "$FILE" ] || {
	echo "BLIND   iam-policy  no statements file at $FILE"
	exit 2
}
[ -n "${OCI_TENANCY_OCID:-}" ] || {
	echo "BLIND   iam-policy  OCI_TENANCY_OCID unset; the policy lives in the tenancy root"
	exit 2
}
live=$(oci iam policy list --compartment-id "$OCI_TENANCY_OCID" --name "$NAME" --all --query 'data[0].statements' 2>&1) || {
	echo "BLIND   iam-policy  oci iam policy list failed: $(printf %s "$live" | grep -iE 'code|message' | head -1 | cut -c1-120)"
	exit 2
}
case "$live" in null | "")
	echo "FAIL    iam-policy  no policy named $NAME in the tenancy root | fix: founder runs bin/idp-oci-bootstrap"
	exit 1
	;;
esac
have=$(printf %s "$live" | jq -c 'map(ascii_downcase)' 2>/dev/null) || {
	echo "BLIND   iam-policy  policy list answered no JSON: $(printf %s "$live" | head -1 | cut -c1-120)"
	exit 2
}
note=""
if [ -n "${OCI_COMPARTMENT_OCID:-}" ]; then
	clive=$(oci iam policy list --compartment-id "$OCI_COMPARTMENT_OCID" --name "$CNAME" --all --query 'data[0].statements' 2>&1) || {
		echo "BLIND   iam-policy  oci iam policy list ($CNAME) failed: $(printf %s "$clive" | grep -iE 'code|message' | head -1 | cut -c1-120)"
		exit 2
	}
	case "$clive" in
	null | "") note="; $CNAME not applied yet (oke-check apply creates it)" ;;
	*)
		chave=$(printf %s "$clive" | jq -c --arg c "$OCI_COMPARTMENT_OCID" 'map(ascii_downcase|sub(" in compartment id " + ($c|ascii_downcase) + "$"; " in compartment estate"))' 2>/dev/null) || {
			echo "BLIND   iam-policy  policy list ($CNAME) answered no JSON: $(printf %s "$clive" | head -1 | cut -c1-120)"
			exit 2
		}
		have=$(jq -nc --argjson a "$have" --argjson b "$chave" '$a+$b|unique')
		;;
	esac
fi
want=$(jq -c 'map(ascii_downcase)|sort' "$FILE")
have=$(jq -c 'sort' <<<"$have")
missing=$(jq -nc --argjson w "$want" --argjson h "$have" '$w-$h')
# an extra live line whose verb is weaker than a wanted line on the same resource and scope is stale, not drift
JQ_STALE='def key: sub("^(?<a>allow group .* to )(inspect|read|use|manage)(?<b> .*)$"; "\(.a)*\(.b)");
  def rank: if test(" to manage ") then 4 elif test(" to use ") then 3 elif test(" to read ") then 2 else 1 end;
  ($h-$w) | map(. as $e | {s: $e, stale: (any($w[]; key == ($e|key) and rank >= ($e|rank)))})'
graded=$(jq -nc --argjson w "$want" --argjson h "$have" "$JQ_STALE")
extra=$(jq -c 'map(select(.stale|not)|.s)' <<<"$graded")
stale=$(jq -c 'map(select(.stale)|.s)' <<<"$graded")
nm=$(jq length <<<"$missing")
ne=$(jq length <<<"$extra")
ns=$(jq length <<<"$stale")
if [ "$nm" -eq 0 ] && [ "$ne" -eq 0 ]; then
	[ "$ns" -eq 0 ] || note="$note; $ns stale tenancy line(s) superseded, cleared by the next bin/idp-oci-bootstrap: $(jq -r 'join("; ")' <<<"$stale")"
	echo "ok      iam-policy  $(jq length "$FILE") statements, live matches ${FILE#$HERE/}$note"
	exit 0
fi
[ "$nm" -eq 0 ] || echo "FAIL    iam-policy  $nm missing from the live policy: $(jq -r 'join("; ")' <<<"$missing") | fix: compartment lines land with oke-check apply (platform/oci/iam.tf); tenancy lines need the founder to run bin/idp-oci-bootstrap$note"
[ "$ne" -eq 0 ] || echo "FAIL    iam-policy  $ne live statement(s) not in ${FILE#$HERE/}: $(jq -r 'join("; ")' <<<"$extra") | fix: add to the file or remove with bin/idp-oci-bootstrap"
exit 1
