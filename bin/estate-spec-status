#!/usr/bin/env python3
"""estate-spec-status -- is a founder spec done? Only the proof decides.

    estate-spec-status --all          every spec: done or open, with the proof's exit status
    estate-spec-status --check SPEC    one spec
    estate-spec-status --json          machine-readable

A spec is done when its proof exits zero. Not when it was merged, not when it was reported,
not when it looks finished: when the proof runs green. The founder's rule (2026-10-29): the
acceptance criteria and the proof command decide.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def _governance_path() -> str:
    """Where the governance package lives: this checkout, or the estate's runtime tree."""

    repo_root = os.path.dirname(HERE)
    for cand in (
        os.environ.get("ESTATE_GOVERNANCE_TREE", ""),
        os.path.join(repo_root, "platform", "estate"),
        os.path.join(repo_root, "runtime", "idp", "platform", "estate"),
        os.path.expanduser("~/.estate/runtime/idp/platform/estate"),
    ):
        if cand and os.path.isfile(os.path.join(cand, "governance", "registry.py")):
            return cand
    raise SystemExit("estate: the governance package was not found (set ESTATE_GOVERNANCE_TREE)")


sys.path.insert(0, _governance_path())
ROOT = os.path.abspath(os.path.join(os.path.dirname(_governance_path()), ".."))

from governance import registry  # noqa: E402


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--all", action="store_true")
    ap.add_argument("--check", default="")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv[1:])

    report = registry.evaluate_specs(ROOT)
    rows = report["specs"]
    if args.check:
        rows = [r for r in rows if r["id"] == args.check]
        if not rows:
            print(f"FAIL  spec-status  no spec named {args.check}")
            return 1
    if args.json:
        print(json.dumps({"specs": rows}, indent=2, default=str))
    else:
        for row in rows:
            print(f"{row['status'].upper():5} {row['id']:24} {row['title']}")
            print(f"      component: {row['component']}")
            if row["source_spec"]:
                print(f"      spec: {row['source_spec']}")
            for criterion in row["acceptance"]:
                print(f"      - {criterion}")
            print(f"      proof: {row['proof']}")
    open_rows = [r for r in rows if r["status"] != "done"]
    return 1 if open_rows else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
