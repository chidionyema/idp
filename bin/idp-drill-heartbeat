#!/usr/bin/env bash
# A drill that never runs looks exactly like one that passes (crew#307, 2026-08-26 13:15Z: 40
# minutes after login-drill.yml landed on main with cron */5, GitHub had fired zero scheduled runs
# and nothing said so). This row grades absence: the newest successful run of a workflow must be
# younger than MAX_AGE_MIN, and the newest run of any conclusion must not be a failure.
#   ok      heartbeat  login-drill  last success 4 min ago (run 123)
#   FAIL    heartbeat  login-drill  last success 41 min ago > 20 | fix: dispatch it; if the cron never fires, GitHub dropped the schedule
#   BLIND   heartbeat  <reason>
# Usage: idp-drill-heartbeat <workflow-file> [max-age-min]   env: GH_REPO (owner/repo), GH_TOKEN
set -euo pipefail
set -u
trap 'echo "$0: exit $?" >&2' EXIT
WF="${1:?workflow file, e.g. login-drill.yml}"
MAX="${2:-20}"
REPO="${GH_REPO:?GH_REPO owner/repo}"
command -v gh >/dev/null || {
	echo "BLIND   heartbeat  $WF  gh missing"
	exit 2
}
row=$(gh run list -R "$REPO" --workflow "$WF" --status success --limit 1 --json databaseId,updatedAt --jq '.[0]|"\(.databaseId) \(.updatedAt)"' 2>&1) || {
	echo "BLIND   heartbeat  $WF  gh run list failed: $(printf %s "$row" | head -1 | cut -c1-100)"
	exit 2
}
case "$row" in "" | "null null")
	echo "FAIL    heartbeat  $WF  no successful run on record | fix: gh workflow run $WF -R $REPO"
	exit 1
	;;
esac
id=${row%% *}
ts=${row#* }
now=$(date -u +%s)
then=$(python3 -c "import sys,datetime;print(int(datetime.datetime.fromisoformat(sys.argv[1].replace('Z','+00:00')).timestamp()))" "$ts" 2>/dev/null) || {
	echo "BLIND   heartbeat  $WF  unreadable timestamp '$ts'"
	exit 2
}
age=$(((now - then) / 60))
if [ "$age" -gt "$MAX" ]; then
	echo "FAIL    heartbeat  $WF  last success $age min ago > $MAX (run $id) | fix: gh workflow run $WF -R $REPO; if the cron never fires, GitHub dropped the schedule"
	exit 1
fi
echo "ok      heartbeat  $WF  last success $age min ago (run $id)"
