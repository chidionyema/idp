#!/usr/bin/env python3
"""crew#488 CP1: grades the weekly hydration drill (LAW 19, portability outranks detection).

.github/workflows/portability-drill.yml creates a vanilla k3d cluster on a GitHub runner with no
OCI identity, installs Flux, points one GitRepository at the run's commit and applies every
Kustomization under clusters/oke/. That is the migration scenario docs/prose/cloud-agnostic-drills.feature
described in prose since crew#250; this is the first time it runs. The workflow then dumps
`kubectl get kustomizations -A -o json` and hands the file here.

Prints one line, like every drill, after one line per layer that did not come up:
  ok      portability  ready N/M (root-red R all named, cascaded C, pending P) on a cluster with no OCI (floor F); the cascade waits C1 on <row>, C2 on <row>
  FAIL    portability  root-red not on drills/portability-oci-reds.txt: <layers>  -- a break of its own that no one has explained
  FAIL    portability  ready N/M is below the floor F        -- a layer that hydrated last week no longer does
  FAIL    portability  no Kustomization was applied           -- the drill itself is broken, nothing was graded
  BLIND   portability  <why>                                  -- the receipt is missing or unreadable

A cascade also names the row at the end of its chain. `cascaded 25` alone cannot tell twenty-five
rows each broken on their own from twenty-five queued behind one door, and those are opposite
answers to "does this platform port". On run 33232172215 the answer is the second: 22 of the 25
wait on secret-store, the vault door, whose own red is named and expected off OCI.

crew#488 CP5: a not-ready layer is one of three things, and the line says which.
  cascaded   its Ready message is Flux's "dependency X is not ready": a row above it is red, it is not
  oci-red    red for a reason of its own that drills/portability-oci-reds.txt names for that layer
  ROOT-RED   red for a reason of its own that nothing names: this FAILS the run whatever the floor says
Before this, 2/38 with 36 red graded ok against floor 2 (run 33208911991): four layers broke on
their own, thirty-two fell behind them, and the line read green. A count that cannot tell a
cascade from a cause cannot tell a buyer's engineer anything (LAW 44, silent green).

The floor is drills/portability-floor.txt, one integer. It only goes up: a run that beats it is the
evidence for the PR that raises it, and a run below it is red. A floor of 0 grades nothing and is
refused, because a drill that cannot fail is a wish (LAW 44).

Usage: idp-portability-drill <kustomizations.json> [--floor drills/portability-floor.txt] [--reds drills/portability-oci-reds.txt]
"""
from __future__ import annotations

import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def read_floor(path: str) -> int:
    with open(path, encoding="utf-8") as fh:
        lines = [ln.strip() for ln in fh if ln.strip() and not ln.lstrip().startswith("#")]
    if len(lines) != 1 or not lines[0].isdigit():
        raise ValueError(f"{path}: expected exactly one integer line, got {lines!r}")
    return int(lines[0])


PENDING = {"Progressing", "Reconciling"}
CASCADE = re.compile(r"dependency '?[\w./-]+'? is not ready")
# Same message, but keeping the blocker's short name: `dependency 'flux-system/secret-store' is
# not ready` -> secret-store. crew#488: `cascaded 26` is one opaque number, and the only question
# a buyer's engineer asks of it is "behind what". Twenty-six rows waiting on one vault door is a
# different platform from twenty-six rows each broken on their own, and the line could not tell
# them apart.
BLOCKER = re.compile(r"dependency '?(?:[\w.-]+/)?([\w.-]+)'? is not ready")


def resolve_root(start: str, blocked_by: dict[str, str]) -> str:
    """The row at the end of the dependency chain: the one red for a reason of its own.

    Walks `blocked_by` (cascaded row -> the row it names) until it reaches a row that is not
    itself a cascade. Returns that row's short name. A cycle -- Flux permits dependsOn loops and
    reports both ends as waiting on the other -- stops at the row it re-enters rather than
    hanging, so a malformed tree makes this print a name, never spin.
    """
    seen, cur = {start}, start
    while cur in blocked_by:
        nxt = blocked_by[cur]
        if nxt in seen:
            return nxt
        seen.add(nxt)
        cur = nxt
    return cur


def read_reds(path: str) -> list[tuple[str, str]]:
    """(layer, substring) rows of drills/portability-oci-reds.txt; a row with no substring is refused."""
    out = []
    with open(path, encoding="utf-8") as fh:
        for ln in fh:
            ln = ln.strip()
            if not ln or ln.startswith("#"):
                continue
            parts = ln.split(None, 1)
            if len(parts) != 2:
                raise ValueError(f"{path}: {ln!r} names a layer with no reason; a red nobody can name is a root-red")
            out.append((parts[0], parts[1].strip()))
    return out


def grade(items: list[dict], floor: int, reds: list[tuple[str, str]] = ()) -> tuple[str, list[str]]:
    """Returns (verdict line, one line per not-ready layer). Pure, so the gate can prove it both ways."""
    if floor < 1:
        return ("FAIL    portability  floor is 0: a drill that cannot fail grades nothing (LAW 44)", [])
    if not items:
        return ("FAIL    portability  no Kustomization was applied; the drill itself is broken", [])
    ready, lines, cascaded, oci, roots, pending = 0, [], 0, 0, [], 0
    blocked_by: dict[str, str] = {}   # cascaded row -> the row its Ready message names
    cascade_rows: list[tuple[int, str]] = []   # (index into `lines`, short name), patched below
    for it in items:
        meta = it.get("metadata", {})
        short = meta.get("name", "?")
        name = f"{meta.get('namespace', '?')}/{short}"
        conds = {c.get("type"): c for c in it.get("status", {}).get("conditions", [])}
        rc = conds.get("Ready", {})
        if rc.get("status") == "True":
            ready += 1
            continue
        msg = rc.get("message") or "no Ready condition yet"
        if rc.get("status") == "Unknown" or rc.get("reason") in PENDING:
            # Flux has not judged it yet (Progressing / Unknown): not ready, not a root.
            pending += 1
            lines.append(f"  pending    {name}: {msg[:160]}")
        elif CASCADE.search(msg):
            cascaded += 1
            blocker = BLOCKER.search(msg)
            if blocker:
                blocked_by[short] = blocker.group(1)
            cascade_rows.append((len(lines), short))
            lines.append(f"  cascaded   {name}: {msg[:160]}")
        elif any(layer == short and why in msg for layer, why in reds):
            oci += 1
            lines.append(f"  oci-red    {name}: {msg[:160]}")
        else:
            roots.append(short)
            lines.append(f"  ROOT-RED   {name}: {msg[:160]}")
    # Attribution: every cascade carries the row at the end of its chain, and the verdict carries
    # the tally. The per-row prefix is untouched, so a reader (and the gate) still counts cascades
    # the same way.
    behind: dict[str, int] = {}
    for idx, short in cascade_rows:
        root = resolve_root(short, blocked_by)
        behind[root] = behind.get(root, 0) + 1
        lines[idx] = f"{lines[idx]}  -> root {root}"
    tally = ", ".join(f"{n} on {r}" for r, n in sorted(behind.items(), key=lambda kv: (-kv[1], kv[0])))

    total = len(items)
    if roots:
        return (f"FAIL    portability  root-red not on drills/portability-oci-reds.txt: {' '.join(roots)} "
                f"(ready {ready}/{total}, cascaded {cascaded}, pending {pending})", lines)
    if ready < floor:
        return (f"FAIL    portability  ready {ready}/{total} is below the floor {floor}", lines)
    return (f"ok      portability  ready {ready}/{total} (root-red {oci} all named, cascaded {cascaded}, pending {pending}) "
            f"on a cluster with no OCI (floor {floor})"
            + (f"; the cascade waits {tally}" if tally else ""), lines)


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        print(__doc__)
        return 2
    floor_path = os.path.join(ROOT, "drills", "portability-floor.txt")
    if "--floor" in argv:
        floor_path = argv[argv.index("--floor") + 1]
    reds_path = os.path.join(ROOT, "drills", "portability-oci-reds.txt")
    if "--reds" in argv:
        reds_path = argv[argv.index("--reds") + 1]
    try:
        with open(argv[1], encoding="utf-8") as fh:
            items = json.load(fh).get("items", [])
        floor = read_floor(floor_path)
        reds = read_reds(reds_path)
    except (OSError, ValueError) as exc:
        print(f"BLIND   portability  {exc}")
        return 1
    verdict, bad = grade(items, floor, reds)
    for ln in bad:
        print(ln)
    print(verdict)
    return 0 if verdict.startswith("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
