#!/usr/bin/env python3
"""idp-greenlane tick | status

`tick` is one step of the gated trunk (greenlane/engine.py) against GitHub: it loads the engine's
state from refs/greenlane/state, observes the lanes, judges the candidate under test, lands or
bisects, starts the next candidate, and saves the state. Run by .github/workflows/greenlane.yml
on every lane push, every ci completion, every hand-raised pull request and a five-minute
backstop, under one concurrency group, so there is exactly one writer of main.

`status` prints the JSON the Fleet page shows: the invariants as measured now (main green?
open pull requests? lanes, candidate, last landings), read with whatever token `gh` holds.

Required checks come from platform/github/ruleset.idp.required-checks.json, never a list typed
here: crew typed one once, the founder deleted the workflow behind a name, and the bot refused
every pull request for ten days (merge-when-green.yml, 2026-09).
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))

from greenlane.brief import brief  # noqa: E402
from greenlane.engine import LANDED, Engine, State, latency  # noqa: E402
from greenlane.github import STATE_REF, GitHubBackend  # noqa: E402

RULESET = ROOT / "platform/github/ruleset.idp.required-checks.json"


def required_contexts() -> list[str]:
    spec = json.loads(RULESET.read_text())
    for rule in spec["rules"]:
        if rule["type"] == "required_status_checks":
            # `greenlane` is the engine's own verdict, written just before it merges: waiting on
            # it before writing it would hold every batch forever.
            return [
                c["context"]
                for c in rule["parameters"]["required_status_checks"]
                if c["context"] != "greenlane"
            ]
    raise SystemExit(f"BLIND   greenlane  {RULESET} declares no required_status_checks")


def repo() -> str:
    return (
        os.environ.get("GH_REPO")
        or os.environ.get("GITHUB_REPOSITORY")
        or subprocess.run(  # noqa: S603 -- fixed argv, no shell
            ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],  # noqa: S607
            capture_output=True,
            text=True,
            check=True,
        ).stdout.strip()
    )


STALE_ATTEMPTS = 3  # one live attempt, then two reload-and-retry cycles


def tick(judge_only: bool = False) -> int:
    """One tick, tolerant of losing the state race (2026-10-17).

    Ticks overlap (lane push runs and main dispatches sit in different concurrency groups)
    and the save is a compare-and-swap: whoever saves second refuses to clobber and dies.
    Dying is correct -- silently overwriting is the b2953/b2954 defect -- but a lost race
    is not something an agent should have to re-trigger, and a tick is idempotent by
    design: the state is re-read from the ref and everything is re-derived. So a
    stale-lease refusal reloads and retries, bounded; a refusal that survives the bound is
    real contention and stays loud.

    `judge_only=True` (idp#6520) runs the collecting half only: it lands, bisects or
    requeues the candidate the state already names, and forms nothing. It is safe to run
    in its own concurrency group on every check completion, because it never observes or
    starts batches -- the work only a `greenlane`-group tick may do.
    """
    for attempt in range(1, STALE_ATTEMPTS + 1):
        try:
            return _tick_once(judge_only=judge_only)
        except RuntimeError as e:
            if attempt == STALE_ATTEMPTS or "stale info" not in str(e):
                raise
            print(
                f"ok      greenlane  state moved under the tick (lease stale); "
                f"reload and retry {attempt + 1}/{STALE_ATTEMPTS}",
                flush=True,
            )
    raise AssertionError("unreachable")  # the loop returns or raises


def _tick_once(judge_only: bool = False) -> int:
    b = GitHubBackend(
        repo(),
        required_contexts(),
        run_url=os.environ.get("GREENLANE_RUN_URL", ""),
        image_only_diff=ROOT / "bin/idp-image-only-diff",
        status_token=os.environ.get("GREENLANE_STATUS_TOKEN", ""),
    )
    b.fetch()
    st = State.loads(b.load_state_text())
    eng = Engine(b, st)
    try:
        landed_before = st.landed
        eng.tick(judge_only=judge_only)
    finally:
        b.save_state_text(st.dumps())
    for line in eng.log:
        print(f"ok      greenlane  {line}")
    batch = st.batch
    print(
        f"ok      greenlane  main={b.main()[:12]} lanes={len(st.lanes)} "
        f"candidate={(batch.tip[:12] + ' (' + batch.id + ')') if batch else 'none'} landed_total={st.landed}"
    )
    for name, why in b.refused.items():
        print(f"REFUSED greenlane  {name}: {why}")
    # A judge tick fires on every check completion in the repository; re-arming from all of
    # them would dispatch a mutate tick per completion. Re-arm only when the judge actually
    # collected a verdict, so a landing is followed by the next batch within seconds (the
    # re-arm dispatch lands in the `greenlane` group and queues there like any other tick).
    if not judge_only or st.landed > landed_before:
        rearm(st)
    return 0


def rearm(st: State) -> None:
    """Chain one more tick if a lane is still unproven (2026-10-11).

    A lane push fires `push` exactly once, and it competes for the single
    `greenlane` concurrency slot with the continuous stream of `workflow_run`
    ticks that every completion on main produces. Losing that race cancels the
    lane's only trigger: measured over the last 100 greenlane runs, 8 of 11
    `push` runs were cancelled and 52 of 76 cancellations killed a run that had
    already started. The `schedule` backstop that is supposed to cover this
    fired twice in that same window against a `*/5` cron (288/day expected), so
    nothing re-armed a lost lane and it sat unproven on origin until an agent
    dispatched a tick by hand.

    A cancelled run never reaches this function, so the re-arm cannot come from
    the run that was lost. It comes from whichever tick runs next and observes
    work outstanding -- which is why the chain has to be self-sustaining rather
    than relying on the event that establishes the work.

    Re-arming is safe to repeat because a tick is idempotent: the engine persists
    `state.json` in git (bin/idp-greenlane.tick saves it in a `finally`), and a
    run killed mid-flight is requeued from that state rather than stranded. The
    guard is only against a runaway loop: a tick with no lane outstanding
    dispatches nothing, so the chain terminates as soon as the estate is clean.
    """
    if not os.environ.get("GH_TOKEN"):
        return  # no credential to dispatch with; the next event-triggered tick covers it
    # Outstanding is the engine's own answer, not a second copy of it (2026-10-14). The copy
    # read `st.main`, which State has never had -- main lives on the backend -- so every tick
    # that landed a batch raised AttributeError here (5 of the 7 failed greenlane runs on
    # 2026-10-14) and the chain broke exactly when it had just moved main. The tests passed
    # because their helper set `st.main` by hand. The copy also counted a parked CONFLICT
    # (rejudged >= REJUDGE_LIMIT) as outstanding, so 7 parked lanes kept the chain alive
    # forever. A LANDED lane is never reopened by the engine, so it is done whatever main is.
    outstanding = sorted(
        name
        for name, lane in st.lanes.items()
        if lane.status != LANDED and not Engine.final(lane)
    )
    if not outstanding and not st.queued:
        return  # nothing unproven: let the chain end here, as it must to stay finite
    proc = subprocess.run(  # noqa: S603 -- fixed argv, no shell
        [  # noqa: S607
            "gh",
            "workflow",
            "run",
            "greenlane.yml",
            "--ref",
            "main",
            "--repo",
            repo(),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode == 0:
        print(
            f"ok      greenlane  re-armed a tick: {len(outstanding)} lane(s) still "
            f"unproven ({', '.join(outstanding[:4])}"
            f"{'...' if len(outstanding) > 4 else ''})"
        )
    else:
        # A refused dispatch must be loud: silence here is a lane that sits
        # unproven with nothing left to move it.
        print(
            f"REFUSED greenlane  re-arm dispatch failed rc={proc.returncode}: "
            f"{(proc.stderr or '').strip()[:200]}"
        )


def status() -> int:
    r = repo()

    def gh(path: str):
        p = subprocess.run(  # noqa: S603 -- fixed argv, no shell
            ["gh", "api", f"repos/{r}/{path}"],  # noqa: S607
            capture_output=True,
            text=True,  # noqa: S607
        )
        return json.loads(p.stdout) if p.returncode == 0 and p.stdout else None

    def gh_or_why(path: str) -> tuple[dict | None, str]:
        """As `gh`, but it hands back the reason when the read failed.

        A required check that reads `absent` because GitHub refused the read is not the same
        fact as one that ran and is not there, and the founder acts on which it is.
        """
        p = subprocess.run(  # noqa: S603 -- fixed argv, no shell
            ["gh", "api", f"repos/{r}/{path}"],  # noqa: S607
            capture_output=True,
            text=True,  # noqa: S607
        )
        if p.returncode != 0 or not p.stdout.strip():
            lines = (p.stderr or p.stdout or f"rc={p.returncode}").strip().splitlines()
            return None, (lines[-1][:140] if lines else f"rc={p.returncode}")
        try:
            return json.loads(p.stdout), ""
        except json.JSONDecodeError as e:
            return None, f"unparseable: {str(e)[:120]}"

    out: dict = {"repo": r}
    ref = gh(f"git/ref/{STATE_REF[5:]}")
    st = State()
    if ref:
        commit = gh(f"git/commits/{ref['object']['sha']}")
        tree = gh(f"git/trees/{commit['tree']['sha']}") if commit else None
        blob_sha = next(
            (
                e["sha"]
                for e in (tree or {}).get("tree", [])
                if e["path"] == "state.json"
            ),
            None,
        )
        blob = gh(f"git/blobs/{blob_sha}") if blob_sha else None
        if blob:
            import base64

            st = State.loads(base64.b64decode(blob["content"]).decode())
    out["state"] = {
        "available": ref is not None,
        "landed_total": st.landed,
        "candidates_total": st.candidates,
        "batch": (st.batch.__dict__ if st.batch else None),
        "lanes": {
            k: {"status": v.status, "reason": v.reason, "head": v.head[:12]}
            for k, v in st.lanes.items()
        },
        # where push-to-land time goes (minutes), from the engine's own bounded records
        "latency": latency(st),
        "recent": st.history[-10:],
    }
    for k, v in st.lanes.items():  # who pushed a red lane's head: the owner the founder asks for
        if v.status == "red":
            c = gh(f"commits/{v.head}") or {}
            who = (c.get("author") or {}).get("login") or (
                (c.get("commit") or {}).get("author") or {}
            ).get("name")
            if who:
                out["state"]["lanes"][k]["owner"] = who
    prs = gh("pulls?state=open&per_page=100") or []
    out["open_prs"] = [
        {"number": p["number"], "user": p["user"]["login"], "head": p["head"]["ref"]}
        for p in prs
    ]

    def required_read(context: str) -> str:
        """The newest check run with this exact name on main's tip (2026-10-11).

        This read one page of every check on main's tip
        (`commits/main/check-runs?per_page=100&filter=latest`) and keyed it by name. The
        Greenlane's own `tick` reports a check on main's sha every ~80s, so that one page fills
        with `tick` long before the checks that ran when main landed: measured 2026-10-11
        main e47ab313e carried 249 check-runs, 132 of them `tick`, and not one of the eight
        required contexts was in the first hundred. All eight read `absent`, `main.green` was
        false and /fleet raised its alarm, while bdd, ci-success, fast-gate / fast-gate,
        guarded-paths, test and portal-app were all `success` on that commit. Asking for the
        name is bounded -- each required context has one or two runs against those 132 ticks --
        so the tick stream cannot bury it.
        """
        d, why = gh_or_why(
            f"commits/main/check-runs?check_name={quote(context, safe='')}&per_page=100"
        )
        if d is None:
            # Never green, and never a silent `absent`: the founder can tell "I could not read
            # this" from "this did not run".
            return f"unreadable: {why}"
        runs = [c for c in (d.get("check_runs") or []) if c.get("name") == context]
        if not runs:
            return "absent"
        newest = max(
            runs, key=lambda c: c.get("completed_at") or c.get("started_at") or ""
        )
        return newest.get("conclusion") or newest.get("status") or "absent"

    required = required_contexts()
    out["main"] = {
        "sha": (gh("commits/main") or {}).get("sha", "")[:12],
        "required": {c: required_read(c) for c in required},
    }
    out["main"]["green"] = all(
        v in ("success", "skipped", "neutral") for v in out["main"]["required"].values()
    )
    # Work lost = a pull request closed without merging whose commits are in no branch, no
    # lane and not in main. The engine closes hand-raised pull requests and relanes them, so a
    # closed PR is normal; a closed PR whose work is nowhere is the one hole the founder must
    # never have to look for ("I don't want to ever be concerned about PRs and work getting
    # into main", 2026-09-29). Measured, not assumed: every closed-unmerged PR is checked.
    heads = {
        r["ref"].removeprefix("refs/heads/")
        for r in (gh("git/matching-refs/heads/") or [])
    }
    lost = []
    for p in gh("pulls?state=closed&per_page=100") or []:
        if p.get("merged_at"):
            continue
        br, sha = p["head"]["ref"], p["head"]["sha"]
        if br in heads or f"lane/{br}" in heads:
            continue
        cmp = gh(f"compare/main...{sha}")
        if cmp and cmp.get("status") in ("behind", "identical"):
            continue  # every commit already in main
        lost.append({"number": p["number"], "branch": br, "head": sha[:12]})
    out["work_lost"] = lost
    out["invariants"] = {
        "main_green": out["main"]["green"],
        "open_prs_not_raised_by_engine": sum(
            1 for p in prs if p["user"]["login"] != "estate-agents[bot]"
        ),
        "red_open_prs": 0 if not prs else None,
        "work_lost": len(lost),
    }
    out["alarm"] = (not out["main"]["green"]) or bool(lost)
    out["now_min"] = time.time() / 60.0  # the engine's own clock (github.py now()), for ages
    out["brief"] = brief(out)  # the three answers the Fleet dot and the voice both read
    print(json.dumps(out, indent=1, sort_keys=True))
    return 0


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "status"
    if cmd == "tick" and "--judge-only" in sys.argv[2:]:
        sys.exit(tick(judge_only=True))
    sys.exit({"tick": tick, "status": status}.get(cmd, lambda: (print(__doc__), 2))())
