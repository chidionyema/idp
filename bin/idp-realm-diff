#!/usr/bin/env python3
"""The customer realm that is running, graded against the customer realm that is in git.

WHY. Founder, 2026-08-30, on the identity spec: "the realm's live state must be diffable
against git in CI". A realm is the one piece of this platform an admin console can change in
ten seconds and nobody would ever know: who may register, whether email is verified, how many
failed passwords lock an account, how long a token lives. keycloak-config-cli reconciles git
onto the server every run, so drift is short-lived -- but "short-lived" is a claim about a job
having run, not a measurement of the realm, and the estate's second defect class is exactly
that (silent green). This reads the realm back and says whether it is what git says.

WHAT IT COMPARES. Git is a subset on purpose: a Keycloak export carries several hundred keys
this estate has no opinion about, and demanding equality with all of them would mean checking
in Keycloak's defaults and re-checking them on every upgrade. So the rule is one-sided and
stated out loud: EVERY key git declares must match the export, and a key git does not declare
is not drift. Clients are matched by clientId and roles by name, never by list position,
because an export orders them however the database felt like it.

  bin/idp-realm-diff --export FILE          grade a realm export (JSON or YAML) already on disk
  bin/idp-realm-diff --export FILE --realm platform/customer-identity/realm/shop.yaml
  bin/idp-realm-diff                        no export: BLIND, never a pass

  exit 0  ok      every key git declares matches
  exit 1  FAIL    at least one key differs; each one is printed as git -> live
  exit 2  BLIND   nothing could be compared, and that is not a pass

PLACEHOLDERS. The git realm carries keycloak-config-cli variable substitution, `$(env:NAME)`,
so no hostname is a literal in the repository (LAW 46). A placeholder whose variable is unset
is BLIND, not a wildcard: wildcarding it would let this script grade a realm it cannot read
and print ok, which is the defect it exists to catch. The one exception is a placeholder under
a credential key: those are compared by presence, never by value, so their variable is never
read and this check never needs a credential in its environment to run.

WHAT IT CANNOT SEE (LAW 45 step 5). It grades the export it was handed. It does not prove the
export came from the live server, and it has no opinion about keys git stays silent on -- a
console change to one of those is invisible here by design. Widen git, not this rule.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

import yaml

#: keycloak-config-cli's default substitution prefix. Anything else in the file is a literal.
PLACEHOLDER = re.compile(r"\$\(env:([A-Za-z_][A-Za-z0-9_]*)\)")

#: A verdict line, same eight-column shape as every other bin/idp-* (bin/idp-cluster-state).
NAME = "realm-diff"

#: Keys whose VALUE is a credential. Two separate reasons they are presence-only here, and
#: either one alone would be enough. First, R49: a secret value never appears anywhere it can be
#: read again, and a difference line prints both sides -- so comparing them is a leak path into
#: CI logs. Second, it could not work anyway: keycloak-config-cli and the admin export both
#: return a client secret masked as `**********`, so an equality test on it is a guaranteed red
#: that would teach everyone to ignore this check.
SECRET_KEYS = {"secret", "password", "credentials", "privateKey", "clientSecret"}


def verdict(word: str, why: str) -> None:
    print(f"{word:<8}{NAME}  {why}")


def blind(why: str) -> None:
    verdict("BLIND", why)
    sys.exit(2)


def load(path: Path) -> dict:
    """A realm file, JSON or YAML. A Keycloak export is JSON; git holds YAML."""
    text = path.read_text()
    try:
        doc = yaml.safe_load(text)  # YAML 1.1 is a superset of JSON, so this reads both
    except yaml.YAMLError as exc:
        blind(f"{path} is neither readable YAML nor JSON: {exc}")
    if not isinstance(doc, dict):
        blind(f"{path} is not a realm object")
    return doc


def substitute(value, env: dict) -> object:
    """Fill `$(env:NAME)` from the environment. An unset name is BLIND, never a wildcard."""
    if isinstance(value, str):
        missing = [m for m in PLACEHOLDER.findall(value) if m not in env]
        if missing:
            blind(
                f"the git realm needs {', '.join(sorted(set(missing)))} to be readable, and "
                "nothing set it; an unread placeholder is not a match"
            )
        return PLACEHOLDER.sub(lambda m: env[m.group(1)], value)
    if isinstance(value, list):
        return [substitute(v, env) for v in value]
    if isinstance(value, dict):
        # A credential is compared by presence, never by value (SECRET_KEYS), so its
        # placeholder is left standing: reading it would put a secret in this process's
        # environment for no measurement at all.
        return {
            k: (v if k in SECRET_KEYS else substitute(v, env)) for k, v in value.items()
        }
    return value


def by_key(items, key: str) -> dict:
    """A list of objects, indexed by one of their fields. An export orders lists arbitrarily."""
    out = {}
    for item in items or []:
        if isinstance(item, dict) and key in item:
            out[str(item[key])] = item
    return out


def compare(want, live, path: str, out: list) -> None:
    """Every key `want` declares must match `live`. A key only `live` has is not drift."""
    if isinstance(want, dict) and isinstance(live, dict):
        for k, v in want.items():
            if k in SECRET_KEYS:
                # Presence, never value. The realm must carry one; what it is stays unread.
                if k not in live or live[k] in (None, ""):
                    out.append(f"{path}.{k}: git sets a value, the realm carries none")
                continue
            if k not in live:
                out.append(
                    f"{path}.{k}: git says {json.dumps(v)}, the realm has no such key"
                )
                continue
            compare(v, live[k], f"{path}.{k}", out)
        return
    if isinstance(want, list) and isinstance(live, list):
        # Objects that carry a name are matched by it; anything else is compared as a set, so
        # a reordered redirectUris list is not reported as three separate differences.
        for field in ("clientId", "name"):
            w, l = by_key(want, field), by_key(live, field)
            if w and len(w) == len([i for i in want if isinstance(i, dict)]):
                for name, item in w.items():
                    if name not in l:
                        out.append(f"{path}[{field}={name}]: in git, not in the realm")
                    else:
                        compare(item, l[name], f"{path}[{field}={name}]", out)
                return
        if sorted(map(json.dumps, want)) != sorted(map(json.dumps, live)):
            out.append(
                f"{path}: git says {json.dumps(want)}, the realm says {json.dumps(live)}"
            )
        return
    if want != live:
        out.append(
            f"{path}: git says {json.dumps(want)}, the realm says {json.dumps(live)}"
        )


def main() -> int:
    root = Path(__file__).resolve().parent.parent
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument(
        "--realm", default=str(root / "platform/customer-identity/realm/shop.yaml")
    )
    ap.add_argument("--export", default=os.environ.get("IDP_REALM_EXPORT", ""))
    args = ap.parse_args()

    want_path = Path(args.realm)
    if not want_path.exists():
        blind(f"the git realm {want_path} is not there; nothing to compare against")
    if not args.export:
        blind(
            "no realm export was given, so nothing was read back from the server; pass "
            "--export FILE (or set IDP_REALM_EXPORT). Absent is not a pass."
        )
    live_path = Path(args.export)
    if not live_path.exists():
        blind(f"the realm export {live_path} is not there")

    want = substitute(load(want_path), dict(os.environ))
    live = load(live_path)

    if want.get("realm") != live.get("realm"):
        verdict(
            "FAIL",
            f"this is a different realm: git holds {want.get('realm')!r}, "
            f"the export is {live.get('realm')!r}",
        )
        return 1

    differences: list = []
    compare(want, live, "realm", differences)
    if differences:
        verdict(
            "FAIL",
            f"the running realm is not what git says, in {len(differences)} places:",
        )
        for line in differences:
            print(f"        {line}")
        return 1

    keys = len(want)
    clients = len(want.get("clients") or [])
    verdict(
        "ok",
        f"realm {want['realm']}: {keys} keys and {clients} clients declared in git, "
        "every one of them matches the realm that is running",
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
