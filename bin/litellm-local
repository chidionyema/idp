#!/usr/bin/env bash
# litellm-local -- the laptop router, natively on macOS, no VM and no cluster.
#
#   bin/litellm-local install     stage, then deploy with `swap` (no gap for any caller)
#   bin/litellm-local swap        boot the staged router in the idle slot, switch the front to it
#                                 once it answers, then stop the old slot gracefully
#   bin/litellm-local uninstall   stop and remove the launchd agents (clients fall back to direct)
#   bin/litellm-local status      front + active slot liveliness, launchd state
#   bin/litellm-local run         run a router in the foreground (what a slot's launchd agent calls)
#   bin/litellm-local front       run the front on :4000 (what the front's launchd agent calls)
#
# ZERO-GAP DEPLOYS (2026-10-02). Callers reach 127.0.0.1:4000, which is platform/llm/front.py, a
# byte forwarder that never changes. The router itself runs in slot 4001 or 4002. A deploy boots
# the new router in the idle slot beside the live one (LiteLLM takes ~90 s), and only when it
# answers does the front send new connections to it; requests in flight finish on the old slot,
# which launchd stops gracefully (ExitTimeOut 600). A new router that never answers is stopped
# and the old one keeps serving. Before this, every deploy stopped the only router and every
# agent saw "Connection error" for ~90 s (17:03 and 17:12 UTC that day).
#
# Same LiteLLM version as llm/litellm.yml (1.98.0) and the same rendered llm/config.yaml, run
# without Docker or Postgres: on this 8 GiB Mac the compose stack needs a 4 GiB VM (litellm-up's
# floor), while this process measured 275 MiB RSS.
#
# THE CLOUD IS THE DEFAULT; THIS IS THE FALLBACK. Founder, 2026-10-26: the estate is moving
# away from laptop-based anything -- llm.mumchimp.com is the default route and 127.0.0.1:4000
# is the fallback that stays so a cluster outage does not disable every agent. The 2026-09-26
# ruling ("if cluster breaks we are all disabled") was the reason this router was the DEFAULT;
# it is superseded as a statement of the default, and kept as the reason the fallback exists.
# So: build new capability against the cloud router, and keep this one answering.
#
# WHY IT IS STAGED. launchd agents cannot read ~/Documents (macOS TCC: "Operation not
# permitted", measured 2026-09-26), and this repo lives there. `install` copies the launcher,
# the rendered config and the callback modules to ~/.estate/litellm-local/ and launchd runs that
# copy. A side effect worth having: a branch switch in the repo cannot change the running
# router; only the next `install` does.
#
# No DATABASE_URL, no virtual keys, no master key; the port is bound to 127.0.0.1 only. Every
# Claude Code process is pointed here by ANTHROPIC_BASE_URL in ~/.claude/settings.json, with no
# direct fallback: a dead router is a loud error that launchd's KeepAlive restarts, never a
# silent bypass of the efficiency gateway. These omissions are the point of the fallback, not
# an accident: the cloud router carries the state (postgres, virtual keys, the shared redis
# answer cache, the ollama floor) and this one carries the liveness.
set -euo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
STAGE="$HOME/.estate/litellm-local"
LEGACY_LABEL="com.estate.litellm-local"   # the single router on :4000, before slots
FRONT_LABEL="com.estate.litellm-front"
AGENTS="$HOME/Library/LaunchAgents"
ROUTER_STATE="${ESTATE_ROUTER_STATE:-$HOME/.estate/router-state}"
ACTIVE="$ROUTER_STATE/active"              # the slot the front forwards to (front.py reads it)
FRONT_PORT=4000
LOG="$HOME/Library/Logs/litellm-local.log"
VENV="${LITELLM_LOCAL_VENV:-$HOME/.cache/estate-tools/litellm-venv}"
ESTATE_SECRETS="${ESTATE_SECRETS:-$HOME/Documents/code/estate-secrets}"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
PORT="${LITELLM_LOCAL_PORT:-4001}"   # a slot's agent sets 4001 or 4002; a canary sets its own
MODULES="local_caller_auth.py efficiency_gateway.py request_ceiling.py anthropic_beta_passthrough.py graph_capture.py action_ledger.py router_catalog.py lane_registry.py route_table.py active_memory.py no_handback.py"

live() { curl -sf -m 5 "http://127.0.0.1:${1:-$FRONT_PORT}/health/liveliness" >/dev/null; }
slot_label() { echo "com.estate.litellm-local-$1"; }
loaded() { launchctl print "gui/$(id -u)/$1" >/dev/null 2>&1; }
# bootout returns before the agent is gone; bootstrapping into that window fails with
# "Bootstrap failed: 5: Input/output error" (measured 2026-09-26), so wait for the unload.
unload() {
  launchctl bootout "gui/$(id -u)/$1" 2>/dev/null || true
  for _ in $(seq 1 20); do loaded "$1" || break; sleep 0.5; done
}

# plist LABEL ARG [PORT]: the launchd agent running `litellm-local ARG` from the stage. A slot
# gets 600 s to finish its in-flight streams after SIGTERM before launchd kills it.
plist() {
  local env="" exit_timeout=""
  [ -n "${3:-}" ] && env="<key>LITELLM_LOCAL_PORT</key><string>$3</string>" \
    && exit_timeout="<key>ExitTimeOut</key><integer>600</integer>"
  cat > "$AGENTS/$1.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$1</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>$STAGE/litellm-local</string><string>$2</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  $exit_timeout
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>$env</dict>
</dict>
</plist>
EOF
}

run() {
  if [ -f "$HERE/config.yaml" ]; then
    CFG="$HERE/config.yaml"; MODDIR="$HERE/modules"          # staged copy (launchd)
    MEMLIB="$HERE/memory"
  else
    CFG="$HERE/../llm/config.yaml"; MODDIR="$HERE/../platform/llm"   # repo checkout
    MEMLIB="$HERE/../platform/estate/memory"
  fi

  # A lane without api_key falls back to ANTHROPIC_API_KEY from the environment -- i.e. an
  # Anthropic API key and its "credit balance is too low" -- instead of relaying the client's
  # Max OAuth token. Never let one reach this process (2026-09-04 ruling).
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN DATABASE_URL

  # No router key. Every Claude Code process reaches this router from ~/.claude/settings.json,
  # which cannot read the keychain, and a key is never written into a file. The router holds no
  # credential to protect: it binds 127.0.0.1, launchd gives it no vendor keys, the Anthropic
  # ones are unset above, and every caller must bring its own Max OAuth token. With
  # LITELLM_MASTER_KEY unset LiteLLM skips auth (probed 2026-09-26: a keyless request reached
  # Anthropic and was refused there for lacking a token). Founder, 2026-09-26: "no skipping
  # the router allowed".
  unset LITELLM_MASTER_KEY

  # The callback modules named in llm/config.yaml are imported from here.
  export PYTHONPATH="$MODDIR"
  # local_caller_auth admits only its own Host; a canary on another port must admit that port,
  # or every keyed lane refuses it (measured 2026-09-29 on :4001).
  export ESTATE_ROUTER_HOSTS="${ESTATE_ROUTER_HOSTS:-127.0.0.1:$FRONT_PORT,localhost:$FRONT_PORT,127.0.0.1:$PORT,localhost:$PORT}"
  # One ceiling for every router: request_ceiling.py's own default (128,000), the same value the
  # cloud router runs on. This used to be 200000 here only, so a failover to the cloud silently
  # lowered the limit mid-session. Claude Code's CLAUDE_CODE_AUTO_COMPACT_WINDOW must stay below
  # it (100000 in ~/.estate/harness/cc/settings.json) so compaction fires before any refusal.
  export ESTATE_MAX_INPUT_TOKENS="${ESTATE_MAX_INPUT_TOKENS:-128000}"
  # Export the OTEL_* settings only when a collector answers. Dropping the otel callback was not
  # enough: LiteLLM still built span and metric exporters from these variables alone, and retried
  # the dead :4318 on every batch (8,394 ConnectionErrors in litellm-local.log, 2026-10-10).
  _otel_ep="${OTEL_EXPORTER_OTLP_ENDPOINT:-http://127.0.0.1:4318}"
  if python3 -c 'import socket,sys; from urllib.parse import urlparse as u; e=u(sys.argv[1]); socket.create_connection((e.hostname, e.port or 4318), timeout=1).close()' "$_otel_ep" 2>/dev/null; then
    export OTEL_EXPORTER_OTLP_ENDPOINT="$_otel_ep"
    export OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
    export OTEL_SERVICE_NAME=litellm-local
  else
    unset OTEL_EXPORTER_OTLP_ENDPOINT OTEL_EXPORTER_OTLP_PROTOCOL OTEL_SERVICE_NAME
  fi

  if [ -x "$HERE/sops" ] && [ -d "$HERE/secrets" ]; then
    for f in "$HERE"/secrets/*.yaml; do
      [ -e "$f" ] || continue
      k="$(basename "$f" .yaml)"
      v="$("$HERE/sops" -d --extract "[\"$k\"]" "$f" 2>/dev/null)" && export "$k=$v" || echo "warn  could not decrypt $k"
    done
    unset v
  fi
  # Vendor keys from Bitwarden: ESO syncs every human-* entry into the llm namespace through the
  # human-vault ClusterSecretStore. Read into this process only, so a key added in Bitwarden is a
  # lane here on the next start -- nothing to seed, stage or paste.
  export PATH="$HOME/.rd/bin:$HOME/.local/bin:$HOME/bin:$PATH"
  # The loader is a variable, not inline in $(...): macOS /bin/bash 3.2 mis-parses a quoted
  # multi-line program inside a command substitution and runs it as shell.
  local bw_py bw_env
  bw_py='
import base64, json, re, shlex, sys
try: items = json.load(sys.stdin)["items"]
except Exception: items = []
names = []
for s in items:
    if not s["metadata"]["name"].startswith("human-"): continue
    for k, v in (s.get("data") or {}).items():
        if re.fullmatch(r"[A-Z][A-Z0-9_]*", k):
            print("export %s=%s" % (k, shlex.quote(base64.b64decode(v).decode()))); names.append(k)
print("echo " + shlex.quote("keys   bitwarden: %d %s" % (len(names), ",".join(sorted(names)))))
'
  if command -v kubectl >/dev/null; then
    # --request-timeout does not bound kubectl when the cluster is unreachable (measured
    # 2026-10-28: a 5 s timeout still hung past 55 s, so every slot boot stalled here, never
    # bound its port, and every caller of :4000 got 502). kubectl ignores SIGALRM too (a perl
    # alarm left it hung 5 min), so the ceiling is subprocess's SIGKILL.
    bw_env="$("$VENV/bin/python" -c 'import subprocess, sys; sys.stdout.buffer.write(subprocess.run(sys.argv[1:], capture_output=True, timeout=25).stdout)' kubectl -n llm get secrets -o json --request-timeout=20s 2>/dev/null | "$VENV/bin/python" -c "$bw_py")" || bw_env=""
    eval "$bw_env"
  fi
  unset bw_py bw_env
  [ -n "${DEEPSEEK_API_KEY:-}" ] || echo "warn  bitwarden keys unreadable (kubectl -n llm get secrets): vendor lanes will be dropped"
  # The laptop router key, the one key the estate's local services present (voice-router already
  # does). local_caller_auth requires it on every lane that spends a key this process holds.
  # Undecryptable means those lanes refuse everyone: fail closed, and say so.
  if [ -x "$HERE/sops" ] && [ -f "$HERE/caller/LITELLM_LAPTOP_KEY.yaml" ]; then
    ESTATE_LOCAL_CALLER_KEY="$("$HERE/sops" -d --extract '["LITELLM_API_KEY"]' "$HERE/caller/LITELLM_LAPTOP_KEY.yaml" 2>/dev/null)" || true
    export ESTATE_LOCAL_CALLER_KEY
  fi
  [ -n "${ESTATE_LOCAL_CALLER_KEY:-}" ] || echo "warn  no local caller key: keyed lanes refuse every caller"
  # Active Memory (platform/llm/active_memory.py): every call through this router carries the
  # estate brief and the live claims, read the way bin/estate-brief reads them -- the MCP door
  # and the claim ledger, from the staged platform/estate/memory. The door key is decrypted here
  # because launchd cannot run the vault loader under ~/Documents; it lives in this process only.
  export ESTATE_MEMORY_DOOR=mcp ESTATE_MEMORY_LIB="$MEMLIB"
  # The door is a round trip to the cluster edge; 1.5 s is the in-cluster budget.
  export ACTIVE_MEMORY_BUDGET_S="${ACTIVE_MEMORY_BUDGET_S:-3}"
  if [ -z "${MCP_GATEWAY_KEY:-}" ] && [ -x "$HERE/sops" ] && [ -f "$HERE/caller/MCP_GATEWAY_KEY.yaml" ]; then
    MCP_GATEWAY_KEY="$("$HERE/sops" -d --extract '["MCP_GATEWAY_KEY"]' "$HERE/caller/MCP_GATEWAY_KEY.yaml" 2>/dev/null)" || true
    export MCP_GATEWAY_KEY
  fi
  [ -n "${MCP_GATEWAY_KEY:-}" ] || echo "warn  no MCP_GATEWAY_KEY: calls carry Active Focus but no Active Memory brief"

  # A lane whose key is absent can only fail, cool down and retry on every request -- that is
  # flake, not redundancy. Serve only the lanes this process can actually call.
  # Runtime state lives apart from the code: the stage may be frozen read-only (root-owned), and
  # a router that cannot write its rendered config exits on every restart and never comes back.
  STATE="${ESTATE_ROUTER_STATE:-$HOME/.estate/router-state}"
  mkdir -p "$STATE"
  RUNCFG="$STATE/config.runtime.yaml"
  export ESTATE_ROUTER_CONFIG="$RUNCFG"
  "$VENV/bin/python" - "$CFG" "$RUNCFG" <<'PY'
import os, sys, yaml
cfg = yaml.safe_load(open(sys.argv[1]))
kept, refused, declared = [], [], []
for m in cfg.get("model_list", []):
    declared.append(m["model_name"])
    key = str(m.get("litellm_params", {}).get("api_key", ""))
    if key.startswith("os.environ/") and not os.environ.get(key.split("/", 1)[1]):
        # A declared capability whose credential is absent is REFUSED WITH A REASON, never
        # dropped in silence. Measured 2026-10-29: the `voice` lane vanished from the laptop
        # because the process that happened to be running held no key for it, and nothing said
        # so -- the served set was a function of one unsupervised process's environment, not of
        # the repository. A lane that cannot be served must be visible to whoever depends on
        # it, with the credential that is missing named.
        refused.append({"lane": m["model_name"],
                        "reason": "credential " + key.split("/", 1)[1] + " absent",
                        "verdict": "MEASURED_FAIL"})
    else:
        kept.append(m)
# A pool that loses every deployment is a hole, not a lane: the caller asks for `voice` and the
# router answers "no healthy deployments for this model". On the laptop the surviving vendors are
# the ones whose keys this process holds, so the estate's brain lane is served by one of them
# instead of vanishing with the vendors it named.
if "voice" not in {m["model_name"] for m in kept}:
    src = next((m for m in kept if m["model_name"] in ("default", "fast", "groq")), None)
    if src is not None:
        params = dict(src.get("litellm_params", {}))
        params["timeout"] = 60
        kept.append({"model_name": "voice", "litellm_params": params,
                     "model_info": {"max_input_tokens": 131072}})
# The free floor: Ollama, when this machine runs it and has a model pulled. It costs nothing and it
# answers when every paid vendor refuses. A fallback nobody can reach is a hope, not a floor.
# Measured 2026-10-28: Groq's daily token allowance was exhausted (Limit 200000, Used 199348),
# so the only paid-independent route this machine had was the local floor.
import json as _json, socket as _socket, urllib.request as _urlreq
OLLAMA_BASE = "http://127.0.0.1:11434"
ollama_models = []
try:
    _socket.create_connection(("127.0.0.1", 11434), timeout=1).close()
    with _urlreq.urlopen(OLLAMA_BASE + "/api/tags", timeout=3) as _r:
        ollama_models = [t.get("name", "") for t in _json.load(_r).get("models", [])]
except Exception:
    ollama_models = []
if ollama_models:
    pick = next((n for n in ollama_models if "qwen" in n), ollama_models[0])
    kept.append({"model_name": "ollama",
                 "litellm_params": {"model": "ollama/" + pick, "api_base": OLLAMA_BASE,
                                    "timeout": 120, "keep_alive": "24h"},
                 "model_info": {"max_input_tokens": 32768}})
# Codex asks for `gpt-6.1-sol`, and the estate's cloud router published that model group from
# ITS DATABASE (`store_model_in_db: true` in platform/llm/config.base.yaml) -- not from YAML,
# which is why the name appears nowhere in the repo. Measured 2026-10-29: with the database on a
# volume that is not yet restored, the laptop answered Codex with
# "You passed in model=gpt-6.1-sol. There are no healthy deployments for this model".
# So the laptop publishes the name too, as a MODEL ROW on the estate's standard tier.
# A ROW, not an alias: the auth gate (local_caller_auth) decides whether a lane spends a key
# the router holds by matching the REQUESTED name against the keyed lanes. An alias would
# resolve to a keyed lane after that check, and every local caller would inherit the key.
# A row carries its own `api_key`, so the gate sees it and asks for the laptop router key,
# exactly as it does for `default`.
if "gpt-6.1-sol" not in {m["model_name"] for m in kept}:
    src = next((m for m in kept if m["model_name"] in ("default", "fast", "ollama")), None)
    if src is not None:
        row = {"model_name": "gpt-6.1-sol",
               "litellm_params": dict(src.get("litellm_params", {})),
               "model_info": dict(src.get("model_info", {}))}
        kept.append(row)
# Providers are derived, never declared: every <PROVIDER>_API_KEY[_N] this process holds whose
# provider LiteLLM knows becomes the lane "<provider>/*", so every model that provider serves is
# callable by its own name (deepseek/deepseek-chat, openrouter/qwen/qwen3-coder:free, ...).
# Several keys for one provider are several deployments of one lane. A new provider is a new
# Bitwarden entry; nothing here or in any harness changes.
import re
import litellm
known = {getattr(p, "value", p) for p in litellm.provider_list}
alias = {"nvidia": "nvidia_nim"}          # key names that differ from LiteLLM's provider name
never = {"anthropic"}                     # claude-* relays the caller's own Max token
# A key that only one endpoint honours (#5691): ZAI_API_KEY is the GLM Coding Plan key, which
# LiteLLM's default zai endpoint (pay-as-you-go, $0 balance) refuses with code 1113.
bases = {"zai": "https://api.z.ai/api/coding/paas/v4"}
providers = {}
for var in sorted(os.environ):
    mt = re.fullmatch(r"([A-Z][A-Z0-9]*)_API_KEY(?:_\d+)?", var)
    if not mt or not os.environ[var]:
        continue
    p = alias.get(mt.group(1).lower(), mt.group(1).lower())
    if p in known and p not in never:
        providers.setdefault(p, []).append(var)
        params = {"model": f"{p}/*", "api_key": f"os.environ/{var}"}
        if p in bases:
            params["api_base"] = bases[p]
        kept.append({"model_name": f"{p}/*", "litellm_params": params})
cfg["model_list"] = kept
# A fallback chain that names a lane this machine does not serve is a silent substitution: the
# caller asks for deepseek and is answered by another vendor. Keep only chains between served lanes,
# so a dead lane fails loudly with its own name.
served = {m["model_name"] for m in kept}
rs = cfg.setdefault("router_settings", {})
chains = []
for entry in rs.get("fallbacks", []):
    for src, tgts in entry.items():
        tgts = [t for t in tgts if t in served]
        if "ollama" in served and "ollama" not in tgts:
            tgts = tgts + ["ollama"]
        if src in served and tgts:
            chains.append({src: tgts})
rs["fallbacks"] = chains
# The new row needs its own chain, or a refusing vendor is the end of the road for it.
if "gpt-6.1-sol" in served and "ollama" in served:
    if not any("gpt-6.1-sol" in entry for entry in rs["fallbacks"]):
        rs["fallbacks"].append({"gpt-6.1-sol": ["ollama"]})
# The trace exporter retried a collector nobody runs (3,367 ConnectionErrors in one log window).
# Serve the otel callback only when its endpoint answers, same rule as lanes with no key.
import socket
from urllib.parse import urlparse
ep = urlparse(os.environ.get("OTEL_EXPORTER_OTLP_ENDPOINT", "http://127.0.0.1:4318"))
try:
    socket.create_connection((ep.hostname, ep.port or 4318), timeout=1).close()
    otel_up = True
except OSError:
    otel_up = False
if not otel_up:
    cfg.setdefault("litellm_settings", {})["callbacks"] = [
        c for c in cfg["litellm_settings"].get("callbacks", []) if c != "otel"]
# The router's own account of what it serves, readable without a log.
import json, time
json.dump({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "served": sorted(served),
           "declared": sorted(set(declared)),
           "refused": [r for r in refused if r["lane"] not in served],
           "providers": dict(sorted(providers.items())),
           "bases": {p: b for p, b in bases.items() if p in providers},
           "fallbacks": chains, "otel": otel_up},
          open(os.path.join(os.path.dirname(sys.argv[2]), "lanes.json"), "w"), indent=1)
# Laptop only: who may call this router (platform/llm/local_caller_auth.py). It runs before every
# other callback, so a refused request costs nothing.
cfg.setdefault("general_settings", {})["custom_auth"] = "local_caller_auth.user_api_key_auth"
ls = cfg.setdefault("litellm_settings", {})
ls["callbacks"] = ["local_caller_auth.proxy_handler_instance"] + [
    c for c in ls.get("callbacks", []) if c != "local_caller_auth.proxy_handler_instance"
]
# Laptop only: every exchange spooled for the estate graph (platform/llm/graph_capture.py).
if "graph_capture.proxy_handler_instance" not in ls["callbacks"]:
    ls["callbacks"].append("graph_capture.proxy_handler_instance")
# Laptop only: every call signed and chained (platform/llm/action_ledger.py, crew#983).
if "action_ledger.proxy_handler_instance" not in ls["callbacks"]:
    ls["callbacks"].append("action_ledger.proxy_handler_instance")
# Every call carries the estate brief and live claims (platform/llm/active_memory.py); the
# cluster config names it in config.base.yaml, this one is rendered here.
if "active_memory.proxy_handler_instance" not in ls["callbacks"]:
    ls["callbacks"].append("active_memory.proxy_handler_instance")
# Every model is told to drive the work to done, not hand it back (platform/llm/no_handback.py).
if "no_handback.proxy_handler_instance" not in ls["callbacks"]:
    ls["callbacks"].append("no_handback.proxy_handler_instance")
yaml.safe_dump(cfg, open(sys.argv[2], "w"), sort_keys=False)
print(f"lanes  serving {len(kept)}: {sorted({m['model_name'] for m in kept})}")
_still_refused = [r for r in refused if r["lane"] not in served]
print(f"lanes  refused {len(_still_refused)}: " + "; ".join(
    f"{r['lane']} ({r['reason']})" for r in _still_refused))
# A refused lane is an ALARM, not a log line. The estate's alert inbox is where a caller finds
# out that a declared capability is not being served; a degraded router that says nothing in
# the log is how a lane disappears for hours (2026-10-29: the `voice` lane, gone silently).
if _still_refused:
    _inbox = os.environ.get("ESTATE_ALERTS_INBOX") or os.path.join(
        os.path.expanduser("~"), ".estate", "alerts", "inbox.jsonl")
    try:
        os.makedirs(os.path.dirname(_inbox), exist_ok=True)
        with open(_inbox, "a") as _f:
            for _r in _still_refused:
                _f.write(json.dumps({"ts": time.time(), "source": "litellm-local",
                                     "key": "lane:" + _r["lane"], "text": _r["lane"] + " refused: " + _r["reason"]}) + "\n")
    except OSError:
        pass
# The render must RETURN, and the work is done when the files are written.
#
# Measured 2026-10-29: a render that had already written config.runtime.yaml and lanes.json sat
# in Python's interpreter shutdown for 4 h 33 m, garbage-collecting litellm's module graph
# (sampled: Py_FinalizeEx -> finalize_modules -> gc_collect_main, state R). The slot waiting for
# it never bound its port, so the router could not be deployed at all -- the zero-gap swap
# timed out at its own 180 s window and the old router kept serving the old bytes. The fix is
# not a bigger window: the finalizer is not part of the render. os._exit skips it, and the
# explicit flush keeps the lines an operator reads.
#
# __name__ is "__main__" when the wrapper runs this block as a script, and something else when a
# test executes the very same block in-process -- where os._exit would take the test runner
# with it. So the guard is on the name, not on the environment.
if __name__ == "__main__":
    sys.stdout.flush()
    sys.stderr.flush()
    os._exit(0)
PY

  # Every model the providers serve, written into every installed harness (router_catalog.py).
  # Background: the router never waits on a provider's model listing.
  ( "$VENV/bin/python" "$MODDIR/router_catalog.py" "$(dirname "$RUNCFG")/lanes.json" \
      >"$(dirname "$RUNCFG")/catalog.log" 2>&1 & )

  exec "$VENV/bin/litellm" --config "$RUNCFG" --host 127.0.0.1 --port "$PORT"
}

install() {
  local idp; idp="$(cd "$HERE/.." && pwd)"
  [ -x "$VENV/bin/litellm" ] || {
    echo "FAIL  no LiteLLM at $VENV; install it with:"
    echo "      uv venv --python 3.12 $VENV && VIRTUAL_ENV=$VENV uv pip install 'litellm[proxy]==1.98.0' opentelemetry-sdk opentelemetry-exporter-otlp"
    exit 2
  }
  mkdir -p "$STAGE/modules" "$AGENTS" "$(dirname "$LOG")"
  cp "$idp/bin/litellm-local" "$STAGE/litellm-local"
  cp "$idp/llm/config.yaml" "$STAGE/config.yaml"
  for m in $MODULES; do cp "$idp/platform/llm/$m" "$STAGE/modules/$m"; done
  # efficiency_gateway.py loads the budget orchestrator (m4) from beside itself.
  cp "$idp/platform/efficiency/budget_orchestrator.py" "$STAGE/modules/budget_orchestrator.py"
  # The guardian (launchd/ai.estate.litellm-watchdog.plist.tmpl) runs from the stage too.
  cp "$idp/platform/llm/watchdog.py" "$STAGE/watchdog.py"
  # Vendor keys, ciphertext only: launchd cannot read ~/Documents, so the SOPS files and the
  # sops binary are staged; run() decrypts them into this process's environment and nowhere else.
  rm -rf "$STAGE/secrets"; mkdir -p "$STAGE/secrets"
  cp "$ESTATE_SECRETS"/secrets/dev/*_API_KEY*.yaml "$STAGE/secrets/" 2>/dev/null || true
  rm -rf "$STAGE/caller"; mkdir -p "$STAGE/caller"
  cp "$ESTATE_SECRETS"/secrets/dev/LITELLM_LAPTOP_KEY.yaml "$STAGE/caller/" 2>/dev/null || true
  cp "$ESTATE_SECRETS"/secrets/dev/MCP_GATEWAY_KEY.yaml "$STAGE/caller/" 2>/dev/null || true
  # active_memory.py imports the door and the focus rules from here (ESTATE_MEMORY_LIB).
  rm -rf "$STAGE/memory"; mkdir -p "$STAGE/memory"
  for m in door.py focus.py runtimes.json; do cp "$idp/platform/estate/memory/$m" "$STAGE/memory/$m"; done
  local sops; sops="$(command -v sops || echo "$HOME/.cache/estate-tools/sops")"
  [ -x "$sops" ] && cp "$sops" "$STAGE/sops"
  cp "$idp/platform/llm/front.py" "$STAGE/front.py"
  mkdir -p "$ROUTER_STATE"
  plist "$FRONT_LABEL" front
  if loaded "$LEGACY_LABEL"; then
    # One-time move off the single router on :4000: boot a slot first, then hand :4000 to the
    # front. The gap is the moment between the old router releasing the port and the front
    # binding it (front.py retries the bind), not a 90 s boot.
    swap || exit 1
    unload "$LEGACY_LABEL"; rm -f "$AGENTS/$LEGACY_LABEL.plist"
    launchctl bootstrap "gui/$(id -u)" "$AGENTS/$FRONT_LABEL.plist"
  else
    loaded "$FRONT_LABEL" || launchctl bootstrap "gui/$(id -u)" "$AGENTS/$FRONT_LABEL.plist"
    swap || exit 1
  fi
  for _ in $(seq 1 30); do live && { echo "ok    litellm-local live on 127.0.0.1:$FRONT_PORT -> slot $(cat "$ACTIVE") (staged at $STAGE)"; return 0; }; sleep 1; done
  echo "FAIL  front not answering on :$FRONT_PORT; last log lines:"; tail -20 "$LOG"; exit 1
}

swap() {
  local cur next
  cur="$(cat "$ACTIVE" 2>/dev/null || true)"
  if [ "$cur" = 4001 ]; then next=4002; else next=4001; fi
  unload "$(slot_label "$next")"
  plist "$(slot_label "$next")" run "$next"
  launchctl bootstrap "gui/$(id -u)" "$AGENTS/$(slot_label "$next").plist"
  for _ in $(seq 1 90); do live "$next" && break; sleep 2; done
  if ! live "$next"; then
    unload "$(slot_label "$next")"
    echo "FAIL  slot $next not live after 180s; slot ${cur:-none} keeps serving; last log lines:"
    tail -20 "$LOG"; return 1
  fi
  printf '%s\n' "$next" > "$ACTIVE.tmp" && mv "$ACTIVE.tmp" "$ACTIVE"
  echo "ok    slot $next active; new connections go to it"
  # In the background: launchd gives the old slot up to 600 s to finish its streams. Its plist
  # goes too, or the next login would boot both slots.
  if [ -n "$cur" ]; then
    (launchctl bootout "gui/$(id -u)/$(slot_label "$cur")" >/dev/null 2>&1; rm -f "$AGENTS/$(slot_label "$cur").plist") &
  fi
}

front() { exec "$VENV/bin/python" "$HERE/front.py"; }

uninstall() {
  for l in "$FRONT_LABEL" "$(slot_label 4001)" "$(slot_label 4002)" "$LEGACY_LABEL"; do
    unload "$l"; rm -f "$AGENTS/$l.plist"
  done
  rm -f "$ACTIVE"
  echo "ok    litellm-local stopped; new shells go direct to Anthropic"
}

status() {
  if live; then echo "live  127.0.0.1:$FRONT_PORT"; else echo "DOWN  127.0.0.1:$FRONT_PORT (new shells go direct)"; fi
  local a; a="$(cat "$ACTIVE" 2>/dev/null || true)"; echo "slot  ${a:-none} active"
  for l in "$FRONT_LABEL" "$(slot_label 4001)" "$(slot_label 4002)" "$LEGACY_LABEL"; do
    loaded "$l" && echo "      $l: $(launchctl print "gui/$(id -u)/$l" | grep -E '^\s*state =' | xargs)"
  done
  return 0
}

case "${1:-run}" in
  run) run ;;
  install) install ;;
  swap) swap ;;
  front) front ;;
  uninstall) uninstall ;;
  status) status ;;
  *) echo "usage: $0 [run|install|swap|front|uninstall|status]"; exit 2 ;;
esac
