#!/usr/bin/env python3
"""security-policy-gate [PAGE]: every control row on the security policy page
names a proof command that exists.

A policy row without a proof is a wish (LAW 44). The proof column must start
with a backtick command; its first word must be a file under bin/ (relative to
the repo root or to estate-secrets), or an executable on PATH. Anything else
prints FAIL and exits 1. The page is the only input, so this runs anywhere.
"""
import os, re, shutil, subprocess, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# The estate root is the parent of the main checkout, asked of git so a worktree
# resolves it the same way and no file names where the checkout lives (LAW 46).
try:
    _main = subprocess.run(["git", "-C", ROOT, "worktree", "list", "--porcelain"],
                           capture_output=True, text=True, check=True).stdout.split("\n")[0]
    ESTATE = os.path.dirname(_main.split(" ", 1)[1])
except Exception:
    ESTATE = os.path.dirname(ROOT)
ESTATE = os.environ.get("ESTATE_ROOT", ESTATE)
page = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, "docs", "reference", "security-policy.md")
rows, findings = 0, []
in_table = False
for n, line in enumerate(open(page, encoding="utf-8"), 1):
    if line.startswith("| Control"):
        in_table = True
        continue
    if in_table and line.startswith("|---"):
        continue
    if in_table and not line.startswith("|"):
        in_table = False
        continue
    if not in_table:
        continue
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    if len(cells) < 5:
        findings.append(f"{page}:{n}: row has {len(cells)} cells, needs 5")
        continue
    rows += 1
    m = re.match(r"`([^`]+)`", cells[2])
    if not m:
        findings.append(f"{page}:{n}: proof column does not start with a `command`")
        continue
    word = m.group(1).split()[0]
    ok = (
        os.path.isfile(os.path.join(ROOT, word))
        or os.path.isfile(os.path.join(ESTATE, word))
        or os.path.isfile(os.path.expanduser(word))
        or shutil.which(word) is not None
    )
    if not ok:
        findings.append(f"{page}:{n}: proof command '{word}' does not exist")
if rows == 0:
    findings.append(f"{page}: no control rows found")
for f in findings:
    print("FAIL  security-policy", f)
if findings:
    sys.exit(1)
print(f"ok    security-policy {rows} controls, every proof command exists")
