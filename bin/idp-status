#!/usr/bin/env bash
# What is serving right now, and where. One line per fact, each from a probe.
set -uo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
host=$(tailscale status --json 2>/dev/null | /usr/local/bin/jq -r '.Self.DNSName' | sed 's/\.$//')

# curl writes %{http_code} even when it fails -- "000" -- so `|| echo down`
# appends and the caller gets "000down", which matches neither. Read the code
# and decide here.
probe() {
  local c
  c=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "$1" 2>/dev/null || true)
  case "$c" in ""|000) echo "down" ;; *) echo "$c" ;; esac
}

# `localhost`, deliberately, and the reason changed today -- keep the name.
#
# It was written because the `yarn start` dev server bound [::1] only, so a
# v4 probe returned 000 and this command called the catalogue down while a
# browser on the same machine was reading it. That server is gone: the
# catalogue is a container now, and compose publishes 127.0.0.1:3100, which
# is v4. So the original reason is dead and the opposite failure is the live
# one -- a hardcoded [::1] probe would now be the broken half.
#
# `localhost` survives both because it resolves to both families and curl
# tries each in turn. That is the point: this probe should not encode which
# address family today's deployment happens to use, because it has already
# been wrong in both directions inside one day. Measured 2026-08-24 against
# the container: curl 127.0.0.1:3100/healthcheck -> 200, curl localhost -> 200.
catalogue=$(probe http://localhost:3100)

echo "SURFACE    LOCAL                  HTTP   PUBLISHED"
printf "%-10s %-22s %-6s %s\n" "catalogue" "localhost:3100 backstage" "$catalogue" "http://$host:8443/"

echo
echo "CATALOGUE"
if [ -f "$IDP/catalog/estate.db" ]; then
  taken=$(sqlite3 "$IDP/catalog/estate.db" "select taken_at from meta limit 1" 2>/dev/null)
  n=$(sqlite3 "$IDP/catalog/estate.db" "select count(*) from assets" 2>/dev/null)
  echo "  $n assets, inventory taken $taken"
else
  echo "  no estate.db -- run bin/db-gen"
fi
[ -f "$IDP/catalog/catalog-info.yaml" ] \
  && echo "  $(grep -c '^kind:' "$IDP/catalog/catalog-info.yaml") entities in catalog-info.yaml" \
  || echo "  no catalog-info.yaml -- run bin/catalog-gen"

echo
echo "REACHABILITY"
tailscale serve status 2>/dev/null | sed 's/^/  /' || echo "  tailscale serve: not configured"
funnel=$(tailscale funnel status 2>/dev/null | grep -c 'Funnel on' || true)
if [ "${funnel:-0}" -gt 0 ]; then
  echo "  PUBLIC: funnel is on -- anyone with the URL can read the catalogue"
else
  echo "  tailnet only -- not reachable from the public internet"
fi

# Exit non-zero when the catalogue is not serving. There is one surface now,
# so "down" is an outage with no second opinion to soften it, and a status
# command that returns 0 anyway cannot be used as a check.
[ "$catalogue" = "down" ] && exit 1
exit 0
