#!/usr/bin/env python3
"""claim-gate BASE HEAD -- refuse a change that nobody declared (AGENTS.md §5).

WHY. 2026-09-30: ten agents ran for two days, duplicated and overwrote each other, and nothing they
built could be pointed to as working. The founder: "we can't afford all this chaos", then "not
seeing any enforcement". AGENTS.md §5 makes every agent claim its work on a GitHub issue first;
this is the enforcement: ci-success (the one check the merge queue gates on) needs this job.

WHAT IT IS NOW (founder, 2026-10-10: "i thinkwe should just remove the claim requirement", then
"b" -- shrink it to the one thing it can actually prove). Measured that day before deciding:
of the last 20 greenlane runs, 10 succeeded, 9 were CANCELLED (superseded lanes, not refusals)
and 1 failed -- and that one failure was not this gate. So the gate is not what breaks the
pipeline, and it is not what fixes it either. What it CAN prove is the one thing the 2026-09-30
incident was actually about: that two live agents are not working the same files at the same
time. Everything that was ceremony around that is gone --

  - the `in-progress` label: a second, redundant way to say "live" when the heartbeat already
    says it, and one more thing to forget;
  - the `model=` field of the claim comment: read by nothing.

What remains, and each part is load-bearing:
    Claim: <owner>/<repo>#<number>      (or #<number> for this repository)
    Agent: <name>
and the claimed issue is open and carries a live
`CLAIM agent=<name> paths=<glob,...> heartbeat=<UTC>` comment from that same agent. `paths=` must
cover every file the change touches -- THAT is the collision check. The heartbeat (under 2 hours)
keeps it from also being a deadlock: a claim belonging to an agent that has moved on lapses by
itself, so nothing has to be closed by hand before the next person can work. Lapsing frees the
issue for the NEXT claim; it does not by itself refuse the holder's change, because until another
agent claims, nobody else holds those files.

Writing one of these is mechanical, so it is a command: bin/claim-open makes all of it true and
then runs this gate. An agent should not have to rediscover the contract by being refused.

The founder's freeze (2026-10-29) is checked here as well: a path the founder has approved is
frozen, and no claim -- not even a live one -- can land a change to it. "We kick the door and
take the keys away": the change is refused at merge time as well as at edit time.

Three exemptions, none of which trusts a git author name (anyone can type one):
  - a change whose every added and removed line carries a Flux `$imagepolicy` marker: it can only
    move image tags, the image-automation controller's job (it commits as the same
    estate-agents[bot] identity the agents use, so the name proves nothing);
  - a change whose every changed path is a dependency manifest or lockfile (dependency_pin_only):
    a bumped pin cannot carry product code, and this is judged from the diff itself, so it holds
    on the Greenlane's lane path where no pull request exists to report an author (see
    2026-10-22 below);
  - a pull request GitHub itself reports as opened by dependabot[bot] ($PR_AUTHOR).

The Greenlane lands work by pushing queue/<batch>: one squashed commit per lane whose message keeps
only the subject and `Greenlane-Head: <lane head>`. There each squashed commit is judged on its own,
its files against the claim in its lane's own commit messages.

Model-agnostic: nothing here knows which model or runtime wrote the change.
"""

from __future__ import annotations

import fnmatch
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

DEPENDABOT = "dependabot[bot]"
MAX_AGE = timedelta(hours=2)
HEAD_TRAILER = re.compile(r"^Greenlane-Head:\s*([0-9a-f]{7,40})\s*$", re.M)
RUNNER_PIN = re.compile(r"^\s*runs-on:\s*ubuntu-\d{2}\.\d{2}\s*$", re.M)
_PRS: dict[
    tuple[str, str], tuple[str, str]
] = {}  # (repo, sha) -> (pull request number, author)
CLAIM_REF = re.compile(r"^Claim:\s*(?:([\w.-]+/[\w.-]+))?#(\d+)\s*$", re.M)
AGENT = re.compile(r"^Agent:\s*(\S+)\s*$", re.M)
CLAIM = re.compile(
    r"^CLAIM\s+agent=(?P<agent>\S+)\s+(?:model=\S+\s+)?paths=(?P<paths>\S+)\s+"
    r"heartbeat=(?P<hb>\S+)\s*$",
    re.M,
)
PROOF = re.compile(r"^Proof:\s*(?P<ids>[^\n]+?)\s*$", re.M)

# The truth obligation. The estate had a process for ownership and a process for code and no
# process for truth, so on 2026-10-29 every gate was green while the founder's path answered
# nothing (founder: "we are totally out of touch with reality and no sense or awareness of
# implications of our decisions"; "a claim should have come with proof"; "following estate rules
# must not be optional"). The contract says which path answers which predicate; the snapshot is
# the measurement; and this gate refuses a change whose evidence is missing, unknown, or silent.
TRUTH_CONTRACT_REL = "catalog/truth-contract.json"
TRUTH_SNAPSHOT_REL = "catalog/truth-verdicts.json"
# A measurement older than this is not evidence about now. Seven days: the instrument runs every
# fifteen minutes on the laptop and every fifteen minutes on a runner, so a week-old snapshot
# means the instrument stopped, not that the estate is quiet.
TRUTH_MAX_AGE = timedelta(days=7)
TRUTH_OK = "MEASURED_OK"
TRUTH_FAIL = "MEASURED_FAIL"
TRUTH_UNKNOWN = "UNKNOWN"


def truth_problems(
    text: str, files: list[str], now: datetime, root: Path | None = None
) -> list[str]:
    """The proof obligation, enforced.

    A change that touches a path named by the truth contract must carry the measurement of the
    predicate that path answers. There are three cases and no fourth:

      - the predicate has no measurement at all -> REFUSE: unknown is never ok;
      - the predicate is UNKNOWN -> REFUSE: unknown is never ok;
      - the predicate is MEASURED_FAIL -> the change must NAME it in a `Proof:` trailer, so a
        change that lands while the founder's path is broken cannot land in silence.

    A predicate that is MEASURED_OK asks for nothing: the measurement already proves it, and a
    gate that asks for more would be ceremony.

    WHAT THIS GATE CANNOT DO, SAID PLAINLY: it cannot prove the measurement was true. The
    snapshot is a witness, and a witness in a repository can be written by the person it is
    about. That is why the measurement is also published to the claim issue (durable, off the
    machine, in the founder's eyes) and why the snapshot is refused when it is stale. The gate
    enforces EVIDENCE, FRESHNESS and ACKNOWLEDGEMENT; whether the change addresses the failure
    it names stays a human judgement, and pretending otherwise would be a gate that cannot fail.
    """
    root = root or (Path(__file__).resolve().parent.parent)
    contract_path = root / TRUTH_CONTRACT_REL
    if not contract_path.is_file():
        return []  # the law is not installed on this tree; nothing to enforce
    try:
        contract = json.loads(contract_path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return [f"the truth contract cannot be read: {exc}"]
    wanted: set[str] = set()
    for pattern, ids in (contract.get("paths") or {}).items():
        if any(covered_by(f, pattern) for f in files):
            wanted.update(i for i in ids if i)
    if not wanted:
        return []
    problems: list[str] = []
    snapshot_path = root / TRUTH_SNAPSHOT_REL
    if not snapshot_path.is_file():
        return [
            "the change touches a truth path (%s) and there is no measurement: %s is absent. "
            "Run bin/idp-estate-truth --write-snapshot %s and land it."
            % (", ".join(sorted(wanted)), TRUTH_SNAPSHOT_REL, TRUTH_SNAPSHOT_REL)
        ]
    try:
        snapshot = json.loads(snapshot_path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        return [f"the truth snapshot cannot be read: {exc}"]
    measured = {p.get("id"): p for p in (snapshot.get("predicates") or [])}
    generated = snapshot.get("generated_at")
    try:
        when = datetime.fromisoformat(str(generated).replace("Z", "+00:00"))
    except (TypeError, ValueError):
        when = None
    if when is None:
        problems.append(
            "the truth snapshot carries no usable generated_at (%r): it cannot be evidence"
            % generated
        )
    elif now - when > TRUTH_MAX_AGE:
        problems.append(
            "the truth snapshot is %d days old (%s): a stale measurement is not evidence about "
            "now. Run bin/idp-estate-truth --write-snapshot %s and land it."
            % ((now - when).days, generated, TRUTH_SNAPSHOT_REL)
        )
    named = set()
    for match in PROOF.finditer(text):
        named.update(i.strip() for i in match.group("ids").split(",") if i.strip())
    for pid in sorted(wanted):
        pred = measured.get(pid)
        if pred is None:
            problems.append(
                "the change touches a truth path and the predicate %s has NO measurement: "
                "unknown is never ok" % pid
            )
            continue
        verdict = pred.get("verdict")
        if verdict == TRUTH_UNKNOWN:
            problems.append(
                "the predicate %s is UNKNOWN (%s): unknown is never ok, so this change cannot "
                "land on an unmeasured path" % (pid, pred.get("detail", "")[:120])
            )
        elif verdict == TRUTH_FAIL:
            if pid not in named:
                problems.append(
                    "the predicate %s is MEASURED_FAIL (%s): the founder's path is broken and this "
                    "change lands on it. Name it in the commit message: `Proof: %s`"
                    % (pid, pred.get("detail", "")[:120], pid)
                )
    return problems


def frozen_problems(files: list[str]) -> list[str]:
    """The founder-approved paths this change touches. A claim is not an approval."""
    gov_root = os.path.join(
        os.path.dirname(os.path.realpath(__file__)), "..", "platform", "estate"
    )
    if gov_root not in sys.path:
        sys.path.insert(0, gov_root)
    try:
        from governance import freeze  # type: ignore
    except ImportError:
        return []
    problems = []
    for path in files:
        frozen, entry = freeze.is_frozen(path)
        if frozen:
            problems.append(
                f"{path} is frozen by founder approval "
                f"({entry.get('approval', 'unknown')}): no agent may change founder-approved "
                "work. The keys are taken away until the founder approves a new change "
                f"(bin/estate-freeze --release '{entry.get('pattern')}' --approval '<approval>')"
            )
    return problems


def covered_by(path: str, pattern: str) -> bool:
    """Does one `paths=` entry of a claim cover this file?

    A claimant may name a file literally, and a Next.js dynamic route's literal path carries glob
    metacharacters: `web/app/writing/[slug]/page.tsx`. `claim-open` posts the changed files as
    literals, so a claim routinely holds that exact string -- and `fnmatch` reads `[slug]` as a
    character class, so the file matched nothing and could not satisfy its own claim (measured
    2026-10-17: `FAIL claim-gate 1 file(s) outside every claim's paths:
    web/app/writing/[slug]/page.tsx`). Equality first: a claimant who names a file has claimed
    that file. The glob stays, because `paths=web/**` is how a lane claims a tree.
    """
    return path == pattern or fnmatch.fnmatch(path, pattern)


def git(*a: str) -> str:
    return subprocess.run(  # noqa: S603 -- fixed argv, no shell
        ["git", *a],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
    ).stdout


def gh_json(path: str) -> object:
    out = subprocess.run(  # noqa: S603 -- fixed argv, no shell
        ["gh", "api", "--paginate", "--slurp", path],  # noqa: S607
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    pages = json.loads(out)  # --slurp: one JSON array holding every page
    if pages and all(isinstance(p, list) for p in pages):
        return [item for page in pages for item in page]
    return pages[0] if len(pages) == 1 else pages


def has_commit(sha: str) -> bool:
    return (
        subprocess.run(  # noqa: S603 -- fixed argv, no shell
            ["git", "cat-file", "-e", f"{sha}^{{commit}}"],  # noqa: S607
            capture_output=True,
        ).returncode
        == 0
    )


def lane_text(base: str, lane_head: str, squash: str) -> str:
    """The commit messages of the lane a squash came from.

    2026-10-08, PR #5511: land() force-pushes the squash onto the PR branch, so the lane head
    the trailer names is no longer on any ref; `git log base..<head>` exited 128, claim-gate went
    red on a change it had passed minutes earlier, and the lane requeued twice. GitHub still
    serves an unreferenced commit by full sha, so fetch it; failing that, the squash carries the
    lane's own message body (greenlane/github.py), which is what a plain PR is judged on anyway.
    """
    if not has_commit(lane_head):
        subprocess.run(  # noqa: S603 -- fixed argv, no shell
            ["git", "fetch", "-q", "--no-tags", "origin", lane_head],  # noqa: S607
            capture_output=True,
        )
    if has_commit(lane_head):
        return git("log", "--format=%B", f"{base}..{lane_head}")
    return git("log", "-1", "--format=%B", squash)


# Paths a dependency bot touches whose content cannot execute at all.
DEPENDENCY_ONLY = re.compile(
    r"^(?:.*/)?(?:requirements[^/]*\.txt|constraints[^/]*\.txt|"
    r"[^/]*\.lock|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|"
    r"go\.mod|go\.sum|uv\.lock|poetry\.lock|Pipfile\.lock|Cargo\.lock|composer\.lock)$"
)

# A manifest that can carry code, allowed only when the diff of it is a pin: a `"name": "range"`
# line or a brace/comma. A `"scripts": {` line -- and any lifecycle hook -- is not allowed, so a
# change that adds `"postinstall"` still needs a claim. `pyproject.toml`, `Cargo.toml`, `Gemfile`
# and `Pipfile` are not listed: their pin syntax is not JSON and a mistake there is a code path, so
# a lane touching one falls through to the claim check.
MANIFESTS_WITH_HOOKS = re.compile(r"^(?:.*/)?package\.json$")
MANIFEST_PIN_LINE = re.compile(r'^[+-]\s*"[^"]+"\s*:\s*"[^"]*"\s*,?\s*$')
MANIFEST_HOOK_LINE = re.compile(
    r'^[+-]\s*"(?:(?:pre|post)?(?:install|pack|publish|version)|prepare|prepublishOnly|'
    r'scripts|dependencies|devDependencies|peerDependencies|optionalDependencies)"\s*:',
    re.I,
)
STRUCTURAL_LINE = re.compile(r"^[+-]\s*[{}\[\],]*\s*$")


def _lines_by_file(diff: str) -> dict[str, list[str]]:
    """The changed (+) and removed (-) lines of a diff, attributed to the file they belong to."""
    out: dict[str, list[str]] = {}
    current = ""
    for ln in diff.splitlines():
        if ln.startswith("diff --git "):
            current = ln.split(" b/", 1)[-1]
            out.setdefault(current, [])
            continue
        if ln.startswith(("+++", "---")) or not current:
            continue
        if ln[:1] in "+-":
            out[current].append(ln)
    return out


def _manifest_is_a_pin(lines: list[str]) -> bool:
    if not lines or any(MANIFEST_HOOK_LINE.match(ln) for ln in lines):
        return False
    return all(MANIFEST_PIN_LINE.match(ln) or STRUCTURAL_LINE.match(ln) for ln in lines)


def dependency_pin_only(files: list[str], diff: str = "") -> bool:
    """Every changed path is a dependency pin: the bots' own work, which belongs to nobody's claim.

    Measured 2026-10-22 on refs/greenlane/state: 156 of the last 200 queue batches were red, and
    the failing rung was claim-gate on `lane/dependabot/...` lanes -- `lane b4fa355f7: no `Claim:
    <owner>/<repo>#<n>` line` -- while their pull requests are open and authored by
    dependabot[bot]. The exemption the gate already documents never fired there: it is keyed on
    $PR_AUTHOR, CI's pull_request event, and the Greenlane judges a LANE, which carries no pull
    request at all. One red batch costs a whole CI run plus a bisection, so four dependency lanes
    were eating the queue and real work sat behind them.

    This is the same shape as image_bump_only and runner_pin_only: decide it from the diff, so it
    cannot depend on which event is running the gate and it cannot be wrong about who typed what.
    Two kinds of path qualify: files whose content cannot execute at all (lockfiles, go.mod/go.sum,
    requirements/constraints text), and `package.json` when its diff is nothing but a version pin --
    dependabot's npm lanes change package.json next to yarn.lock, and refusing those keeps the
    queue red forever. Everything else (a workflow, a Dockerfile, a source file, a manifest that
    adds a script or a lifecycle hook) falls through to the claim check as before.
    """
    if not files:
        return False
    changed = _lines_by_file(diff) if diff else {}
    for f in files:
        if DEPENDENCY_ONLY.match(f):
            continue
        if MANIFESTS_WITH_HOOKS.match(f) and _manifest_is_a_pin(changed.get(f, [])):
            continue
        return False
    return True


def image_bump_only(diff: str) -> bool:
    """Every changed line (not the +++/--- headers) carries a Flux image-policy marker."""
    changed = [
        ln
        for ln in diff.splitlines()
        if ln[:1] in "+-" and not ln.startswith(("+++", "---"))
    ]
    return bool(changed) and all("$imagepolicy" in ln for ln in changed)


def runner_pin_only(diff: str) -> bool:
    """Every non-header changed line is in a GitHub Actions workflow and is either a
    `runs-on: ubuntu-NN.NN` pin or indented content within it.

    GitHub retires ubuntu-latest on a schedule; pinning to a specific version is mechanical
    infrastructure hygiene that does not belong to any agent. Like image bumps it
    requires no claim, and for the same reason: it is the platform's own maintenance, not
    a product change.
    """
    changed = [
        ln
        for ln in diff.splitlines()
        if ln[:1] in "+-" and not ln.startswith(("+++", "---"))
    ]
    if not changed:
        return False
    in_workflow = False
    for ln in changed:
        stripped = ln.lstrip("+- ")
        if stripped.startswith("jobs:") or stripped.startswith("jobs."):
            in_workflow = True
        if stripped.startswith("runs-on:"):
            if not RUNNER_PIN.match(ln.lstrip("+-")):
                return False
            in_workflow = True
    if not in_workflow:
        # A new workflow file has no `jobs:` line in the diff; detect it by all
        # non-header lines being indented (they are the file body).
        return all(ln[1:].startswith(" ") or ln[1:].startswith("\t") for ln in changed)
    return True


def verdict(text: str, files: list[str], repo: str, fetch, now: datetime) -> list[str]:
    """The reasons this change may not land; empty means it passes. `fetch(repo, n)` returns
    (issue dict, comments list)."""
    refs = CLAIM_REF.findall(text)
    # The same issue, once per commit (2026-10-28). A lane's commits each carry the two
    # trailers, so the text this gate reads -- `git log --format=%B base..head` -- holds one
    # `Claim:` line per commit. Measured on a 16-commit lane with two issues: 32 Claim lines, 32
    # issue lookups and 32 comment lookups, 27s of GitHub API, and lane-submit's 40s step was
    # killed before the push it had already proved. The lookups answer the same question every
    # time: an issue is open or it is not, and its newest CLAIM comment is one comment. So each
    # distinct (repo, issue) is fetched once, and the verdict is the one the repeats produced.
    seen: set[tuple[str, str]] = set()
    unique_refs: list[tuple[str, str]] = []
    for ref in refs:
        if ref in seen:
            continue
        seen.add(ref)
        unique_refs.append(ref)
    refs = unique_refs
    agents = AGENT.findall(text)
    if not refs:
        return [
            "no `Claim: <owner>/<repo>#<n>` line: declare the work on an issue first. EXACT SHAPE: the line is `Claim: owner/repo#123` ALONE on its line (nothing else on it, one space after the colon), followed by `Agent: <name>` alone on its own line. Run bin/claim-open to stamp both."
        ]
    if not agents:
        return [
            "no `Agent: <name>` line: the change must say which agent's claim it lands on"
        ]
    # 2026-10-12: `git log --format=%B` prints newest first, so `agents[-1]` was the OLDEST
    # commit's trailer. A range naming two agents therefore passed whenever the claim holder
    # happened to be the older one; measured on this tree, a range naming idp-60 and idp-99 was
    # judged clear against a claim held by idp-99 while idp-60 wrote to the claimed files. The
    # one thing this gate can prove is that two live agents are not working the same files
    # (AGENTS.md §5), so every name in the range must be the claimant's -- a range that names
    # two agents is not one agent's change, and no single claim covers it.
    named = sorted(set(agents))
    if len(named) > 1:
        return [
            "the change names %d agents (%s): one claim covers one agent's work, so this range "
            "cannot land as it stands -- rebase so it carries only the claimant's commits"
            % (len(named), ", ".join(named))
        ]
    agent = named[0]
    problems: list[str] = []
    covered: set[str] = set()
    for ref_repo, num in refs:
        where = f"{ref_repo or repo}#{num}"
        issue, comments = fetch(ref_repo or repo, int(num))
        if issue.get("state") != "open":
            problems.append(f"{where} is not open")
            continue
        # 2026-10-10: no `in-progress` label check. The label was a second way to say the same
        # thing the heartbeat already says, and the only thing it added was one more requirement
        # to satisfy before a change could land. Liveness is the heartbeat, below.
        claims = [m for c in comments for m in CLAIM.finditer(c.get("body", ""))]
        if not claims:
            problems.append(f"{where} has no CLAIM comment")
            continue
        c = claims[-1]
        if c["agent"] != agent:
            problems.append(f"{where} is claimed by {c['agent']}, not {agent}")
            continue
        try:
            hb = datetime.fromisoformat(c["hb"].replace("Z", "+00:00"))
        except ValueError:
            problems.append(f"{where} heartbeat {c['hb']!r} is not a UTC ISO time")
            continue
        # 2026-10-14: an old heartbeat alone no longer refuses. The two hours exist so an
        # abandoned claim stops blocking OTHER agents (AGENTS.md §5.4): once lapsed, anyone may
        # post their own CLAIM, and that newer comment fails the `claimed by` check above. Until
        # someone does, the newest claim is still this agent's and nobody else holds the files,
        # which is the one thing this gate proves. Refusing it anyway turned every pull request
        # that waited two hours red with no change to it -- #6198 and #6208, measured 10-14, the
        # moment Greenlane (the only thing that re-stamps a waiting lane's heartbeat) went red.
        if hb > now + MAX_AGE:
            problems.append(f"{where} heartbeat {c['hb']!r} is in the future")
            continue
        globs = [g for g in c["paths"].split(",") if g]
        covered |= {f for f in files if any(covered_by(f, g) for g in globs)}
    # demo-render pushes updated demo GIFs onto every lane branch whenever main advances.
    # They are auto-generated infrastructure, not product changes, and do not belong to any agent's
    # claim. Like runner-pins they require no claim: they are the platform's own housekeeping.
    DEMOS_EXEMPT = re.compile(r"^docs/demos/[^/]+$")
    # The registry witness is generated too, and by the same argument it must not belong to a
    # claim: .github/workflows/registry-snapshot.yml regenerates it from the pull request's own
    # tree and commits it as the bot, so the agent that built a component never has to touch it.
    # Its CONTENT is not unchecked here -- bin/registry-gate proves the committed witness equals
    # a fresh generation, inside the required ci checks, so a hand-edited witness is refused
    # there. Two layers, each doing its own job: this one says who owns the file (nobody), that
    # one says whether it is true (the gate).
    WITNESS_EXEMPT = re.compile(r"^catalog/estate-capability-registry\.json$")
    # The truth snapshot is a witness too: it is written by the instrument, not by an agent,
    # and it is refreshed on a schedule. It is exempt from the CLAIM requirement, and its
    # CONTENT is checked where it matters -- bin/claim-gate's truth obligation, which refuses a
    # change on a truth path when the snapshot is missing, stale, unknown or failing.
    TRUTH_WITNESS_EXEMPT = re.compile(r"^catalog/truth-verdicts\.json$")
    outside = [
        f
        for f in files
        if f not in covered
        and not DEMOS_EXEMPT.match(f)
        and not WITNESS_EXEMPT.match(f)
        and not TRUTH_WITNESS_EXEMPT.match(f)
    ]
    if not problems and outside:
        problems.append(
            f"{len(outside)} file(s) outside every claim's paths: {', '.join(outside[:10])}"
        )
    # The founder's freeze: a founder-approved path is frozen, and no claim -- not even a live
    # one -- can land a change to it. The keys are taken away at merge time as well as at edit
    # time, so a session that bypassed the write gate still cannot land the change.
    problems += frozen_problems(files)
    # The truth obligation runs after the claim check, so the message a change's author reads
    # is about the claim first and about the evidence second: the claim says who owns the
    # files, the evidence says whether the thing those files carry works.
    problems.extend(truth_problems(text, files, now))
    return problems


def judge(
    base: str, head: str, repo: str, fetch, now: datetime, pr_body: str, pr_author: str
) -> list[str]:
    if pr_author == DEPENDABOT:
        return []
    commits = [c for c in git("rev-list", "--reverse", f"{base}..{head}").split() if c]
    lanes = [
        (c, HEAD_TRAILER.search(git("log", "-1", "--format=%B", c))) for c in commits
    ]
    if commits and all(m for _, m in lanes):
        problems: list[str] = []
        for c, m in lanes:
            diff = git("show", "--format=", c)
            if image_bump_only(diff):
                continue
            if runner_pin_only(diff):
                continue
            files = [
                f
                for f in git(
                    "diff-tree", "--no-commit-id", "-r", "--name-only", c
                ).split("\n")
                if f
            ]
            if dependency_pin_only(files, diff):
                continue
            lane_head = m.group(1)
            text = lane_text(base, lane_head, c) + "\n" + lane_body(repo, lane_head, c)
            problems += [
                f"lane {lane_head[:9]}: {p}"
                for p in verdict(text, files, repo, fetch, now)
            ]
        return problems
    diff = git("diff", f"{base}...{head}")
    if image_bump_only(diff):
        return []
    if runner_pin_only(diff):
        return []
    files = [f for f in git("diff", "--name-only", f"{base}...{head}").split("\n") if f]
    if dependency_pin_only(files, diff):
        return []
    text = git("log", "--format=%B", f"{base}..{head}") + "\n" + pr_body
    return verdict(text, files, repo, fetch, now)


def pr_of_head(repo: str, head: str) -> tuple[str, str]:
    """(number, author) of the open pull request whose head is `head`, or ("", "").

    ci-success hands this gate the pull request in the environment (PR_NUMBER/PR_BODY/
    PR_AUTHOR, .github/workflows/ci.yml), because a pull_request event carries it. The Greenlane
    runs the same gate one stage earlier, on a LANE -- a branch -- and exports none of it
    (greenlane/github.py::unclaimed passes only GITHUB_REPOSITORY). That was invisible while
    every lane declared its two trailers in a commit message, and became a false `no live claim`
    the moment one declared them in its pull request body -- which AGENTS.md §5 rule 5 allows
    ("in a commit message (or the PR body)"), which judge() reads (it appends the body), and
    which both #6202 and #6198 did.

    Measured 2026-10-15 against a clean origin/main, greenlane holding both with
    `no live claim: no `Claim: <owner>/<repo>#<n>` line` while both were green and mergeable:

        PR_NUMBER unset  -> FAIL  claim-gate  no `Claim: <owner>/<repo>#<n>` line
        PR_NUMBER=6202   -> ok    claim-gate  no other live agent holds these files

    Asking GitHub which pull request this sha is the head of supplies the same fact CI is handed,
    so the lane stage and the queue cannot answer the same question differently.
    """
    # Resolve a ref name to a sha before asking GitHub (GitHub needs a sha).
    resolved = (
        subprocess.run(  # noqa: S603, S607 -- fixed argv, no shell
            ["git", "rev-parse", head],
            capture_output=True,
            text=True,
        ).stdout.strip()
        if not re.match(r"^[0-9a-f]{7,40}$", head)
        else head
    )
    key = (repo, resolved)
    if key not in _PRS:
        _PRS[key] = ("", "")
        try:
            p = subprocess.run(  # noqa: S603, S607 -- fixed argv, no shell
                ["gh", "api", f"repos/{repo}/commits/{resolved}/pulls"],
                capture_output=True,
                text=True,
                timeout=30,
            )
            found = json.loads(p.stdout or "[]") if p.returncode == 0 else []
        except Exception:
            found = []
        for pr in found if isinstance(found, list) else []:
            if pr.get("state") == "open":
                _PRS[key] = (
                    str(pr.get("number", "")),
                    ((pr.get("user") or {}).get("login") or ""),
                )
                break
    return _PRS[key]


def pr_context(repo: str, head: str) -> tuple[str, str]:
    """The pull request this run judges: CI's environment first, GitHub's answer second.

    CI sets both variables, so it pays nothing for this. The lane stage sets neither, which is
    the whole defect -- it now asks which pull request this sha is the head of.
    """
    num = os.environ.get("PR_NUMBER", "")
    author = os.environ.get("PR_AUTHOR", "")
    if num and author:
        return num, author
    found_num, found_author = pr_of_head(repo, head)
    return num or found_num, author or found_author


def lane_body(repo: str, lane_head: str, squash: str) -> str:
    """The body of the pull request a landed lane came from, or "".

    judge()'s lane path reads the LANE BRANCH's commit messages (lane_text), so a lane whose two
    trailers live in its pull request body was refused here even after the lane stage admitted it
    -- the same blindness, one stage later. Try the head the trailer names, then the squash the
    batch carries: whichever GitHub still associates with the pull request."""
    for sha in (lane_head, squash):
        num, _ = pr_of_head(repo, sha)
        if num:
            return live_body(repo, num)
    return ""


def live_body(repo: str, num: str = "") -> str:
    """The PR body as it is now, not as the opening-day event snapshot carried it (idp#5758:
    a re-run judges github.event.pull_request.body from the original event, so a trailer fix
    in the body stayed invisible and the gate failed identically). Falls back to the snapshot
    when there is no PR number or the fetch fails -- CI still runs the same gate."""
    num = num or os.environ.get("PR_NUMBER", "")
    if not num:
        return os.environ.get("PR_BODY", "")
    p = subprocess.run(  # noqa: S603, S607 -- fixed argv, no shell
        ["gh", "api", f"repos/{repo}/pulls/{num}", "--jq", ".body"],
        capture_output=True,
        text=True,
        timeout=30,
    )
    if p.returncode == 0:
        return p.stdout or ""
    return os.environ.get("PR_BODY", "")


def repo_slug() -> str:
    """owner/repo: CI's GITHUB_REPOSITORY, else the checkout's own (as bin/claim-open finds it).

    Read straight from the environment, the gate crashed `KeyError: 'GITHUB_REPOSITORY'` on the
    laptop, where nothing exports it -- so `bin/claim-gate base HEAD` by hand, the command its own
    refusals tell an agent to run, died with a traceback instead of a verdict (2026-10-21, #6791).
    """
    slug = os.environ.get("GITHUB_REPOSITORY", "").strip()
    if slug:
        return slug
    p = subprocess.run(  # noqa: S603 -- fixed argv, no shell
        ["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],  # noqa: S607
        capture_output=True,
        text=True,
        timeout=30,
    )
    slug = (p.stdout or "").strip() if p.returncode == 0 else ""
    if not slug:
        raise SystemExit(
            "BLIND claim-gate  no GITHUB_REPOSITORY and `gh repo view` could not name the repo: "
            + (p.stderr or "").strip()[:200]
        )
    return slug


def main(argv: list[str]) -> int:
    base, head = argv[1], argv[2]
    repo = repo_slug()
    num, author = pr_context(repo, head)

    def fetch(r: str, n: int):
        return gh_json(f"repos/{r}/issues/{n}"), gh_json(
            f"repos/{r}/issues/{n}/comments?per_page=100"
        )

    problems = judge(
        base,
        head,
        repo,
        fetch,
        datetime.now(timezone.utc),
        live_body(repo, num),
        author,
    )
    for p in problems:
        print(f"FAIL  claim-gate  {p}")
    if not problems:
        print("ok    claim-gate  no other live agent holds these files")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
