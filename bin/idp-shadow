#!/usr/bin/env python3
"""Prove a change converges by handing it to the environment, not by applying it (spec W2).

WHAT CHANGED AND WHY (founder 2026-09-21, four rulings in one breath):
  "we going for mathematical guarantees"
  "agents are not deploying, the environment is"
  "i dont want agents anywhere near production cluster"
  "they do their work, handover to environment to verify and deploy"

The version of this tool deleted here did the opposite of all four. It read the OKE host cluster's
`vc-demo-sandbox` Secret -- the CI-held cluster credential clusters/oke/sandbox.yaml exists to
forbid -- and then ran `kubectl apply` into the vcluster itself. That is an agent standing next to
production, deploying. Its verdict was then written to /tmp as JSON and handed to a grader, so the
"proof" was a file this process had just authored about its own work.

WHAT IT DOES NOW. The agent's work ends at a commit. This driver hands that commit to Flux -- the
same reconciler that runs production -- inside a Kubernetes cluster it creates from nothing and
destroys at the end, and then *reads back* what really happened:

  1. `up`      k3d creates a throwaway cluster; `flux install` puts the environment in it.
               No estate credential is read, held or needed: the cluster did not exist a minute
               ago and will not exist in a minute.
  2. `verify`  a git daemon serves this working tree on loopback; a Flux GitRepository is pinned to
               the exact commit under test and a Flux Kustomization per changed path reconciles it
               with `wait: true`. FLUX applies the change. This process applies nothing. Then the
               real .status of every workload Flux actually created is read out of the API server
               and graded by bin/idp-shadow-verify, fail-closed.
  3. `down`    the cluster is deleted; nothing survives, by design.

WHERE THE GUARANTEE COMES FROM. Not from this file's opinion. From three facts that are checkable
after the run: Flux's own Kustomization Ready condition, the applied inventory Flux reports, and
each workload's .status as the API server recorded it. A workload the reconcile never created is
absent from the inventory and fails; a workload that never became Ready fails; silence fails.

  bin/idp-shadow up
  bin/idp-shadow verify --head <sha> [--path platform/x ...] [--record out.json]
  bin/idp-shadow judge --head-record head.json [--base-record base.json]
  bin/idp-shadow down

THE PR IS GRADED ON WHAT IT CHANGED (2026-10-14, #6194). A shadow run reconciles each changed
path on a cluster that holds only the floor, so a path whose namespace, CRD or database secret
lives in another row fails there on every commit, the PR's or not. #6194 was 24 lines of newTag:
bumps and went red on 14 of its 15 paths: commerce/app (namespace from platform/commerce/data),
jit (namespace agents from platform/rbac-floor), nodesoftware-operator (ServiceMonitor CRD from
clusters/oke/monitoring.yaml), dagster (secret estate-db-dagster from platform/estate-db/cluster),
observability (superset-memory-seed writes to a superset database the shadow does not have), and
eight more charged with dagster's pod because the pod watch read every pod in the cluster. So:
  - a stuck pod is charged only to the Kustomization whose objects own it (owned_by), and
  - CI runs the same paths at the PR's merge-base beside the head (`verify --record` twice), and
    `judge` fails the PR only for a failure the base does not show. A base run that is missing or
    BLIND excuses nothing: the head's failures then stand exactly as before.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
# The tree under test. It defaults to this checkout; CI points it at a clone of the commit being
# proved (the head, or the merge-base for the base run), so the tool that grades is the one this
# checkout carries while the rows, stand-ins and served commit all come from the commit itself.
REPO = os.environ.get("IDP_SHADOW_TREE") or os.path.dirname(HERE)
VERIFY = os.path.join(HERE, "idp-shadow-verify")
SYNC = os.path.join(HERE, "idp-shadow-sync")

CLUSTER = os.environ.get("IDP_SHADOW_CLUSTER", "shadow")
GIT_PORT = int(os.environ.get("IDP_SHADOW_GIT_PORT", "9418"))
# Inside a k3d node the runner's loopback is reachable under this name; k3d writes it into
# every node's /etc/hosts. This is why no credential and no public URL are involved.
GIT_HOST = "host.k3d.internal"
WORKLOAD_KINDS = ("Deployment", "StatefulSet", "DaemonSet", "Job", "CronJob")

# Waiting states the kubelet retries forever but that never become Ready on their own
# (#5710): a container that dies on every start, an image ref that does not resolve, a
# Secret or ConfigMap that does not exist. Flux keeps the Kustomization in Progressing
# while they retry -- that is Flux's job -- so only a direct watch of the pods can end
# the run before the full deadline.
POD_DOOM_REASONS = frozenset(
    (
        "CrashLoopBackOff",
        "ImagePullBackOff",
        "ErrImagePull",
        "CreateContainerConfigError",
        "CreateContainerError",
        "RunContainerError",
        "InvalidImageName",
        "ErrImageNeverPull",
    )
)
# A state must persist this long before it is a verdict: a first pull attempt shows
# ErrImagePull, a Secret the vault stand-in has not written yet shows
# CreateContainerConfigError, and an app that retries its way to green crash-loops a
# few times first. 30s of uninterrupted doom means roughly four failed starts with no
# recovery, which no workload that passes its own probes ever shows.
POD_GRACE = float(os.environ.get("IDP_SHADOW_POD_GRACE", "30"))


def sh(argv, check=True, timeout=600, env=None):
    p = subprocess.run(
        argv,
        capture_output=True,
        text=True,
        timeout=timeout,
        env=env or os.environ.copy(),
    )
    if check and p.returncode != 0:
        raise RuntimeError(
            f"{' '.join(argv[:5])}... exited {p.returncode}\n"
            f"{(p.stderr or p.stdout).strip()[-800:]}"
        )
    return p


def have(tool):
    from shutil import which

    return which(tool) is not None


def kube(argv, check=True, timeout=300):
    return sh(["kubectl"] + argv, check=check, timeout=timeout)


# ---------------------------------------------------------------- up


def up():
    """Create the throwaway cluster and install the environment into it."""
    for tool in ("k3d", "kubectl", "flux"):
        if not have(tool):
            return 2, [f"{tool} is not installed; this run proves nothing"]

    existing = sh(["k3d", "cluster", "list", "-o", "json"], check=False)
    names = []
    if existing.returncode == 0:
        try:
            names = [c.get("name") for c in json.loads(existing.stdout or "[]")]
        except json.JSONDecodeError:
            names = []
    if CLUSTER in names:
        print(f"ok      shadow  cluster {CLUSTER} already up")
    else:
        # A single node, no traefik, no servicelb: the same shape platform/k3d/estate.yaml
        # argues for, minus the fixed host port, because this one is disposable and parallel.
        sh(
            [
                "k3d",
                "cluster",
                "create",
                CLUSTER,
                "--servers",
                "1",
                "--agents",
                "0",
                "--no-lb",
                "--k3s-arg",
                "--disable=traefik@server:*",
                "--k3s-arg",
                "--disable=servicelb@server:*",
                "--k3s-arg",
                "--disable=metrics-server@server:*",
                "--wait",
                "--timeout",
                "300s",
            ],
            timeout=600,
        )
        print(
            f"ok      shadow  cluster {CLUSTER} created (throwaway; no estate credential involved)"
        )

    sh(
        [
            "k3d",
            "kubeconfig",
            "merge",
            CLUSTER,
            "--kubeconfig-merge-default",
            "--kubeconfig-switch-context",
        ]
    )
    # The environment itself. Production runs these same controllers.
    sh(
        [
            "flux",
            "install",
            "--components",
            "source-controller,kustomize-controller,helm-controller",
        ],
        timeout=600,
    )
    print(
        "ok      shadow  flux installed -- from here the environment deploys, not this process"
    )
    return 0, []


# ---------------------------------------------------------------- verify


def serve_tree():
    """Serve this working tree read-only on loopback so Flux can clone the commit under test.

    No token, no remote, no network beyond the runner: the source of truth for a shadow run is the
    tree the agent actually produced, not whatever a remote branch happens to hold.
    """
    # R20 (the gateway is the only process that binds a non-loopback address) is in tension with
    # this listener: k3d nodes reach the runner through host.k3d.internal, which resolves to the
    # docker bridge, so a loopback-only bind is unreachable from inside the cluster and the whole
    # scheme stops working. This binds the bridge for the lifetime of one verify() call on an
    # ephemeral CI runner and is torn down in the finally: below. It is a real exception to R20,
    # named here rather than taken quietly; bin/bind-audit will see it if it runs on a laptop.
    # HTTP, NOT `git daemon`. The first version of this ran `git daemon` and pointed the
    # GitRepository at `git://host.k3d.internal:PORT/idp`. Flux REJECTS the git:// scheme at
    # admission -- measured 2026-09-23, the only two runs this check has ever had:
    #
    #   The GitRepository "shadow" is invalid: spec.url: Invalid value:
    #   "git://host.k3d.internal:9418/idp": spec.url in body should match '^(http|https|ssh)://.*$'
    #
    # So the check could NEVER pass, on any commit, and it is on the required list. `git
    # http-backend` is the same read-only service over a scheme Flux accepts, and it ships with
    # git (no new dependency). One process, one port, torn down in the finally: below.
    parent = os.path.dirname(REPO)
    backend = (
        subprocess.check_output(["git", "--exec-path"], text=True).strip()
        + "/git-http-backend"
    )
    daemon = subprocess.Popen(
        [sys.executable, "-c", _HTTP_GIT_SERVER, backend, parent, str(GIT_PORT)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(2)
    if daemon.poll() is not None:
        raise RuntimeError(
            f"git http-backend server exited immediately (port {GIT_PORT} taken?)"
        )
    return daemon


# The smallest HTTP wrapper that speaks `git http-backend`'s CGI contract for a READ-ONLY,
# unauthenticated, single-purpose export of one repo. No upload-pack write path is reachable:
# the only service advertised is git-upload-pack, and the child gets GIT_HTTP_EXPORT_ALL off so
# a path outside the base is refused. This is a test harness on an ephemeral runner.
_HTTP_GIT_SERVER = r"""
import os, subprocess, sys
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

BACKEND, BASE, PORT = sys.argv[1], sys.argv[2], int(sys.argv[3])


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self._backend("GET")

    def do_POST(self):
        self._backend("POST")

    def _backend(self, method):
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else b""
        path, _, query = self.path.partition("?")
        env = dict(os.environ)
        env.update({
            "GIT_PROJECT_ROOT": BASE,
            "GIT_HTTP_EXPORT_ALL": "1",
            "REQUEST_METHOD": method,
            "PATH_INFO": path,
            "QUERY_STRING": query,
            "CONTENT_TYPE": self.headers.get("Content-Type", ""),
            "CONTENT_LENGTH": str(len(body)),
            "GATEWAY_INTERFACE": "CGI/1.1",
            "SERVER_PROTOCOL": "HTTP/1.1",
        })
        p = subprocess.run([BACKEND], input=body, capture_output=True, env=env)
        # CGI output is `headers \r\n\r\n body`. The first version unpacked these the other way
        # round, so the HEADERS were written as the body and the BODY parsed as headers --
        # measured as "Header without colon" from git's client. Name them for what they are.
        head, _, payload = p.stdout.partition(b"\r\n\r\n")
        status = 200
        out_headers: list[tuple[str, str]] = []
        for line in head.decode(errors="replace").split("\r\n"):
            if ":" not in line:
                continue
            k, _, v = line.partition(":")
            k, v = k.strip(), v.strip()
            # `Status: 404 Not Found` is CGI's way of setting the HTTP status; it is not a
            # header to forward. Everything else passes through verbatim.
            if k.lower() == "status":
                status = int(v.split()[0]) if v.split() else 200
            else:
                out_headers.append((k, v))
        self.send_response(status)
        for k, v in out_headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *a):
        pass


ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
"""


# The branch the served tree names its head commit on. Measured 2026-09-27 (runs 36311081058 and
# every other PR that touched platform/): actions/checkout of a SHA leaves HEAD detached and no
# refs/heads at all, and Flux's commit-only clone fetches refs/heads/* -- so the commit under test
# was never fetched, and source-controller answered "unable to clone ...: object not found" after
# the 300s reconcile timeout. Not one of the check's greens had ever reconciled anything; every
# one was the "no platform directory changed" skip. Naming the head on a branch, and cloning that
# branch pinned to the commit, is the fix (reproduced with go-git against this exact server).
SHADOW_BRANCH = "shadow-verify"


def name_head(head):
    """Put `head` on refs/heads/SHADOW_BRANCH in the served tree, so a clone can reach it."""
    sh(["git", "-C", REPO, "update-ref", f"refs/heads/{SHADOW_BRANCH}", head])


def flux_source(head):
    # http:// -- the ONE scheme Flux admits among the three it allows (see serve_tree's note).
    url = f"http://{GIT_HOST}:{GIT_PORT}/{os.path.basename(REPO)}"
    name_head(head)
    src = {
        "apiVersion": "source.toolkit.fluxcd.io/v1",
        "kind": "GitRepository",
        "metadata": {"name": "shadow", "namespace": "flux-system"},
        # Pinned to the commit, never a branch: the thing proved is the thing the agent wrote.
        "spec": {
            "interval": "1m",
            "url": url,
            "ref": {"branch": SHADOW_BRANCH, "commit": head},
            "ignore": ".git/\n",
        },
    }
    p = subprocess.run(
        ["kubectl", "apply", "-f", "-"],
        input=json.dumps(src),
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        raise RuntimeError(
            f"could not create the shadow source: {p.stderr.strip()[-400:]}"
        )
    sh(
        ["flux", "reconcile", "source", "git", "shadow", "-n", "flux-system"],
        timeout=300,
    )


def flux_kustomization(name, path, source="shadow", substitute=False, ks_timeout="10m"):
    ks = {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {"name": name, "namespace": "flux-system"},
        "spec": {
            "interval": "5m",
            "path": path,
            "prune": True,
            "sourceRef": {"kind": "GitRepository", "name": source},
            # wait: true is the environment doing the verifying. Flux blocks until every
            # applied object reports healthy, or it fails the Kustomization itself.
            "wait": True,
            "timeout": ks_timeout,
            "force": True,
        },
    }
    if substitute:
        # 2026-10-11, #5747: this used to write ONLY estate-config, so a row that production
        # declares with github-app as well (clusters/oke/platform.yaml lines 161, 183, 318 and the
        # mcp row) was rendered in the shadow against a substituteFrom production does not have.
        # estate-config carries no githubApp* key (grep -c githubAppIDQuoted = 0), and
        # githubAppIDQuoted lives only in the github-app Secret, so `platform/mcp` failed with
        #   envsubst error: variable substitution failed: variable not set (strict mode):
        #   "githubAppIDQuoted"
        # The shadow stands in for the estate, never for the change (the rule the vault stand-in
        # above already states) -- so it substitutes from the same sources the row names. The
        # github-app Secret is laid by stand_in_vault before these rows are applied.
        ks["spec"]["postBuild"] = {
            "substituteFrom": [
                {"kind": "ConfigMap", "name": "estate-config"},
                {"kind": "Secret", "name": "github-app"},
            ]
        }
    subprocess.run(
        ["kubectl", "apply", "-f", "-"],
        input=json.dumps(ks),
        capture_output=True,
        text=True,
    )


# THE ESTATE FLOOR. Production never reconciles a platform path on a bare cluster: the
# external-secrets row installs the ExternalSecret CRDs and the priority-classes row the
# PriorityClasses before any workload row. MEASURED 2026-09-27, once the shadow could clone its
# head (idp#4488): every PR touching platform/llm, temporal, epistemic-fabric,
# unified-memory-server or voice-router failed on `no matches for kind "ExternalSecret"`, and
# event-bus's nats on `no PriorityClass with name platform-batch` -- gaps in the shadow, not in
# the change. Flux lays the floor too; this process still applies nothing it proves.
ESO_ROW = os.path.join(REPO, "platform", "secrets", "external-secrets.yaml")
ESO_GIT = "https://github.com/external-secrets/external-secrets"
# The row holding the github-app ExternalSecret. Four production rows substitute from the Secret
# it produces, so the shadow has to lay it (see flux_floor). Path is repo-relative, like the
# other rows the floor names.
CREDS_ROW_NAME = "shadow-floor-github-app-creds"
CREDS_ROW_PATH = "./platform/github-app-creds"
# MEASURED 2026-09-27 once the vault stand-in landed (idp#4510): platform/llm then failed on
# `no matches for kind "HTTPRoute"` and unified-memory-server on `no matches for kind
# "HTTPScaledObject"`. Production has both: clusters/oke/ingress.yaml lays the Gateway API CRDs,
# platform/keda/keda.yaml installs the KEDA http add-on. The shadow takes their CRDs, at the
# versions production pins, and nothing else of either.
GATEWAY_ROW = os.path.join(REPO, "clusters", "oke", "ingress.yaml")
KEDA_ROW = os.path.join(REPO, "platform", "keda", "keda.yaml")
# MEASURED 2026-09-27: platform/llm (idp#4516) failed on `no matches for kind "Middleware" in
# version "traefik.io/v1alpha1"` and platform/calico/raw (idp#4375) on `no matches for kind
# "GlobalNetworkPolicy" in version "crd.projectcalico.org/v1"`. Production has both: the edge row's
# traefik chart installs its CRDs, and calico-node runs the version the raw manifest pins.
TRAEFIK_ROW = os.path.join(REPO, "platform", "edge", "traefik.yaml")
CALICO_ROW = os.path.join(REPO, "platform", "calico", "raw-migration", "calico.yaml")
# MEASURED 2026-10-14 (run 38526820263, #6148): platform/unified-memory-server failed on `no
# matches for kind "ImagePolicy" in version "image.toolkit.fluxcd.io/v1"`. It was red on every
# change to that path on main, image updates included. Production runs image-reflector and
# image-automation (clusters/oke/flux-system/gotk-components.yaml); the shadow installs neither.
# The shadow takes their CRDs at the controller versions production pins. It does not take the
# controllers, which would scan ghcr and commit tag bumps.
FLUX_ROW = os.path.join(REPO, "clusters", "oke", "flux-system", "gotk-components.yaml")
IMAGE_CONTROLLERS = ("image-reflector-controller", "image-automation-controller")


# MEASURED 2026-09-27 (idp#4582): platform/llm failed on `spec.hostnames[0]: Invalid value:
# "llm.${ESTATE_ZONE}"`. Production substitutes every hostname in Flux postBuild from the
# estate-config ConfigMap (clusters/oke/estate-config.yaml); the shadow had neither the ConfigMap
# nor the postBuild, so every path that publishes a hostname was refused for a gap in the shadow.
# The ConfigMap is the head's own copy: configuration, like the vault stand-in, not the change.
ESTATE_CONFIG = os.path.join(REPO, "clusters", "oke", "estate-config.yaml")


def estate_config():
    """Lay the head's estate-config ConfigMap. Returns the failure, or None."""
    p = subprocess.run(
        ["kubectl", "apply", "-f", ESTATE_CONFIG], capture_output=True, text=True
    )
    if p.returncode != 0:
        return f"could not lay estate-config: {(p.stderr or '').strip()[-400:]}"
    print(
        "ok      shadow  estate-config laid from the head (clusters/oke/estate-config.yaml)"
    )
    return None


def pinned(row, pattern, what):
    with open(row) as f:
        m = re.search(pattern, f.read())
    if not m:
        raise RuntimeError(f"no {what} version in {row}")
    return m.group(1)


def eso_version():
    """The ESO chart version production pins, so the shadow's CRDs are production's CRDs."""
    return pinned(
        ESO_ROW,
        r"chart: external-secrets\s+version: *([0-9][^\s]*)",
        "external-secrets chart",
    )


def floor_sources():
    """(GitRepository name, url, tag, CRD path) for every CRD family production lays first."""
    return [
        ("shadow-floor-eso", ESO_GIT, "v" + eso_version(), "./deploy/crds"),
        (
            "shadow-floor-gateway-api",
            "https://github.com/kubernetes-sigs/gateway-api",
            pinned(
                GATEWAY_ROW,
                r"gateway-api\s+ref:\s+tag: *(v[0-9][^\s]*)",
                "gateway-api tag",
            ),
            "./config/crd/experimental",
        ),
        (
            "shadow-floor-keda-http",
            "https://github.com/kedacore/http-add-on",
            "v"
            + pinned(
                KEDA_ROW,
                r"chart: keda-add-ons-http\s+version: *([0-9][^\s]*)",
                "keda-add-ons-http chart",
            ),
            "./config/crd",
        ),
        (
            "shadow-floor-traefik",
            "https://github.com/traefik/traefik-helm-chart",
            "v"
            + pinned(
                TRAEFIK_ROW,
                r"chart: traefik\s+version: *([0-9][^\s]*)",
                "traefik chart",
            ),
            "./traefik/crds",
        ),
        (
            "shadow-floor-calico",
            "https://github.com/projectcalico/calico",
            pinned(CALICO_ROW, r"calico/node:(v[0-9][^\s\"]*)", "calico/node image"),
            "./libcalico-go/config/crd",
        ),
        *(
            (
                f"shadow-floor-{c}",
                f"https://github.com/fluxcd/{c}",
                pinned(
                    FLUX_ROW, rf"ghcr\.io/fluxcd/{c}:(v[0-9][^\s\"]*)", f"{c} image"
                ),
                "./config/crd",
            )
            for c in IMAGE_CONTROLLERS
        ),
    ]


def flux_floor(deadline):
    """Have Flux lay what production has under every platform row. Returns the failures."""
    floor = []
    for src_name, url, tag, path in floor_sources():
        src = {
            "apiVersion": "source.toolkit.fluxcd.io/v1",
            "kind": "GitRepository",
            "metadata": {"name": src_name, "namespace": "flux-system"},
            "spec": {
                "interval": "1h",
                "url": url,
                "ref": {"tag": tag},
                # the two levels production re-includes: /deploy/crds/, /config/crd/
                "ignore": "/*\n!/" + "/".join(path[2:].split("/")[:2]) + "/\n",
            },
        }
        subprocess.run(
            ["kubectl", "apply", "-f", "-"],
            input=json.dumps(src),
            capture_output=True,
            text=True,
        )
        floor.append((src_name + "-crds", path, src_name))
    floor.append(
        ("shadow-floor-priority-classes", "./platform/priority-classes", "shadow")
    )
    for name, path, source in floor:
        flux_kustomization(name, path, source)
    # #5747 follow-up, measured 2026-10-11 on run 38146045240: a row whose postBuild names
    # github-app cannot converge until that Secret exists, and the Secret is written by ESO from
    # an ExternalSecret that lives in a row of its own (platform/github-app-creds). The shadow
    # reconciles only the path under test, so github-app-creds was never applied, stand_in_vault
    # never saw its ExternalSecret, flux-system/github-app never appeared, and vault_wait timed
    # out after 120s: platform/mcp and platform/temporal then failed with
    #   substitute from 'Secret/github-app' error: secrets "github-app" not found
    # Four production rows (clusters/oke/platform.yaml lines 161, 183, 318, and the mcp row at
    # 159) declare dependsOn github-app-creds for exactly this reason, so the shadow lays that
    # row like the rest of the floor. Applied, never waited on: ESO has no controller here, so
    # the ExternalSecret can never report Ready -- the stand-in writes its Secret from the spec.
    failed = []
    for name, path, _ in floor:
        ready, msg, _inv = wait_ks(name, deadline)
        if ready:
            print(f"ok      shadow  floor {name} laid by flux")
        else:
            failed.append(f"the shadow floor {name} did not converge -- {msg}")
    # Applied only once the floor has converged: the ExternalSecret needs the ESO CRD
    # established. Applied beside the floor rows it raced them, kustomize-controller answered
    # "no matches for kind ExternalSecret" and retried on its 5m interval, so vault_wait's 120s
    # expired with flux-system/github-app absent and platform/llm failed
    # `secrets "github-app" not found` on some runs and not others (runs 39907078830,
    # 39908064993, 39920521952 against 39908067512, where the same row converged).
    if not failed:
        flux_kustomization(CREDS_ROW_NAME, CREDS_ROW_PATH, "shadow")
    return failed


# The vault is the one thing a shadow can never have: ESO's CRDs are on the floor, but no
# controller and no estate-vault store, so no ExternalSecret ever writes its Secret and every
# workload that mounts one waits in ContainerCreating until the health check times out (P1's
# epistemic-ingest, 2026-09-27: `secret "epistemic-fabric-github-api" not found`). The shadow
# stands in for the vault, not for the change: for each ExternalSecret Flux applies, it creates
# the target Secret ESO would have written, with the keys ESO would have written and a
# placeholder value. A workload that needs the real credential to go Ready still fails.
VAULT_PLACEHOLDER = "shadow-vault-stand-in"
# A key whose consumer PARSES it cannot be stood in with prose: the consumer dies on its first
# byte, before it ever reaches the network, and the row holding it can then never converge in any
# shadow run -- a gap in the shadow that looks exactly like a broken change.
#
# Measured 2026-10-12 on the open image-update PR 5890 (run 38287453511, job 114939495218):
# platform/mcp's fetch-estate-db init container runs `flux pull artifact` with DOCKER_CONFIG=/creds
# and parses /creds/config.json -- the stood-in ghcr-pull/.dockerconfigjson -- so it died with
#   parsing config file (/creds/config.json): invalid character 's' looking for beginning of value
# which is the `s` of the placeholder below. platform/mcp therefore never converged, and an
# image-update PR always carries the platform/mcp and platform/temporal kustomizations, so this
# row was always in scope: every built image sat at shadow-verify and never moved the overlays.
#
# The stand-in still forges nothing. An empty auths block is anonymous, and the artifact is
# anonymously readable: measured the same day, the anonymous token from
# https://ghcr.io/token?scope=repository:chidionyema/idp/estate-db:pull&service=ghcr.io reads
# /v2/chidionyema/idp/estate-db/manifests/latest with HTTP 200. A row that needs a real credential
# to go Ready still fails -- at the registry, where it belongs, not at the parser.
JSON_STAND_IN = '{"auths":{}}'


def is_json_key(key):
    """True for a secret key a consumer parses as JSON rather than reads as a string.

    `.dockerconfigjson` is the key the OCI tooling parses (a docker config), and a `.json` suffix
    is that same contract spelled differently (a service-account key, a GCP key).
    """
    return key == ".dockerconfigjson" or key.endswith(".json")


def placeholder(key):
    """The stand-in value for one key, in the shape that key's own consumer parses."""
    return JSON_STAND_IN if is_json_key(key) else VAULT_PLACEHOLDER


def consumer_secret_keys():
    """{(namespace, secret name): [key names consumers read]}, from the head's manifests.

    For an extract-style ExternalSecret the upstream key names are unknowable in the
    shadow -- and also irrelevant: the only keys that matter are the ones a workload
    actually reads. This walks the head's own platform/ manifests the way this script
    parses every row (bounded regexes, no YAML library for the runner to lack) and
    names those keys: valueFrom.secretKeyRef {name, key} in both spellings, and secret
    volumes with items. An envFrom secretRef names a Secret but no key, so it
    contributes the name with nothing behind it -- the shadow does not invent keys
    nobody named.
    """
    refs = {}
    for dirpath, _dirs, files in os.walk(os.path.join(REPO, "platform")):
        for fname in files:
            if not fname.endswith((".yaml", ".yml")):
                continue
            try:
                with open(os.path.join(dirpath, fname), errors="replace") as f:
                    text = f.read()
            except OSError:
                continue
            for doc in re.split(r"^---\s*$", text, flags=re.M):
                ns_m = re.search(r"^  namespace:\s*(\S+)", doc, re.M)
                ns = ns_m.group(1) if ns_m else "default"

                def add(name, key, _ns=ns):
                    slot = refs.setdefault((_ns, name), [])
                    if key and key not in slot:
                        slot.append(key)

                for m in re.finditer(
                    r"secretKeyRef:\s*\n\s+name:\s*(\S+)\s*\n\s+key:\s*(\S+)", doc
                ):
                    add(m.group(1), m.group(2))
                for m in re.finditer(
                    r"secretKeyRef:\s*\{\s*name:\s*([^,}\s]+)\s*,\s*key:\s*([^}\s]+)",
                    doc,
                ):
                    add(m.group(1), m.group(2))
                # secret volumes: secretName: X, then items: - key: K until dedent.
                # Chart values name Secrets too: existingSecret: X with a sibling
                # secretKey: K at the same indent names the key (temporal); alone, it
                # is a named reference with no knowable keys (hindsight's ln -> envFrom).
                lines = doc.splitlines()
                i = 0
                vol = items_at = None
                while i < len(lines):
                    line = lines[i]
                    i += 1
                    m = re.match(r"^(\s*)secretName:\s*(\S+)", line)
                    if m:
                        vol, items_at = m.group(2), None
                        add(vol, None)
                        continue
                    m = re.match(r"^(\s*)existingSecret:\s*(\S+)", line)
                    if m:
                        indent, name = len(m.group(1)), m.group(2)
                        add(name, None)
                        while i < len(lines):
                            nxt = lines[i]
                            s = nxt.strip()
                            if s and not s.startswith("#"):
                                cur = len(nxt) - len(nxt.lstrip())
                                if cur < indent or (
                                    cur == indent
                                    and not s.startswith(
                                        ("existingSecret", "secretKey")
                                    )
                                ):
                                    break
                                km = re.match(r"^(\s*)secretKey:\s*(\S+)", nxt)
                                if km and len(km.group(1)) == indent:
                                    add(name, km.group(2))
                            i += 1
                        continue
                    if vol is None:
                        continue
                    stripped = line.strip()
                    if not stripped or stripped.startswith("#"):
                        continue
                    indent = len(line) - len(line.lstrip())
                    if items_at is not None and indent <= items_at:
                        items_at = None
                    m = re.match(r"^(\s*)(items|key):\s*(\S*)", line)
                    if not m:
                        continue
                    what, value = m.group(2), m.group(3)
                    if what == "items" and not value:
                        items_at = indent
                    elif what == "key" and items_at is not None and indent > items_at:
                        add(vol, value)
                for m in re.finditer(r"secretRef:\s*\{\s*name:\s*([^},\s]+)", doc):
                    add(m.group(1), None)
                for m in re.finditer(r"secretRef:\s*\n\s+name:\s*(\S+)", doc):
                    add(m.group(1), None)
    return refs


def vault_stand_ins(external_secrets, consumer_keys=None):
    """The Secrets ESO would write for these ExternalSecrets, holding placeholders.

    Keys come from three sources, in order of authority: the ExternalSecret's own
    spec (data[].secretKey, target template, dataFrom rewrites), then the keys the
    head's own consumers read from the target Secret (consumer_keys) -- which is the
    only source that knows them for extract-style ExternalSecrets. Measured 2026-10-10,
    greenlane 38088674916: the stand-in wrote temporal/temporal-db with zero keys, and
    temporal-frontend died anyway: `couldn't find key password in Secret`.
    """
    out = []
    for es in external_secrets:
        meta, spec = es.get("metadata") or {}, es.get("spec") or {}
        target = spec.get("target") or {}
        name = target.get("name") or meta.get("name")
        namespace = meta.get("namespace") or "default"
        keys = [d["secretKey"] for d in spec.get("data") or [] if d.get("secretKey")]
        keys += list(((target.get("template") or {}).get("data") or {}).keys())
        for src in spec.get("dataFrom") or []:
            for rw in src.get("rewrite") or []:
                # a literal transform template renames the generated key to itself
                tpl = (rw.get("transform") or {}).get("template") or ""
                if tpl and "{{" not in tpl:
                    keys.append(tpl)
        if consumer_keys:
            keys += consumer_keys.get((namespace, name), [])
        out.append(
            {
                "apiVersion": "v1",
                "kind": "Secret",
                "metadata": {
                    "name": name,
                    "namespace": namespace,
                    "labels": {"idp.shadow/vault-stand-in": "true"},
                },
                "stringData": {k: placeholder(k) for k in dict.fromkeys(keys)},
            }
        )
    return out


def vault_wait(namespace, name, timeout=120.0, every=2.0):
    """Block until the vault stand-in has laid <namespace>/<name>, or the timeout expires.

    #5747: stand_in_vault runs in a background thread, so a row applied immediately after it
    starts can name a Secret the thread has not created yet. Bounded and non-fatal -- the
    caller decides what a timeout means.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        p = kube(["get", "secret", name, "-n", namespace, "-o", "name"], check=False)
        if p.returncode == 0:
            return True
        time.sleep(every)
    return False


def stand_in_vault(stop, every=5.0):
    """Until stop is set, give every ExternalSecret in the shadow its Secret, once."""
    made = set()
    consumer_keys = consumer_secret_keys()
    while True:
        p = kube(
            ["get", "externalsecrets.external-secrets.io", "-A", "-o", "json"],
            check=False,
        )
        items = (
            json.loads(p.stdout or "{}").get("items", []) if p.returncode == 0 else []
        )
        for sec in vault_stand_ins(items, consumer_keys):
            key = (sec["metadata"]["namespace"], sec["metadata"]["name"])
            if key in made:
                continue
            r = subprocess.run(
                ["kubectl", "create", "-f", "-"],
                input=json.dumps(sec),
                capture_output=True,
                text=True,
            )
            if r.returncode == 0 or "AlreadyExists" in (r.stderr or ""):
                made.add(key)
                print(
                    f"ok      shadow  vault stand-in {key[0]}/{key[1]} "
                    f"({len(sec['stringData'])} placeholder key(s))"
                )
        if stop.wait(every):
            return


# ---------------------------------------------------------------- the database stand-in
#
# The database the estate actually has. Production runs estate-db as CloudNativePG; the shadow
# installs no operator and no cluster -- a throwaway that can never reach production has no
# business carrying one -- so every workload that resolves estate-rw.estate-db.svc.cluster.local
# used to find nothing and never converge. The stand-in is the same move as the vault stand-in
# above: it stands in for the ESTATE (the server, its roles, its databases), never for the
# change. The image is the one cluster.yaml pins (so the extensions are production's); the roles
# and databases are the ones the head's own databases.yaml declares; and every password is the
# vault stand-in's placeholder, which is exactly the value the vault stand-in writes into the
# Secret the workload mounts. Nothing in the PR is touched to make room for it.
ESTATE_DB_ROW = os.path.join(REPO, "platform", "estate-db", "cluster", "cluster.yaml")
DATABASES_ROW = os.path.join(REPO, "platform", "estate-db", "cluster", "databases.yaml")
DB_NS = "estate-db"
DB_RW = "estate-rw"  # the CNPG read-write Service name, verbatim
DB_STAND_IN = "estate-stand-in"


def db_image():
    """The image production's cluster pins, so the stand-in carries production's extensions."""
    return pinned(ESTATE_DB_ROW, r"imageName: *(\S+)", "estate-db image")


def database_rows():
    """(database, owner, [extensions]) exactly as the estate's own seed declares them.

    Parsed the way this script parses every row (pinned, eso_version): bounded regexes,
    no YAML library for the runner to lack. The name that matters is spec's, not
    metadata's -- temporal-visibility the Database is temporal_visibility the schema --
    and a dashed extension line only counts under an extensions: key.
    """
    with open(DATABASES_ROW) as f:
        docs = re.split(r"^---\s*$", f.read(), flags=re.M)
    rows = []
    for doc in docs:
        if not re.search(r"^kind:\s*Database\s*$", doc, re.M):
            continue
        spec = re.search(r"^spec:\s*$\n(.*?)(?=^\S|\Z)", doc, re.M | re.S)
        body = spec.group(1) if spec else doc
        name = re.search(r"^  name:\s*(\S+)", body, re.M)
        owner = re.search(r"^  owner:\s*(\S+)", body, re.M)
        exts = re.findall(r"^    - name:\s*(\S+)", body, re.M)
        if name and owner:
            rows.append((name.group(1), owner.group(1), exts))
    return rows


# Private images the shadow cannot pull: ghcr packages under this account are private and the
# shadow holds no registry credential (it forges nothing and creates no estate credential), so a
# row that runs one sat in ErrImagePull on every run, base and head alike, and platform/llm never
# converged (runs 39908067512, 39908062442). The stand-in is the vault stand-in's move again: it
# stands in for the ESTATE (an image the shadow is not entitled to), never for the change. It
# answers the one probe the Deployment declares and runs nothing of the application, so the
# manifests are proven (scheduling, security context, probes, wiring) and the code is not.
# name -> (port, health path), read off the Deployment's own probe.
PRIVATE_STAND_INS = {"ghcr.io/chidionyema/zeroedge": (8757, "/health")}

STAND_IN_DOCKERFILE = """FROM python:3.12-alpine
RUN mkdir -p /srv/www{dir} && echo ok > /srv/www{health}
USER 10001:10001
EXPOSE {port}
CMD ["python", "-m", "http.server", "{port}", "--directory", "/srv/www"]
"""


def private_image_refs(paths):
    """{ref} of every stood-in private image the manifests under test run, tag as Flux sets it.

    A kustomization `images:` entry (name + newTag) overrides the tag in the Deployment, so it
    wins; a bare `image:` line is the fallback only when no override names the image.
    """
    overrides, bare = {}, {}
    for path in paths:
        root = os.path.join(REPO, path.strip("/"))
        if not os.path.isdir(root):
            continue
        for dirpath, _dirs, files in os.walk(root):
            for fname in files:
                if not fname.endswith((".yaml", ".yml")):
                    continue
                with open(os.path.join(dirpath, fname), errors="replace") as f:
                    text = f.read()
                for name in PRIVATE_STAND_INS:
                    esc = re.escape(name)
                    overrides.setdefault(name, set()).update(
                        re.findall(rf"-\s*name:\s*{esc}\s*\n\s*newTag:\s*(\S+)", text)
                    )
                    bare.setdefault(name, set()).update(
                        re.findall(rf"image:\s*{esc}:(\S+)", text)
                    )
    return {
        f"{name}:{tag}"
        for name in PRIVATE_STAND_INS
        for tag in (overrides.get(name) or bare.get(name) or ())
    }


def stand_in_private_images(paths):
    """Build and load a stand-in for each private image the paths run. Returns the failures."""
    failed = []
    for ref in sorted(private_image_refs(paths)):
        port, health = PRIVATE_STAND_INS[ref.rsplit(":", 1)[0]]
        directory = os.path.dirname(health)
        dockerfile = STAND_IN_DOCKERFILE.format(
            port=port, health=health, dir=directory if directory != "/" else ""
        )
        try:
            with tempfile.TemporaryDirectory() as ctx:
                with open(os.path.join(ctx, "Dockerfile"), "w") as f:
                    f.write(dockerfile)
                sh(["docker", "build", "-t", ref, ctx], timeout=600)
            sh(["k3d", "image", "import", ref, "-c", CLUSTER], timeout=600)
        except (RuntimeError, OSError, subprocess.SubprocessError) as e:
            detail = getattr(e, "stderr", None) or str(e)
            failed.append(f"image stand-in {ref} could not be laid: {detail[-300:]}")
            continue
        print(
            f"ok      shadow  image stand-in {ref} (private; answers {health} on {port})"
        )
    return failed


def db_needs_standin(paths):
    """True when a manifest under test points a workload at the estate database."""
    for path in paths:
        root = os.path.join(REPO, path.strip("/"))
        if not os.path.isdir(root):
            continue
        for dirpath, _dirs, files in os.walk(root):
            for name in files:
                if not name.endswith((".yaml", ".yml")):
                    continue
                with open(os.path.join(dirpath, name), errors="replace") as f:
                    if "estate-db.svc.cluster.local" in f.read():
                        return True
    return False


def db_sql(rows):
    """The one psql script that mints the estate's roles, databases and extensions.

    Guarded, not blind: only what the head's seed declares is created, and what already
    exists is left alone -- the same ensure: present semantics CloudNativePG gives
    production. One script, one exec, whatever the row count.
    """
    parts = ["\\set ON_ERROR_STOP on"]
    for owner in dict.fromkeys(owner for _db, owner, _exts in rows):
        parts.append(
            f"DO $$ BEGIN IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '{owner}') "
            f"THEN CREATE ROLE \"{owner}\" LOGIN PASSWORD '{VAULT_PLACEHOLDER}'; "
            "END IF; END $$;"
        )
    for db, owner, _exts in rows:
        parts.append(
            f'SELECT \'CREATE DATABASE "{db}" OWNER "{owner}"\' WHERE NOT EXISTS '
            f"(SELECT FROM pg_database WHERE datname = '{db}') \\gexec"
        )
    for db, _owner, exts in rows:
        if exts:
            parts.append(f'\\connect "{db}"')
            for ext in exts:
                parts.append(f'CREATE EXTENSION IF NOT EXISTS "{ext}";')
    return "\n".join(parts) + "\n"


def db_standin_objects():
    """The Namespace, one-Pod Deployment and estate-rw Service the stand-in needs."""
    return [
        {
            "apiVersion": "v1",
            "kind": "Namespace",
            "metadata": {"name": DB_NS},
        },
        {
            "apiVersion": "apps/v1",
            "kind": "Deployment",
            "metadata": {"name": DB_STAND_IN, "namespace": DB_NS},
            "spec": {
                "replicas": 1,
                "selector": {"matchLabels": {"app": DB_STAND_IN}},
                "template": {
                    "metadata": {"labels": {"app": DB_STAND_IN}},
                    "spec": {
                        "containers": [
                            {
                                "name": "postgres",
                                "image": db_image(),
                                "command": ["/bin/bash", "-c"],
                                "args": [
                                    "set -e; umask 077; mkdir -p /tmp/ssl /tmp/pgdata; "
                                    "chmod 700 /tmp/pgdata; "
                                    f"openssl req -x509 -newkey rsa:2048 -nodes -days 3650 "
                                    f"-subj /CN={DB_RW} -keyout /tmp/ssl/server.key "
                                    "-out /tmp/ssl/server.crt 2>/dev/null; "
                                    "if [ ! -s /tmp/pgdata/PG_VERSION ]; then "
                                    'echo "$POSTGRES_SUPERUSER_PASSWORD" > /tmp/pwfile; '
                                    "initdb -D /tmp/pgdata -U postgres --pwfile=/tmp/pwfile "
                                    "--auth-local=trust --auth-host=scram-sha-256; fi; "
                                    "exec postgres -D /tmp/pgdata -c ssl=on "
                                    "-c ssl_cert_file=/tmp/ssl/server.crt "
                                    "-c ssl_key_file=/tmp/ssl/server.key"
                                ],
                                "env": [
                                    {
                                        "name": "POSTGRES_SUPERUSER_PASSWORD",
                                        "value": VAULT_PLACEHOLDER,
                                    },
                                ],
                                # Available must mean serving: with no probe the
                                # deployment goes Available the moment the container
                                # runs, while initdb is still mid-flight, and the seed
                                # exec finds no socket. Measured, greenlane
                                # 38118221613: "connection to server on socket
                                # /var/run/postgresql/.s.PGSQL.5432 failed".
                                "readinessProbe": {
                                    "exec": {
                                        "command": [
                                            "/bin/bash",
                                            "-c",
                                            "pg_isready -U postgres -d postgres",
                                        ],
                                    },
                                    "periodSeconds": 1,
                                    "timeoutSeconds": 3,
                                    "failureThreshold": 60,
                                },
                                "ports": [{"containerPort": 5432}],
                            }
                        ]
                    },
                },
            },
        },
        {
            "apiVersion": "v1",
            "kind": "Service",
            "metadata": {"name": DB_RW, "namespace": DB_NS},
            "spec": {
                "selector": {"app": DB_STAND_IN},
                "ports": [{"port": 5432, "targetPort": 5432}],
            },
        },
    ]


def stand_in_database():
    """Lay the database stand-in. Returns the failure, or None.

    A Postgres that never becomes Ready, or a seed script it refuses, fails the run: a
    shadow that cannot lay its own dependencies proves nothing about the change.
    """
    # A JSON document stream (--- separated), never a top-level JSON array: kubectl
    # refuses an array with "invalid object to validate". Measured, greenlane
    # 38096348716: every full shadow run died here, 53s into verify.
    p = subprocess.run(
        ["kubectl", "apply", "-f", "-"],
        input="\n---\n".join(json.dumps(o) for o in db_standin_objects()),
        capture_output=True,
        text=True,
    )
    if p.returncode != 0:
        return f"could not lay the database stand-in: {(p.stderr or '').strip()[-400:]}"
    w = kube(
        [
            "-n",
            DB_NS,
            "wait",
            "--for=condition=available",
            f"deployment/{DB_STAND_IN}",
            "--timeout=120s",
        ],
        check=False,
        timeout=150,
    )
    if w.returncode != 0:
        return (
            "the database stand-in never became available: "
            + (w.stderr or "").strip()[-300:]
        )
    seed = subprocess.run(
        [
            "kubectl",
            "-n",
            DB_NS,
            "exec",
            "-i",
            f"deploy/{DB_STAND_IN}",
            "--",
            "psql",
            "-U",
            "postgres",
            "-d",
            "postgres",
        ],
        input=db_sql(database_rows()),
        capture_output=True,
        text=True,
        timeout=120,
    )
    if seed.returncode != 0:
        return (
            "the database stand-in refused the estate's seed: "
            + (seed.stderr or seed.stdout or "").strip()[-400:]
        )
    print(
        f"ok      shadow  database stand-in {DB_NS}/{DB_RW} seeded from the head's "
        "databases.yaml"
    )
    return None


def ks_status(name):
    p = kube(
        ["get", "kustomization", name, "-n", "flux-system", "-o", "json"], check=False
    )
    if p.returncode != 0:
        return None
    return json.loads(p.stdout)


FLUX_KS_LABEL = "kustomize.toolkit.fluxcd.io/name"
HELM_NAME_LABEL = "helm.toolkit.fluxcd.io/name"
HELM_NS_LABEL = "helm.toolkit.fluxcd.io/namespace"
OWNER_KINDS = "replicasets,jobs,deployments,statefulsets,daemonsets,cronjobs"


def owned_by(obj, ks, releases, by_uid):
    """Does `obj`'s controller chain reach an object Kustomization `ks` applied?

    Flux labels what a Kustomization applies with its name, and helm-controller labels what a
    HelmRelease renders with the release's; a pod carries neither, so the chain is walked through
    ownerReferences (pod -> ReplicaSet -> Deployment, pod -> Job -> CronJob). `releases` is the
    (namespace, name) of every HelmRelease `ks` applied.
    """
    seen = set()
    while obj is not None:
        md = obj.get("metadata") or {}
        labels = md.get("labels") or {}
        if labels.get(FLUX_KS_LABEL) == ks:
            return True
        if (labels.get(HELM_NS_LABEL), labels.get(HELM_NAME_LABEL)) in releases:
            return True
        uid = md.get("uid")
        if uid in seen:
            return False
        seen.add(uid)
        refs = md.get("ownerReferences") or []
        ctrl = next((r for r in refs if r.get("controller")), refs[0] if refs else None)
        obj = by_uid.get(ctrl.get("uid")) if ctrl else None
    return False


def _items(argv):
    p = kube(argv, check=False)
    if p.returncode != 0:
        return None
    return json.loads(p.stdout).get("items") or []


def pod_failures(ks=None):
    """Every container past rescue that belongs to Kustomization `ks`, one human line each.

    `ks=None` is every pod in the cluster. That was the only mode until #6194, where one dagster
    pod stuck on a missing Secret was reported as the failure of eight other paths that do not
    own it. A pod whose chain cannot be read is not charged: this watch narrows what wait_ks can
    conclude, it never widens it, and Flux's own health check still fails a path whose workload
    never becomes ready.
    """
    pods = _items(["get", "pods", "-A", "-o", "json"])
    if pods is None:
        return []
    if ks is not None:
        owners = _items(["get", OWNER_KINDS, "-A", "-o", "json"]) or []
        by_uid = {(o.get("metadata") or {}).get("uid"): o for o in owners}
        hrs = (
            _items(
                [
                    "get",
                    "helmreleases.helm.toolkit.fluxcd.io",
                    "-A",
                    "-l",
                    f"{FLUX_KS_LABEL}={ks}",
                    "-o",
                    "json",
                ]
            )
            or []
        )
        releases = {
            (
                (h.get("metadata") or {}).get("namespace"),
                (h.get("metadata") or {}).get("name"),
            )
            for h in hrs
        }
        pods = [pod for pod in pods if owned_by(pod, ks, releases, by_uid)]
    out = []
    for pod in pods:
        meta, status = pod.get("metadata") or {}, pod.get("status") or {}
        who = f"{meta.get('namespace')}/{meta.get('name')}"
        for cs in (status.get("initContainerStatuses") or []) + (
            status.get("containerStatuses") or []
        ):
            reason = ((cs.get("state") or {}).get("waiting") or {}).get("reason")
            if reason not in POD_DOOM_REASONS:
                continue
            dead = (cs.get("lastState") or {}).get("terminated") or {}
            detail = (
                dead.get("message")
                or ((cs.get("state") or {}).get("waiting") or {}).get("message")
                or "no message"
            )
            out.append(
                f"pod {who} container {cs.get('name')} is {reason} "
                f"(restarts {int(cs.get('restartCount') or 0)}): {detail}"
            )
            _say_why_it_died(meta, cs.get("name"))
    return out


_explained = set()


def _say_why_it_died(meta, container):
    """Print the dead container's last words once, to the run log and not into the failure message.

    A CrashLoopBackOff line names the state and never the cause (run 39926636846: litellm
    crashlooped and nothing in the log said why). The message stays free of it on purpose: it is
    what `signature` compares between the head's run and the base's.
    """
    key = (meta.get("namespace"), meta.get("name"), container)
    if key in _explained:
        return
    _explained.add(key)
    p = kube(
        ["logs", "-n", key[0], key[1], "-c", container, "--previous", "--tail=150"],
        check=False,
        timeout=30,
    )
    text = re.sub(r"\x1b\[[0-9;]*m", "", (p.stdout or p.stderr or "")).strip()
    if text:
        print(f"note    shadow  last output of {key[0]}/{key[1]} {container}:")
        print("\n".join("        | " + ln for ln in text.splitlines()))


def wait_ks(name, deadline):
    """Wait for Flux's own verdict on this path. Returns (ready, message, inventory)."""
    last = "no status reported"
    doomed_since = None
    while time.time() < deadline:
        obj = ks_status(name)
        if obj:
            conds = {
                c["type"]: c for c in (obj.get("status", {}).get("conditions") or [])
            }
            ready = conds.get("Ready")
            if ready:
                last = ready.get("message", "")
                if ready.get("status") == "True":
                    inv = (obj.get("status", {}).get("inventory") or {}).get(
                        "entries"
                    ) or []
                    return True, last, inv
                # ArtifactFailed is kustomize-controller retrying while its GitRepository still
                # clones (2026-09-27: the ESO floor, Applied 18s later). A source that never
                # arrives still fails, at the deadline, with this message.
                if ready.get("status") == "False" and ready.get("reason") not in (
                    "Progressing",
                    "ReconciliationSucceeded",
                    "ArtifactFailed",
                ):
                    inv = (obj.get("status", {}).get("inventory") or {}).get(
                        "entries"
                    ) or []
                    return False, last, inv
        # Fail fast on pods the kubelet has already given up on (#5710): a crash-looping
        # workload holds the Kustomization in Progressing, which used to hold the whole
        # run out to the deadline. A doom state that clears within the grace -- a pull in
        # progress, a secret the stand-in has not written yet -- costs nothing and is
        # waited out; only a state that persists past the grace is a verdict.
        bad = pod_failures(name)
        if bad:
            now = time.time()
            if doomed_since is None:
                doomed_since = now
            elif now - doomed_since >= POD_GRACE:
                msg = (
                    bad[0]
                    if len(bad) == 1
                    else (f"{len(bad)} stuck container(s), first: {bad[0]}")
                )
                return False, f"pods past rescue: {msg}", []
        else:
            doomed_since = None
        time.sleep(5)
    return False, f"timed out waiting for Flux: {last}", []


def observe(kind, ns, name):
    """Read the REAL status the API server recorded. Never a value this process decided."""
    p = kube(["get", kind.lower(), name, "-n", ns, "-o", "json"], check=False)
    if p.returncode != 0:
        return {"kind": kind, "metadata": {"name": name, "namespace": ns}}
    obj = json.loads(p.stdout)
    st = obj.get("status") or {}
    spec = obj.get("spec") or {}
    obs = {"kind": kind, "metadata": {"name": name, "namespace": ns}}

    if kind in ("Deployment", "StatefulSet"):
        req = int(spec.get("replicas", 1))
        avail = int(st.get("availableReplicas") or 0)
        readyc = int(st.get("readyReplicas") or 0)
        obs.update(
            {
                "requiredReplicas": req,
                "availableReplicas": avail,
                "readyReplicas": readyc,
                "ready": avail >= req and readyc >= req,
            }
        )
    elif kind == "DaemonSet":
        req = int(st.get("desiredNumberScheduled") or 0)
        avail = int(st.get("numberAvailable") or 0)
        readyc = int(st.get("numberReady") or 0)
        obs.update(
            {
                "requiredReplicas": req,
                "availableReplicas": avail,
                "readyReplicas": readyc,
                "ready": avail >= req and readyc >= req,
            }
        )
    elif kind == "Job":
        obs.update(
            {
                "succeeded": int(st.get("succeeded") or 0) > 0,
                "ready": int(st.get("succeeded") or 0) > 0,
            }
        )
    elif kind == "CronJob":
        obs.update({"succeeded": True, "ready": True})

    # Probes: the real per-container readiness the kubelet recorded on the pods Flux created.
    obs["probes"] = pod_probes(ns, obj)
    # Tests: a workload declares its own by annotation; absent means none, which grade() accepts
    # only as an explicit empty set.
    ann = (obj.get("metadata") or {}).get("annotations") or {}
    obs["tests"] = (
        []
        if "shadow.estate/tests" not in ann
        else [{"name": ann["shadow.estate/tests"], "passed": False}]
    )
    return obs


def pod_probes(ns, owner):
    """Per-container readiness as the kubelet reports it, for the pods this workload owns."""
    sel = ((owner.get("spec") or {}).get("selector") or {}).get("matchLabels") or {}
    if not sel:
        return None  # grade() treats silence as a FAIL, which is correct: we cannot see the pods.
    sel_s = ",".join(f"{k}={v}" for k, v in sel.items())
    p = kube(["get", "pods", "-n", ns, "-l", sel_s, "-o", "json"], check=False)
    if p.returncode != 0:
        return None
    pods = json.loads(p.stdout).get("items") or []
    if not pods:
        return None
    probes = {}
    for pod in pods:
        pname = pod["metadata"]["name"]
        for cs in pod.get("status", {}).get("containerStatuses") or []:
            probes[f"{pname}/{cs['name']}"] = "pass" if cs.get("ready") else "fail"
        if not (pod.get("status", {}).get("containerStatuses") or []):
            probes[pname] = "fail"
    return probes or None


def grade_all(observations):
    """Grade every observation with the estate's fail-closed judge. One FAIL fails the run."""
    sys.path.insert(0, HERE)
    import importlib.util

    import importlib.machinery

    # VERIFY has no .py suffix, so spec_from_file_location cannot infer a loader and returns None.
    spec = importlib.util.spec_from_file_location(
        "shadow_verify",
        VERIFY,
        loader=importlib.machinery.SourceFileLoader("shadow_verify", VERIFY),
    )
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)

    failed = []
    for obs in observations:
        ok, reasons = mod.grade(obs)
        md = obs.get("metadata", {})
        who = f"{md.get('namespace')}/{md.get('name')}"
        if ok:
            print(f"ok      shadow  {obs['kind']} {who} converged")
        else:
            failed.append((who, reasons))
            for r in reasons:
                print(f"FAIL    shadow  {obs['kind']} {who}: {r}")
    return failed


def signature(message):
    """A failure with what differs between two runs of the same failure taken out.

    Pod and ReplicaSet suffixes, commit shas, durations, restart counts and timestamps change from
    run to run; the kind, the object, the reason and the missing thing do not. Two runs fail the
    same way exactly when their signatures are equal.
    """
    s = message.lower()
    # How many containers are stuck is a count, not a cause: run 39935488278 failed platform/llm
    # on litellm's CrashLoopBackOff on both sides, base with one stuck pod and head with two
    # ("2 stuck container(s), first: pod ..."), and the judge called it introduced.
    s = re.sub(r"\b\d+ stuck container\(s\), first: ", "", s)
    # The kubelet's own tail repeats the pod as `pod=<name>_<ns>(<uid>)`: a generated name whose
    # suffix and uid change on every run (run 39940650771: the same temporal crash on both sides,
    # judged introduced). The message already names the pod before it.
    s = re.sub(r"\bpod=\S+", "pod=<pod>", s)
    s = re.sub(r"\b[0-9a-f]{12,64}\b", "<sha>", s)
    # Kubernetes generates ReplicaSet and pod suffixes from this alphabet (apimachinery's
    # util/rand: no vowels, no 0, 1 or 3), so a hyphen-joined run of it is generated, not named:
    # d945998bkr5v8, 698xw, xkzqv. A rare word is spelled from it too (`https` in a policy name);
    # that only equates two failures that differ in nothing else.
    # A ReplicaSet hash and a pod suffix are two segments or, truncated to 63 characters, one.
    s = re.sub(r"(-[bcdfghjklmnpqrstvwxz2456789]{5,}\b)+", "-<gen>", s)
    # A Go duration is one token whatever its shape: 1m1.194572576s and 58.0021s.
    s = re.sub(r"\b(\d+(\.\d+)?(ms|h|m|s))+\b", "<dur>", s)
    s = re.sub(r"\d+(\.\d+)?", "<n>", s)
    return re.sub(r"\s+", " ", s).strip()


def write_record(record, head, rc, fails):
    """The run as data, so the head's run and the base's can be compared by `judge`."""
    if not record:
        return
    doc = {
        "head": head,
        "rc": rc,
        "failures": [
            {"scope": sc, "message": m, "signature": signature(m)} for sc, m in fails
        ],
    }
    # The workflow names $RUNNER_TEMP/record/<side>.json and nothing creates record/: without
    # this, verify died here on both sides of every pull request that touched a platform/ dir,
    # no record was uploaded, and judge failed the run as unreadable (#6224, #6226, 10-14).
    os.makedirs(os.path.dirname(record) or ".", exist_ok=True)
    with open(record, "w") as f:
        json.dump(doc, f, indent=2)


def verify(head, paths, record=None):
    """Run the shadow on `head`; with `record`, also write the run's failures as JSON."""
    fails = []
    rc = 2
    try:
        rc, fails = _verify(head, paths)
        return rc, [m for _, m in fails]
    finally:
        write_record(record, head, rc, fails)


def _verify(head, paths):
    """(rc, [(scope, message)]): scope is the path, workload or floor stage that failed."""
    if not head:
        return 2, [
            (
                "run",
                "--head is required: a shadow run proves one commit, or it proves nothing",
            )
        ]
    for tool in ("k3d", "kubectl", "flux"):
        if not have(tool):
            return 2, [("run", f"{tool} is not installed; this run proves nothing")]
    if not paths:
        return 2, [("run", "no path under test; nothing to reconcile")]

    daemon = serve_tree()
    vault_stop = threading.Event()
    try:
        flux_source(head)
        floor_failed = flux_floor(time.time() + 300)
        if floor_failed:
            return 1, [("floor", m) for m in floor_failed]
        config_failed = estate_config()
        if config_failed:
            return 1, [("estate-config", config_failed)]
        threading.Thread(target=stand_in_vault, args=(vault_stop,), daemon=True).start()
        # #5747: a row whose postBuild names github-app cannot converge until that Secret exists,
        # and stand_in_vault finds it only after the github-app-creds row has applied the
        # ExternalSecret. flux_floor lays that row before this point, so the ExternalSecret is
        # in the shadow; the stand-in polls every 5s and vault_wait bounds the wait. Wait here so
        # the mcp row is not applied into a missing-Secret failure that Flux then retries on its
        # 5m interval. A timeout is still not fatal: rows that do not name github-app converge
        # regardless.
        if vault_wait("flux-system", "github-app", timeout=120):
            print("ok      shadow  vault stand-in flux-system/github-app is ready")
        else:
            print(
                "note    shadow  flux-system/github-app did not appear within 120s; "
                "rows substituting from it will report a missing Secret"
            )
        if db_needs_standin(paths):
            db_failed = stand_in_database()
            if db_failed:
                return 1, [("database", db_failed)]
        image_failed = stand_in_private_images(paths)
        if image_failed:
            return 1, [("image", image_failed)]
        names = []
        for path in paths:
            name = "shadow-" + path.strip("/").replace("/", "-")[:50]
            flux_kustomization(name, path, substitute=True)
            names.append((name, path))

        deadline = time.time() + int(os.environ.get("IDP_SHADOW_TIMEOUT", "1200"))
        observations, hard = [], []
        for name, path in names:
            ready, msg, inv = wait_ks(name, deadline)
            if not ready:
                hard.append(
                    (path, f"{path}: the environment refused to converge it -- {msg}")
                )
                print(f"FAIL    shadow  flux could not reconcile {path}: {msg}")
                continue
            print(
                f"ok      shadow  flux reconciled {path} ({len(inv)} objects applied by the environment)"
            )
            for entry in inv:
                # Flux inventory ids are ns_name_group_kind
                parts = (entry.get("id") or "").split("_")
                if len(parts) != 4:
                    continue
                ns, nm, _grp, kind = parts
                if kind in WORKLOAD_KINDS:
                    observations.append(observe(kind, ns or "default", nm))

        if hard:
            return 1, hard
        if not observations:
            return 1, [
                (
                    "run",
                    "the reconcile created no workload; a shadow that deployed nothing "
                    "has proved nothing",
                )
            ]
        failed = grade_all(observations)
        if failed:
            return 1, [(w, f"{w}: {'; '.join(rs)}") for w, rs in failed]
        print(
            f"ok      shadow-verify  {len(observations)} workload(s) converged on head {head} "
            f"under flux (shadow-verify SUCCESS)"
        )
        return 0, []
    finally:
        vault_stop.set()
        daemon.terminate()
        try:
            daemon.wait(timeout=10)
        except subprocess.TimeoutExpired:
            daemon.kill()


# ---------------------------------------------------------------- judge


def load_record(path):
    """A record `verify --record` wrote, or None when it is missing or unreadable."""
    try:
        with open(path) as f:
            doc = json.load(f)
    except (OSError, ValueError, TypeError):
        return None
    if not isinstance(doc, dict) or doc.get("rc") not in (0, 1, 2):
        return None
    if not isinstance(doc.get("failures"), list):
        return None
    return doc


def judge(head_record, base_record):
    """Grade the head on what it changed: a failure the merge-base shows too is not the PR's.

    Fail-closed in every direction it can be: no readable head record is BLIND (2); a BLIND head
    run is BLIND; and a base record that is missing, unreadable or BLIND excuses nothing, so the
    head's failures stand exactly as a single run would have graded them.
    """
    h = load_record(head_record) if head_record else None
    if h is None:
        return 2, [
            f"no readable head record at {head_record!r}; the run proves nothing"
        ]
    if h["rc"] == 2:
        return 2, [f["message"] for f in h["failures"]] or ["the head run was BLIND"]
    if h["rc"] == 0:
        print(
            f"ok      shadow-verify  head {h.get('head')} converged (shadow-verify SUCCESS)"
        )
        return 0, []
    b = load_record(base_record) if base_record else None
    known = set()
    if b is None or b["rc"] == 2:
        print(
            "note    shadow-verify  no usable base run; every head failure is graded as the PR's"
        )
    else:
        known = {(f.get("scope"), f.get("signature")) for f in b["failures"]}
    new, inherited = [], []
    for f in h["failures"]:
        sig = f.get("signature") or signature(f.get("message", ""))
        (inherited if (f.get("scope"), sig) in known else new).append(f)
    for f in inherited:
        print(
            f"note    shadow-verify  inherited from base {b.get('head')}: {f['message']}"
        )
    if new:
        for f in new:
            print(
                f"FAIL    shadow-verify  introduced by head {h.get('head')}: {f['message']}"
            )
        return 1, [f["message"] for f in new]
    if not h["failures"]:
        # rc 1 with nothing named: a run that failed without saying why. Not a pass.
        return 1, ["the head run failed and recorded no failure"]
    print(
        f"ok      shadow-verify  head {h.get('head')} introduced no failure; "
        f"{len(inherited)} inherited from base {b.get('head')} (shadow-verify SUCCESS)"
    )
    return 0, []


# ---------------------------------------------------------------- down


def down():
    if not have("k3d"):
        return 0, []
    sh(["k3d", "cluster", "delete", CLUSTER], check=False)
    print(f"ok      shadow  cluster {CLUSTER} deleted; nothing survives, by design")
    return 0, []


def main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("cmd", choices=["up", "verify", "judge", "down"])
    ap.add_argument("--head", help="the commit under test (verify)")
    ap.add_argument(
        "--path",
        action="append",
        default=[],
        help="a directory Flux should reconcile; repeatable",
    )
    ap.add_argument("--record", help="verify: write the run's failures here as JSON")
    ap.add_argument("--head-record", help="judge: the head run's record")
    ap.add_argument("--base-record", help="judge: the merge-base run's record")
    a = ap.parse_args(argv)

    if a.cmd == "up":
        rc, lines = up()
    elif a.cmd == "down":
        rc, lines = down()
    elif a.cmd == "judge":
        rc, lines = judge(a.head_record, a.base_record)
    else:
        rc, lines = verify(a.head, a.path, a.record)
    for line in lines:
        print(f"       {line}")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
