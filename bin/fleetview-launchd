#!/usr/bin/env python3
"""launchd's door into fleetview: load the router key from the vault by name, then become the server.

WHY. litellm-local refuses a keyed lane without the laptop router key (3027e45b), and the launchd
job had no way to hold it: a key in the plist is a key in a file (AGENTS.md section 4). So every
/voice/stream answered 401 and /fleet's default voice engine was dead; measured 2026-09-27 with
bin/voice-latency-gate --engine estate (BLIND).

WHY PYTHON. launchd cannot start /bin/sh on anything under ~/Documents (TCC, exit 126), while the
framework Python it already runs fleetview with can. So this is Python, run by that interpreter.

The key goes through estate-secrets/scripts/secret-load, the vault's one egress, into this
process's environment only. Never printed. If it cannot be loaded the server still starts and
/voice answers 503 naming LITELLM_API_KEY -- a board without voice beats no board.
"""

import os
import subprocess
import sys
from pathlib import Path

SECRET_LOAD = Path(
    os.environ.get("ESTATE_SECRET_LOAD")
    or Path.home() / "Documents/code/estate-secrets/scripts/secret-load"
)


def load_key(
    entry: str = "LITELLM_LAPTOP_KEY",
    name: str = "LITELLM_API_KEY",
    what: str = "router key",
    quiet: bool = False,
) -> str:
    """The vault's dev/<entry>, or <name> if the environment already holds it. bin/voice-router-launchd
    loads the estate memory key (dev/MCP_GATEWAY_KEY) through this same door."""
    if os.environ.get(name):
        return os.environ[name]
    env = dict(os.environ)
    # launchd's PATH is /usr/bin:/bin:/usr/sbin:/sbin: secret-load needs sops and a python3.
    extra = [
        str(Path(sys.executable).parent),
        str(Path.home() / ".cache/estate-tools"),
        "/usr/local/bin",
        "/opt/homebrew/bin",
    ]
    env["PATH"] = ":".join([*extra, env.get("PATH", "/usr/bin:/bin")])
    try:
        r = subprocess.run(
            [
                "/bin/bash",
                str(SECRET_LOAD),
                "dev",
                entry,
                name,
            ],
            capture_output=True,
            text=True,
            timeout=30,
            env=env,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        if quiet:
            return ""
        print(
            f"fleetview-launchd: {what} not loaded: {type(exc).__name__}",
            file=sys.stderr,
        )
        return ""
    if r.returncode != 0 or not r.stdout.strip():
        if quiet:
            return ""
        # stderr is sops's, which names files, never values; the last line says why.
        why = (r.stderr.strip().splitlines() or ["no output"])[-1][:200]
        print(
            f"fleetview-launchd: {what} not loaded (exit {r.returncode}): {why}",
            file=sys.stderr,
        )
        return ""
    return r.stdout.strip()


def agent_key(router_key: str) -> tuple[str, str]:
    """The key spoken intents curl the router with (`Bearer $ESTATE_AGENT_KEY`: router-status,
    cost-today, ledger-verify), and where it came from.

    WHY. estate-execute reads ESTATE_AGENT_KEY from its inherited environment and nothing set it,
    so every one of those intents sent an empty bearer and the router answered 401 (measured
    2026-10-19: no key 401, the laptop key 200). A dedicated dev/ESTATE_AGENT_KEY vault entry wins
    when it exists -- the narrower credential this variable's name promises. Until someone mints
    one, the router key this process already holds is the fallback: the intents run on this
    laptop, against the router it is already trusted to call."""
    dedicated = load_key(
        "ESTATE_AGENT_KEY", "ESTATE_AGENT_KEY", "agent key", quiet=True
    )
    if dedicated:
        return dedicated, "dedicated vault entry"
    if router_key:
        return router_key, "router key (no dev/ESTATE_AGENT_KEY entry)"
    return "", "MISSING -- router intents will answer 401"


def runtime_src() -> Path:
    """The tree's own `fleetview_backend`, ahead of anything pip installed.

    WHY (2026-10-23). `python3 -m fleetview_backend.serve` resolved the package through an editable
    install whose `.pth` points at ~/Documents/code/idp -- a checkout that had not moved since
    October 18. So `ai.estate.runtime-sync` restaged main, restarted this job, and the process came
    back on the old code: measured, `fleetview_backend.__file__` was
    /Users/roseonyema/Documents/code/idp/backstage/plugins/fleetview-backend/src/..., whose
    voice_intents had no `args` handling at all, so production `pr-list` with
    {limit: 2, state: "merged"} was read back as "Run pr-list? Say yes to confirm." and listed open
    PRs. A converger that restarts a service which imports last month's checkout has converged
    nothing; this is the same defect runtime-sync exists to kill, one layer down.
    """
    return Path(__file__).resolve().parent.parent / "backstage" / "plugins" / "fleetview-backend" / "src"


def main() -> None:
    src = runtime_src()
    # execv passes this environment to the server, and `-m` searches PYTHONPATH before site-packages,
    # so the tree's code wins over the editable install whatever that install points at.
    os.environ["PYTHONPATH"] = os.pathsep.join(
        [str(src), *([os.environ["PYTHONPATH"]] if os.environ.get("PYTHONPATH") else [])]
    )
    if not (src / "fleetview_backend" / "serve.py").is_file():
        # Louder than a fallback: an empty tree serves nothing, and answering 200 on a route nobody
        # implemented is how the estate ends up believing a plane is up.
        print(
            f"fleetview-launchd: no fleetview_backend in {src}; refusing to start on an install "
            "from another checkout",
            file=sys.stderr,
        )
        sys.exit(78)
    key = load_key()
    if key:
        os.environ["LITELLM_API_KEY"] = key
    intent_key, intent_key_from = agent_key(key)
    if intent_key:
        os.environ["ESTATE_AGENT_KEY"] = intent_key
    print(f"fleetview-launchd: intent key {intent_key_from}", file=sys.stderr)
    # The server inherits launchd's PATH too, and agent_jobs shells out to `gh auth token` when no
    # token file is set. With /usr/bin:/bin only, gh (in ~/.local/bin or Homebrew) was not found and
    # /agent-jobs answered 503 "Fleet has no GitHub credential" with gh logged in (2026-10-09).
    tool_dirs = [
        str(Path.home() / ".local/bin"),
        "/opt/homebrew/bin",
        "/usr/local/bin",
    ]
    os.environ["PATH"] = ":".join([*tool_dirs, os.environ.get("PATH", "/usr/bin:/bin")])
    print(
        f"fleetview-launchd: router key {'loaded' if key else 'MISSING -- /voice will answer 503'}",
        file=sys.stderr,
    )
    os.execv(
        sys.executable, [sys.executable, "-m", "fleetview_backend.serve", *sys.argv[1:]]
    )


if __name__ == "__main__":
    main()
