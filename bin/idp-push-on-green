#!/usr/bin/env bash
# bin/idp-push-on-green -- refuse a push onto a pull request that is already green (crew#584).
#
# Incident 2026-08-28 (crew#584, idp#628): the PR went green at 18:42:42Z (run 33200030561,
# 6m40s) and was then pushed to three more times -- 18:45, 18:50, 18:52 -- each push cancelling
# the run before it, so a 7-minute PR was open for 21 minutes and the founder wrote "look how
# long it takes". A green PR is merged; follow-up work is a second PR. This script is the
# pre-push rung that says so, once, with the fix on the line.
#
#   idp-push-on-green            exit 1 when the current branch has an open PR whose head
#                                already carries an all-green check run and the push would
#                                move that head; 0 otherwise (no PR, red or pending checks,
#                                nothing new to push). BLIND (no gh / no network) is exit 0:
#                                the push is not refused by an instrument that cannot see.
#
# IDP_PUSH_ON_GREEN=1 pushes anyway (a review asked for the change on this PR, say). The
# override is an environment variable so it is typed on purpose, never left on.
set -uo pipefail
[ "${IDP_PUSH_ON_GREEN:-0}" = 1 ] && { echo "ok    push-on-green: IDP_PUSH_ON_GREEN=1, pushing onto the green PR on purpose"; exit 0; }
command -v gh >/dev/null || { echo "ok    push-on-green: BLIND, no gh"; exit 0; }
meta=$(gh pr view --json number,headRefOid,statusCheckRollup,state,mergeStateStatus 2>/dev/null) || { echo "ok    push-on-green: no open PR for this branch"; exit 0; }
[ "$(printf '%s' "$meta" | jq -r .state)" = OPEN ] || { echo "ok    push-on-green: PR is not open"; exit 0; }
# A green PR that cannot merge (DIRTY = conflicts with main) is not one to protect: the only way to
# merge it is a push. idp#629 at 68e2e6b was refused here while `gh pr merge` refused it for conflicts.
[ "$(printf '%s' "$meta" | jq -r .mergeStateStatus)" != DIRTY ] || { echo "ok    push-on-green: PR conflicts with main, this push is the rebase"; exit 0; }
n=$(printf '%s' "$meta" | jq -r .number)
head=$(printf '%s' "$meta" | jq -r .headRefOid)
local_head=$(git rev-parse HEAD 2>/dev/null || true)
[ "$head" = "$local_head" ] && { echo "ok    push-on-green: #$n head already at ${head:0:7}, nothing new"; exit 0; }
# Green = every check concluded and none red. A pending or failed check means the push is a fix, allowed.
checks=$(printf '%s' "$meta" | jq -r '.statusCheckRollup | length')
[ "$checks" -gt 0 ] || { echo "ok    push-on-green: #$n has no checks yet"; exit 0; }
red=$(printf '%s' "$meta" | jq -r '[.statusCheckRollup[] | (.conclusion // .state // "") | ascii_upcase] | map(select(. != "SUCCESS" and . != "SKIPPED" and . != "NEUTRAL")) | length')
[ "$red" -eq 0 ] || { echo "ok    push-on-green: #$n has $red check(s) not green, this push is a fix"; exit 0; }
cat <<EOF
FAIL  push-on-green: pull request #$n is GREEN at ${head:0:7} and this push would restart its CI (crew#584).
      A green PR is merged, not pushed to: 3 re-pushes turned a 7-minute PR into 21 minutes on idp#628.
      fix: gh pr merge $n --merge     then open a second PR for the new commits
      or:  IDP_PUSH_ON_GREEN=1 git push   when a review asked for a change on this PR
EOF
exit 1
