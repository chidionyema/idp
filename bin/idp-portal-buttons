#!/usr/bin/env python3
"""Every workflow a person could dispatch is a button in the portal (crew#66, founder 2026-08-28:
"founder does not remember commands or run scripts"; "we are underutilising backstage").

    bin/idp-portal-buttons            write backstage/templates/founder-actions/<workflow>/template.yaml
                                      for every .github/workflows/*.yml carrying workflow_dispatch
    bin/idp-portal-buttons --check    exit 1 naming each button that is missing or stale (CI, tests)

One template per workflow, generated from the workflow's own `workflow_dispatch.inputs` (a choice
becomes a drop-down, a default stays a default), one step: `github:actions:dispatch` on main,
authenticated by the portal's GitHub integration (`integrations.github[].token` in the app
config; the token is a lane-narrowed installation token of the estate-agents App, never a PAT). The
founder taps Create; the run lands under Actions and the template's output links it.
Nothing here is typed by hand, so a new dispatchable workflow with no button fails
tests/test_incident_crew66_every_dispatchable_workflow_has_a_button.py until this is re-run.
Reads only the tree; opens no socket.
"""

import pathlib
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[1]
WORKFLOWS = ROOT / ".github" / "workflows"
OUT = ROOT / "backstage" / "templates" / "founder-actions"
REPO_URL = "github.com?owner=chidionyema&repo=idp"
BRANCH = "main"
HEADER = "# GENERATED by bin/idp-portal-buttons from .github/workflows/{wf} -- edit the workflow, not this file.\n"
MARKER = "NOT generated: a pasted secret may not travel through a workflow_dispatch input"


def _not_generated(text):
    """True when a template or workflow body carries the hand-written marker the activate-key door
    depends on (docs/specs/key-ingest-door.md part 1 rule 1, part 3). A file carrying it must never
    be turned into (or back into) a github:actions:dispatch button: workflow_dispatch inputs are
    recorded and readable by anyone with repository read, which is the exact leak the marker exists
    to prevent. The check is the marker phrase, not a rule id, so a weakened/false rule cannot
    quietly un-flag it; only the literal sentinel is accepted."""
    return MARKER in (text or "")


def _founder_lines(text, wf):
    """The button's words are the workflow's `# button:` title and `# founder:` sentence, written
    for the person who presses it. The engineers' comment block below them never reaches the
    portal (founder, 2026-08-31: "dev speak should never cross boundaries"). A workflow without
    both lines gets no button and this generator fails naming it."""
    title = sentence = None
    for line in text.splitlines():
        if line.startswith("# button:"):
            title = line[len("# button:") :].strip()
        elif line.startswith("# founder:"):
            sentence = line[len("# founder:") :].strip()
        elif not line.startswith("#"):
            break
    if not (title and sentence):
        raise SystemExit(
            f"FAIL    portal-buttons: {wf} has no `# button: <plain title>` and `# founder: <one plain sentence>` header lines; the portal shows nothing else"
        )
    return title, sentence


def dispatchable():
    for path in sorted(WORKFLOWS.glob("*.yml")):
        text = path.read_text()
        doc = yaml.safe_load(text)
        on = doc.get("on") or doc.get(True) or {}
        if not isinstance(on, dict) or "workflow_dispatch" not in on:
            continue
        inputs = (on.get("workflow_dispatch") or {}).get("inputs") or {}
        title, sentence = _founder_lines(text, path.name)
        yield path.name, title, sentence, inputs


def template_for(wf, name, description, inputs):
    properties, required = {}, []
    for key, spec in inputs.items():
        spec = spec or {}
        # the form label is the plain sentence the workflow wrote for it, never the input's key
        prop = {
            "title": str(spec.get("description") or key.replace("_", " ")),
            "type": "boolean" if spec.get("type") == "boolean" else "string",
        }
        if spec.get("type") == "choice":
            prop["enum"] = [str(o) for o in spec.get("options") or []]
        if "default" in spec:
            prop["default"] = spec["default"]
        elif spec.get("required"):
            required.append(key)
        properties[key] = prop
    parameters = []
    if properties:
        step = {"title": "Choices for this run", "properties": properties}
        if required:
            step["required"] = required
        parameters.append(step)
    dispatch = {"repoUrl": REPO_URL, "workflowId": wf, "branchOrTagName": BRANCH}
    if properties:
        dispatch["workflowInputs"] = {
            k: "${{ parameters." + k + " }}" for k in properties
        }
    return {
        "apiVersion": "scaffolder.backstage.io/v1beta3",
        "kind": "Template",
        "metadata": {
            "name": f"run-{pathlib.Path(wf).stem}",
            "title": name,
            "description": description,
            "tags": ["founder-action", "estate"],
        },
        "spec": {
            "owner": "group:default/platform",
            "type": "founder-action",
            "parameters": parameters,
            "steps": [
                {
                    "id": "dispatch",
                    "name": f"Start {name}",
                    "action": "github:actions:dispatch",
                    "input": dispatch,
                }
            ],
            "output": {
                "links": [
                    {
                        "title": "Past runs",
                        "url": f"https://github.com/chidionyema/idp/actions/workflows/{wf}",
                    }
                ]
            },
        },
    }


def render(wf, name, description, inputs):
    return HEADER.format(wf=wf) + yaml.safe_dump(
        template_for(wf, name, description, inputs), sort_keys=False, width=100
    )





def main(argv):
    check = "--check" in argv
    wanted = {}
    for wf, name, description, inputs in dispatchable():
        wanted[OUT / pathlib.Path(wf).stem / "template.yaml"] = render(
            wf, name, description, inputs
        )
    if not wanted:
        print(
            "BLIND   portal-buttons: no workflow_dispatch workflow found under .github/workflows"
        )
        return 2
    present = set(OUT.glob("*/template.yaml"))
    bad = 0
    for path, text in sorted(wanted.items()):
        if marked_path(path):
            # A human put the secret marker on an on-disk OUT button that a workflow_dispatch
            # workflow still claims. Leave that hand-written file exactly as it is: a dispatch form
            # must never overwrite it, and it is not counted MISSING/STALE because overwriting it is
            # forbidden by the marker, not merely stale. (docs/specs/key-ingest-door.md part 3)
            print(f"marker-skip portal-buttons: {path.relative_to(ROOT)} carries the {MARKER!r} marker; left hand-written")
            present.discard(path)
            continue
        state = "ok"
        if not path.exists():
            state = "MISSING"
        elif path.read_text() != text:
            state = "STALE"
        if state != "ok" and not check:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
            state = "written"
        if state in ("MISSING", "STALE"):
            bad += 1
        print(f"{state:<8}portal-buttons: {path.relative_to(ROOT)}")
    for stray in sorted(present - set(wanted)):
        if marked_path(stray):
            # Hand-written door with no dispatch workflow behind it: a supported exception, not STRAY.
            print(f"marker-skip portal-buttons: {stray.relative_to(ROOT)} carries the {MARKER!r} marker; kept as a door")
            continue
        bad += 1
        print(
            f"STRAY   portal-buttons: {stray.relative_to(ROOT)} has no workflow_dispatch workflow behind it"
        )
    if check and bad:
        print(
            f"FAIL    portal-buttons: {bad} button(s) out of step with .github/workflows; run bin/idp-portal-buttons and commit"
        )
        return 1
    print(
        f"ok      portal-buttons: {len(wanted)} dispatchable workflow(s)"
    )
    return 0


def marked_path(path):
    """A target OUT button already carries the secret marker on disk, meaning a human shut generation
    off for this workflow; the generator must not clobber it with a dispatch form."""
    try:
        return _not_generated(path.read_text(encoding="utf-8", errors="replace"))
    except FileNotFoundError:
        # Nonexistent names cannot hold the marker; they are generated as usual.
        return False


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
