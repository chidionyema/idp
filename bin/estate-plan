#!/usr/bin/env python3
"""Declare and maintain a session's plan through the shell (idp#6675).

    estate-plan [--session <id>] <declare_plan|revise_plan|add_bdd|address_edgecases|address_2nd_order_effects|complete_goal> '<json>'

The plan lock refuses work until a plan is declared. The plan tools normally come from the
estate-memory bridge; when a session's bridge did not load -- or the runtime has no bridge at
all (Claude Code's CLI, Cline, Codex, Gemini) -- this is the door that is always there, so the
lock can never leave an agent with no way to comply.

THE CALL IS CHECKED AND RECORDED, not merely acknowledged. It is checked against this session's
own plan and then written into it, because the durable ledger is what every copy of the contract
replays: a declaration this command makes is the same plan the door reads a moment later, in any
runtime. The session is the one the caller presents (--session), the one the environment names
(ESTATE_SESSION_ID), or the one the door resolves from the caller's own process tree.

Exit codes: 0 the call applied and is recorded; 1 the call does not apply (the reason is on
stderr); 2 the command was used wrongly.
"""

import json
import os
import sys

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "platform",
        "estate",
        "memory",
    ),
)
import plan  # noqa: E402


def _usage() -> None:
    print(__doc__.strip().split("\n\n")[0], file=sys.stderr)
    print(__doc__.strip().split("\n\n")[1], file=sys.stderr)


def _split_session(argv: list) -> tuple:
    """The session the caller names, and the call itself."""
    args = list(argv)
    if args and args[0] == "--session":
        if len(args) < 2:
            return "", args
        return args[1], args[2:]
    if args and args[0].startswith("--session="):
        return args[0].split("=", 1)[1], args[1:]
    return "", args


def main(argv: list) -> int:
    session, rest = _split_session(argv)
    if len(rest) != 2 or rest[0] not in plan.PLAN_TOOLS:
        _usage()
        return 2
    try:
        args = json.loads(rest[1])
    except ValueError as e:
        print(f"estate-plan: the arguments are not JSON: {e}", file=sys.stderr)
        return 2
    if not isinstance(args, dict):
        print("estate-plan: the arguments must be a JSON object", file=sys.stderr)
        return 2
    sid = (session or "").strip() or plan.resolve_session_id()
    current = plan.ledger_plan(sid) if sid else None
    r = plan.apply(current, rest[0], args)
    if not r["ok"]:
        print(f"estate-plan: {r['reason']}", file=sys.stderr)
        return 1
    if sid:
        plan.record_plan_call(sid, rest[0], args)
    print(r["message"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
