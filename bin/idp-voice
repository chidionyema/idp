#!/usr/bin/env python3
"""idp-voice — the conversation loop.

Async duplex: listen() -> think() -> speak() over asyncio.Queue.
Micro-clause chunking: speak a clause while the model is still generating.
Barge-in: a line on stdin (or a new file in --watch) cancels speaking.

Modes:
  --ask "..."      text in, text out (no audio). The testable mode.
  --file x.wav     transcribe -> think -> speak
  --text "..."     text in, speak the answer
  --listen         live: record, transcribe, think, speak, repeat
  --check          which engines are reachable; exit non-zero if none

Honest degradation (LAW 38): BLIND voice ... on stderr, exit 2.
Config (LAW 46): OLLAMA_HOST, VOICE_MODEL, WHISPER_CMD, VOICE_SYSTEM, VOICE_MAX_TOKENS.
"""

from __future__ import annotations

import argparse
import asyncio
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
import wave
from pathlib import Path

# --------------------------------------------------------------------------
# Config (LAW 46)
# --------------------------------------------------------------------------

DEFAULT_HOST = "http://localhost:11434"
DEFAULT_MODEL = "deepseek-r1:8b"
DEFAULT_MAX_TOKENS = 512

SYSTEM_PROMPT = (
    "You are the estate's fleet operator. You answer questions about sessions, "
    "state and cost. You answer in one or two sentences, plainly. "
    "You never claim to have done something you have not done. "
    "If you do not know, you say so."
)

HTTP_TIMEOUT = 30.0  # every HTTP call passes a timeout. Never hang.

CLAUSE_BOUNDARIES = ",.?!;"


def ollama_host() -> str:
    return os.environ.get("OLLAMA_HOST", DEFAULT_HOST).rstrip("/")


def voice_model() -> str:
    return os.environ.get("VOICE_MODEL", DEFAULT_MODEL)


def voice_system() -> str:
    return os.environ.get("VOICE_SYSTEM", SYSTEM_PROMPT)


def voice_max_tokens() -> int:
    raw = os.environ.get("VOICE_MAX_TOKENS", str(DEFAULT_MAX_TOKENS))
    try:
        return int(raw)
    except ValueError:
        return DEFAULT_MAX_TOKENS


# --------------------------------------------------------------------------
# BLIND — honest degradation, loudly (LAW 38)
# --------------------------------------------------------------------------


class Blind(Exception):
    """Raised when an engine is not reachable. Carries the exit code."""

    def __init__(self, message: str, code: int = 2):
        super().__init__(message)
        self.message = message
        self.code = code


def blind(message: str, code: int = 2) -> "Blind":
    return Blind(message, code)


# --------------------------------------------------------------------------
# HTTP — urllib.request in a thread. Every call has a timeout.
# --------------------------------------------------------------------------


def _post(url: str, payload: dict, timeout: float = HTTP_TIMEOUT) -> bytes:
    """POST JSON, return raw body. Raises Blind on connection failure."""
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        raise blind(f"HTTP {exc.code} from {url}: {exc.reason}")
    except urllib.error.URLError as exc:
        raise blind(f"cannot reach {url}: {exc.reason}")
    except TimeoutError:
        raise blind(f"timeout after {timeout}s reaching {url}")
    except OSError as exc:
        raise blind(f"cannot reach {url}: {exc}")


def _get(url: str, timeout: float = HTTP_TIMEOUT) -> bytes:
    req = urllib.request.Request(url, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.read()
    except urllib.error.HTTPError as exc:
        raise blind(f"HTTP {exc.code} from {url}: {exc.reason}")
    except urllib.error.URLError as exc:
        raise blind(f"cannot reach {url}: {exc.reason}")
    except TimeoutError:
        raise blind(f"timeout after {timeout}s reaching {url}")
    except OSError as exc:
        raise blind(f"cannot reach {url}: {exc}")


async def _post_async(url: str, payload: dict, timeout: float = HTTP_TIMEOUT) -> bytes:
    return await asyncio.to_thread(_post, url, payload, timeout)


async def _get_async(url: str, timeout: float = HTTP_TIMEOUT) -> bytes:
    return await asyncio.to_thread(_get, url, timeout)


# --------------------------------------------------------------------------
# Engines
# --------------------------------------------------------------------------


def transcribe(path: str) -> str:
    """Transcribe an audio file.

    Order of preference:
      1. WHISPER_CMD set -> run it. THE PATH IS ALWAYS APPENDED, and `{path}` may also be used
         for a command that needs it in the middle. Appending unconditionally is what makes a
         plain `whisper-cli` or `whisper` work without the caller having to know this script's
         template syntax; a command that already contains `{path}` keeps the path where it was
         written and gets it appended too, which is harmless for every real transcriber (an extra
         trailing argument naming the same file) and keeps the rule to one sentence.
      2. A .txt sibling of the wav exists -> read it (so the loop is testable without a model).
      3. BLIND, naming the variable to set.
    """
    p = Path(path)
    whisper = os.environ.get("WHISPER_CMD")
    if whisper:
        # The path is ALWAYS appended, and `{path}` is substituted when present. A transcriber
        # invoked as `whisper-cli --model base` then receives the file with no template needed;
        # one written as `whisper --model base {path} --output txt` keeps its own placement.
        cmd = f"{whisper.replace('{path}', str(p))} {p}".strip()
        try:
            proc = subprocess.run(
                cmd,
                shell=True,
                capture_output=True,
                text=True,
                timeout=120,
            )
        except subprocess.TimeoutExpired:
            raise blind(f"transcriber timed out on {p}")
        except OSError as exc:
            raise blind(f"transcriber failed: {exc}")
        if proc.returncode != 0:
            raise blind(f"transcriber exited {proc.returncode}: {proc.stderr.strip()}")
        return proc.stdout.strip()

    sibling = p.with_suffix(".txt")
    if sibling.exists():
        return sibling.read_text(encoding="utf-8").strip()

    raise blind("no transcriber on this machine: set WHISPER_CMD")


def _ollama_chat_url() -> str:
    return f"{ollama_host()}/api/chat"


def _build_chat_payload(prompt: str, stream: bool) -> dict:
    return {
        "model": voice_model(),
        "messages": [
            {"role": "system", "content": voice_system()},
            {"role": "user", "content": prompt},
        ],
        "stream": stream,
        "options": {"num_predict": voice_max_tokens()},
    }


def think(prompt: str) -> str:
    """Blocking, non-streaming think. Used by --ask."""
    body = _post(_ollama_chat_url(), _build_chat_payload(prompt, stream=False))
    try:
        doc = json.loads(body.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as exc:
        raise blind(f"bad response from ollama: {exc}")
    msg = doc.get("message") or {}
    content = msg.get("content")
    if content is None:
        raise blind("ollama returned no message content")
    return content.strip()


async def think_stream(prompt: str):
    """Async generator yielding content deltas from Ollama's streaming /api/chat."""
    url = _ollama_chat_url()
    payload = _build_chat_payload(prompt, stream=True)
    data = json.dumps(payload).encode("utf-8")

    def _open():
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json"},
            method="POST",
        )
        try:
            return urllib.request.urlopen(req, timeout=HTTP_TIMEOUT)
        except urllib.error.HTTPError as exc:
            raise blind(f"HTTP {exc.code} from {url}: {exc.reason}")
        except urllib.error.URLError as exc:
            raise blind(f"cannot reach {url}: {exc.reason}")
        except TimeoutError:
            raise blind(f"timeout after {HTTP_TIMEOUT}s reaching {url}")
        except OSError as exc:
            raise blind(f"cannot reach {url}: {exc}")

    resp = await asyncio.to_thread(_open)
    try:
        while True:
            line = await asyncio.to_thread(resp.readline)
            if not line:
                break
            line = line.strip()
            if not line:
                continue
            try:
                doc = json.loads(line.decode("utf-8"))
            except (ValueError, UnicodeDecodeError):
                continue
            msg = doc.get("message") or {}
            piece = msg.get("content")
            if piece:
                yield piece
            if doc.get("done"):
                break
    finally:
        try:
            await asyncio.to_thread(resp.close)
        except Exception:
            pass


def _say_available() -> bool:
    return shutil.which("say") is not None


def speak(text: str) -> None:
    """macOS say + afplay. Blocking. Raises Blind if say is missing."""
    if not text.strip():
        return
    if not _say_available():
        raise blind("no speech synthesis")
    with tempfile.NamedTemporaryFile(suffix=".aiff", delete=False) as fh:
        out = fh.name
    try:
        proc = subprocess.run(
            ["say", "-o", out, text],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if proc.returncode != 0:
            raise blind(f"say exited {proc.returncode}: {proc.stderr.strip()}")
        if shutil.which("afplay"):
            subprocess.run(["afplay", out], capture_output=True, timeout=300)
    finally:
        try:
            os.unlink(out)
        except OSError:
            pass


# --------------------------------------------------------------------------
# Micro-clause chunking
# --------------------------------------------------------------------------


def split_clauses(buffer: str) -> tuple[list[str], str]:
    """Split buffer at clause boundaries.

    Returns (complete_clauses, remainder). A clause boundary is one of
    , . ? ! ; — the boundary character stays with the clause.
    """
    clauses: list[str] = []
    start = 0
    for i, ch in enumerate(buffer):
        if ch in CLAUSE_BOUNDARIES:
            piece = buffer[start : i + 1].strip()
            if piece:
                clauses.append(piece)
            start = i + 1
    remainder = buffer[start:]
    return clauses, remainder


# --------------------------------------------------------------------------
# The loop
# --------------------------------------------------------------------------


class VoiceLoop:
    def __init__(self, speak_enabled: bool = True):
        self.speak_enabled = speak_enabled
        self.speak_task: asyncio.Task | None = None
        self.barge_in = asyncio.Event()
        self.spoken: list[str] = []

    async def _speak_clause(self, clause: str) -> None:
        self.spoken.append(clause)
        if not self.speak_enabled:
            return
        await asyncio.to_thread(speak, clause)

    async def speak_stream(self, clauses: asyncio.Queue) -> None:
        """Consume clauses and speak them, one at a time, cancellable."""
        try:
            while True:
                clause = await clauses.get()
                if clause is None:
                    return
                await self._speak_clause(clause)
        except asyncio.CancelledError:
            raise

    async def think_and_speak(self, prompt: str) -> str:
        """Stream the model, chunk into clauses, speak while generating."""
        clauses: asyncio.Queue = asyncio.Queue()
        speaker = asyncio.create_task(self.speak_stream(clauses))
        buffer = ""
        full: list[str] = []
        try:
            async for delta in think_stream(prompt):
                full.append(delta)
                buffer += delta
                done, buffer = split_clauses(buffer)
                for clause in done:
                    await clauses.put(clause)
            tail = buffer.strip()
            if tail:
                await clauses.put(tail)
            await clauses.put(None)
            await speaker
        except asyncio.CancelledError:
            speaker.cancel()
            raise
        except Blind:
            speaker.cancel()
            raise
        return "".join(full).strip()

    async def barge_in_watcher(self, watch_dir: str | None) -> None:
        """Watch stdin for a line, and optionally a directory for new files."""
        loop = asyncio.get_running_loop()
        seen: set[str] = set()
        if watch_dir:
            try:
                seen = {str(p) for p in Path(watch_dir).glob("*.wav")}
            except OSError:
                seen = set()

        async def stdin_reader():
            while True:
                line = await loop.run_in_executor(None, sys.stdin.readline)
                if not line:
                    return
                if line.strip():
                    self.barge_in.set()
                    return

        stdin_task = asyncio.create_task(stdin_reader())
        try:
            while True:
                if watch_dir:
                    try:
                        now = {str(p) for p in Path(watch_dir).glob("*.wav")}
                    except OSError:
                        now = set()
                    if now - seen:
                        self.barge_in.set()
                        return
                if stdin_task.done():
                    return
                await asyncio.sleep(0.2)
        finally:
            stdin_task.cancel()


# --------------------------------------------------------------------------
# Modes
# --------------------------------------------------------------------------


def mode_ask(prompt: str) -> int:
    """Text in, text out. No audio. The testable mode."""
    print(f"USER  {prompt}")
    try:
        answer = think(prompt)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    print(f"AGENT {answer}")
    return 0


def mode_text(prompt: str) -> int:
    """Text in, speak the answer."""
    print(f"USER  {prompt}")
    try:
        answer = think(prompt)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    print(f"AGENT {answer}")
    try:
        speak(answer)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    return 0


def mode_file(path: str) -> int:
    """Transcribe -> think -> speak."""
    try:
        text = transcribe(path)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    print(f"USER  {text}")
    try:
        answer = think(text)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    print(f"AGENT {answer}")
    try:
        speak(answer)
    except Blind as exc:
        print(f"BLIND voice {exc.message}", file=sys.stderr)
        return exc.code
    return 0


def _record_once(seconds: float = 5.0) -> str:
    """Record from the default input to a temp wav. macOS: sox or ffmpeg."""
    out = tempfile.NamedTemporaryFile(suffix=".wav", delete=False).name
    if shutil.which("sox"):
        cmd = ["sox", "-d", "-r", "16000", "-c", "1", out, "trim", "0", str(seconds)]
    elif shutil.which("ffmpeg"):
        cmd = [
            "ffmpeg", "-y", "-f", "avfoundation", "-i", ":0",
            "-t", str(seconds), "-ar", "16000", "-ac", "1", out,
        ]
    else:
        raise blind("no recorder on this machine: install sox or ffmpeg")
    proc = subprocess.run(cmd, capture_output=True, text=True, timeout=seconds + 30)
    if proc.returncode != 0:
        raise blind(f"recorder exited {proc.returncode}: {proc.stderr.strip()}")
    return out


async def mode_listen(watch_dir: str | None) -> int:
    """Live loop: record, transcribe, think, speak, repeat. Barge-in cancels speaking."""
    loop = VoiceLoop(speak_enabled=True)
    watcher = asyncio.create_task(loop.barge_in_watcher(watch_dir))
    try:
        while True:
            loop.barge_in.clear()
            try:
                wav = await asyncio.to_thread(_record_once)
            except Blind as exc:
                print(f"BLIND voice {exc.message}", file=sys.stderr)
                return exc.code
            try:
                text = await asyncio.to_thread(transcribe, wav)
            except Blind as exc:
                print(f"BLIND voice {exc.message}", file=sys.stderr)
                return exc.code
            finally:
                try:
                    os.unlink(wav)
                except OSError:
                    pass
            if not text:
                continue
            print(f"USER  {text}")
            speak_task = asyncio.create_task(loop.think_and_speak(text))
            barge = asyncio.create_task(loop.barge_in.wait())
            done, pending = await asyncio.wait(
                {speak_task, barge}, return_when=asyncio.FIRST_COMPLETED
            )
            for task in pending:
                task.cancel()
            if speak_task in done:
                try:
                    answer = speak_task.result()
                    print(f"AGENT {answer}")
                except Blind as exc:
                    print(f"BLIND voice {exc.message}", file=sys.stderr)
                    return exc.code
            else:
                speak_task.cancel()
                print("BARGE-IN", file=sys.stderr)
    finally:
        watcher.cancel()


def mode_check() -> int:
    """Which engines are reachable. Exit non-zero if none."""
    ok = 0
    host = ollama_host()
    try:
        _get(f"{host}/api/tags", timeout=5.0)
        print(f"OK    ollama at {host}")
        ok += 1
    except Blind as exc:
        print(f"BLIND ollama: {exc.message}")

    if os.environ.get("WHISPER_CMD"):
        print(f"OK    transcriber: {os.environ['WHISPER_CMD']}")
        ok += 1
    else:
        print("BLIND transcriber: set WHISPER_CMD")

    if _say_available():
        print("OK    speech synthesis: say")
        ok += 1
    else:
        print("BLIND speech synthesis: say not found")

    return 0 if ok else 2


# --------------------------------------------------------------------------
# CLI
# --------------------------------------------------------------------------


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="idp-voice", description="the conversation loop")
    g = p.add_mutually_exclusive_group(required=True)
    g.add_argument("--ask", metavar="TEXT", help="text in, text out (no audio)")
    g.add_argument("--file", metavar="WAV", help="transcribe -> think -> speak")
    g.add_argument("--text", metavar="TEXT", help="text in, speak the answer")
    g.add_argument("--listen", action="store_true", help="live loop")
    g.add_argument("--check", action="store_true", help="which engines are reachable")
    p.add_argument("--watch", metavar="DIR", default=None, help="directory to watch for new wavs")
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.ask is not None:
        return mode_ask(args.ask)
    if args.file is not None:
        return mode_file(args.file)
    if args.text is not None:
        return mode_text(args.text)
    if args.check:
        return mode_check()
    if args.listen:
        try:
            return asyncio.run(mode_listen(args.watch))
        except KeyboardInterrupt:
            return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())

