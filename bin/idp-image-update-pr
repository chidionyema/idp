#!/usr/bin/env bash
# crew#267 / crew#439: open or refresh the flux/image-updates pull request and arm auto-merge.
# crew#439: idp#298 sat CONFLICTING for two hours while every push printed "ok auto-merge armed".
# A pull request that is not MERGEABLE is not ok: merge main into the branch (the controller's
# newTag lines win) and push with the flux-writer key so ci runs on the branch and the head commit
# carries the required checks (a push made with GITHUB_TOKEN fires no workflow). Anything else exits 1.
set -euo pipefail
branch=${IMAGE_UPDATE_BRANCH:-flux/image-updates}
OPTIMISED="Optimised: 1 -> 1 steps (a newTag line written by the image controller), 1 -> 1 round trips (one push, one pull request); cut: nothing, a machine-written tag bump has no plan to shrink (operating-model-gate rule optimised_plan, LAW 51)"
n=$(gh pr list --head "$branch" --base main --state open --json number -q '.[0].number')
if [ -z "$n" ]; then
  gh pr create --head "$branch" --base main \
    --title "$(git log -1 --format=%s)" \
    --body "$(printf '%s\n\n%s\n%s\n%s\n%s\n%s\n\n%s\n%s\n%s\n%s\n%s\n' \
      "$(git log -1 --format=%b)" \
      "$OPTIMISED" \
      "Spec: tests/test_incident_catalogue_image_never_repulled.py" \
      "Drill: login-drill" \
      "Cost-delta-usd-month: 0" \
      "Rung 7: production oracle, the backstage row health check rolls the Deployment on merge" \
      "## Architecture laws" \
      "- LAW 1 zero-gravity: n/a: image tag only, bin/cloud-agnostic-gate unchanged" \
      "- LAW 2 fractal: n/a: same container, new build" \
      "- LAW 3 nervous system: n/a: Deployment env unchanged" \
      "- LAW 4 calibration: n/a: no prediction made")"
  n=$(gh pr list --head "$branch" --base main --state open --json number -q '.[0].number')
fi
# crew#584 / idp#719: a pull request opened before this script carried the `Optimised:` line keeps
# its old body on every controller push, so operating-model-gate rule optimised_plan refused
# #719 for a day after idp#744 fixed the create path. An existing body that lacks the line gets it.
body=$(gh pr view "$n" --json body -q .body)
case "$body" in
  "Optimised: "*|*$'\n'"Optimised: "*) ;;
  *)
    gh pr edit "$n" --body "$(printf '%s\n\n%s\n' "$body" "$OPTIMISED")"
    echo "refresh image-update-pr #$n body gained the Optimised line (LAW 51)"
    ;;
esac
m=UNKNOWN
for _ in 1 2 3 4 5 6; do
  m=$(gh pr view "$n" --json mergeable -q .mergeable)
  [ "$m" != UNKNOWN ] && break
  sleep "${MERGEABLE_WAIT:-10}"
done
case "$m" in
  MERGEABLE) ;;
  CONFLICTING)
    git fetch origin main
    git -c user.name=image-update-pr -c user.email=image-update-pr@users.noreply.github.com \
      merge origin/main --no-edit -X ours -m "$branch: merge main, keep the controller's newTag lines (crew#439)"
    # A push made with GITHUB_TOKEN fires no ci run, so the workflow sets PUSH_URL to the ssh remote
    # and GIT_SSH_COMMAND to the flux-writer deploy key (kini-finish.yml does the same); that push
    # fires ci.yml on the branch and the ruleset grades the new head.
    git push "${PUSH_URL:-origin}" "HEAD:$branch"
    echo "refresh image-update-pr #$n was CONFLICTING, merged main as $(git rev-parse --short HEAD), pushed with the writer key"
    ;;
  *)
    echo "FAIL    image-update-pr #$n mergeable=$m after waiting; not armed"
    exit 1
    ;;
esac
gh pr merge "$n" --auto --squash
echo "ok      image-update-pr #$n auto-merge armed"
