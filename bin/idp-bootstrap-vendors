#!/usr/bin/env bash
# Root trust for every vendor credential, one command, no paste, no browser (crew#66; crew#579; R52).
#   bin/idp-bootstrap-vendors                  write every vendor key the vault is missing (platform/vendors/consoles.yaml), verified first
#   bin/idp-bootstrap-vendors --only <vendor>  one vendor
#   bin/idp-bootstrap-vendors --preflight      prove the vault, list what would be written, write nothing
#   bin/idp-bootstrap-vendors --rotate         write anew even where the vault key still verifies
#
# R52 (founder 2026-08-29): one root credential per provider, set by him once as a named repository
# secret; code does the rest. These vendors publish no create-key API, so the key itself is the root:
# the apply run maps each SEED_<VENDOR>_API_KEY secret into this process's environment (registry field
# `secret`), the key is proved against the vendor's API, then bin/idp-vault-put --merge writes every
# target (the other keys of the entry are kept). A key the vault already holds that still verifies is
# kept, so the repository secret may be deleted after the first green run. No secret is ever on argv or
# printed; nothing but vendor and key NAMES reach stdout. A vendor whose secret is absent and whose
# vault key does not verify is BLIND, listed, and the exit is 2 after every other vendor is handled.
# A vendor marked `pair` in the registry has two halves that the vendor can only grade together (the
# store's Google OAuth client): both roots are read, both shapes are checked, one verify call grades
# the pair, and both fields are written or neither is.
# The browser console driver, the Google SSO road and the laptop OCI sign-in this replaced were the
# wrong roots (crew#66 comment 5461144560); none of them may come back.
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
REG="$IDP/platform/vendors/consoles.yaml"
MODE=mint; ONLY=""; ROTATE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --preflight) MODE=preflight; shift ;;
    --rotate) ROTATE=1; shift ;;
    --only) ONLY=${2:?vendor}; shift 2 ;;
    *) sed -n 2,6p "$0"; exit 2 ;;
  esac
done
say()  { printf '%-7s %-20s %s\n' "$1" "$2" "$3"; }
bl()   { say BLIND "$1" "$2"; exit 2; }
for t in python3 curl jq; do command -v "$t" >/dev/null || bl deps "$t missing"; done
python3 -c 'import yaml' 2>/dev/null || bl deps "python3 has no yaml module (pip install pyyaml)"
[ -f "$REG" ] || bl registry "no $REG"

if [ "$MODE" = mint ]; then
  # The vault is written with whatever OCI identity is live: OIDC in the apply run, a session on a
  # laptop. This never signs anyone in (the laptop SSO was a wrong root).
  OCI_CLI_PROFILE=$("$IDP/bin/idp-oci-whoami" 2>/dev/null) || bl oci "no live OCI identity; run this from the apply workflow (oke-check.yml mode=apply)"
  export OCI_CLI_PROFILE OCI_CLI_AUTH=security_token
fi
VAULT_PUT_PREFLIGHT=1 "$IDP/bin/idp-vault-put" vendors --preflight | sed 's/^/        /' || bl vault "not reachable"

export IDP REG MODE ONLY ROTATE
exec python3 - <<'PY'
import os, re, sys, glob, json, functools, subprocess, tempfile, urllib.error, urllib.request
import yaml
IDP, REG, MODE, ONLY, ROTATE = (os.environ[k] for k in ("IDP", "REG", "MODE", "ONLY", "ROTATE"))
reg = yaml.safe_load(open(REG))["vendors"]
def say(st, who, msg): print(f"{st:<7} {who:<20} {msg}", flush=True)

def vault_get(entry):
    r = subprocess.run([f"{IDP}/bin/idp-cloud", "secret", "get", entry], capture_output=True, text=True)
    if r.returncode == 0:
        try: return json.loads(r.stdout)
        except ValueError: return {"_raw": r.stdout.strip()}
    if r.returncode == 1: return {}
    say("BLIND", entry, f"vault read exited {r.returncode} (split or unreadable)"); sys.exit(2)

def vault_put(entry, field, value):
    fd, path = tempfile.mkstemp(); os.write(fd, f"V_KEY={value}\n".encode()); os.close(fd)
    try:
        r = subprocess.run([f"{IDP}/bin/idp-vault-put", "--merge", entry, f"{field}=V_KEY"], env={**os.environ, "ESTATE_ENV_FILE": path}, capture_output=True, text=True)
    finally:
        os.unlink(path)
    if r.returncode != 0: say("FAIL", entry, f"vault write of {field} refused: {r.stderr.strip()[:120]}"); sys.exit(1)

@functools.lru_cache(maxsize=1)
def zone():
    """The estate's DNS zone is written once, in clusters/<cluster>/estate-config.yaml, and every
    other platform file says ${ESTATE_ZONE} (founder 2026-08-26, crew#269: "as always
    configurable"; bin/estate-zone-gate refuses a literal anywhere under platform/)."""
    for p in sorted(glob.glob(f"{IDP}/clusters/*/estate-config.yaml")):
        m = re.search(r"^\s*ESTATE_ZONE:\s*(\S+)", open(p).read(), re.M)
        if m: return m.group(1)
    return ""

def verify(v, subs):
    """subs maps a placeholder to its value: {"key": k} for a single root, one entry per target
    FIELD for a pair. Everything is substituted in-process; no value reaches argv."""
    spec = v["verify"]
    def fill(s):
        for ph, val in subs.items(): s = s.replace("{" + ph + "}", val)
        if "${ESTATE_ZONE}" in s:
            z = zone()
            if not z:
                # BLIND, never a quiet https://api./... probe: a half-built URL would be refused by
                # the vendor and read as a bad credential, which is the wrong thing to tell anyone.
                say("BLIND", "registry", "no ESTATE_ZONE in clusters/*/estate-config.yaml; the probe URL cannot be built")
                sys.exit(2)
            s = s.replace("${ESTATE_ZONE}", z)
        if "${" in s:
            say("FAIL", "registry", f"unresolved placeholder in {spec['url']}; every substitution is named here")
            sys.exit(1)
        return s
    headers = {k: fill(val) for k, val in (spec.get("headers") or {}).items()}
    data = fill(spec["body"]).encode() if spec.get("body") else None
    req = urllib.request.Request(fill(spec["url"]), data=data, method=spec["method"], headers=headers)
    refuse = spec.get("refuse_when")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            if refuse: return not re.search(refuse, resp.read(65536).decode("utf-8", "replace"))
            return 200 <= resp.status < 300
    except urllib.error.HTTPError as e:
        # An HTTPError IS the response, and a `refuse_when` vendor answers on a 4xx on purpose: the
        # Google token endpoint will not confirm an OAuth client, it will only refuse one it does
        # not know. Reading that body is the whole check. Without refuse_when a 4xx is still a FAIL.
        return bool(refuse) and not re.search(refuse, e.read(65536).decode("utf-8", "replace"))
    except Exception: return False


def sec(v, t):
    """The repository secret this target's root comes from. A target may carry its own (Telegram's
    two bots; each half of an OAuth pair); otherwise the vendor's one secret serves every target."""
    return t.get("secret") or v["secret"]


def holds(v, targets, values):
    """Does what we have verify? A pair is graded ONCE with every half substituted by its field
    name, because neither half means anything to the vendor alone. Everything else is graded once
    per distinct value as {key}, exactly as before."""
    if v.get("pair"): return verify(v, {t["field"]: values[t["field"]] for t in targets})
    return all(verify(v, {"key": k}) for k in {values[t["field"]] for t in targets})

def root(name, secret):
    """The root from the environment, consumed once; never on argv, never printed."""
    key = os.environ.pop(secret, "")
    return key.strip()

written = kept = 0; blind = []
for name, v in reg.items():
    if ONLY and name != ONLY: continue
    if v["kind"] != "secret": say("FAIL", name, f"kind {v['kind']!r} is not a road (R52: every vendor is kind: secret)"); sys.exit(1)
    # one root per (vendor, secret); a target with its own `secret` is its own root (Telegram bots).
    # `pair: true` is the exception and the reason this loop is shaped this way: the targets are two
    # halves of ONE credential that the vendor can only grade together, so they stay in one group.
    pair = bool(v.get("pair"))
    groups = {}
    for t in v["targets"]:
        groups.setdefault("" if pair else sec(v, t), []).append(t)
    for targets in groups.values():
        who = name if len(groups) == 1 else f"{name}/{targets[0]['field']}"
        names = sorted({sec(v, t) for t in targets})
        if MODE == "preflight":
            say("", who, " + ".join(names) + " -> " + ", ".join(f"{t['entry']}.{t['field']}" for t in targets)); continue
        have = {t["field"]: vault_get(t["entry"]).get(t["field"], "") for t in targets}
        if not ROTATE and all(have.values()) and holds(v, targets, have):
            say("ok", who, "every target verifies; kept"); kept += 1; del have; continue
        del have
        # One pop per SECRET, not per target: root() consumes the environment variable, so several
        # targets sharing one root must read it once between them.
        roots = {}
        for t in targets: roots.setdefault(sec(v, t), root(name, sec(v, t)))
        keys = {t["field"]: roots[sec(v, t)] for t in targets}
        del roots
        blank = sorted({sec(v, t) for t in targets if not keys[t["field"]]})
        if blank:
            blind.append(who); del keys
            say("BLIND", who, f"no {' or '.join(blank)} in the environment and the vault does not verify; the root is made once at {v['page']} and set with gh secret set {' '.join(blank)} (R52)"); continue
        for t in targets:
            shape = t.get("shape") or v.get("shape")
            if not shape: say("FAIL", who, f"{t['field']} has no shape in the registry; every root is anchored"); del keys; sys.exit(1)
            if not re.fullmatch(shape, keys[t["field"]]): say("FAIL", who, f"{sec(v, t)} does not match the registry shape"); del keys; sys.exit(1)
        if not holds(v, targets, keys):
            say("FAIL", who, f"{' + '.join(names)} refused by {v['verify']['url'].split('{')[0]}; revoke it and make one that works"); del keys; sys.exit(1)
        for t in targets: vault_put(t["entry"], t["field"], keys[t["field"]])
        del keys; written += 1
        say("ok", who, "verified, written to " + ", ".join(f"{t['entry']}.{t['field']}" for t in targets))
if MODE == "preflight": say("ok", "preflight", f"{len(reg)} vendors registered; nothing written")
else:
    say("ok" if not blind else "BLIND", "vendors", f"{written} written, {kept} kept, {len(blind)} blind; ExternalSecrets refresh within 1h")
    if blind: sys.exit(2)
PY
