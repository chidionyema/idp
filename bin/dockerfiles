#!/usr/bin/env bash
# dockerfiles: the one list of estate images in this repository (R24).
#
#   bin/dockerfiles            -> one line per image: <name> <dockerfile> <context>
#   bin/dockerfiles --json     -> the same as a JSON array of objects
#   bin/dockerfiles [--json] --changed-since <ref>
#                              -> only the images whose context (or Dockerfile) differs
#                                 from <ref>; every image when this script or the build
#                                 workflow changed, or when <ref> is unknown to git
#
# `Dockerfile` and `<name>.Dockerfile` both count; a `<name>.Dockerfile` is named
# by its stem (mcp/estate-mcp.Dockerfile -> estate-mcp), a bare Dockerfile by its
# directory. build-multiarch.yml builds this list and bin/multiarch-gate checks
# that nothing Dockerfile-shaped in the tree is missing from it, so an image can
# not escape R24 by its file name (found by chidionyema-b0, 2026-08-25).
set -euo pipefail
cd "$(dirname "$0")/.."
json=0; since=
while [ $# -gt 0 ]; do
  case "$1" in
    --json) json=1 ;;
    --changed-since) since=${2:-}; shift ;;
    *) echo "dockerfiles: unknown argument $1" >&2; exit 2 ;;
  esac
  shift
done
# Changed files against <ref>, or an empty answer (= build everything) when the ref is
# not in this clone: a shallow checkout or a force-push must never skip a build.
changed=
if [ -n "$since" ]; then
  if git rev-parse -q --verify "$since^{commit}" >/dev/null 2>&1; then
    changed=$(git diff --name-only "$since...HEAD" 2>/dev/null || git diff --name-only "$since" HEAD)
    case "$changed" in *bin/dockerfiles*|*.github/workflows/build-multiarch.yml*) changed= ; since= ;; esac
  else
    since=
  fi
fi
sources() {  # sources <dockerfile> <context>: the context paths the image copies in
  # Every COPY/ADD source that is not another stage (--from=) or a heredoc,
  # resolved against the context. `.` is the whole context. A Dockerfile that
  # copies nothing falls back to its whole context (crew#584 CP-G).
  local ctx=$2 line s
  grep -iE '^[[:space:]]*(COPY|ADD)[[:space:]]' "$1" | grep -viE -- '--from=' | while IFS= read -r line; do
    set -- $line; shift
    while [ $# -gt 1 ]; do
      s=$1; shift
      case "$s" in --*|'<<'*) continue ;; esac
      s=${s#./}
      if [ "$s" = . ] || [ -z "$s" ]; then echo "$ctx"; elif [ "$ctx" = . ]; then echo "$s"; else echo "$ctx/$s"; fi
    done
  done | sort -u
}
touched() {  # touched <dockerfile> <context>: does the diff reach this image?
  [ -z "$since" ] && return 0
  local f s srcs
  srcs=$(sources "$1" "$2")
  [ -z "$srcs" ] && srcs=$2
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    [ "$f" = "$1" ] && return 0
    while IFS= read -r s; do
      [ "$s" = . ] && return 0
      # shellcheck disable=SC2254  # unquoted on purpose: a COPY glob like app-config*.yaml must match
      case "$f" in $s|$s/*) return 0 ;; esac   # unquoted: a COPY glob like app-config*.yaml matches
    done <<< "$srcs"
  done <<< "$changed"
  return 1
}
# Excluded, with the reason. Anything Dockerfile-shaped not listed here and not
# produced below is a gate finding.
EXCLUDE='backstage/packages/backend/Dockerfile backstage/Dockerfile.dockerignore'   # upstream scaffold: needs a host yarn build and the repo root as context; the .dockerignore is backstage/Dockerfile's build context filter, not an image
rows=()
while IFS= read -r f; do
  f=${f#./}
  case " $EXCLUDE " in *" $f "*) continue ;; esac
  d=$(dirname "$f"); b=$(basename "$f")
  if [ "$b" = Dockerfile ]; then n=$(basename "$d"); [ "$n" = "." ] && n=idp; else n=${b%.Dockerfile}; fi
  touched "$f" "$d" || continue
  rows+=("$n $f $d")
done < <(find . \( -name Dockerfile -o -name '*.Dockerfile' \) -not -path '*/node_modules/*' -not -path './.git/*' -not -path './tests/*' | sort)
if [ "$json" = 1 ]; then
  { printf '%s\n' "${rows[@]:-}" | grep . || true; } | jq -Rc 'split(" ") | {name: .[0], dockerfile: .[1], context: .[2]}' | jq -sc .   # no image touched prints [], never a non-zero exit (crew#584 CP-G)
else
  printf '%s\n' "${rows[@]:-}" | grep . || true
fi
