#!/usr/bin/env bash
# Refuse to let a local OpenTofu state file be copied over the shared remote state.
# Incident 2026-08-26 02:26Z: `tofu init -migrate-state -force-copy` in platform/oci pushed a
# stale platform/oci/terraform.tfstate (serial 7, 30 resources) over estate/terraform.tfstate in
# the bucket; oci_identity_dynamic_group.workers and oci_identity_policy.workers_read_secrets
# fell out of state and every oke-check run on every branch failed tofu-plan rc=2 for 40 minutes.
# Usage: bin/idp-state-guard <module dir>. Exit 0 always; a non-empty local state is moved to
# <name>.quarantine-<utc> (gitignored by *.tfstate*) and the move is printed.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
M="${1:?module dir}"
[ -d "$M" ] || {
	echo "BLIND   state   $M is not a directory"
	exit 0
}
n=0
for f in "$M"/terraform.tfstate "$M"/terraform.tfstate.backup; do
	[ -s "$f" ] || {
		rm -f "$f"
		continue
	}
	q="$M/$(basename "$f").quarantine-$(date -u +%Y%m%dT%H%M%SZ)"
	mv "$f" "$q"
	n=$((n + 1))
	echo "GUARD   state   $(basename "$f") ($(wc -c <"$q" | tr -d ' ') bytes) moved to $(basename "$q"): a local state is never migrated over the remote (incident 2026-08-26 02:26Z)"
done
[ "$n" = 0 ] && echo "ok      state   no local state in $M"
exit 0
