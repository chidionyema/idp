#!/bin/sh
# One deterministic disk tick. The governed cleaner owns every deletion and keep rule.
set -u
VOLUME=${DISK_GUARD_PATH:-/System/Volumes/Data}
FLOOR_MB=${DISK_FLOOR_MB:-3000}
CLEANUP=${DISK_WATCH_CLEANER:-$HOME/.estate/libexec/disk-cleanup.sh}
HEARTBEAT=${DISK_WATCH_HEARTBEAT:-$HOME/.estate/heartbeats/disk-guardian.json}
WATCH_BUDGET=${DISK_WATCH_BUDGET_S:-45}
free_mb=$(df -m "$VOLUME" 2>/dev/null | awk 'NR==2 {print $4}')
case "${free_mb:-}" in ''|*[!0-9]*) echo "BLIND disk-watch cannot read free space on $VOLUME"; exit 0;; esac
state=healthy
[ "$free_mb" -ge "$FLOOR_MB" ] || state=reclaiming
mkdir -p "${HEARTBEAT%/*}" 2>/dev/null || true
printf '{"at":"%s","state":"%s","free_mb":%s}\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$state" "$free_mb" >"$HEARTBEAT.tmp" 2>/dev/null &&
  mv -f "$HEARTBEAT.tmp" "$HEARTBEAT" 2>/dev/null || true
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) disk-watch free_mb=$free_mb floor_mb=$FLOOR_MB state=$state"
[ "$state" = healthy ] && exit 0
[ -x "$CLEANUP" ] || { echo "BLIND disk-watch cleaner missing: $CLEANUP"; exit 1; }
DISK_CLEANUP_PHASES=${DISK_CLEANUP_PHASES:-caches,temp} DISK_CLEANUP_TARGET_MB=${DISK_CLEANUP_TARGET_MB:-6000} \
  DISK_CLEANUP_INCREMENTAL=1 bash "$CLEANUP" true false "$FLOOR_MB" false "$WATCH_BUDGET"
rc=$?
case "$rc" in 0|4|5) exit 0;; 3|143) exit 0;; *) exit "$rc";; esac
