#!/usr/bin/env python3
"""estate-diagram: draw what is running now, from the catalogue, never by hand.

Founder, 2026-08-25 (R29, crew#236 row 2): "Diagrams are generated from what is running.
A hand-drawn one is deleted." The live state is collected by ~/.estate/scripts/inventory.py
(launchd jobs, listeners, repos, guards, ledgers, drills) into inventory.json, and
bin/catalog-gen turns that into catalog/catalog-info.yaml with its dependsOn edges. This
file is the third renderer of the same inventory: it reads the catalogue and writes one
Mermaid page. It collects nothing, so it can never disagree with the catalogue.

    estate-diagram                      render catalog/catalog-info.yaml -> docs/architecture/live.md
    estate-diagram --catalog F --out G  other paths (the tests use a fixture)
    estate-diagram --check              exit 1 when the page on disk is not what the catalogue says

The page has two parts. The graph shows every repository (Component) with the number of
scheduled jobs, guards and ledgers that belong to it, the ports listening on this machine
attached to the repository whose checkout runs them, and the vendor each repository is
coupled to. The table lists every scheduled job with its interval and last status, so "is
it running" is read off the page, not remembered. 274 entities and 371 edges drawn one to
one is not a diagram anyone reads (LAW 28), so jobs, guards and ledgers are counts on the
node and the full list is the table.

Deterministic: same catalogue, same bytes. The header carries the inventory timestamp
that catalog-gen wrote, so a stale page says when it was true.
"""
from __future__ import annotations

import argparse
import os
import re
import sys
from collections import defaultdict
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parent.parent
CATALOG = ROOT / "catalog" / "catalog-info.yaml"
OUT = ROOT / "docs" / "architecture" / "live.md"


def mermaid_id(name: str) -> str:
    return "n_" + re.sub(r"[^A-Za-z0-9_]", "_", name)


def load(catalog: Path):
    text = catalog.read_text(encoding="utf-8")
    m = re.search(r"^# inventory taken: (.+)$", text, re.M)
    taken = m.group(1).strip() if m else "unknown"
    docs = [d for d in yaml.safe_load_all(text) if d]
    return taken, docs


def render(taken: str, docs: list) -> str:
    comps = sorted((d for d in docs if d["kind"] == "Component"), key=lambda d: d["metadata"]["name"])
    res = [d for d in docs if d["kind"] == "Resource"]
    by_type = defaultdict(list)
    for r in res:
        by_type[r.get("spec", {}).get("type")].append(r)

    # counts of jobs/guards/ledgers per component, from dependsOn edges
    counts = defaultdict(lambda: defaultdict(int))
    vendors = defaultdict(set)
    for r in res:
        t = r.get("spec", {}).get("type")
        for dep in r.get("spec", {}).get("dependsOn", []) or []:
            if dep.startswith("component:"):
                counts[dep.split("/", 1)[-1]][t] += 1
    for c in comps:
        v = (c["metadata"].get("annotations") or {}).get("estate/coupling", "none")
        if v and v != "none":
            vendors[c["metadata"]["name"]].add(v)

    # a port belongs to the repository whose checkout path appears in its command line
    paths = [(c["metadata"]["name"], (c["metadata"].get("annotations") or {}).get("estate/path", "")) for c in comps]
    paths = sorted((n, p) for n, p in paths if p)
    port_owner = {}
    for p in by_type.get("port", []):
        cmd = (p["metadata"].get("annotations") or {}).get("estate/command", "")
        best = ""
        for n, path in paths:
            if path and path in cmd and len(path) > len(best):
                best, port_owner[p["metadata"]["name"]] = path, n

    lines = [
        "# Live estate",
        "",
        f"GENERATED by `bin/estate-diagram` from `catalog/catalog-info.yaml`, inventory taken {taken}. "
        "Do not edit: the next render overwrites it. Regenerate with `make diagrams`; "
        "`bin/estate-diagram --check` fails when this page and the catalogue disagree.",
        "",
        f"{len(comps)} repositories, {len(by_type.get('scheduled-job', []))} scheduled jobs, "
        f"{len(by_type.get('guard', []))} guards, {len(by_type.get('ledger', []))} ledgers, "
        f"{len(by_type.get('port', []))} listening ports, {len(by_type.get('drill', []))} drills.",
        "",
        "```mermaid",
        "flowchart LR",
    ]
    for c in comps:
        n = c["metadata"]["name"]
        k = counts[n]
        label = f"{n}<br/>{k['scheduled-job']} jobs · {k['guard']} guards · {k['ledger']} ledgers"
        lines.append(f'  {mermaid_id(n)}["{label}"]')
    seen_vendor = set()
    for n in sorted(vendors):
        for v in sorted(vendors[n]):
            if v not in seen_vendor:
                lines.append(f'  {mermaid_id("vendor-" + v)}(("{v}"))')
                seen_vendor.add(v)
            lines.append(f"  {mermaid_id(n)} -.-> {mermaid_id('vendor-' + v)}")
    for p in sorted(by_type.get("port", []), key=lambda d: int((d["metadata"].get("annotations") or {}).get("estate/port", "0"))):
        a = p["metadata"].get("annotations") or {}
        pid = mermaid_id(p["metadata"]["name"])
        lines.append(f'  {pid}[/"{p["metadata"]["name"]} · {a.get("estate/owner", "")} · {a.get("estate/bind", "")}"/]')
        owner = port_owner.get(p["metadata"]["name"])
        lines.append(f"  {pid} --> {mermaid_id(owner)}" if owner else f'  {pid} --> {mermaid_id("outside")}')
    if any(p["metadata"]["name"] not in port_owner for p in by_type.get("port", [])):
        lines.append(f'  {mermaid_id("outside")}["(process outside every checkout)"]')
    lines += ["```", "", "## Scheduled jobs", "", "| job | every | last status | loaded | belongs to |", "|---|---|---|---|---|"]
    for j in sorted(by_type.get("scheduled-job", []), key=lambda d: d["metadata"]["name"]):
        a = j["metadata"].get("annotations") or {}
        owner = next((d.split("/", 1)[-1] for d in (j.get("spec", {}).get("dependsOn") or []) if d.startswith("component:")), "")
        iv = a.get("estate/interval-s", "")
        every = f"{int(iv)//60} min" if iv.isdigit() and int(iv) >= 60 else (f"{iv} s" if iv else "")
        lines.append(f"| {j['metadata']['name']} | {every} | {a.get('estate/last-status', '')} | {a.get('estate/loaded', '')} | {owner} |")
    lines.append("")
    return "\n".join(lines)


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--catalog", default=str(CATALOG))
    ap.add_argument("--out", default=str(OUT))
    ap.add_argument("--check", action="store_true", help="exit 1 when the page on disk differs from the catalogue")
    args = ap.parse_args(argv)
    catalog, out = Path(args.catalog), Path(args.out)
    if not catalog.is_file():
        print(f"BLIND estate-diagram: no catalogue at {catalog} (run bin/catalog-gen)", file=sys.stderr)
        return 3
    page = render(*load(catalog))
    if args.check:
        if out.is_file() and out.read_text(encoding="utf-8") == page:
            print(f"ok    estate-diagram: {out} matches the catalogue")
            return 0
        print(f"FAIL  estate-diagram: {out} is not what {catalog} says; run bin/estate-diagram")
        return 1
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(page, encoding="utf-8")
    print(f"estate-diagram: {page.count(chr(10))} lines -> {os.path.relpath(out)}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
