#!/usr/bin/env python3
"""Scaffold a component around an EXISTING interface contract; no invented implementation."""
from __future__ import annotations
import argparse
import json
import re
import shutil
from pathlib import Path

IDENT = re.compile(r"^[a-z][a-z0-9.-]*(?:/[a-z][a-z0-9.-]*)+$")
SEMVER = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)$")

def create(root: Path, identifier: str, capability: str, owner: str,
           version: str, contract: Path, kind: str = "primitive") -> Path:
    if not IDENT.fullmatch(identifier) or not IDENT.fullmatch(capability):
        raise ValueError("component and capability IDs must be slash-namespaced")
    if not SEMVER.fullmatch(version):
        raise ValueError("version must be explicit SemVer")
    if not owner.strip():
        raise ValueError("owner is mandatory")
    if kind not in ("primitive", "composite"):
        raise ValueError("invalid component kind")
    if not contract.is_file() or contract.suffix.lower() != ".json":
        raise ValueError("an existing JSON interface contract is mandatory")
    try:
        definition = json.loads(contract.read_text(encoding="utf-8"))
    except ValueError as exc:
        raise ValueError(f"invalid interface JSON: {exc}") from exc
    if not isinstance(definition, dict) or not definition:
        raise ValueError("interface contract must be a nonempty JSON object")
    base = root.resolve() / identifier
    if base.exists():
        raise FileExistsError(f"component already exists: {base}; never overwrite")
    base.mkdir(parents=True)
    for folder in ("src", "tests", "contracts"):
        (base / folder).mkdir()
    shutil.copyfile(contract, base / "contracts" / "interface.json")
    # Preserve directories in git; this is an empty boundary, not pretend working code.
    for folder in ("src", "tests"):
        (base / folder / ".gitkeep").write_text("", encoding="utf-8")
    manifest = {
        "schema": "estate.fractal.component/v1",
        "id": identifier,
        "version": version,
        "kind": kind,
        "owner": owner,
        "stage": "experimental",
        "source": "src",
        "provides": [{"capability": capability, "version": version,
                      "interface": "contracts/interface.json"}],
        "requires": [],
        "effects": ["none"],
        "state": "stateless",
        "verification": {"contract_tests": "tests"},
    }
    path = base / "component.json"
    path.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return path

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default="modules")
    parser.add_argument("--id", required=True)
    parser.add_argument("--capability", required=True)
    parser.add_argument("--owner", required=True)
    parser.add_argument("--version", default="0.1.0")
    parser.add_argument("--contract", required=True, type=Path)
    parser.add_argument("--kind", choices=("primitive", "composite"), default="primitive")
    args = parser.parse_args()
    print(create(Path(args.root), args.id, args.capability, args.owner,
                 args.version, args.contract, args.kind))
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
