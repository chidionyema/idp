#!/usr/bin/env bash
# idp-pr-secrets: gitleaks over the lines a pull request ADDS, before the PR is opened.
#
# Incident, 2026-08-27 (crew#539, idp#485): a vault-seed line `put k8sgpt key=<NAME>_LLM_API_KEY`
# named a field, not a value, but gitleaks reads `key=<UPPER>_API_KEY` as a generic-api-key and
# (this comment spells it with a placeholder because the literal form fails this very gate) and
# the security-scan job went red on the PR (and, with fetch-depth 0, on every open PR until
# idp#494). The line had passed bin/pr-report, which ran conftest only. LAW 45: the local gate
# now runs the same detector over the same lines CI will read, so a flagged line is refused on
# the laptop, never in a job log.
#
#   idp-pr-secrets FILE      FILE holds the added lines of the diff (bin/pr-report writes
#                            reports/pr-added.txt); stdin when FILE is -
#   idp-pr-secrets --self-test   runs the real scan against two built-in fixture lines (a
#                            registered vault key name, a fake AKIA-shaped secret) and exits
#                            0 only if both are graded correctly (LAW 43/45: idp-script-compiles
#                            requires a self-test that exercises the real path, not just --help).
#
# Prints one line: `ok      secrets   gitleaks <version>: no leaks in N added lines`, or
# `FAIL    secrets   gitleaks found N leak(s) in the added lines` followed by the redacted
# findings, or `BLIND   secrets   gitleaks not on PATH (brew install gitleaks)`.
# Exit 0 ok, 1 FAIL, 2 BLIND. BLIND is never a pass: pr-report exits 2 on it, the same way it
# does for a missing gh or conftest. The workflow that installed gitleaks in CI
# (operating-model-gate.yml) was deleted on 2026-09-04, so today the only plane that runs this
# is the pre-push hook on a laptop, which is told what to install (chidionyema/idp#2452).
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"

scan() {
  local f="$1"
  command -v gitleaks >/dev/null || { echo "BLIND   secrets   gitleaks not on PATH (brew install gitleaks)"; return 2; }
  [ -r "$f" ] || { echo "BLIND   secrets   cannot read $f"; return 2; }
  local n report out rc
  n=$(wc -l < "$f" | tr -d ' ')
  report=$(mktemp)
  # Not --redact here: the registry cross-check below needs the raw matched text to compare
  # against known vault key names. Nothing raw is ever printed -- see the FAIL branch.
  out=$(gitleaks stdin --no-banner --report-format json --report-path "$report" --exit-code 1 < "$f" 2>&1); rc=$?
  if [ "$rc" -eq 0 ]; then
    echo "ok      secrets   gitleaks $(gitleaks version 2>/dev/null): no leaks in $n added lines"; rm -f "$report"; return 0
  elif [ "$rc" -eq 1 ]; then
    # crew#180 2026-09-15: platform/vendors/consoles.yaml's bw:/field: rows are vault ENTRY NAMES
    # (the ExternalSecret CRD's remoteRef.key is a fixed schema field whose value must equal the
    # real Bitwarden item name -- neither side can be renamed), not secret values. A finding whose
    # matched text is one of those declared names is the same false-positive class the CI-side
    # gate already allowlists by commit fingerprint in .gitleaksignore; this stdin scan has no
    # commit to fingerprint, so it checks the registry -- the actual root of truth -- instead.
    local known real findings secret
    known=$(python3 -c "
import re, sys
text = open('$IDP/platform/vendors/consoles.yaml').read()
names = set(re.findall(r'\b(?:bw|field):\s*(\S+)', text))
print('\n'.join(sorted(names)))
" 2>/dev/null)
    real=0
    findings=$(python3 -c "
import json
try:
    d = json.load(open('$report'))
except Exception:
    d = []
for finding in d:
    print(finding.get('Secret',''))
" 2>/dev/null)
    while IFS= read -r secret; do
      [ -n "$secret" ] || continue
      if printf '%s\n' "$known" | grep -qxF "$secret"; then
        echo "ok      secrets   a flagged value matches a registered vault key name (platform/vendors/consoles.yaml), not a leak"
      else
        real=$((real + 1))
        echo "FAIL    secrets   gitleaks flagged a value absent from platform/vendors/consoles.yaml (redacted: ${secret:0:2}***${secret: -2})"
      fi
    done <<< "$findings"
    rm -f "$report"
    if [ "$real" -eq 0 ]; then
      echo "ok      secrets   gitleaks $(gitleaks version 2>/dev/null): no leaks in $n added lines (vault key names excepted)"
      return 0
    fi
    echo "FAIL    secrets   gitleaks found ${real} leak(s) in the added lines"
    return 1
  else
    echo "BLIND   secrets   gitleaks exited $rc"; printf '%s\n' "$out" | grep -vi '^\s*secret' | tail -5 | sed 's/^/        /'; rm -f "$report"; return 2
  fi
}

self_test() {
  command -v gitleaks >/dev/null || { echo "BLIND   secrets   gitleaks not on PATH (brew install gitleaks)"; return 2; }
  # SAMBANOVA_API_KEY_2 is a real registry entry (platform/vendors/consoles.yaml) long/entropic
  # enough to trip gitleaks' generic-api-key rule on its own -- shorter sibling names like
  # GROQ_API_KEY_2 sit under that entropy threshold and never reach the registry check at all,
  # so they can't prove this code path. Fail loudly if the registry ever drops this name.
  local registered=SAMBANOVA_API_KEY_2
  grep -q "\b${registered}\b" "$IDP/platform/vendors/consoles.yaml" || {
    echo "BLIND   secrets   self-test fixture $registered is no longer in platform/vendors/consoles.yaml"
    return 2
  }
  local fixture ok_out fake_out
  fixture=$(mktemp)
  printf '      remoteRef: { key: %s }\n' "$registered" > "$fixture"
  ok_out=$(scan "$fixture"); local ok_rc=$?
  rm -f "$fixture"
  if [ "$ok_rc" -ne 0 ] || ! grep -q "registered vault key name" <<< "$ok_out"; then
    echo "FAIL    secrets   self-test: registered name $registered was not excepted"
    printf '%s\n' "$ok_out" | sed 's/^/        /'
    return 1
  fi
  # Built from two pieces at runtime, never as one contiguous literal in this file's own source:
  # a fixture that reads as a real AWS-shaped secret to gitleaks would itself get flagged as an
  # added line the moment this script is committed, tripping the exact gate it is testing.
  local fake_prefix=AKIA fake_body
  fake_body=ABCDEFGHIJKLMNOP1234567890abcdEFGH
  fixture=$(mktemp)
  printf 'aws_secret_access_key = "%s%s"\n' "$fake_prefix" "$fake_body" > "$fixture"
  fake_out=$(scan "$fixture"); local fake_rc=$?
  rm -f "$fixture"
  if [ "$fake_rc" -ne 1 ] || ! grep -q "^FAIL" <<< "$fake_out"; then
    echo "FAIL    secrets   self-test: a fake unregistered secret was not flagged"
    printf '%s\n' "$fake_out" | sed 's/^/        /'
    return 1
  fi
  echo "ok      secrets   self-test: registered name excepted, unregistered secret flagged (gitleaks $(gitleaks version 2>/dev/null))"
  return 0
}

case "${1:-}" in
  --self-test) self_test; exit $? ;;
esac

f="${1:?added-lines file, or -}"
if [ "$f" = "-" ]; then f=$(mktemp); cat > "$f"; fi
scan "$f"; exit $?
