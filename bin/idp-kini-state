#!/usr/bin/env bash
# crew#396 step 4: read the KINI run's own receipt from Object Storage. The CronJob in
# platform/temporal/kini-state.yaml writes state/kini every 15 minutes from the engine's answer
# (`sovereign.cli kini receipt`); this reads it with whatever OCI auth the caller has (a runner's
# exchanged OIDC session in oke-check.yml). Same grading shape as bin/idp-cluster-state.
#   ok      kini-finish  <line 1 of the receipt>   -- fresh; last run green, running, or never started
#   FAIL    kini-finish  <why>                     -- receipt missing or stale, or the last run is red
#   BLIND   kini-finish  <why>                     -- no oci CLI or no session; nothing was graded
# Print the JSON body with --json. Max age 60 min = 4 schedule slots. Override KINI_STATE_MAX_AGE_MIN.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
IDP=$(cd "$(dirname "$0")/.." && pwd)
BUCKET="${DRILL_RECEIPT_BUCKET:-estate-drill-receipts}"
MAX_MIN="${KINI_STATE_MAX_AGE_MIN:-60}"
blind() {
	printf 'BLIND   kini-finish  %s\n' "$1"
	exit 2
}
fail() {
	printf 'FAIL    kini-finish  %s\n' "$1"
	exit 1
}
command -v python3 >/dev/null || blind "python3 is not installed"
head=$("$IDP/bin/idp-cloud" object head --bucket "$BUCKET" --name state/kini 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
	case "$head" in
	*"404"* | *NotFound* | *"not found"*) fail "no receipt state/kini in bucket $BUCKET: the kini-state CronJob has never completed (Flux row temporal not reconciled, or the worker image not built yet)" ;;
	*) blind "object head failed: $(printf '%s' "$head" | tail -1 | cut -c1-160)" ;;
	esac
fi
body=$("$IDP/bin/idp-cloud" object get --bucket "$BUCKET" --name state/kini 2>/dev/null)
# crew#539 (2026-08-28 00:28Z, run 33129788480): the outage receipt (36 Flux rows, 40 pods with
# their last log) outgrew ARG_MAX and `python3: Argument list too long` graded the estate BLIND
# at the moment it needed reading. The body travels by file, never by argv.
bodyf=$(mktemp)
trap 'rm -f "$bodyf"' EXIT
printf '%s' "$body" >"$bodyf"
IDP_LIB="$IDP/bin/lib" python3 - "$head" "$bodyf" "$MAX_MIN" "${1:-}" <<'PY'
import os as _os
def _body_arg(a):
    # crew#539: the receipt is a file path when the caller wrote it out (ARG_MAX, run 33129788480); a literal body is still accepted for the test harnesses.
    return (open(a, encoding='utf-8', errors='replace').read() if _os.path.isfile(a) else a).strip()
import json, re, sys
sys.path.insert(0, _os.environ.get("IDP_LIB", ""))
from receipt_age import receipt_age
head, body, max_min, flag = sys.argv[1], _body_arg(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
line1, _, rest = body.partition("\n")
try:
    head = json.loads(head)
except Exception as e:
    print(f"BLIND   kini-finish  object head was not readable JSON: {e}"); sys.exit(2)
age = receipt_age(head, 60.0, "kini-finish")
if not line1.startswith("ok "):
    print(f"FAIL    kini-finish  receipt does not start with ok: {line1[:120]!r}"); sys.exit(1)
if age > max_min:
    print(f"FAIL    kini-finish  receipt is {age:.0f} min old (max {max_min:.0f}): {line1[:120]}"); sys.exit(1)
kv = dict(m.groups() for m in re.finditer(r"(\w+)=(\S+)", line1))
if kv.get("status") not in ("COMPLETED", "RUNNING", "NONE") or kv.get("red") != "0":
    print(f"FAIL    kini-finish  status={kv.get('status')} red={kv.get('red')}: {line1[:120]}"); sys.exit(1)
print(f"ok      kini-finish  {line1} ({age:.0f} min ago)")
if flag == "--json":
    print(rest)
PY
