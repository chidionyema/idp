#!/usr/bin/env bash
# estate.db to the registry, so estate-mcp on the cluster has a producer (crew#458 row 3, crew#516 CP3).
#
# Until 2026-08-27 catalog/estate.db was written only by bin/db-gen on the founder Mac and mounted
# into the colima estate-mcp container, which is why platform/mcp/agentgateway.yaml shipped without
# the /estate/mcp route. The cloud catalog-render already holds the one input db-gen needs (the
# inventory from the bucket) and the crew checkout beside idp, so it builds the database there and
# pushes it as an OCI artifact the same way bin/idp-catalog-push ships the catalogue: `flux push
# artifact`, a proven tool, not a second uploader. estate-mcp's init container pulls it with
# `flux pull artifact` at start; a restart is a refresh.
#
# The artifact carries the three read-only inputs the Mac compose mounted (mcp/agentgateway.yml):
# estate.db, catalog-info.yaml (get_estate_inventory) and crew/STATE.md.
#
#   INV          inventory.json (default ~/.estate/state/inventory.json, same as db-gen)
#   CATALOG      rendered catalog-info.yaml (default catalog/catalog-info.yaml in this checkout)
#   STATE_MD     crew/STATE.md (default $ESTATE_CODE/crew/STATE.md, the sibling checkout)
#   SU           sqlite-utils (default this checkout's venv; CI passes the one on PATH)
#   ESTATE_DB_ARTIFACT  where it goes (default oci://ghcr.io/chidionyema/idp/estate-db:latest)
#   --dry-run    build the artifact directory and list it; push nothing (LAW 17: measure first)
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
IDP="$(cd "$(dirname "$0")/.." && pwd)"
INV="${INV:-$HOME/.estate/state/inventory.json}"
CATALOG="${CATALOG:-$IDP/catalog/catalog-info.yaml}"
STATE_MD="${STATE_MD:-${ESTATE_CODE:-$(dirname "$IDP")}/crew/STATE.md}"
ARTIFACT="${ESTATE_DB_ARTIFACT:-oci://ghcr.io/chidionyema/idp/estate-db:latest}"
dry=0
[ "${1:-}" = --dry-run ] && dry=1

for t in flux git jq; do command -v "$t" >/dev/null || {
	echo "BLIND $t missing"
	exit 2
}; done
for f in "$INV" "$CATALOG" "$STATE_MD"; do [ -s "$f" ] || {
	echo "BLIND $f missing or empty"
	exit 2
}; done

T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
INV="$INV" DB="$T/estate.db" "$IDP/bin/db-gen" >/dev/null
cp "$CATALOG" "$T/catalog-info.yaml"
cp "$STATE_MD" "$T/STATE.md"
rows=$(jq '.rows | length' "$INV")
REV="$(git -C "$IDP" rev-parse --short HEAD)@$(date -u +%Y%m%dT%H%M%SZ)"
if [ "$dry" = 1 ]; then
	echo "dry-run estate-db: $rows assets, would push $ARTIFACT revision $REV"
	ls -l "$T"
	exit 0
fi
gh auth token >/dev/null 2>&1 || {
	echo "BLIND gh holds no token"
	exit 2
}
gh auth token | flux push artifact "$ARTIFACT" --path="$T" \
	--source="https://github.com/chidionyema/idp" --revision="$REV" --creds "chidionyema:$(cat)" >/dev/null
echo "ok      estate-db pushed ($rows assets), revision $REV"
