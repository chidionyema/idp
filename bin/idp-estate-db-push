#!/usr/bin/env bash
# estate.db to the registry, so estate-mcp on the cluster has a producer (crew#458 row 3, crew#516 CP3).
#
# Until 2026-08-27 catalog/estate.db was written only by bin/db-gen on the founder Mac and mounted
# into the colima estate-mcp container, which is why platform/mcp/agentgateway.yaml shipped without
# the /estate/mcp route. The cloud catalog-render already holds the one input db-gen needs (the
# inventory from the bucket) and the crew checkout beside idp, so it builds the database there and
# pushes it as an OCI artifact the same way bin/idp-catalog-push ships the catalogue: `flux push
# artifact`, a proven tool, not a second uploader. estate-mcp's init container pulls it with
# `flux pull artifact` at start; a restart is a refresh.
#
# The artifact carries the three read-only inputs the Mac compose mounted (mcp/agentgateway.yml):
# estate.db, catalog-info.yaml (get_estate_inventory) and crew/STATE.md.
#
# estate.db carries two things, not one: db-gen's `assets` table (declared state, from the
# inventory) and the estate twin's `nodes`/`edges`/`node_events`/`freshness` tables (runtime +
# code + domain state, from bin/estate-twin-runtime). Until 2026-09-14 this script ran only
# db-gen, so the pushed artifact -- the one estate-mcp on the cluster actually serves --
# never carried a `nodes` table at all: mcp__estate__get_estate_state errored, and the graph
# the catalog-render job spent a whole step building into the CI runner's OWN checkout
# (catalog/estate.db there, not $T/estate.db here) never reached anyone who could read it.
#
# Ordering matters and is not interchangeable. db-gen's own publish step does
# `sqlite3 "$DB" ".restore '$tmp'"` when $DB already exists -- SQLite's online backup API,
# which replaces the ENTIRE destination file with the source, not a merge. So the sweep must
# run AFTER db-gen writes $T/estate.db, into that same file: running it first and letting
# db-gen's restore land second would silently wipe every row the sweep had just written.
#
#   INV          inventory.json (default ~/.estate/state/inventory.json, same as db-gen)
#   CATALOG      rendered catalog-info.yaml (default catalog/catalog-info.yaml in this checkout)
#   STATE_MD     crew/STATE.md (default $ESTATE_CODE/crew/STATE.md, the sibling checkout)
#   SU           sqlite-utils (default this checkout's venv; CI passes the one on PATH)
#   ESTATE_DB_ARTIFACT  where it goes (default oci://ghcr.io/chidionyema/idp/estate-db:latest)
#   --dry-run    build the artifact directory and list it; push nothing (LAW 17: measure first)
#   --self-test  prove this script runs, bounded, no network (LAW 45; bin/idp-script-compiles)
set -euo pipefail

# --help/--self-test are handled before set -u sees $1 and before anything below touches the
# network: an unrecognised flag falling through into the real push path is how a probe (the
# script-compiles gate ran `--help`) ends up executing a live `flux push artifact` and hanging
# past the gate's 60s ceiling instead of exiting 0 -- measured 2026-09-14, the push this fix
# itself needed refused on exactly that.
case "${1:-}" in
  --help|-h)
    cat <<'USAGE'
usage: idp-estate-db-push [--dry-run|--self-test]

Push catalog/estate.db (declared assets from db-gen, plus the estate twin's
runtime/code/domain graph), catalog-info.yaml and crew/STATE.md to the
estate-db OCI artifact estate-mcp pulls from.

options:
  --dry-run     build the artifact directory and list it; push nothing
  --self-test   prove this script runs: checks its tools, touches no network
  --help, -h    this message
USAGE
    exit 0
    ;;
  --self-test)
    for t in flux git jq sqlite3; do command -v "$t" >/dev/null || { echo "BLIND $t missing"; exit 1; }; done
    bash -n "$0"
    echo "ok idp-estate-db-push self-test"
    exit 0
    ;;
esac

IDP="$(cd "$(dirname "$0")/.." && pwd)"
INV="${INV:-$HOME/.estate/state/inventory.json}"
CATALOG="${CATALOG:-$IDP/catalog/catalog-info.yaml}"
STATE_MD="${STATE_MD:-${ESTATE_CODE:-$(dirname "$IDP")}/crew/STATE.md}"
ARTIFACT="${ESTATE_DB_ARTIFACT:-oci://ghcr.io/chidionyema/idp/estate-db:latest}"
dry=0; [ "${1:-}" = --dry-run ] && dry=1

for t in flux git jq sqlite3; do command -v "$t" >/dev/null || { echo "BLIND $t missing"; exit 2; }; done
for f in "$INV" "$CATALOG" "$STATE_MD"; do [ -s "$f" ] || { echo "BLIND $f missing or empty"; exit 2; }; done

T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
INV="$INV" DB="$T/estate.db" "$IDP/bin/db-gen" >/dev/null

# The graph, into the SAME file, AFTER db-gen (see the ordering note above). A cluster read
# that fails here -- no receipt, no cloud session, a rate limit -- must not cost the founder
# the asset half he already has: this reports BLIND and ships the assets rather than aborting
# the whole push (bin/idp-drift-blind's convention: a reader that could not read says so, it
# never reports a clean bill by exiting 0 with nothing written, and it never takes down a
# publish that has real work to ship alongside it).
if ESTATE_DB="$T/estate.db" "$IDP/bin/estate-twin-runtime" --once --code --domains; then
  :
else
  echo "BLIND estate-twin-runtime: could not sweep runtime/code/domains; shipping estate-db with the declared half only" >&2
fi
graph_rows=$(sqlite3 "$T/estate.db" "select count(*) from nodes" 2>/dev/null) || graph_rows=0
if [ "${graph_rows:-0}" -eq 0 ] 2>/dev/null; then
  echo "BLIND estate-twin-runtime: 0 graph rows in $T/estate.db; get_estate_state will answer empty from this artifact" >&2
fi

cp "$CATALOG" "$T/catalog-info.yaml"
cp "$STATE_MD" "$T/STATE.md"
rows=$(jq '.rows | length' "$INV")
REV="$(git -C "$IDP" rev-parse --short HEAD)@$(date -u +%Y%m%dT%H%M%SZ)"
if [ "$dry" = 1 ]; then
  echo "dry-run estate-db: $rows assets, $graph_rows graph node(s), would push $ARTIFACT revision $REV"
  ls -l "$T"; exit 0
fi
gh auth token >/dev/null 2>&1 || { echo "BLIND gh holds no token"; exit 2; }
gh auth token | flux push artifact "$ARTIFACT" --path="$T" \
  --source="https://github.com/chidionyema/idp" --revision="$REV" --creds "chidionyema:$(cat)" >/dev/null
echo "ok      estate-db pushed ($rows assets, $graph_rows graph node(s)), revision $REV"
