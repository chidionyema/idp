#!/usr/bin/env bash
# build-image: the one way an estate image gets built (ruling R24).
#
#   bin/build-image --push -t ghcr.io/OWNER/NAME:TAG [-f Dockerfile] CONTEXT
#   bin/build-image --load -t NAME:TAG            [-f Dockerfile] CONTEXT
#
# --push builds linux/amd64 AND linux/arm64 and pushes one manifest list. A
# `--platform` naming anything else is refused: that is the single-arch push
# R24 forbids. --load builds for the machine you are on only, because the docker
# driver cannot load a manifest list into a local daemon (buildx limitation);
# it never pushes, so nothing single-arch can leave the machine through here.
#
# THE ADMISSION GATE (founder, 2026-10-31). Before a byte is built, the image is
# admitted or refused by platform/estate/libexec/rust-only-admission.py: the k3s spine
# is Rust-only, and an image that carries Python is refused with
#
#   ADMISSION DENIED: Services targeting the k3s spine must be written in Rust.
#
# The gate reads the legacy allowlist of the repository the context belongs to
# (policy/rust-only-allowlist.json), so an image that was already Python before the
# ruling keeps building while a NEW python service never can. One rule engine, one
# verdict, and the exit code is the verdict.
set -euo pipefail
PLATFORMS="linux/amd64,linux/arm64"
mode=""; args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --push) mode=push ;;
    --load) mode=load ;;
    --platform|--platform=*)
      v="${1#--platform=}"; [ "$v" = "$1" ] && { shift; v="$1"; }
      if [ "$mode" != load ] && [ "$(tr ',' '\n' <<<"$v" | sort | paste -sd, -)" != "$PLATFORMS" ]; then
        echo "build-image: refused: --platform $v is not $PLATFORMS (R24: one tag, two architectures)" >&2; exit 2
      fi ;;
    *) args+=("$1") ;;
  esac; shift
done
[ -n "$mode" ] || { echo "build-image: choose --push (multi-arch to a registry) or --load (native only, local)" >&2; exit 2; }

# The context is the last positional argument; -f/-t are read for the gate.
dockerfile=""; tag=""; context=""; prev=""
for a in ${args[@]+"${args[@]}"}; do
  case "$a" in
    -f|--file) prev="file"; continue ;;
    -t|--tag)  prev="tag";  continue ;;
    --file=*)  dockerfile="${a#--file=}"; prev=""; continue ;;
    --tag=*)   tag="${a#--tag=}";       prev=""; continue ;;
    -*)        prev=""; continue ;;
  esac
  if [ "$prev" = "file" ]; then dockerfile="$a"; prev=""; continue; fi
  if [ "$prev" = "tag" ];  then tag="$a";       prev=""; continue; fi
  context="$a"
done
[ -n "$context" ] || { echo "build-image: no build context given" >&2; exit 2; }

here="$(cd "$(dirname "$0")/.." && pwd)"   # the repository root: this script lives in bin/
gate="$here/platform/estate/libexec/rust-only-admission.py"
if [ -f "$gate" ]; then
  repo_root="$(git -C "$context" rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -z "$repo_root" ]; then repo_root="$here"; fi
  gate_args=(--repo-root "$repo_root" --context "$context")
  if [ -n "$dockerfile" ]; then gate_args+=(--dockerfile "$dockerfile"); fi
  if [ -n "$tag" ]; then gate_args+=(--image "$tag"); fi
  python3 "$gate" "${gate_args[@]}" || exit $?
fi

if [ "$mode" = push ]; then
  exec docker buildx build --platform "$PLATFORMS" --push "${args[@]}"
else
  exec docker buildx build --load "${args[@]}"
fi
