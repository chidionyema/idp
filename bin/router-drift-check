#!/usr/bin/env python3
"""Router config drift check (migration P1.T2, spec §1.4/§3).

The estate runs two litellm renderers of one routing policy -- the laptop slot and the
cluster deployment. When they drift, callers get different lanes on different days and
the spend is double-tracked ("two routers, two bills", Delegated Estate K4). This check
compares the SEMANTIC routing surface of the two configs -- the lane inventory and each
lane's wiring -- and fails on divergence that callers can see.

Not a byte diff: the cluster config legitimately carries callbacks, embeddings pools and
deployment-uid blocks the laptop does not, and the laptop carries local-only lanes
(ollama). Divergence is reported per lane; ALLOWED_* sets record the documented
exceptions so a green check means something.

Usage:
  router-drift-check                     # laptop config vs live cluster (default context)
  router-drift-check --laptop PATH --cluster PATH   # explicit files (tests, CI)
Exit 0 = within policy, 1 = drift, 2 = could not measure.

The cluster's ConfigMap name is read from the LIVE Deployment, never hardcoded: Flux
suffixes it on every render, so a hardcoded name is stale within hours and the check then
exits 2 on a healthy cluster (measured 2026-10-25: the pinned name no longer existed while
the router served traffic fine).

Every line this prints that starts with DRIFT is counted in the verdict, and every counted
drift prints a DRIFT line: a printed DRIFT that the verdict does not count is a lie the
reader cannot detect (2026-10-25: "DRIFT wiring differs on vision" was printed while the
check exited 0, because a sphere-bound difference is allowed by policy).

No ConfigMap name is written down anywhere in this file: a name that reaches this script as
text is stale within hours.
"""

import argparse
import json
import pathlib
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.exit("PyYAML required (pip install pyyaml)")

DEFAULT_LAPTOP = pathlib.Path.home() / ".estate/litellm-local/config.yaml"
DEFAULT_CONTEXT = "context-estate-crq7jwxsjxq"
DEFAULT_DEPLOYMENT = "litellm"
DEFAULT_CONFIG_VOLUME = "config"

# Documented exceptions (plan §1.4, P1.T2): never count these as drift.
# Founder, 2026-10-25: cluster names win. Laptop-local lanes keep the ollama- prefix;
# sphere-bound wiring (ollama via host.docker.internal vs in-cluster svc) is fulfillment
# detail, not drift -- only the NAME inventory must converge.
ALLOWED_LAPTOP_ONLY = {"ollama-"}             # laptop fallback lanes (prefix), never on cluster
SPHERE_LOCAL_MARKERS = ("host.docker.internal", "localhost", "127.0.0.1", ".svc.cluster.local", "ollama")
ALLOWED_CLUSTER_ONLY = {"embed", "embed-cohere", "embed-query", "rerank", "image"}

# Fields that define a lane's caller-visible behavior.
LANE_FIELDS = ("model", "api_base")


def kubectl(args, timeout=120):
    return subprocess.run(
        ["kubectl", *args], capture_output=True, text=True, timeout=timeout
    )


def resolve_cluster_cm(context, namespace, deployment, volume):
    """The ConfigMap the live Deployment mounts, or (None, why).

    Flux renames it on every render (kustomize name suffix), so the name is a property of
    the running Deployment, not a constant. A stale constant makes this check exit 2 on a
    healthy cluster, which is the same signal as "the cluster is broken" -- so it is never
    written down.
    """
    r = kubectl(
        ["--context", context, "-n", namespace, "get", "deploy", deployment, "-o", "json"]
    )
    if r.returncode != 0:
        return None, (
            f"cannot read deployment {namespace}/{deployment}: {r.stderr.strip()[:200]}"
        )
    try:
        dep = json.loads(r.stdout)
    except ValueError:
        return None, f"deployment {namespace}/{deployment} did not return JSON"
    volumes = (
        (dep.get("spec") or {}).get("template", {}).get("spec", {}).get("volumes") or []
    )
    picked = None
    for v in volumes:
        if v.get("name") == volume and (v.get("configMap") or {}).get("name"):
            picked = v["configMap"]["name"]
            break
    if picked is None:
        others = [
            v["configMap"]["name"]
            for v in volumes
            if (v.get("configMap") or {}).get("name")
        ]
        picked = others[0] if others else None
    if not picked:
        return None, f"deployment {namespace}/{deployment} mounts no ConfigMap"
    return picked, None


def lane_map(cfg):
    """{model_name: {field: value}} for every entry in model_list."""
    out = {}
    for entry in cfg.get("model_list") or []:
        name = entry.get("model_name")
        params = entry.get("litellm_params") or {}
        if not name:
            continue
        rec = {f: params.get(f) for f in LANE_FIELDS if params.get(f) is not None}
        out.setdefault(str(name), []).append(rec)
    return out


def show_diff(a, b):
    only_a = sorted(set(a) - set(b))
    only_b = sorted(set(b) - set(a))
    changed = sorted(
        n for n in set(a) & set(b)
        if json.dumps(a[n], sort_keys=True) != json.dumps(b[n], sort_keys=True)
    )
    return only_a, only_b, changed


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--laptop", default=str(DEFAULT_LAPTOP))
    ap.add_argument("--cluster", default=None, help="path to cluster config.yaml (else kubectl)")
    ap.add_argument("--context", default=DEFAULT_CONTEXT)
    ap.add_argument("--namespace", default="llm")
    ap.add_argument("--deployment", default=DEFAULT_DEPLOYMENT)
    ap.add_argument("--config-volume", default=DEFAULT_CONFIG_VOLUME)
    args = ap.parse_args()

    try:
        laptop_cfg = yaml.safe_load(pathlib.Path(args.laptop).read_text())
    except OSError as e:
        print(f"FAIL cannot read laptop config {args.laptop}: {e}")
        return 2
    cluster_cm = None
    if args.cluster:
        cluster_cfg = yaml.safe_load(pathlib.Path(args.cluster).read_text())
    else:
        cluster_cm, why = resolve_cluster_cm(
            args.context, args.namespace, args.deployment, args.config_volume
        )
        if cluster_cm is None:
            print(f"FAIL {why}")
            return 2
        r = kubectl(
            ["--context", args.context, "-n", args.namespace, "get", "cm", cluster_cm,
             "-o", "jsonpath={.data.config\\.yaml}"]
        )
        if r.returncode != 0 or not r.stdout.strip():
            print(
                f"FAIL cannot read cluster config from ConfigMap {cluster_cm}: "
                f"{r.stderr.strip()[:200]}"
            )
            return 2
        cluster_cfg = yaml.safe_load(r.stdout)

    lap, clu = lane_map(laptop_cfg), lane_map(cluster_cfg)
    only_lap, only_clu, changed = show_diff(lap, clu)

    unexpected_lap = [n for n in only_lap if not any(n.startswith(p) for p in ALLOWED_LAPTOP_ONLY)]

    def sphere_bound(recs):
        return any(any(m in str(r.get("api_base", "")) for m in SPHERE_LOCAL_MARKERS) for r in recs)
    unexpected_clu = [n for n in only_clu if n not in ALLOWED_CLUSTER_ONLY
                      and not any(n.startswith(p) for p in ALLOWED_CLUSTER_ONLY)]
    # Wildcard lanes (claude-*) compare by exact name; prefix rules cover families.

    # Hard drift needs BOTH sides cloud-wired: a difference on any sphere-local leg is
    # fulfillment detail (laptop ollama vs cluster svc vs vendor API -- founder ruling
    # 2026-10-25: names are the contract). Both-cloud rewiring is real drift.
    hard_changed = [n for n in changed if not sphere_bound(lap[n]) and not sphere_bound(clu[n])]

    # The verdict is computed BEFORE anything is printed, so the printed lines and the exit
    # code cannot disagree: a DRIFT line means a counted drift, and every counted drift
    # prints a DRIFT line.
    for n in unexpected_lap:
        print(f"DRIFT laptop-only lane: {n}")
    for n in unexpected_clu:
        print(f"DRIFT cluster-only lane: {n}")
    for n in hard_changed:
        print(f"DRIFT wiring differs on {n}:\n  laptop : {json.dumps(lap[n])}\n  cluster: {json.dumps(clu[n])}")
    for n in changed:
        if n not in hard_changed:
            print(
                f"note wiring differs on {n} (allowed: sphere-local fulfillment, "
                f"the names are the contract): laptop={json.dumps(lap[n])} "
                f"cluster={json.dumps(clu[n])}"
            )
    for n in sorted(n for n in only_lap if n not in unexpected_lap):
        print(f"note laptop-only (allowed): {n}")
    for n in sorted(n for n in only_clu if n not in unexpected_clu):
        print(f"note cluster-only (allowed): {n}")

    if unexpected_lap or unexpected_clu or hard_changed:
        print(f"FAIL router drift: {len(unexpected_lap)} laptop-only, {len(unexpected_clu)} cluster-only, {len(hard_changed)} rewired")
        return 1
    where = f" (cluster ConfigMap {cluster_cm})" if cluster_cm else ""
    print(f"OK lanes within policy: {len(lap)} laptop / {len(clu)} cluster{where}, no caller-visible drift")
    return 0


if __name__ == "__main__":
    sys.exit(main())
