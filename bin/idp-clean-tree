#!/usr/bin/env python3
"""idp-clean-tree: a gate's answer is only true for the tree it ran in.

Measured 2026-09-12, three times in one session, and every one was reported to the founder as a
defect in the estate when it was not:

  * `defs-load-by-path` reported BLIND -- it requires the `dagster` module, and the checkout the
    gate ran in had no `.venv`. The gate was fine; the tree was wrong.
  * `sleep-ban` reported 14 violations of LAW 14. That rule does not exist on main. Another
    session was midway through adding it, and the shared checkout held their uncommitted rule and
    their uncommitted gate together.
  * `rule-coverage` reported a stale ledger. The ledger on main is accurate; the checkout held
    another session's edit to it.

All three came from one mistake: running a gate in the shared primary checkout -- the ONE
# directory every session on this machine shares, and therefore the directory most likely to be
dirty at any moment.
At the time it was on another session's branch with a conflicted merge staged in it.

docs/policy/no-agent-works-in-the-main-checkout.md has been policy since 2026-09-07 and nothing
enforced it. This is the enforcement, and it is deliberately narrow: it refuses to GRADE from a
dirty shared checkout, not to work in one.

    idp-clean-tree                 # grade the checkout this runs in
    idp-clean-tree --path DIR      # grade another
    idp-clean-tree --explain       # what it checks, and why

Exit 0 clean, 1 dirty, 2 BLIND (not a git checkout, so nothing could be judged).
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path


# How the shared checkout is identified, and why not with `bin/idp-repo-root` alone.
#
# The first version of this file asked `bin/idp-repo-root <dir>` and compared the answer to <dir>.
# That tool maps a LINKED WORKTREE to its primary, but handed a standalone repository it returns
# that repository -- correctly, since "the primary checkout <dir> belongs to" is itself when the
# tree belongs to nothing. So every dirty scratch tree in /tmp compared equal to itself and was
# refused as the shared checkout. Measured 2026-09-13 against /tmp/proof-good: exit 1, on a
# throwaway repository the gate has no business judging. LAW 38 -- a guard that refuses correct
# work is an outage, and this one refused every ordinary dirty worktree.
#
# git answers it exactly. `--git-common-dir` is RELATIVE (`.git`) for a primary checkout and for
# any standalone repository, and an ABSOLUTE path into the primary for a linked worktree. So the
# shared checkout is the repository whose common dir sits beside an idp root AND is not a linked
# worktree of anything else -- and, decisively, is not simply this directory.
def _shared_checkout_root(here: Path) -> Path | None:
    """The primary checkout owning `here`, or None when `here` is not part of one.

    None means: a standalone repository, which is never the shared checkout and is never refused.
    """
    code, out = _git(here, "rev-parse", "--git-common-dir")
    if code != 0 or not out:
        return None
    common = Path(out)
    if not common.is_absolute():
        # A primary checkout or a standalone repository: relative `.git`. Only a repository that
        # carries this tree's own root is the shared checkout.
        return here.resolve()
    return common.parent.resolve()


def _is_shared(root: Path, here: Path) -> bool:
    """Whether `root` is the one checkout every session on this machine shares.

    The override exists for tests, which cannot create a second primary checkout on disk.
    """
    override = os.environ.get("IDP_PRIMARY_CHECKOUT")
    if override:
        return root.resolve() == Path(override).resolve()

    # The shared checkout is the one whose root is named by the estate's own marker files AND
    # which other worktrees claim as their primary. A standalone repository has neither.
    if not (root / "bin" / "idp-rules").exists():
        return False
    return _shared_checkout_root(here) == root.resolve()


# The codes git writes in the first two columns of `status --porcelain` for a file a merge could
# not reconcile. A tree carrying one is mid-merge: it is on nobody's branch yet, so any gate run
# over it is grading work that does not exist anywhere but this disk.
UNMERGED_CODES = ("UU", "AA", "DD", "AU", "UA", "DU", "UD")


def _git(cwd: Path, *args: str) -> tuple[int, str]:
    p = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    return p.returncode, (p.stdout or "").strip()


def find_root(start: Path) -> Path | None:
    """The checkout that holds `start`, walked upward. git is the authority, not a marker file."""
    code, out = _git(start, "rev-parse", "--show-toplevel")
    return Path(out) if code == 0 and out else None


def dirty_files(root: Path) -> list[str]:
    """Every path with a staged, unstaged or unmerged change, plus untracked files.

    `--porcelain` is used rather than `status --short` prose because the columns are fixed, and
    the unmerged codes (`UU`, `AA`, `DU`...) are what a conflicted merge leaves behind. A tree
    carrying one of those is mid-merge, and any gate run there is grading a tree that is on
    nobody's branch yet.
    """
    code, out = _git(root, "status", "--porcelain")
    if code != 0:
        return []
    files = []
    for line in out.splitlines():
        if not line.strip():
            continue
        # porcelain is two status columns, one space, then the path: "XY path". Slicing at 2
        # keeps the first character of the path; the measurement above caught that as "M  .txt".
        path = line[2:].strip()
        # scratch artefacts are not a tree state anyone grades: a venv, an agent dir, DS_Store
        if _ignorable(path):
            continue
        files.append(f"{line[:2]} {path}")
    return files


def _ignorable(path: str) -> bool:
    """Paths that are never a reason to distrust a gate's answer.

    A `.venv` or `.agent` is per-machine and gitignored in practice; `.DS_Store` is macOS noise.
    Kept as one list so the rule is visible rather than scattered through the loop above.

    Both the bare directory and anything under it match, because git prints the bare name for an
    empty or deleted directory -- measured 2026-09-13, when `D .venv` was counted as a change
    while `.venv/bin/python` was not, which is the same directory judged two ways.
    """
    noise = ("node_modules",)
    prefixes = (".venv", ".agent", "__pycache__", ".pytest_cache", ".aevum")
    if path in noise or path == ".DS_Store":
        return True
    return any(path == p or path.startswith(p + "/") for p in prefixes)


def unmerged(root: Path) -> list[str]:
    """Files a merge left unresolved. A tree in this state is on nobody's branch."""
    return [f for f in dirty_files(root) if f[:2] in UNMERGED_CODES]


def grade_state(state: dict, root: Path) -> tuple[int, str]:
    """Judge a tree state read elsewhere, so the fixtures can be JSON.

    `port-gate` grades an injected `inventory.json` for the same reason: the state this gate must
    judge cannot be a fixture in the tree, because git cannot commit a nested `.git` and a real
    conflicted merge cannot be checked in. The shape is the four facts the gate actually uses.
    """
    branch = state.get("branch") or "(detached)"
    files = [f for f in (state.get("files") or []) if not _ignorable(_path_of(f))]
    staged = [f for f in files if f[:2] in UNMERGED_CODES]
    return _verdict(root, branch, files, staged, bool(state.get("shared")))


def _path_of(entry: str) -> str:
    """The path out of a porcelain entry.

    git's `status --porcelain` is fixed-width: two status columns then one space, whatever the
    codes are. "XY path". An earlier version of this guessed at the split by looking at the codes
    and mis-read half the shapes -- ` D .venv` and `UU AGENTS.md` both came back with the status
    still attached, so a per-machine directory was counted as a change. Slice at two, always.
    """
    return entry[2:].strip()


def grade(path: Path) -> tuple[int, str]:
    """(exit code, message). 2 is BLIND: not a checkout, so nothing could be judged."""
    root = find_root(path)
    if root is None:
        return (
            2,
            f"BLIND  clean-tree  {path} is not in a git checkout; nothing could be graded",
        )

    branch = _git(root, "rev-parse", "--abbrev-ref", "HEAD")[1] or "(detached)"
    files = dirty_files(root)
    staged = [f for f in files if f[:2] in UNMERGED_CODES]
    shared = _is_shared(root, Path(path))
    return _verdict(root, branch, files, staged, shared)


def _verdict(
    root: Path, branch: str, files: list[str], staged: list[str], shared: bool
) -> tuple[int, str]:
    """The one place a verdict is decided, so the live path and the state path cannot disagree."""
    if staged:
        return (
            1,
            f"FAIL  clean-tree  {root} is mid-merge with {len(staged)} unmerged file(s) on "
            f"branch {branch}: {staged[0]}\n"
            f"      Any gate run here grades a tree that is on nobody's branch. Use a worktree "
            f"cut from origin/main.",
        )

    if shared and files:
        return (
            1,
            f"FAIL  clean-tree  {root} is the SHARED checkout on branch {branch} and carries "
            f"{len(files)} uncommitted change(s): {files[0]}\n"
            f"      Every session on this machine works in this directory, so a gate run here "
            f"reads another session's half-finished work as estate truth (measured 2026-09-12, "
            f"three times). Use a worktree cut from origin/main:\n"
            f"          git worktree add /tmp/wt-verify origin/main",
        )

    return (
        0,
        f"ok    clean-tree  {root} on {branch}, {len(files)} uncommitted change(s)",
    )


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument(
        "--path", default=".", help="the checkout to grade (default: this directory)"
    )
    ap.add_argument("--state", help="a JSON tree state to grade instead of reading git")
    ap.add_argument("--explain", action="store_true", help="what it checks, and why")
    args = ap.parse_args(sys.argv[1:] if argv is None else argv)

    if args.explain:
        print(__doc__)
        return 0

    if args.state:
        import json

        state = json.loads(Path(args.state).read_text())
        code, message = grade_state(state, Path(state.get("root") or args.path))
    else:
        code, message = grade(Path(args.path))
    print(message, file=sys.stderr if code else sys.stdout)
    return code


if __name__ == "__main__":
    sys.exit(main())
