#!/usr/bin/env python3
"""Estate inventory -> Backstage catalog entities.

A thin adapter, deliberately. It reads the inventory LAW 39 already produces and
writes catalog-info.yaml in the Backstage entity format -- an open, documented
schema that Backstage, Port and Roadie all ingest and that anything else can parse
as plain YAML. Nothing about the estate is stored HERE; this file only translates.

That is the whole point. The catalogue is the asset, the portal is a renderer, and
a renderer you can replace in one command is not a dependency. If Backstage is
wrong in a year, this adapter changes its output format and the estate does not.
"""
import json, os, re, subprocess, sys

# INV and OUT can be overridden so CI can run this against a fixture (bin/idp-ci).
INV = os.environ.get("INV") or os.path.expanduser("~/.estate/state/inventory.json")
OUT = os.environ.get("OUT") or os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "catalog")
OWNER = "group:default/platform"
SYSTEM = "system:default/estate"

# crew#612 CP2: the hierarchy the founder reads the estate through. Bytesync Ltd is the parent
# (a Group of type organization: Backstage has no level above Domain); each company is a
# Domain; each tracked repository is a product System inside its company; every asset's
# spec.system is the product of the repository that holds it. A repository is placed by its
# name only -- no path, host or account is typed here (LAW 46) -- and one that matches no
# company is the platform's, which is what a buyer's engineer would assume anyway.
ORG = ("bytesync", "Bytesync Ltd", "The parent company: every company, product and asset in this catalogue belongs to it.")
COMPANIES = {
    # 4th field: where the company is live, for a Domain page whose code is not in a tracked
    # checkout on this machine (mumchimp runs on OKE; its repos are not in the inventory).
    "mumchimp": ("Mumchimp", ("mumchimp", "medusa", "ecommerce", "ebookstore", "store"),
                 "The store: the storefront, its API and everything that takes a customer's money.",
                 ("The store, live", "https://${ESTATE_ZONE}")),  # substituted by _company_link()
    "prospector": ("Prospector", ("prospector",),
                   "The product that finds and qualifies prospects; stays the product whatever the platform does.",
                   ("Prospector on GitHub", "https://github.com/chidionyema/prospector")),
    "hermes-v2": ("Hermes", ("hermes",),
                  "The agent that acts for the founder from anywhere: Telegram in, a pull request or a run out.",
                  ("Hermes on GitHub", "https://github.com/chidionyema/hermes-v2")),
    "platform": ("Platform", (),
                 "The one platform every product runs on: catalogue, routing, traces, identity, secrets, scheduling, CI."),
}


def company_of(repo_name: str) -> str:
    n = (repo_name or "").lower()
    for key, (_title, needles, *_rest) in COMPANIES.items():
        if any(needle in n for needle in needles):
            return key
    return "platform"


def product_ref(repo_name: str) -> str:
    return f"system:default/product-{repo_name}"

# ENVIRONMENT. Founder, 2026-08-24: "backstge call this nachine production, this is dev not
# prod. ens dev, stage prod". Every Component this file emitted carried a literal
# `lifecycle: production`, so the portal told anyone who opened it that a laptop was the
# production estate. That is the worst class of catalog error: it is wrong, and it is wrong
# in the direction that makes someone comfortable.
#
# Resolution order, and none of it is a literal in this file (LAW 46):
#   1. $ESTATE_ENV
#   2. the first line of $ESTATE_ENV_FILE, else ~/.estate/env
#   3. "dev"
# The fallback is "dev" on purpose. If the environment cannot be established, the safe lie is
# the one that makes you careful, not the one that makes you relaxed.
VALID_ENVS = ("dev", "stage", "prod")
# Backstage's own vocabulary for spec.lifecycle is experimental | production | deprecated, so
# the estate env is mapped onto it rather than invented. The precise env stays readable on the
# entity as an annotation, which is what anything machine-driven should key off.
LIFECYCLE_FOR = {"dev": "experimental", "stage": "experimental", "prod": "production"}


def resolve_env() -> str:
    e = (os.environ.get("ESTATE_ENV") or "").strip().lower()
    if not e:
        f = os.environ.get("ESTATE_ENV_FILE") or os.path.expanduser("~/.estate/env")
        try:
            e = open(f).readline().strip().lower()
        except OSError:
            e = ""
    if not e:
        return "dev"
    if e not in VALID_ENVS:
        sys.exit(f"catalog-gen: ESTATE_ENV={e!r} is not one of {VALID_ENVS}. "
                 "Refusing to label the estate with an environment nobody defined.")
    return e


ENV = resolve_env()
LIFECYCLE = LIFECYCLE_FOR[ENV]

# Backstage names: ^[a-zA-Z0-9]([-_.a-zA-Z0-9]*[a-zA-Z0-9])?$, 63 chars max.
def slug(s: str) -> str:
    s = re.sub(r"[^a-zA-Z0-9._-]", "-", str(s)).strip("-._")
    s = re.sub(r"-{2,}", "-", s) or "unnamed"
    return s[:63].strip("-._")

def github_slug(remote):
    """owner/repo out of a git remote, or None when it is not github.com.

    This exact shape is what Backstage's github.com/project-slug annotation
    wants, and every GitHub-aware widget in the portal keys off it.
    https://backstage.io/docs/features/software-catalog/well-known-annotations
    """
    if not remote or remote == "(none)":
        return None
    m = re.match(r"^(?:https://github\.com/|git@github\.com:)([^/]+/[^/]+?)(?:\.git)?/?$",
                 str(remote))
    return m.group(1) if m else None

# kind of estate asset -> (Backstage kind, spec.type)
MAP = {
    "repo":          ("Component", "service"),
    "scheduled_job": ("Resource",  "scheduled-job"),
    "guard":         ("Resource",  "guard"),
    "ledger":        ("Resource",  "ledger"),
    "data":          ("Resource",  "data-store"),
    "drill":         ("Resource",  "drill"),
    "container":     ("Resource",  "container"),
    "listener":      ("Resource",  "port"),
}


# Founder, 2026-08-29 ("assume an investor and buyer is coming to view our backstage"): the
# served catalogue read like one laptop. 527 lines carried a home directory, 8 titles were
# launchd reverse-DNS labels, and Adobe's own background job was listed as an estate asset.
# Three rules, applied where every entity is written so no row can miss them:
#   1. a path under a user's home is written as ~/..., never the account name (LAW 46);
#   2. a scheduled job whose program lives under the OS's own trees is vendor software on
#      the machine, not an estate asset, and is not written;
#   3. a reverse-DNS id (ai.aiden.watch) is a label, not a title: the title is the words,
#      the label stays on the entity as estate/label.
HOME_RE = re.compile(r"^/(?:Users|home)/[^/\s]+(?=/|$)")
VENDOR_TREES = ("/Applications/", "/System/", "/Library/", "/usr/libexec/")
LABEL_RE = re.compile(r"^[a-z][a-z0-9-]*(\.[a-z0-9-]+){2,}$")


def unhomed(s):
    """Every absolute path under a home directory, anywhere in the string, becomes ~/..."""
    return re.sub(r"/(?:Users|home)/[^/\s]+(?=/|\b)", "~", str(s)) if s is not None else s


def vendor_software(r) -> bool:
    return r.get("kind") == "scheduled_job" and str(r.get("path") or "").startswith(VENDOR_TREES)


# Founder, 2026-09 ("claude directives are polluting the catalogue and are mostly noise; they
# should have a lesser section away from the rest"). The estate inventory holds 303 ledger
# rows; 293 live under ~/.claude, and the generated catalogue shipped 196 Resource-ledgers,
# 188 of them under system:default/product-claude - which became the largest "product" system
# in the catalogue (240 members), ahead of real products. Measured over the live inventory:
# the mass is NOT the estate's canonical op-state boards (hook-outcomes, ledger, goal-net,
# founder-actions, drills, ESTATE_BOARD, DECISIONS, ...) but per-session and per-worktree
# scratch - a per-project directives/*.jsonl, per-session state/prompt-ledger/<uuid>, .claude/
# jobs/*/timeline.jsonl, and shadow copies under .claude/scripts/.wt-*/ and worktrees/. These
# are ephemeral agent logs, not estate surfaces. They must render in a clearly secondary
# place, apart from real products, and remain recoverable (never deleted). Durable canonical
# op boards keep their current place.
ESTATE_INTERNALS_SYSTEM = "system:default/estate-internals"
# Durable .claude op-state boards the live estate reads (openReds reads hook-outcomes; the
# loop reads goal-net; guards/drills read their state) never count as noise. Only the
# canonical board - ~/.claude/<name>.jsonl or ~/.claude/state/<name>.jsonl - is that board;
# a shadow copy under a worktree is still per-worktree churn and counts as noise.
_DURABLE_STATE = {"hook-outcomes", "ledger", "goal-net", "founder-actions", "drills",
                   "ESTATE_BOARD", "DECISIONS", "estate-spend-history", "history",
                   "tickets", "close-guard-observe", "estate-push", "estate-bundle-push",
                   "board-deadletter", "aiden-ticks", "pi-bridge-runs", "ci-reach",
                   "toolguard", "stuck-detector", "consult", "would-have-fired"}


def is_ephemeral_ledger(r) -> bool:
    """True for a .claude ledger that is per-session/per-worktree scratch - the noise a catalogue
    buyer should not scroll past. False for an estate record and for a durable canonical op board.

    A ledger path under ~/.claude is ephemeral unless it is a canonical op board: a known
    durable board's own file sitting directly at ~/.claude/<name>.jsonl, ~/.claude/state/<name>.jsonl,
    or as the directoried canonical under ~/.claude/state/logs|toolguard|agent-cert. Everything
    else under ~/.claude - directives/*, prompt-ledger/*, jobs/*, a .wt-* or worktrees/ shadow
    copy, and any nested scratch - is per-session/per-worktree and counts as noise. A ledger
    anywhere else (estate repo, .estate/** record, launchd) is never agent scratch.
    """
    i = r.get("id") or ""
    p = (r.get("path") or "").replace("\\", "/") or i
    if ".claude" not in i and ".claude" not in (r.get("path") or ""):
        return False                      # estate repo / .estate record: keep in place
    # Reject any visible per-session / per-worktree shape first.
    if "/.wt-" in p or p.startswith(".claude/.wt-") or ".wt-" in i:
        return True                       # .wt-* shadow duplicate of a board
    if "worktrees/" in p or "/one-branch/" in p:
        return True                       # nested-worktree copies
    for m in ("scratchpad", "private-tmp", "/T-", "slot-", "claude-runner", "-runner-repo"):
        if m in p:
            return True                   # claude session scratch
    # Deterministic canonical op-board parents under ~/.claude:
    rel = p[p.index(".claude/") + len(".claude/") :] if ".claude/" in p else p
    base = rel.rsplit("/", 1)[-1].replace(".jsonl", "") if rel.endswith(".jsonl") else rel.rsplit("/", 1)[-1]
    ok_parent = (
        ("/" not in rel)                                          # ~/.claude/<board>.jsonl
        or rel.startswith("state/logs/") or rel.startswith("state/toolguard/")
        or rel.startswith("agent-cert/") or rel == "state/" + base + ".jsonl" or rel == "state/" + base
        or rel == "state/tickets"
    )
    if base in _DURABLE_STATE and ok_parent:
        return False                      # the canonical op board, honest record
    # Per-project per-session dirs and anything else nested under ~/.claude is noise.
    return True


def human_title(r, fallback):
    rid = str(r.get("id") or fallback)
    if not LABEL_RE.match(rid):
        return rid
    parts = rid.split(".")
    if parts[0] in ("ai", "com", "org", "io", "net"):
        parts = parts[1:]
    words = " ".join(w.replace("-", " ") for w in parts)
    return words[:1].upper() + words[1:]


def y(v):
    """YAML scalar, quoted when it could be misread.

    Numbers are quoted too. Backstage's entity envelope requires every
    annotation value to be a string, and an unquoted 12.4 or 3 parses as a
    number, so the entity is rejected with "Malformed envelope, ... must be
    string". Measured 2026-08-24: 141 of 194 entities lost this way, and the
    catalogue still rendered, which is why it looked fine.
    """
    s = str(v)
    if s == "" or re.search(r"[:#\-{}\[\]&*?|>%@`'\"\n]", s) or s.lower() in (
            "true", "false", "null", "yes", "no", "on", "off") \
            or re.fullmatch(r"[+-]?(\d[\d_]*)(\.\d*)?([eE][+-]?\d+)?", s) \
            or re.fullmatch(r"0[xXoObB][0-9a-fA-F_]+", s):
        return "'" + s.replace("'", "''") + "'"
    return s

HIER_LINKS = []  # every Domain/System/Group link, so the interfaces card carries them too


def links_yaml(links):
    """metadata.links lines for the literal Domain/System/Group docs (crew#612 CP2: every
    entity carries a link a person can open). Empty when there is nothing openable: a
    link that 404s is the crew#503 'no broken link' defect, so none beats a guess."""
    out = []
    if links:
        out.append("  links:")
        for t, u in links:
            out += [f"    - title: {y(t)}", f"      url: {y(u)}"]
            HIER_LINKS.append((t, u))
    return out


def entity(kind, name, title, etype, annotations, tags, links=(), depends_on=(),
           system=None, description=""):
    # Founder, 2026-08-27: "cant have components that cannt self describe". An entity
    # without a description is refused here, not tagged, so the catalogue cannot be
    # written with one. Measured before this change: 349 of 362 entities had none.
    if not str(description).strip():
        sys.exit(f"catalog-gen: {kind} {name} has no description; refusing to publish an asset that cannot describe itself")
    out = [
        "apiVersion: backstage.io/v1alpha1",
        f"kind: {kind}",
        "metadata:",
        f"  name: {y(name)}",
        f"  title: {y(title)}",
        f"  description: {y(unhomed(str(description).strip()))}",
    ]
    if annotations:
        out.append("  annotations:")
        # A key with a slash is already namespaced -- backstage.io/techdocs-ref is
        # read by the TechDocs plugin and must not be rewritten. Everything else is
        # ours and gets the estate/ prefix so it cannot collide with Backstage's.
        for k, v in sorted(annotations.items()):
            if v in (None, ""):
                continue
            out.append(f"    {k if '/' in k else 'estate/' + k}: {y(unhomed(v))}")
    if tags:
        out.append("  tags:")
        out += [f"    - {y(slug(t).lower())}" for t in tags if t]
    if links:
        out.append("  links:")
        for t, u in links:
            out += [f"    - title: {y(t)}", f"      url: {y(u)}"]
    out += ["spec:", f"  type: {etype}", f"  owner: {OWNER}",
            f"  system: {system or SYSTEM}"]
    if kind == "Component":
        out.append(f"  lifecycle: {LIFECYCLE}")
    # sorted() and not the discovery order. Founder, 2026-08-24: "we need to take
    # idempotency serious across platform". bin/idp-ci runs this twice over one
    # inventory and fails on a single byte of difference.
    if depends_on:
        out.append("  dependsOn:")
        out += [f"    - {r}" for r in sorted(set(depends_on))]
    return "\n".join(out)



# --- crew#269 row 2: every URL the estate publishes is a link in the catalogue --------------
# Founder, 2026-08-25: "how do i know what the backstage url is". The answer is never a port or
# a chat message: each HTTPRoute under platform/** becomes a Component whose `Open` link is its
# hostname on the estate zone. The zone is the one value in clusters/*/estate-config.yaml
# (idp#140); a hostname that cannot be resolved to a real URL refuses the run, so the catalogue
# never shows a link a person cannot click.
IDP_ROOT = os.environ.get("CATALOG_GEN_ROOT") or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ZONE_KEY = re.compile(r"^\s*ESTATE_ZONE:\s*['\"]?([A-Za-z0-9.-]+)['\"]?\s*$", re.M)


def _docline(path):
    """First sentence of the file's own docstring or leading comment, or ''. The asset
    describes itself; this generator only repeats it."""
    try:
        if not path or not os.path.isfile(path) or os.path.getsize(path) > 2_000_000:
            return ""
        with open(path, errors="replace") as fh:
            head = fh.read(4000)
    except OSError:
        return ""
    m = re.search(r'^\s*[ru]?("""|\'\'\')(.*?)(\1|$)', head, re.S | re.M)
    text = m.group(2) if m else ""
    if not text:
        # crew#612 CP7: only a shebang is skipped. Skipping line 1 of every file dropped the
        # opening line of each YAML comment block, so a Helm chart read "Kubernetes Secrets."
        raw = head.splitlines()
        if raw and raw[0].startswith("#!"):
            raw = raw[1:]
        lines = [l for l in raw[:11] if l.strip()]
        cm = [l.lstrip("# ").strip() for l in lines if l.lstrip().startswith("#")]
        text = " ".join(cm) if cm and len(cm) == len(lines[:len(cm)]) else ""
    text = " ".join(text.split())
    if not text:
        return ""
    parts = re.split(r"(?<=[.!?])\s", text, 2)
    sent = parts[0]
    # crew#612 CP7: "Edge row." or "ADR 0005." is a label, not a sentence; carry the next one too.
    if len(sent.split()) < 3 and len(parts) > 1:
        sent = f"{sent} {parts[1]}"
    return sent[:240]


def describe(r):
    """What this asset is, in one sentence a buyer's engineer can read on the card.
    The asset's own words win (a `what`/`note` field, then the file's docstring);
    when it has none, the sentence is built from fields the inventory measured,
    never invented. Kinds without a row-level sentence are the bug, not a fallback."""
    k = r.get("kind")
    own = (r.get("what") or r.get("note") or "").strip()
    # crew#612 CP7 (founder: "it's too cryptic"): a `what` under five words is a label the
    # inventory writer left ("database", "the board of record"), not a sentence; it becomes a
    # hint on the measured sentence instead of standing in for one.
    hint = own if len(own.split()) < 5 else ""
    own = "" if hint else own
    doc = _docline(r.get("path"))
    if k == "repo":
        return own or doc or f"Git checkout at {r.get('path')} on branch {r.get('branch') or '?'}, {r.get('tracked_files') or 0} tracked files."
    if k == "scheduled_job":
        every = f" every {r['interval_s']} s" if r.get("interval_s") else ""
        return doc or own or f"launchd job{every} running {r.get('path')}; last status {r.get('last_status') or 'unknown'}."
    if k == "guard":
        return doc or own or f"Hook guard at {r.get('path')}" + (f" (symlink to {r['symlink_to']})" if r.get("symlink_to") else "") + "."
    if k == "listener":
        return own or f"Port {r.get('port')} bound on {r.get('bind')} by {r.get('owner') or r.get('process')} ({r.get('command') or r.get('path')})."[:240]
    if k == "drill":
        return own or doc or f"Recovery drill graded {r.get('last_status') or 'NEVER RUN'}, must run every {r.get('max_age_days')} days."
    if k == "container":
        return own or f"Container {r.get('service') or r.get('id')} from image {r.get('image')} in compose project {r.get('project')}, health {r.get('health') or 'unknown'}."
    if k == "ledger":
        return own or (f"Append-only ledger at {r.get('path')}, {r.get('rows') or 0} rows, "
                       + ("read by something in the estate" if r.get("referenced") else "referenced by nothing")
                       + (f"; {hint}." if hint else "."))
    if k == "data":
        what = "Database file" if (hint == "database" or str(r.get("path", "")).endswith((".db", ".sqlite", ".sqlite3"))) else "Data"
        return own or (f"{what} at {r.get('path')}, {r.get('mb') or 0} MB, "
                       + ("read by something in the estate" if r.get("referenced") else "referenced by nothing")
                       + (f"; {hint}." if hint and hint != "database" else "."))
    return own or doc or (f"{hint}." if hint else "")


def estate_zone() -> str:
    """The one value in clusters/*/estate-config.yaml (crew#269, crew#796); a company home link
    written as https://${ESTATE_ZONE} is substituted here, never spelled out in this file."""
    import glob as _glob
    zs = set()
    for f in sorted(_glob.glob(os.path.join(IDP_ROOT, "clusters", "*", "estate-config.yaml"))):
        zs.update(ZONE_KEY.findall(open(f).read()))
    return sorted(zs)[0] if zs else "estate-zone-not-declared.invalid"


def front_door_entities():
    import glob as _glob
    import yaml
    zones = set()
    for f in sorted(_glob.glob(os.path.join(IDP_ROOT, "clusters", "*", "estate-config.yaml"))):
        zones.update(ZONE_KEY.findall(open(f).read()))
    routes = []
    for f in sorted(_glob.glob(os.path.join(IDP_ROOT, "platform", "**", "*.yaml"), recursive=True)):
        for d in yaml.safe_load_all(open(f)):
            if d and d.get("kind") == "HTTPRoute":
                rel = os.path.relpath(f, IDP_ROOT)
                for h in d["spec"].get("hostnames", []):
                    routes.append((rel, d["metadata"]["name"], d["metadata"].get("namespace", ""), h))
    if routes and len(zones) != 1:
        sys.exit(f"catalog-gen: {len(routes)} HTTPRoute hostnames but {len(zones)} zone(s) in "
                 f"clusters/*/estate-config.yaml; refusing to publish links nobody can open")
    docs = []
    for rel, name, ns, host in sorted(routes, key=lambda r: r[3]):
        url_host = host.replace("${ESTATE_ZONE}", next(iter(zones)))
        if "${" in url_host:
            sys.exit(f"catalog-gen: {rel}: hostname {host} carries a variable this generator cannot substitute")
        docs.append(entity("Component", f"front-door-{slug(name)}", url_host, "website",
                           {"hostname": url_host, "namespace": ns, "route": rel},
                           ["front-door"], [("Open", f"https://{url_host}")],
                           description=f"Public front door https://{url_host}, served by HTTPRoute {name} in namespace {ns} ({rel})."))
    return docs


# --- crew#401 CP2/CP5: the founder's surfaces, with the zone resolved and a health stamp --------
# backstage/founder/catalog-info.yaml is the hand-written list of places the founder looks (the
# gate in tests/ refuses a hostname or a workflow button that is not on it). It is not loaded by
# the portal directly: Backstage does not expand `${ESTATE_ZONE}` inside an entity file, so the
# first roll (idp#276, 2026-08-27) would have shown links nobody could open. This generator is
# the only path from that file to the portal: it substitutes the zone the same way front doors
# get theirs, and with CATALOG_GEN_PROBE=1 (set by bin/catalog-render, never in CI, so the
# idempotency check in bin/idp-ci stays byte-identical) it stamps each card with what an HTTP
# request to its first link answered, and when. Health from the founder's own point of view:
# the same request his browser would make.
FOUNDER_FILE = os.path.join(IDP_ROOT, "backstage", "founder", "catalog-info.yaml")


def _probe(url: str) -> str:
    import urllib.request
    import urllib.error
    req = urllib.request.Request(url, method="GET", headers={"User-Agent": "idp-catalog-gen"})
    try:
        with urllib.request.urlopen(req, timeout=8) as r:
            return f"ok {r.status}"
    except urllib.error.HTTPError as e:
        # A login wall answers 401/403 from a living server; anything under 500 is alive.
        return f"ok {e.code}" if e.code < 500 else f"FAIL {e.code}"
    except Exception as e:  # noqa: BLE001 - the verdict is the point, whatever the cause
        return f"FAIL {type(e).__name__}"[:80]


def founder_surface_entities():
    import glob as _glob
    import yaml
    from datetime import datetime, timezone
    if not os.path.exists(FOUNDER_FILE):
        return []
    zones = set()
    for f in sorted(_glob.glob(os.path.join(IDP_ROOT, "clusters", "*", "estate-config.yaml"))):
        zones.update(ZONE_KEY.findall(open(f).read()))
    if len(zones) != 1:
        sys.exit(f"catalog-gen: founder surfaces need exactly one zone, found {len(zones)}")
    zone = next(iter(zones))
    probe = os.environ.get("CATALOG_GEN_PROBE") == "1"
    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    docs = []
    for d in yaml.safe_load_all(open(FOUNDER_FILE)):
        if not d:
            continue
        for link in d["metadata"].get("links", []):
            link["url"] = link["url"].replace("${ESTATE_ZONE}", zone)
            if "${" in link["url"]:
                sys.exit(f"catalog-gen: {d['metadata']['name']}: link {link['url']} carries a variable this generator cannot substitute")
        ann = d["metadata"].setdefault("annotations", {})
        if probe:
            ann["estate/health"] = _probe(d["metadata"]["links"][0]["url"])
            ann["estate/health-checked-at"] = now
            if ann["estate/health"].startswith("FAIL"):
                d["metadata"].setdefault("tags", []).append("unhealthy")
        docs.append(yaml.safe_dump(d, sort_keys=True, allow_unicode=True, width=1000).rstrip())
    return docs

def yaml_links(doc):
    """(title, url) pairs from an already-rendered entity document."""
    import yaml
    d = yaml.safe_load(doc)
    return [(f"{d['metadata']['name']}: {l.get('title') or 'Open'}", l["url"])
            for l in (d or {}).get("metadata", {}).get("links", [])]


# crew#624 (founder, 2026-08-29: "WHY IS HUBBLE NOT THERE ... IF WE CANT TRUST BACKSTAGE THEN WE
# MAY AS WELL NOT HAVE A COMPANY"). Until this function existed the catalogue was built from the
# Mac inventory alone: 30 Flux rows, 24 Helm charts and the CNI (Cilium + Hubble, a cluster
# choice and never a Flux row) ran on the cluster and not one had an entity. Measured 13:3xZ:
# `grep -c hubble catalog/catalog-info.yaml` = 0. The cluster is read from the checkout that
# Flux reconciles (clusters/*/*.yaml and platform/**), so the catalogue and the cluster cannot
# name different sets; tests/test_incident_crew624_every_cluster_row_is_in_the_catalogue.py
# refuses a checkout where they do.
CLUSTER_KINDS = ("Kustomization", "HelmRelease")

# Founder, 2026-08-29 19:0xZ: "i need all metrics exposed ... on backstage ... always ... numbers
# for everything we collect". Measured before this: 440 entities, 0 with a kubernetes annotation,
# so the Kubernetes tab the portal already shipped (crew#412) rendered nothing, and Prometheus had
# no tab at all. Every cluster entity now carries the well-known annotations the two plugins read
# (https://backstage.io/docs/features/kubernetes/configuration#common-backstageio-kubernetes-id-label
# and https://github.com/RoadieHQ/roadie-backstage-plugins/tree/main/plugins/frontend/backstage-plugin-prometheus),
# and the numbers come from platform/monitoring/rules/capacity.yaml recording rules, so a query
# here is a name, never a PromQL expression a comma could break. The generator refuses a cluster
# entity that lost them (tests/test_incident_crew645_every_cluster_entity_shows_its_numbers.py).
CAPACITY_RULES = (
    ("estate:pod_cpu_cores:rate5m", "pod"),
    ("estate:pod_cpu_peak_cores:30m", "pod"),
    ("estate:pod_cpu_request_cores", "pod"),
    ("estate:pod_memory_bytes", "pod"),
    ("estate:pod_memory_request_bytes", "pod"),
    ("estate:pod_restarts_total", "pod"),
)


def _row_namespace(kind, ns, src):
    """The namespace a Flux row's workloads run in: the object names it, or its directory's
    kustomization sets it, or a namespace.yaml sits in the path it reconciles."""
    if ns:
        return ns
    import glob as _glob
    import yaml
    # A HelmRelease with no namespace of its own takes the one its directory's kustomization sets.
    kz = os.path.join(src, "kustomization.yaml")
    if os.path.exists(kz):
        try:
            k = yaml.safe_load(open(kz)) or {}
            if isinstance(k, dict) and k.get("namespace"):
                return k["namespace"]
        except yaml.YAMLError:
            pass
    for f in sorted(_glob.glob(os.path.join(src, "namespace*.yaml")) + _glob.glob(os.path.join(src, "namespace", "**", "*.yaml"), recursive=True)):
        try:
            for d in yaml.safe_load_all(open(f)):
                if isinstance(d, dict) and d.get("kind") == "Namespace":
                    return (d.get("metadata") or {}).get("name", "")
        except yaml.YAMLError:
            continue
    return ""


def metrics_annotations(kind, name, ns, src):
    """The annotations that put live numbers on a cluster entity's page: which pods the
    Kubernetes tab reads (namespace + the label Helm and Flux stamp on what they render) and
    which recording rules and alerts the Prometheus tab graphs, scoped to the namespace."""
    wns = _row_namespace(kind, ns, src)
    if not wns:
        return {}
    selector = (f"app.kubernetes.io/instance={name}" if kind == "HelmRelease"
                else f"kustomize.toolkit.fluxcd.io/name={name}")
    rule = ",".join(f'{r}{{namespace="{wns}"}}|{dim}' for r, dim in CAPACITY_RULES)
    return {
        "backstage.io/kubernetes-namespace": wns,
        "backstage.io/kubernetes-label-selector": selector,
        "prometheus.io/rule": rule,
        "prometheus.io/alert": "all",
        "prometheus.io/labels": f"namespace={wns}",
    }


def _first_comment(path):
    """First sentence of the file's leading comment block; the asset describes itself."""
    return _docline(path)


def _idp_source_link(rel):
    """Source link for a file in this checkout, from the remote git already knows (LAW 46)."""
    try:
        remote = subprocess.run(["git", "-C", IDP_ROOT, "remote", "get-url", "origin"],
                                check=False, capture_output=True, text=True).stdout.strip()
    except OSError:
        remote = ""
    gh = github_slug(remote)
    if not gh:
        return []
    return [("Source", f"https://github.com/{gh}/blob/main/{rel}"),
            ("Cluster state", f"https://github.com/{gh}/actions/workflows/oke-check.yml")]


def registry_vendors():
    """Named vendor roots from platform/vendors/consoles.yaml (crew#751).

    Inventory `coupling` is the blast-radius field. The vendor registry is the
    list of third parties the estate actually holds a root for. A vendor in the
    registry with no inventory tag still belongs in the catalogue: otherwise
    Cursor (Hermes WORK) is invisible until some Mac path happens to be tagged.
    Missing file: inventory couplings only, same as before this function existed.
    """
    path = os.path.join(IDP_ROOT, "platform", "vendors", "consoles.yaml")
    if not os.path.isfile(path):
        return {}
    import yaml
    data = yaml.safe_load(open(path)) or {}
    return data.get("vendors") or {}


def cluster_entities():
    import glob as _glob
    import yaml
    docs, seen_dirs = [], set()
    rows = []  # (kind, name, namespace, relpath, path-in-repo, chart)
    files = sorted(_glob.glob(os.path.join(IDP_ROOT, "clusters", "*", "*.yaml"))) + \
        sorted(_glob.glob(os.path.join(IDP_ROOT, "platform", "**", "*.yaml"), recursive=True))
    for f in files:
        rel = os.path.relpath(f, IDP_ROOT)
        try:
            loaded = list(yaml.safe_load_all(open(f)))
        except yaml.YAMLError:
            continue
        for d in loaded:
            if not isinstance(d, dict) or d.get("kind") not in CLUSTER_KINDS:
                continue
            md, spec = d.get("metadata") or {}, d.get("spec") or {}
            chart = ((spec.get("chart") or {}).get("spec") or {}).get("chart") or \
                (spec.get("chartRef") or {}).get("name") or ""
            rows.append((d["kind"], md.get("name", ""), md.get("namespace", ""), rel,
                         spec.get("path", ""), chart, bool(spec.get("suspend"))))
    for kind, name, ns, rel, path, chart, suspended in sorted(rows):
        if not name:
            continue
        src = os.path.join(IDP_ROOT, path.lstrip("./")) if path else os.path.dirname(os.path.join(IDP_ROOT, rel))
        seen_dirs.add(os.path.relpath(src, IDP_ROOT).split("/")[1] if "/" in os.path.relpath(src, IDP_ROOT) else "")
        desc = _first_comment(os.path.join(IDP_ROOT, rel))
        if not desc:
            for cand in sorted(_glob.glob(os.path.join(src, "*.yaml")) + _glob.glob(os.path.join(src, "README.md"))):
                desc = _first_comment(cand)
                if desc:
                    break
        if not desc:
            desc = (f"{kind} {name}: Flux reconciles {path or rel} into namespace {ns or 'flux-system'}"
                    + (f", chart {chart}" if chart else "") + ".")
        etype = "flux-row" if kind == "Kustomization" else "helm-chart"
        ann = {"source": "cluster", "flux-kind": kind, "flux-name": name, "namespace": ns,
               "file": rel, "path": path, "chart": chart, "suspended": "true" if suspended else ""}
        ann.update(metrics_annotations(kind, name, ns, src))
        if kind == "HelmRelease" and not ns:
            ann["namespace"] = ann.get("backstage.io/kubernetes-namespace", "")
        tags = ["cluster", etype] + (["suspended"] if suspended else [])
        docs.append(entity("Component", f"cluster-{slug(kind).lower()}-{slug(name)}",
                           f"{name} ({kind})", etype, ann, tags, _idp_source_link(rel),
                           description=desc))
    # The CNI is two tools the founder asked for by name (crew#539: "are we getting hubble or not";
    # crew#624: "WHY IS HUBBLE NOT THERE"). Read from the values file so the catalogue says what
    # the cluster runs, never a name typed here.
    vals = os.path.join(IDP_ROOT, "platform", "cni", "cilium-values.yaml")
    if os.path.exists(vals):
        cv = yaml.safe_load(open(vals)) or {}
        hub = (cv.get("hubble") or {})
        for tool, on, what in (("cilium", True, "Cilium replaces flannel as the CNI: pod networking, network policy and eBPF datapath (platform/cni/cilium-values.yaml, applied by playbook cilium-replace, never a Flux row)."),
                               ("hubble", bool(hub.get("enabled")), f"Hubble is Cilium's flow observability: relay {'on' if (hub.get('relay') or {}).get('enabled') else 'off'}, UI {'on' if (hub.get('ui') or {}).get('enabled') else 'off'}; flows and metrics per pod, counted by bin/idp-telemetry-coverage.")):
            docs.append(entity("Component", f"cluster-cni-{tool}", tool.capitalize(), "cluster-choice",
                               {"source": "cluster", "file": "platform/cni/cilium-values.yaml", "enabled": "true" if on else "false"},
                               ["cluster", "cluster-choice", "cni"] + ([] if on else ["disabled"]),
                               _idp_source_link("platform/cni/cilium-values.yaml"), description=what))
        seen_dirs.add("cni")
    # Directories under platform/ that no Flux row reaches are still on the cluster or the
    # estate (the CNI is applied by the cluster's own bootstrap; oci/ is Terraform). One entity
    # each, so nothing that lives in the checkout is dark in the catalogue.
    plat = os.path.join(IDP_ROOT, "platform")
    for d in sorted(os.listdir(plat)) if os.path.isdir(plat) else []:
        full = os.path.join(plat, d)
        if not os.path.isdir(full) or d in seen_dirs:
            continue
        desc = ""
        for cand in sorted(_glob.glob(os.path.join(full, "README.md")) + _glob.glob(os.path.join(full, "*.yaml")) + _glob.glob(os.path.join(full, "*.tf"))):
            desc = _first_comment(cand)
            if desc:
                break
        if not desc:
            desc = f"platform/{d}: applied outside Flux (cluster bootstrap, Terraform or a workflow); see the files in the directory."
        docs.append(entity("Component", f"cluster-dir-{slug(d)}", f"platform/{d}", "cluster-choice",
                           {"source": "cluster", "file": f"platform/{d}"}, ["cluster", "cluster-choice"],
                           _idp_source_link(f"platform/{d}"), description=desc))
    return docs


def main() -> int:
    if not os.path.exists(INV):
        print(f"catalog-gen: no inventory at {INV} -- run the inventory first", file=sys.stderr)
        return 2
    inv = json.load(open(INV))
    rows = [r for r in (inv.get("rows") or []) if not vendor_software(r)]
    if not rows:
        # A catalogue that renders empty looks identical to a portal with nothing
        # wrong. Refuse instead, so the failure is loud where it happens.
        print("catalog-gen: inventory has 0 rows -- refusing to write an empty catalogue",
              file=sys.stderr)
        return 1

    os.makedirs(OUT, exist_ok=True)
    docs, counts, seen = [], {}, set()
    edges = orphans = techdocs = wellknown = 0

    # ---- pass 1: entity names, and the two relationships the inventory can prove ----
    #
    # A relationship this file invents is worse than no relationship: the portal
    # renders it identically and nobody can tell. So only two are emitted, and both
    # are read off measured fields rather than guessed from a name.
    #
    #   containment -- an asset whose `path` is inside a repo's `path` depends on
    #     that repo. Longest match wins, because ~/.claude/scripts sits inside
    #     ~/.claude. Measured on the 2026-08-24T19:00Z inventory: 197 of 215
    #     non-repo assets resolve; the 18 that do not are tagged outside-any-repo,
    #     which is LAW 24 made visible instead of silent.
    #
    #   coupling -- `coupling: anthropic` is the field the drills already grade
    #     "what survives losing this vendor". Emitting it as a Resource turns the
    #     portal's relations graph into the blast radius: click the vendor, see
    #     every asset that stops. 139 of 241 rows on the same inventory.
    #     Unioned with platform/vendors/consoles.yaml so a named root with no
    #     inventory tag (Cursor, crew#751) still has a Resource the portal can
    #     open. One entity per name; inventory dependents stay the measured count.
    #
    # Deliberately NOT emitted: providesApis. No repository in the estate publishes
    # an OpenAPI document -- measured, 0 of 26 -- so the field would be an empty
    # promise. It arrives when a service ships a spec, not before.
    names, repo_index = {}, []
    for r in rows:
        if r.get("kind") not in MAP:
            continue
        name = slug(r.get("id") or "unnamed")
        if name in seen:                       # ids collide across roots
            name = slug(f"{name}-{slug(r.get('root','x'))}")
        if name in seen:                       # still colliding: never drop an asset (idp-verify counts them)
            import hashlib
            name = slug(f"{name[:55]}-{hashlib.sha1(str(r.get('id')).encode()).hexdigest()[:6]}")
        seen.add(name)
        names[id(r)] = name
        if r.get("kind") == "repo" and r.get("path"):
            repo_index.append((r["path"].rstrip("/"), name))
    real_index = {os.path.realpath(rp).rstrip('/'): rn for rp, rn in repo_index}
    repo_index.sort(key=lambda t: (-len(t[0]), t[0]))  # longest path first: most specific repo wins;
    # then by path, so two checkouts whose paths are the same length cannot swap places between
    # runs and produce a one-byte diff in an otherwise identical catalogue.

    # dir -> main checkout path, or None. Cached because the 47 unresolved rows
    # of one inventory share far fewer directories than that, and because a
    # second call must return the same answer for idempotency (bin/idp-ci runs
    # this twice over one inventory and fails on a byte of difference).
    _common = {}

    def common_checkout(path):
        d = path if os.path.isdir(path) else os.path.dirname(path)
        if not d or not os.path.isdir(d):
            return None
        if d in _common:
            return _common[d]
        out = None
        try:
            r = subprocess.run(["git", "-C", d, "rev-parse", "--git-common-dir"],
                               capture_output=True, text=True, timeout=10)
            if r.returncode == 0 and r.stdout.strip():
                g = r.stdout.strip()
                # Relative to d when git reports a bare ".git" (git < 2.31 does
                # this for the main checkout), absolute for a linked worktree.
                if not os.path.isabs(g):
                    g = os.path.join(d, g)
                out = os.path.dirname(os.path.realpath(g)).rstrip("/")
        except (OSError, subprocess.SubprocessError):
            # No git on PATH, or a directory git refuses to read. An asset whose
            # repository cannot be established keeps the outside-any-repo tag,
            # which is the careful direction to be wrong in.
            out = None
        _common[d] = out
        return out

    def owning_repo(path):
        p = (path or "").rstrip("/")
        for rp, rname in repo_index:
            if p == rp or p.startswith(rp + os.sep):
                return rname
        # Not under any checkout the inventory listed -- but the comparison above
        # is a string prefix test, and a path can reach a tracked repository by a
        # route that string never sees.
        #
        #   A LINKED WORKTREE. The inventory finds repositories by testing
        #     isdir(c/".git"); in a linked worktree .git is a FILE, so every
        #     worktree is invisible to it. ~/dev/code/prospector-main (a worktree
        #     of ~/Documents/code/prospector) and ~/dev/code/.crew-state (of crew)
        #     are where those two are actually worked on.
        #   A SYMLINK. ~/.hermes is a symlink to ~/Documents/code/hermes, and ten
        #     launchd jobs run ~/.hermes/scripts/launchd_receipt.py.
        #
        # Measured on the 2026-08-24T21:49:59Z inventory: 14 of the 47 assets
        # carrying outside-any-repo were sitting in a tracked repository -- 4
        # prospector containers, com.chidionyema.graphify-sweep,
        # com.founder.estatesnapshot and 8 launchd jobs under ~/.hermes.
        #
        # That tag is how LAW 24 is made visible: it means "load-bearing and in no
        # repository we track". Reporting it for 14 assets that ARE tracked is a
        # false alarm, and a false alarm costs a session every time someone
        # believes it.
        #
        # git is asked rather than the gitfile parsed by hand: `rev-parse
        # --git-common-dir` is the documented way to get from any working tree to
        # its repository, and a second copy of that format here would be a worse
        # one (LAW 43).
        main = common_checkout(p)
        if main:
            # Both sides realpath'd. git always answers with symlinks resolved,
            # and the inventory records the path as it was walked. On macOS /tmp
            # is a symlink to /private/tmp and /var to /private/var, so a
            # checkout under either answers "/private/..." to git and "/..." to
            # the inventory, and a raw string compare silently never matches.
            return real_index.get(main)
        return None

    inv_couplings = {r.get("coupling") for r in rows
                     if r.get("coupling") and r.get("coupling") != "none"}
    reg = registry_vendors()
    couplings = sorted(inv_couplings | set(reg.keys()))
    vendor_docs = []
    for c in couplings:
        n = sum(1 for r in rows if r.get("coupling") == c)
        links = []
        page = (reg.get(c) or {}).get("page")
        if page:
            links.append(("Console", page))
        for title, url in _idp_source_link("platform/vendors/consoles.yaml"):
            if title == "Source":
                links.append((title, url))
                break
        if n:
            desc = f"External vendor {c}: {n} estate assets stop if it does."
        else:
            desc = (f"External vendor {c}: named in the vendor registry; "
                    "inventory has not tagged an asset against it yet.")
        vendor_docs.append(entity(
            "Resource", f"vendor-{slug(c)}", f"Vendor: {c}", "vendor",
            {"coupling": c, "dependents": n,
             "why": "every asset tagged with this coupling stops if it does",
             "registry": "platform/vendors/consoles.yaml" if c in reg else "inventory-only"},
            ["vendor", f"coupling-{slug(c)}"],
            links,
            description=desc))
    docs += vendor_docs

    # Domain and System take no spec.type/spec.system, so they are written out
    # literally rather than through entity(), which exists for the 194 rows.
    # github slug + real root per tracked repository; the Domain/System/Group docs below and
    # code_link() in pass 2 both read it.
    repo_gh = {names[id(r)]: (github_slug(r.get("remote")), os.path.realpath((r.get("path") or "").rstrip("/")))
               for r in rows if r.get("kind") == "repo"}
    def company_links(key):
        """One 'Source' link per tracked repository in the company, so a Domain page
        opens onto real code. Sorted by name so the render is byte-stable."""
        out = [(t, u.replace("${ESTATE_ZONE}", estate_zone())) for t, u in COMPANIES.get(key, ((),) * 4)[3:4]]
        for rn in sorted(repo_gh):
            gh_slug = repo_gh[rn][0]
            url = f"https://github.com/{gh_slug}"
            if gh_slug and company_of(rn) == key and url not in {u for _, u in out}:
                out.append((f"{rn} on GitHub", url))
        return out

    def org_links():
        owners = sorted({s.split("/")[0] for s, _ in repo_gh.values() if s})
        return [(f"Every repository ({o})", f"https://github.com/{o}") for o in owners]
    docs.append("\n".join([
        "apiVersion: backstage.io/v1alpha1", "kind: Domain", "metadata:",
        "  name: platform", "  title: Platform",
        f"  description: {y('Everything the estate runs, owns or depends on.')}",
        *links_yaml(company_links("platform")),
        "spec:", f"  owner: {OWNER}"]))
    docs.append("\n".join([
        "apiVersion: backstage.io/v1alpha1", "kind: System", "metadata:",
        "  name: estate", "  title: The estate",
        f"  description: {y('Every asset the estate owns, generated from the inventory at ' + str(inv.get('at')))}",
        *links_yaml(company_links("platform")),
        "spec:", f"  owner: {OWNER}", "  domain: platform"]))
    # Founder directive (is_ephemeral_ledger): per-session/per-worktree .claude scratch
    # renders apart from real products, in one clearly lesser System, recoverable, never
    # deleted. It is emitted only when such ledgers exist, so the portal never shows an
    # empty section; when no row is demoted nothing links here and nothing is emitted.
    if any(r.get("kind") == "ledger" and is_ephemeral_ledger(r) for r in rows):
        docs.append("\n".join([
            "apiVersion: backstage.io/v1alpha1", "kind: System", "metadata:",
            "  name: estate-internals", "  title: Internal agent records",
            "  description: " + y('Agent-internal bookkeeping and per-session/per-worktree Claude state, kept apart from the real estate surface. Nothing here is a product, a service or an estate record. Recoverable: nothing is deleted, this is only where the catalogue files it.'),
            "  tags: [estate-internal]",
            "spec:", f"  owner: {OWNER}", "  domain: platform"]))
    docs.append("\n".join([
        "apiVersion: backstage.io/v1alpha1", "kind: Group", "metadata:",
        "  name: platform", "  title: Platform",
        f"  description: {y('The team that owns every generated entity in this catalogue.')}",
        *links_yaml(org_links()),
        "spec:", "  type: team", f"  parent: group:default/{ORG[0]}",
        "  children: []"]))
    docs.append("\n".join([
        "apiVersion: backstage.io/v1alpha1", "kind: Group", "metadata:",
        f"  name: {ORG[0]}", f"  title: {y(ORG[1])}",
        f"  description: {y(ORG[2])}",
        *links_yaml(org_links()),
        "spec:", "  type: organization",
        "  children:", "    - platform"]))
    # One Domain per company (crew#612 CP2); `platform` stays the Domain the estate System
    # and every stack System already point at.
    for key, (title, _needles, desc, *_home) in COMPANIES.items():
        if key == "platform":
            continue
        docs.append("\n".join([
            "apiVersion: backstage.io/v1alpha1", "kind: Domain", "metadata:",
            f"  name: {key}", f"  title: {y(title)}",
            f"  description: {y(desc)}",
            *links_yaml(company_links(key)),
            "spec:", f"  owner: {OWNER}"]))
    # One product System per tracked repository, inside its company.
    repo_rows = [r for r in rows if r.get("kind") == "repo"]
    for r in repo_rows:
        rn = names[id(r)]
        docs.append("\n".join([
            "apiVersion: backstage.io/v1alpha1", "kind: System", "metadata:",
            f"  name: product-{rn}", f"  title: {y(rn + ' (product)')}",
            f"  description: {y('Everything the ' + rn + ' repository holds and runs: its code, its guards, its jobs, its data.')}",
            *links_yaml([("Source", f"https://github.com/{repo_gh[rn][0]}")] if repo_gh.get(rn, (None,))[0] else []),
            "spec:", f"  owner: {OWNER}", f"  domain: {company_of(rn)}"]))

    # One System per running compose project. Backstage's System is "a collection
    # of resources and components that exposes one or several public APIs", and
    # until this the whole estate was a single System, which renders as one flat
    # list of 245 things. A stack is the unit a person actually reasons about:
    # langfuse is 7 containers and you either have traces or you do not.
    stacks = sorted({r.get("project") for r in rows
                     if r.get("kind") == "container" and r.get("project")
                     and r.get("project") != "(none)"})
    for st in stacks:
        members = [r for r in rows if r.get("project") == st]
        docs.append("\n".join([
            "apiVersion: backstage.io/v1alpha1", "kind: System", "metadata:",
            f"  name: stack-{slug(st)}", f"  title: {y(st + ' stack')}",
            f"  description: {y(str(len(members)) + ' running containers, compose project ' + st)}",
            *links_yaml([("Its containers, in this catalogue", f"/catalog?filters%5Btags%5D=stack-{slug(st)}")]),
            "spec:", f"  owner: {OWNER}", "  domain: platform"]))

    # Ports. The catalog is the port registry: every listening port is an entity
    # and two claims on one port stop the generator. Before this, ports lived in
    # compose comments, one architecture table and four annotations, and 3200
    # was handed to the scheduler UI while an ssh forward held it (2026-08-24).
    claims = {}
    for r in rows:
        if r.get("kind") == "container" and r.get("published_ports") not in (None, "", "(none)"):
            for prt in str(r["published_ports"]).split(","):
                claims.setdefault(int(prt), set()).add(r["id"])
        elif r.get("kind") == "listener":
            # A listener's claim is its OWNER, not the program holding the socket.
            # The inventory has already mapped every published port to the
            # container that published it (~/.estate/scripts/inventory.py:690),
            # so the container row and the listener row are one claim, not two.
            #
            # This used to read `process != "ssh"`, which graded a proxy: it asked
            # which program happens to hold the socket rather than whether the
            # inventory had attributed it. Nine of the ten published ports on this
            # machine are forwarded by ssh, so the exemption covered them and the
            # bug stayed invisible. Ports 80 and 443 come through colima's
            # `limactl hostagent` instead, fell outside the exemption, and the
            # generator refused the whole catalogue over a port with exactly one
            # owner. Measured: `ai.estate.idp` last exit status 3, and
            # catalog/catalog-info.yaml frozen at 2026-08-24 22:10 while the
            # hourly job kept failing.
            #
            # Reading owner keeps every real collision. Something that binds a
            # port with no container behind it is named by its own process, so it
            # still collides with a container publishing the same port -- which is
            # the 3200 incident this guard was written for.
            claims.setdefault(int(r["port"]), set()).add(
                r.get("owner") or r.get("process") or r["id"])
    collisions = {prt: who for prt, who in claims.items() if len(who) > 1}
    if collisions:
        for prt, who in sorted(collisions.items()):
            print(f"catalog-gen: PORT COLLISION {prt}: {', '.join(sorted(who))}", file=sys.stderr)
        return 3
    port_owner = {}
    for r in rows:
        if r.get("kind") == "container" and r.get("published_ports") not in (None, "", "(none)"):
            for prt in str(r["published_ports"]).split(","):
                port_owner.setdefault(int(prt), names[id(r)])

    # ---- pass 2: the entities ----
    all_links = []
    # crew#612 CP2: every asset inside a tracked repository links to where it lives in the
    # code, on the repository's default branch (tree/HEAD never rots when a branch merges).
    # Only paths git itself tracks get the link: an untracked file would be a 404.

    def code_link(repo_name, path):
        gh_slug, root = repo_gh.get(repo_name, (None, None))
        if not gh_slug or not path or not root:
            return None
        rel = os.path.relpath(os.path.realpath(path), root)
        if rel.startswith(".."):
            return None
        ok = subprocess.run(["git", "-C", root, "ls-files", "--error-unmatch", "--", rel],
                            capture_output=True, text=True).returncode == 0
        return ("Where it lives in the code", f"https://github.com/{gh_slug}/tree/HEAD/{rel}") if ok else None

    for r in rows:
        k = r.get("kind")
        if k not in MAP:
            continue
        bkind, btype = MAP[k]
        name = names[id(r)]

        ann = {"root": r.get("root"), "path": r.get("path"), "coupling": r.get("coupling"),
               "kind": k}
        tags = [k.replace("_", "-"), f"coupling-{r.get('coupling') or 'none'}"]

        deps = []
        if r.get("coupling") and r.get("coupling") != "none":
            deps.append(f"resource:default/vendor-{slug(r['coupling'])}")
        owner_repo = name if k == "repo" else None
        if k != "repo":
            owner_repo = owning_repo(r.get("path"))
            if owner_repo:
                deps.append(f"component:default/{owner_repo}")
            else:
                # Load-bearing and in no repository we track: LAW 24. Three of these
                # run ~/.hermes/scripts/launchd_receipt.py, the estate the founder
                # killed on 2026-08-22.
                tags.append("outside-any-repo")
                orphans += 1

        if k == "repo":
            ann.update({"branch": r.get("branch"), "dirty": r.get("dirty"),
                        "tracked-files": r.get("tracked_files"),
                        "offsite": r.get("offsite")})
            if r.get("dirty"):
                tags.append("dirty")
            if not r.get("offsite"):
                tags.append("not-offsite")
            lic = any(os.path.exists(os.path.join(r.get("path", ""), n)) for n in
                      ("LICENSE", "LICENSE.md", "LICENSE.txt", "COPYING", "LICENCE"))
            ann["licence-file"] = "present" if lic else "ABSENT"
            if not lic:
                tags.append("no-licence")
            # TechDocs renders MkDocs. Annotating a repo that has no mkdocs.yml
            # gives the portal a Docs tab that 404s, which is the empty-shell
            # failure again. Measured 2026-08-24: 1 of 26 repos has one.
            # crew#459: the portal runs in a pod, not on the laptop that
            # generated this file, so `dir:.` can never be built there and the
            # Docs section stayed empty. A GitHub repo gets the URL form, which
            # the TechDocs builder fetches at read time; `dir:.` is kept only
            # for a repo with no GitHub remote (laptop-only rendering).
            gh = github_slug(r.get("remote"))
            if os.path.exists(os.path.join(r.get("path", ""), "mkdocs.yml")):
                ann["backstage.io/techdocs-ref"] = (
                    f"url:https://github.com/{gh}/tree/main/" if gh else "dir:.")
                tags.append("has-docs")
                techdocs += 1
            else:
                tags.append("no-docs")
            # Well-known keys, not estate/ ones. Backstage's own plugins read
            # these and read nothing of ours: project-slug drives every GitHub
            # widget, source-location drives the "View Source" affordance on
            # each entity page. Measured before this change: 0 of 245 entities
            # carried a single well-known annotation, so the portal rendered
            # 245 pages with no way back to the code.
            if gh:
                ann["github.com/project-slug"] = gh
                # The repository root, not the checked-out branch. A branch URL
                # 404s the moment that branch merges, and 8 of 26 repos are on a
                # feature branch right now -- the catalogue would churn on every
                # checkout for a link that rots.
                ann["backstage.io/source-location"] = f"url:https://github.com/{gh}/"
                wellknown += 1
        elif k == "scheduled_job":
            ann.update({"loaded": r.get("loaded"), "last-status": r.get("last_status"),
                        "interval-s": r.get("interval_s")})
            if str(r.get("last_status")) not in ("clean", "running"):
                tags.append("not-clean")
            if not r.get("loaded"):
                tags.append("not-loaded")
        elif k == "guard" and r.get("last_status"):
            # crew#474: hook-outcomes.jsonl via inventory guard_outcomes(); absent = never fired in 24h
            ann.update({"last-status": r.get("last_status"), "fired-24h": r.get("fired_24h"),
                        "refused-24h": r.get("refused_24h")})
        elif k == "drill":
            ann.update({"last-status": r.get("last_status"), "age-h": r.get("age_h"),
                        "max-age-days": r.get("max_age_days"), "stale": r.get("stale")})
            if r.get("last_status") in (None, "", "NEVER RUN"):
                tags.append("never-run")
            if r.get("stale"):
                tags.append("stale")
        elif k == "container":
            ann.update({"image": r.get("image"), "project": r.get("project"),
                        "service": r.get("service"), "health": r.get("health"),
                        "published-ports": r.get("published_ports"),
                        "image-pinned": r.get("pinned")})
            if r.get("project") and r.get("project") != "(none)":
                tags.append(f"stack-{r['project']}")
            if r.get("health") == "unhealthy":
                tags.append("unhealthy")
            if not r.get("pinned"):
                # A floating tag means two pulls a week apart run different
                # software. It is a supply-chain finding, so it is a tag a
                # person can filter on, not a number in a report nobody opens.
                tags.append("image-not-pinned")
        elif k == "listener":
            ann.update({"port": r.get("port"), "bind": r.get("bind"),
                        "process": r.get("process"), "command": r.get("command"),
                        "owner": r.get("owner")})
            if r.get("owner", "").startswith("(ssh forward"):
                tags.append("unowned-port")
            if r.get("bind") in ("*", "0.0.0.0", "::"):
                tags.append("bound-all-interfaces")
            own = port_owner.get(int(r.get("port") or 0))
            if own:
                deps.append(f"resource:default/{own}")
        elif k in ("ledger", "data"):
            ann.update({"rows": r.get("rows"), "mb": r.get("mb"),
                        "referenced": r.get("referenced")})

        links = []
        gh_link = github_slug(r.get("remote"))
        if gh_link:
            links.append(("Source", f"https://github.com/{gh_link}"))
        if k == "listener" and r.get("bind") in ("127.0.0.1", "*", "0.0.0.0", "[::1]", "::"):
            links.append(("Open", f"http://127.0.0.1:{r.get('port')}"))
        if k != "repo" and owner_repo:
            cl = code_link(owner_repo, r.get("path"))
            if cl:
                links.append(cl)

        sysref = SYSTEM
        if k == "container" and r.get("project") and r.get("project") != "(none)":
            sysref = f"system:default/stack-{slug(r['project'])}"
        elif owner_repo:
            # crew#612 CP2: company -> product -> asset. An asset in no tracked repository
            # stays on the estate System, tagged outside-any-repo above.
            sysref = product_ref(owner_repo)
        if k == "ledger" and is_ephemeral_ledger(r):
            # Founder directive (see is_ephemeral_ledger): per-session/per-worktree .claude
            # scratch is set apart - it is not a product member, not an estate surface. It
            # moves to the estate-internals System and carries the estate-internal tag so the
            # portal can keep it in a lesser, clearly-separate section (recoverable, never
            # deleted). This is absolute: it wins over any repo/product resolution, so a
            # .claude path can never leak back onto a product System.
            sysref = ESTATE_INTERNALS_SYSTEM
            if "estate-internal" not in tags:
                tags.append("estate-internal")
        if r.get("id") and human_title(r, name) != r.get("id"):
            ann["label"] = r.get("id")
        docs.append(entity(bkind, name, human_title(r, name), btype, ann, tags, links,
                           deps, system=sysref, description=describe(r)))
        all_links += [(f"{r.get('id') or name}: {t}", u) for t, u in links]
        counts[k] = counts.get(k, 0) + 1
        edges += len(deps)

    front = front_door_entities()
    docs += front
    counts["front-door"] = len(front)
    cluster = cluster_entities()
    docs += cluster
    counts["cluster"] = len(cluster)
    # crew#503 CP6: the founder entities reach the portal from the founder-catalog ConfigMap
    # (platform/backstage/overlays/oke, zone substituted by Flux), so they are not emitted here
    # a second time; they are still read so the `interfaces` card carries their links.
    founder = founder_surface_entities()
    counts["founder-surface (links only, entities via Flux)"] = len(founder)
    # Founder, 2026-08-27: "i thought i could see all my interface urls in one spot". One
    # entity carries every link the catalogue publishes, so the answer is one card in the
    # portal (Component `interfaces`), never a grep over 362 entities.
    for d in front + founder + cluster + vendor_docs:
        m = yaml_links(d)
        all_links += m
    all_links = sorted(set(all_links) | set(HIER_LINKS))
    docs.append(entity("Component", "interfaces", "Every interface URL", "website",
                       {"links": len(all_links)}, ["interfaces"], all_links,
                       description=f"Every URL the estate publishes, {len(all_links)} links collected from the catalogue itself; open one here instead of searching for it."))
    counts["interface-links"] = len(all_links)
    target = os.path.join(OUT, "catalog-info.yaml")
    with open(target, "w") as fh:
        fh.write("# GENERATED by idp/bin/catalog-gen from ~/.estate/state/inventory.json\n"
                 f"# inventory taken: {inv.get('at')}\n"
                 "# Do not hand-edit: the next run overwrites it. Fix the inventory instead.\n---\n")
        fh.write("\n---\n".join(docs) + "\n")

    # The human-readable ledger is rendered from the same rows, never hand-edited,
    # so it cannot disagree with the catalog or the process table.
    ports = sorted((r for r in rows if r.get("kind") == "listener"), key=lambda r: int(r["port"]))
    if ports:
        lines = ["# Ports", "",
                 "GENERATED by idp/bin/catalog-gen from the inventory taken " + str(inv.get("at")) + ".",
                 "The catalog is the port registry: every row here is a Resource of type `port` in",
                 "catalog-info.yaml, and catalog-gen refuses to run when two things claim one port.",
                 "To claim a port, bind it and run the inventory; to read the rule, see docs/how-to/onboarding/ports.md.",
                 "", "| Port | Bind | Owner | Process | Open |", "|---|---|---|---|---|"]
        for r in ports:
            url = f"http://127.0.0.1:{r['port']}"
            lines.append(f"| {r['port']} | {r.get('bind')} | {r.get('owner')} | {r.get('process')} | {url} |")
        with open(os.path.join(OUT, "ports.md"), "w") as fh:
            fh.write("\n".join(lines) + "\n")
    print(f"catalog-gen: {len(docs)} entities, {edges} dependsOn edges -> {target}")
    for k in sorted(counts):
        print(f"  {k:14} {counts[k]}")
    print(f"  {'stacks':14} {len(stacks)}  ({', '.join(stacks) or 'none'})")
    print(f"  {'vendors':14} {len(couplings)}  ({', '.join(couplings) or 'none'})")
    print(f"  {'orphans':14} {orphans}  (asset in no tracked repo -- LAW 24)")
    print(f"  {'techdocs':14} {techdocs}  (repo with an mkdocs.yml)")
    print(f"  {'well-known':14} {wellknown}  (repo carrying github.com/project-slug"
          " + backstage.io/source-location)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
