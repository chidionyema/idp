#!/usr/bin/env python3
"""Every open PR in the estate, its age and the one reason it is still open (crew#607 CP1).

Founder, 2026-08-28: "why do we have open PRs not merged" / "4 maximum". Measured that day: 24 open
PRs, the oldest four days, four of them green and waiting for nobody in particular. A PR is open for
at most PR_AGE_MAX_H machine-hours (default 4); this prints the table and exits 1 when any row is
over it, so a scheduled run is red for the reason the founder named.

Reasons, one per PR, first match wins: `conflict`, `red:<check>`, `pending:<check>`,
`stacked-on:<repo>#n`, `blocked-by-policy` (green checks, base policy still refuses: a required
check that no longer reports, idp#641), `green` (mergeable now: nobody merged it).

Age is measured against GitHub's clock (bin/lib/ledger_fresh.authority_now), never this machine's
(crew#583: a dead battery stamps 1970). No API clock -> BLIND, exit 2.

With `--act` (crew#607 CP2/CP3) the table is acted on, never only printed: a `green` row gets
`bin/idp-pr-arm` so it merges the moment nothing holds it where the repository allows auto-merge,
and reads `waiting-on-founder` where it does not (idp#1046). A row over the bound gets one
`PR AGE:` comment on its own thread naming the reason (never repeated while the reason is unchanged).

Nothing is ever drafted or closed (founder, 2026-09-29: "autuo closing prs is void, pr just disapears
andwork foesmissing"). The red clock that drafted a red row at the bound and closed it at six bounds is
gone: of 99 PRs closed unmerged in the fortnight before, 10 took commits main never received. A PR
stays in view until it lands, however long that takes.

Red means GitHub refuses the merge, not that some check somewhere failed. A failing check that is not
required (shadow-verify, 2026-09-29, red on every platform/llm PR while the shadow cluster could not
start litellm) leaves the PR UNSTABLE -- mergeable -- and the old any-failure rule called all of them
red, so none was armed and the pile grew behind one advisory check. GitHub's mergeStateStatus is the
verdict; the rollup only names the check when that verdict is a refusal.

Usage: bin/idp-pr-age [--repos idp,crew,claude-guards] [--act] [--json FILE ...]   (--json: test injection)
"""
from __future__ import annotations

import argparse
import datetime as dt
import json
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent / "lib"))
from ledger_fresh import authority_now  # noqa: E402

OWNER = os.environ.get("ESTATE_GITHUB_OWNER", "chidionyema")
FIELDS = "number,title,body,createdAt,mergeable,mergeStateStatus,isDraft,statusCheckRollup,headRefName"
# The branch the image-automation controller writes and the deploy PR is opened from. A PR from it
# IS the estate's deploy: drafting it stops the deploy, closing it throws the deploy away. idp#1046,
# 2026-08-31: this robot drafted PR 1011 -- the portal the founder was waiting on -- because a
# separate fault had made it red, and the red clock would have closed it at six bounds.
DEPLOY_BRANCH = os.environ.get("ESTATE_DEPLOY_BRANCH", "flux/image-updates")
STACKED = re.compile(r"[Ss]tacked on (?:([\w-]+))?#(\d+)")


def fetch(repo: str) -> list[dict]:
    p = subprocess.run(["gh", "pr", "list", "-R", f"{OWNER}/{repo}", "--state", "open", "--limit", "100",
                        "--json", FIELDS], capture_output=True, text=True, timeout=60)
    if p.returncode != 0:
        raise RuntimeError(f"{repo}: {p.stderr.strip()}")
    return [dict(pr, repo=repo) for pr in json.loads(p.stdout)]


# GitHub will merge these: every required check passed (UNSTABLE: only advisory checks failed).
MERGEABLE = {"CLEAN", "UNSTABLE", "HAS_HOOKS"}


def reason(pr: dict) -> str:
    if pr.get("mergeable") == "CONFLICTING":
        return "conflict"
    if pr.get("mergeStateStatus") in MERGEABLE:
        m = STACKED.search(pr.get("body") or "")
        return f"stacked-on:{m.group(1) or pr['repo']}#{m.group(2)}" if m else "green"
    for c in pr.get("statusCheckRollup") or []:
        if (c.get("conclusion") or "").upper() == "FAILURE":
            return f"red:{c.get('name') or c.get('context')}"
    for c in pr.get("statusCheckRollup") or []:
        if (c.get("status") or "").upper() in ("IN_PROGRESS", "QUEUED", "PENDING") and not c.get("conclusion"):
            return f"pending:{c.get('name') or c.get('context')}"
    m = STACKED.search(pr.get("body") or "")
    if m:
        return f"stacked-on:{m.group(1) or pr['repo']}#{m.group(2)}"
    if pr.get("mergeStateStatus") == "BLOCKED":
        return "blocked-by-policy"
    return "green"


def rows(prs: list[dict], now: dt.datetime) -> list[tuple[str, int, float, str, str, str]]:
    out = []
    for pr in prs:
        created = dt.datetime.fromisoformat(pr["createdAt"].replace("Z", "+00:00"))
        age_h = (now - created).total_seconds() / 3600.0
        out.append((pr["repo"], pr["number"], age_h, reason(pr), pr["title"][:60], pr.get("headRefName") or ""))
    return sorted(out, key=lambda r: -r[2])


def gh(*args: str) -> subprocess.CompletedProcess:
    return subprocess.run(["gh", *args], capture_output=True, text=True, timeout=60)


def arm(slug: str, n: int) -> subprocess.CompletedProcess:
    """idp#1046: auto-merge is off on this repository (allow_auto_merge=false, set beside the founder-only-releases ruleset on 2026-08-30), so `gh pr merge --auto` answers `enablePullRequestAutoMerge` and exits 1. bin/idp-pr-arm arms it where the repository allows it and names the founder's merge where it does not."""
    # --squash: main requires linear history, so a merge commit is refused ("Merge commits are not
    # allowed on this repository", pr-age run 36529931271) and nothing was ever armed.
    tool = os.path.join(os.path.dirname(os.path.abspath(__file__)), "idp-pr-arm")
    return subprocess.run([tool, str(n), "--squash"], capture_output=True, text=True,
                          timeout=60, env={**os.environ, "GH_REPO": slug})


def act(repo: str, n: int, age_h: float, why: str, max_h: float, head: str = "") -> str:
    """One action per row, returned as a word for the table: auto-merge | commented | quiet | -."""
    slug = f"{OWNER}/{repo}"
    if head == DEPLOY_BRANCH:
        # Hygiene never touches the deploy. This row is the running estate waiting to catch up with
        # main; a draft or a close here is an outage, not tidiness (idp#1046). It is still printed,
        # and bin/idp-deploy-lag is the instrument that grades how far behind it has fallen.
        return "deploy-untouched"
    if why == "green":
        p = arm(slug, n)
        if p.returncode != 0:
            return f"auto-merge-refused:{(p.stderr or p.stdout).strip()[:80]}"
        return "auto-merge" if p.stdout.startswith("ok") else "waiting-on-founder"
    if age_h <= max_h:
        return "-"
    line = f"PR AGE: {age_h:.1f}h open, reason: {why} (bound {max_h:g}h, founder 2026-08-28: 4 maximum; crew#607)"
    p = gh("pr", "view", str(n), "-R", slug, "--json", "comments", "-q", "[.comments[].body]|last // \"\"")
    if p.returncode == 0 and p.stdout.strip().startswith("PR AGE:") and f"reason: {why} " in p.stdout:
        return "quiet"
    p = gh("pr", "comment", str(n), "-R", slug, "--body", line)
    return "commented" if p.returncode == 0 else f"comment-refused:{(p.stderr or p.stdout).strip()[:80]}"


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--repos", default="idp,crew,claude-guards")
    ap.add_argument("--json", nargs="*", help="files of `gh pr list --json` output, with a `repo` key per PR (tests)")
    ap.add_argument("--now", help="ISO timestamp (tests); otherwise GitHub's clock")
    ap.add_argument("--act", action="store_true", help="auto-merge green rows, comment PR AGE: on rows over the bound")
    a = ap.parse_args()
    max_h = float(os.environ.get("PR_AGE_MAX_H", "4"))
    now = dt.datetime.fromisoformat(a.now.replace("Z", "+00:00")) if a.now else authority_now()
    if now is None:
        print("BLIND pr-age: no clock to measure against (gh api gave no Date header); the local clock is not one")
        return 2
    try:
        prs = [pr for f in a.json for pr in json.loads(pathlib.Path(f).read_text())] if a.json else \
              [pr for r in a.repos.split(",") for pr in fetch(r)]
    except (RuntimeError, OSError, ValueError) as e:
        print(f"BLIND pr-age: {e}")
        return 2
    over = 0
    print(f"{'repo':<14}{'pr':>6}  {'age_h':>7}  {'reason':<34} title")
    for repo, n, age, why, title, head in rows(prs, now):
        flag = "OVER" if age > max_h else "    "
        over += age > max_h
        did = f"  {act(repo, n, age, why, max_h, head)}" if a.act else ""
        print(f"{repo:<14}{n:>6}  {age:>7.1f}  {why:<34} {title}  {flag}{did}".rstrip())
    verdict = "FAIL" if over else "ok  "
    print(f"{verdict}    pr-age  {len(prs)} open, {over} over {max_h:g}h (founder 2026-08-28: 4 maximum)")
    return 1 if over else 0


if __name__ == "__main__":
    sys.exit(main())
