#!/usr/bin/env bash
# Stop Langfuse and the fallback. Data survives -- volumes are not touched.
#
#   langfuse-down            stop the containers, keep every trace
#   langfuse-down --purge    stop AND delete all trace data. Cannot be undone.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT

IDP="$(cd "$(dirname "$0")/.." && pwd)"
OBS="$IDP/observability"
COMPOSE=(docker compose --env-file "$OBS/.env" -f "$OBS/langfuse.yml")

if [ "${1:-}" = "--purge" ]; then
	echo "This deletes every trace, the ClickHouse data and the fallback file."
	echo "It cannot be undone. Ctrl-C now if that is not what you meant."
	sleep 5
	"${COMPOSE[@]}" down -v
	echo "stopped, volumes deleted"
else
	"${COMPOSE[@]}" down
	echo "stopped. Data kept -- bin/langfuse-up brings it back with every trace."
fi
