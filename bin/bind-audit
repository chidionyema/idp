#!/usr/bin/env bash
# bind-audit -- list every process on this machine listening on a non-loopback
# address and fail if one of them is not on the allow-list below.
#
# Why this exists. On 2026-08-24 the local Kubernetes cluster in
# platform/k3d/estate.yaml was created without a `kubeAPI:` block. k3d's default
# is to publish the API server on 0.0.0.0 at a port the kernel picks, so the
# control plane of the cluster was reachable from every interface of the laptop
# for 40 minutes: `docker port` read `6443/tcp -> 0.0.0.0:53145`. Nothing on the
# machine looked for it. The config file was reviewed, merged and CI-green.
#
# The class of mistake is not "one missing YAML key". It is: a config file that
# publishes a port is trusted to say where it binds, and nothing ever reads back
# what actually ended up listening. This script reads back what actually ended
# up listening.
#
# Founder ruling R20 (2026-08-24): the gateway is the only process that binds a
# non-loopback address. Everything else is 127.0.0.1 or nothing.
#
# Tool considered and rejected: osquery, whose `listening_ports` table is the
# mature answer to the enumeration half of this. It is not installed here, it
# wants a resident daemon (osqueryd) on a machine the founder has twice this
# week said is too slow to work on, and it supplies no policy -- the allow-list
# below is the part that has to be written either way. If osquery arrives on
# this estate for other reasons, replace the `lsof` line and keep the rest.
#
# Usage:
#   bin/bind-audit             audit this machine; exit 1 on any unknown bind
#   bin/bind-audit --selftest  prove the check both refuses and permits, then exit
#   bin/bind-audit --table F   audit a recorded lsof table instead of this machine,
#                              which is how CI runs it on a Linux runner that has
#                              neither this laptop's processes nor its lsof
#
# Exit codes: 0 clean, 1 an unknown non-loopback listener, 2 the audit could not
# see (LAW: a guard that loses its evidence reports BLIND, never a verdict).

set -uo pipefail

# ---------------------------------------------------------------------------
# The allow-list is catalog/ports.yaml. It used to be an array in this file,
# which meant the estate had TWO allow-lists for one question -- this one and
# bin/port-gate's -- free to drift apart, and neither visible from the ledger the
# founder made law. Founder directive 2026-08-24: "ports.yaml is the single
# source of truth for all port bindings across all environments."
#
# A port may face the network if the ledger gives it either
#   substrate: a row under `substrate:`   (not ours: Apple, lima)
#   ours:      a row with non_loopback: true  (R20: the gateway, and only it)
# Anything else FAILS. There is no silent pass branch, because an allow-list with
# a silent miss case is how ten criticals went undelivered for 18 hours here.
#
# REG can be overridden so bin/idp-ci can prove this both ways on a fixture.
# ---------------------------------------------------------------------------
REG=${REG:-"$(dirname "$(dirname "$(cd "$(dirname "$0")" && pwd)/x")")/catalog/ports.yaml"}
if [ ! -f "$REG" ]; then
  echo "BLIND: no port ledger at $REG. This is not a pass; nothing was checked." >&2
  exit 2
fi
# One "port|why" line per allowed non-loopback binding, read from the ledger.
ALLOW=()
while IFS= read -r line; do ALLOW+=("$line"); done < <(python3 - "$REG" <<'PYEOF'
import sys, yaml
reg = yaml.safe_load(open(sys.argv[1])) or {}
for r in reg.get("substrate") or []:
    if r.get("non_loopback"):
        print(f'{r["port"]}|{r.get("why","declared in catalog/ports.yaml as a substrate port.")}')
for r in reg.get("ports") or []:
    if r.get("non_loopback"):
        print(f'{r["port"]}|{r.get("service","?")}: declared non_loopback in catalog/ports.yaml. R20 allows this only for the gateway.')
PYEOF
)
if [ ${#ALLOW[@]} -eq 0 ]; then
  echo "BLIND: the ledger at $REG declares no non-loopback port. Refusing to report every listener as a finding on an empty list." >&2
  exit 2
fi

selftest_table() {
  # A synthetic lsof table: one row that must pass, one that must fail.
  # Format matches the columns this script reads: COMMAND PID USER FD TYPE DEV SIZE NODE NAME
  cat <<'EOF'
rapportd    447 chidionyema    8u  IPv4 0x0 0t0 TCP *:49248 (LISTEN)
k3d-proxy 99999 chidionyema    9u  IPv4 0x0 0t0 TCP *:53145 (LISTEN)
EOF
}

real_table() {
  lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null
}

# Reads an lsof table on stdin and prints one line per non-loopback listener,
# prefixed OK or UNKNOWN. It prints only; the caller counts. The count is not
# returned in a global because this function is always on the right of a pipe,
# which puts it in a subshell where an assignment is lost -- that bug made the
# first version of this script exit 1 on a clean machine.
audit() {
  local line cmd addr port hit row aport why
  while read -r line; do
    # lsof's own header, blank lines, and the '#' comments the recorded fixture
    # tables carry. Without the '#' arm a fixture's explanatory prose parsed as
    # five listeners called "#", and the good fixture failed its own check.
    case "$line" in COMMAND*|'#'*|"") continue ;; esac
    cmd=$(printf '%s\n' "$line" | awk '{print $1}')
    addr=$(printf '%s\n' "$line" | awk '{print $9}')
    # Loopback is the compliant case and is not reported.
    case "$addr" in
      127.0.0.1:*|'[::1]:'*) continue ;;
    esac
    port=${addr##*:}
    hit=""
    for row in "${ALLOW[@]}"; do
      aport=${row%%|*}
      why=${row#*|}
      if [ "$port" = "$aport" ]; then hit="$why"; break; fi
    done
    if [ -n "$hit" ]; then
      printf 'OK       %-12s %-22s %s\n' "$cmd" "$addr" "$hit"
    else
      printf 'UNKNOWN  %-12s %-22s not declared in catalog/ports.yaml. Bind it to 127.0.0.1, or add a row to the ledger saying why it may face the network.\n' "$cmd" "$addr"
    fi
  done
}

# lsof prints one row per file descriptor, so a process listening on both IPv4
# and IPv6 appears twice on the same port. Collapse to one row per finding.
dedupe() { awk '!seen[$1 FS $2 FS $3]++'; }

if [ "${1:-}" = "--selftest" ]; then
  echo "== selftest: the check must REFUSE an unknown bind =="
  out=$(selftest_table | audit | dedupe)
  printf '%s\n' "$out"
  n=$(printf '%s\n' "$out" | grep -c '^UNKNOWN')
  if [ "$((n + 0))" -ne 1 ]; then
    echo "SELFTEST FAILED: expected exactly 1 unknown, got $n"; exit 1
  fi
  echo "refused 1 of 2 rows, as required"
  echo
  echo "== selftest: the check must PERMIT a known bind =="
  # A guard only ever seen refusing has never been shown to permit (LAW 38).
  out=$(selftest_table | grep rapportd | audit | dedupe)
  printf '%s\n' "$out"
  n=$(printf '%s\n' "$out" | grep -c '^UNKNOWN')
  if [ "$((n + 0))" -ne 0 ]; then
    echo "SELFTEST FAILED: allow-listed row was refused"; exit 1
  fi
  echo "permitted 1 of 1 rows, as required"
  echo
  echo "SELFTEST PASS -- the check refuses and permits"
  exit 0
fi

if [ "${1:-}" = "--table" ]; then
  [ -f "${2:-}" ] || { echo "BLIND: no such table file: ${2:-}" >&2; exit 2; }
  TABLE=$(cat "$2")
else
  TABLE=$(real_table)
fi
if [ -z "$TABLE" ]; then
  echo "BLIND: lsof returned nothing. This is not a pass; the audit could not see." >&2
  exit 2
fi

echo "== non-loopback listeners on ${2:-$(hostname -s)} =="
OUT=$(printf '%s\n' "$TABLE" | audit | dedupe)
printf '%s\n' "$OUT"
SEEN=$(printf '%s\n' "$OUT" | grep -c '^\(OK\|UNKNOWN\)')
BAD=$(printf '%s\n' "$OUT" | grep -c '^UNKNOWN')
echo
if [ "$((BAD + 0))" -gt 0 ]; then
  echo "FAIL: $BAD of $SEEN non-loopback listeners are not allow-listed."
  exit 1
fi
echo "PASS: all $SEEN non-loopback listeners are allow-listed."
