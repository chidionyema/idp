#!/usr/bin/env python3
"""Refuses a push/PR that drops an idp.estate.io/runtime: always-on Kustomization.

c96359f4 (2026-09-26, "~80 Flux rows -> 7") deleted clusters/oke/backstage.yaml and
clusters/oke/platform.yaml outright. Nothing caught it: kubeconform and `kustomize build`
only validate whatever clusters/oke/ files still exist, so a file that is gone entirely is
invisible to both. Backstage was manually restored the next day; estate-mcp and hindsight
were not, and sat orphaned at 0/0 for two days. This compares the always-on Kustomization
names committed on the base ref against the working tree and fails if any name present on
the base ref is missing now -- the inventory may only grow.

THE SECOND INCIDENT. clusters/oke/quad-ledger.yaml was committed (390ec4875, 2026-09-27) and
never listed in clusters/oke/kustomization.yaml resources:. Flux builds ./clusters/oke from
that list, so the quad-ledger Kustomization was never created and the quad namespace never
existed; quad.ledger-verify exited 1 with 'namespaces "quad" not found' for a month. The drop
check above cannot see it: the file is still in the tree, so its names are in current_all and
nothing is missing. kubeconform and `kustomize build` cannot see it either -- both validate
whatever the manifest builds, and an unlisted file is not in what it builds. The file's own
header claimed 'a test pins this list to the directory'; no such test existed. This is it.

The same walk therefore also refuses a clusters/oke/*.yaml that is not reachable from
resources:, so 'the row was added to the tree but never wired to Flux' is a red CI rather
than a silent month.
"""
import os
import re
import subprocess
import sys
from pathlib import Path

BASE_REF = os.environ.get("IDP_CI_BASE") or "origin/main"
REPO_ROOT = Path(
    subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()
)
CLUSTER_DIR = "clusters/oke"
# Compare against where this branch left main, not main's tip: a branch cut before a row was
# ADDED to main would otherwise "drop" it (2026-09-28: every branch behind the platform.yaml
# restore was refused for dropping estate-db-migrate, hindsight, ... it never had).
_mb = subprocess.run(
    ["git", "merge-base", BASE_REF, "HEAD"], cwd=REPO_ROOT, capture_output=True, text=True
).stdout.strip()
BASE_REF = _mb or BASE_REF

# No DOTALL: "." must not swallow newlines here, or the lazy repetition below skips past the
# real metadata.name and matches the LAST "name:" line in the doc instead of the first (found
# by testing against clusters/oke/backstage.yaml, whose second Kustomization matched
# "catalogue" -- a name: nested many lines down in an unrelated patch -- instead of "backstage").
NAME_RE = re.compile(r"(?m)^metadata:\s*\n(?:.*\n)*?\s+name:\s*(\S+)")
RUNTIME_RE = re.compile(r"idp\.estate\.io/runtime:\s*(\S+)")


def kustomization_names(text):
    """Every Kustomization name in text, regardless of its runtime annotation."""
    names = set()
    for doc in re.split(r"(?m)^---\s*$", text):
        if "kind: Kustomization" not in doc or "kustomize.toolkit.fluxcd.io" not in doc:
            continue
        m = NAME_RE.search(doc)
        if m:
            names.add(m.group(1))
    return names


def always_on_names(text):
    names = set()
    for doc in re.split(r"(?m)^---\s*$", text):
        if "kind: Kustomization" not in doc or "kustomize.toolkit.fluxcd.io" not in doc:
            continue
        r = RUNTIME_RE.search(doc)
        if not r or r.group(1) != "always-on":
            continue
        m = NAME_RE.search(doc)
        if m:
            names.add(m.group(1))
    return names


def base_always_on():
    try:
        files = subprocess.run(
            ["git", "ls-tree", "-r", "--name-only", BASE_REF, "--", CLUSTER_DIR],
            cwd=REPO_ROOT,
            capture_output=True,
            text=True,
            check=True,
        ).stdout.splitlines()
    except subprocess.CalledProcessError:
        return None
    names = set()
    for f in files:
        if not f.endswith(".yaml") or f.endswith("kustomization.yaml"):
            continue
        show = subprocess.run(
            ["git", "show", f"{BASE_REF}:{f}"], cwd=REPO_ROOT, capture_output=True, text=True
        )
        if show.returncode != 0:
            continue
        names |= always_on_names(show.stdout)
    return names


def working_tree_names():
    """(all Kustomization names present, always-on names) in the working tree."""
    all_names, on_names = set(), set()
    for f in (REPO_ROOT / CLUSTER_DIR).rglob("*.yaml"):
        if f.name == "kustomization.yaml":
            continue
        text = f.read_text()
        all_names |= kustomization_names(text)
        on_names |= always_on_names(text)
    return all_names, on_names


def wired_resources():
    """Every path reachable from clusters/oke/kustomization.yaml resources:.

    Returns the set of entry strings as written (file names and sub-directory names). A file
    is applied by Flux only if it appears here; anything else in the directory is orphaned.
    Returns None when there is no kustomization.yaml at all: with no manifest there is no
    list to be missing from, and every file is trivially 'not in it'. Fixtures and throwaway
    repos that carry a lone Kustomization are legitimate and must not be refused for it.
    """
    kfile = REPO_ROOT / CLUSTER_DIR / "kustomization.yaml"
    if not kfile.exists():
        return None
    # A plain scan rather than a yaml dependency: this guard runs in the pre-push hook and in
    # CI on hosts where PyYAML is not guaranteed, and the shape is a flat list of scalars.
    entries, in_resources = set(), False
    for line in kfile.read_text().splitlines():
        if re.match(r"^\s*resources:\s*$", line):
            in_resources = True
            continue
        if in_resources:
            m = re.match(r"^\s*-\s*(.+?)\s*$", line)
            if m:
                entries.add(m.group(1).strip().strip('"').strip("'"))
            elif line.strip() and not line.startswith((" ", "\t")):
                in_resources = False  # a new top-level key ends the list
    return entries


def orphaned_files():
    """clusters/oke/*.yaml present in the tree but not listed in resources:.

    Returns [] when there is no kustomization.yaml (nothing to be orphaned from).
    """
    entries = wired_resources()
    if entries is None:
        return []
    orphans = []
    for f in sorted((REPO_ROOT / CLUSTER_DIR).glob("*.yaml")):
        if f.name == "kustomization.yaml":
            continue
        if f.name not in entries:
            orphans.append(f.name)
    return orphans


def main():
    base = base_always_on()
    if base is None:
        print(f"idp-always-on-guard: {BASE_REF} unreachable, skipping (nothing to diff against)")
        return 0
    current_all, current_on = working_tree_names()
    # A name that vanished from the always-on set but still exists as a Kustomization (demoted to
    # on-demand/none, in its own commit) is a deliberate decision, not the outage this guards
    # against; only a name gone from the tree entirely -- deleted, exactly like c96359f4 -- fails.
    missing = sorted(base - current_all)
    if missing:
        print(f"idp-always-on-guard: FAIL -- always-on Kustomization(s) dropped since {BASE_REF}:")
        for name in missing:
            print(f"  - {name}")
        print("If this is deliberate, demote it to on-demand/none first in its own commit;")
        print("an always-on row must never simply vanish.")
        return 1
    # A file that exists but is not listed in resources: is never applied by Flux, so it is
    # exactly as absent as one that was deleted -- the same outage, one indirection quieter.
    orphans = orphaned_files()
    if orphans:
        print(
            f"idp-always-on-guard: FAIL -- {CLUSTER_DIR}/*.yaml present but not wired into "
            f"{CLUSTER_DIR}/kustomization.yaml resources: (Flux never applies these):"
        )
        for name in orphans:
            print(f"  - {name}")
        print("Every *.yaml beside kustomization.yaml MUST be listed in its resources:.")
        print("An unlisted file is silently not applied; add the row, or delete the file.")
        return 1
    print(
        f"idp-always-on-guard: {len(current_on)} always-on Kustomization(s), none dropped, "
        f"none orphaned"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
