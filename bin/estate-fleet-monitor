#!/usr/bin/env python3
"""Layer-2 output gate: void language in a report to the founder raises an alarm.

    estate-fleet-monitor check [--alert] [--agent NAME]   read the report on stdin
    estate-fleet-monitor phrases                          print the void phrases

Void language is the founder's own list (protocol 2026-10-30): a status that hands work back
instead of citing claim, proof and outcome identifiers. Exit 0 clean, 1 ALARM. With --alert the
alarm goes to the fleet inbox and the founder's phone (bin/estate-fleet-telegram), so the founder
never has to read the offending report to learn it was one.
"""

import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
VOID = [
    "not proven",
    "unproven",
    "still open",
    "still unproven",
    "remaining",
    "next steps",
    "want me to",
    "shall i",
    "let me know if",
    "can't find",
    "cannot find",
    "couldn't find",
]
PATTERN = re.compile("|".join(re.escape(p).replace("'", "['’]") for p in VOID), re.I)


def scan(text):
    return sorted({m.group(0).lower() for m in PATTERN.finditer(text)})


def alert(agent, hits):
    msg = f"ALARM void language in {agent}'s report to the founder: {', '.join(hits)}. Re-run the search intent, then report claim/proof/outcome ids."
    subprocess.run(
        [sys.executable, str(HERE / "estate-fleet"), "send", "founder", msg],
        check=False,
    )  # noqa: S603
    subprocess.run(
        [sys.executable, str(HERE / "estate-fleet-telegram"), "send", msg], check=False
    )  # noqa: S603


def main(argv):
    if argv[:1] == ["phrases"]:
        print("\n".join(VOID))
        return 0
    if argv[:1] != ["check"]:
        sys.exit(__doc__)
    agent = argv[argv.index("--agent") + 1] if "--agent" in argv else "unknown"
    hits = scan(sys.stdin.read())
    if not hits:
        print("ok      estate-fleet-monitor  report is clean")
        return 0
    print(f"ALARM   estate-fleet-monitor  void language: {', '.join(hits)}")
    if "--alert" in argv:
        alert(agent, hits)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
