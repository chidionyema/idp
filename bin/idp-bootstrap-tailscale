#!/usr/bin/env bash
# Root trust for Tailscale, one command, no hands after the seed (crew#66; docs/policy/root-trust.md).
#   bin/idp-bootstrap-tailscale              mint the operator OAuth client through the API and write vault entry `tailscale-operator`
#   bin/idp-bootstrap-tailscale --check      exit 0 when the vault entry still exchanges for a token, 1 when it does not (hourly)
#   bin/idp-bootstrap-tailscale --rotate     mint a new client even though the vault entry already works, and delete the old one
#   bin/idp-bootstrap-tailscale --seed       the one human step, once: read the seed client from a hidden prompt into vault `tailscale-seed`
#
# What the provider allows, measured 2026-08-28 from the vendor's own SDK
# (github.com/tailscale/tailscale-client-go-v2 keys.go, KeysResource.CreateOAuthClient):
#   POST /api/v2/tailnet/-/keys  {"keyType":"client","scopes":[...],"tags":[...],"description":...}
# creates an OAuth client and answers {"id":..,"key":<secret>,..}; "keyType":"federated" creates a
# federated identity the same way. The earlier header of this file said no endpoint creates one and
# drove the admin console with a browser instead; that was measured from the console, not the API,
# and was wrong (crew#590 sheet, docs/vendors/tailscale.md). The bootstrap problem is real all the
# same: creating a credential needs a credential. The seed is ONE OAuth client, scope `oauth_keys`
# only, made once by a person in the console and never used for anything but minting. OAuth clients
# do not expire (tailscale.com/kb/1215), so --check is a drift check, not a renewal.
# Scopes minted: auth_keys (tag:k8s) + devices:core, the two the founder named, and policy_file, which
# bin/idp-tailscale-policy exchanges this same client for. Nothing is printed but key NAMES and ids.
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
SECRET=tailscale-operator
SEED=tailscale-seed
API=${TAILSCALE_API_URL:-https://api.tailscale.com}
TAG=${TAILSCALE_K8S_TAG:-tag:k8s}
SCOPES='["auth_keys","devices:core","policy_file"]'
CONSOLE=${TAILSCALE_CONSOLE_URL:-https://console.tailscale.com/admin/settings/trust-credentials}
VAULT_PUT=${IDP_VAULT_PUT:-$IDP/bin/idp-vault-put}   # tests point these at shims; no network, no vault
CLOUD=${IDP_CLOUD:-$IDP/bin/idp-cloud}
WHOAMI=${IDP_OCI_WHOAMI:-$IDP/bin/idp-oci-whoami}
MODE=${1:-mint}
case "$MODE" in mint|--check|--rotate|--seed) ;; *) sed -n 2,6p "$0"; exit 2;; esac

say()  { printf '%-7s %-20s %s\n' "$1" "$2" "$3"; }
fail() { say FAIL "$1" "$2"; exit 1; }
bl()   { say BLIND "$1" "$2"; exit 2; }
for t in curl jq; do command -v "$t" >/dev/null || bl deps "$t missing"; done
umask 077; P=$(mktemp -d); trap 'rm -rf "$P"' EXIT

# 1. the vault must be reachable before any one-time material exists (crew#503 lesson in idp-vault-put).
if ! OCI_CLI_PROFILE=$("$WHOAMI" 2>/dev/null); then
  MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
  SV="${ESTATE_SECRETS:-$(dirname "$MAIN")/estate-secrets}/secrets/${OCI_ENV:-dev}"
  export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
  region=$(sops -d --extract '["OCI_REGION"]' "$SV/OCI_REGION.yaml" 2>/dev/null); tenancy=$(sops -d --extract '["OCI_TENANCY_NAME"]' "$SV/OCI_TENANCY_NAME.yaml" 2>/dev/null)
  [ -n "$region" ] && [ -n "$tenancy" ] || bl oci "no live session and the sops vault at $SV has no OCI_REGION / OCI_TENANCY_NAME to sign in with"
  say "" oci "no live session: the browser opens once for OCI SSO (token lives one hour)"
  oci session authenticate --region "$region" --tenancy-name "$tenancy" --profile-name estate-bootstrap >/dev/null || bl oci "session sign-in did not complete"
  OCI_CLI_PROFILE=$("$WHOAMI") || bl oci "signed in, but no session profile is live"
fi
export OCI_CLI_PROFILE OCI_CLI_AUTH=security_token
VAULT_PUT_PREFLIGHT=1 "$VAULT_PUT" "$SECRET" --preflight | sed 's/^/        /' || bl vault "not reachable as $OCI_CLI_PROFILE"

token_for() { # <client_id> <client_secret> -> access-token JSON on stdout; never echoes inputs
  curl -sS -u "$1:$2" "$API/api/v2/oauth/token" -d grant_type=client_credentials
}
vault_pair() { # <entry> -> sets cid/csec from the vault, or returns 1
  local cur; cur=$("$CLOUD" secret get "$1" 2>/dev/null) && [ -n "$cur" ] || return 1
  cid=$(jq -r '.client_id // empty' <<<"$cur"); csec=$(jq -r '.client_secret // empty' <<<"$cur")
  [ -n "$cid" ] && [ -n "$csec" ]
}
vault_write() { # <entry> <client_id> <client_secret>, through a file the vault helper reads; never an argv
  printf 'V_client_id=%s\nV_client_secret=%s\n' "$2" "$3" > "$P/env"
  ESTATE_ENV_FILE="$P/env" "$VAULT_PUT" "$1" client_id=V_client_id client_secret=V_client_secret
}

# --seed: the one human step. The seed client is made in the console with exactly one scope,
# `oauth_keys` (write), and pasted here into a hidden prompt; it is never printed and never used
# for anything but minting. FOUNDER ACTION wording per LAW 47.
if [ "$MODE" = --seed ]; then
  say "" seed "FOUNDER ACTION: at $CONSOLE/add choose OAuth, description estateseed, tab Keys: tick OAuth keys WRITE, nothing else, Generate credential; then paste below"
  read -r -p 'seed client id: ' cid; read -r -s -p 'seed client secret (hidden): ' csec; echo
  token_for "$cid" "$csec" | jq -e '.access_token' >/dev/null || fail seed "the pasted seed does not exchange for a token"
  vault_write "$SEED" "$cid" "$csec"; unset cid csec
  say ok "$SEED" "written; run $0 to mint the operator client"
  exit 0
fi

# 2. does the operator entry already work? (idempotent: a working client is kept unless --rotate)
old_id=""
if vault_pair "$SECRET"; then
  if token_for "$cid" "$csec" | jq -e '.access_token' >/dev/null 2>&1; then
    [ "$MODE" = --check ] && { say ok "$SECRET" "vault entry exchanges for an access token"; exit 0; }
    [ "$MODE" = mint ] && { say ok "$SECRET" "vault entry exchanges for an access token; kept (--rotate to mint anew)"; exit 0; }
    old_id=$cid
  else
    [ "$MODE" = --check ] && fail "$SECRET" "vault entry present but does not exchange for a token; run $0 to mint"
    say "" "$SECRET" "vault entry present but does not exchange for a token; minting a new client"
  fi
else
  [ "$MODE" = --check ] && fail "$SECRET" "no vault entry; run $0 to mint"
fi

# 3. the seed, and an access token from it
vault_pair "$SEED" || fail seed "no vault entry $SEED; the one human step is: $0 --seed"
seed_tok=$(token_for "$cid" "$csec" | jq -r '.access_token // empty'); unset cid csec
[ -n "$seed_tok" ] || fail seed "vault entry $SEED does not exchange for a token; make a new seed with $0 --seed"
say ok seed "exchanges for an access token"

# 4. mint the operator client through the API (the SDK's CreateOAuthClient, verbatim body)
desc="estate-operator-$(date -u +%Y%m%dT%H%MZ)"
body=$(jq -cn --argjson s "$SCOPES" --arg t "$TAG" --arg d "$desc" '{keyType:"client",scopes:$s,tags:[$t],description:$d}')
resp=$(curl -sS -H "Authorization: Bearer $seed_tok" -H 'Content-Type: application/json' -d "$body" "$API/api/v2/tailnet/-/keys")
new_id=$(jq -r '.id // empty' <<<"$resp"); new_sec=$(jq -r '.key // empty' <<<"$resp")
[ -n "$new_id" ] && [ -n "$new_sec" ] || fail mint "POST /keys keyType=client answered no id/key: $(jq -r '.message // .error // "no message"' <<<"$resp" | cut -c1-120)"
say ok mint "OAuth client $new_id ($desc) scopes $SCOPES tag $TAG"

# 5. prove the credential before anything is stored (LAW 15: the API said so, the token endpoint must agree)
tok=$(token_for "$new_id" "$new_sec") || fail verify "token exchange did not answer"
jq -e '.access_token' <<<"$tok" >/dev/null || fail verify "the minted client does not exchange for a token: $(jq -r '.message // .error // "no message"' <<<"$tok")"
scopes=$(jq -r '.scope // ""' <<<"$tok")
for s in auth_keys devices:core policy_file; do
  case " $scopes " in *" $s "*|*" $s:"*) ;; *) [ -z "$scopes" ] || fail verify "token lacks scope $s (has: $scopes)";; esac
done
say ok verify "client exchanges for an access token; scopes: ${scopes:-not reported by the token endpoint}"

# 6. vault, then retire the client this one replaces (the operator reads the vault within its 1h refresh)
vault_write "$SECRET" "$new_id" "$new_sec"; unset new_sec tok
say ok "$SECRET" "written; ExternalSecret tailscale/tailscale-operator-secret picks it up within its 1h refresh (flux reconcile kustomization tailscale to hurry it)"
if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ]; then
  curl -sS -o /dev/null -w '' -X DELETE -H "Authorization: Bearer $seed_tok" "$API/api/v2/tailnet/-/keys/$old_id" && say ok rotate "old client $old_id deleted" || say "" rotate "old client $old_id not deleted; delete it in the console"
fi
