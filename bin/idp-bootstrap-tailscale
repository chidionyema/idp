#!/usr/bin/env bash
# Root trust for Tailscale, one command, no hands after the seed (crew#66; docs/reference/policy/root-trust.md).
#   bin/idp-bootstrap-tailscale              mint the operator OAuth client through the API and write vault entry `tailscale-operator`
#   bin/idp-bootstrap-tailscale --check      exit 0 when the vault entry still exchanges for a token, 1 when it does not
#   bin/idp-bootstrap-tailscale --rotate     mint a new client even though the vault entry already works, and delete the old one
#   bin/idp-bootstrap-tailscale --seed       the one human step, once: Chrome opens, you click the console wizard, the script reads the seed off the page into vault `tailscale-seed`
#   bin/idp-bootstrap-tailscale --federated-check   in GitHub Actions: exchange the runner OIDC token only, print ok or the full refusal, touch nothing
# In GitHub Actions with TAILSCALE_FEDERATED_CLIENT_ID set (estate-config), no seed is needed: the
# runner's OIDC token is exchanged for a Tailscale token (kb/1581) and the operator client is minted
# from that. .github/workflows/connect-tailscale.yml is the button; the seed road stays for a laptop.
#
# What the provider allows, measured 2026-08-28 from the vendor's own SDK
# (github.com/tailscale/tailscale-client-go-v2 keys.go, KeysResource.CreateOAuthClient):
#   POST /api/v2/tailnet/-/keys  {"keyType":"client","scopes":[...],"tags":[...],"description":...}
# creates an OAuth client and answers {"id":..,"key":<secret>,..}; "keyType":"federated" creates a
# federated identity the same way. The earlier header of this file said no endpoint creates one and
# drove the admin console with a browser instead; that was measured from the console, not the API,
# and was wrong (crew#590 sheet, docs/vendors/tailscale.md). The bootstrap problem is real all the
# same: creating a credential needs a credential. The seed is ONE OAuth client, scope `oauth_keys`
# only, made once by a person in the console and never used for anything but minting. OAuth clients
# do not expire (tailscale.com/kb/1215), so --check is a drift check, not a renewal.
# Scopes minted: auth_keys (tag:k8s) + devices:core, the two the founder named, and policy_file, which
# bin/idp-tailscale-policy exchanges this same client for. Nothing is printed but key NAMES and ids.
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
SECRET=tailscale-operator
SEED=tailscale-seed
API=${TAILSCALE_API_URL:-https://api.tailscale.com}
TAG=${TAILSCALE_K8S_TAG:-tag:k8s}
SCOPES='["auth_keys","devices:core","policy_file","users:read"]'   # users:read: bin/idp-tailscale-policy reads the tailnet owner for group:founder (crew#562)
CONSOLE=${TAILSCALE_CONSOLE_URL:-https://console.tailscale.com/admin/settings/trust-credentials}
VAULT_PUT=${IDP_VAULT_PUT:-$IDP/bin/idp-vault-put}   # tests point these at shims; no network, no vault
CLOUD=${IDP_CLOUD:-$IDP/bin/idp-cloud}
WHOAMI=${IDP_OCI_WHOAMI:-$IDP/bin/idp-oci-whoami}
MODE=${1:-mint}
case "$MODE" in mint|--check|--rotate|--seed|--federated-check) ;; *) sed -n 2,6p "$0"; exit 2;; esac

say()  { printf '%-7s %-20s %s\n' "$1" "$2" "$3"; }
fail() { say FAIL "$1" "$2"; exit 1; }
bl()   { say BLIND "$1" "$2"; exit 2; }
for t in curl jq; do command -v "$t" >/dev/null || bl deps "$t missing"; done
umask 077; P=$(mktemp -d); trap 'rm -rf "$P"' EXIT

federated_exchange() { # <federated client id> -> access-token JSON on stdout (kb/1581). Any answer but HTTP 200 with an
  # access_token prints the FULL error body and exits 1; there is no fall-through to a secret road (founder 2026-08-29,
  # run 33244862380 said `ok federated` on an empty answer and then blamed the seed). The token is never printed.
  local aud jwt code
  [ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ] || fail federated "identity $1 is configured but this is not GitHub Actions: the federated road runs only on the runner (gh workflow run oke-check.yml -f mode=apply)" >&2
  aud="api.tailscale.com/$1"
  jwt=$(curl -sS -H "Authorization: Bearer ${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=$aud" | jq -r '.value // empty')
  [ -n "$jwt" ] || fail federated "GitHub gave no OIDC token for audience $aud (does the job have id-token: write?)" >&2
  code=$(curl -sS -o "$P/xchg" -w '%{http_code}' -d "client_id=$1" --data-urlencode "jwt=$jwt" "$API/api/v2/oauth/token-exchange") || code=curl-failed
  # The claims are read from the token itself, never guessed: a repo created after 2026-07-15 sends GitHub's
  # immutable subject repo:OWNER@ID/REPO@ID:ref:... (run 33248046751 was refused on the guessed form).
  claims=$(printf '%s' "$jwt" | cut -d. -f2 | python3 -c 'import sys,base64,json; p=sys.stdin.read().strip(); d=json.loads(base64.urlsafe_b64decode(p+"="*(-len(p)%4))); print("iss=%s sub=%s aud=%s"%(d.get("iss"),d.get("sub"),d.get("aud")))' 2>/dev/null || echo "claims unreadable")
  unset jwt
  if [ "$code" != 200 ]; then
    say FAIL federated "token-exchange answered HTTP $code for identity $1. The runner presented: $claims. On the identity (kb/1581) set Issuer to that iss and Subject to that sub, or a wildcard of it. Full answer:" >&2
    cat "$P/xchg" >&2 2>/dev/null; echo >&2
    exit 1
  fi
  jq -e '.access_token' "$P/xchg" >/dev/null 2>&1 || { say FAIL federated "HTTP 200 but no access_token in the answer. Full answer:" >&2; cat "$P/xchg" >&2; echo >&2; exit 1; }
  cat "$P/xchg"
}
fed_id=${TAILSCALE_FEDERATED_CLIENT_ID:-$(awk '$1=="TAILSCALE_FEDERATED_CLIENT_ID:"{gsub(/"/,"",$2);print $2}' "${ESTATE_CONFIG:-$IDP/clusters/oke/estate-config.yaml}" 2>/dev/null || true)}
if [ "$MODE" = --federated-check ]; then
  [ -n "$fed_id" ] || fail federated "no TAILSCALE_FEDERATED_CLIENT_ID in clusters/oke/estate-config.yaml; register one (kb/1581)"
  federated_exchange "$fed_id" >/dev/null
  say ok federated "OIDC token exchanged at /api/v2/oauth/token-exchange for identity $fed_id (no secret held)"; exit 0
fi

# 1. the vault must be reachable before any one-time material exists (crew#503 lesson in idp-vault-put).
if ! OCI_CLI_PROFILE=$("$WHOAMI" 2>/dev/null); then
  MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
  SV="${ESTATE_SECRETS:-$(dirname "$MAIN")/estate-secrets}/secrets/${OCI_ENV:-dev}"
  export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
  region=$(sops -d --extract '["OCI_REGION"]' "$SV/OCI_REGION.yaml" 2>/dev/null); tenancy=$(sops -d --extract '["OCI_TENANCY_NAME"]' "$SV/OCI_TENANCY_NAME.yaml" 2>/dev/null)
  [ -n "$region" ] && [ -n "$tenancy" ] || bl oci "no live session and the sops vault at $SV has no OCI_REGION / OCI_TENANCY_NAME to sign in with"
  say "" oci "no live session: the browser opens once for OCI SSO (token lives one hour)"
  oci session authenticate --region "$region" --tenancy-name "$tenancy" --profile-name estate-bootstrap >/dev/null || bl oci "session sign-in did not complete"
  OCI_CLI_PROFILE=$("$WHOAMI") || bl oci "signed in, but no session profile is live"
fi
export OCI_CLI_PROFILE OCI_CLI_AUTH=security_token
VAULT_PUT_PREFLIGHT=1 "$VAULT_PUT" "$SECRET" --preflight | sed 's/^/        /' || bl vault "not reachable as $OCI_CLI_PROFILE"

token_for() { # <client_id> <client_secret> -> access-token JSON on stdout; the pair reaches curl on stdin, never argv
  printf 'user = "%s:%s"\n' "$1" "$2" | curl -sS -K - "$API/api/v2/oauth/token" -d grant_type=client_credentials
}
vault_pair() { # <entry> -> sets cid/csec from the vault, or returns 1
  local cur; cur=$("$CLOUD" secret get "$1" 2>/dev/null) && [ -n "$cur" ] || return 1
  cid=$(jq -r '.client_id // empty' <<<"$cur"); csec=$(jq -r '.client_secret // empty' <<<"$cur")
  [ -n "$cid" ] && [ -n "$csec" ]
}
vault_write() { # <entry> <client_id> <client_secret>, through a file the vault helper reads; never an argv
  printf 'V_client_id=%s\nV_client_secret=%s\n' "$2" "$3" > "$P/env"
  ESTATE_ENV_FILE="$P/env" "$VAULT_PUT" "$1" client_id=V_client_id client_secret=V_client_secret
}

# --seed: the one human step, and the hand never touches the secret (root-trust standard, crew#66, 2026-08-28:
# "the founder will never copy-paste a secret"). Real Chrome opens on the estate's own profile (Google SSO refuses
# Playwright's Chromium, idp#619), the founder completes SSO if asked and makes the console's own wizard clicks
# (a vendor console is not an API: the driver drives nothing, so nothing but two regexes can drift, 30bd2bf0),
# and this process reads the generated pair off the page, proves it against the API and writes the vault. Restored
# 2026-08-29 after 00cc57d9 replaced it with a paste prompt, which the founder refused five times.
if [ "$MODE" = --seed ]; then
  HOME_DIR=${ESTATE_HOME:-$HOME/.estate}; PROFILE="$HOME_DIR/tailscale-browser"; VENV="$HOME_DIR/bootstrap-venv"
  mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"
  if ! "$VENV/bin/python" -c 'import playwright' >/dev/null 2>&1; then
    say "" driver "installing playwright into $VENV (once)"
    python3 -m venv "$VENV" >/dev/null && "$VENV/bin/pip" install -q playwright >/dev/null
  fi
  say "" console "Chrome opens on $CONSOLE; if Tailscale asks you to sign in, complete SSO. Then: OAuth, a description of letters and digits, Continue, tab Keys: tick OAuth keys WRITE only, Generate credential. This script reads the result itself."
  "$VENV/bin/python" - "$CONSOLE" "$PROFILE" "$P/cred" <<'PY'
import re, sys, time
from playwright.sync_api import sync_playwright
console, profile, out = sys.argv[1:4]
def step(name): print(f"        step    {name}", flush=True)
with sync_playwright() as p:
    ctx = p.chromium.launch_persistent_context(profile, headless=False, viewport={"width": 1280, "height": 900},
                                               channel="chrome", ignore_default_args=["--enable-automation"],
                                               args=["--disable-blink-features=AutomationControlled"])
    page = ctx.pages[0] if ctx.pages else ctx.new_page()
    page.goto(console, wait_until="domcontentloaded"); step("console opened")
    heading = page.get_by_role("heading", name=re.compile(r"trust credentials|oauth clients", re.I))
    deadline = time.time() + 300
    while time.time() < deadline:
        if heading.count() and heading.first.is_visible(): break
        time.sleep(2)
    else:
        sys.exit("FAIL    console   no Trust credentials page after 5 minutes; SSO not completed")
    step("signed in")
    page.goto(console.rstrip("/") + "/add", wait_until="domcontentloaded")
    deadline = time.time() + 600; cid = sec = None
    while time.time() < deadline:
        try: text = page.inner_text("body")
        except Exception: text = ""
        cid = re.search(r"\b(k[A-Za-z0-9]{10,})\b", text); sec = re.search(r"\b(tskey-client-[A-Za-z0-9-]+)\b", text)
        if cid and sec: break
        time.sleep(2)
    else:
        sys.exit("FAIL    console   no generated client on the page after 10 minutes; nothing written")
    step("generated (read from the page, never shown)")
    with open(out, "w") as f: f.write(cid.group(1) + "\n" + sec.group(1) + "\n")
    done = page.get_by_role("button", name=re.compile(r"^(done|close)$", re.I))
    if done.count(): done.first.click()
    ctx.close()
PY
  cid=$(sed -n 1p "$P/cred"); csec=$(sed -n 2p "$P/cred"); [ -n "$cid" ] && [ -n "$csec" ] || fail console "driver produced no credential"
  token_for "$cid" "$csec" | jq -e '.access_token' >/dev/null || fail seed "the generated seed does not exchange for a token"
  vault_write "$SEED" "$cid" "$csec"; unset cid csec
  say ok "$SEED" "written from the page; run $0 to mint the operator client and register the federated identity"
  exit 0
fi

# 2. does the operator entry already work? (idempotent: a working client is kept unless --rotate)
old_id=""
if vault_pair "$SECRET"; then
  if token_for "$cid" "$csec" | jq -e '.access_token' >/dev/null 2>&1; then
    [ "$MODE" = --check ] && { say ok "$SECRET" "vault entry exchanges for an access token"; exit 0; }
    [ "$MODE" = mint ] && { say ok "$SECRET" "vault entry exchanges for an access token; kept (--rotate to mint anew)"; exit 0; }
    old_id=$cid
  else
    [ "$MODE" = --check ] && fail "$SECRET" "vault entry present but does not exchange for a token; run $0 to mint"
    say "" "$SECRET" "vault entry present but does not exchange for a token; minting a new client"
  fi
else
  [ "$MODE" = --check ] && fail "$SECRET" "no vault entry; run $0 to mint"
fi

# 3. an access token that may mint. Federated first (tailscale.com/kb/1581); the seed only manages identities.
#    a) in GitHub Actions with a federated identity registered for this repo: trade the runner's OIDC
#       JWT for a Tailscale token at /api/v2/oauth/token-exchange. No secret exists anywhere.
#       The identity's client id lives in the vault as `tailscale-federated` (written by road b) or in
#       clusters/oke/estate-config.yaml as TAILSCALE_FEDERATED_CLIENT_ID (issuer
#       https://token.actions.githubusercontent.com, subject repo:<owner>@<id>/<repo>@<id>:*, scope oauth_keys).
#    b) when the exchange is refused on the runner, the one bootstrap credential (founder 2026-08-29:
#       "create one credential by hand, then have that one manage the rest") REGISTERS the identity from
#       the claims the runner really carries, then road a runs again. The seed never mints the operator
#       on the runner; off the runner (no OIDC) it mints directly, the older one-human-step road.
vf=$("$CLOUD" secret get tailscale-federated 2>/dev/null | jq -r '.client_id // empty' 2>/dev/null || true)
[ -z "$vf" ] || fed_id=$vf
if [ -n "$fed_id" ] && seed_json=$(federated_exchange "$fed_id"); then
  say ok federated "OIDC token exchanged at /api/v2/oauth/token-exchange for identity $fed_id (no secret held)"
else
  # outside the runner a refused identity cannot be repaired (the claims live on the runner); the refusal is printed above
  [ -z "$fed_id" ] || [ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ] || exit 1
  #    c) the seed pair handed in by the environment (oke-check apply reads repository secrets
  #       SEED_TAILSCALE_CLIENT_ID / SEED_TAILSCALE_CLIENT_SECRET, set once by bin/idp-set-root tailscale:
  #       one OAuth client with the single scope oauth_keys write); it is vaulted as `tailscale-seed`
  #       here so the repository secrets can be deleted.
  if [ -n "${TAILSCALE_SEED_CLIENT_ID:-}" ] && [ -n "${TAILSCALE_SEED_CLIENT_SECRET:-}" ]; then
    cid=$TAILSCALE_SEED_CLIENT_ID; csec=$TAILSCALE_SEED_CLIENT_SECRET
    token_for "$cid" "$csec" | jq -e '.access_token' >/dev/null 2>&1 || fail seed "the seed pair in the environment does not exchange for a token"
    vault_pair "$SEED" || { vault_write "$SEED" "$cid" "$csec"; say ok "$SEED" "written from the environment; the repository secrets SEED_TAILSCALE_* may be deleted"; }
    cid=$TAILSCALE_SEED_CLIENT_ID; csec=$TAILSCALE_SEED_CLIENT_SECRET
  else
    vault_pair "$SEED" || fail seed "${fed_id:+the federated identity $fed_id was refused (answer above) and }no seed exists to register the identity from code: the one hand, once, is bin/idp-set-root tailscale (or $0 --seed on a laptop)"
  fi
  seed_json=$(token_for "$cid" "$csec"); unset cid csec TAILSCALE_SEED_CLIENT_SECRET
  if [ -n "${ACTIONS_ID_TOKEN_REQUEST_URL:-}" ]; then
    # road b: register the federated identity from the runner's own claims, vault its id, exchange again
    stok=$(jq -r '.access_token // empty' <<<"$seed_json"); [ -n "$stok" ] || fail seed "the seed does not exchange for a token: $(jq -r '.message // .error // "no message"' <<<"$seed_json" | cut -c1-200)"
    jwt=$(curl -sS -H "Authorization: Bearer ${ACTIONS_ID_TOKEN_REQUEST_TOKEN:-}" "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=api.tailscale.com" | jq -r '.value // empty')
    [ -n "$jwt" ] || fail federated "GitHub gave no OIDC token to read the runner's claims from (does the job have id-token: write?)"
    read -r iss sub < <(printf '%s' "$jwt" | cut -d. -f2 | python3 -c 'import sys,base64,json; p=sys.stdin.read().strip(); d=json.loads(base64.urlsafe_b64decode(p+"="*(-len(p)%4))); print(d["iss"], d["sub"])')
    unset jwt
    subj="${sub%%:ref:*}:*"   # every ref of this repository (ids are immutable; the name is not), nothing else
    body=$(jq -cn --arg i "$iss" --arg s "$subj" --arg d "estate-github-${GITHUB_REPOSITORY:-idp}" '{keyType:"federated",description:$d,scopes:["oauth_keys"],issuer:$i,subject:$s}')
    resp=$(curl -sS -H "Authorization: Bearer $stok" -H 'Content-Type: application/json' -d "$body" "$API/api/v2/tailnet/-/keys")
    new_fid=$(jq -r '.id // empty' <<<"$resp")
    [ -n "$new_fid" ] || fail federated "POST /keys keyType=federated answered no id: $(jq -r '.message // .error // "no message"' <<<"$resp" | cut -c1-160)"
    vault_write tailscale-federated "$new_fid" none
    say ok federated "identity $new_fid registered from code: issuer $iss subject $subj scope oauth_keys; vaulted as tailscale-federated"
    if [ -n "$fed_id" ] && [ "$fed_id" != "$new_fid" ]; then
      code=$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE -H "Authorization: Bearer $stok" "$API/api/v2/tailnet/-/keys/$fed_id" || echo curl-failed)
      case "$code" in 200|204) say ok federated "refused identity $fed_id deleted";; *) say "" federated "refused identity $fed_id not deleted (DELETE answered $code); harmless, delete it later";; esac
    fi
    unset stok
    seed_json=$(federated_exchange "$new_fid") || fail federated "the identity registered from the runner's own claims is still refused (answer above)"
    say ok federated "OIDC token exchanged for identity $new_fid (no secret held from here on)"
  fi
fi
seed_tok=$(jq -r '.access_token // empty' <<<"$seed_json")
[ -n "$seed_tok" ] || fail seed "the seed does not exchange for a token: $(jq -r '.message // .error // "no message"' <<<"$seed_json" | cut -c1-200); make a new seed with $0 --seed"
seed_scopes=$(jq -r '.scope // ""' <<<"$seed_json")
case "$seed_scopes" in ""|oauth_keys|oauth_keys:*) ;; *) fail seed "the seed carries more than oauth_keys ($seed_scopes); a seed is one scope, make a new one with $0 --seed";; esac
say ok seed "exchanges for an access token; scopes: ${seed_scopes:-not reported by the token endpoint}"

# 4. mint the operator client through the API (the SDK's CreateOAuthClient, verbatim body)
desc="estate-operator-$(date -u +%Y%m%dT%H%MZ)"
body=$(jq -cn --argjson s "$SCOPES" --arg t "$TAG" --arg d "$desc" '{keyType:"client",scopes:$s,tags:[$t],description:$d}')
resp=$(curl -sS -H "Authorization: Bearer $seed_tok" -H 'Content-Type: application/json' -d "$body" "$API/api/v2/tailnet/-/keys")
new_id=$(jq -r '.id // empty' <<<"$resp"); new_sec=$(jq -r '.key // empty' <<<"$resp")
[ -n "$new_id" ] && [ -n "$new_sec" ] || fail mint "POST /keys keyType=client answered no id/key: $(jq -r '.message // .error // "no message"' <<<"$resp" | cut -c1-120)"
say ok mint "OAuth client $new_id ($desc) scopes $SCOPES tag $TAG"

# 5. prove the credential before anything is stored (LAW 15: the API said so, the token endpoint must agree)
tok=$(token_for "$new_id" "$new_sec") || fail verify "token exchange did not answer"
jq -e '.access_token' <<<"$tok" >/dev/null || fail verify "the minted client does not exchange for a token: $(jq -r '.message // .error // "no message"' <<<"$tok")"
scopes=$(jq -r '.scope // ""' <<<"$tok")
for s in auth_keys devices:core policy_file; do
  case " $scopes " in *" $s "*|*" $s:"*) ;; *) [ -z "$scopes" ] || fail verify "token lacks scope $s (has: $scopes)";; esac
done
say ok verify "client exchanges for an access token; scopes: ${scopes:-not reported by the token endpoint}"

# 6. vault, then retire the client this one replaces (the operator reads the vault within its 1h refresh)
vault_write "$SECRET" "$new_id" "$new_sec"; unset new_sec tok
say ok "$SECRET" "written; ExternalSecret tailscale/tailscale-operator-secret picks it up within its 1h refresh (flux reconcile kustomization tailscale to hurry it)"
if [ -n "$old_id" ] && [ "$old_id" != "$new_id" ]; then
  code=$(curl -sS -o /dev/null -w '%{http_code}' -X DELETE -H "Authorization: Bearer $seed_tok" "$API/api/v2/tailnet/-/keys/$old_id" || echo curl-failed)
  case "$code" in 200|204) say ok rotate "old client $old_id deleted";; *) fail rotate "old client $old_id NOT deleted (DELETE answered $code); the superseded credential is still live, delete it in the console";; esac
fi
