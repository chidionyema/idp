#!/usr/bin/env python3
"""SigNoz is gone and does not come back.

Founder, 2026-09-27: "remove signoz" and "don't let it come back". Its ClickHouse took 2.0 cores of
a 1.8-core budget, and the estate's one OTLP door is now platform/monitoring/otlp.yaml (Alloy ->
Grafana Cloud). A second telemetry store is a second copy of a layer (AGENTS.md section 6).

This refuses any deployable SigNoz identifier in what Flux, CI or a template can ship: a chart,
a chart repository, an image, a resource or host name, an endpoint. History is not refused --
comments and prose that say what the old store did stay readable. What counts as deployable is
a lowercase `signoz` token that is joined to something (signoz-otel-collector, charts.signoz.io,
signoz/signoz, signoz.<zone>), or the whole value of a key or list item (`chart: signoz`). K8s
names, chart names and image refs are lowercase, so capitalised prose ("SigNoz") never matches.

  idp-no-signoz-gate [ROOT]      exit 0 clean, 1 refused
"""

from __future__ import annotations

import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SCOPE = (
    "platform/",
    "clusters/",
    "backstage/templates/",
    ".github/workflows/",
    "mcp/",
    "intents/",
)
SUFFIXES = (".yaml", ".yml", ".json", ".tf")
# The one-shot Job that deletes what is left on the cluster, and the line that ships it. The
# cleanup PR removes both after the Job's "done retire-signoz" log line, and this with them.
EXEMPT_FILES = {"platform/edge/retire-signoz.yaml"}
EXEMPT_TOKENS = {"retire-signoz.yaml"}

TOKEN = re.compile(r"[\w./:@-]*(?<![A-Za-z])signoz(?![a-z])[\w./:@-]*")
WHOLE = re.compile(r"""^\s*(?:-\s+|[\w.-]+:\s+)["']?signoz["']?\s*,?\s*$""")
COMMENT = re.compile(r"(^|\s)#.*$")


def refused(text: str) -> list[tuple[int, str]]:
    hits = []
    for n, raw in enumerate(text.splitlines(), 1):
        line = COMMENT.sub("", raw)
        if "signoz" not in line:
            continue
        joined = [t for t in TOKEN.findall(line) if t != "signoz" and t not in EXEMPT_TOKENS]
        if joined or WHOLE.match(line):
            hits.append((n, raw.strip()))
    return hits


def main(root: str) -> int:
    files = subprocess.run(
        ["git", "-C", root, "ls-files", *SCOPE], capture_output=True, text=True, check=True
    ).stdout.split()
    bad = 0
    for f in files:
        if not f.endswith(SUFFIXES) or f in EXEMPT_FILES:
            continue
        path = os.path.join(root, f)
        if not os.path.isfile(path):
            continue
        with open(path, encoding="utf-8", errors="replace") as fh:
            for n, line in refused(fh.read()):
                print(f"  REFUSED {f}:{n}: {line}")
                bad += 1
    if bad:
        print(
            f"idp-no-signoz-gate: {bad} SigNoz identifier(s). The one OTLP door is "
            "platform/monitoring/otlp.yaml (Alloy -> Grafana Cloud); SigNoz does not come back."
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1] if len(sys.argv) > 1 else ROOT))
