#!/usr/bin/env python3
"""The shop serves what we built, graded from the visitor's side (crew#693).

    bin/idp-storefront-drill            # grades https://<ESTATE_ZONE>

2026-08-30 17:01Z to 2026-08-31: the storefront pack pictures were built, merged and pushed to
the registry, and the cluster kept serving the 17:01 build for eight hours. Nothing said so. The
release rail's own pull request could not merge (auto-merge is off on this repository, run
33336842115) so the tag in clusters/oke/edge.yaml never moved, and every instrument in the estate
stayed green: flux reconciled what git held, the pods were Ready, the front door answered 200. The
founder found it by looking at the site and saying it looked the same.

That is the class this drill closes. Every existing drill grades the platform -- a login, a
cluster, a collector. None of them opens the shop and asks whether it is showing what the last
merge built, so a release that silently stops arriving reads as a healthy estate.

Three rows, all of them what a stranger gets:

  shop-answers     the home page answers 200 with HTML
  pack-page        the first pack the home page links to answers 200
  pack-pictures    the home page references at least one pack picture, and every picture it
                   references loads as an image

The picture row is the one that was red for eight hours. Zero pictures referenced is a FAIL, not
a pass on an empty list: measured 2026-08-31, the live home page linked 77 packs and referenced 0
pictures, while the same code built locally referenced 62. A row that grades a list it never
checks is full is the silent-green defect this estate has on record four times.

Nothing here names a selector, a test id or anything about layout (R53). A picture that loads and
a page that answers are features; where they sit on the screen is not this drill's business.
"""

from __future__ import annotations

import re
import sys
import urllib.error
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
CONFIG = REPO / "clusters" / "oke" / "estate-config.yaml"
TIMEOUT = 20
# Enough to prove the estate is serving the pack pictures, few enough that the drill stays under a
# minute on a cold runner. The row fails on the first picture that does not load, so a wider sample
# would not find a different answer -- it would only find it slower.
SAMPLE = 8

failures = 0


def say(ok: bool, row: str, detail: str) -> None:
    global failures
    if not ok:
        failures += 1
    print(f"{'ok  ' if ok else 'FAIL'} {row:<14} {detail}", flush=True)


def zone() -> str:
    """The shop's host, read from the estate config; never a literal (LAW 46, estate-zone-gate)."""
    match = re.search(r"^\s*ESTATE_ZONE:\s*(\S+)", CONFIG.read_text(), re.M)
    if not match:
        say(False, "config", f"{CONFIG.relative_to(REPO)} declares no ESTATE_ZONE")
        sys.exit(1)
    return match.group(1).strip().strip("\"'")


def fetch(url: str) -> tuple[int, str, bytes]:
    """Answer (status, content type, body). A refused connection is a status of 0, not a crash."""
    request = urllib.request.Request(
        url, headers={"User-Agent": "idp-storefront-drill"}
    )
    try:
        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:  # noqa: S310
            return (
                response.status,
                response.headers.get("content-type", ""),
                response.read(),
            )
    except urllib.error.HTTPError as error:
        return error.code, error.headers.get("content-type", ""), b""
    except OSError as error:
        return 0, str(error), b""


def main() -> int:
    shop = f"https://{zone()}"

    status, content_type, body = fetch(f"{shop}/")
    home = body.decode("utf-8", "replace")
    say(
        status == 200 and "text/html" in content_type,
        "shop-answers",
        f"{shop}/ -> {status} {content_type or 'no content type'}",
    )

    packs = sorted(set(re.findall(r'/pack/([0-9a-f]{8,32})(?=")', home)))
    if not packs:
        say(
            False,
            "pack-page",
            f"{shop}/ links no pack: the catalogue is not being rendered",
        )
    else:
        first = f"{shop}/pack/{packs[0]}"
        status, content_type, _ = fetch(first)
        say(
            status == 200,
            "pack-page",
            f"{len(packs)} packs listed; {first} -> {status}",
        )

    pictures = sorted(set(re.findall(r"/pack/[0-9a-f]{8,32}\.jpg", home)))
    if not pictures:
        say(
            False,
            "pack-pictures",
            f"{shop}/ references 0 pack pictures over {len(packs)} packs: the build serving the "
            "shop is older than the one that added them",
        )
    else:
        bad = []
        for path in pictures[:SAMPLE]:
            status, content_type, body = fetch(f"{shop}{path}")
            if status != 200 or not content_type.startswith("image/") or not body:
                bad.append(f"{path} -> {status} {content_type or 'no content type'}")
        say(
            not bad,
            "pack-pictures",
            f"{len(pictures)} referenced, {min(len(pictures), SAMPLE)} fetched"
            + (f"; broken: {'; '.join(bad)}" if bad else "; all served as images"),
        )

    print(
        f"{'FAIL' if failures else 'ok  '} storefront-smoke  "
        f"{failures} row(s) red out of 3 at {shop}",
        flush=True,
    )
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
