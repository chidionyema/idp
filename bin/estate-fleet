#!/usr/bin/env python3
from __future__ import annotations

import html
import json
import os
import time
import urllib.request
from pathlib import Path

HOME = Path.home()
TOP = HOME / ".estate" / "topology"
FLEETVIEW = "http://127.0.0.1:18790/sessions"
OUT_JSON = TOP / "fleet.json"
OUT_HTML = TOP / "fleet.html"
PROC = {
    "claude-code": "/claude",
    "pi": "/pi",
    "opencode": "/opencode",
}

PROC_MAP = {}


def processes() -> dict[str, int]:
    out: dict[str, int] = {}
    try:
        import subprocess
        p = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True, timeout=10)
    except Exception:
        return out
    for line in p.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) != 2:
            continue
        pid, comm = parts
        out[comm.strip()] = len(out) and out.get(comm.strip(), 0) + 1 or 1
    return out


def fetch() -> dict:
    try:
        with urllib.request.urlopen(FLEETVIEW, timeout=12) as r:
            return json.loads(r.read().decode())
    except Exception as exc:
        return {"available": False, "error": repr(exc)[:200], "sessions": []}


def normalize(doc: dict, pids: dict) -> dict:
    rows = []
    runtimes = {}
    states = {}
    unknown = []
    for s in doc.get("sessions") or []:
        runtime = s.get("runtime") or "unknown"
        runtimes[runtime] = runtimes.get(runtime, 0) + 1
        state = s.get("state") or "unknown"
        states[state] = states.get(state, 0) + 1
        needle = PROC.get(runtime, "")
        observed = bool(needle) and any(needle in comm for comm in pids)
        if not needle:
            unknown.append("runtime %s has no process mapping" % runtime)
        rows.append({
            "session_id": s.get("session_id"),
            "runtime": runtime,
            "model": s.get("model"),
            "state": state,
            "step": s.get("step"),
            "age_seconds": s.get("age_seconds"),
            "event_count": s.get("event_count"),
            "repo": s.get("repo"),
            "ticket": s.get("ticket"),
            "task": (s.get("task") or "")[:120],
            "updated_at": s.get("updated_at"),
            "trace_url": s.get("trace_url"),
            "worker_observed": observed,
        })
    return {
        "at": int(time.time()),
        "source": FLEETVIEW,
        "source_generated_at": doc.get("generated_at"),
        "available": bool(doc.get("available")),
        "error": doc.get("error"),
        "unreachable": doc.get("unreachable") or [],
        "fresh_window_minutes": doc.get("fresh_window_minutes"),
        "sessions": len(rows),
        "runtimes": runtimes,
        "states": states,
        "unknown": sorted(set(unknown)),
        "rows": rows,
    }


def page(doc: dict) -> str:
    rows = sorted(doc["rows"], key=lambda r: r.get("age_seconds") or 10**9)[:80]
    trs = []
    for r in rows:
        colour = {"working": "#17b26a", "paused": "#f5a524", "failed": "#e5484d"}.get(r["state"], "#8b93a7")
        obs = "yes" if r["worker_observed"] else "not observed"
        trs.append(
            "<tr><td><span class=dot style=\"background:%s\"></span></td>"
            "<td><b>%s</b><div class=id>%s</div></td><td>%s</td><td>%s</td>"
            "<td>%s</td><td>%ss</td><td>%s</td><td>%s</td></tr>" % (
                colour, html.escape(r["runtime"]), html.escape((r["session_id"] or "")[:48]),
                html.escape(r["state"]), html.escape((r["model"] or "")[:32]),
                r["event_count"] if r["event_count"] is not None else "-",
                r["age_seconds"] if r["age_seconds"] is not None else "?",
                html.escape(r["repo"] or "-"), obs))
    counters = "".join("<div class=card><b>%s</b>%s</div>" % (n, html.escape(k))
                       for k, n in sorted(doc["runtimes"].items()))
    return """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<meta http-equiv=refresh content=30>
<title>Estate fleet</title>
<style>
body{font:14px/1.45 -apple-system,system-ui,sans-serif;margin:0;background:#0b0d10;color:#e7e9ee}
main{max-width:1100px;margin:0 auto;padding:20px}
h1{font-size:20px;margin:0 0 4px}.sub{color:#8b93a7;margin-bottom:14px}
.cards{display:flex;gap:10px;flex-wrap:wrap;margin:10px 0}
.card{background:#141821;border:1px solid #232936;border-radius:10px;padding:10px 14px;min-width:90px}
.card b{font-size:20px;display:block}
table{width:100%%;border-collapse:collapse;background:#141821;border:1px solid #232936;border-radius:10px;overflow:hidden}
th,td{text-align:left;padding:8px 10px;border-bottom:1px solid #1d2330;vertical-align:top}
th{color:#8b93a7;font-size:12px}.id,.grey{color:#8b93a7;font-size:12px}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%%}
</style>
<main>
<h1>Estate fleet</h1>
<div class=sub>source %s &middot; %d sessions &middot; source time %s &middot; refresh 30s</div>
<div class=cards>%s</div>
<div class=cards>%s</div>
<table><thead><tr><th></th><th>runtime / session</th><th>state</th><th>model</th><th>events</th><th>age</th><th>repo</th><th>worker observed</th></tr></thead>
<tbody>%s</tbody></table>
<div class=sub style="margin-top:10px">"worker observed" is a process match, not a heartbeat: when it says
not observed, the worker is unproven, not necessarily dead. Unknowns: %s</div>
</main>""" % (html.escape(doc["source"]), doc["sessions"], html.escape(str(doc["source_generated_at"])),
              counters, "".join("<div class=card><b>%s</b>%s</div>" % (n, html.escape(k))
                                for k, n in sorted(doc["states"].items())),
              "".join(trs), html.escape(", ".join(doc["unknown"]) or "none"))


def main() -> int:
    doc = normalize(fetch(), processes())
    OUT_JSON.write_text(json.dumps(doc, indent=2, sort_keys=True) + "\n")
    OUT_HTML.write_text(page(doc))
    print("fleet available=%s sessions=%d runtimes=%s states=%s unknown=%d"
          % (doc["available"], doc["sessions"], doc["runtimes"], doc["states"], len(doc["unknown"])))
    return 0 if doc["available"] else 1


if __name__ == "__main__":
    raise SystemExit(main())
