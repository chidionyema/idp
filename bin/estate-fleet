#!/usr/bin/env python3
"""idp#7481: real-time fleet messaging with a durable, acknowledged inbox.

Root cause being fixed: a founder directive had no durable home. It lived in chat or an issue
comment and an agent saw it only if it happened to poll, so the founder had to repeat it.
Here a message is stored in JetStream (stream ESTATE_FLEET, file storage) and each agent has a
durable consumer: a message stays pending, and is redelivered, until that agent acks it.

    estate-fleet send <agent> <text>     one agent          subject estate.fleet.to.<agent>
    estate-fleet broadcast <text>        every agent        subject estate.fleet.broadcast
    estate-fleet directive <text>        every agent + growmos DECISION (survives the bus)
    estate-fleet inbox [--ack]           print my pending messages; --ack acknowledges them
    estate-fleet inbox --pipe CMD...     feed messages to CMD on stdin; ack ONLY if CMD exits 0
    estate-fleet watch                   live push of new messages
    estate-fleet refuse <seq> <reason>   record that I will not apply message <seq>
    estate-fleet status <seq>            who has acked (applied) or refused message <seq>
Envelope: {id, from, kind, text, at, channel, reply_to}. $ESTATE_FLEET_CHANNEL names the door
(console, voice, telegram, face, mcp; default console); $ESTATE_FLEET_REPLY_TO threads a reply.
Acks are records on estate.fleet.ack.<seq>.<agent>, so "who applied this" survives restarts.
Identity: $ESTATE_AGENT. Bus: $ESTATE_NATS_URL (default nats://127.0.0.1:4222).
Exit 0 ok, 1 FAIL, 2 BLIND (bus unreachable: never reported as an empty inbox).
"""
import asyncio
import json
import os
import subprocess
import sys
import time
import uuid

STREAM = "ESTATE_FLEET"
URL = os.environ.get("ESTATE_NATS_URL", "nats://127.0.0.1:4222")
ACK_WAIT = float(os.environ.get("ESTATE_FLEET_ACK_WAIT", "60"))


def me():
    a = os.environ.get("ESTATE_AGENT", "")
    if not a:
        sys.exit("FAIL    estate-fleet  no agent identity: set ESTATE_AGENT")
    return a


async def connect():
    import nats
    from nats.js.api import RetentionPolicy, StorageType

    try:
        nc = await nats.connect(URL, connect_timeout=3, max_reconnect_attempts=1)
    except Exception as e:  # unreachable bus is BLIND, never an empty inbox
        print(f"BLIND   estate-fleet  cannot reach {URL}: {type(e).__name__}")
        sys.exit(2)
    js = nc.jetstream()
    try:
        await js.add_stream(name=STREAM, subjects=["estate.fleet.>"], storage=StorageType.FILE,
                            retention=RetentionPolicy.LIMITS)
    except Exception:
        await js.stream_info(STREAM)  # already exists: fine
    return nc, js


async def publish(subject, text, kind):
    nc, js = await connect()
    body = json.dumps({
        "id": uuid.uuid4().hex, "from": me(), "kind": kind, "text": text,
        "channel": os.environ.get("ESTATE_FLEET_CHANNEL", "console"),
        "reply_to": os.environ.get("ESTATE_FLEET_REPLY_TO") or None,
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    })
    ack = await js.publish(subject, body.encode())
    await nc.close()
    print(f"ok      estate-fleet  {kind} stored seq={ack.seq} on {subject}")


def subjects(agent):
    return {"broadcast": "estate.fleet.broadcast", "directive": "estate.fleet.directive",
            "to": f"estate.fleet.to.{agent}"}


async def record_ack(js, seq, agent, outcome, note):
    body = json.dumps({"seq": seq, "by": agent, "outcome": outcome, "note": note,
                       "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())})
    await js.publish(f"estate.fleet.ack.{seq}.{agent}", body.encode())


async def refuse(seq, reason):
    nc, js = await connect()
    await record_ack(js, int(seq), me(), "refused", reason)
    await nc.close()
    print(f"ok      estate-fleet  refusal of seq={seq} recorded for {me()}")


async def status(seq):
    nc, js = await connect()
    rows = {}
    try:
        sub = await js.pull_subscribe(f"estate.fleet.ack.{int(seq)}.*", stream=STREAM)
        while True:
            try:
                msgs = await sub.fetch(100, timeout=1)
            except Exception:
                break
            for m in msgs:
                d = json.loads(m.data)
                rows[d["by"]] = d  # latest record per agent wins
                await m.ack()
    finally:
        await nc.close()
    for by, d in sorted(rows.items()):
        print(f"{d['outcome']:<8} seq={seq} by={by} at={d['at']} {d['note']}".rstrip())
    print(f"ok      estate-fleet  seq={seq}: {len(rows)} agent(s) on record")


async def inbox(ack, pipe=None):
    from nats.js.api import ConsumerConfig

    agent = me()
    nc, js = await connect()
    n = 0
    held = []
    for kind, subj in subjects(agent).items():
        sub = await js.pull_subscribe(subj, durable=f"{agent}-{kind}", stream=STREAM,
                                      config=ConsumerConfig(ack_wait=ACK_WAIT))
        try:
            msgs = await sub.fetch(100, timeout=1)
        except Exception:
            msgs = []
        for m in msgs:
            d = json.loads(m.data)
            print(f"{d['kind']:<9} seq={m.metadata.sequence.stream} from={d['from']} {d['text']}")
            n += 1
            if pipe:
                held.append((m, d))
            elif ack:
                await record_ack(js, m.metadata.sequence.stream, agent, "applied", "")
                await m.ack()
    if pipe and held:
        # A fetched message is invisible to a second inbox call until ack_wait expires, so a
        # separate "read, then ack" can ack nothing and redeliver forever. Ack only on success.
        text = "".join(f"{d['kind']} from={d['from']} {d['text']}\n" for _, d in held)
        rc = subprocess.run(pipe, input=text, text=True).returncode
        if rc:
            await nc.close()
            sys.exit(f"FAIL    estate-fleet  {pipe[0]} exited {rc}: {n} message(s) left un-acked")
        for m, _ in held:
            await record_ack(js, m.metadata.sequence.stream, agent, "applied", "")
            await m.ack()
    await nc.close()
    print(f"ok      estate-fleet  {n} pending message(s) for {agent}" + ("" if ack else " (not acked: will be redelivered)"))


async def watch():
    agent = me()
    nc, js = await connect()
    for subj in subjects(agent).values():
        async def cb(m):
            d = json.loads(m.data)
            print(f"{d['kind']} from={d['from']} {d['text']}", flush=True)
        await nc.subscribe(subj, cb=cb)
    await asyncio.sleep(10**9)


def main(argv):
    if not argv:
        sys.exit(__doc__)
    c, rest = argv[0], argv[1:]
    if c == "send" and rest and rest[0].startswith("-"):
        sys.exit(f"estate-fleet: send takes '<agent> <text>', not a flag ({rest[0]!r}); nothing was sent")
    if c == "send" and len(rest) >= 2:
        asyncio.run(publish(f"estate.fleet.to.{rest[0]}", " ".join(rest[1:]), "to"))
    elif c == "broadcast" and rest:
        asyncio.run(publish("estate.fleet.broadcast", " ".join(rest), "broadcast"))
    elif c == "directive" and rest:
        text = " ".join(rest)
        asyncio.run(publish("estate.fleet.directive", text, "directive"))
        if not os.environ.get("ESTATE_FLEET_NO_MEMORY"):
            subprocess.run(["growmos", "remember", f"directive-{int(time.time())}", "--type", "DECISION", "--desc", f"Founder directive via estate-fleet: {text}"], check=False)
    elif c == "inbox" and "--pipe" in rest:
        asyncio.run(inbox(False, rest[rest.index("--pipe") + 1 :] or sys.exit("FAIL    estate-fleet  --pipe needs a command")))
    elif c == "inbox":
        asyncio.run(inbox("--ack" in rest))
    elif c == "refuse" and len(rest) >= 2 and rest[0].isdigit():
        asyncio.run(refuse(rest[0], " ".join(rest[1:])))
    elif c == "status" and len(rest) == 1 and rest[0].isdigit():
        asyncio.run(status(rest[0]))
    elif c == "watch":
        asyncio.run(watch())
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
