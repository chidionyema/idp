#!/usr/bin/env python3
"""Count every static credential the estate still holds, on this host and in the vault.

Policy row: "No static credential anywhere; machines use workload identity, people use
hardware-rooted identity" (docs/reference/security-policy.md, kini-master-spec 4.1, 4.4).
Founder, 2026-08-25: prompts for passwords and keychain access stalled the cluster build;
"there are no static secrets anywhere in the system" is the target state.

Report mode only. Each line names a static credential and the identity that replaces it.
Exit 0 when the count is zero, 1 while any remain, 2 when a location cannot be read (BLIND).
Every path derives from HOME or the vault variable (LAW 46).

Proved both ways: STATIC_SECRET_GATE_ROOT=<dir> scans that tree instead of HOME, so
tests/fixtures/static-secret/{good,bad} exercise the empty and the populated case.
"""
import os
import pathlib
import re
import subprocess
import sys

# LAW 46: nothing here names where the checkout lives. ROOT is the home directory being audited,
# CODE the directory that holds every checkout (default: the parent of this repo), VAULT the sops vault.
ROOT = pathlib.Path(os.environ.get("STATIC_SECRET_GATE_ROOT") or pathlib.Path.home())
CODE = pathlib.Path(os.environ.get("ESTATE_CODE") or pathlib.Path(__file__).resolve().parents[2])
VAULT = pathlib.Path(os.environ.get("ESTATE_SECRETS") or CODE / "estate-secrets")
STATIC_NAME = re.compile(r"(API_KEY|PRIVATE_KEY|SECRET_KEY|ACCESS_KEY|_TOKEN|PASSWORD|FINGERPRINT)", re.I)

# (what, where it lives, the identity that replaces it)
CHECKS = [
    ("OCI API private key", ROOT / ".oci", lambda p: sorted(p.glob("*.pem")),
     "OCI Workload Identity Federation (GitHub OIDC -> UPST) for CI; OKE workload identity in-cluster"),
    ("gh OAuth token in a file", ROOT / ".config" / "gh" / "hosts.yml",
     lambda p: [p] if p.is_file() and "oauth_token" in p.read_text() else [],
     "GitHub App installation token minted per run; founder signs in with WebAuthn"),
    ("plaintext .env under the estate", CODE,
     lambda p: [f for f in p.glob("*/.env") if f.is_file()] + [f for f in p.glob("*/*/.env") if f.is_file()],
     "External Secrets Operator from OCI Vault, read by workload identity"),
]


def vault_static() -> list[pathlib.Path]:
    d = VAULT / "secrets"
    return sorted(f for f in d.rglob("*.yaml") if STATIC_NAME.search(f.stem)) if d.is_dir() else []


# crew#227, 2026-08-27: "delete once the workload identity that replaces it is green" was the one exit
# path printed for every vault entry, and it is false for a key a third party issues: no SPIFFE SVID
# or instance principal ever replaces a Stripe or OpenRouter key. Each row now names its real exit.
# The count does not change; the plan next to each row does.
VAULT_EXITS = (
    (re.compile(r"^(GH_TOKEN|GITHUB_TOKEN|GITHUB_MCP_TOKEN)$"),
     "GitHub App installation token minted per run (vault-seed entry github-app); then delete this file"),
    (re.compile(r"^OCI_S3_"),
     "instance principal on the node pool (platform/oci/vault.tf dynamic group); then delete this file"),
    (re.compile(r"^(LITELLM_API_KEY|STORE_INTERNAL_API_KEY|PROSPECTOR_ENTITLEMENTS_API_KEY|CONTROL_CENTER_PASSWORD)$"),
     "service-to-service SPIFFE SVID (platform/spire); then delete this file"),
)
THIRD_PARTY_EXIT = ("third-party issued, no identity replaces it: seed OCI Vault (gh workflow run "
                    "vault-seed.yml), serve it by ExternalSecret, then delete this file")


def vault_exit(stem: str) -> str:
    for pat, exit_path in VAULT_EXITS:
        if pat.search(stem):
            return exit_path
    return THIRD_PARTY_EXIT


def keychain_entries() -> list[str] | None:
    if os.environ.get("STATIC_SECRET_GATE_ROOT"):
        return []  # fixture run: the keychain is the host's, not the fixture's
    try:
        out = subprocess.run(["security", "dump-keychain"], capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return None
    return sorted({m for m in re.findall(r'"svce"<blob>="([^"]*(?:gh:|github|docker|oci|sops)[^"]*)"', out, re.I)})


def main() -> int:
    findings, blind = [], []
    for what, where, find, replacement in CHECKS:
        try:
            for f in find(where):
                findings.append((what, str(f), replacement))
        except OSError as e:
            blind.append(f"{what}: {where}: {e}")
    for f in vault_static():
        findings.append(("static credential in the vault", str(f.relative_to(VAULT)), vault_exit(f.stem)))
    kc = keychain_entries()
    if kc is None:
        blind.append("keychain: `security dump-keychain` failed")
    else:
        findings += [("keychain item used by automation", k, "no automation reads the keychain") for k in kc]
    for what, where, replacement in findings:
        print(f"static  {what:36} {where}\n        -> {replacement}")
    for b in blind:
        print(f"BLIND   {b}")
    verdict = "BLIND" if blind else ("ok" if not findings else "FAIL")
    print(f"{verdict}    static-secret-gate: {len(findings)} static credential(s) remain; target 0 (crew#227)")
    return 2 if blind else (0 if not findings else 1)


if __name__ == "__main__":
    sys.exit(main())
