#!/usr/bin/env python3
"""The reference decision matrix, enforced (ADR 0009, crew#562).

Founder, 2026-08-28 (crew#562 5458078376), verbatim: "i like the natri, enforce it" / "rigorously,
cant be cheated" / "need evidence" / "and we eed to rview weekly". This is the protocol behind
those four sentences (LAW 44: a law without a protocol is a wish).

  matrix-gate                    grade docs/decisions/decision-matrix.yaml; exit 1 on any refusal
  matrix-gate --slugs            print the decided slugs as a JSON list (bin/pr-report feeds the rego)
  matrix-gate --review           the weekly review: every evidence URL must still answer, every
                                 decision past next_review is listed; exit 1 when either is wrong
  matrix-gate --verify-receipts  every receipt resolves, through the GitHub API, to a comment on
                                 the crew or idp repository written by the repository owner's login

What "cannot be cheated" means here, mechanically:
  1. A score is a mapping {score, evidence}. A bare number is refused. Evidence is a URL, a path
     that exists in this repository, or `cmd: <command>`; a sentence is refused.
  2. The weights are locked to a founder receipt: weights_history's last entry carries the sha256
     of the weights as they stand. Change a weight without a new entry and the gate refuses; a new
     entry needs a receipt, and --verify-receipts checks the receipt is the founder's comment.
  3. The recorded decision must be the arithmetic top score. Inside tie_band a `tie_receipt`
     (the founder's word) is required; outside it a tie_receipt is not enough to pick the loser.
  4. A decided entry carries a receipt and a next_review date; --review lists what is overdue.
  5. Every candidate scores every criterion; a criterion the matrix does not hold is refused, so a
     new founder question becomes a weighted criterion (with his receipt) before it can be scored.

Honest limit, written down so a buyer's engineer reads it here first: sessions post to GitHub with
the founder's own token, so "author is the repository owner" proves the comment came through his
account, not that he typed it. The receipt therefore must quote him verbatim, LAW 49 gives him a
60-minute veto on every STAGED change, and the weekly review puts every receipt in front of him.

Exit 0 ok, 1 FAIL, 2 BLIND (matrix unreadable, or the API unreachable for --verify-receipts).
"""
import datetime as dt
import hashlib
import json
import os
import re
import subprocess
import sys
import urllib.request

import yaml

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MATRIX = os.environ.get("MATRIX_FILE", os.path.join(ROOT, "docs", "decisions", "decision-matrix.yaml"))
RECEIPT_RE = re.compile(r"^https://github\.com/([\w.-]+)/([\w.-]+)/(?:issues|pull)/\d+#issuecomment-(\d+)$")


def weights_sha(weights):
    return hashlib.sha256(json.dumps(weights, sort_keys=True).encode()).hexdigest()


def score(weights, scores):
    return sum(weights[k] * scores[k]["score"] for k in weights)


def evidence_ok(ev):
    if not isinstance(ev, str) or not ev.strip():
        return False
    if ev.startswith("https://"):
        return " " not in ev
    if ev.startswith("cmd: "):
        return len(ev) > 5
    return os.path.exists(os.path.join(ROOT, ev)) and not os.path.isabs(ev)


def grade(m, today=None):
    """Return the list of refusals for a parsed matrix; empty means it stands."""
    today = today or dt.date.today()
    fails = []
    w = m.get("weights") or {}
    if not w or any(not isinstance(v, int) or v < 0 for v in w.values()):
        return ["weights: missing or not non-negative integers"]
    if sum(w.values()) != 100:
        fails.append(f"weights: sum is {sum(w.values())}, must be 100")
    band = m.get("tie_band")
    if not isinstance(band, int) or not 0 < band < 50:
        fails.append(f"tie_band: {band!r} is not an integer in (0, 50)")
    hist = m.get("weights_history") or []
    if not hist:
        fails.append("weights_history: empty; the weights are the founder's input and carry his receipt")
    else:
        last = hist[-1]
        if not RECEIPT_RE.match(str(last.get("receipt", ""))):
            fails.append("weights_history: last entry's receipt is not a GitHub issue-comment URL")
        if last.get("sha256") != weights_sha(w):
            fails.append(f"weights_history: weights changed without a new founder-receipted entry (sha256 now {weights_sha(w)[:12]}…)")
    seen = set()
    for d in m.get("decisions") or []:
        slug = d.get("slug", "?")
        if slug in seen:
            fails.append(f"{slug}: duplicate slug")
        seen.add(slug)
        cands = d.get("candidates") or {}
        if len(cands) < 2:
            fails.append(f"{slug}: fewer than two candidates is not a decision")
        totals = {}
        for name, c in cands.items():
            sc = (c or {}).get("scores") or {}
            if set(sc) != set(w):
                fails.append(f"{slug}/{name}: scores {sorted(set(sc) ^ set(w))} do not match the criteria; a new criterion is a weighted row with the founder's receipt, not a cell")
                continue
            bad = False
            for k, cell in sc.items():
                if not isinstance(cell, dict) or not isinstance(cell.get("score"), int) or not 0 <= cell["score"] <= 5:
                    fails.append(f"{slug}/{name}/{k}: a score is {{score: 0-5, evidence: …}}, got {cell!r}")
                    bad = True
                elif not evidence_ok(cell.get("evidence")):
                    fails.append(f"{slug}/{name}/{k}: evidence must be a URL, a repo path that exists, or `cmd: …`; got {cell.get('evidence')!r}")
                    bad = True
            if not bad:
                totals[name] = score(w, sc)
        if len(totals) != len(cands):
            continue
        ranked = sorted(totals.items(), key=lambda kv: -kv[1])
        top, runner = ranked[0], ranked[1]
        chosen = d.get("decision")
        if chosen not in totals:
            fails.append(f"{slug}: decision {chosen!r} is not a candidate")
            continue
        # The top score is built. Inside tie_band of the top, any candidate may be chosen, but only
        # on the founder's word (tie_receipt). Outside the band no receipt can pick a loser.
        tie = top[1] - runner[1] <= band
        gap = top[1] - totals[chosen]
        if gap > band:
            fails.append(f"{slug}: decision {chosen} scores {totals[chosen]}, top is {top[0]} at {top[1]}, gap {gap} > tie_band {band}; the matrix builds the top score")
        elif tie and not RECEIPT_RE.match(str(d.get("tie_receipt", ""))):
            fails.append(f"{slug}: {top[0]} {top[1]} vs {runner[0]} {runner[1]} is inside tie_band {band}; the founder decides and tie_receipt carries his word")
        if not tie and d.get("tie_receipt"):
            fails.append(f"{slug}: tie_receipt given but the gap {top[1] - runner[1]} is outside tie_band {band}; a receipt cannot pick a loser")
        status = d.get("status")
        if status not in ("decided", "proposed"):
            fails.append(f"{slug}: status must be decided or proposed")
        if status == "decided" and not RECEIPT_RE.match(str(d.get("receipt", ""))):
            fails.append(f"{slug}: decided without a receipt URL")
        nr = d.get("next_review")
        if not isinstance(nr, dt.date):
            fails.append(f"{slug}: next_review must be a date")
        for r in d.get("reviews") or []:
            if not RECEIPT_RE.match(str(r.get("receipt", ""))) or not isinstance(r.get("date"), dt.date):
                fails.append(f"{slug}: every review is {{date, receipt}}")
    return fails


def overdue(m, today=None):
    today = today or dt.date.today()
    return [d["slug"] for d in m.get("decisions") or [] if isinstance(d.get("next_review"), dt.date) and d["next_review"] < today]


def urls(m):
    out = set()
    for d in m.get("decisions") or []:
        for c in (d.get("candidates") or {}).values():
            for cell in ((c or {}).get("scores") or {}).values():
                ev = (cell or {}).get("evidence", "")
                if isinstance(ev, str) and ev.startswith("https://"):
                    out.add(ev)
    return sorted(out)


def url_alive(u, timeout=15):
    req = urllib.request.Request(u, method="GET", headers={"User-Agent": "idp-matrix-gate"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return r.status < 400
    except Exception:  # noqa: BLE001
        return False


def receipts(m):
    out = []
    for h in m.get("weights_history") or []:
        out.append(("weights", h.get("receipt")))
    for d in m.get("decisions") or []:
        for k in ("receipt", "tie_receipt"):
            if d.get(k):
                out.append((f"{d['slug']}.{k}", d[k]))
        for r in d.get("reviews") or []:
            out.append((f"{d['slug']}.review", r.get("receipt")))
    return out


def verify_receipt(url):
    mm = RECEIPT_RE.match(str(url))
    if not mm:
        return False, "not an issue-comment URL"
    owner, repo, cid = mm.groups()
    r = subprocess.run(["gh", "api", f"repos/{owner}/{repo}/issues/comments/{cid}", "-q", '.user.login + " " + (.body|length|tostring)'],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None, (r.stderr.strip().splitlines() or ["gh api failed"])[-1]
    login, n = r.stdout.split()
    return (login == owner and int(n) > 0), f"author {login}, {n} chars"


def main(argv):
    try:
        with open(MATRIX, encoding="utf-8") as fh:
            m = yaml.safe_load(fh)
    except Exception as e:  # noqa: BLE001
        print(f"BLIND matrix unreadable: {e}")
        return 2
    if "--slugs" in argv:
        print(json.dumps([d["slug"] for d in m.get("decisions") or [] if d.get("status") in ("decided", "proposed")]))
        return 0
    fails = grade(m)
    for f in fails:
        print(f"FAIL  matrix-gate: {f}")
    rc = 1 if fails else 0
    if "--review" in argv:
        for u in urls(m):
            ok = url_alive(u)
            print(f"{'ok   ' if ok else 'FAIL '} evidence {u}")
            rc = rc or (0 if ok else 1)
        due = overdue(m)
        for s in due:
            print(f"FAIL  review overdue: {s}")
        rc = rc or (1 if due else 0)
        for d in m.get("decisions") or []:
            print(f"      {d['slug']}: {d.get('status')} {d.get('decision')} next_review {d.get('next_review')} reviews {len(d.get('reviews') or [])}")
    if "--verify-receipts" in argv:
        for label, u in receipts(m):
            ok, why = verify_receipt(u)
            if ok is None:
                print(f"BLIND receipt {label} {u}: {why}")
                return 2
            print(f"{'ok   ' if ok else 'FAIL '} receipt {label} {why}")
            rc = rc or (0 if ok else 1)
    print("PASS  matrix-gate" if rc == 0 else "FAIL  matrix-gate")
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
