#!/usr/bin/env bash
# estate-security-rollout [--apply] [--merge]: every repository pushed in the
# last ACTIVE_DAYS (30) days carries .github/workflows/security-scan.yml, the
# caller for the two idp composite actions (security-scan, spec-gate). Report
# mode by default. --apply opens one pull request per repository that lacks
# the file or carries a different one; --merge squash-merges those pull
# requests whose checks are green. After that, `repo-rulesets --apply` makes
# both checks required (platform/github/ruleset.@active.security-scan.json).
#
# The mature tool for fleet-wide file sync is a GitHub App such as
# repo-file-sync-action; it needs an App or PAT with contents:write on every
# repo and a workflow in each target, which is the very thing being installed
# here. The gh CLI already holds that permission on this account.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
OWNER="${ESTATE_GH_OWNER:-$(gh api /user -q .login)}"
SRC="$IDP/platform/github/workflows/security-scan.yml"
DEST=".github/workflows/security-scan.yml"
BRANCH="estate/security-scan"
ACTIVE_DAYS="${ACTIVE_DAYS:-30}"
apply=0; merge=0
for a in "$@"; do case "$a" in --apply) apply=1 ;; --merge) merge=1 ;; *) echo "usage: estate-security-rollout [--apply] [--merge]" >&2; exit 3 ;; esac; done
since="$(date -u -v-"${ACTIVE_DAYS}"d +%Y-%m-%d 2>/dev/null || date -u -d "-${ACTIVE_DAYS} days" +%Y-%m-%d)"
want="$(base64 < "$SRC" | tr -d '\n')"
ok=0; todo=0; opened=0; merged=0; blocked=0
while read -r repo pushed; do
  [ "$pushed" \> "$since" ] || continue
  [ "$repo" = "idp" ] && { echo "ok      idp: runs the actions from ./.github/actions in ci.yml"; ok=$((ok+1)); continue; }
  default="$(gh api "/repos/$OWNER/$repo" -q .default_branch 2>/dev/null)" || { echo "BLOCKED $repo: cannot read repository"; blocked=$((blocked+1)); continue; }
  have="$(gh api "/repos/$OWNER/$repo/contents/$DEST?ref=$default" -q .content 2>/dev/null | tr -d '\n')"
  if [ "$have" = "$want" ]; then echo "ok      $repo: $DEST in place on $default"; ok=$((ok+1)); continue; fi
  pr="$(gh pr list --repo "$OWNER/$repo" --head "$BRANCH" --state open --json number,url -q '.[0] | "\(.number) \(.url)"' 2>/dev/null)"
  if [ -n "$pr" ] && [ "${pr% *}" != "null" ]; then
    if [ $merge = 1 ]; then
      if gh pr checks "${pr% *}" --repo "$OWNER/$repo" >/dev/null 2>&1 && gh pr merge "${pr% *}" --repo "$OWNER/$repo" --squash --delete-branch >/dev/null 2>&1; then
        echo "MERGED  $repo: ${pr#* }"; merged=$((merged+1)); continue
      fi
      echo "OPEN    $repo: ${pr#* } (checks not green, not merged)"; todo=$((todo+1)); continue
    fi
    echo "OPEN    $repo: ${pr#* }"; todo=$((todo+1)); continue
  fi
  if [ $apply = 0 ]; then echo "MISSING $repo: no $DEST on $default"; todo=$((todo+1)); continue; fi
  sha="$(gh api "/repos/$OWNER/$repo/git/ref/heads/$default" -q .object.sha)"
  gh api -X POST "/repos/$OWNER/$repo/git/refs" -f ref="refs/heads/$BRANCH" -f sha="$sha" >/dev/null 2>&1 || true
  existing="$(gh api "/repos/$OWNER/$repo/contents/$DEST?ref=$BRANCH" -q .sha 2>/dev/null || true)"
  args=(-f message="ci: estate security-scan and spec-gate (chidionyema/idp actions)" -f content="$want" -f branch="$BRANCH")
  [ -n "$existing" ] && args+=(-f sha="$existing")
  gh api -X PUT "/repos/$OWNER/$repo/contents/$DEST" "${args[@]}" >/dev/null || { echo "BLOCKED $repo: could not write $DEST on $BRANCH"; blocked=$((blocked+1)); continue; }
  url="$(gh pr create --repo "$OWNER/$repo" --base "$default" --head "$BRANCH" \
    --title "ci: estate security-scan and spec-gate" \
    --body "$(printf 'Installs the two estate gates as one job each, calling the composite actions in chidionyema/idp: security-scan (gitleaks over history, pip-audit, npm audit, policy gate) and spec-gate (a code change must carry a *.feature, test or diagram-generator change; founder ruling R29, 2026-08-25). Opened by bin/estate-security-rollout from idp; tracked on crew#236 and crew#229.\n\nAuthor-session: estate-security-rollout\nNo-Issue: fleet rollout tracked on crew#236')" 2>&1 | tail -1)"
  echo "OPENED  $repo: $url"; opened=$((opened+1))
done < <(gh repo list "$OWNER" --limit 200 --no-archived --json name,pushedAt -q '.[] | .name+" "+.pushedAt[:10]' | sort)
echo "$([ $todo = 0 ] && [ $blocked = 0 ] && echo 'ok  ' || echo FAIL)  rollout $ok in place, $opened opened, $merged merged, $todo open or missing, $blocked blocked"
[ $todo = 0 ] && [ $blocked = 0 ]
