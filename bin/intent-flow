#!/usr/bin/env python3
"""intent-flow: judge the vision-to-done state machine in catalog/intent-flow.json.

  intent-flow check          exit 0 if the machine is sound, 2 and the reasons if not
  intent-flow path FROM TO   shortest path of states, one gate per hop
  intent-flow outcome FILE --id=ID --result=landed|operating|failed|breach --graded-by=WHO
  intent-flow report FILE    outcome by choice: per layer and picked/chosen, BLIND until enough graded
  intent-flow drift FILE     compare older vs newer sessions: STABLE, CHANGED or BLIND (too few to say)
  intent-flow session [--has-sealed-order] [--retire-target --target-in-register] [--unproved-claim] [--claim-open]
                      [--choose=LAYER --chosen-by=WHO]   pick (or choose) this session's primary layer
"""
from __future__ import annotations

import hashlib
import json
import sys
from collections import deque
from pathlib import Path

CAT = Path(__file__).resolve().parents[1] / "catalog" / "intent-flow.json"


def load(path=CAT):
    return json.loads(Path(path).read_text(encoding="utf-8"))


def problems(m):
    s, e = m["states"], m["edges"]
    out = []
    for x in e:
        for k in ("from", "to"):
            if x[k] not in s:
                out.append("edge names unknown state %r" % x[k])
        if x.get("decider") not in ("machine", "model", "judgment") or not x.get("gate"):
            out.append("edge %s->%s needs a gate and a decider" % (x["from"], x["to"]))
    if out:
        return out
    adj = {k: [] for k in s}
    for x in e:
        adj[x["from"]].append(x["to"])
    seen, q = {m["start"]}, deque([m["start"]])
    while q:
        for n in adj[q.popleft()]:
            if n not in seen:
                seen.add(n)
                q.append(n)
    out += ["unreachable from start: %s" % k for k in s if k not in seen]
    for k, v in s.items():
        if not v.get("terminal") and not adj[k]:
            out.append("dead end (not terminal): %s" % k)
    # done only through the operating proof, never straight from merge
    into_done = [x["from"] for x in e if x["to"] == m["done"]]
    if into_done != ["closed"] or [x["from"] for x in e if x["to"] == "closed"] != ["operating"]:
        out.append("done must be reachable only via operating then closed")
    if any(x["from"] == "landed" and x["to"] in ("closed", m["done"]) for x in e):
        out.append("landed must not skip the operating proof")
    # a legion state never decides: every edge out of a legion state is machine-decided
    for x in e:
        if s[x["from"]]["class"] == "legion" and x["decider"] != "machine":
            out.append("legion edge %s->%s must be machine-decided" % (x["from"], x["to"]))
    # every non-terminal state before landing has a failure or escalation path back or out
    for k in ("running", "lane"):
        if not any(x["from"] == k and x["to"] in ("ordered", "escalated") for x in e):
            out.append("%s has no failure path" % k)
    fb = m.get("feedback", {})
    causes = fb.get("causes", {})
    if not fb.get("reissue_budget"):
        out.append("feedback needs a reissue_budget")
    for ek, cs in fb.get("edge_causes", {}).items():
        a, b = ek.split("->")
        if not any(x["from"] == a and x["to"] == b for x in e):
            out.append("feedback names an edge that does not exist: %s" % ek)
        for c in cs:
            if c not in causes:
                out.append("cause %r on %s has no correction" % (c, ek))
    for x in e:
        if x["to"] == "ordered" and x["from"] != "queued" and "%s->ordered" % x["from"] not in fb.get("edge_causes", {}):
            out.append("failure edge %s->ordered has no cause classes" % x["from"])
    for c, v in causes.items():
        if not (v.get("level") in fb.get("levels", []) and v.get("correction") and v.get("record")):
            out.append("cause %r needs a level, a correction and a record" % c)
    if not any(x["from"] == "running" and x["to"] == "escalated" for x in e):
        out.append("a spent reissue budget must escalate")
    ch = m.get("chain", {})
    roles = ch.get("roles", {})
    roots = [k for k, v in roles.items() if v.get("parent") is None]
    if roots != ["founder"]:
        out.append("the chain must have exactly one root, the founder")
    for k, v in roles.items():
        seen_up, cur = set(), k
        while cur is not None and cur not in seen_up:
            seen_up.add(cur)
            cur = roles.get(cur, {}).get("parent") if cur in roles else None
        if cur is not None or "founder" not in seen_up:
            out.append("role %s does not reach the founder without a cycle" % k)
    for k, v in ch.get("routing", {}).items():
        if k not in roles:
            out.append("routing names unknown role %s" % k)
        tgt = v.get("reports_to") or v.get("escalates_to")
        if tgt and roles.get(k, {}).get("parent") != tgt:
            out.append("%s reports to %s, which is not its parent" % (k, tgt))
    lr = ch.get("routing", {}).get("legion-runner", {})
    if "decide" not in lr.get("may_not", []) or "issue an order" not in lr.get("may_not", []):
        out.append("legion must be forbidden to decide and to issue orders")
    if any(r["class"] == "legion" and any(c["parent"] == k for c in roles.values()) for k, r in roles.items()):
        out.append("a legion role must be a leaf: it commands nobody")
    rk = m.get("ranks", {})
    order = rk.get("order", [])
    rdef = rk.get("ranks", {})
    if order and sorted(order) != sorted(rdef):
        out.append("rank order and rank table disagree")
    forbidden = rk.get("forbidden_to_every_rank", [])
    prev = set()
    for name in order:
        paths = set(rdef.get(name, {}).get("paths", []))
        if name != "shadow" and not rdef[name].get("push_lane"):
            out.append("rank %s must be able to push a lane" % name)
        if name == "shadow" and (paths or rdef[name].get("push_lane")):
            out.append("shadow must have no paths and no push")
        for f in forbidden:
            if f in paths:
                out.append("rank %s is granted forbidden path %s" % (name, f))
        if rdef.get(name, {}).get("always_held") is not True and name == order[-1]:
            out.append("the top legion rank must be always_held (founder door)")
        if not (prev <= paths) and name != "duke":
            out.append("rank %s must include the paths of the rank below" % name)
        prev = paths if name != "duke" else prev
    if rk:
        if rk.get("commanded_by") not in roles:
            out.append("ranks are commanded by an unknown role")
        if "never" not in rk.get("promotion", {}) or "grade" not in rk.get("promotion", {}).get("evidence", ""):
            out.append("promotion must forbid self-grading and name an outside grader")
        if "shadow" not in rk.get("demotion", {}).get("rule", ""):
            out.append("a seal breach must demote to shadow")
    dna = m.get("dna", {})
    if dna:
        layers = dna.get("layers", {})
        if sorted(layers) != ["assassin", "mathematician", "soldier", "surgeon"]:
            out.append("the quad layer must be exactly soldier, mathematician, surgeon, assassin")
        if sorted(dna.get("order_of_application", [])) != sorted(layers):
            out.append("order_of_application must name every layer once")
        root = CAT.parent.parent
        for name, v in layers.items():
            if not (v.get("duty") and v.get("prevents") and v.get("gate")):
                out.append("layer %s needs a duty, a failure it prevents and a gate" % name)
            eb = v.get("enforced_by") or []
            if not eb:
                out.append("layer %s has no enforcing piece (a wish)" % name)
            for pth in eb:
                if not (root / pth).exists():
                    out.append("layer %s names %s, which does not exist" % (name, pth))
    return out


def path(m, a, b):
    adj = {}
    for x in m["edges"]:
        adj.setdefault(x["from"], []).append(x)
    prev, q = {a: None}, deque([a])
    while q:
        c = q.popleft()
        if c == b:
            break
        for x in adj.get(c, []):
            if x["to"] not in prev:
                prev[x["to"]] = x
                q.append(x["to"])
    if b not in prev:
        return None
    hops, c = [], b
    while prev[c]:
        hops.append(prev[c]); c = prev[c]["from"]
    return hops[::-1]


def pick(m, sig, choose=None):
    """One primary layer for a session: by rule from the signals, or an explicit choice that must be allowed."""
    sel = m["dna"]["selection"]
    ok = {
        "soldier": bool(sig.get("has_sealed_order")),
        "assassin": bool(sig.get("retire_target") and sig.get("target_in_register")),
        "mathematician": bool(sig.get("unproved_claim") or sig.get("new_invariant") or sig.get("no_falsifier")),
        "surgeon": bool(sig.get("claim_open")),
    }
    by_rule = next((n for n in sel["priority"] if ok[n]), None)
    if choose:
        if choose not in ok:
            return dict(layer=None, how="refused", why="unknown layer %r" % choose)
        if not ok[choose]:
            return dict(layer=None, how="refused", why="precondition for %s not met: %s" % (choose, next(r["precondition"] for r in sel["rules"] if r["layer"] == choose)))
        return dict(layer=choose, how="chosen", by_rule=by_rule, chosen_by=sig.get("chosen_by", "unrecorded"))
    if by_rule is None:
        return dict(layer=None, how="refused", why="no layer applies: open a claim first (surgeon), or supply a sealed order")
    return dict(layer=by_rule, how="picked")


def record(path, agent, r, sig, now=None):
    """Append one session decision. Append-only; one line per session; never rewritten."""
    import datetime
    now = now or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    line = dict(type="session", id=hashlib.sha256(("%s|%s|%s" % (now, agent, r.get("layer"))).encode()).hexdigest()[:12], at=now, agent=agent, layer=r.get("layer"), how=r["how"], by_rule=r.get("by_rule"), why=r.get("why"), signals=sorted(k for k, v in sig.items() if v is True))
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(line, sort_keys=True) + "\n")
    return line


RESULTS = ("landed", "operating", "failed", "breach")


def outcome(path, sid, result, graded_by, now=None):
    """Append a grade for one session. The grader must not be the agent that ran it."""
    import datetime
    rows = [json.loads(ln) for ln in Path(path).read_text(encoding="utf-8").splitlines() if ln.strip()]
    sess = next((r for r in rows if r.get("type") == "session" and r["id"] == sid), None)
    if sess is None:
        raise ValueError("no session %s" % sid)
    if result not in RESULTS:
        raise ValueError("result must be one of %s" % (RESULTS,))
    if graded_by == sess["agent"]:
        raise ValueError("an agent never grades its own session")
    now = now or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(dict(type="outcome", id=sid, at=now, result=result, graded_by=graded_by), sort_keys=True) + "\n")


def report(rows, min_n=10):
    """Outcome by choice: per (layer, picked or chosen) how often did it reach operating, and how often breach.

    Ungraded sessions are counted and shown, never assumed good. Under min_n graded: BLIND."""
    sess = {r["id"]: r for r in rows if r.get("type") == "session"}
    graded = {r["id"]: r["result"] for r in rows if r.get("type") == "outcome" and r["id"] in sess}
    cells = {}
    for sid, s in sess.items():
        key = "%s/%s" % (s.get("layer") or "refused", s["how"])
        c = cells.setdefault(key, dict(n=0, graded=0, good=0, bad=0, overrides=0))
        c["n"] += 1
        if s["how"] == "chosen" and s.get("by_rule") not in (None, s.get("layer")):
            c["overrides"] += 1
        res = graded.get(sid)
        if res:
            c["graded"] += 1
            c["good"] += res in ("landed", "operating")
            c["bad"] += res in ("failed", "breach")
    for c in cells.values():
        c["verdict"] = "BLIND" if c["graded"] < min_n else ("%.2f good" % (c["good"] / c["graded"]))
    return dict(sessions=len(sess), graded=len(graded), ungraded=len(sess) - len(graded), cells=cells)


def drift(rows, min_n=20, threshold=0.25):
    """Compare the older half of the sessions with the newer half.

    Total variation distance over (layer or refusal) per half. Fewer than min_n rows in either half is BLIND,
    never 'no change': an unmeasurable thing is unknown (J4). min_n and threshold are proposed, unmeasured."""
    rows = [r for r in rows if r.get("type", "session") == "session"]
    if len(rows) < 2 * min_n:
        return dict(verdict="BLIND", why="need %d sessions, have %d" % (2 * min_n, len(rows)))
    half = len(rows) // 2
    old, new = rows[:half], rows[half:]

    def dist(rs):
        c = {}
        for r in rs:
            k = r.get("layer") or "refused"
            c[k] = c.get(k, 0) + 1
        return {k: v / len(rs) for k, v in c.items()}

    a, b = dist(old), dist(new)
    tvd = sum(abs(a.get(k, 0) - b.get(k, 0)) for k in set(a) | set(b)) / 2
    moved = sorted(((k, round(b.get(k, 0) - a.get(k, 0), 3)) for k in set(a) | set(b)), key=lambda x: -abs(x[1]))
    by_agent = {}
    for r in new:
        by_agent.setdefault(r.get("agent"), []).append(r.get("layer") or "refused")
    return dict(verdict="CHANGED" if tvd > threshold else "STABLE", tvd=round(tvd, 3), threshold=threshold, moved=moved[:4], old_n=len(old), new_n=len(new))


def main(argv):
    m = load()
    if len(argv) >= 2 and argv[1] == "check":
        p = problems(m)
        print(json.dumps({"sound": not p, "problems": p}, indent=2))
        return 2 if p else 0
    if len(argv) == 4 and argv[1] == "path":
        h = path(m, argv[2], argv[3])
        if h is None:
            print("no path"); return 2
        for x in h:
            print("%-10s -> %-10s [%s] %s" % (x["from"], x["to"], x["decider"], x["gate"]))
        return 0
    if len(argv) >= 2 and argv[1] == "session":
        sig, choose = {}, None
        for a in argv[2:]:
            if a.startswith("--choose="):
                choose = a.split("=", 1)[1]
            elif a.startswith(("--record=", "--agent=")):
                continue
            elif a.startswith("--chosen-by="):
                sig["chosen_by"] = a.split("=", 1)[1]
            elif a.startswith("--"):
                sig[a[2:].replace("-", "_")] = True
        r = pick(m, sig, choose)
        rec = next((a.split("=", 1)[1] for a in argv[2:] if a.startswith("--record=")), None)
        agent = next((a.split("=", 1)[1] for a in argv[2:] if a.startswith("--agent=")), None)
        sig.pop("record", None); sig.pop("agent", None)
        if rec:
            if not agent:
                sys.stderr.write("intent-flow: --record needs --agent=NAME (every agent decides, by name)\n")
                return 1
            record(rec, agent, r, sig)
        if r["layer"]:
            r["layer_spec"] = m["dna"]["layers"][r["layer"]]
            r["then_check_in_order"] = [x for x in m["dna"]["order_of_application"] if x != r["layer"]]
        print(json.dumps(r, indent=2))
        return 0 if r["layer"] else 2
    if len(argv) >= 3 and argv[1] == "report":
        rows = [json.loads(ln) for ln in Path(argv[2]).read_text(encoding="utf-8").splitlines() if ln.strip()]
        print(json.dumps(report(rows), indent=2))
        return 0
    if len(argv) >= 6 and argv[1] == "outcome":
        kw = dict(a[2:].split("=", 1) for a in argv[3:] if a.startswith("--") and "=" in a)
        try:
            outcome(argv[2], kw["id"], kw["result"], kw["graded-by"])
        except (KeyError, ValueError, OSError) as e:
            sys.stderr.write("intent-flow: %s\n" % e)
            return 1
        return 0
    if len(argv) >= 3 and argv[1] == "drift":
        rows = [json.loads(ln) for ln in Path(argv[2]).read_text(encoding="utf-8").splitlines() if ln.strip()]
        r = drift(rows)
        print(json.dumps(r, indent=2))
        return {"STABLE": 0, "CHANGED": 4, "BLIND": 3}[r["verdict"]]
    sys.stderr.write(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
