#!/usr/bin/env bash
# Put the estate cluster on the founder's phone, with nothing to type.
#
# Writes a kubeconfig that points at this Mac's tailnet address (see
# bin/idp-kubeapi-mac) and sends it to a phone over Taildrop -- the "send file
# to device" button he already found in the Tailscale app. The file carries no
# token, no certificate and no password: it is a URL only, and the tailnet
# policy is what grants access to it.
#
# Usage: bin/idp-phone-kubeconfig [device]
#        device defaults to the tailnet's only iOS peer.
set -euo pipefail

trap 'echo "FAIL  phone-kubeconfig  exit $? at line $LINENO" >&2' ERR

die() {
	printf 'BLIND   phone-kubeconfig  %s\n' "$1" >&2
	exit 2
}

TS="$(command -v tailscale || true)"
[ -n "$TS" ] || TS="/Applications/Tailscale.app/Contents/MacOS/Tailscale"
[ -x "$TS" ] || die "no tailscale command on this Mac"

ADDR="$("$TS" ip -4 2>/dev/null | head -1 || true)"
[ -n "$ADDR" ] || die "this Mac has no tailnet address; open Tailscale and sign in"

PORT="${IDP_KUBEAPI_PORT:-8001}"
DEVICE="${1:-}"
if [ -z "$DEVICE" ]; then
	DEVICE="$("$TS" status --json |
		python3 -c 'import json,sys;p=json.load(sys.stdin)["Peer"];print(next((v["DNSName"].rstrip(".") for v in p.values() if v.get("OS")=="iOS"),""))')"
fi
[ -n "$DEVICE" ] || die "no iOS device on this tailnet; sign in to Tailscale on the phone first"

OUT="${IDP_PHONE_KUBECONFIG:-$HOME/Desktop/estate-cluster.yaml}"
cat >"$OUT" <<EOF
apiVersion: v1
kind: Config
current-context: estate
clusters:
  - name: estate
    cluster:
      server: http://${ADDR}:${PORT}
contexts:
  - name: estate
    context:
      cluster: estate
      user: tailnet
users:
  - name: tailnet
    user: {}
EOF

printf 'ok      phone-kubeconfig  wrote %s  (server http://%s:%s)\n' "$OUT" "$ADDR" "$PORT"

# Taildrop only works between devices owned by the same person. This Mac is a
# tagged node (tag:founder-mac), and a tagged node has no owner, so Tailscale
# refuses: "peer is owned by a different user". That is by design and not worth
# untagging the Mac for -- the tag is what the ACL grants on. AirDrop the file
# from the Desktop instead; the phone opens it straight into the app.
if "$TS" file cp "$OUT" "${DEVICE}:" 2>/dev/null; then
	printf 'ok      phone-kubeconfig  sent to %s over Taildrop\n' "$DEVICE"
else
	printf 'note    phone-kubeconfig  Taildrop cannot send from a tagged Mac to %s; AirDrop %s instead\n' "$DEVICE" "$OUT"
fi
