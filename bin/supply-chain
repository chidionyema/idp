#!/usr/bin/env bash
# What is inside what we ship, and are we allowed to sell it.
#
# Two questions a buyer asks on day one, answered by command rather than by
# somebody remembering:
#
#   1. What are the parts?          syft  -> an SBOM in SPDX and CycloneDX
#   2. Which parts are vulnerable?  grype -> a vulnerability report
#   3. What may we sell?            opa   -> a licence policy over the SBOM
#
# The third one is the interesting choice. The obvious tool is the OSS Review
# Toolkit, which is Linux Foundation governed and does far more than this. It
# also needs a JVM and a ~2GB image, and this machine is a laptop already
# running Docker. syft already extracts per-package licence metadata, and OPA
# is already installed and already enforcing the risk register, so the licence
# question gets answered with two tools that are here rather than one that is
# not. ORT stays the upgrade path if the answer ever needs to be richer --
# curations, attribution documents, source scanning. See docs/onboarding.
#
#   supply-chain            write reports to reports/
#   supply-chain --quiet    same, no per-step chatter
#
# Reports are gitignored: they are generated, and a committed copy is a stale
# copy that reads as a record (LAW 24 excludes generated output).
set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$IDP/reports"
TARGET="$IDP/backstage/node_modules"
quiet=0
[ "${1:-}" = "--quiet" ] && quiet=1

log() { [ "$quiet" -eq 1 ] || printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

for t in syft grype conftest cyclonedx sbomqs; do
  command -v "$t" >/dev/null || { echo "$t is not installed -- brew install $t"; exit 2; }
done
[ -d "$TARGET" ] || { echo "no $TARGET -- the parts list needs an installed tree"; exit 2; }

mkdir -p "$OUT"

# --- 1. the parts list --------------------------------------------------------
# node_modules rather than yarn.lock on purpose. Measured 2026-08-24: yarn.lock
# yields 2802 packages and zero licences, because a lockfile records versions
# and not terms. The installed tree carries each package.json, which is where
# the licence actually is. A parts list with no licences cannot answer question 3.
#
# --select-catalogers is not optional and it is the whole trick. syft picks
# catalogers by tag, and a `dir:` scan selects the "directory/declared" set.
# Run `syft cataloger list` and the problem is on two lines:
#
#   javascript-lock-cataloger     tags=declared,directory,...   <- runs, no licences
#   javascript-package-cataloger  tags=image,installed,...      <- has licences, skipped
#
# The cataloger that reads package.json is tagged for image scans, so pointing
# syft at node_modules without this flag gets you the lockfile reader and a
# parts list with no terms in it. Measured 2026-08-24 on backstage/node_modules:
# without the flag 1821 packages / 2 licences; with it 4996 packages / 3081.
#
# sbom.spdx3.json (SPDX-3.0.1, via `-o spdx-json@3`, syft 1.51.0+, anchore/syft#4269)
# is emitted alongside 2.3 because BSI TR-03183-2 v2.1.0 bans SPDX 2.x and
# requires CycloneDX 1.6+ or SPDX 3.0.1+ (crew#96). It is UNVALIDATED: nothing
# on this machine can check it -- sbomqs 2.0.11 errors "unsupported sbom
# format" on it, spdx-tools 0.8.5 is still 2.x-only, protobom's SPDX3 reader
# is merged but not in a tagged release. Confirmed 2026-08-24 by running both,
# not by reading a changelog. sbom.spdx.json (2.3) stays -- our own tooling
# still reads it, and 3.0.1 is not a replacement, it is the regulator's ask.
log "sbom      scanning $TARGET"
syft scan "dir:$TARGET" --select-catalogers "+javascript-package-cataloger" \
                        -o json="$OUT/sbom.syft.json" \
                        -o spdx-json="$OUT/sbom.spdx.json" \
                        -o spdx-json@3="$OUT/sbom.spdx3.json" \
                        -o cyclonedx-json="$OUT/sbom.cyclonedx.json" -q
n=$(/usr/local/bin/jq '.artifacts|length' "$OUT/sbom.syft.json")
lic=$(/usr/local/bin/jq '[.artifacts[]|select((.licenses|length)>0)]|length' "$OUT/sbom.syft.json")
log "sbom      $n packages, $lic with a declared licence -> reports/sbom.{syft,spdx,spdx3,cyclonedx}.json"
log "sbom      sbom.spdx3.json is SPDX-3.0.1, unvalidated -- no tool on this machine checks it (crew#96 AC4)"

# --- 1b. does the SBOM validate --------------------------------------------
# A 12MB CycloneDX file nothing checks is a metadata slot, not a self-
# describing asset (crew#96). --fail-on-errors is not optional: without it
# cyclonedx validate passes on warnings silently. This one is a real gate --
# set -e stops the script here if the BOM is invalid. sbomqs score and
# --bsi-v2 compliance are reported, same as the vuln counts below, because
# neither tool exits non-zero on a low score -- the number is the signal.
log "sbom      validating against the CycloneDX schema"
cyclonedx validate --input-file "$OUT/sbom.cyclonedx.json" --fail-on-errors
score=$(sbomqs score "$OUT/sbom.cyclonedx.json" | head -1 | grep -oE '[0-9]+\.[0-9]+/10\.0' | head -1)
bsi=$(sbomqs compliance --bsi-v2 --basic "$OUT/sbom.cyclonedx.json" | tail -1)
log "sbom      valid, quality $score, $bsi"

# --- 2. vulnerabilities -------------------------------------------------------
# Scanning the SBOM, not the directory again. Same answer, seconds instead of
# minutes, and it proves the SBOM is well formed enough for another tool to read.
log "vulns     scanning the SBOM"
grype "sbom:$OUT/sbom.syft.json" -o json --file "$OUT/vulns.json" -q 2>/dev/null || true
crit=$(/usr/local/bin/jq '[.matches[]?|select(.vulnerability.severity=="Critical")]|length' "$OUT/vulns.json" 2>/dev/null || echo 0)
high=$(/usr/local/bin/jq '[.matches[]?|select(.vulnerability.severity=="High")]|length' "$OUT/vulns.json" 2>/dev/null || echo 0)
tot=$(/usr/local/bin/jq '.matches|length' "$OUT/vulns.json" 2>/dev/null || echo 0)
log "vulns     $tot findings: $crit critical, $high high -> reports/vulns.json"

# --- 3. licences --------------------------------------------------------------
log "licence   reshaping the SBOM for the policy"
/usr/local/bin/jq '{packages: [.artifacts[] | {
    name, version,
    licences: [ .licenses[]? | (.value // .spdxExpression // empty) ]
  }]}' "$OUT/sbom.syft.json" > "$OUT/licences.json"

log "licence   conftest against policy/licences.rego"
set +e
conftest test --parser json -p "$IDP/policy" "$OUT/licences.json" 2>&1 | tee "$OUT/licence-policy.txt"
rc=${PIPESTATUS[0]}
set -e

echo
if [ "$rc" -eq 0 ]; then
  echo "PASS      $n packages ($lic licensed), $tot vulnerabilities ($crit critical), nothing sell-blocking"
else
  echo "FAIL      the licence policy refused -- see reports/licence-policy.txt"
fi
exit "$rc"
