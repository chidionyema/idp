#!/usr/bin/env python3
"""crew#344: the HelmRelease rows of the broken-workload Alert are generated, not typed.

Reads every Flux Kustomization under clusters/<cluster>/*.yaml, renders its path with kustomize,
collects the namespaces that hold a HelmRelease, and rewrites the `kind: HelmRelease` rows of
the Alert in platform/alerts/alert.yaml to exactly that set (sorted). The Kustomization and
GitRepository rows are kept as written. A namespace that must stay silent is listed in EXCLUDED
with its reason; that is a decision recorded here, not a line someone forgot.

  bin/idp-alert-rows            rewrite the rows, print what changed
  bin/idp-alert-rows --check    exit 1 if the file is stale (CI; tests/test_incident_backstage_17h_unreported.py)
"""
from __future__ import annotations

import glob
import pathlib
import subprocess
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[1]
ALERT = ROOT / "platform/alerts/alert.yaml"
ALERT_NAME = "broken-workload"
EXCLUDED: dict[str, str] = {}  # namespace -> why its HelmReleases page nobody

MARK_BEGIN = "    # --- generated by bin/idp-alert-rows: every namespace that holds a HelmRelease ---\n"
MARK_END = "    # --- end generated ---\n"


def helmrelease_namespaces() -> list[str]:
    seen: set[str] = set()
    for f in sorted(glob.glob(str(ROOT / "clusters/*/*.yaml"))):
        for d in yaml.safe_load_all(pathlib.Path(f).read_text()):
            if not d or d.get("kind") != "Kustomization":
                continue
            path = (ROOT / d["spec"]["path"]).resolve()
            if not any((path / k).exists() for k in ("kustomization.yaml", "kustomization.yml", "Kustomization")):
                continue  # a Kustomization pointing at plain manifests (or the cluster root) renders no HelmRelease
            out = subprocess.run(["kubectl", "kustomize", str(path)], capture_output=True, text=True)
            if out.returncode != 0:
                sys.exit(f"FAIL    alert-rows  kustomize {path}: {out.stderr.strip()[:200]}")
            for x in yaml.safe_load_all(out.stdout):
                if x and x.get("kind") == "HelmRelease":
                    seen.add(x["metadata"].get("namespace") or "default")
    return sorted(seen - set(EXCLUDED))


def rows(namespaces: list[str]) -> str:
    body = "".join(f'    - kind: HelmRelease\n      name: "*"\n      namespace: {ns}\n' for ns in namespaces)
    return MARK_BEGIN + body + MARK_END


def render(text: str, namespaces: list[str]) -> str:
    if MARK_BEGIN in text:
        head, rest = text.split(MARK_BEGIN, 1)
        _, tail = rest.split(MARK_END, 1)
        return head + rows(namespaces) + tail
    # First run: replace the hand-typed HelmRelease rows inside the broken-workload Alert.
    lines = text.splitlines(keepends=True)
    out, i, done = [], 0, False
    while i < len(lines):
        ln = lines[i]
        if not done and ln == "    - kind: HelmRelease\n":
            if not any(f"name: {ALERT_NAME}" in x for x in out):
                out.append(ln); i += 1; continue
            while i < len(lines) and (lines[i] == "    - kind: HelmRelease\n" or lines[i].startswith("      ")):
                i += 1
            out.append(rows(namespaces)); done = True; continue
        out.append(ln); i += 1
    if not done:
        sys.exit(f"FAIL    alert-rows  no HelmRelease rows found in {ALERT}")
    return "".join(out)


def main() -> int:
    check = "--check" in sys.argv
    namespaces = helmrelease_namespaces()
    before = ALERT.read_text()
    after = render(before, namespaces)
    if after == before:
        print(f"ok      alert-rows  {len(namespaces)} namespace(s) hold a HelmRelease, all listed: {' '.join(namespaces)}")
        return 0
    if check:
        print(f"FAIL    alert-rows  {ALERT.relative_to(ROOT)} is stale; run bin/idp-alert-rows (namespaces now: {' '.join(namespaces)})")
        return 1
    ALERT.write_text(after)
    print(f"ok      alert-rows  rewrote {ALERT.relative_to(ROOT)}: {' '.join(namespaces)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
