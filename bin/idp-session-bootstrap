#!/usr/bin/env bash
# Every Claude Code session starts fenced, on any machine (crew#654, crew#300; founder 2026-08-29:
# "we need a path back to a MacBook or any other machine").
#   bin/idp-session-bootstrap          clone claude-estate (guards submodule included) into $HOME/.claude when absent; no-op when present
#   bin/idp-session-bootstrap --check  exit 0 when $HOME/.claude/scripts holds the guards, 1 when it does not; nothing written
# Runs as the SessionStart hook in .claude/settings.json, so a cloud session (vendor page: repo hooks
# run in the cloud, user-level ~/.claude does not) gets the same fences as the Mac. Never writes over
# an existing checkout and never touches its branch: a peer's working tree is not this script's to move.
set -euo pipefail
trap 'echo "idp-session-bootstrap: failed at line $LINENO" >&2' ERR
ESTATE_REPO=${ESTATE_REPO:-https://github.com/chidionyema/claude-estate}
DEST=$HOME/.claude
if [ "${1:-}" = --check ]; then
	[ -f "$DEST/scripts/hook-run.py" ] && {
		echo "ok      guards present in $DEST/scripts"
		exit 0
	}
	echo "MISSING $DEST/scripts/hook-run.py" >&2
	exit 1
fi
if [ -f "$DEST/scripts/hook-run.py" ]; then exit 0; fi
if [ -e "$DEST/.git" ]; then
	git -C "$DEST" submodule update --init --recursive
else
	tmp=$(mktemp -d "${TMPDIR:-/tmp}/estate.XXXXXX")
	git clone --quiet --recurse-submodules "$ESTATE_REPO" "$tmp/estate"
	mkdir -p "$DEST"
	cp -R "$tmp/estate/." "$DEST/"
	rm -rf "$tmp"
fi
"$0" --check
