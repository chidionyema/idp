#!/usr/bin/env python3
"""Print Pennyd's edge key to a trusted local process; never log it."""

import json
import re
from pathlib import Path

path = Path.home() / ".estate" / "pennyd" / "keys.toml"
match = re.search(r'^key\s*=\s*"((?:[^"\\]|\\.)*)"', path.read_text(), re.M)
if not match:
    raise SystemExit(f"{path} carries no [[keys]] key")
print(json.loads(f'"{match.group(1)}"'))
