#!/usr/bin/env bash
# crew#488 CP5, founder 2026-08-28 "why do our drills take so long": the two portability jobs each
# ran `kubectl wait kustomization --all --for=condition=Ready --timeout=600s || true`, and since
# two layers can never be Ready on a cluster with no OCI, every run burned the full 600 s per job
# (measured: median 22.2 min over 5 runs, 10.0 min of it in this step in each job). `kubectl wait`
# has no notion of "settled"; this does. A Kustomization is settled when its Ready condition is
# True or False with a reason that is not Progressing/Reconciling; the cluster is settled when
# every Kustomization is, and stays so for SETTLE_GRACE seconds. Cascades and honest reds settle
# in seconds, so the wall-clock is the real hydration time, not the timeout.
# Env: SETTLE_TIMEOUT (s, default 600), SETTLE_GRACE (s, default 30). Exit 0 when settled, 1 on timeout.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
timeout=${SETTLE_TIMEOUT:-600}
grace=${SETTLE_GRACE:-30}
t0=$(date +%s)
stable_since=""
while :; do
	unsettled=$(kubectl get kustomizations -A -o json | python3 -c '
import json, sys
n = 0
for it in json.load(sys.stdin)["items"]:
    rc = next((c for c in it.get("status", {}).get("conditions", []) if c.get("type") == "Ready"), None)
    if rc is None or rc.get("status") == "Unknown" or rc.get("reason") in ("Progressing", "Reconciling", "ReconciliationInProgress"):
        n += 1
print(n)')
	now=$(date +%s)
	if [ "$unsettled" = 0 ]; then
		[ -n "$stable_since" ] || stable_since=$now
		if [ $((now - stable_since)) -ge "$grace" ]; then
			echo "settled after $((now - t0))s"
			exit 0
		fi
	else
		stable_since=""
	fi
	if [ $((now - t0)) -ge "$timeout" ]; then
		echo "not settled after ${timeout}s: $unsettled Kustomizations still reconciling"
		exit 1
	fi
	sleep 5
done
