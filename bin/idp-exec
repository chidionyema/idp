#!/usr/bin/env python3
"""idp-exec: token-efficient command wrapper.

Executes a shell command and clamps output to 50 lines to prevent context bloat.
Full output is logged to idp/state/last_exec.log for later inspection.

Usage:
    idp-exec cat large_file.log
    idp-exec git log --oneline -100
"""

import subprocess
import sys
from pathlib import Path

MAX_LINES = 50
LOG_DIR = Path.home() / ".pi" / "agent" / "state"
LOG_FILE = LOG_DIR / "last_exec.log"


def main():
    if len(sys.argv) < 2:
        print("Usage: idp-exec <command> [args...]", file=sys.stderr)
        return 1

    cmd = sys.argv[1:]
    
    try:
        result = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=300,
        )
    except subprocess.TimeoutExpired:
        print("[ERROR] Command timed out after 300 seconds", file=sys.stderr)
        return 124
    except FileNotFoundError:
        print(f"[ERROR] Command not found: {cmd[0]}", file=sys.stderr)
        return 127
    except Exception as e:
        print(f"[ERROR] Failed to execute command: {e}", file=sys.stderr)
        return 1

    output = result.stdout
    if result.stderr:
        output += result.stderr

    lines = output.splitlines()

    # Save full output to log
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        LOG_FILE.write_text(output, encoding="utf-8")
    except Exception as e:
        print(f"[WARNING] Could not save log to {LOG_FILE}: {e}", file=sys.stderr)

    # Clamp output if needed
    if len(lines) > MAX_LINES:
        half = MAX_LINES // 2
        first_half = lines[:half]
        last_half = lines[-half:]
        
        print("\n".join(first_half))
        print(f"\n[... TRUNCATED: Output exceeded {MAX_LINES} lines. Full output saved to {LOG_FILE} ...]")
        print("\n".join(last_half))
    else:
        print(output, end="")

    return result.returncode


if __name__ == "__main__":
    sys.exit(main())
