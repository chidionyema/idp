#!/usr/bin/env python3
"""No pull request without BDD proof, across all agent sessions.

The rule: a pull request that a session opens must carry evidence that the behaviour
it claims was proved by a BDD run, and that run must be on the same head commit as the
pull request. A PR with no proof block, or whose proof names a different commit, is
refused -- fail-closed.

This is the "show the green run, do not describe it" rule (LAW 22) given a machine that
can say no, and it applies to every session, not one agent's workflow.

Input: a pull request as JSON on stdin or as a file path (the shape `gh pr view --json`),
or `--live` to grade the pull request this CI run is for.
Exit codes:
  0  the pull request carries BDD proof on its own head commit
  1  refused -- missing block, unparseable, or the run is not on this head
  2  the input could not be read at all (BLIND, never a pass)
  3  `--live` only: this event carries no pull request (a push to main grades itself)

The BODY IS READ LIVE, THE HEAD IS THE COMMIT UNDER TEST (measured 2026-10-25, on this gate's
own pull request). `--live` used to grade the body out of `GITHUB_EVENT_PATH`, and on a
re-run GitHub replays the payload it froze when the run was created: this lane's re-run was
refused with `the proof names ced59a268, but the pull request's head is b9a59de20889` while the
pull request's actual body named b9a59de2 -- the author had already corrected it, and the gate
convicted a snapshot. So the payload now supplies only the identity and the head sha (what this
run graded), and the body comes from `gh pr view` when gh can read it. A job with no token still
grades the payload's body, and the gate says which one it read, so a stale snapshot is
diagnosable instead of mysterious.
"""

from __future__ import annotations

import json
import re
import sys
from pathlib import Path

# The block a session must paste, and it must name the commit it proved.
BEGIN = "BDD-PROOF"
END = "END-BDD-PROOF"

# A passing BDD line, and the bar is deliberately high: the block must carry a RUNNER'S
# OWN COUNTS, not a sentence saying the tests passed. "I ran the tests and they passed" is
# the claim this gate exists to refuse, so a bare `passed` never counts.
#
# Accepted shapes, one per family:
#   cucumber / behave / pytest-bdd : "31 scenarios (31 passed)", "0 failed", "5 features passed"
#   jest-cucumber / vitest-cucumber: "Tests: 31 passed, 31 total"
#   go test -run TestBDD           : "--- PASS: TestBDDGateway (0.02s)"
#   pytest with bdd plugin         : "142 passed in 4.51s"
PASS_PATTERNS = [
    # cucumber family summaries
    re.compile(r"\b\d+\s+scenarios?\b[^\n]{0,40}\b\d+\s+passed\b", re.I),
    re.compile(r"\b\d+\s+features?\b[^\n]{0,40}\b\d+\s+passed\b", re.I),
    re.compile(r"\b\d+\s+failed\b", re.I)
    if False
    else re.compile(r"\b0\s+failed\b", re.I),
    # jest / vitest
    re.compile(r"Tests:\s*\d+\s+passed", re.I),
    re.compile(r"\b\d+\s+passed,\s*\d+\s+total\b", re.I),
    # go
    re.compile(r"^---\s*PASS:\s*\w", re.M),
    # pytest
    re.compile(r"\b\d+\s+passed\s+in\s+[\d.]+s", re.I),
]

# A block that only asserts in prose, with no runner output at all. Refused separately so
# the refusal message names the real reason.
PROSE_ONLY = re.compile(
    r"^\s*(i\s+(ran|ran\s+the)|tests?\s+(pass|passed|are\s+green)|all\s+green|"
    r"bdd\s+(pass|passed|is\s+green)|verified\s+manually)\b",
    re.I | re.M,
)


def extract_block(body: str) -> str | None:
    """The first BDD-PROOF ... END-BDD-PROOF block, or None."""
    m = re.search(
        rf"{BEGIN}(.*?){END}",
        body,
        re.S | re.I,
    )
    return m.group(1) if m else None


def head_from_block(block: str) -> str | None:
    """The commit the proof block names, e.g. `head: abc1234`."""
    m = re.search(r"^\s*head\s*[:=]\s*([0-9a-f]{7,40})\s*$", block, re.I | re.M)
    return m.group(1).lower() if m else None


def looks_like_a_pass(block: str) -> bool:
    """True only when the block carries a runner's own counts, not a prose claim."""
    if PROSE_ONLY.search(block) and not any(p.search(block) for p in PASS_PATTERNS):
        return False
    return any(p.search(block) for p in PASS_PATTERNS)


def _event_payload() -> dict | None:
    """The GitHub Actions event payload, or None off-CI. A SNAPSHOT of the event's moment."""
    import os

    p = os.environ.get("GITHUB_EVENT_PATH")
    if not p or not Path(p).is_file():
        return None
    try:
        return json.loads(Path(p).read_text())
    except Exception:  # noqa: S110 - malformed event JSON falls through to gh
        return None


def _event_pr() -> dict | None:
    """The pull request the event payload carries, or None (a push, a schedule, off-CI)."""
    ev = _event_payload()
    if ev is None:
        return None
    return ev.get("pull_request") or None


def _payload_row(pr: dict) -> dict:
    """The pull request row out of an event payload, in `gh pr view --json` shape."""
    return {
        "number": pr.get("number"),
        "title": pr.get("title") or "",
        "body": pr.get("body") or "",
        "headRefOid": ((pr.get("head") or {}).get("sha") or ""),
        "_source": "event payload",
    }


def _gh_view(number) -> dict | None:
    """The pull request as it is NOW, or None when gh cannot read it (no token, no network)."""
    import subprocess

    if not number:
        return None
    try:
        out = subprocess.run(
            [
                "gh",
                "pr",
                "view",
                str(number),
                "--json",
                "number,title,body,headRefOid",
            ],
            cwd=Path(__file__).resolve().parents[1],
            capture_output=True,
            text=True,
            timeout=120,
        )
    except Exception:  # noqa: S110 - a missing gh is a fallback, not a crash
        return None
    if out.returncode != 0:
        return None
    try:
        row = json.loads(out.stdout)
    except Exception:  # noqa: S112 - unreadable gh output is a fallback
        return None
    if not isinstance(row, dict):
        return None
    row["_source"] = "gh pr view"
    return row


def live_pr() -> dict:
    """The pull request under test: the payload's identity and head, the live body.

    The previous shape `gh pr list --state all --limit 1` returned the newest PR ANY
    session opened, not the PR being graded -- so a run for branch A refused because branch
    B's freshly-opened PR carried no BDD-PROOF block. That false-red is what the founder's
    comment at bin/idp-ci:73-84 was working around with a load-bearing `|| true`. Fix that
    class by reading the PR number from the GitHub Actions event payload when it is set
    (pull_request or merge_group event), and fall back to newest only when neither is
    present (local invocation).
    """
    ev_row = _event_pr()
    if ev_row is not None:
        row = _payload_row(ev_row)
        live = _gh_view(row["number"])
        if live is not None:
            # The body is where the author writes the proof, and they may have edited it after
            # this run started; the head stays the payload's, because that is the commit this
            # run graded. A re-run replays a frozen payload, and its body is the stale half.
            row["body"] = live.get("body") or row["body"]
            row["title"] = live.get("title") or row["title"]
            row["_source"] = "gh pr view body, payload head"
        return row

    # No event payload: a local invocation, or the pre-push hook on a lane/* branch.

    import os
    import subprocess

    root = Path(__file__).resolve().parents[1]
    # GITHUB_HEAD_REF is set by the pre-push hook for lane/* branches. Use it to find
    # the correct PR for the branch being pushed, instead of the global newest PR.
    head_ref = os.environ.get("GITHUB_HEAD_REF", "")
    if head_ref:
        out = subprocess.run(
            [
                "gh",
                "pr",
                "list",
                "--head",
                head_ref,
                "--state",
                "all",
                "--limit",
                "1",
                "--json",
                "number,title,body,headRefOid",
            ],
            cwd=root,
            capture_output=True,
            text=True,
            timeout=120,
        )
        if out.returncode == 0:
            rows = json.loads(out.stdout or "[]")
            if rows:
                return rows[0]

    out = subprocess.run(
        [
            "gh",
            "pr",
            "list",
            "--state",
            "all",
            "--limit",
            "1",
            "--json",
            "number,title,body,headRefOid",
        ],
        cwd=root,
        capture_output=True,
        text=True,
        timeout=120,
    )
    if out.returncode != 0:
        raise RuntimeError(
            f"gh could not list pull requests: {out.stderr.strip()[:200]}"
        )
    rows = json.loads(out.stdout or "[]")
    if not rows:
        raise RuntimeError("no pull request exists on this repository to grade")
    return rows[0]


def _self_test() -> int:
    """Exercise the block extractor + counts predicate on real bytes.

    A gate that has never executed is not a gate (script-compiles rule); this proves the
    hot path -- extract_block, head_from_block, looks_like_a_pass -- on both the good and
    the bad shape without hitting the network. Live grading is exercised only when
    --live is passed with a real GHA event.
    """
    good = "BDD-PROOF\nhead: abc1234\n142 passed in 4.51s\nEND-BDD-PROOF"
    bad_prose = (
        "BDD-PROOF\nhead: abc1234\ni ran the tests and they passed\nEND-BDD-PROOF"
    )
    bad_none = "no proof block at all here"
    assert extract_block(good) is not None, "extractor missed a real block"
    assert extract_block(bad_none) is None, "extractor invented a block"
    assert head_from_block(extract_block(good)) == "abc1234", "head parser wrong"
    assert looks_like_a_pass(extract_block(good)) is True, (
        "counts pattern refused a real pass"
    )
    assert looks_like_a_pass(extract_block(bad_prose)) is False, (
        "prose accepted as pass"
    )
    print("ok bdd-proof-gate --self-test: extractor + counts predicate both ways")
    return 0


def grade(pr: dict) -> int:
    """Grade one pull request, whoever fed it in. 0 proved on this head; 1 refused, named.

    ONE grader, both paths (the file/stdin path and `--live`). `--live` used to check only that
    a block existed and never bound its `head:` to the head being graded, so the same pull
    request got a weaker answer depending on which door asked.
    """
    import os

    body = pr.get("body") or ""
    head = (pr.get("headRefOid") or pr.get("head_oid") or "").lower()
    title = pr.get("title") or ""
    source = pr.get("_source") or "input"

    # Env overrides let a rule's fixture cases prove the both-ways cases without a live PR:
    #   BDD_PR_HEAD   -- pretend the pull request's head is this commit
    #   BDD_RUN_HEAD  -- pretend the proof names this commit
    # Both default to the input, so an unset environment changes nothing.
    if os.environ.get("BDD_PR_HEAD"):
        head = os.environ["BDD_PR_HEAD"].lower()
    run_head_override = os.environ.get("BDD_RUN_HEAD", "").lower()

    block = extract_block(body)
    if block is None:
        print(
            f"refused: '{title}' carries no {BEGIN} ... {END} block "
            f"(body from {source})",
            file=sys.stderr,
        )
        return 1

    if not looks_like_a_pass(block):
        print("refused: the proof block carries no passing BDD run", file=sys.stderr)
        return 1

    proved = run_head_override or head_from_block(block)
    if proved is None:
        print("refused: the proof block names no head commit", file=sys.stderr)
        return 1

    if head and not head.startswith(proved):
        print(
            f"refused: the proof names {proved}, but the pull request's head is {head[:12]} "
            f"(body from {source})",
            file=sys.stderr,
        )
        return 1

    print(f"ok: bdd proof on head {proved} (body from {source})")
    return 0


def main() -> int:
    if "--self-test" in sys.argv or "-h" in sys.argv or "--help" in sys.argv:
        return (
            _self_test()
            if "--self-test" in sys.argv
            else (print(__doc__ or "bdd-proof-gate") or 0)
        )
    if "--live" in sys.argv:
        if "--pr" in sys.argv:
            i = sys.argv.index("--pr")
            row = _gh_view(sys.argv[i + 1] if i + 1 < len(sys.argv) else "")
            if row is None:
                print(
                    "bdd-proof-gate: BLIND, gh could not read that pull request",
                    file=sys.stderr,
                )
                return 2
            return grade(row)
        if _event_payload() is not None and _event_pr() is None:
            # A push, a schedule, a merge-queue run: no pull request in this event, so there is
            # nothing here to grade. Named and skipped, never counted as a pass.
            print("skip: this event carries no pull request", file=sys.stderr)
            return 3
        try:
            pr = live_pr()
        except Exception as e:
            print(
                f"bdd-proof-gate: BLIND, cannot read a pull request: {e}",
                file=sys.stderr,
            )
            return 2
        return grade(pr)

    src = sys.argv[1] if len(sys.argv) > 1 else "-"
    try:
        raw = sys.stdin.read() if src == "-" else Path(src).read_text()
    except Exception as e:
        print(f"bdd-proof-gate: cannot read input: {e}", file=sys.stderr)
        return 2

    try:
        pr = json.loads(raw)
    except Exception as e:
        print(f"bdd-proof-gate: input is not JSON: {e}", file=sys.stderr)
        return 2

    if not isinstance(pr, dict):
        print("bdd-proof-gate: input is not a pull request object", file=sys.stderr)
        return 2
    return grade(pr)


if __name__ == "__main__":
    sys.exit(main())
