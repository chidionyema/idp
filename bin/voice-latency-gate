#!/usr/bin/env python3
"""voice-latency-gate: end of speech -> first sound, over real turns, for both /fleet voice engines.

Exit 0 = inside the limits, 1 = over them, 3 = blind (an engine unreachable or no turn completed).
Blind is red: a gate that cannot measure has not passed.

WHY. 2026-09-27 the founder: "not accepting any latency drag ... needs tests for low latency".
Until now every voice test asserted first_audio_s > 0, which a 30 s reply passes.

THE LIMITS (voice-to-voice, from the moment the person stops speaking to the first sound):
  p50 <= 0.8 s, p95 <= 1.2 s   -- the gate. Coval, Hamming and Telnyx put 800 ms as the production
                                 target and 1.2-1.5 s as where a conversation reads as broken.
  p50 <= 0.5 s                 -- the ultra-low target, printed, not gated. Human turn-taking gaps
                                 sit around 200 ms (Stivers et al., PNAS 2009).
Override with VOICE_P50_S / VOICE_P95_S; lowering is fine, raising is a decision to write down.

WHAT IS TIMED, PER ENGINE, with nothing mocked:
  router  -- cmd/talk, built from this tree, streams a spoken question into /voice/ws at real time
             and then room silence, as a microphone does, and reads the clock from the last speech
             sample to the first audio frame. The router's endpoint wait is inside the number.
  estate  -- the page's own request chain against fleetview: /voice/hear -> /voice/stream until the
             first clause -> /voice/say for that clause, whole (the page plays a clause only once
             its body has arrived). The browser VAD's silence wait comes before /voice/hear and is
             NOT inside this number, so the estate figure flatters the engine by that much.
"""

import argparse
import json
import math
import os
import re
import statistics
import subprocess
import sys
import tempfile
import time
import urllib.request
import wave
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SAID = "how many sessions are running"
P50 = float(os.environ.get("VOICE_P50_S", "0.8"))
P95 = float(os.environ.get("VOICE_P95_S", "1.2"))
ULTRA = 0.5
BLIND = 3


def utterance(work: Path) -> Path:
    wav = work / "q.wav"
    subprocess.run(["say", "-o", str(work / "q.aiff"), SAID], check=True)
    subprocess.run(
        [
            "afconvert",
            "-f",
            "WAVE",
            "-d",
            "LEI16@16000",
            "-c",
            "1",
            str(work / "q.aiff"),
            str(wav),
        ],
        check=True,
    )
    return wav


def router_turns(wav: Path, work: Path, n: int, url: str) -> list[float]:
    talk = work / "talk"
    env = dict(os.environ)
    tools = Path.home() / ".cache/estate-tools"
    env["PATH"] = f"{tools}/go/bin:{env['PATH']}"
    env.setdefault("GOPATH", str(tools / "gopath"))
    b = subprocess.run(
        ["go", "build", "-o", str(talk), "./cmd/talk"],
        cwd=ROOT / "platform/voice-router",
        env=env,
        capture_output=True,
        text=True,
    )
    if b.returncode != 0:
        print(f"router: BLIND: cannot build cmd/talk: {b.stderr.strip()[-400:]}")
        sys.exit(BLIND)
    out = []
    for i in range(n):
        r = subprocess.run(
            [str(talk), "-url", url, "-wav", str(wav)],
            capture_output=True,
            text=True,
            timeout=90,
        )
        m = re.search(r"\+\s*(\d+)ms first audio", r.stdout)
        done = re.search(r"\bdone\b", r.stdout)
        if not (m and done):
            print(f"router turn {i + 1}: no answer spoken\n{r.stdout.strip()[-600:]}")
            continue
        out.append(int(m.group(1)) / 1000)
        print(f"router turn {i + 1}: {out[-1]:.2f}s")
    return out


def post(url: str, body: bytes, ctype: str, timeout: float = 120):
    req = urllib.request.Request(
        url, data=body, headers={"Content-Type": ctype}, method="POST"
    )
    return urllib.request.urlopen(req, timeout=timeout)


def estate_turns(wav: Path, n: int, base: str) -> list[float]:
    import array

    with wave.open(str(wav)) as w:
        ints = array.array("h", w.readframes(w.getnframes()))
    pcm = array.array(
        "f", (s / 32768 for s in ints)
    ).tobytes()  # the page sends 16 kHz float32
    out = []
    for i in range(n):
        t0 = time.monotonic()
        try:
            heard = json.load(
                post(
                    f"{base}/voice/hear?session_id=voice-latency-gate&author=voice-latency-gate",
                    pcm,
                    "application/octet-stream",
                )
            )
            if heard.get("empty"):
                print(f"estate turn {i + 1}: nothing heard")
                continue
            clause = None
            with post(
                f"{base}/voice/stream",
                json.dumps({"question": heard["text"], "history": []}).encode(),
                "application/json",
            ) as s:
                event = None
                for raw in s:
                    line = raw.decode().strip()
                    if line.startswith("event:"):
                        event = line[6:].strip()
                    elif line.startswith("data:") and event == "delta":
                        clause = json.loads(line[5:]).get("text")
                        if clause:
                            break
                    elif line.startswith("data:") and event == "error":
                        break
            if not clause:
                print(f"estate turn {i + 1}: the brain gave no clause")
                continue
            audio = post(
                f"{base}/voice/say",
                json.dumps({"text": clause}).encode(),
                "application/json",
            ).read()
            if not audio:
                print(f"estate turn {i + 1}: no audio for the first clause")
                continue
        except Exception as exc:  # noqa: BLE001 - an unreachable engine is reported, then counted blind
            print(f"estate turn {i + 1}: {type(exc).__name__}: {exc}")
            continue
        out.append(time.monotonic() - t0)
        print(f"estate turn {i + 1}: {out[-1]:.2f}s")
    return out


def p(xs: list[float], q: float) -> float:
    """Nearest-rank percentile: with 10 turns, p95 is the slowest one."""
    s = sorted(xs)
    return s[max(0, math.ceil(len(s) * q / 100) - 1)]


def verdict(engine: str, xs: list[float], n: int) -> int:
    if not xs:
        print(f"{engine}: BLIND: 0/{n} turns answered")
        return BLIND
    p50, p95 = statistics.median(xs), p(xs, 95)
    red = p50 > P50 or p95 > P95 or len(xs) < n
    # The load is printed, never used to excuse a result: 2026-09-27 one run went from p50 2.0 s
    # to 7.5 s while other builds pushed the 1-minute load to 149 on a 4-thread i5.
    load = os.getloadavg()[0]
    print(
        f"{engine}: {len(xs)}/{n} answered  p50={p50:.2f}s (limit {P50}s, ultra {ULTRA}s)  "
        f"p95={p95:.2f}s (limit {P95}s)  load1={load:.0f} cpus={os.cpu_count()}  "
        f"-> {'RED' if red else 'GREEN'}"
    )
    return 1 if red else 0


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--engine", choices=["router", "estate", "both"], default="both")
    ap.add_argument("--turns", type=int, default=10)
    ap.add_argument("--router-url", default="ws://127.0.0.1:8091/voice/ws")
    ap.add_argument("--fleetview", default="http://127.0.0.1:18790")
    a = ap.parse_args()
    with tempfile.TemporaryDirectory(prefix="voice-latency-") as d:
        work = Path(d)
        wav = utterance(work)
        rcs = []
        if a.engine in ("router", "both"):
            rcs.append(
                verdict(
                    "router", router_turns(wav, work, a.turns, a.router_url), a.turns
                )
            )
        if a.engine in ("estate", "both"):
            rcs.append(
                verdict("estate", estate_turns(wav, a.turns, a.fleetview), a.turns)
            )
    return max(rcs)


if __name__ == "__main__":
    sys.exit(main())
