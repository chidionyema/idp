#!/usr/bin/env python3
"""memory-door-schema -- can the door every agent writes through CARRY the evidence?

WHY. 2026-10-26. The gate that proves the checker works reported 4 refutations and the brief
above the memories was headed VERIFIED. But the door every agent actually writes through --
`mcp/plugins/estate_memory.py`'s `remember` tool, over MCP -- advertised six arguments
(`content`, `subject`, `kind`, `tags`, `source`, `runtime`) and no way to attach an
instrument, an evidence path or an authority. Measured on the live pod that day:

    remember props: ['content', 'kind', 'runtime', 'source', 'subject', 'tags']

So an agent had no wire-level way to hand the checker anything, which means no write could
earn a rung, which means the estate's memories were ALL raw_source -- 193 of 193, measured
-- while the brief above them said VERIFIED. The checker worked. The door could not reach it.

`bin/memory-gate` could not see this: its rungs call `do_remember(...)` inside the pod, in
process, which passes whether or not the tool schema advertises the arguments. A rung that
calls the function is not a rung that asks the door. This program asks the door, on the wire,
the same question an agent's MCP client asks: `tools/list`.

WHAT IT DOES. Reads one JSON-RPC `tools/list` response (raw, or SSE `data:` framed) on stdin
and checks that the `remember` tool's `inputSchema.properties` includes `instrument`,
`evidence` and `authority`. Exit 0 when the door can carry evidence, 1 when it cannot, naming
each field the door is missing. It writes nothing and touches no store: the answer is a
property of the schema, and a gate must not leave probe facts in the namespace it grades.

    bin/memory-gate                                   live: drives this over the real endpoint
    kubectl ... curl ... tools/list | bin/memory-door-schema
"""

from __future__ import annotations

import json
import sys

# The three arguments that let a claim reach `bin/estate-claim-check probe`. Named together
# because one alone is not evidence: an instrument reproduces, a path binds, an authority
# attributes, and the door has to be able to be handed any of the three.
EVIDENCE_FIELDS = ("instrument", "evidence", "authority")
TOOL = "remember"


def find_tools(body: str) -> list | None:
    """The `tools` array from a tools/list response, raw JSON or SSE-framed.

    A streaming MCP server frames each message as `event: message` + `data: {...}`; a plain
    one answers with the object. The same server answers in either shape depending on the
    Accept header, so this must not depend on which one it got -- failing to parse a response
    the door DID send would report a defect that is not there.
    """
    for line in body.splitlines():
        line = line.strip()
        if line.startswith("data:"):
            line = line[len("data:") :].strip()
        if not line.startswith("{"):
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        result = msg.get("result") if isinstance(msg, dict) else None
        if isinstance(result, dict) and isinstance(result.get("tools"), list):
            return result["tools"]
    return None


def check(body: str) -> tuple:
    tools = find_tools(body)
    if tools is None:
        # An unparseable or error response is not a pass. The door was asked and did not
        # answer with a tool list; that is the same defect as a door that cannot carry
        # evidence, and it must fail loudly rather than quietly.
        return False, "the door returned no tools/list payload -- it said: " + (
            body.strip()[:200] or "(nothing)"
        )
    for tool in tools:
        if not isinstance(tool, dict) or tool.get("name") != TOOL:
            continue
        props = (tool.get("inputSchema") or {}).get("properties") or {}
        missing = [f for f in EVIDENCE_FIELDS if f not in props]
        if missing:
            return False, (
                "the door's `%s` cannot carry evidence: missing %s (it advertises: %s)"
                % (TOOL, ", ".join(missing), ", ".join(sorted(props)))
            )
        return True, "`%s` can carry evidence: %s" % (TOOL, ", ".join(EVIDENCE_FIELDS))
    return (
        False,
        "the door does not offer `%s` at all -- agents cannot write a memory" % TOOL,
    )


def main(argv: list) -> int:
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    ok, detail = check(sys.stdin.read())
    if ok:
        print("ok    memory-door-schema: " + detail)
        return 0
    print("FAIL  memory-door-schema: " + detail)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
