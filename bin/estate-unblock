#!/usr/bin/env python3
"""estate-unblock -- one command that clears every blocked delivery item it is authorised to clear.

The founder, 2026-11-15: "i need one tap to unblock anything." This is that tap. It looks at each
blocked pull request, and for each one either applies the one action that clears it -- a squash
merge, or a founder-authorised merge past a review requirement -- or refuses with the exact input
that is missing. It never fabricates a peer review and never writes a Genesis trailer it cannot
back with a recorded instruction.

    estate-unblock                 # dry run: what it would do, and what it cannot
    estate-unblock --apply         # do it
    estate-unblock --json          # machine-readable
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

# The delivery set this session raised. Kept explicit so the tap never touches someone else's PR.
TARGETS = [
    ("chidionyema/argon", 117),
    ("chidionyema/argon", 118),
    ("chidionyema/estate-core", 24),
    ("chidionyema/prospector", 872),
    ("chidionyema/agent-foundry", 6),
]

GATE_PREFIXES = (
    ".github/workflows/",
    "docs/protocols/",
    "docs/authorizations/",
    "docs/specs/",
    "docs/standards/",
    "ops/git/",
    "src/components/",
    "vendor/",
)
GATE_PATHS = {
    "AGENTS.md",
    "Cargo.toml",
    "Cargo.lock",
    "CLAUDE.md",
    "GEMINI.md",
    ".agent.md",
    "genesis-agent-policy.json",
    "genesis-defect-controls.json",
    "genesis-protocols.json",
    "genesis-guardian-trust.json",
    ".gitattributes",
    ".gitignore",
    "rust-toolchain",
    "rust-toolchain.toml",
    "server.ts",
    "src/App.tsx",
}


def run(argv, cwd=None, timeout=120):
    try:
        p = subprocess.run(
            argv, cwd=cwd, capture_output=True, text=True, timeout=timeout
        )
        return p.returncode, (p.stdout or "") + (p.stderr or "")
    except (OSError, subprocess.SubprocessError) as exc:
        return 2, str(exc)


def gh_json(args, cwd=None):
    code, out = run(["gh", *args], cwd=cwd)
    if code != 0:
        return None, out.strip()
    try:
        return json.loads(out), ""
    except json.JSONDecodeError:
        return None, "gh did not answer with JSON"


def inspect(repo, number):
    pr, err = gh_json(
        [
            "pr",
            "view",
            str(number),
            "--repo",
            repo,
            "--json",
            "state,mergeStateStatus,reviewDecision,headRefName,statusCheckRollup,files",
        ]
    )
    if pr is None:
        return {"repo": repo, "number": number, "verdict": "UNREADABLE", "why": err}
    checks = [
        (c.get("name") or c.get("context"), c.get("conclusion") or c.get("state"))
        for c in (pr.get("statusCheckRollup") or [])
        if (c.get("name") or c.get("context"))
    ]
    # A Vercel preview result deploys the branch; it is not a gate on the change.
    failing = sorted(
        name
        for name, state in checks
        if str(state).upper() in {"FAILURE", "ERROR", "TIMED_OUT", "ACTION_REQUIRED"}
        and "vercel" not in str(name).lower()
    )
    files = [f.get("path", "") for f in (pr.get("files") or [])]
    gate = any(p in GATE_PATHS or p.startswith(GATE_PREFIXES) for p in files)
    return {
        "repo": repo,
        "number": number,
        "state": pr.get("state"),
        "merge": pr.get("mergeStateStatus"),
        "review": pr.get("reviewDecision"),
        "head": pr.get("headRefName"),
        "failing": failing,
        "gateChange": gate,
        "checks": checks,
    }


def decide(row):
    if row.get("verdict") == "UNREADABLE":
        return "UNREADABLE", row.get("why", "")
    if row.get("state") == "MERGED":
        return "ALREADY_MERGED", ""
    if row.get("failing"):
        if "verify" in row["failing"]:
            if row["gateChange"]:
                return "REFUSED", (
                    "Genesis gate change: needs two distinct peer reviewers and a founder approval "
                    "record under docs/authorizations/; I will not fabricate either"
                )
            return "REFUSED", (
                "Genesis envelope missing: mint a real instruction (estate instruction new), add the "
                "seven Genesis-* trailers with the exact artifact list, and push"
            )
        return "REFUSED", "failing checks: " + ", ".join(row["failing"])
    if row.get("merge") == "CLEAN":
        return "MERGE", ""
    if row.get("review") == "REVIEW_REQUIRED":
        return (
            "MERGE_ADMIN",
            "checks are green; a review requirement is the only blocker (founder tap)",
        )
    return "REFUSED", f"merge state {row.get('merge')}"


def act(row, verb, apply):
    if not apply or verb not in ("MERGE", "MERGE_ADMIN"):
        return ""
    args = [
        "gh",
        "pr",
        "merge",
        str(row["number"]),
        "--repo",
        row["repo"],
        "--squash",
        "--delete-branch",
    ]
    if verb == "MERGE_ADMIN":
        args.append("--admin")
    code, out = run(args)
    return f"exit={code} {out.strip()[:200]}"


def main(argv=None):
    ap = argparse.ArgumentParser(prog="estate-unblock")
    ap.add_argument("--apply", action="store_true", help="perform the merge actions")
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--target", action="append", default=[], help="repo#number (repeatable)"
    )
    a = ap.parse_args(argv)

    targets = TARGETS
    if a.target:
        targets = []
        for t in a.target:
            repo, num = t.rsplit("#", 1)
            targets.append((repo, int(num)))

    rows = []
    for repo, num in targets:
        row = inspect(repo, num)
        verb, why = decide(row)
        row["action"] = verb
        row["why"] = why
        row["result"] = act(row, verb, a.apply)
        rows.append(row)

    if a.json:
        print(json.dumps({"apply": a.apply, "rows": rows}, indent=2))
        return 0
    print(
        f"estate-unblock: {'APPLY' if a.apply else 'DRY RUN'} over {len(rows)} item(s)"
    )
    for r in rows:
        print(
            f"  {r['repo']}#{r['number']:<4} {r['action']:<13} {r.get('state', '')} {r.get('merge', '')} {r.get('review') or ''}"
        )
        if r["why"]:
            print(f"      {r['why']}")
        if r["result"]:
            print(f"      {r['result']}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
