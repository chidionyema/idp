#!/usr/bin/env bash
# The founder's whole part for one provider, in one command, zero copying between windows (R52; crew#618).
#   bin/idp-set-root tailscale | cloudflare | anthropic | openrouter | deepseek | minimax | groq | gemini | exa | stripe | telegram-hermes | telegram-alerts
#
# It opens the provider's page, says exactly what to click and what to type, then asks for each
# value right here with hidden input and hands it straight to `gh secret set` (the repository
# secret is the one root, R52). Nothing is printed back, nothing is written to disk, nothing is
# copied to a clipboard. When every secret is set it dispatches the apply run that mints the rest.
# Founder, 2026-08-29: "its already gone cos we're printing, it's living in console ... should
# come with working instructions or fully automated, either way zero friction."
set -euo pipefail
REPO=${IDP_REPO:-chidionyema/idp}
P=${1:-}; [ -n "$P" ] || { sed -n 3p "$0"; exit 2; }
command -v gh >/dev/null || { echo "FAIL    gh is not installed: brew install gh, then gh auth login"; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "FAIL    gh is not signed in: run gh auth login once"; exit 1; }
open_page() { command -v open >/dev/null && open "$1" || command -v xdg-open >/dev/null && xdg-open "$1" || echo "        open $1"; }
ask() { # ask NAME "what it is"; hidden input, straight into gh, never echoed
  local name=$1 what=$2 v
  printf '        %s (%s): ' "$name" "$what"; IFS= read -rs v; echo
  [ -n "$v" ] || { echo "FAIL    empty value for $name; nothing set"; exit 1; }
  printf %s "$v" | gh secret set "$name" -R "$REPO" >/dev/null; unset v
  echo "ok      $name set on $REPO"
}
case "$P" in
  tailscale)
    echo "Tailscale: one OAuth client, once. The page is opening."
    open_page "https://login.tailscale.com/admin/settings/oauth"
    cat <<'T'
        1. Press "Generate OAuth client".
        2. Description: estateseed
        3. Scopes: tick only "OAuth keys" and choose Write. Leave every other box empty.
        4. Tags, if the form asks: tag:k8s
        5. Press "Generate client". Keep that window open; copy each value when asked below.
T
    ask SEED_TAILSCALE_CLIENT_ID "the Client ID shown"
    ask SEED_TAILSCALE_CLIENT_SECRET "the Client secret shown" ;;
  cloudflare)
    echo "Cloudflare: one root token, once. The page is opening."
    open_page "https://dash.cloudflare.com/profile/api-tokens"
    cat <<'T'
        1. Press "Create Token", then "Custom token", "Get started".
        2. Name: estate-root
        3. Permissions: one row: User / User API Tokens / Edit. Nothing else.
        4. TTL: one year from today.
        5. "Continue to summary", "Create Token". Copy the token when asked below.
T
    ask SEED_CLOUDFLARE_ROOT_TOKEN "the token shown" ;;
  anthropic|openrouter|deepseek|minimax|groq|gemini|exa|stripe)
    IDP=$(cd "$(dirname "$0")/.." && pwd)
    page=$(python3 -c "import yaml,sys;print(yaml.safe_load(open('$IDP/platform/vendors/consoles.yaml'))['vendors']['$P']['page'])")
    name=$(python3 -c "import yaml,sys;print(yaml.safe_load(open('$IDP/platform/vendors/consoles.yaml'))['vendors']['$P']['secret'])")
    echo "$P: one API key, once. The key page is opening."
    open_page "$page"
    echo "        1. Create a key. Name it: estate"
    echo "        2. Copy it when asked below."
    ask "$name" "the key shown" ;;
  telegram-hermes|telegram-alerts)
    [ "$P" = telegram-hermes ] && name=SEED_TELEGRAM_HERMES_BOT_TOKEN || name=SEED_TELEGRAM_ALERTS_BOT_TOKEN
    echo "Telegram: the bot token, once. BotFather is opening."
    open_page "https://t.me/BotFather"
    echo "        1. Send /token and pick the bot (${P#telegram-})."
    echo "        2. Copy the token BotFather answers with, when asked below."
    ask "$name" "the token shown" ;;
  *) echo "FAIL    unknown provider $P"; sed -n 3p "$0"; exit 2 ;;
esac
gh workflow run oke-check.yml -R "$REPO" -f mode=apply >/dev/null && echo "ok      apply run dispatched; the pipeline mints the rest. You are done with $P."
