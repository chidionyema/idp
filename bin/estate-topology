#!/usr/bin/env python3
from __future__ import annotations

import html
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
BASE = HOME / ".estate" / "topology"
TARGETS = BASE / "targets.json"
TOPOLOGY = BASE / "topology.json"
KB = BASE / "KB.md"
METRICS = BASE / "metrics.prom"
SURFACE = BASE / "surface.html"
BACKSTAGE = BASE / "backstage"
PROBE_TIMEOUT = 6


def _dig(host: str) -> str:
    try:
        p = subprocess.run(["dig", "+short", "+time=2", "+tries=1", "A", host],
                           capture_output=True, text=True, timeout=5)
    except (subprocess.SubprocessError, OSError):
        return ""
    for line in p.stdout.splitlines():
        line = line.strip()
        if line and not line.endswith("."):
            return line
    return ""


def _curl(target: dict, ip: str) -> tuple[int, float, str]:
    url = target["url"]
    cmd = ["curl", "-sS", "-m", str(PROBE_TIMEOUT), "-o", "/dev/null",
           "-w", "%{http_code} %{time_total}"]
    if target.get("method") == "POST":
        cmd += ["-X", "POST", "-H", "Content-Type: application/json",
                "-d", target.get("body", "{}")]
    if ip:
        host = url.split("//", 1)[-1].split("/", 1)[0].split(":")[0]
        cmd += ["--resolve", "%s:443:%s" % (host, ip)]
    cmd.append(url)
    t0 = time.time()
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=PROBE_TIMEOUT + 3)
    except (subprocess.SubprocessError, OSError) as exc:
        return 0, (time.time() - t0) * 1000.0, repr(exc)
    parts = (p.stdout or "").strip().split()
    code = int(parts[0]) if parts and parts[0].isdigit() else 0
    latency = float(parts[1]) * 1000.0 if len(parts) > 1 else (time.time() - t0) * 1000.0
    detail = (p.stderr or "").strip().splitlines()[-1][:200] if p.returncode != 0 else ""
    return code, latency, detail


def _tcp(host: str, port: int) -> tuple[bool, float, str]:
    t0 = time.time()
    try:
        with socket.create_connection((host, port), timeout=3):
            return True, (time.time() - t0) * 1000.0, ""
    except OSError as exc:
        return False, (time.time() - t0) * 1000.0, repr(exc)


def probe(target: dict, now: int) -> dict:
    kind = target["kind"]
    ip = _dig(target["url"].split("//", 1)[-1].split("/", 1)[0].split(":")[0]) if kind in ("http", "tls") else ""
    state = "down"
    code = 0
    latency = 0.0
    detail = ""
    if kind in ("http", "tls"):
        code, latency, detail = _curl(target, ip)
        if kind == "http":
            state = "up" if code == target.get("expect", 200) else "down"
        else:
            state = "up" if code and code < 500 else "down"
    elif kind == "tcp":
        opened, latency, detail = _tcp(target["host"], int(target["port"]))
        state = "up" if opened else "down"
    return {
        "id": target["id"],
        "name": target["name"],
        "kind": kind,
        "owner": target.get("owner", "platform"),
        "slo": target.get("slo", 99.0),
        "runbook": target.get("runbook", ""),
        "dns": ip,
        "expect": target.get("expect"),
        "state": state,
        "http_code": code,
        "latency_ms": round(latency, 1),
        "detail": detail,
        "checked_at": now,
    }


def write_atomic(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def render_kb(doc: dict) -> str:
    rows = doc["targets"]
    up = sum(1 for r in rows if r["state"] == "up")
    lines = [
        "# Estate infrastructure knowledge base",
        "",
        "Generated by `estate-topology`. Do not edit by hand: edit `targets.json`, then rerun.",
        "",
        "- collected_at: `%s`" % doc["collected_at_iso"],
        "- targets: `%d` up / `%d` down of `%d`" % (up, len(rows) - up, len(rows)),
        "- topology: `%s`" % TOPOLOGY,
        "",
        "## Doors at a glance",
        "",
        "| id | name | state | code | latency_ms | owner | SLO |",
        "|---|---|---|---|---|---|---|",
    ]
    for r in rows:
        lines.append("| `%s` | %s | %s | %s | %s | %s | %s |" % (
            r["id"], r["name"], r["state"].upper(), r["http_code"] or "-",
            r["latency_ms"], r["owner"], r["slo"]))
    lines += ["", "## Target detail", ""]
    for r in rows:
        lines += [
            "### %s" % r["id"],
            "",
            "- name: %s" % r["name"],
            "- kind: `%s` expect `%s`" % (r["kind"], r["expect"]),
            "- state: **%s** (code `%s`, %s ms)" % (r["state"], r["http_code"] or "-", r["latency_ms"]),
            "- owner: %s, SLO %s%%" % (r["owner"], r["slo"]),
            "- dns: `%s`" % (r["dns"] or "unresolved"),
            "- runbook: `%s`" % r["runbook"],
        ]
        if r["detail"]:
            lines.append("- last error: `%s`" % r["detail"].replace("`", "'"))
        lines.append("")
    lines += [
        "## Dispatch API (for agents)",
        "",
        "| Method | Path | Auth | Purpose |",
        "|---|---|---|---|",
        "| GET | /health | none | liveness |",
        "| GET | /status | none | this topology as JSON |",
        "| GET | /surface | none | founder surface (HTML) |",
        "| GET | /kb | none | this document |",
        "| GET | /metrics | none | Prometheus text |",
        "| GET | /openapi.json | none | action schema |",
        "| GET | /intents | bearer | allowlist |",
        "| POST | /dispatch | bearer | queue an intent; needs goal/given/when/then |",
        "| GET | /dispatch/{run_id} | bearer | poll to a terminal state |",
        "| GET | /agent | bearer | executor, plan gate, ledger, counters |",
        "",
        "## Debug",
        "",
        "- `estate-debug-pack` writes a hashed bundle to `~/.estate/debug-packs/`.",
        "- Re-verify everything: `~/.estate/topology/verify-stack.sh`.",
        "- Evidence for a single run: `~/.estate/dispatch/runs/<run_id>.json`; its `evidence_sha256`",
        "  recomputes after removing that field and canonicalising the rest.",
        "",
    ]
    return "\n".join(lines)


def render_metrics(doc: dict) -> str:
    up = sum(1 for t in doc["targets"] if t["state"] == "up")
    lines = [
        "# HELP estate_topology_collected_timestamp_seconds Unix time the collector last wrote.",
        "# TYPE estate_topology_collected_timestamp_seconds gauge",
        "estate_topology_collected_timestamp_seconds %d" % doc["collected_at"],
        "# HELP estate_targets_total Declared infrastructure targets.",
        "# TYPE estate_targets_total gauge",
        "estate_targets_total %d" % len(doc["targets"]),
        "# HELP estate_targets_up Targets currently answering as declared.",
        "# TYPE estate_targets_up gauge",
        "estate_targets_up %d" % up,
        "# HELP estate_probe_up 1 when the target answers as declared, else 0.",
        "# TYPE estate_probe_up gauge",
    ]
    for t in doc["targets"]:
        lines.append('estate_probe_up{target="%s",kind="%s",owner="%s"} %d' % (
            t["id"], t["kind"], t["owner"], 1 if t["state"] == "up" else 0))
    lines += ["# HELP estate_probe_latency_ms Last probe latency in milliseconds.",
              "# TYPE estate_probe_latency_ms gauge"]
    for t in doc["targets"]:
        lines.append('estate_probe_latency_ms{target="%s"} %s' % (t["id"], t["latency_ms"]))
    lines += ["# HELP estate_probe_http_code Last HTTP status observed (0 when none).",
              "# TYPE estate_probe_http_code gauge"]
    for t in doc["targets"]:
        lines.append('estate_probe_http_code{target="%s"} %s' % (t["id"], t["http_code"]))
    return "\n".join(lines) + "\n"


def render_surface(doc: dict) -> str:
    rows = doc["targets"]
    up = sum(1 for t in rows if t["state"] == "up")
    down = len(rows) - up
    trace = {}
    try:
        trace = json.loads((BASE / "assurance.json").read_text()).get("trace", {})
    except (OSError, ValueError):
        pass
    trs = []
    for t in rows:
        colour = "#17b26a" if t["state"] == "up" else "#e5484d"
        trs.append(
            "<tr><td><span class=dot style=\"background:%s\"></span></td>"
            "<td><b>%s</b><div class=id><a href=/kb#%s>%s</a></div>"
            "<details><summary>why</summary><div class=id>kind=%s dns=%s owner=%s slo=%s<br>%s</div></details></td>"
            "<td>%s</td><td>%s</td><td>%s ms</td><td class=grey>%s</td>"
            "<td><code>%s</code></td></tr>" % (
                colour, html.escape(t["name"]), html.escape(t["id"]), html.escape(t["id"]),
                t["kind"], html.escape(t["dns"] or "-"), html.escape(t["owner"]), t["slo"],
                html.escape(t["detail"] or "answering as declared"),
                t["state"].upper(), t["http_code"] or "-", t["latency_ms"],
                html.escape(t["owner"]), html.escape(t["runbook"])))
    return """<!doctype html><meta charset=utf-8>
<meta name=viewport content="width=device-width,initial-scale=1">
<meta http-equiv=refresh content=30>
<title>Estate infrastructure</title>
<style>
body{font:14px/1.45 -apple-system,system-ui,sans-serif;margin:0;background:#0b0d10;color:#e7e9ee}
main{max-width:1100px;margin:0 auto;padding:20px}
h1{font-size:20px;margin:0 0 4px}.sub{color:#8b93a7;margin-bottom:16px}
.cards{display:flex;gap:12px;margin:14px 0}
.card{background:#141821;border:1px solid #232936;border-radius:10px;padding:12px 16px;min-width:110px}
.card b{font-size:22px;display:block}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%%}
table{width:100%%;border-collapse:collapse;background:#141821;border:1px solid #232936;border-radius:10px;overflow:hidden}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid #1d2330;vertical-align:top}
th{color:#8b93a7;font-weight:600;font-size:12px}
.id,.grey{color:#8b93a7;font-size:12px}
code{font-size:11px;color:#a9b4cc;word-break:break-all}
a{color:#7aa2ff}
@media(max-width:700px){.cards{flex-wrap:wrap}td:nth-child(7),th:nth-child(7){display:none}}
</style>
<main>
<h1>Estate infrastructure</h1>
<div class=sub>generated %s &middot; refresh 30s &middot; <a href=/kb>knowledge base</a> &middot; <a href=/metrics>metrics</a></div>
<div class=cards>
 <div class=card><b>%d</b>up</div>
 <div class=card><b>%d</b>down</div>
 <div class=card><b>%d</b>targets</div>
 <div class=card><b>%s</b>collected</div>
</div>
<table><thead><tr><th></th><th>target</th><th>state</th><th>code</th><th>latency</th><th>owner</th><th>runbook</th></tr></thead>
<tbody>%s</tbody></table>
<div class=sub style="margin-top:12px">A door is up only when it answers as declared. Probes are the real
public path, not a process check.</div>
<div class=sub style="margin-top:8px">last traced instruction: <b>%s</b> exit <b>%s</b> sha <code>%s</code></div>
</main>""" % (doc["collected_at_iso"], up, down, len(rows),
              time.strftime("%H:%M:%SZ", time.gmtime(doc["collected_at"])), "".join(trs),
              trace.get("intent", "-"), trace.get("exit_code", "-"),
              (trace.get("evidence_sha256") or "-")[:16])


def render_backstage(doc: dict) -> str:
    parts = [
        "apiVersion: backstage.io/v1alpha1",
        "kind: Domain",
        "metadata:",
        "  name: estate",
        "  description: The chidionyema estate",
        "spec:",
        "  owner: platform",
        "---",
        "apiVersion: backstage.io/v1alpha1",
        "kind: System",
        "metadata:",
        "  name: estate-infra",
        "  description: Public doors, the governed intent door and the dispatch plane. Generated by estate-topology.",
        "  annotations:",
        "    estate.io/collected-at: \"%s\"" % doc["collected_at_iso"],
        "spec:",
        "  owner: platform",
        "  domain: estate",
        "",
    ]
    for t in doc["targets"]:
        parts += [
            "---",
            "apiVersion: backstage.io/v1alpha1",
            "kind: Component",
            "metadata:",
            "  name: %s" % t["id"],
            "  description: \"%s (%s)\"" % (t["name"].replace('"', "'"), t["state"]),
            "  annotations:",
            "    estate.io/probe-state: \"%s\"" % t["state"],
            "    estate.io/runbook: \"%s\"" % t["runbook"].replace('"', "'"),
            "  links:",
            "    - title: Founder surface",
            "      url: https://dispatch.mumchimp.com/surface",
            "    - title: Knowledge base",
            "      url: https://dispatch.mumchimp.com/kb",
            "spec:",
            "  type: service",
            "  lifecycle: production",
            "  owner: %s" % t["owner"],
            "  system: estate-infra",
            "  providesApis: []",
            "",
        ]
    return "\n".join(parts)


def push_target(now: int) -> dict:
    state = {"at": 0}
    try:
        state = json.loads((BASE / "push-state.json").read_text())
    except (OSError, ValueError):
        pass
    age = now - int(state.get("at") or 0)
    bench = (state.get("endpoint") or "") in ("127.0.0.1:4319", "localhost:4319")
    ok = bool(state.get("ok")) and age < 180 and not bench
    reason = ""
    if not ok:
        reason = ("bench endpoint; no cloud credential yet" if bench else
                  state.get("reason") or ("stale %ss" % age if state.get("ok") else "status=%s" % state.get("status")))
    return {
        "id": "grafana-cloud-push",
        "name": "Grafana Cloud metrics",
        "kind": "push",
        "owner": "platform",
        "slo": 99.0,
        "runbook": "estate-metrics-push --strict; vault entry grafana-cloud (url, user, token)",
        "dns": state.get("endpoint") or "",
        "expect": 200,
        "state": "up" if ok else "down",
        "http_code": state.get("status") or 0,
        "latency_ms": 0.0,
        "detail": "" if ok else reason,
        "checked_at": now,
    }


def bws_target(now: int) -> dict:
    path = HOME / ".estate" / "secrets" / "bws" / "status.json"
    st = {"state": "down", "reason": "sync never ran", "at": 0}
    try:
        st = json.loads(path.read_text())
    except (OSError, ValueError):
        pass
    age = now - int(st.get("at") or 0)
    healthy = st.get("state") == "ok" and age < 120
    reason = "" if healthy else (st.get("reason") or st.get("state") or "unknown")
    return {
        "id": "bitwarden-sync",
        "name": "Bitwarden Secrets sync",
        "kind": "push",
        "owner": "platform",
        "slo": 99.9,
        "runbook": "estate-bws-sync --once; vault entry bitwarden-machine; audit ~/.estate/secrets/bws/audit.jsonl",
        "dns": "api.bitwarden.com",
        "expect": 200,
        "state": "up" if healthy else "down",
        "http_code": 0,
        "latency_ms": 0.0,
        "detail": "" if healthy else "%s (%ss ago)" % (reason, age),
        "checked_at": now,
    }


def grade_target(now: int) -> dict:
    st = {"critical_ok": False, "at": 0, "gaps": 0}
    try:
        st = json.loads((BASE / "grade-state.json").read_text())
    except (OSError, ValueError):
        pass
    age = now - int(st.get("at") or 0)
    healthy = bool(st.get("critical_ok")) and age < 900
    return {
        "id": "service-grade",
        "name": "Service grade (conformance)",
        "kind": "push",
        "owner": "platform",
        "slo": 100.0,
        "runbook": "estate-service-grade --pack; ~/.estate/topology/GRADE.md",
        "dns": "",
        "expect": 100,
        "state": "up" if healthy else "down",
        "http_code": 0,
        "latency_ms": 0.0,
        "detail": "" if healthy else ("%d gap(s), worst %s/%s, %ss ago" % (
            st.get("gaps", 0), st.get("worst", 0), st.get("max", 8), age)),
        "checked_at": now,
    }


def assurance_target(now: int) -> dict:
    st = {"ok": False, "at": 0, "pass": 0, "fail": 0}
    try:
        st = json.loads((BASE / "assurance-state.json").read_text())
    except (OSError, ValueError):
        pass
    age = now - int(st.get("at") or 0)
    healthy = bool(st.get("ok")) and age < 3600
    return {
        "id": "assurance-selftest",
        "name": "Assurance self-test",
        "kind": "push",
        "owner": "platform",
        "slo": 100.0,
        "runbook": "estate-assurance-selftest; ~/.estate/topology/ASSURANCE.md",
        "dns": "",
        "expect": 10,
        "state": "up" if healthy else "down",
        "http_code": 0,
        "latency_ms": 0.0,
        "detail": "" if healthy else "last result %s/%s, %ss ago" % (
            st.get("pass", 0), st.get("pass", 0) + st.get("fail", 0), age),
        "checked_at": now,
    }


def main() -> int:
    targets = json.loads(TARGETS.read_text())
    now = int(time.time())
    doc = {
        "collected_at": now,
        "collected_at_iso": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        "host": socket.gethostname(),
        "targets": [probe(t, now) for t in targets] + [push_target(now), bws_target(now), grade_target(now), assurance_target(now)],
    }
    write_atomic(TOPOLOGY, json.dumps(doc, indent=2, sort_keys=True) + "\n")
    write_atomic(KB, render_kb(doc))
    write_atomic(METRICS, render_metrics(doc))
    write_atomic(SURFACE, render_surface(doc))
    write_atomic(BACKSTAGE / "estate-infra.yaml", render_backstage(doc))
    up = sum(1 for t in doc["targets"] if t["state"] == "up")
    print("topology %s targets=%d up=%d down=%d" % (
        doc["collected_at_iso"], len(doc["targets"]), up, len(doc["targets"]) - up))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
