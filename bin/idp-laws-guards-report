#!/usr/bin/env python3
"""Generate docs/reference/laws-and-guards.md: the fifty laws and every guard that enforces them.

Founder, 2026-08-28: "report of all laws, guard operations and output, with descriptions" and
"as a generated TechDocs page". Nothing here is typed by hand: the laws table is read from the
laws file, the guard order per hook event from the harness settings file,
and each guard's description is the first line of its own docstring. Run it, commit the page.

  bin/idp-laws-guards-report            # rewrites docs/reference/laws-and-guards.md
  bin/idp-laws-guards-report --check    # exit 1 if the committed page is stale

The guards checkout is CLAUDE_GUARDS_DIR (default ~/.claude/scripts, the live tree); the laws
file is LAWS_FILE (default ~/AGENTS.md); the settings file is CLAUDE_SETTINGS_FILE (default
settings.json beside the guards checkout). LAW 46: no path is a literal.
"""
from __future__ import annotations

import ast
import functools
import json
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
OUT = ROOT / "docs" / "reference" / "laws-and-guards.md"
GUARDS = pathlib.Path(os.environ.get("CLAUDE_GUARDS_DIR") or pathlib.Path.home() / ".claude" / "scripts")
LAWS = pathlib.Path(os.environ.get("LAWS_FILE") or pathlib.Path.home() / "AGENTS.md")
SETTINGS = pathlib.Path(os.environ.get("CLAUDE_SETTINGS_FILE") or GUARDS.parent / "settings.json")
EVENTS = ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Stop"]
RUNNER = "hook-run.py"


def laws_table() -> list[tuple[str, str, str]]:
    rows = []
    for line in LAWS.read_text(errors="replace").splitlines():
        m = re.match(r"\|\s*(\d+)\s*\|\s*(.+?)\s*\|\s*(.+?)\s*\|\s*$", line)
        if m:
            rows.append((m.group(1), m.group(2), m.group(3)))
    return rows


@functools.cache
def _hooks() -> dict:
    """`settings.json` IS the guard order: per event, in order, the command the harness runs.

    Until 2026-08-29 this read `policy/adapters.rego` in the guards checkout. That file is on no
    branch of the guards repo -- not HEAD, not origin/main -- so the generator raised
    FileNotFoundError on every real run and the committed page could not be regenerated, while
    the test below passed because its fixture tree wrote one. The page's own first sentence
    claimed a door (`opa-hook.py`) that the settings file does not route the other guards through.
    """
    try:
        return json.loads(SETTINGS.read_text()).get("hooks", {})
    except FileNotFoundError:
        sys.exit(f"no harness settings file at {SETTINGS}; set CLAUDE_SETTINGS_FILE")
    except json.JSONDecodeError as exc:
        sys.exit(f"{SETTINGS} is not valid JSON: {exc}")


def adapter_rows(event: str) -> list[tuple[str, list[str]]]:
    """[(script, tools)] for one hook event, in the order the harness runs them."""
    out = []
    for row in _hooks().get(event, []):
        matcher = (row.get("matcher") or "").strip()
        tools = [] if matcher in ("", "*") else [tool for tool in matcher.split("|") if tool]
        for hook in row.get("hooks", []):
            #: `python3 .../hook-run.py .../goal-guard.py`: the guard is the last .py, and the
            #: runner is not a guard. One guard under two matchers is two rows, as it runs.
            names = [n for n in re.findall(r"([A-Za-z0-9_.-]+\.py)", hook.get("command", ""))
                     if n != RUNNER]
            if names:
                out.append((names[-1], tools))
    return out


def describe(script: str) -> str:
    p = GUARDS / script
    try:
        doc = ast.get_docstring(ast.parse(p.read_text(errors="replace"))) or ""
    except (OSError, SyntaxError):
        return "(no docstring)"
    first = next((ln.strip() for ln in doc.splitlines() if ln.strip()), "")
    return first.rstrip(".") or "(no docstring)"


def laws_cited(script: str) -> str:
    try:
        text = (GUARDS / script).read_text(errors="replace")
    except OSError:
        return ""
    nums = sorted({int(n) for n in re.findall(r"\bLAW\s+(\d{1,2})\b", text)})
    return ", ".join(str(n) for n in nums)


def render() -> str:
    sha = subprocess.run(["git", "-C", str(GUARDS), "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip() or "?"
    lines = ["# Laws and guards", "",
             f"Generated by `bin/idp-laws-guards-report` from the laws file, the guards tree at `{sha}` and the "
             "harness settings file. Do not edit by hand; run the script and commit. The settings file names, per "
             "hook event and in the order below, every command the harness runs; `hook-run.py` runs each guard and "
             "writes its ledger row, and `opa-hook.py` is one of the guards, not a door in front of them.", ""]
    laws = laws_table()
    lines += [f"## The {len(laws)} laws", "", "| # | Law | Fires |", "|---|---|---|"]
    lines += [f"| {n} | {law} | {fires} |" for n, law, fires in laws]
    lines += ["", "When two laws want different things, the lower number wins. Full prose: `~/AGENTS-FULL.md`.", ""]
    total = 0
    events = 0
    for event in EVENTS:
        rows = adapter_rows(event)
        if not rows:
            continue
        total += len(rows)
        events += 1
        lines += [f"## {event}: {len(rows)} guards, in this order", "",
                  "| # | Guard | What it does | Laws it cites | Tools |", "|---|---|---|---|---|"]
        for i, (script, tools) in enumerate(rows, 1):
            lines.append(f"| {i} | `{script}` | {describe(script)} | {laws_cited(script) or '—'} | {', '.join(tools) or 'every tool'} |")
        lines.append("")
    lines += ["## How a guard answers", "",
              "A guard prints nothing and exits 0 to pass. It refuses with exit 2 and the reason on stderr, or with "
              "`{\"decision\": \"block\", \"reason\": ...}` on stdout. A guard that crashes or exceeds its budget is "
              "`NoVerdict`, and the door answers no (fail-closed). Every run is a row in the hook ledger "
              "(`hook-run.py`), which is where a claim that a guard ran is checked.", "",
              f"Total: {total} guard rows across {events} events."]
    return "\n".join(lines) + "\n"


def main() -> int:
    text = render()
    if "--check" in sys.argv:
        if OUT.exists() and OUT.read_text() == text:
            return 0
        print(f"{OUT.relative_to(ROOT)} is stale; run bin/idp-laws-guards-report", file=sys.stderr)
        return 1
    OUT.write_text(text)
    print(f"wrote {OUT.relative_to(ROOT)} ({len(text)} bytes)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
