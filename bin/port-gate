#!/usr/bin/env python3
"""port-gate: a port is bound only if catalog/ports.yaml says so.

  port-gate            static: every compose publication in this repo is declared
  port-gate --live     plus: every listener the KERNEL reports is declared or foreign

Exit 0 clean, 1 on any undeclared bind, doubled claim, or non-loopback bind that
ports.yaml does not mark non_loopback (R20), or a bind address that differs from a
row's declared `bind:`. Prints one line per finding.
REG can be overridden so bin/idp-ci can prove it both ways on fixtures. INV can be
set to a captured inventory to replay a fixture; when it is unset --live asks the
kernel directly and no file is involved. See live_rows() for why.
"""
import glob
import json
import os
import re
import subprocess
import sys

import yaml

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REG = os.environ.get("REG") or os.path.join(IDP, "catalog", "ports.yaml")
INV = os.environ.get("INV")      # unset => --live asks the kernel; see live_rows()
COMPOSE = os.environ.get("COMPOSE_GLOB") or "board/*.yml llm/*.yml mcp/*.yml observability/*.yml"
PUB = re.compile(r'^\s*-\s*"?(?:(?P<host>[\d.]+):)?(?P<port>\d+):\d+"?\s*$')


def live_rows():
    """Listeners from the kernel, right now. Returns None if it could not look.

    `--live` used to read ~/.estate/state/inventory.json, and a file is a claim
    about the past, not about the machine. That snapshot is rebuilt by
    com.estate.inventory on a StartCalendarInterval of 01:13, 07:13, 13:13, 19:13 --
    every six hours -- so the gate could grade a state that was true six hours ago.

    Both directions of that lag are wrong and only one of them is visible. Measured
    2026-08-24 22:53: the snapshot still reported listeners on 80 and 443 two
    minutes after k3d had stopped, which is a FAIL on a port nobody holds -- noisy,
    but safe. The same lag reversed is a port opened after the last rebuild, absent
    from the file, and therefore reported by a security gate as ok. That is the
    silent miss, and it is the one this function exists to remove.
    """
    try:
        out = subprocess.run(["lsof", "-nP", "-iTCP", "-sTCP:LISTEN"],
                             capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return None
    if not out.stdout.strip():
        # No output and a bad status means lsof could not look. No output with a
        # good status would mean a machine with zero listeners, which this one is
        # not; either way, reporting "0 findings" here would be a verdict drawn
        # from an empty reading.
        return None
    seen, rows = set(), []
    for line in out.stdout.splitlines()[1:]:
        f = line.split()
        if len(f) < 9:
            continue
        m = re.match(r"^(.*):(\d+)$", f[8])
        if not m:
            continue
        addr, port = m.group(1), int(m.group(2))
        bind = addr[1:-1] if addr.startswith("[") and addr.endswith("]") else addr
        key = (port, bind, f[0])
        if key in seen:          # lsof lists a dual-stack listener once per family
            continue
        seen.add(key)
        rows.append({"kind": "listener", "port": port, "bind": bind,
                     "process": f[0], "owner": f[0]})
    return rows


def main() -> int:
    reg = yaml.safe_load(open(REG)) or {}
    declared = {}
    bad = 0
    for e in reg.get("ports") or []:
        if e["port"] in declared:
            print(f"FAIL  ports    {e['port']} declared twice: {declared[e['port']]['service']}, {e['service']}")
            bad += 1
        declared[int(e["port"])] = e

    # static: compose publications
    for pat in COMPOSE.split():
        for f in sorted(glob.glob(os.path.join(IDP, pat))):
            svc = None
            for n, line in enumerate(open(f), 1):
                m = re.match(r"^  ([A-Za-z0-9_-]+):\s*$", line)
                if m:
                    svc = m.group(1)
                m = PUB.match(line)
                if not m:
                    continue
                port, host = int(m.group("port")), m.group("host") or "0.0.0.0"
                rel = os.path.relpath(f, IDP)
                d = declared.get(port)
                if not d:
                    print(f"FAIL  ports    {rel}:{n} publishes {port} for {svc}: not in catalog/ports.yaml")
                    bad += 1
                elif d["service"] != svc:
                    print(f"FAIL  ports    {rel}:{n} publishes {port} as {svc}; ports.yaml gives it to {d['service']}")
                    bad += 1
                if host not in ("127.0.0.1", "::1") and not (d or {}).get("non_loopback"):
                    print(f"FAIL  ports    {rel}:{n} binds {host}:{port}; R20 allows only the gateway off loopback")
                    bad += 1

    substrate = {r["port"]: r for r in (reg.get("substrate") or [])}
    eph = reg.get("ephemeral") or [49152, 65535]
    eph_lo, eph_hi = int(eph[0]), int(eph[1])

    if "--live" in sys.argv:
        if INV:
            # Explicit INV replays a captured reading. bin/idp-ci uses it to prove
            # this gate both ways on fixtures; nothing else should set it.
            if not os.path.exists(INV):
                print(f"BLIND ports    no inventory at {INV}; live check not run")
                return 1
            rows = json.load(open(INV)).get("rows", [])
        else:
            rows = live_rows()
            if rows is None:
                print("BLIND ports    could not read listeners from the kernel; live check not run")
                return 1
        for r in rows:
            if r.get("kind") != "listener":
                continue
            port, proc = int(r["port"]), r.get("process", "")
            if eph_lo <= port <= eph_hi:
                continue
            # There is no process-name exemption. A list of trusted process names
            # was the defect: colima republishes every container port as `limactl`,
            # so naming that process exempted every containerised service in the
            # estate. Founder directive 2026-08-24 -- a process holding a port is
            # making a claim, not earning an exemption. Substrate ports we do not
            # own are declared per port in ports.yaml, with an owner and a reason.
            sub = substrate.get(port)
            if sub:
                if sub.get("owner") and proc and not sub["owner"].lower().startswith(proc.lower()[:8]):
                    print(f"FAIL  ports    live listener {port} is held by {proc}; ports.yaml declares substrate owner {sub['owner']}")
                    bad += 1
                continue
            d = declared.get(port)
            if not d:
                print(f"FAIL  ports    live listener {port} ({r.get('owner')}) is not in catalog/ports.yaml")
                bad += 1
            want = (d or {}).get("bind")
            seen = "[::1]" if r.get("bind") == "::1" else r.get("bind")
            if want and seen != want:
                # Declaring 127.0.0.1:7107 and binding *:7107 is the exact shape closed on 2026-08-24.
                print(f"FAIL  ports    live listener {port} ({r.get('owner')}) binds {seen}; ports.yaml declares {want}")
                bad += 1
            if r.get("bind") not in ("127.0.0.1", "[::1]", "::1") and not (d or {}).get("non_loopback"):
                if proc != "ssh" or d:   # ssh forwards to k3d etc. are the founder's, listed as not gated
                    print(f"FAIL  ports    live listener {port} ({r.get('owner')}) binds {r.get('bind')}; R20")
                    bad += 1
    print(f"{'FAIL' if bad else 'ok  '}  ports    {len(declared)} declared, {bad} findings")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
