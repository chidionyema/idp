#!/usr/bin/env bash
# estate-security-scan: the "Security passes" evidence named by the Definition
# of Done v2.1 (docs/reference/policy/definition-of-done.md, Gate 3 and section 3.3).
#
# Four questions, each answered by a mature tool rather than by this file:
#
#   1. Static secrets in the codebase = 0     gitleaks   (git history, so every
#                                                          tracked byte ever committed)
#   2. Unaudited dependencies = 0             pip-audit  (every requirements*.txt)
#   3. Policy contradiction = 0               bin/security-policy-gate (every control
#                                                          row names a proof that exists)
#   4. Container image vulnerabilities = 0    Trivy Operator (platform/trivy, crew#846):
#                                                          its own VulnerabilityReport CRDs,
#                                                          read live through bin/idp-kube
#
# Output is the receipt: a header with the UTC timestamp and the commit hash, one
# line per check, and a last line SECURITY-SCAN PASS|FAIL|BLIND. Exit 0 on PASS,
# 1 on FAIL, 3 on BLIND. BLIND means a tool is missing so the check could not run;
# a guard that loses its evidence reports BLIND, never a verdict (LAW 45). CI
# installs the tools, so BLIND there is a broken job, and non-zero blocks merge.
#
# Untracked files (llm/.env and friends) are not the codebase and are not scanned
# here: they are git-ignored and never leave the machine. `gitleaks protect
# --staged` is the pre-commit fence for what is about to become the codebase.
#
#   estate-security-scan                 run all checks on this checkout, print the receipt
#   estate-security-scan --quiet         receipt only, no tool chatter
#   estate-security-scan --source DIR    scan another repository (the composite action
#                                        .github/actions/security-scan runs it this way
#                                        from every active estate repo)
#
# Checks 2 and 3 adapt to the repository: pip-audit runs only where a tracked
# requirements*.txt exists, npm audit only where a tracked package-lock.json
# exists, and the policy gate only where bin/security-policy-gate exists. A
# check with nothing to scan prints "ok ... none tracked", never BLIND.
#
# Check 4 is cluster-wide, not per-repository: it runs only from the checkout that
# carries bin/idp-kube (idp itself). A product repository scanned with --source has
# no cluster of its own to ask and prints "ok ... no bin/idp-kube", never BLIND.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$IDP"; quiet=0
while [ $# -gt 0 ]; do
  case "$1" in
    --quiet) quiet=1 ;;
    --source) SRC="$(cd "$2" && pwd)" || exit 3; shift ;;
    *) echo "usage: estate-security-scan [--quiet] [--source DIR]" >&2; exit 3 ;;
  esac; shift
done
cd "$SRC" || exit 3
fail=0; blind=0
say() { printf '%s\n' "$*"; }

# idp#7080: a dependency advisory is judged against the ref the change is measured from.
#
# ESTATE_DEPS_BASE names that ref. An advisory whose pin the change did NOT move is
# pre-existing: it is reported and deferred, and it does not hold the change. An advisory
# whose pin the change DID move is the change's own, and fails the gate exactly as before.
# Without the var (or with a base that does not resolve here) every advisory gates, as before.
#
# The judgement compares pins, not advice: the same package at the same version on both refs
# is the same code, so the same advisory, and the diff did not bring it. A package the base
# did not pin at all, or pinned at another version, is not deferrable -- it is this change's.
#
# The state of a ref is read from its own tree, so the comparison is exactly "what the two
# refs pin", never "what a tool says today".
DEPS_BASE="${ESTATE_DEPS_BASE:-}"
DEPS_FINDINGS=""
DEPS_REMAINING=""
DEPS_DEFERRED=0

deps_base_active() {
  [ -n "$DEPS_BASE" ] || return 1
  git rev-parse -q --verify "${DEPS_BASE}^{commit}" >/dev/null 2>&1
}

# The dependency state of a ref, as JSON:
#   {"python": {"<name>": "<version>"},
#    "npm": {"<lock path>": {"<name>": ["<version>", ...]}}}
deps_state() {
  python3 - "$1" <<'PY'
import json, re, subprocess, sys

ref = sys.argv[1]


def git(*a):
    p = subprocess.run(["git", *a], capture_output=True, text=True)
    return p.stdout if p.returncode == 0 else ""


def norm(n):
    return re.sub(r"[-_.]+", "-", n.strip().lower())


state = {"python": {}, "npm": {}}
for f in [x for x in git("ls-tree", "-r", "--name-only", ref).splitlines() if x.strip()]:
    if re.search(r"(^|/)requirements[^/]*\.txt$", f):
        for line in git("show", f"{ref}:{f}").splitlines():
            line = line.split("#", 1)[0].strip()
            m = re.match(r"^([A-Za-z0-9._-]+)\s*==\s*([^\s;]+)$", line)
            if m:
                state["python"][norm(m.group(1))] = m.group(2)
    elif f.endswith("package-lock.json"):
        try:
            doc = json.loads(git("show", f"{ref}:{f}"))
        except Exception:
            continue
        vers = {}
        for key, meta in (doc.get("packages") or {}).items():
            m = re.search(r"node_modules/(.+)$", key)
            if not m or not isinstance(meta, dict):
                continue
            v = meta.get("version")
            if v:
                vers.setdefault(m.group(1), []).append(v)
        state["npm"][f] = {k: sorted(set(v)) for k, v in vers.items()}
print(json.dumps(state))
PY
}

# One pip-audit run. With a base to judge against it is asked for its JSON report as
# well, so the judgement costs no second resolution and no second five-minute install;
# the text it printed is kept beside it, because the resolution failures this check has
# always read are on stderr.
pa_run() {
  PA_TEXT=""; PA_JSON=""
  local errf; errf=$(mktemp)
  if deps_base_active; then
    # shellcheck disable=SC2086
    # No bound here (2026-10-25, ADR 0043): `timeout 240` was larger than the 100s door that runs
    # this script, so it could never fire inside the estate and only ever hid a hang in CI as an
    # empty advisory list -- a false "clean". The door bounds the run; a CI job has its own timeout.
    PA_JSON=$($PA "$@" --progress-spinner off --format=json 2>"$errf"); PA_RC=$?
    PA_TEXT="$(cat "$errf")"
  else
    # shellcheck disable=SC2086
    PA_TEXT=$($PA "$@" --progress-spinner off 2>&1); PA_RC=$?
  fi
  rm -f "$errf"
  return 0
}

# One finding per line: py<TAB>name<TAB>version<TAB>id
deps_collect_python_json() {
  python3 -c 'import json, sys
try:
    doc = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for dep in doc.get("dependencies") or []:
    name = dep.get("name")
    ver = dep.get("version")
    for v in dep.get("vulns") or []:
        vid = v.get("id")
        if name and vid:
            print(f"py\t{name}\t{ver}\t{vid}")'
}

# Judge the collected findings against the base ref. Prints one note per deferred
# finding and leaves the findings that are this change's own in DEPS_REMAINING.
deps_judge() {
  DEPS_REMAINING=""; DEPS_DEFERRED=0
  [ -n "$DEPS_FINDINGS" ] || return 1
  deps_base_active || return 1
  local tf; tf=$(mktemp -d) || return 1
  deps_state "$DEPS_BASE" > "$tf/base.json"
  deps_state "HEAD" > "$tf/head.json"
  printf '%s\n' "$DEPS_FINDINGS" > "$tf/findings"
  local verdict
  verdict=$(python3 - "$tf/findings" "$tf/base.json" "$tf/head.json" <<'PY'
import json, re, sys

findings_path, base_path, head_path = sys.argv[1:4]
base = json.load(open(base_path))
head = json.load(open(head_path))


def norm(n):
    return re.sub(r"[-_.]+", "-", n.strip().lower())


for line in open(findings_path):
    parts = line.rstrip("\n").split("\t")
    if not parts or not parts[0]:
        continue
    if parts[0] == "py":
        _, name, version, vid = parts
        ok = base["python"].get(norm(name)) == version
        shown = f"{name} {version}"
    else:
        _, lock, name, vid = parts
        b = base["npm"].get(lock, {}).get(name) or []
        h = head["npm"].get(lock, {}).get(name) or []
        ok = bool(b) and b == h
        shown = f"{name} {'/'.join(h) if h else 'unpinned'}"
    print(("DEFER\t" if ok else "KEEP\t") + "\t".join([vid, shown]))
PY
)
  local kind vid shown
  while IFS=$'\t' read -r kind vid shown; do
    case "$kind" in
      DEFER)
        DEPS_DEFERRED=$((DEPS_DEFERRED + 1))
        say "note  deps      deferred $vid: $shown is pinned the same way on $DEPS_BASE, so this change did not bring it"
        ;;
      KEEP)
        DEPS_REMAINING="${DEPS_REMAINING}${vid} (${shown})  "
        ;;
    esac
  done <<< "$verdict"
  [ "$DEPS_DEFERRED" -gt 0 ] && [ -z "$DEPS_REMAINING" ]
}

# The dependency check found something. Judge it against the base ref: an advisory the
# change did not bring is reported and does not hold the change.
deps_fail() {
  local label="$1" evidence="$2"; shift 2
  if deps_judge; then
    say "ok    deps      pip-audit: every finding is pre-existing on $DEPS_BASE and this change moved no vulnerable pin; deferred"
    return 0
  fi
  say "FAIL  deps      pip-audit${label:+ ($label)}"
  if [ -n "$DEPS_FINDINGS" ]; then
    local kind name version vid
    while IFS=$'\t' read -r kind name version vid; do
      say "      finding: $name $version $vid"
    done <<< "$DEPS_FINDINGS"
    [ -z "$DEPS_REMAINING" ] || say "      not pre-existing on $DEPS_BASE: $DEPS_REMAINING"
  else
    [ $quiet = 1 ] || printf '%s\n' "$evidence" | tail -15 | sed 's/^/      /'
  fi
  fail=1
  return 1
}

say "SECURITY-SCAN $(date -u +%Y-%m-%dT%H:%M:%SZ) commit=$(git rev-parse HEAD) tree=$(git status --porcelain | grep -vc '^?? .estate-idp/')-dirty-paths"
if [ -n "$DEPS_BASE" ]; then
  if deps_base_active; then
    say "note  deps      judging dependency advisories against $DEPS_BASE ($(git rev-parse --short "${DEPS_BASE}^{commit}")): an advisory this change did not bring is reported and deferred"
  else
    say "note  deps      ESTATE_DEPS_BASE=$DEPS_BASE does not resolve here; every dependency advisory gates, as it did before"
  fi
fi

# 1. secrets, over git history: every tracked byte in every commit REACHABLE FROM
# HEAD. Without --log-opts gitleaks walks every fetched ref, and CI checks out with
# fetch-depth 0, so one literal on an unmerged peer branch reddened every open PR
# (2026-08-27 21:00Z, idp#479 #486-#492; crew#539 branch commit 3bf04ab). A branch
# may only fail its own PR; a leak reaches main only through a PR whose HEAD holds it.
#
# idp#6606: ESTATE_SCAN_BASE=<ref> scans only <ref>..HEAD -- the commits this checkout adds. A
# Greenlane candidate is main plus its lanes, and every commit already on main was scanned in the
# candidate that landed it, so walking all of history again was 129 of this job's 191 s on every
# batch (run 39298091203). The push to main sets no base and keeps the full walk. A base that does
# not resolve is not a reason to scan less: it falls back to the full history, and says so.
check_secrets() {
if command -v gitleaks >/dev/null; then
  local range=HEAD scope="git history"
  if [ -n "${ESTATE_SCAN_BASE:-}" ]; then
    if git rev-parse -q --verify "${ESTATE_SCAN_BASE}^{commit}" >/dev/null; then
      range="${ESTATE_SCAN_BASE}..HEAD"; scope="the $(git rev-list --count "$range") commit(s) $ESTATE_SCAN_BASE..HEAD adds"
    else
      scope="git history (base $ESTATE_SCAN_BASE does not resolve here; scanned everything)"
    fi
  fi
  if out=$(gitleaks detect --source . --log-opts="$range" --redact --no-banner --exit-code 1 2>&1); then
    say "ok    secrets   gitleaks $(gitleaks version): no leaks in $scope"
  else
    say "FAIL  secrets   gitleaks found leaks in git history"; [ $quiet = 1 ] || printf '%s\n' "$out" | tail -20 | sed 's/^/      /'; fail=1
  fi
else
  say "BLIND secrets   gitleaks not on PATH (brew install gitleaks)"; blind=1
fi
}

# 2. dependencies: every requirements file, one pip-audit run each.
check_deps() {
PA=""
if command -v pip-audit >/dev/null; then PA="pip-audit";
elif command -v uvx >/dev/null; then PA="uvx pip-audit"; fi
reqs=$(git ls-files | grep -E '(^|/)requirements[^/]*\.txt$')
# Recorded dismissals: a TRACKED .pip-audit-ignores file in the scanned repository,
# one advisory per line: "<ID> <reason>". The reason is mandatory: an unexplained
# dismissal is an unaudited dependency and fails the scan. Each ID rides pip-audit's
# own --ignore-vuln flag, and every dismissal is printed in the receipt, so nothing
# is silenced invisibly. An untracked file is not the codebase and is not read.
ig=()
if git ls-files --error-unmatch .pip-audit-ignores >/dev/null 2>&1; then
  while IFS= read -r iline; do
    case "$iline" in ''|'#'*) continue ;; esac
    iid=${iline%% *}; ireason=${iline#* }
    if [ "$ireason" = "$iline" ] || [ -z "$(printf '%s' "$ireason" | tr -d '[:space:]')" ]; then
      say "FAIL  deps      .pip-audit-ignores entry $iid has no reason; an unexplained dismissal is refused"; fail=1
      continue
    fi
    ig+=(--ignore-vuln "$iid")
    say "note  deps      dismissed $iid: $(printf '%s' "$ireason" | cut -c1-160)"
  done < .pip-audit-ignores
fi
if [ -z "$PA" ]; then
  say "BLIND deps      pip-audit not on PATH (pipx install pip-audit, or uv)"; blind=1
elif [ -z "$reqs" ]; then
  say "ok    deps      no requirements*.txt tracked"
else
  # one resolver run over every file: per-file runs each re-resolve the tree
  # and the three together exceeded five minutes on the founder machine.
  args=(); for r in $reqs; do args+=(-r "$r"); done
  # one resolver run over every file: per-file runs each re-resolve the tree
  # and the three together exceeded five minutes on the founder machine.
  # idp#7080: with a base to judge against, this same run is also asked for its JSON
  # report, so the findings are named by package and version and the judgement costs
  # no second resolution.
  pa_run "${args[@]}" ${ig[@]+"${ig[@]}"}
  rc=$PA_RC; out="$PA_TEXT"
  DEPS_FINDINGS=""
  if [ $rc = 0 ]; then
    say "ok    deps      pip-audit over $(( ${#args[@]} / 2 )) requirements files: no known vulnerabilities"
  elif [ $rc = 124 ]; then
    say "BLIND deps      pip-audit exceeded 240s (network); rerun"; blind=1
  elif printf '%s' "$PA_TEXT$PA_JSON" | grep 'Failed to install packages' >/dev/null ; then
    # The joint environment could not be built. Before giving up on resolution, try each
    # file on its own: two files may pin the same package apart ON PURPOSE because they
    # feed two interpreters (crew#712, 2026-08-30: requirements-research.txt openai<3 for
    # litellm, requirements-grade.txt openai>=3.1 for Inspect). Each file still resolves
    # and is fully audited; only their union is impossible.
    perfile_rc=0; perfile_out=""; perfile_install=0
    for r in $reqs; do
      pa_run -r "$r" ${ig[@]+"${ig[@]}"}
      c=$PA_RC
      if [ $c = 124 ]; then perfile_rc=124; break; fi
      if [ $c != 0 ]; then
        if printf '%s' "$PA_TEXT$PA_JSON" | grep 'Failed to install packages' >/dev/null; then perfile_install=1; else perfile_rc=1; perfile_out="$perfile_out
$r:
$PA_TEXT"; DEPS_FINDINGS="${DEPS_FINDINGS}$(printf '%s' "$PA_JSON" | deps_collect_python_json)
"; fi
      fi
    done
    if [ $perfile_rc = 124 ]; then
      say "BLIND deps      pip-audit exceeded 240s (network); rerun"; blind=1
    elif [ $perfile_install = 0 ] && [ $perfile_rc = 0 ]; then
      say "ok    deps      pip-audit over $(( ${#args[@]} / 2 )) requirements files, resolved one file at a time (their union does not install): no known vulnerabilities"
    elif [ $perfile_install = 0 ]; then
      deps_fail "resolved one file at a time" "$perfile_out"
    else
    # pip-audit could not build the environment (a package with no wheel and no build
    # deps, or a pin that is not on the index). That is not an advisory, so it is not a
    # FAIL: audit the pins as written, without resolving or installing anything.
    why=$(printf '%s' "$PA_TEXT$PA_JSON" | grep -m1 -oE 'No matching distribution found for [^ ]+|No module named [^ ]+' || echo "see pip-audit output")
    pa_run "${args[@]}" ${ig[@]+"${ig[@]}"} --no-deps --disable-pip
    rc2=$PA_RC; out2="$PA_TEXT"
    if [ $rc2 = 0 ]; then
      say "ok    deps      pip-audit over $(( ${#args[@]} / 2 )) requirements files: no known vulnerabilities (pins audited without resolution; install failed: $why)"
    elif [ $rc2 = 124 ]; then
      say "BLIND deps      pip-audit exceeded 240s (network); rerun"; blind=1
    elif printf '%s' "$PA_TEXT$PA_JSON" | grep -iE 'not pinned|must be pinned|pinned to an exact' >/dev/null ; then
      say "BLIND deps      pip-audit could not install ($why) and a requirements file is not fully pinned, so nothing was measured"
      [ $quiet = 1 ] || printf '%s\n' "$PA_TEXT" | tail -5 | sed 's/^/      /'; blind=1
    else
      DEPS_FINDINGS="$(printf '%s' "$PA_JSON" | deps_collect_python_json)"
      deps_fail "pins audited without resolution; install failed: $why" "$out2"
    fi
    fi
  else
    DEPS_FINDINGS="$(printf '%s' "$PA_JSON" | deps_collect_python_json)"
    deps_fail "" "$out"
  fi
fi
}

# 2b. Node dependencies: every tracked package-lock.json, npm audit at High+.
check_npm() {
locks=$(git ls-files | grep -E '(^|/)package-lock\.json$')
if [ -z "$locks" ]; then
  say "ok    npm       no package-lock.json tracked"
elif ! command -v npm >/dev/null; then
  say "BLIND npm       npm not on PATH"; blind=1
else
  # Recorded dismissals: a TRACKED .npm-audit-ignores file, one advisory per line:
  # "<GHSA-id> <review-by YYYY-MM-DD> <reason>". For an advisory with no patched release at all
  # (braces <=3.0.3, GHSA-vfj7-8cjw-p6xm, 2026-09-18: every repo shipping bash-language-server
  # turned permanently red). Unlike .pip-audit-ignores, the date is mandatory: an entry past it
  # fails, so a dismissal is re-read rather than forgotten. Each dismissal is printed in the
  # receipt, and it only ever clears the advisories it names; one undismissed finding still fails.
  nig=""
  if git ls-files --error-unmatch .npm-audit-ignores >/dev/null 2>&1; then
    today=$(date -u +%F)
    while IFS= read -r iline; do
      case "$iline" in ''|'#'*) continue ;; esac
      read -r iid idate ireason <<<"$iline"
      if ! [[ "$iid" =~ ^GHSA(-[0-9a-z]{4}){3}$ ]] || ! [[ "$idate" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || [ -z "$ireason" ]; then
        say "FAIL  npm       .npm-audit-ignores line is not \"<GHSA-id> <review-by YYYY-MM-DD> <reason>\": $(printf '%s' "$iline" | cut -c1-80)"; fail=1
      elif [[ "$idate" < "$today" ]]; then
        say "FAIL  npm       .npm-audit-ignores $iid was to be reviewed by $idate; re-read the advisory, then fix, re-date or remove it"; fail=1
      else
        nig="$nig $iid"
        say "note  npm       dismissed $iid until $idate: $(printf '%s' "$ireason" | cut -c1-160)"
      fi
    done < .npm-audit-ignores
  fi
  nfail=0
  for l in $locks; do
    d=$(dirname "$l")
    # The gate is what ships: --omit=dev. devDependencies (lighthouse CI, storybook, test
    # runners) never reach a customer, and on 2026-08-25 two of them (image-size, extract-zip)
    # had High advisories with no patched release at all, which made every repo carrying them
    # permanently red. Those are still reported, one WARN line, so nobody can say they were hidden.
    # `rc=$?` after an `if ! cmd` reads the status of the negation, which is always 0, so the
    # 124 branch below never fired and every registry timeout arrived as "high or critical
    # advisories" with an empty evidence block (hermes-v2#71, twice, 2026-09-04). Capture the
    # real status before any other command runs.
    out=$(cd "$d" && npm audit --package-lock-only --audit-level=high --omit=dev 2>&1) && rc=0 || rc=$?
    if [ $rc != 0 ]; then
      # A registry that does not answer in 300s is a network condition, not a finding. Under the
      # flake protocol an unrelated infrastructure timeout must not hold a correct change, so this
      # reports and does not gate; a real advisory still prints its report and still fails.
      if [ $rc = 124 ]; then say "WARN  npm       $d: npm audit exceeded 300s (registry unreachable); dependencies unmeasured, not gating"
      elif printf '%s' "$out" | grep -qiE 'severity vulnerabilit|npm audit report'; then
        # POSITIVE EVIDENCE OF A FINDING, and the only branch that gates. npm prints one of
        # these two whenever it actually measured something: the report header, or the
        # "N high severity vulnerabilities" summary. Judging the report rather than the exit
        # code is the whole fix -- `npm audit` exits non-zero for a registry that refused to
        # answer just as readily as for a real advisory, and on 2026-09-04 hermes-v2#72 was
        # refused by "npm warn audit 503 Service Unavailable" reported as
        # "high or critical advisories in shipped dependencies" with a 503 as its evidence.
        # A dismissal clears a finding only when every High+ advisory in the report is one it
        # names; the report is re-read as JSON for that, and JSON that cannot be read clears nothing.
        open="unread"
        npmjson=""
        if [ -n "$nig" ] || deps_base_active; then
          npmjson=$(cd "$d" && npm audit --package-lock-only --audit-level=high --omit=dev --json 2>/dev/null)
          open=$(printf '%s' "$npmjson" | NIG="$nig" python3 -c 'import json, os, sys
dismissed = set(os.environ["NIG"].split())
try:
    vulns = json.load(sys.stdin)["vulnerabilities"]
except Exception:
    print("unread"); sys.exit()
found = {v["url"].rsplit("/", 1)[-1] for p in vulns.values() for v in p["via"]
         if isinstance(v, dict) and v.get("severity") in ("high", "critical") and v.get("url")}
print(" ".join(sorted(found - dismissed)) if found else "unread")')
        fi
        if [ -z "$open" ]; then
          say "ok    npm       $d: every high or critical advisory is a recorded dismissal"
        else
          # idp#7080: the same judgement the python side gets. A dismissal clears nothing
          # here: a dismissed advisory is not a finding, so it is not judged at all.
          DEPS_FINDINGS=""
          if deps_base_active && [ "$open" != "unread" ]; then
            DEPS_FINDINGS=$(printf '%s' "$npmjson" | NIG="$nig" python3 -c 'import json, os, sys
lock = sys.argv[1]
dismissed = set(os.environ["NIG"].split())
try:
    vulns = json.load(sys.stdin).get("vulnerabilities") or {}
except Exception:
    sys.exit()
for name, meta in vulns.items():
    for via in meta.get("via") or []:
        if not isinstance(via, dict) or via.get("severity") not in ("high", "critical"):
            continue
        vid = (via.get("url") or "").rstrip("/").split("/")[-1]
        if vid and vid not in dismissed:
            print(f"npm\t{lock}\t{name}\t{vid}")' "$l")
          fi
          if deps_judge; then
            say "ok    npm       $d: every high or critical advisory is pre-existing on $DEPS_BASE and this change moved no vulnerable pin; deferred"
          else
            say "FAIL  npm       $d: high or critical advisories in shipped dependencies"
            [ "$open" = "unread" ] || say "      not dismissed: $open"
            [ -z "$DEPS_REMAINING" ] || say "      not pre-existing on $DEPS_BASE: $DEPS_REMAINING"
            [ $quiet = 1 ] || printf '%s\n' "$out" | tail -15 | sed 's/^/      /'
            nfail=1
          fi
        fi
      elif printf '%s' "$out" | grep -qiE '5[0-9][0-9] |429 |service unavailable|econnreset|etimedout|eai_again|enotfound|socket hang up|audit endpoint'; then
        # A registry that answered with an HTTP error or dropped the socket measured nothing.
        # Under the flake protocol an unrelated infrastructure failure must not hold a correct
        # change, so this reports and does not gate.
        say "WARN  npm       $d: npm audit could not reach the registry (exit $rc); dependencies unmeasured, not gating"
        [ $quiet = 1 ] || printf '%s\n' "$out" | tail -3 | sed 's/^/      /'
      elif [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
        # A real advisory always prints its report. A non-zero exit with nothing on stdout or
        # stderr is a broken probe, not a finding, and reporting it as FAIL blocks correct work
        # with no evidence anybody can act on (LAW 38). hermes-v2#71, three Python files, was
        # refused this way twice on 2026-09-04 while the identical command answered "found 0
        # vulnerabilities" outside CI. BLIND says what actually happened: nothing was measured.
        say "BLIND npm       $d: npm audit exited $rc and printed nothing; nothing was measured"; blind=1
      else
        # Non-zero, output that is neither a report nor a recognised transport failure. Nothing
        # was measured and nothing is claimed: BLIND, with the output so a person can read it.
        say "BLIND npm       $d: npm audit exited $rc with no advisory report; nothing was measured"
        [ $quiet = 1 ] || printf '%s\n' "$out" | tail -5 | sed 's/^/      /'
        blind=1
      fi
    else
      (cd "$d" && npm audit --package-lock-only --audit-level=high >/dev/null 2>&1); rc=$?
      if [ $rc = 124 ]; then say "WARN  npm       $d: all-deps npm audit exceeded 300s (registry unreachable); dev advisories unmeasured"
      elif [ $rc != 0 ]; then say "WARN  npm       $d: high or critical advisories in devDependencies only (not shipped; not gating)"; fi
    fi
  done
  [ $nfail = 1 ] && fail=1
  [ $nfail = 0 ] && say "ok    npm       npm audit over $(echo "$locks" | wc -l | tr -d ' ') package-lock.json: no high or critical advisories${nig:+ beyond the recorded dismissals}"
fi
}

# 3. policy: every control row on the security policy page names a proof that exists.
check_policy() {
if [ ! -x bin/security-policy-gate ]; then
  say "ok    policy    no bin/security-policy-gate in this repository (idp carries the estate policy)"
elif out=$(python3 bin/security-policy-gate 2>&1); then
  say "ok    policy    security-policy-gate: every control row has a proof"
else
  say "FAIL  policy    security-policy-gate"; [ $quiet = 1 ] || printf '%s\n' "$out" | tail -10 | sed 's/^/      /'; fail=1
fi
}

# 4. container images: Trivy Operator's own VulnerabilityReport CRDs (platform/trivy, crew#846),
# read live -- there is nothing to lint in git, only a cluster to ask. bin/idp-kube is the one
# door to the cluster (a repo hook refuses bare kubectl); it prints BLIND and exits 2 when no
# cluster is reachable, which this folds into the same BLIND this check reports for a missing
# CRD -- a guard that cannot reach its evidence reports BLIND, never a verdict (LAW 45).
check_images() {
if [ ! -x bin/idp-kube ]; then
  say "ok    images    no bin/idp-kube in this repository (idp carries the cluster)"
else
  out=$(bin/idp-kube get vulnerabilityreports.aquasecurity.github.io -A -o json 2>&1) && rc=0 || rc=$?
  if [ $rc = 0 ]; then
    summary=$(printf '%s' "$out" | python3 -c '
import json, sys
try:
    items = json.load(sys.stdin).get("items", [])
except Exception:
    print("PARSE-ERROR"); sys.exit(0)
c = h = m = l = 0
for it in items:
    s = (it.get("report") or {}).get("summary") or {}
    c += s.get("criticalCount", 0) or 0
    h += s.get("highCount", 0) or 0
    m += s.get("mediumCount", 0) or 0
    l += s.get("lowCount", 0) or 0
print(f"{len(items)} {c} {h} {m} {l}")
' 2>/dev/null)
    if [ -z "$summary" ] || [ "$summary" = "PARSE-ERROR" ]; then
      say "BLIND images    vulnerabilityreports.aquasecurity.github.io: kubectl answered but the JSON did not parse"; blind=1
    else
      read -r n_reports crit high med low <<<"$summary"
      if [ "$n_reports" = "0" ]; then
        say "BLIND images    0 VulnerabilityReport objects; Trivy Operator has not scanned anything yet"; blind=1
      elif [ "$crit" -gt 0 ] || [ "$high" -gt 0 ]; then
        say "FAIL  images    $n_reports VulnerabilityReport(s): $crit critical, $high high, $med medium, $low low"
        fail=1
      else
        say "ok    images    trivy-operator over $n_reports VulnerabilityReport(s): 0 critical, 0 high ($med medium, $low low)"
      fi
    fi
  elif [ $rc = 2 ]; then
    # A GitHub-hosted runner has no route to the cluster: the security-scan job holds no OCI
    # identity and no tailnet, so "cannot reach" there is a fact about the runner, not about
    # the code in the pull request, and grading a pull request on it refuses correct work
    # (LAW 38). The live question is asked once a day by oke-check, which does hold the
    # machine identity, and that job sets SECURITY_SCAN_REQUIRE_CLUSTER=1 so an unreachable
    # cluster is still BLIND where reaching it is the point.
    if [ "${SECURITY_SCAN_REQUIRE_CLUSTER:-0}" = 1 ]; then
      say "BLIND images    bin/idp-kube could not reach the cluster"; blind=1
    else
      say "ok    images    no cluster reachable from here; the daily oke-check run grades this"
    fi
  elif printf '%s' "$out" | grep -qiE "doesn.t have a resource type|could not find the requested resource"; then
    say "BLIND images    Trivy Operator's VulnerabilityReport CRD is not installed on this cluster yet"; blind=1
  else
    say "BLIND images    bin/idp-kube get vulnerabilityreports.aquasecurity.github.io failed"
    [ $quiet = 1 ] || printf '%s\n' "$out" | tail -5 | sed 's/^/      /'
    blind=1
  fi
fi
}

# 5. manifests: `trivy config` over the Kubernetes YAML in this repository, before it reaches a
# cluster. Check 4 above asks the cluster what is already running, which makes it exactly one
# merge too late to stop anything; this asks the same question of the bytes in the pull request.
# Founder, 2026-09-07: "yes need trivy enabled". It is scoped to the kubernetes scanner so it
# costs seconds rather than minutes (35s cold, 2s warm on the estate; the unscoped default, which
# also runs the terraform, cloudformation, helm, ansible and azure-arm scanners over the whole
# tree, is 199s), and --skip-check-update keeps it offline: the checks bundle compiled into the
# binary is used rather than pulled from a registry.
#
# tests/ is not scanned. Its fixtures are deliberately-bad manifests that exist so the gates in
# AGENTS.md can be proved to refuse them, and a scanner grading them would be grading another
# gate's test inputs (76 findings on 2026-09-07, every one of them intentional).
#
# .trivyignore.yaml is the accepted-risk register, not a mute button: every waiver names its
# paths, says why the estate accepts the finding, and carries an expiry where the answer is "fix
# it, not now". A finding that is not in that file fails this check and blocks the merge.
check_manifests() {
if ! command -v trivy >/dev/null 2>&1; then
  say "BLIND manifests trivy is not installed; nothing was measured"; blind=1
else
  tv_count() {   # findings on stdin's JSON report, or ERR when it did not parse
    python3 -c 'import json,sys
try: d = json.load(sys.stdin)
except Exception: print("ERR"); sys.exit(0)
print(sum(len(r.get("Misconfigurations") or []) for r in (d.get("Results") or [])))'
  }
  tv_args=(config --quiet --skip-check-update --misconfig-scanners kubernetes
           --severity "HIGH,CRITICAL" --format json)
  # Proved both ways in the same run, the way bin/catalog-refcheck is: a guard is only evidence
  # while it can still refuse. The must-fail fixture is a privileged pod on the host network with
  # the docker socket mounted. If that comes back clean the check has stopped working -- a wrong
  # scanner scope, a checks bundle that did not load -- and it reports BLIND rather than carrying
  # on printing ok over an unmeasured repository (LAW 45).
  probe_ok=1
  if [ ! -f tests/fixtures/trivy-config/bad.yaml ]; then
    say "ok    manifests no tests/fixtures/trivy-config here (idp carries the must-fail fixture)"
  else
    n_bad=$(trivy "${tv_args[@]}" tests/fixtures/trivy-config/bad.yaml 2>/dev/null | tv_count)
    n_good=$(trivy "${tv_args[@]}" tests/fixtures/trivy-config/good.yaml 2>/dev/null | tv_count)
    if [ "${n_bad:-0}" = ERR ] || [ "${n_bad:-0}" -lt 1 ] 2>/dev/null; then
      say "BLIND manifests the must-fail fixture came back clean; trivy config is refusing nothing"
      blind=1; probe_ok=0
    elif [ "${n_good:-1}" = ERR ] || [ "${n_good:-1}" -ne 0 ] 2>/dev/null; then
      say "BLIND manifests the must-pass fixture was refused ($n_good); the check disagrees with the estate's own policies"
      blind=1; probe_ok=0
    else
      # Third probe: the register's deadlines are real. .trivyignore.yaml defers real findings with
      # a date, and the whole point of a date is that the gate goes red again by itself when it
      # passes. The file first shipped with `expires:`, which trivy parses, validates and ignores --
      # an entry dated 2020 still suppressed its finding, so every deferral in it was permanent and
      # the file read as though it were not. The key is `expired_at`. This proves both halves on the
      # must-fail fixture before trusting the register: one waiver dated in the past must leave the
      # finding standing, the same waiver dated in the future must take it away. If either stops
      # being true -- a rename upstream, a typo here -- the check says so instead of going quiet.
      exp_dir="$(mktemp -d)"
      printf 'misconfigurations:\n  - id: KSV-0017\n    paths: ["bad.yaml"]\n    expired_at: 2020-01-01\n' > "$exp_dir/past.yaml"
      printf 'misconfigurations:\n  - id: KSV-0017\n    paths: ["bad.yaml"]\n    expired_at: 2099-01-01\n' > "$exp_dir/future.yaml"
      n_past=$(trivy "${tv_args[@]}" --ignorefile "$exp_dir/past.yaml" tests/fixtures/trivy-config 2>/dev/null | tv_count)
      n_future=$(trivy "${tv_args[@]}" --ignorefile "$exp_dir/future.yaml" tests/fixtures/trivy-config 2>/dev/null | tv_count)
      rm -rf "$exp_dir"
      if [ "${n_past:-0}" = ERR ] || [ "${n_future:-0}" = ERR ] || [ "${n_past:-0}" -le "${n_future:-0}" ] 2>/dev/null; then
        say "BLIND manifests an expired waiver ($n_past findings) did not outweigh a live one ($n_future); the register's deadlines are not being read"
        blind=1; probe_ok=0
      fi
    fi
  fi
  if [ $probe_ok = 1 ]; then
    tv_ignore=()
    [ -f .trivyignore.yaml ] && tv_ignore=(--ignorefile .trivyignore.yaml)
    # .estate-idp is the copy of this repo the composite action clones beside the checkout it is
    # grading; scanning it means grading a second copy of every file, and its paths match no entry
    # in the register because every entry names a path in the repository under test.
    out=$(trivy "${tv_args[@]}" --skip-dirs tests --skip-dirs .estate-idp "${tv_ignore[@]}" . 2>/dev/null)
    n=$(printf '%s' "$out" | tv_count)
    if [ "$n" = ERR ] || [ -z "$n" ]; then
      say "BLIND manifests trivy config produced no report that parsed; nothing was measured"; blind=1
    elif [ "$n" -gt 0 ]; then
      say "FAIL  manifests trivy config: $n HIGH or CRITICAL misconfiguration(s) not in the accepted-risk register"
      # No escaped quotes in here and no `| head`: the first spelling of this printer used
      # f-string subscripts with backslash-escaped quotes, which the shell passed through
      # literally and python refused ("unexpected character after line continuation character"),
      # so a real FAIL in CI named its count and listed nothing (run 34154634513). head closing
      # the pipe then killed the printf with EPIPE on top. The limit is applied in python.
      [ $quiet = 1 ] || printf '%s' "$out" | python3 -c '
import json, sys
d = json.load(sys.stdin)
rows = []
for r in d.get("Results") or []:
    for m in r.get("Misconfigurations") or []:
        line = (m.get("CauseMetadata") or {}).get("StartLine") or "?"
        rows.append("      %-8s %s  %s:%s  %s" % (
            m.get("Severity", ""), m.get("ID", ""), r.get("Target", ""), line, m.get("Title", "")))
for row in rows[:20]:
    print(row)
if len(rows) > 20:
    print("      ... and %d more" % (len(rows) - 20))'

      [ $quiet = 1 ] || say "      Fix it, or accept it on the record in .trivyignore.yaml with a reason and an expiry."
      fail=1
    else
      say "ok    manifests trivy config over the manifests: 0 HIGH or CRITICAL outside the accepted-risk register"
    fi
  fi
fi
}

# The six checks run side by side (2026-10-14). They are independent reads of the same checkout,
# and run one after another they were 185 s of the CI job -- gitleaks over the whole history 80 s,
# pip-audit 69 s, trivy 30 s -- on the job the merge queue waits for last. Each check writes its
# lines to a file of its own and its verdict to another, and the receipt replays them in the order
# above, so it reads exactly as it did run serially. A check that dies without writing a verdict
# is BLIND, never a pass.
work=$(mktemp -d); vwork=$(mktemp -d /tmp/scan-XXXXXXXX); trap 'rm -rf "$work" "$vwork"' EXIT
checks="secrets deps npm policy images manifests"
declare -A pid
for c in $checks; do
  # the verdict is tee'd: its last stdout line AND a file in a /tmp/scan-* dir.
  # The /tmp/tmp.* verdict file vanished twice under a clean subshell exit
  # (runs 39090910860, 39095002769: deps ok line printed, rc=0, file gone at
  # read time) while .out/.err -- opened at launch -- always survived. The
  # stdout line rides the channel that provably survives; the scan-* file
  # rules out a /tmp/tmp.* sweeper; the read side reports which it saw.
  ( fail=0; blind=0; "check_$c"; printf '%s %s\n' "$fail" "$blind" | tee "$vwork/$c.verdict" ) \
    > "$work/$c.out" 2> "$work/$c.err" &
  pid[$c]=$!
done
for c in $checks; do
  wait "${pid[$c]}"; rc=$?
  cat "$work/$c.out"; cat "$work/$c.err" >&2
  v=$(tail -n 1 "$work/$c.out" 2>/dev/null)
  if printf '%s' "$v" | grep -qE '^[01] [01]$'; then
    [ "${v% *}" = 1 ] && fail=1; [ "${v#* }" = 1 ] && blind=1
  elif [ -s "$vwork/$c.verdict" ]; then
    read -r f b < "$vwork/$c.verdict"
    [ "$f" = 1 ] && fail=1; [ "$b" = 1 ] && blind=1
    say "note  scan      $c verdict came from the scan-* file; its stdout line was missing"
  elif [ "$rc" -gt 128 ]; then
    say "BLIND $c the check died on signal $(( rc - 128 )) before it gave a verdict"; blind=1
  else
    say "BLIND $c the check exited before it gave a verdict (rc=$rc)"; blind=1
  fi
done

if [ $fail = 1 ]; then say "SECURITY-SCAN FAIL commit=$(git rev-parse --short HEAD)"; exit 1; fi
if [ $blind = 1 ]; then say "SECURITY-SCAN BLIND commit=$(git rev-parse --short HEAD)"; exit 3; fi
say "SECURITY-SCAN PASS commit=$(git rev-parse --short HEAD)"
