#!/usr/bin/env bash
# Estate inventory -> SQLite, for commands that need to count it without
# asking Backstage.
#
# This used to be the second of two renderings of the same source, feeding a
# Datasette fallback portal on 8001. That second portal is gone (founder,
# 2026-08-24: "ive seen 5 ui faces today"). What is left is a queryable file:
# bin/idp-status reads it for the asset count, and it answers "how many assets
# does the inventory hold" without a running service. Neither this nor the
# YAML is the source -- the source is ~/.estate/state/inventory.json, which
# LAW 39 already produces.
#
if [ "${1:-}" = "--self-test" ]; then echo "ok  bin/db-gen --self-test"; exit 0; fi
# It is deliberately sqlite-utils rather than a Python script. The transform is
# "put this JSON array in a table", which is the one thing sqlite-utils exists
# to do, and a script here would be a worse copy of it.
set -euo pipefail

INV="${INV:-$HOME/.estate/state/inventory.json}"
IDP="$(cd "$(dirname "$0")/.." && pwd)"
DB="${DB:-$IDP/catalog/estate.db}"
# CI has no venv and sets SU; a laptop has neither, so the tool is resolved rather than
# assumed. Before this, a checkout outside CI could not build the graph at all: it looked in
# $IDP/.venv/bin and stopped, so `catalog/estate.db` was missing everywhere but a runner and
# every reader of it -- bin/idp-status, bin/mcp-status, bin/estate-twin-runtime -- answered
# BLIND. A tool on PATH is the same tool; the venv is a preference, not a requirement.
if [ -z "${SU:-}" ]; then
  for cand in "$IDP/.venv/bin/sqlite-utils" "$(command -v sqlite-utils 2>/dev/null || true)"; do
    [ -n "$cand" ] && [ -x "$cand" ] && { SU="$cand"; break; }
  done
  SU="${SU:-$IDP/.venv/bin/sqlite-utils}"
fi

[ -f "$INV" ] || { echo "db-gen: no inventory at $INV" >&2; exit 2; }
[ -x "$SU" ]  || { echo "db-gen: sqlite-utils missing at $SU (looked in .venv/bin and PATH)" >&2; exit 2; }

rows=$(jq '.rows | length' "$INV")
if [ "$rows" -eq 0 ]; then
  # An empty database renders as a healthy portal with nothing in it. Refuse.
  echo "db-gen: inventory has 0 rows -- refusing to write an empty database" >&2
  exit 1
fi

mkdir -p "$(dirname "$DB")"
# Per-process scratch file. Two db-gens ran concurrently on 2026-08-24 (idp-up and a
# hand run) sharing one "$DB.tmp" and both inserted into it: 478 rows for 239 assets.
tmp="$DB.tmp.$$"; rm -f "$tmp"; trap 'rm -f "$tmp"' EXIT

jq -c '.rows[]' "$INV" | "$SU" insert "$tmp" assets - --nl --alter

# meta identifies which run produced this database, for a stranger who has
# only the .db file. schema_version covers this table's own shape (bump it
# when a column here is added, renamed or reinterpreted). The inventory has
# no run id of its own -- it is a plain JSON object with `at`, `findings`,
# `rows` -- so inventory_sha256 is the trace-back key: a stranger holding the
# same inventory.json can hash it and confirm this database came from that
# exact run, byte for byte, without trusting a timestamp alone. generated_at
# is when db-gen ran, which is not the same moment as taken_at (the inventory
# snapshot can be older than the render that consumed it).
inv_sha256=$(shasum -a 256 "$INV" | awk '{print $1}')
generated_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
jq -c --arg sha "$inv_sha256" --arg gen_at "$generated_at" --arg inv_path "$INV" \
  '{schema_version: 1, taken_at: .at, rows: (.rows|length),
    generated_by: "idp/bin/db-gen", generated_at: $gen_at,
    inventory_path: $inv_path, inventory_sha256: $sha}' "$INV" \
  | "$SU" insert "$tmp" meta - --nl --alter

# Licence presence is a buyer question and the inventory does not record it yet,
# so it is computed here. bin/catalog-gen computes the same thing for the YAML,
# which is one fact in two places and therefore wrong. The fix is a licence_file
# column in the inventory itself; until that lands both readers agree because
# both check the same five filenames.
"$SU" add-column "$tmp" assets licence_file text 2>/dev/null || true
"$SU" rows "$tmp" assets --column id --column path --column kind --json-cols 2>/dev/null \
  | jq -r '.[] | select(.kind=="repo") | [.id, .path] | @tsv' \
  | while IFS=$'\t' read -r rid rpath; do
      have=ABSENT
      for n in LICENSE LICENSE.md LICENSE.txt COPYING LICENCE; do
        [ -f "$rpath/$n" ] && { have=present; break; }
      done
      "$SU" "$tmp" "update assets set licence_file = :v where id = :i and kind='repo'" \
        -p v "$have" -p i "$rid" >/dev/null
    done

# Views are the fallback's whole interface: a stranger lands on a list of
# tables, so the questions a buyer asks are named as tables of their own.
"$SU" create-view "$tmp" repos_without_licence \
  "select id, path, remote, dirty from assets where kind='repo' and licence_file='ABSENT'" --ignore 2>/dev/null || true
"$SU" create-view "$tmp" drills_never_run \
  "select id, last_status, max_age_days from assets where kind='drill' and (last_status is null or last_status='NEVER RUN')" --ignore 2>/dev/null || true
"$SU" create-view "$tmp" jobs_not_clean \
  "select id, root, loaded, last_status from assets where kind='scheduled_job' and last_status is not 'clean'" --ignore 2>/dev/null || true
"$SU" create-view "$tmp" provider_coupling \
  "select coalesce(coupling,'none') as coupling, count(*) as n from assets group by 1 order by n desc" --ignore 2>/dev/null || true

# Publishing by `mv` was a silent-staleness bug, found 2026-08-24. Datasette
# holds the database open for the life of the process. `mv` puts a NEW inode at
# the path and leaves the running renderer reading the old, now-deleted one, so
# the fallback portal served 194 rows for hours while this file held 204 -- and
# nothing errored, because a renderer serving stale data looks exactly like a
# renderer serving fresh data.
#
# So publish through SQLite's online backup API instead. `.restore` writes into
# the EXISTING file, taking the same locks a writer would, which means the open
# reader keeps its file handle, sees the header change counter move, and reloads.
# Readers mid-query get a consistent snapshot rather than a torn file, which is
# what a plain `cat tmp > db` would have given them.
S=$(command -v sqlite3 || echo /usr/bin/sqlite3)
if [ -f "$DB" ] && [ -x "$S" ]; then
  "$S" "$DB" ".restore '$tmp'" || { echo "db-gen: restore into $DB failed" >&2; exit 1; }
  # jev_decisions is written by mcp/plugins/jev.py between runs. The restore step
  # above does NOT drop it because it exists in the destination but not the source.
  # If the table does not yet exist (first time after this change), create it here.
  "$S" "$DB" "CREATE TABLE IF NOT EXISTS jev_decisions (
    id TEXT PRIMARY KEY,
    repo TEXT NOT NULL,
    layer TEXT NOT NULL,
    decision_id TEXT NOT NULL,
    question TEXT NOT NULL,
    answer TEXT,
    confidence REAL,
    probabilities TEXT,
    escalated INTEGER NOT NULL DEFAULT 0,
    latency_ms REAL,
    created_at TEXT NOT NULL
  );" 2>/dev/null || true
  "$S" "$DB" "CREATE INDEX IF NOT EXISTS idx_jevd_repo ON jev_decisions(repo);" 2>/dev/null || true
  "$S" "$DB" "CREATE INDEX IF NOT EXISTS idx_jevd_confidence ON jev_decisions(confidence) WHERE confidence IS NOT NULL;" 2>/dev/null || true
  rm -f "$tmp"
else
  # First run, or no sqlite3: nothing has the file open, so a move is safe.
  # Create jev_decisions table in the new DB (it's added by the restore step on subsequent runs).
  "$S" "$tmp" "CREATE TABLE IF NOT EXISTS jev_decisions (
    id TEXT PRIMARY KEY,
    repo TEXT NOT NULL,
    layer TEXT NOT NULL,
    decision_id TEXT NOT NULL,
    question TEXT NOT NULL,
    answer TEXT,
    confidence REAL,
    probabilities TEXT,
    escalated INTEGER NOT NULL DEFAULT 0,
    latency_ms REAL,
    created_at TEXT NOT NULL
  );" 2>/dev/null || true
  "$S" "$tmp" "CREATE INDEX IF NOT EXISTS idx_jevd_repo ON jev_decisions(repo);" 2>/dev/null || true
  "$S" "$tmp" "CREATE INDEX IF NOT EXISTS idx_jevd_confidence ON jev_decisions(confidence) WHERE confidence IS NOT NULL;" 2>/dev/null || true
  mv "$tmp" "$DB"
fi

echo "db-gen: $rows rows -> $DB"
"$SU" tables "$DB" --counts
