#!/usr/bin/env bash
# One primitive layer between the estate's operator scripts and whichever cloud holds its state (crew#66 CP1, crew#309).
#   bin/idp-cloud object head --bucket B --name N     JSON with "last-modified" (RFC 1123), "date"
#                                                     (the store's own clock as it answered -- crew#583) and "content-length";
#                                                     exit 1 with NotFound on stderr when absent
#   bin/idp-cloud object get  --bucket B --name N     body on stdout
#   bin/idp-cloud object put  --bucket B --name N --file F
#   bin/idp-cloud object list --bucket B [--prefix P] one name per line
#   bin/idp-cloud secret get  NAME                    decoded secret content; exit 1 NotFound, 3 Split (ACTIVE in more than one vault), 4 Unreadable
#   bin/idp-cloud secret put  NAME --file F           create or update; content is the file, never argv
#   bin/idp-cloud secret delete NAME                  schedule deletion; absent is exit 0
#   bin/idp-cloud secret describe NAME                JSON {"id","vault-id","key-id"} of the ACTIVE secret in the compartment; exit 1 NotFound, 3 Split
#   bin/idp-cloud secret list [--vault VAULT_ID]      one ACTIVE secret name per line; --vault restricts to that vault only
#   bin/idp-cloud vault list                         one ACTIVE vault per line as "<display-name> <id>", sorted by name
#   bin/idp-cloud bucket head NAME                   exit 0 "ok" if the bucket exists in the tenancy namespace; exit 1 with NotFound on stderr when absent, exit 2 BLIND when the namespace cannot be read
#   bin/idp-cloud cluster list                       one ACTIVE cluster per line as "<name> <id>", sorted by name
#   bin/idp-cloud cluster nodepools                  one node pool per line as "<name> <lifecycle-state>", sorted
#   bin/idp-cloud cluster kubeconfig ID --file PATH [--region R]   writes the kubeconfig for cluster ID to PATH, chmod 600, prints nothing; exit 1 with NotFound on stderr when the cluster is absent
# Backend: $IDP_CLOUD_BACKEND, default oci. `file` backend (tests, laptops with no cloud) roots at $IDP_CLOUD_FILE_ROOT:
#   objects at $IDP_CLOUD_FILE_ROOT/objects/<bucket>/<name>, secrets at $IDP_CLOUD_FILE_ROOT/secrets/<name>, clusters at $IDP_CLOUD_FILE_ROOT/clusters/<id>/, nodepools at $IDP_CLOUD_FILE_ROOT/nodepools/<name>.
# Grading lines, same shape as every bin/idp-*: `BLIND   cloud  <why>` exit 2 when nothing could be asked.
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
BACKEND=${IDP_CLOUD_BACKEND:-oci}
blind() { printf 'BLIND   cloud  %s\n' "$1" >&2; exit 2; }
# A grading line is one line. Fold a multi-line CLI diagnosis onto it, drop anything shaped like
# a bearer token or key so a diagnosis can never become a leak, and cap it so one row stays one row.
oneline() { printf '%s' "$1" | tr '\n\r\t' '   ' | sed -E 's/[A-Za-z0-9_-]{40,}/<redacted>/g; s/  +/ /g; s/^ //' | cut -c1-300; }
prim=$1; verb=$2; shift 2
BUCKET=""; NAME=""; FILE=""; PREFIX=""; VAULT=""; REGION=""
while [ $# -gt 0 ]; do
  case "$1" in
    --bucket) BUCKET=$2; shift 2;;
    --name)   NAME=$2; shift 2;;
    --file)   FILE=$2; shift 2;;
    --prefix) PREFIX=$2; shift 2;;
    --vault)  VAULT=$2; shift 2;;
    --region) REGION=$2; shift 2;;
    --) shift; break;;
    -*) blind "unknown flag $1";;
    *) NAME=$1; shift;;
  esac
done

file_object_path() { printf '%s' "$IDP_CLOUD_FILE_ROOT/objects/$BUCKET/$NAME"; }
file_secret_path() { printf '%s' "$IDP_CLOUD_FILE_ROOT/secrets/$NAME"; }

# Resolve $C the same way every oci verb does: whoami, the security_token auth, the sops envelope,
# the env override. Centralised so vault-list and cluster-list share the exact same shape (crew#66 CP5d).
oci_compartment() {
  local MAIN
  MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
  if [ -z "${OCI_CLI_PROFILE:-}" ]; then
    # shellcheck source=idp-oci-whoami
    source "$IDP/bin/idp-oci-whoami" >&2 || return 2
  fi
  export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
  export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
  # Order: env, the tfvars the provisioner already rendered (the runner has that and no age key —
  # idp#490 check job: nodes went BLIND for this), then the sops envelope on a laptop.
  if [ -n "${OCI_COMPARTMENT_OCID:-}" ]; then printf '%s' "$OCI_COMPARTMENT_OCID"; return 0; fi
  if [ -f "$IDP/platform/oci/terraform.tfvars" ]; then
    local T; T=$(awk -F'"' '/^compartment_ocid/{print $2}' "$IDP/platform/oci/terraform.tfvars")
    if [ -n "$T" ]; then printf '%s' "$T"; return 0; fi
  fi
  sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml"
}

case "$prim" in
  object)
    case "$verb" in
      head)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            path=$(file_object_path)
            [ -f "$path" ] || { echo "NotFound: $BUCKET/$NAME" >&2; exit 1; }
            FILE_PATH="$path" python3 -c 'import os,json
from datetime import datetime, timezone
from email.utils import format_datetime
p=os.environ["FILE_PATH"]
mtime=os.path.getmtime(p); size=os.path.getsize(p)
# "date" is what the clock that stamped this object said as it answered the read. For the oci
# backend that is the storage service, and for this one it is this machine -- which is the point:
# the reader subtracts the two, so a wrong clock cancels itself out instead of inventing an age
# (crew#583). Both come from the same clock, so both move together.
print(json.dumps({"last-modified": format_datetime(datetime.fromtimestamp(mtime, timezone.utc), usegmt=True), "date": format_datetime(datetime.now(timezone.utc), usegmt=True), "content-length": size}))'
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            ns=(); [ -n "${OCI_OS_NAMESPACE:-}" ] && ns=(--namespace-name "$OCI_OS_NAMESPACE")
            exec oci os object head "${ns[@]}" --bucket-name "$BUCKET" --name "$NAME"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      get)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            path=$(file_object_path)
            [ -f "$path" ] || { echo "NotFound: $BUCKET/$NAME" >&2; exit 1; }
            cat "$path"
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            ns=(); [ -n "${OCI_OS_NAMESPACE:-}" ] && ns=(--namespace-name "$OCI_OS_NAMESPACE")
            # crew#163: a machine with no OCI identity (a Mac, crew#345) still reads one object through
            # the S3 door with the envelope's state-backend keys; the oci CLI is asked first.
            if command -v oci >/dev/null && oci os object get "${ns[@]}" --bucket-name "$BUCKET" --name "$NAME" --file - 2>/dev/null; then exit 0; fi
            exec "$IDP/bin/idp-oci-s3" get "$BUCKET" "$NAME"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      put)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            path=$(file_object_path)
            mkdir -p "$(dirname "$path")"
            if [ "$FILE" = "-" ]; then cat > "$path"; else cp "$FILE" "$path"; fi
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            ns=(); [ -n "${OCI_OS_NAMESPACE:-}" ] && ns=(--namespace-name "$OCI_OS_NAMESPACE")
            exec oci os object put "${ns[@]}" --bucket-name "$BUCKET" --name "$NAME" --file "$FILE" --force
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      list)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            dir="$IDP_CLOUD_FILE_ROOT/objects/$BUCKET"
            [ -d "$dir" ] || exit 0
            cd "$dir" || exit 0
            for n in $(find . -type f | sed 's|^\./||' | sort); do
              case "$n" in
                "$PREFIX"*) printf '%s\n' "$n";;
                *) : ;;
              esac
            done
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            ns=(); [ -n "${OCI_OS_NAMESPACE:-}" ] && ns=(--namespace-name "$OCI_OS_NAMESPACE")
            oci os object list "${ns[@]}" --bucket-name "$BUCKET" --all ${PREFIX:+--prefix "$PREFIX"} --query 'data[].name' --raw-output | python3 -c 'import json,sys; [print(n) for n in json.load(sys.stdin)]'
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      *) blind "unknown object $verb";;
    esac
    ;;
  secret)
    case "$verb" in
      get)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            split="$IDP_CLOUD_FILE_ROOT/secrets/$NAME.split"
            [ -e "$split" ] && { echo "Split: secret $NAME is ACTIVE in more than one vault of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            path=$(file_secret_path)
            [ -f "$path" ] || { echo "NotFound: secret $NAME" >&2; exit 1; }
            cat "$path"
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
            if [ -z "${OCI_CLI_PROFILE:-}" ]; then
              # shellcheck source=idp-oci-whoami
              source "$IDP/bin/idp-oci-whoami" >&2 || exit 2
            fi
            export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
            export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
            C=${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}
            ids=$(oci vault secret list --compartment-id "$C" --name "$NAME" --all --query "data[?\"lifecycle-state\"=='ACTIVE'].id" --output json 2>/dev/null | python3 -c 'import json,sys; [print(i) for i in json.load(sys.stdin)]' 2>/dev/null) || ids=""
            n=$(printf '%s\n' "$ids" | grep -c .)
            [ "$n" -le 1 ] || { echo "Split: secret $NAME is ACTIVE in $n vaults of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            sid=$(printf '%s\n' "$ids" | head -1)
            [ -n "$sid" ] && [ "$sid" != null ] || { echo "NotFound: secret $NAME" >&2; exit 1; }
            b64=$(oci secrets secret-bundle get --secret-id "$sid" --query 'data."secret-bundle-content".content' --raw-output 2>/dev/null) || b64=""
            [ -n "$b64" ] && [ "$b64" != null ] || { echo "Unreadable: secret-bundle for $NAME is empty or unreadable by this identity" >&2; exit 4; }
            printf '%s' "$b64" | base64 -d
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      put)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -n "$NAME" ] || blind "secret put NAME --file F: NAME required"
            [ -n "$FILE" ] || blind "secret put NAME --file F: --file F required"
            mkdir -p "$IDP_CLOUD_FILE_ROOT/secrets"
            path=$(file_secret_path)
            if [ -f "$path" ]; then verb=updated; else verb=created; fi
            cp "$FILE" "$path"
            chmod 600 "$path"
            printf '%s' "$verb"
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
            if [ -z "${OCI_CLI_PROFILE:-}" ]; then
              # shellcheck source=idp-oci-whoami
              source "$IDP/bin/idp-oci-whoami" >&2 || exit 2
            fi
            export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
            export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
            C=${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}
            ids=$(oci vault secret list --compartment-id "$C" --name "$NAME" --all --query "data[?\"lifecycle-state\"=='ACTIVE'].id" --output json 2>/dev/null | python3 -c 'import json,sys; [print(i) for i in json.load(sys.stdin)]' 2>/dev/null) || ids=""
            n=$(printf '%s\n' "$ids" | grep -c .)
            [ "$n" -le 1 ] || { echo "Split: secret $NAME is ACTIVE in $n vaults of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            sid=$(printf '%s\n' "$ids" | head -1)
            payload=$(base64 < "$FILE" | tr -d '\n')
            if [ -n "$sid" ] && [ "$sid" != null ]; then
              oci vault secret update-base64 --secret-id "$sid" --secret-content-content "$payload" >/dev/null
              printf '%s' updated
            else
              V=${ESTATE_VAULT_OCID:-$(cd "$MAIN/platform/oci" && tofu output -raw vault_id)}
              K=${ESTATE_VAULT_KEY_OCID:-$(cd "$MAIN/platform/oci" && tofu output -raw vault_key_id)}
              oci vault secret create-base64 --compartment-id "$C" --vault-id "$V" --key-id "$K" --secret-name "$NAME" --secret-content-content "$payload" >/dev/null
              printf '%s' created
            fi
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      delete)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -n "$NAME" ] || blind "secret delete NAME: NAME required"
            rm -f "$IDP_CLOUD_FILE_ROOT/secrets/$NAME" "$IDP_CLOUD_FILE_ROOT/secrets/$NAME.split"
            exit 0
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
            if [ -z "${OCI_CLI_PROFILE:-}" ]; then
              # shellcheck source=idp-oci-whoami
              source "$IDP/bin/idp-oci-whoami" >&2 || exit 2
            fi
            export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
            export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
            C=${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}
            ids=$(oci vault secret list --compartment-id "$C" --name "$NAME" --all --query "data[?\"lifecycle-state\"=='ACTIVE'].id" --output json 2>/dev/null | python3 -c 'import json,sys; [print(i) for i in json.load(sys.stdin)]' 2>/dev/null) || ids=""
            n=$(printf '%s\n' "$ids" | grep -c .)
            [ "$n" -le 1 ] || { echo "Split: secret $NAME is ACTIVE in $n vaults of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            sid=$(printf '%s\n' "$ids" | head -1)
            if [ -z "$sid" ] || [ "$sid" = null ]; then printf '%s' absent; exit 0; fi
            oci vault secret schedule-secret-deletion --secret-id "$sid" >/dev/null
            printf '%s' scheduled
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      describe)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            split="$IDP_CLOUD_FILE_ROOT/secrets/$NAME.split"
            [ -e "$split" ] && { echo "Split: secret $NAME is ACTIVE in more than one vault of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            meta="$IDP_CLOUD_FILE_ROOT/secrets/$NAME.meta.json"
            path=$(file_secret_path)
            if [ -f "$meta" ]; then cat "$meta"
            elif [ -f "$path" ]; then printf '{"id":"file:%s","vault-id":"file","key-id":"file"}\n' "$NAME"
            else echo "NotFound: secret $NAME" >&2; exit 1; fi
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
            if [ -z "${OCI_CLI_PROFILE:-}" ]; then
              # shellcheck source=idp-oci-whoami
              source "$IDP/bin/idp-oci-whoami" >&2 || exit 2
            fi
            export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
            export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
            C=${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}
            list=$(oci vault secret list --compartment-id "$C" --name "$NAME" --all --query "data[?\"lifecycle-state\"=='ACTIVE']" --output json 2>/dev/null) || list=""
            n=$(printf '%s\n' "$list" | jq 'length // 0' 2>/dev/null) || n=0
            [ "$n" -le 1 ] || { echo "Split: secret $NAME is ACTIVE in $n vaults of the compartment; bin/idp-vault-split-guard names them" >&2; exit 3; }
            desc=$(printf '%s\n' "$list" | jq -c 'if length == 0 then null else .[0] | {id, "vault-id": ."vault-id", "key-id": ."key-id"} end' 2>/dev/null) || desc=""
            [ -n "$desc" ] && [ "$desc" != null ] || { echo "NotFound: secret $NAME" >&2; exit 1; }
            printf '%s\n' "$desc"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      list)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            if [ -n "$VAULT" ]; then
              dir="$IDP_CLOUD_FILE_ROOT/vaults/$VAULT/secrets"
            else
              dir="$IDP_CLOUD_FILE_ROOT/secrets"
            fi
            [ -d "$dir" ] || exit 0
            cd "$dir" || exit 0
            ls -1 | sort
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
            if [ -z "${OCI_CLI_PROFILE:-}" ]; then
              # shellcheck source=idp-oci-whoami
              source "$IDP/bin/idp-oci-whoami" >&2 || exit 2
            fi
            export OCI_CLI_AUTH=${OCI_CLI_AUTH:-security_token}
            export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt} SUPPRESS_LABEL_WARNING=True
            C=${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}
            if [ -n "$VAULT" ]; then
              V=$VAULT
            else
              V=${ESTATE_VAULT_OCID:-$(cd "$MAIN/platform/oci" && tofu output -raw vault_id)}
            fi
            oci vault secret list --compartment-id "$C" --vault-id "$V" --all --query "data[?\"lifecycle-state\"=='ACTIVE'].\"secret-name\"" --raw-output | python3 -c 'import json,sys; [print(n) for n in sorted(json.load(sys.stdin))]'
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      *) blind "unknown secret $verb";;
    esac
    ;;
  vault)
    case "$verb" in
      list)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -d "$IDP_CLOUD_FILE_ROOT/vaults" ] || exit 0
            for d in "$IDP_CLOUD_FILE_ROOT"/vaults/*/; do
              [ -d "$d" ] || continue
              name=$(cat "$d/name" 2>/dev/null) || continue
              id=$(basename "$d")
              printf '%s %s\n' "$name" "$id"
            done | sort
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            C=$(oci_compartment)
            oci kms management vault list --compartment-id "$C" --all --query "data[?\"lifecycle-state\"=='ACTIVE'].[\"display-name\",id]" --output json | jq -r '.[] | "\(.[0]) \(.[1])"' | sort || blind "oci kms management vault list failed"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      *) blind "unknown vault $verb";;
    esac
    ;;
  bucket)
    case "$verb" in
      head)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -d "$IDP_CLOUD_FILE_ROOT/objects/$NAME" ] || { echo "NotFound: bucket $NAME" >&2; exit 1; }
            echo ok
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            bucket_ns=$(oci os ns get --query data --raw-output) || blind "oci os ns get failed"
            if oci os bucket get --namespace "$bucket_ns" --bucket-name "$NAME" >/dev/null 2>&1; then
              echo ok
            else
              echo "NotFound: bucket $NAME" >&2
              exit 1
            fi
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      *) blind "unknown bucket $verb";;
    esac
    ;;
  cluster)
    case "$verb" in
      list)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -d "$IDP_CLOUD_FILE_ROOT/clusters" ] || exit 0
            for d in "$IDP_CLOUD_FILE_ROOT"/clusters/*/; do
              [ -d "$d" ] || continue
              name=$(cat "$d/name" 2>/dev/null) || continue
              id=$(basename "$d")
              printf '%s %s\n' "$name" "$id"
            done | sort
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            C=$(oci_compartment)
            oci ce cluster list --compartment-id "$C" --lifecycle-state ACTIVE --query 'data[].[name,id]' --output json | jq -r '.[] | "\(.[0]) \(.[1])"' | sort || blind "oci ce cluster list failed"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      nodepools)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            dir="$IDP_CLOUD_FILE_ROOT/nodepools"
            [ -d "$dir" ] || exit 0
            for f in "$dir"/*; do
              [ -f "$f" ] || continue
              printf '%s %s\n' "$(basename "$f")" "$(cat "$f")"
            done | sort
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            C=$(oci_compartment)
            oci ce node-pool list --compartment-id "$C" --query 'data[].[name,"lifecycle-state"]' --output json | jq -r '.[] | "\(.[0]) \(.[1])"' | sort || blind "oci ce node-pool list failed"
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      kubeconfig)
        case "$BACKEND" in
          file)
            [ -n "${IDP_CLOUD_FILE_ROOT:-}" ] || blind "IDP_CLOUD_FILE_ROOT unset for the file backend"
            [ -n "$NAME" ] || blind "cluster kubeconfig ID --file PATH: ID required"
            [ -n "$FILE" ] || blind "cluster kubeconfig ID --file PATH: --file PATH required"
            [ -d "$IDP_CLOUD_FILE_ROOT/clusters/$NAME" ] || { echo "NotFound: cluster $NAME" >&2; exit 1; }
            cp "$IDP_CLOUD_FILE_ROOT/clusters/$NAME/kubeconfig" "$FILE"
            chmod 600 "$FILE"
            ;;
          oci)
            command -v oci >/dev/null || blind "oci CLI is not installed"
            # crew#292: `|| blind "create-kubeconfig failed"` threw away the only sentence that
            # said why. bin/idp-kube then took tail -1 of the combined output, which is this
            # line, so the CLI's ServiceError never reached the receipt: 7 of 7 verify-drill runs
            # read carried `BLIND kube create-kubeconfig failed` with no cause anywhere in the
            # log, and nobody could attribute it (LAW 28, LAW 29). oci writes its diagnosis to
            # stderr, so stderr is captured and travels in the blind line. stdout is discarded:
            # the kubeconfig goes to --file, and a token must never land in a log.
            if [ -n "$REGION" ]; then
              why=$(oci ce cluster create-kubeconfig --cluster-id "$NAME" --file "$FILE" --region "$REGION" --token-version 2.0.0 --kube-endpoint PUBLIC_ENDPOINT 2>&1 >/dev/null) \
                || blind "oci ce cluster create-kubeconfig failed: $(oneline "$why")"
            else
              why=$(oci ce cluster create-kubeconfig --cluster-id "$NAME" --file "$FILE" --token-version 2.0.0 --kube-endpoint PUBLIC_ENDPOINT 2>&1 >/dev/null) \
                || blind "oci ce cluster create-kubeconfig failed: $(oneline "$why")"
            fi
            ;;
          *) blind "unknown backend $BACKEND";;
        esac
        ;;
      *) blind "unknown cluster $verb";;
    esac
    ;;
  *) blind "unknown $prim $verb";;
esac
