#!/usr/bin/env python3
"""machine-pressure -- say whether THIS machine is short of memory, and never call it healthy blind.

WHY THIS EXISTS (measured 2026-11-11). The disk guardian's heartbeat said `state=healthy` while
the same record said `free=52M RAM swap=82%`, and its own brake said `braked=pressure-no-target`:
it wanted to reclaim, had nowhere to reclaim to, and graded itself healthy anyway. Swap was 3331M
of 4096M used and agents' doors were refusing work. Nothing in this repo read swap at all
(`rg vm.swapusage` -> 0 files), so the machine suffocated while the one resident watchdog, which
only ever measured DISK, reported green.

A disk number cannot answer a memory question. This probe answers only the memory question:

    ok         free RAM is above the floor and swap is not being consumed
    pressure   swap is materially in use, or free RAM is under the floor -- work will slow down
    exhausted  swap is (nearly) full -- new work cannot be admitted without thrashing
    BLIND      the numbers could not be read; this is never reported as ok

The verdict is a pure function of measured bytes. The thresholds are named constants with the
reason they are what they are, and each is overridable so a falsifier can drive the boundary
without touching the machine.

Exit codes are the verdict, so a caller never parses prose:
    0 ok   3 pressure   4 exhausted   2 BLIND
"""

import argparse
import json
import os
import subprocess
import sys

# Free RAM floor, not swap: low swap means nothing if RAM is plentiful.
RAM_FLOOR_MB = int(os.environ.get("MACHINE_RAM_FLOOR_MB", "512"))
# Swap is a spill, not a resource. At 50% the machine is already paying to move pages, and work on
# it is measurably slower -- that is why pressure, not because it is about to die.
SWAP_PRESSURE_PCT = int(os.environ.get("MACHINE_SWAP_PRESSURE_PCT", "50"))
# At 80% the spill has nowhere left to grow: the next allocation pages out something live. This is
# set BELOW the measured 2026-11-11 failure (3331M of 4096M = 81.3%) on purpose -- a threshold above
# the failure it is meant to catch cannot catch it, and 85% would have called that machine pressure
# rather than exhausted.
SWAP_EXHAUSTED_PCT = int(os.environ.get("MACHINE_SWAP_EXHAUSTED_PCT", "80"))

CODE = {"ok": 0, "pressure": 3, "exhausted": 4}


class Blind(Exception):
    """The machine's own numbers could not be read. Never silently becomes ok."""


def _digits(text):
    return "".join(c for c in text if c.isdigit())


def swap_mb():
    """(total, used) swap in MB from the kernel, or raise Blind."""
    try:
        out = subprocess.run(
            ["/usr/sbin/sysctl", "-n", "vm.swapusage"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        ).stdout
    except (OSError, subprocess.SubprocessError) as e:
        raise Blind("sysctl vm.swapusage failed: %s" % type(e).__name__) from e
    found = []
    for token in out.replace("=", " ").split():
        if token.endswith("M"):
            try:
                found.append(float(token[:-1]))
            except ValueError:
                continue
    if len(found) < 3:
        raise Blind("could not parse swapusage: %s" % out.strip()[:80])
    total, used = found[0], found[1]
    return (total, used) if total > 0 else (0.0, 0.0)


def ram_free_mb():
    """Free RAM in MB as the kernel accounts it, or raise Blind."""
    try:
        out = subprocess.run(
            ["/usr/bin/vm_stat"], capture_output=True, text=True, timeout=5, check=False
        ).stdout
    except (OSError, subprocess.SubprocessError) as e:
        raise Blind("vm_stat failed: %s" % type(e).__name__) from e
    page_size = 4096
    free_pages = None
    for line in out.splitlines():
        if "page size of" in line:
            n = _digits(line)
            if n:
                page_size = int(n)
        if line.startswith("Pages free:"):
            n = _digits(line.split(":", 1)[1] if ":" in line else "")
            if n:
                free_pages = int(n)
    if free_pages is None:
        raise Blind("could not parse vm_stat: %s" % out.strip()[:80])
    return free_pages * page_size / (1024 * 1024)


def verdict(total, used, free_ram):
    """The one place the rule lives. Pure, so a falsifier drives it with exact numbers."""
    swap_pct = (100.0 * used / total) if total > 0 else 0.0
    if total > 0 and swap_pct >= SWAP_EXHAUSTED_PCT:
        return (
            "exhausted",
            "swap %.0fM of %.0fM (%.0f%% >= %d%%)"
            % (used, total, swap_pct, SWAP_EXHAUSTED_PCT),
        )
    if free_ram < RAM_FLOOR_MB:
        return "pressure", "free RAM %.0fM under floor %dM" % (free_ram, RAM_FLOOR_MB)
    if total > 0 and swap_pct >= SWAP_PRESSURE_PCT:
        return "pressure", "swap %.0fM of %.0fM (%.0f%%)" % (used, total, swap_pct)
    return "ok", "free RAM %.0fM, swap %.0f%% used" % (free_ram, swap_pct)


def main(argv):
    ap = argparse.ArgumentParser(description="Is this machine short of memory?")
    ap.add_argument(
        "--json", action="store_true", help="one line of JSON, not the human line"
    )
    args = ap.parse_args(argv)

    try:
        total, used = swap_mb()
        free_ram = ram_free_mb()
    except Blind as e:
        # BLIND is exit 2, never 0: a caller that cannot see the machine must not assume it is fine.
        print("BLIND  machine-pressure  %s" % e)
        return 2

    state, why = verdict(total, used, free_ram)
    if args.json:
        print(
            json.dumps(
                {
                    "state": state,
                    "why": why,
                    "free_ram_mb": round(free_ram),
                    "swap_total_mb": round(total),
                    "swap_used_mb": round(used),
                    "swap_pct": round(100.0 * used / total) if total else 0,
                }
            )
        )
    else:
        print("%-6s machine-pressure  %s" % (state.upper(), why))
    return CODE.get(state, 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
