#!/usr/bin/env bash
# Refuse an apply that would create a resource whose live namesake already exists.
# Incident 2026-08-26 02:26Z: after the state overwrite (bin/idp-state-guard), oci_kms_vault.estate
# was no longer in state; the next apply created a second, empty vault "estate-secrets",
# bin/idp-flux-bootstrap wrote its OCID into flux-system/estate-vars, and every ExternalSecret
# failed (GetSecretBundleByName 404) for ~90 minutes while the 10 secrets sat in the first vault.
# A lost-state re-create is never what anyone wants: the answer is `tofu import`, and this guard
# says so before the apply runs.
# Usage: bin/idp-recreate-guard <module dir> [tofu plan args...]. Exit 0 pass, 1 refuse, 0 + BLIND
# when the live side cannot be read (a guard that loses its evidence reports BLIND, never a verdict).
set -uo pipefail
M="${1:?module dir}"; shift
cd "$M" || { echo "BLIND   recreate  $M is not a directory"; exit 0; }
C=$(grep -o 'ocid1\.compartment[^" ]*' terraform.tfvars 2>/dev/null | head -1)
P="$M/recreate-guard.tfplan"; trap 'rm -f "$P"' EXIT
tofu plan -input=false -no-color -lock=false -out="$P" "$@" >/dev/null 2>&1 || true
[ -f "$P" ] || { echo "BLIND   recreate  tofu plan produced no plan file"; exit 0; }
CREATES=$(tofu show -no-color "$P" 2>/dev/null | grep -oE '^\s*# [a-z_.]+\[?[^ ]* will be created' | sed -E 's/^\s*# //; s/ will be created$//')
REFUSED=0
for addr in $CREATES; do
  case "$addr" in
    oci_kms_vault.estate)
      name=$(tofu show -no-color "$P" | awk -v a="$addr" '$0 ~ "# "a" will be created"{f=1} f && /display_name/{gsub(/"/,"",$3); print $3; exit}')
      [ -n "$C" ] && [ -n "$name" ] || { echo "BLIND   recreate  $addr: no compartment or display_name to check"; continue; }
      live=$(oci kms management vault list --compartment-id "$C" --query "data[?\"display-name\"=='$name' && \"lifecycle-state\"=='ACTIVE'].id | [0]" --raw-output 2>/dev/null) || { echo "BLIND   recreate  $addr: oci vault list failed"; continue; }
      if [ -n "$live" ] && [ "$live" != "null" ]; then
        echo "REFUSE  recreate  $addr would be created but ACTIVE vault '$name' already exists ($live): the state lost it; run 'tofu import $addr $live' (incident 2026-08-26 02:26Z)"; REFUSED=1
      else echo "ok      recreate  $addr: no ACTIVE vault named '$name', a create is a real create"; fi ;;
  esac
done
[ -n "$CREATES" ] || echo "ok      recreate  plan creates nothing"
exit $REFUSED
