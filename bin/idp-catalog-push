#!/usr/bin/env bash
# Publish catalog/catalog-info.yaml to the cluster as an OCI artifact (ADR 0004 step 3).
# Wraps `flux push artifact` (rejected: committing a 6,900-line generated file to git and
# kubectl-applying a ConfigMap by hand, which has no reconciler). Needs GITHUB_TOKEN in the vault
# with write:packages. Idempotent: same content pushes the same digest.
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
# estate-secrets sits beside the main checkout, even when this runs from a worktree under .claude/worktrees (crew#408)
MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
VAULT="${ESTATE_SECRETS:-$(dirname "$MAIN")/estate-secrets}"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
ENV_NAME="${OCI_ENV:-dev}"
for t in flux kubectl git; do command -v "$t" >/dev/null || { echo "BLIND $t missing"; exit 2; }; done
# sops is the vault fallback only: a runner with GH_TOKEN (catalog-render.yml) carries no vault and no sops
# (run 33102084969: "BLIND sops missing" with a valid token in the environment)
gh auth token >/dev/null 2>&1 || command -v sops >/dev/null || { echo "BLIND sops missing (and gh holds no token)"; exit 2; }
SRC="$IDP/catalog/catalog-info.yaml"
[ -s "$SRC" ] || { echo "BLIND $SRC missing; run bin/catalog-gen"; exit 2; }
T=$(mktemp -d); trap 'rm -rf "$T"' EXIT
kubectl create configmap estate-catalog --from-file=catalog-info.yaml="$SRC" --dry-run=client -o yaml > "$T/estate-catalog.yaml"
REV="$(git -C "$IDP" rev-parse --short HEAD)@$(date -u +%Y%m%dT%H%M%SZ)"
# crew#401 CP4: the vault copy of GITHUB_TOKEN answered UNAUTHORIZED on 2026-08-27 (no write:packages).
# gh on the machine that runs the schedule is the founder's account and carries it: gh first, vault second.
token() { gh auth token 2>/dev/null || sops -d --extract '["GITHUB_TOKEN"]' "$VAULT/secrets/$ENV_NAME/GITHUB_TOKEN.yaml"; }
token | flux push artifact "oci://ghcr.io/chidionyema/idp/estate-catalog:latest" \
  --path="$T" --source="https://github.com/chidionyema/idp" --revision="$REV" --creds "chidionyema:$(cat)" >/dev/null
echo "ok      estate-catalog pushed, revision $REV"
