#!/usr/bin/env bash
# Deliver a vault secret to a Mac-hosted service, without a paste (R52, LAW 54).
#
#   bin/idp-mac-secret-deliver --entry concierge-twilio --key TWILIO_AUTH_TOKEN \
#       --out ~/.concierge/secrets/TWILIO_AUTH_TOKEN --service concierge
#   bin/idp-mac-secret-deliver --check --entry ... --key ... --out ...
#
# Why this exists, and why it is not a general secret copier:
#
# The estate's rule for this Mac is explicit in bin/idp-bootstrap-macrun: "the Mac holds no cloud
# identity and the founder never pastes a secret". The one secret that reaches the machine today
# -- Otto's SSH key -- arrives that way. Mum's Sovereign Concierge needs a second one: the Twilio
# Auth Token, which its /webhook/whatsapp handler uses to verify Twilio's HMAC signature before it
# trusts anything in a request, including `From`, which whoever sends the POST controls.
#
# The service runs on this Mac because its deploy pins Homebrew, a Python 3.12 venv, ffmpeg,
# Chromium and a torch 2.2.2 / speechbrain 0.5.15 stack, and its browser operator needs her own
# Chrome profile on her own machine. The token lives in the estate vault. This is the join.
#
# What this deliberately is NOT:
#   * It does not print the value. Ever. Not to stdout, not to a log, not in an error message.
#     The only thing it prints is the path it wrote and the SHA-256 prefix, so a person can
#     confirm WHICH value landed without reading it.
#   * It does not read from Bitwarden or a vendor API. It reads the vault entry the estate already
#     synced from the human door (platform/vendors/consoles.yaml, the human-vault bridge), so a
#     rotation is his one change in Secrets Manager and nothing here changes.
#   * It does not write anywhere but the path it is given, which must be under the service's own
#     directory. A flag that can write any path is a write primitive wearing a delivery tool's
#     name.
#
# It runs where the identity is (CI, an oke-check apply step, or the operator's own shell with
# idp-cloud), never from an agent session: see the RBAC floor -- an agent identity reading secrets
# is the failure this estate refuses on purpose.
set -euo pipefail

IDP=$(cd "$(dirname "$0")/.." && pwd)
CLOUD="$IDP/bin/idp-cloud"

ENTRY=""
KEY=""
OUT=""
SERVICE=""
MODE=deliver

usage() {
	sed -n '2,8p' "$0"
	exit 2
}

while [ $# -gt 0 ]; do
	case "$1" in
	--entry)
		ENTRY=${2:-}
		shift 2
		;;
	--key)
		KEY=${2:-}
		shift 2
		;;
	--out)
		OUT=${2:-}
		shift 2
		;;
	--service)
		SERVICE=${2:-}
		shift 2
		;;
	--check)
		MODE=check
		shift
		;;
	*) usage ;;
	esac
done

say() { printf '%-7s %-22s %s\n' "$1" "$2" "$3"; }
fail() {
	say FAIL "$1" "$2"
	exit 1
}

[ -n "$ENTRY" ] || fail args "--entry is required"
[ -n "$KEY" ] || fail args "--key is required"
[ -n "$OUT" ] || fail args "--out is required"
[ -n "$SERVICE" ] || fail args "--service is required"

# The path must stay inside the service's own directory. Expanded first, then compared, so a
# symlinked or relative path cannot escape by spelling.
OUT_EXPANDED=$(python3 -c 'import os,sys; print(os.path.realpath(os.path.expanduser(sys.argv[1])))' "$OUT")
HOME_REAL=$(python3 -c 'import os; print(os.path.realpath(os.path.expanduser("~")))')
case "$OUT_EXPANDED" in
"$HOME_REAL/.$SERVICE"/*) ;;
*) fail args "--out must be under ~/.$SERVICE (got $OUT_EXPANDED)" ;;
esac

# One call, and the value is never assigned to a variable this shell can print. `idp-cloud` holds
# the identity; a session or a runner without it fails here, loudly, which is the point.
if ! value=$("$CLOUD" secret get "$ENTRY" 2>/dev/null); then
	fail "$ENTRY" "vault entry unreadable by this identity (no cloud identity here, or no grant)"
fi
[ -n "$value" ] || fail "$ENTRY" "vault entry is empty"

# The entry is a JSON object per the estate's own shape; the named key is the field. A plain
# string entry is also accepted, because some entries are one value.
field=$(printf '%s' "$value" | python3 -c '
import json, sys
raw = sys.stdin.read()
try:
    doc = json.loads(raw)
except Exception:
    print(raw)
else:
    print(doc.get(sys.argv[1], "") if isinstance(doc, dict) else raw)
' "$KEY")

if [ -z "$field" ] && [ "$MODE" = check ]; then
	fail "$ENTRY" "no field named $KEY in the entry"
fi

if [ "$MODE" = check ]; then
	[ -f "$OUT_EXPANDED" ] || fail "$SERVICE" "no secret at $OUT_EXPANDED"
	# Compare by hash: matching means the file already holds what the vault holds, without either
	# value being printed or read into a shell variable that could leak.
	vault_sha=$(printf '%s' "$field" | python3 -c 'import sys,hashlib; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest()[:8])')
	file_sha=$(python3 -c 'import sys,hashlib; print(hashlib.sha256(open(sys.argv[1],"rb").read().rstrip(b"\n")).hexdigest()[:8])' "$OUT_EXPANDED")
	if [ "$vault_sha" = "$file_sha" ]; then
		say ok "$SERVICE" "$KEY at $OUT_EXPANDED matches the vault (sha $vault_sha)"
		exit 0
	fi
	fail "$SERVICE" "$KEY at $OUT_EXPANDED does not match the vault (file $file_sha, vault $vault_sha)"
fi

mkdir -p "$(dirname "$OUT_EXPANDED")"
umask 077
# Written by python so the value never enters the shell's argv (visible to any process on the
# node) and never appears in a trace. 0600, owner only.
printf '%s' "$field" | python3 -c '
import os, sys
path = sys.argv[1]
data = sys.stdin.buffer.read().rstrip(b"\n") + b"\n"
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "wb") as fh:
    fh.write(data)
' "$OUT_EXPANDED"

FINAL_SHA=$(python3 -c 'import sys,hashlib; print(hashlib.sha256(open(sys.argv[1],"rb").read().rstrip(b"\n")).hexdigest()[:8])' "$OUT_EXPANDED")
say ok "$SERVICE" "$KEY delivered to $OUT_EXPANDED (sha $FINAL_SHA, mode 600)"
