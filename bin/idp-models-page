#!/usr/bin/env python3
"""Write one catalogue entity per model artifact, so the portal shows what exists and what runs.

    bin/idp-models-page            # write backstage/platform/models.catalog-info.yaml
    bin/idp-models-page --check    # exit 1 if the file on disk differs

WHY THIS EXISTS. On 2026-09-12 the estate had five models on the shelf and one running, and NO PAGE
said so. The founder asked "how else am I going to use it if I don't have backstage", and the answer
was that the capability was real and its door was missing. A model that exists and cannot be seen is
a model nobody can use.

WHAT IT READS, and every field is measured rather than remembered:

  * GHCR        which artifacts exist, their newest digest and tag
  * the cluster whether a Deployment for that model exists, and its replicas
  * pods        how many are actually Ready right now

STATE IS THE POINT. An entity that says "model: falcon" is a list entry. An entity whose description
says "running, 1 of 1 ready" is an instrument -- the founder can see a stopped model without asking
anybody, which is the whole reason for the page.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]
OUT = ROOT / "backstage/platform/models.catalog-info.yaml"
ZONE = "${ESTATE_ZONE}"


def _sh(*args: str) -> str:
    r = subprocess.run(args, capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def artifacts() -> list[dict]:
    """Every model artifact in GHCR. Read, never listed by hand."""
    names = _sh("gh", "api", "users/chidionyema/packages?package_type=container&per_page=100",
                "--jq", ".[].name").split()
    out = []
    for name in names:
        if not name.startswith("models/"):
            continue
        task = name.split("/", 1)[1]
        v = _sh("gh", "api",
                f"users/chidionyema/packages/container/models%2F{task}/versions",
                "--jq", '.[0]|{digest:.name,tags:(.metadata.container.tags//[])}').strip()
        if not v:
            continue
        d = json.loads(v)
        # An untagged version is the COSIGN SIGNATURE, not the image.
        if not d["tags"]:
            continue
        out.append({"task": task, "digest": d["digest"], "tag": d["tags"][0]})
    return sorted(out, key=lambda a: a["task"])


def running() -> dict[str, str]:
    """What the cluster says about each expert Deployment, by model name."""
    raw = _sh("kubectl", "get", "deploy", "-n", "edge-runtime", "-o", "json")
    if not raw:
        return {}
    state = {}
    for d in json.loads(raw).get("items", []):
        name = d["metadata"]["name"]
        if not name.startswith("expert-"):
            continue
        model = name[len("expert-"):]
        want = d["spec"].get("replicas", 0)
        ready = d["status"].get("readyReplicas", 0)
        if want == 0:
            word = "stopped"
        elif ready >= want:
            word = f"running, {ready} of {want} ready"
        else:
            word = f"starting, {ready} of {want} ready"
        state[model] = word
    return state


def entity(a: dict, state: str) -> str:
    model = a["task"]
    # The portal's own words. A person reading the card sees whether it runs before they see a
    # digest, because the digest is not the question they are asking.
    return f"""---
apiVersion: backstage.io/v1alpha1
kind: Component
metadata:
  name: model-{model}
  title: 'Model: {model}'
  description: 'An open-weight model the estate can run itself. State right now: {state}.'
  annotations:
    estate/coupling: model
    estate/registry: 'ghcr'
    estate/digest: '{a["digest"]}'
    estate/namespace: 'edge-runtime'
    estate/deployment: 'expert-{model}'
  tags: [model, 'model-{model}']
  links:
    - title: 'The artifact in the registry'
      url: https://github.com/chidionyema/idp/pkgs/container/models%2F{model}
spec:
  type: model
  lifecycle: production
  owner: group:default/platform
  system: ai
"""


def body() -> str:
    arts = artifacts()
    live = running()
    header = (
        "# GENERATED by bin/idp-models-page -- do not hand-edit; the next run overwrites it.\n"
        "#\n"
        "# One entity per model artifact in GHCR. The description carries its STATE, read from the\n"
        "# cluster, so a stopped model is visible in the portal without asking anybody.\n"
    )
    return header + "".join(entity(a, live.get(a["task"], "on the shelf, not running")) for a in arts)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()
    text = body()
    if args.check:
        if not OUT.exists():
            print(f"FAIL  {OUT.relative_to(ROOT)} does not exist; run bin/idp-models-page")
            return 1
        if OUT.read_text() != text:
            print(f"FAIL  {OUT.relative_to(ROOT)} is stale; run bin/idp-models-page and commit")
            return 1
        n = text.count("kind: Component")
        print(f"ok    models-page: {OUT.relative_to(ROOT)} matches {n} model(s)")
        return 0
    OUT.parent.mkdir(parents=True, exist_ok=True)
    OUT.write_text(text)
    n = text.count("kind: Component")
    print(f"ok    models-page: wrote {OUT.relative_to(ROOT)} for {n} model(s)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
