#!/usr/bin/env python3
"""Claude Code PreToolUse hook on Read: a whole-file read of a big text file goes to a free
worker model, and the frontier model gets a digest instead of the file.

Why (2026-10-08): the read-shunt the 2026-09-20 harness synthesis lists as a wired hook was
not wired -- the live settings.json had no hooks block, claude-guards/read-shunt.py pointed
at the opencode TypeScript guard, and claude-guards/read_shunt dangled into a deleted
directory. Every big Read in every session went to Opus at full price. This is that guard
again, ported from estate/opencode-plugin/guards/read-shunt.ts (same threshold, prompt and
reason text), with the difference that a hook here may never cost a turn: any failure --
no router, a slow worker, a binary file -- lets the Read through untouched.

A ranged Read (offset or limit) is never shunted, so exact text is always one call away.
Opt out for a session with ESTATE_READ_SHUNT=0.

Wiring lives outside the estate (no harness folders here, 1ba8ecd17): a copy is installed at
~/.estate/hooks/idp-read-shunt and $CLAUDE_CONFIG_DIR/settings.json runs it as a PreToolUse
hook on Read. Every outcome lands in ~/.estate/read-shunt-ledger.jsonl.
"""

import hashlib
import json
import os
import sys
import time
import urllib.request

THRESHOLD_LINES = int(os.environ.get("ESTATE_READ_SHUNT_LINES", "350"))
MAX_CHARS = int(os.environ.get("ESTATE_READ_SHUNT_MAX_CHARS", "200000"))
TIMEOUT_S = float(os.environ.get("ESTATE_READ_SHUNT_TIMEOUT", "20"))
MAX_TOKENS = 3000
# deepseek, measured 2026-10-08 on a 1119-line file: 6s, a well-formed digest, line ranges
# exact. The free gpt-oss lanes (groq, cerebras, fast) took 13-44s and returned an empty or
# reasoning-only answer about half the time, since their reasoning length ignores
# reasoning_effort. deepseek bills ~$0.002 for that file against ~$0.17 of Opus input.
WORKER_MODEL = os.environ.get("ESTATE_READ_SHUNT_MODEL", "deepseek")
CHARS_PER_TOKEN = 4
STATE = os.path.expanduser(os.environ.get("ESTATE_READ_SHUNT_STATE", "~/.estate"))
LEDGER = os.path.join(STATE, "read-shunt-ledger.jsonl")
CACHE = os.path.join(STATE, "read-shunt-cache")
# Claude Code renders these itself (images, PDFs, notebooks); a text digest would lose them.
SKIP_EXT = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico", ".svg",
    ".pdf", ".ipynb",
}  # fmt: skip

PROMPT = """You are a code-reading worker for a senior engineer who will NOT see this file. Produce a digest they can act on without reading it. Be exact and dense; no preamble. HARD BUDGET: the whole digest must be under 2500 characters.

FILE: {path} ({lines} lines)

Return, in this order, as plain text with these headings:
PURPOSE: one or two sentences.
STRUCTURE: the top-level units as `L<start>-L<end> <name>: <=8 words`.
KEY VALUES: constants, env vars, paths, ports, hosts, versions, flags.
NOTABLE: bugs, TODOs, dead code, security smells.
READ EXACTLY: the 1-3 line ranges most worth reading verbatim.

FILE CONTENT:
{content}"""


def _ledger(row: dict) -> None:
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(LEDGER, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
    except OSError:
        pass  # the ledger may never cost the Read


def _router() -> "tuple[str, str]":
    base = os.environ.get("ANTHROPIC_BASE_URL") or "http://127.0.0.1:4000"
    key = os.environ.get("LITELLM_API_KEY", "")
    if not key:
        for line in (os.environ.get("ANTHROPIC_CUSTOM_HEADERS") or "").splitlines():
            name, _, value = line.partition(":")
            if name.strip().lower() == "x-litellm-api-key":
                key = value.strip()
    return base.rstrip("/"), key


def _digest(path: str, text: str, lines: int) -> str:
    base, key = _router()
    # Numbered, as Read shows it: without numbers the worker's L<start>-L<end> ranges drifted
    # 10-20 lines on a 1119-line file (measured 2026-10-08), and a wrong range costs a re-read.
    text = "".join(f"{i}\t{ln}" for i, ln in enumerate(text.splitlines(True), 1))
    body = {
        "model": WORKER_MODEL,
        "messages": [
            {
                "role": "user",
                "content": PROMPT.format(
                    path=path, lines=lines, content=text[:MAX_CHARS]
                ),
            }
        ],
        "max_tokens": MAX_TOKENS,
        "temperature": 0,
    }
    req = urllib.request.Request(
        f"{base}/v1/chat/completions",
        data=json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=TIMEOUT_S) as resp:
        data = json.load(resp)
    return (data["choices"][0]["message"]["content"] or "").strip()


def decide(event: dict) -> "dict | None":
    """The hook's answer for one PreToolUse event, or None to let the Read through."""
    if os.environ.get("ESTATE_READ_SHUNT") == "0" or event.get("tool_name") != "Read":
        return None
    args = event.get("tool_input") or {}
    path = args.get("file_path") or ""
    if args.get("offset") or args.get("limit") or args.get("pages"):
        return None
    if os.path.splitext(path)[1].lower() in SKIP_EXT or not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except (OSError, UnicodeDecodeError):
        return None
    lines = text.count("\n") + 1
    if lines <= THRESHOLD_LINES:
        return None

    started = time.time()
    st = os.stat(path)
    key = hashlib.sha256(f"{path}:{st.st_mtime_ns}:{st.st_size}".encode()).hexdigest()
    cached = os.path.join(CACHE, key[:32])
    row = {
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(started)),
        "session": event.get("session_id"),
        "path": path,
        "lines": lines,
        "model": WORKER_MODEL,
        "est_tokens_full": len(text) // CHARS_PER_TOKEN,
    }
    try:
        with open(cached, encoding="utf-8") as fh:
            digest, row["cache"] = fh.read(), "hit"
    except OSError:
        try:
            digest, row["cache"] = _digest(path, text, lines), "miss"
        except Exception as exc:  # noqa: BLE001 - a worker failure passes the Read through
            _ledger({**row, "outcome": "passed-through", "error": str(exc)[:200]})
            return None
        digest = digest[:8000]
        if not all(h in digest.upper() for h in ("PURPOSE", "STRUCTURE")):
            # Not the digest asked for (empty, or the worker's reasoning): the real file beats it.
            bad = {"outcome": "passed-through", "error": "malformed digest"}
            _ledger({**row, **bad, "head": digest[:80]})
            return None
        try:
            os.makedirs(CACHE, exist_ok=True)
            with open(cached, "w", encoding="utf-8") as fh:
                fh.write(digest)
        except OSError:
            pass
    row.update(
        outcome="shunted",
        ms=round((time.time() - started) * 1000),
        est_tokens_digest=len(digest) // CHARS_PER_TOKEN,
    )
    row["est_tokens_saved"] = max(0, row["est_tokens_full"] - row["est_tokens_digest"])
    _ledger(row)
    reason = (
        f"read-shunt: {path} is {lines} lines (over {THRESHOLD_LINES}); the full read went "
        f"to the worker model `{WORKER_MODEL}` and this digest came back instead. For exact "
        f"text call Read with offset and limit (a ranged read is never shunted).\n\n{digest}"
    )
    return {
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": reason,
        }
    }


def main() -> int:
    try:
        out = decide(json.load(sys.stdin))
    except Exception:  # noqa: BLE001 - never block a Read on the guard's own bug
        return 0
    if out:
        print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
