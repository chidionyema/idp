#!/usr/bin/env python3
"""Give every agent runtime on this machine estate memory, from one manifest (#6156).

    bin/estate-memory-install                    write what is missing or stale, for every runtime present
    bin/estate-memory-install --check            write nothing; exit 1 when any present runtime has drifted
    bin/estate-memory-install --runtime pi       one runtime only (repeatable)

The manifest is platform/estate/memory/runtimes.json. For each runtime it names an MCP entry (the
same bin/estate-memory-mcp everywhere) and, where the runtime has one, a session-start hook (the
same bin/estate-brief everywhere). A runtime whose config directory is absent is skipped, not
created: installing a config for a tool nobody uses is how a second copy starts.

Only the estate-memory entry and the estate-brief hook are touched; every other key in a config is
kept as it was. A link destination that exists and is not a symlink is refused, never replaced --
it is somebody's file. No key is written anywhere: the bridge reads it by name at call time.

Runtimes run a copy, not a checkout. The bridge, the brief, the door and the manifest are copied
into a home of their own ($ESTATE_MEMORY_HOME, default ~/.estate/memory, laid out as the repo is)
and every config points there. A checkout is somebody's working tree: on 2026-10-14 the primary
one sat on another lane's branch, 119 commits behind main, without these files at all, and a
branch switch would have taken memory out of every runtime at once. --check reports a stale copy
as drift, so a merged change reaches the runtimes by one rerun from an up-to-date checkout.

Every runtime names its plan_lock: how it refuses work until a declared plan allows it (#6675).
The bridge serves the plan tools everywhere but cannot refuse a runtime's own tools, so a runtime
with no plan_lock would work unplanned and nothing would say so. When such a runtime's command is
on PATH it is reported UNLOCKED and the run exits 1; memory is still written for it.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
MANIFEST = json.loads(
    (HERE / "platform" / "estate" / "memory" / "runtimes.json").read_text()
)


def expand(p: str, rt: dict) -> Path:
    if p.startswith("$CLAUDE_CONFIG_DIR"):
        base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser(
            rt["mcp"]["default_dir"]
        )
        p = base + p[len("$CLAUDE_CONFIG_DIR") :]
    return Path(os.path.expanduser(p))


def load(path: Path) -> dict:
    if not path.exists():
        return {}
    text = path.read_text()
    if path.suffix == ".jsonc" and re.search(r"(?m)^\s*//|/\*", text):
        raise SystemExit(
            f"refused: {path} has comments; rewriting it as JSON would drop them"
        )
    return json.loads(text) if text.strip() else {}


def save(path: Path, data: dict) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f, indent=2)
        f.write("\n")
    if path.exists():
        os.chmod(tmp, path.stat().st_mode & 0o777)
    os.replace(tmp, path)


def mcp_entry(shape: str, root: Path) -> dict:
    bridge = str(root / MANIFEST["bridge"])
    if shape == "opencode":
        return {"type": "local", "command": ["python3", bridge], "enabled": True}
    return {"command": "python3", "args": [bridge]}


def brief_command(root: Path) -> str:
    return f"python3 {root / MANIFEST['session_start']}"


def home_files() -> list[str]:
    """Every file a runtime runs or links, as a path relative to the repo."""
    links = [
        rt["hook"]["source"]
        for rt in MANIFEST["runtimes"].values()
        if rt.get("hook", {}).get("kind") == "link"
    ]
    memory = "platform/estate/memory"
    return [
        MANIFEST["bridge"],
        MANIFEST["session_start"],
        MANIFEST["enforce"]["bin"],
        # The plan lock's refusal names this copy by path: without it a session whose bridge did
        # not load is told to run a file that is not there, and is locked out (#6675).
        "bin/estate-plan",
        f"{memory}/door.py",
        f"{memory}/focus.py",
        f"{memory}/handback.py",
        f"{memory}/plan.py",
        f"{memory}/runtimes.json",
        *links,
    ]


def plan_home(root: Path) -> list[tuple[str, Path, object]]:
    """The copies the home needs so it matches this checkout, empty when in step."""
    changes = []
    for rel in home_files():
        source, dest = HERE / rel, root / rel
        if dest.exists() and dest.read_bytes() == source.read_bytes():
            continue

        def copy(source=source, dest=dest):
            dest.parent.mkdir(parents=True, exist_ok=True)
            fd, tmp = tempfile.mkstemp(dir=dest.parent, prefix=f".{dest.name}.")
            with os.fdopen(fd, "wb") as f:
                f.write(source.read_bytes())
            os.chmod(tmp, source.stat().st_mode & 0o777)
            os.replace(tmp, dest)

        changes.append(("copy", dest, copy))
    return changes


def enforce_command(root: Path, arg: str) -> str:
    return f"python3 {root / MANIFEST['enforce']['bin']} {arg}"


def plan_enforce(path: Path, root: Path) -> list[tuple[str, Path, object]]:
    """The memory/focus enforcement hooks (PreToolUse, Stop) a settings runtime must carry.

    Each is matched by its command, so a reinstall replaces the estate's own entries and leaves
    every other hook in the file alone. One event may carry several (PreToolUse: pre and plan), so
    an event's entries are compared and written together, never one overwriting the other."""
    marker = MANIFEST["enforce"]["bin"]
    changes = []
    events: dict = {}
    for spec in MANIFEST["enforce"]["hooks"]:
        events.setdefault(spec["event"], []).append(spec)
    for event, specs in events.items():
        want = [(s.get("matcher"), enforce_command(root, s["arg"])) for s in specs]
        groups = load(path).get("hooks", {}).get(event, [])
        mine = [
            (g.get("matcher"), h.get("command"))
            for g in groups
            for h in g.get("hooks", [])
            if marker in h.get("command", "")
        ]
        if mine == want:
            continue

        def put(path=path, event=event, want=want):
            data = load(path)
            kept = [
                g
                for g in data.setdefault("hooks", {}).get(event, [])
                if not any(marker in h.get("command", "") for h in g.get("hooks", []))
            ]
            ours = []
            for matcher, cmd in want:
                group = {"hooks": [{"type": "command", "command": cmd, "timeout": 15}]}
                if matcher:
                    group["matcher"] = matcher
                ours.append(group)
            data["hooks"][event] = [*kept, *ours]
            save(path, data)

        changes.append(("hook", path, put))
    return changes


def unlocked(rt: dict) -> "str | None":
    """The installed command of a runtime that nothing holds to a plan, else None."""
    if rt["plan_lock"]:
        return None
    return shutil.which(rt["command"])


def plan(name: str, rt: dict, root: Path) -> list[tuple[str, Path, object]]:
    """The changes this runtime needs: (what, where, how to apply), empty when in step."""
    mcp_file = expand(rt["mcp"]["file"], rt)
    if not mcp_file.parent.is_dir():
        return [("absent", mcp_file.parent, None)]
    changes = []

    cfg = load(mcp_file)
    want = mcp_entry(rt["mcp"]["shape"], root)
    if cfg.get(rt["mcp"]["key"], {}).get(MANIFEST["server"]) != want:

        def put_mcp(path=mcp_file, key=rt["mcp"]["key"], want=want):
            data = load(path)
            data.setdefault(key, {})[MANIFEST["server"]] = want
            save(path, data)

        changes.append(("mcp", mcp_file, put_mcp))

    hook = rt.get("hook")
    if hook and hook["kind"] == "settings":
        path, cmd = expand(hook["file"], rt), brief_command(root)
        groups = load(path).get("hooks", {}).get(hook["event"], [])
        mine = [
            h
            for g in groups
            for h in g.get("hooks", [])
            if MANIFEST["session_start"] in h.get("command", "")
        ]
        if [h.get("command") for h in mine] != [cmd]:

            def put_hook(path=path, event=hook["event"], cmd=cmd):
                data = load(path)
                kept = [
                    g
                    for g in data.setdefault("hooks", {}).get(event, [])
                    if not any(
                        MANIFEST["session_start"] in h.get("command", "")
                        for h in g.get("hooks", [])
                    )
                ]
                data["hooks"][event] = [
                    *kept,
                    {"hooks": [{"type": "command", "command": cmd}]},
                ]
                save(path, data)

            changes.append(("hook", path, put_hook))
        changes += plan_enforce(path, root)
    elif hook and hook["kind"] == "link":
        dest, source = expand(hook["dest"], rt), root / hook["source"]
        if dest.is_symlink() and Path(os.readlink(dest)) == source:
            pass
        elif dest.exists() and not dest.is_symlink():
            changes.append(("refused", dest, None))
        else:

            def link(dest=dest, source=source):
                dest.parent.mkdir(parents=True, exist_ok=True)
                if dest.is_symlink():
                    dest.unlink()
                dest.symlink_to(source)

            changes.append(("hook", dest, link))
    return changes


def commits_behind_main() -> int:
    """How far this checkout is behind origin/main; 0 when git cannot say."""
    try:
        out = subprocess.run(
            ["git", "-C", str(HERE), "rev-list", "--count", "HEAD..origin/main"],
            capture_output=True,
            text=True,
            timeout=10,
        )
        return int(out.stdout) if out.returncode == 0 else 0
    except (OSError, ValueError, subprocess.SubprocessError):
        return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--runtime", action="append", choices=sorted(MANIFEST["runtimes"]))
    ap.add_argument(
        "--home", default=os.environ.get("ESTATE_MEMORY_HOME", "~/.estate/memory")
    )
    args = ap.parse_args(argv)
    root = Path(os.path.expanduser(args.home)).resolve()
    if root == HERE:
        raise SystemExit(
            f"refused: the home {root} is this checkout; runtimes run a copy"
        )

    drift = refused = 0
    rows = [("home", plan_home(root))] + [
        (name, plan(name, MANIFEST["runtimes"][name], root))
        for name in args.runtime or sorted(MANIFEST["runtimes"])
    ]
    for name, changes in rows:
        for what, where, apply in changes or [("ok", None, None)]:
            if what == "absent":
                print(f"absent   {name:<12} no {where}")
            elif what == "ok":
                print(f"ok       {name}")
            elif what == "refused":
                refused += 1
                print(
                    f"REFUSED  {name:<12} {where} exists and is not a link; move it to install"
                )
            elif args.check:
                drift += 1
                print(f"DRIFT    {name:<12} {what} {where}")
            else:
                apply()
                print(f"wrote    {name:<12} {what} {where}")
    for name in args.runtime or sorted(MANIFEST["runtimes"]):
        found = unlocked(MANIFEST["runtimes"][name])
        if found:
            refused += 1
            print(
                f"UNLOCKED {name:<12} {found} is installed and nothing holds it to a plan (#6675)"
            )
    behind = commits_behind_main() if args.check and drift else 0
    if behind:
        print(
            f"NOTE     this checkout is {behind} commits behind origin/main; the DRIFT above"
            " may be the checkout, not the install. Re-run from a current main checkout.",
            file=sys.stderr,
        )
    return 1 if drift or refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
