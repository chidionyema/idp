#!/usr/bin/env bash
# conformity-report: Annex VI internal-control assessment, rendered from the gates
# rather than written by hand. Prints markdown to stdout; nothing is committed
# because a stored copy is a stale copy (LAW 24 excludes generated output).
set -u
IDP="$(cd "$(dirname "$0")/.." && pwd)"
d="${TODAY:-$(date +%F)}"
echo "# Conformity assessment by internal control (Annex VI), $d"
echo
echo "Voluntary, for minimal-risk systems. Each line is a gate's own output."
echo
echo '```'
python3 "$IDP/bin/ai-act-gate" "$IDP" 2>&1
python3 "$IDP/bin/security-policy-gate" 2>&1
"$IDP/bin/policy-test" 2>&1 | tail -1
python3 "$IDP/bin/multiarch-gate" "$IDP" 2>&1 | tail -1
echo '```'
echo
echo "Systems assessed:"
python3 - "$IDP" <<'PY'
import sys, yaml, os
root = sys.argv[1]
for s in yaml.safe_load(open(os.path.join(root, "platform/ai/systems.yaml")))["systems"]:
    print(f"- {s['name']}: tier {s['risk_tier']}, role {s['role']}, owner {s['owner']}, file {s['technical_file']}, review due {s['review_due']}")
PY
