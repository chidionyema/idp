#!/usr/bin/env bash
# crew#584 CP-A: wait for the portability drill only as long as it takes to reach the floor.
#
# Before this, .github/workflows/portability-drill.yml ran
#   kubectl wait kustomization --all -A --for=condition=Ready --timeout=600s || true
# which burns the full 600 s on every run, because the OCI-only layers (vault, DNS, receipts
# bucket) are designed to stay red on a cluster with no OCI identity. Measured 2026-08-29:
# 11 min x9 of the last 10 drill runs, 16 min x1. Every PR that touches platform/ paid it.
#
# This polls bin/idp-portability-drill against drills/portability-floor.txt every
# DRILL_WAIT_STEP seconds and exits 0 the moment the floor is met. It exits 0 on the
# DRILL_WAIT_MAX ceiling too: the grade step after it is the verdict, this is only the wait.
#
# crew#488, 2026-08-29: it then settles DRILL_WAIT_GRACE seconds more. Exiting on the first poll
# at the floor broke the floor's own ratchet -- drills/portability-floor.txt says "Only goes up:
# raise it in the PR that carries the green run URL that beat it", and a run that stops the
# instant it reaches the floor can never beat it. Measured on one tree: 11/41 with the old 600 s
# settle (run 33220112386), then exactly 9/42 twice with the floor at 9 (run 33225061822, jobs
# 99026942901 and 99026943071). The count had stopped measuring the cluster and started echoing
# the floor file. 60 s on a wait that costs ~200 s, against the 600 s this replaced.
# DRILL_WAIT_GRACE=0 switches it off for a run that only needs to know the floor held.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
max="${DRILL_WAIT_MAX:-600}"
step="${DRILL_WAIT_STEP:-10}"
grace="${DRILL_WAIT_GRACE:-60}"
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT
t0=$(date +%s)
while :; do
	kubectl get kustomizations -A -o json >"$tmp" 2>/dev/null || echo '{"items":[]}' >"$tmp"
	if verdict="$("$ROOT/bin/idp-portability-drill" "$tmp" 2>/dev/null | tail -1)" && [[ "$verdict" == ok* ]]; then
		echo "floor met after $(($(date +%s) - t0)) s: $verdict"
		if ((grace > 0)); then
			echo "settling ${grace} s more so this run can still beat the floor (crew#488)"
			sleep "$grace"
		fi
		exit 0
	fi
	if (($(date +%s) - t0 >= max)); then
		echo "floor not met after ${max} s; grading what came up: ${verdict:-no verdict}"
		exit 0
	fi
	sleep "$step"
done
