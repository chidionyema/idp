#!/usr/bin/env python3
"""Generate Flux Alert eventSources from the live namespace inventory (crew#344).

WHY. platform/alerts/alert.yaml named 7 namespaces by hand. A namespace shipped
without a matching hand-added line got no alert coverage, silently -- crew#308 and
crew#340 are both real instances of this class. This generator makes coverage the
default: every namespace that carries a HelmRelease, Kustomization or GitRepository
Flux manages is covered unless explicitly excluded, so the failure mode flips from
"forgot to add a line" (silent) to "explicitly excluded" (a decision, on the record).

INPUT (real use): the live cluster's namespace + Flux resource inventory, via
`kubectl get helmrelease,kustomization,gitrepository -A -o json` piped in, or
`--stdin-inventory` with the same {"namespaces": [...], "excluded": [...]} shape
used by tests/test_incident_crew344_*.py for fast, cluster-free testing.

OUTPUT: {"eventSources": [{"kind": ..., "name": "*", "namespace": ...}, ...]},
suitable for splicing into platform/alerts/alert.yaml's spec.eventSources list.

Idempotent by construction: output is a pure function of the inventory, sorted for
determinism, so two runs over one identical inventory are byte-identical (the
generator invariant every idp generator already carries, AGENTS.md).

  python3 bin/idp-alert-coverage --stdin-inventory < inventory.json
  python3 bin/idp-alert-coverage --selftest    # one case that must alert, one that must not
"""
from __future__ import annotations

import json
import sys

# Namespaces excluded by default: Kubernetes system machinery this platform does not
# own or manage via Flux, so alerting on it would be noise, not signal. A namespace
# can also be excluded explicitly via the "excluded" input field (a deliberate,
# on-the-record decision, per-run) -- this default set is the always-excluded floor.
DEFAULT_EXCLUDED = {"kube-system", "kube-public", "kube-node-lease"}

# Kind preference when a namespace carries multiple Flux-managed resource types.
# flux-system itself is watched via its Kustomizations (its own reconcile health),
# not a HelmRelease -- there isn't one for the Flux controllers themselves.
_KIND_FOR_NAMESPACE_DEFAULT = "HelmRelease"
_KIND_OVERRIDE = {"flux-system": "Kustomization"}


def build_coverage(namespaces: list[dict], excluded: list[str]) -> dict:
    excluded_set = DEFAULT_EXCLUDED | set(excluded)
    sources = []
    for ns in namespaces:
        name = ns["name"]
        if name in excluded_set:
            continue
        if not ns.get("has_helmrelease_or_kustomization", False):
            continue
        kind = _KIND_OVERRIDE.get(name, _KIND_FOR_NAMESPACE_DEFAULT)
        sources.append({"kind": kind, "name": "*", "namespace": name})
    # Deterministic order: idempotency (T3) requires this, not just correct membership.
    sources.sort(key=lambda e: (e["namespace"], e["kind"]))
    return {"eventSources": sources}


def selftest() -> int:
    ok = True

    # must-pass: a namespace nobody excluded gets coverage by default (the class fix).
    r1 = build_coverage([{"name": "brand-new-service", "has_helmrelease_or_kustomization": True}], [])
    got1 = any(e["namespace"] == "brand-new-service" for e in r1["eventSources"])
    print(f"new-namespace-covered: {'PASS' if got1 else 'FAIL'} ok" if got1 else "new-namespace-covered: FAIL")
    ok &= got1

    # must-fail-to-alert: an explicitly excluded namespace stays silent, on purpose.
    r2 = build_coverage([{"name": "scratch-dev", "has_helmrelease_or_kustomization": True}], ["scratch-dev"])
    got2 = not any(e["namespace"] == "scratch-dev" for e in r2["eventSources"])
    print(f"excluded-namespace-silent: {'PASS' if got2 else 'FAIL'} ok" if got2 else "excluded-namespace-silent: FAIL")
    ok &= got2

    return 0 if ok else 1


def main() -> int:
    if "--selftest" in sys.argv:
        return selftest()
    if "--stdin-inventory" in sys.argv:
        try:
            payload = json.load(sys.stdin)
        except Exception as exc:  # noqa: BLE001
            print(f"BLIND   idp-alert-coverage: invalid JSON on stdin: {exc}", file=sys.stderr)
            return 2
        result = build_coverage(payload.get("namespaces", []), payload.get("excluded", []))
        print(json.dumps(result, indent=2, sort_keys=True))
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main())
