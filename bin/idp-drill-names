#!/usr/bin/env python3
"""Print, as a JSON list, the union of drill names across one or more drills/catalogue.yaml files.

bin/pr-report feeds the gate the catalogue on main and, when the pull request changes the
catalogue, the copy at the PR head, so `Drill: <name>` may name a row the same PR adds
(policy/operating_model.rego drill_named). A file that is missing or unreadable adds nothing
and is named on stderr; the caller decides whether that is BLIND.
"""
import json
import sys

import yaml


def names(paths: list[str]) -> list[str]:
    out: list[str] = []
    for path in paths:
        try:
            with open(path) as fh:
                doc = yaml.safe_load(fh) or {}
        except (OSError, yaml.YAMLError) as exc:
            print(f"idp-drill-names: skipped {path}: {exc}", file=sys.stderr)
            continue
        for d in doc.get("drills", []) or []:
            n = d.get("name") if isinstance(d, dict) else None
            if n and n not in out:
                out.append(n)
    return out


if __name__ == "__main__":
    print(json.dumps(names(sys.argv[1:])))
