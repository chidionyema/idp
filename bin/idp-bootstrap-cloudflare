#!/usr/bin/env bash
# Root trust for Cloudflare, one command, no hands (crew#66 founder 2026-08-28; docs/policy/root-trust.md; crew#578).
#   bin/idp-bootstrap-cloudflare              mint the DNS token and the R2 credential, write vault entries cloudflare-api-token + prospector-engine-env.R2_*
#   bin/idp-bootstrap-cloudflare --preflight  prove the vault, the browser driver and the dashboard reachability, write nothing
#   bin/idp-bootstrap-cloudflare --rotate     mint anew even though the vault entries already verify
#
# What the provider allows, measured 2026-08-28 from developers.cloudflare.com/api (User API Tokens)
# and developers.cloudflare.com/r2/api/tokens:
#   - POST /user/tokens creates an API token with any permission groups — but only for a caller that
#     already holds a token with "User API Tokens: Edit". The first token is born nowhere but the
#     dashboard (dash.cloudflare.com/profile/api-tokens), behind the founder's login.
#   - An R2 S3 credential is an API token with the R2 permission group: access key id = the token's
#     id, secret access key = SHA-256 of the token value. So R2 keys are API-minted too.
#   - Rejected: `wrangler login` (OAuth, one consent) — its scope list (account:read, user:read,
#     workers:*, pages:write, zone:read, ssl_certs:write, d1/queues/r2 buckets...) carries neither
#     dns_records:edit nor api_tokens:edit, so the OAuth token can neither serve external-dns nor
#     mint the tokens that would. Rejected: the Global API Key (a password-equivalent, no scope).
# So this script drives the dashboard once for a single "root" token (User API Tokens: Edit only,
# expiring in one hour), and everything after that is the API in this process: a DNS token
# (Zone.DNS: Edit on the estate zone) for external-dns and the cert solver, an R2 token (Account
# R2 Storage: Edit) for the product's store, the bucket itself, each verified before the vault is
# written through bin/idp-vault-put. The root token is deleted at the end. Nothing is printed but
# key NAMES. The founder's whole part is the dashboard login when the estate browser profile has no
# live session.
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
API=${CLOUDFLARE_API_URL:-https://api.cloudflare.com/client/v4}
CONSOLE=${CLOUDFLARE_CONSOLE_URL:-https://dash.cloudflare.com/profile/api-tokens}
HOME_DIR=${ESTATE_HOME:-$HOME/.estate}
PROFILE="$HOME_DIR/cloudflare-browser"
VENV="$HOME_DIR/bootstrap-venv"
CFG="$IDP/clusters/oke/estate-config.yaml"
MODE=${1:-mint}
case "$MODE" in mint|--preflight|--rotate) ;; *) sed -n 2,5p "$0"; exit 2;; esac

say()  { printf '%-7s %-20s %s\n' "$1" "$2" "$3"; }
fail() { say FAIL "$1" "$2"; exit 1; }
bl()   { say BLIND "$1" "$2"; exit 2; }
for t in python3 curl jq; do command -v "$t" >/dev/null || bl deps "$t missing"; done
ZONE=$(awk '/ESTATE_ZONE:/{print $2}' "$CFG" 2>/dev/null || true); [ -n "$ZONE" ] || bl config "no ESTATE_ZONE in $CFG"
BUCKET=${R2_BUCKET:-$(python3 -c "import yaml,sys; print(yaml.safe_load(open(sys.argv[1])).get('r2',{}).get('bucket',''))" "$IDP/estate-defaults.yaml" 2>/dev/null || true)}
[ -n "$BUCKET" ] || BUCKET="prospector-${ZONE%%.*}"
mkdir -p "$HOME_DIR"; chmod 700 "$HOME_DIR"

cf() { # <token> <method> <path> [json] -> body; the token never reaches argv of a child but curl's -H
  local tok=$1 m=$2 p=$3 d=${4:-}
  if [ -n "$d" ]; then curl -sS -X "$m" -H "Authorization: Bearer $tok" -H 'Content-Type: application/json' -d "$d" "$API$p"
  else curl -sS -X "$m" -H "Authorization: Bearer $tok" "$API$p"; fi
}
verify() { cf "$1" GET /user/tokens/verify | jq -e '.success and .result.status=="active"' >/dev/null 2>&1; }

# 0. driver, once, into the estate venv
if ! "$VENV/bin/python" -c 'import playwright' >/dev/null 2>&1; then
  say "" driver "installing playwright into $VENV (once)"
  python3 -m venv "$VENV" >/dev/null; "$VENV/bin/pip" install -q playwright >/dev/null; "$VENV/bin/playwright" install chromium >/dev/null
fi
PY="$VENV/bin/python"
say ok driver "playwright $("$PY" -c 'import playwright,importlib.metadata as m;print(m.version("playwright"))')"

# 1. the vault first (the same OCI SSO fallback as bin/idp-bootstrap-tailscale)
if ! OCI_CLI_PROFILE=$("$IDP/bin/idp-oci-whoami" 2>/dev/null); then
  MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
  SV="${ESTATE_SECRETS:-$(dirname "$MAIN")/estate-secrets}/secrets/${OCI_ENV:-dev}"
  export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
  region=$(sops -d --extract '["OCI_REGION"]' "$SV/OCI_REGION.yaml" 2>/dev/null); tenancy=$(sops -d --extract '["OCI_TENANCY_NAME"]' "$SV/OCI_TENANCY_NAME.yaml" 2>/dev/null)
  [ -n "$region" ] && [ -n "$tenancy" ] || bl oci "no live session and no OCI_REGION / OCI_TENANCY_NAME in $SV"
  say "" oci "no live session: the browser opens once for OCI SSO"
  oci session authenticate --region "$region" --tenancy-name "$tenancy" --profile-name estate-bootstrap >/dev/null || bl oci "session sign-in did not complete"
  OCI_CLI_PROFILE=$("$IDP/bin/idp-oci-whoami") || bl oci "signed in, but no session profile is live"
fi
export OCI_CLI_PROFILE OCI_CLI_AUTH=security_token
VAULT_PUT_PREFLIGHT=1 "$IDP/bin/idp-vault-put" cloudflare-api-token --preflight | sed 's/^/        /' || bl vault "not reachable as $OCI_CLI_PROFILE"

# 2. idempotent: both credentials already verify -> kept
if [ "$MODE" = mint ]; then
  dns=$("$IDP/bin/idp-cloud" secret get cloudflare-api-token 2>/dev/null || true)
  eng=$("$IDP/bin/idp-cloud" secret get prospector-engine-env 2>/dev/null || true)
  r2id=$(jq -r '.R2_ACCESS_KEY_ID // empty' <<<"${eng:-{\}}" 2>/dev/null || true)
  if [ -n "$dns" ] && verify "$dns" && [ -n "$r2id" ]; then
    say ok cloudflare "DNS token verifies and an R2 key id is present; kept (--rotate to mint anew)"; unset dns eng; exit 0
  fi
  unset dns eng
fi
if [ "$MODE" = --preflight ]; then
  code=$(curl -sS -o /dev/null -w '%{http_code}' "$CONSOLE") || code=curl-failed
  case "$code" in 200|301|302|303) say ok console "$CONSOLE answers $code";; *) fail console "$CONSOLE answers $code";; esac
  say ok preflight "vault, driver and dashboard reachable; nothing written"; exit 0
fi

# 3. the one dashboard drive: a root token with "User API Tokens: Edit", one hour, read once from the page
P=$(mktemp -d); trap 'rm -rf "$P"' EXIT; umask 077
NAME="estate-root $(date -u +%Y-%m-%dT%H:%MZ)"
say "" console "opening $CONSOLE in the estate browser profile; if Cloudflare asks you to sign in, do — that is the only hand"
"$PY" - "$CONSOLE" "$PROFILE" "$NAME" "$P/root" <<'PY'
import re, sys, time
from playwright.sync_api import sync_playwright
console, profile, name, out = sys.argv[1:5]
def step(s): print(f"        step    {s}", flush=True)
with sync_playwright() as p:
    ctx = p.chromium.launch_persistent_context(profile, headless=False, viewport={"width": 1280, "height": 900})
    page = ctx.pages[0] if ctx.pages else ctx.new_page()
    page.goto(console, wait_until="domcontentloaded"); step("dashboard opened")
    create = page.get_by_role("link", name=re.compile(r"create token", re.I)).or_(page.get_by_role("button", name=re.compile(r"create token", re.I)))
    deadline = time.time() + 300
    while time.time() < deadline:
        if create.count() and create.first.is_visible(): break
        time.sleep(2)
    else:
        sys.exit("FAIL    console   no API Tokens page after 5 minutes; login not completed")
    step("signed in"); create.first.click()
    page.get_by_role("link", name=re.compile(r"get started", re.I)).or_(page.get_by_role("button", name=re.compile(r"get started", re.I))).last.click()
    step("custom token form")
    page.get_by_label(re.compile(r"token name", re.I)).first.fill(name)
    # permission row: <scope> <group> <level>; the three selects of the first row
    selects = page.locator("form select, form [role=combobox]")
    def pick(i, text):
        s = selects.nth(i); s.click()
        opt = page.get_by_role("option", name=re.compile(text, re.I)).first
        if opt.count(): opt.click()
        else: s.select_option(label=re.compile(text, re.I))
    pick(0, r"^user$"); pick(1, r"api tokens"); pick(2, r"^edit$")
    step("permission User:API Tokens:Edit")
    page.get_by_role("button", name=re.compile(r"continue to summary", re.I)).first.click()
    page.get_by_role("button", name=re.compile(r"^create token$", re.I)).first.click()
    step("created")
    page.wait_for_timeout(1500)
    text = page.inner_text("body")
    m = re.search(r"\b([A-Za-z0-9_-]{40})\b", text)
    if not m:
        sys.exit("FAIL    console   token created but not found on the result page (selector drift); revoke the token named " + name + " and rerun after the driver is fixed")
    open(out, "w").write(m.group(1) + "\n")
    ctx.close()
PY
ROOT=$(cat "$P/root"); [ -n "$ROOT" ] || fail console "driver produced no token"
verify "$ROOT" || fail verify "the root token does not verify at $API/user/tokens/verify"
say ok root "root token verifies (User API Tokens: Edit)"

# 4. API-minted children. Permission group ids are looked up by name, never typed (LAW 46).
groups=$(cf "$ROOT" GET /user/tokens/permission_groups)
gid() { jq -r --arg n "$1" --arg s "$2" '.result[] | select(.name==$n and (.scopes|index($s))) | .id' <<<"$groups" | head -1; }
DNS_GID=$(gid "DNS Write" com.cloudflare.api.account.zone); [ -n "$DNS_GID" ] || fail perms "no permission group 'DNS Write' (zone)"
R2_GID=$(gid "Workers R2 Storage Write" com.cloudflare.api.account); [ -n "$R2_GID" ] || fail perms "no permission group 'Workers R2 Storage Write' (account)"
zone=$(cf "$ROOT" GET "/zones?name=$ZONE" | jq -r '.result[0] // empty'); [ -n "$zone" ] || fail zone "$ZONE is not a zone of this account"
ZONE_ID=$(jq -r .id <<<"$zone"); ACCOUNT_ID=$(jq -r .account.id <<<"$zone")
mint() { # <name> <policies-json> -> token JSON {id,value}
  cf "$ROOT" POST /user/tokens "$(jq -nc --arg n "$1" --argjson p "$2" '{name:$n, policies:$p}')" | jq -e 'select(.success) | .result | {id, value}'
}
dnspol=$(jq -nc --arg g "$DNS_GID" --arg z "$ZONE_ID" '[{effect:"allow", resources:{("com.cloudflare.api.account.zone."+$z):"*"}, permission_groups:[{id:$g}]}]')
r2pol=$(jq -nc --arg g "$R2_GID" --arg a "$ACCOUNT_ID" '[{effect:"allow", resources:{("com.cloudflare.api.account."+$a):"*"}, permission_groups:[{id:$g}]}]')
dnstok=$(mint "estate-dns $ZONE" "$dnspol") || fail mint "DNS token not created"
r2tok=$(mint "estate-r2 $BUCKET" "$r2pol") || fail mint "R2 token not created"
DNS=$(jq -r .value <<<"$dnstok"); R2_ID=$(jq -r .id <<<"$r2tok"); R2_VAL=$(jq -r .value <<<"$r2tok"); unset dnstok r2tok
R2_SECRET=$(printf '%s' "$R2_VAL" | python3 -c 'import sys,hashlib; print(hashlib.sha256(sys.stdin.read().encode()).hexdigest())'); unset R2_VAL
say ok mint "DNS token (zone $ZONE) and R2 token (account) minted by the API"

# 5. prove both before the vault (LAW 15): DNS token verifies and lists the zone; R2 token can see or create the bucket
verify "$DNS" || fail verify "DNS token does not verify"
cf "$DNS" GET "/zones/$ZONE_ID/dns_records?per_page=1" | jq -e .success >/dev/null || fail verify "DNS token cannot read $ZONE records"
bk=$(cf "$ROOT" GET "/accounts/$ACCOUNT_ID/r2/buckets/$BUCKET" | jq -r '.success')
[ "$bk" = true ] || cf "$ROOT" POST "/accounts/$ACCOUNT_ID/r2/buckets" "$(jq -nc --arg n "$BUCKET" '{name:$n}')" | jq -e .success >/dev/null || fail r2 "bucket $BUCKET neither exists nor could be created"
say ok verify "DNS token reads $ZONE; bucket $BUCKET present"

# 6. vault, in-process, key names only
printf '%s' "$DNS" > "$P/dns"; "$IDP/bin/idp-cloud" secret put cloudflare-api-token --file "$P/dns" >/dev/null || fail vault "cloudflare-api-token write refused"
printf 'V_ID=%s\nV_SECRET=%s\nV_ACCOUNT=%s\nV_BUCKET=%s\n' "$R2_ID" "$R2_SECRET" "$ACCOUNT_ID" "$BUCKET" > "$P/env"
ESTATE_ENV_FILE="$P/env" "$IDP/bin/idp-vault-put" --merge prospector-engine-env R2_ACCESS_KEY_ID=V_ID R2_SECRET_ACCESS_KEY=V_SECRET R2_ACCOUNT_ID=V_ACCOUNT R2_BUCKET=V_BUCKET >/dev/null || fail vault "prospector-engine-env R2_* write refused"
unset DNS R2_SECRET
# 7. the root token dies with this process
rid=$(cf "$ROOT" GET /user/tokens | jq -r --arg n "$NAME" '.result[] | select(.name==$n) | .id' | head -1)
[ -z "$rid" ] || cf "$ROOT" DELETE "/user/tokens/$rid" >/dev/null || true
unset ROOT
say ok cloudflare "cloudflare-api-token + prospector-engine-env.R2_* written; root token revoked; ExternalSecrets refresh within 1h"
