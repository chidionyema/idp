#!/usr/bin/env python3
"""Write every namespace's fence, in one pass, from platform/ns-fences/allowances.yaml.

crew#839. `bin/ns-fence-gate` names four things a namespace needs and has, until now, only ever
graded two fixture files: a LimitRange so no pod is refused for declaring no request, a
ResourceQuota so a runaway pod cannot take the node, a both-ways default deny so a compromised pod
cannot reach the namespace next door, and a DNS exception so denying egress does not read as the
application being slow.

This writes all four for every namespace the estate declares, from one input file, in one run. It
is idempotent: a second run over unchanged input rewrites byte-identical files. There is no
per-namespace hand-editing and no per-namespace exception that is not written down in the input.

The quota and the LimitRange land in platform/ns-fences/ and are applied. The NetworkPolicies land
in platform/ns-fences/network/ and are NOT applied, because this cluster runs flannel, which does
not implement NetworkPolicy; see that directory's README.
"""
from __future__ import annotations

import math
import os
import sys

import yaml

HERE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FENCES = os.path.join(HERE, "platform", "ns-fences")
NETWORK = os.path.join(FENCES, "network")
BANNER = ("# Generated by bin/idp-ns-fence-gen from platform/ns-fences/allowances.yaml (crew#839).\n"
          "# Do not edit: the next run overwrites this file. Change the input and re-run.\n")


def load(name: str):
    with open(os.path.join(FENCES, name)) as fh:
        return yaml.safe_load(fh) if name.endswith((".yaml", ".yml")) else __import__("json").load(fh)


def declared_namespaces() -> set[str]:
    """Every namespace this estate declares in a manifest, plus every one the input names."""
    found: set[str] = set()
    for root, dirs, files in os.walk(os.path.join(HERE, "platform")):
        dirs[:] = [d for d in dirs if d not in (".terraform", ".git", "ns-fences")]
        for f in files:
            if not f.endswith((".yaml", ".yml")):
                continue
            try:
                with open(os.path.join(root, f)) as fh:
                    docs = list(yaml.safe_load_all(fh))
            except Exception:
                continue
            for d in docs:
                if isinstance(d, dict) and d.get("kind") == "Namespace":
                    name = (d.get("metadata") or {}).get("name")
                    if name:
                        found.add(name)
    return found


def ceiling(measured: dict, sizing: dict) -> dict:
    """What a namespace may grow to before the quota refuses it, from what it asks for today."""
    head, floor = sizing["headroom"], sizing["floor"]
    cpu = max(math.ceil(measured.get("cpu_millicores", 0) * head["cpu"]), floor["cpu_millicores"])
    mem = max(math.ceil(measured.get("memory_mib", 0) * head["memory"]), floor["memory_mib"])
    pods = max(math.ceil(measured.get("pods", 0) * head["pods"]), floor["pods"])
    return {"cpu": f"{cpu}m", "memory": f"{mem}Mi", "pods": pods}


def quota_doc(ns: str, cap: dict, override: dict) -> dict:
    # requests and pods only. Counting limits.cpu would refuse every container that declares no
    # limit, and 42 of those run in this estate today. A deliberate ceiling in the input wins over
    # the derived one.
    hard = {"requests.cpu": cap["cpu"], "requests.memory": cap["memory"], "pods": str(cap["pods"])}
    hard.update(override.get("hard") or {})
    return {"apiVersion": "v1", "kind": "ResourceQuota",
            "metadata": {"name": "ns-ceiling", "namespace": ns}, "spec": {"hard": hard}}


def limitrange_doc(ns: str, req: dict, override: dict) -> dict:
    return {
        "apiVersion": "v1", "kind": "LimitRange",
        "metadata": {"name": "ns-defaults", "namespace": ns},
        # defaultRequest only, deliberately: a default LIMIT would OOM-kill a container that runs
        # today with none and uses more than the default.
        "spec": {"limits": [dict({"type": "Container",
                                  "defaultRequest": {"cpu": req["cpu"], "memory": req["memory"]}},
                                 **({"max": override["max"]} if override.get("max") else {}))]},
    }


def ns_selector(ns: str) -> dict:
    return {"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": ns}}}


def policy_docs(ns: str, flows: dict) -> list[dict]:
    """The floor, then the holes: DNS, the collector, and whatever the input declares."""
    docs = [{
        "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
        "metadata": {"name": "default-deny-all", "namespace": ns},
        # podSelector {} is what makes this the floor rather than somebody's allow-list; a label
        # selector here would be an allow rule wearing a deny's name.
        "spec": {"podSelector": {}, "policyTypes": ["Ingress", "Egress"]},
    }, {
        "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
        "metadata": {"name": "allow-dns-egress", "namespace": ns},
        "spec": {"podSelector": {}, "policyTypes": ["Egress"], "egress": [{
            "to": [{"namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "kube-system"}},
                    "podSelector": {"matchLabels": {"k8s-app": "kube-dns"}}}],
            "ports": [{"protocol": "UDP", "port": 53}, {"protocol": "TCP", "port": 53}]}]},
    }]
    egress = list(flows.get("egress") or [])
    if ns != "observability":
        egress.append("observability")  # LAW 50: every workload emits to the one collector.
    egress = sorted(set(egress))
    if egress:
        docs.append({
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": {"name": "allow-declared-egress", "namespace": ns},
            "spec": {"podSelector": {}, "policyTypes": ["Egress"],
                     "egress": [{"to": [ns_selector(t) for t in egress]}]},
        })
    ingress = sorted(set(flows.get("ingress_from") or []))
    if ingress:
        docs.append({
            "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
            "metadata": {"name": "allow-declared-ingress", "namespace": ns},
            "spec": {"podSelector": {}, "policyTypes": ["Ingress"],
                     "ingress": [{"from": [ns_selector(s) for s in ingress]}]},
        })
    return docs


def write(path: str, docs: list[dict]) -> None:
    body = yaml.safe_dump_all(docs, default_flow_style=False, sort_keys=False)
    with open(path, "w") as fh:
        fh.write(BANNER + body)


def main() -> int:
    allow = load("allowances.yaml")
    measured = load("measured.json")
    exempt, flows, sizing = allow["exempt"], allow["flows"], allow["sizing"]

    every = (declared_namespaces() | set(measured) | set(flows)) - set(exempt)
    # A ResourceQuota cannot be created into a namespace that does not exist yet, and Flux applies
    # this directory as one set, so a single such file fails the whole reconcile and every fence
    # on the cluster stops being updated. live-namespaces.txt is the record of what the cluster
    # actually holds, so a namespace missing from it is declared in git but not yet applied -- it
    # is fenced on the next run, once whatever owns it has created it. (Found live: ns-fences
    # reported `ResourceQuota/commerce/ns-ceiling not found: namespaces "commerce" not found`, and
    # commerce is a Kustomization that has never reconciled.) measured.json is deliberately not the
    # test: it records usage, and an empty namespace that exists has no row in it.
    live = {n.strip() for n in open(os.path.join(FENCES, "live-namespaces.txt")) if n.strip()}
    pending = sorted(n for n in every if n not in live)
    every -= set(pending)
    os.makedirs(NETWORK, exist_ok=True)

    for stale_dir in (FENCES, NETWORK):
        for f in os.listdir(stale_dir):
            if f.endswith(".yaml") and f not in ("allowances.yaml", "kustomization.yaml"):
                if f[:-5] not in every:
                    os.remove(os.path.join(stale_dir, f))

    for ns in sorted(every):
        cap = ceiling(measured.get(ns, {}), sizing)
        over = (allow.get("overrides") or {}).get(ns) or {}
        write(os.path.join(FENCES, f"{ns}.yaml"),
              [limitrange_doc(ns, allow["default_request"], over), quota_doc(ns, cap, over)])
        write(os.path.join(NETWORK, f"{ns}.yaml"), policy_docs(ns, flows.get(ns) or {}))

    if pending:
        print("note   idp-ns-fence-gen: not fenced, declared in git but not on the cluster: "
              + ", ".join(pending))

    for d, note in ((FENCES, "the quota and the request defaults, applied to the cluster"),
                    (NETWORK, "the policies, held until a CNI enforces them")):
        rows = sorted(f for f in os.listdir(d) if f.endswith(".yaml")
                      and f not in ("allowances.yaml", "kustomization.yaml"))
        with open(os.path.join(d, "kustomization.yaml"), "w") as fh:
            fh.write(BANNER + f"# {note}\n")
            yaml.safe_dump({"apiVersion": "kustomize.config.k8s.io/v1beta1",
                            "kind": "Kustomization", "resources": rows}, fh, sort_keys=False)

    print(f"ok     idp-ns-fence-gen: {len(every)} namespace(s) fenced, "
          f"{len(exempt)} exempt with a reason in allowances.yaml")
    return 0


if __name__ == "__main__":
    sys.exit(main())
