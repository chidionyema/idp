#!/usr/bin/env bash
# Start Langfuse and its fallback receiver. Safe to run repeatedly.
#
# First run generates observability/.env with openssl, chmod 600. That file
# holds every secret this stack uses and is gitignored. Nothing in here ever
# prints a secret value -- not to the terminal, not to a log (LAW 21). If you
# need the UI password, `bin/langfuse-password` puts it on the clipboard
# without displaying it.
#
# Langfuse creates its own org, project, user and API key pair on first boot
# from the LANGFUSE_INIT_* variables, so there is no sign-up wizard to click
# through and no key to copy out of a browser afterwards.
set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
# A bind-mount source the container VM cannot see mounts as an empty directory (2026-08-25).
"$IDP/bin/vm-shared-path" "$IDP" || exit 2
OBS="$IDP/observability"
ENVF="$OBS/.env"
COMPOSE=(docker compose --env-file "$ENVF" -f "$OBS/langfuse.yml")

log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

command -v docker >/dev/null || { echo "docker is not installed"; exit 2; }
docker info >/dev/null 2>&1 || { echo "docker daemon is not running -- start Docker Desktop"; exit 2; }

# Validate the ClickHouse config before starting anything that depends on it.
#
# A double hyphen inside its opening XML comment made ClickHouse refuse the whole
# file and crash-loop. langfuse-web and langfuse-worker wait on clickhouse being
# healthy, so neither was ever started, and `docker ps -a` showed them as Created
# rather than Exited -- which reads like "not reached yet", not like a fault.
# Three hours to find, one command to catch. It is here and not in a comment
# because writing that comment introduced a second double hyphen.
CH_XML="$OBS/clickhouse-low-memory.xml"
if command -v xmllint >/dev/null 2>&1; then
  if ! xmllint --noout "$CH_XML" 2>/tmp/lf-xml.$$; then
    echo "FAIL  $CH_XML is not valid XML, so ClickHouse would refuse it and crash-loop:"
    sed 's/^/        /' /tmp/lf-xml.$$
    rm -f /tmp/lf-xml.$$
    exit 2
  fi
  rm -f /tmp/lf-xml.$$
  log "clickhouse config is valid XML"
else
  # A guard that cannot read its evidence says so rather than returning a verdict.
  log "BLIND  xmllint is not installed, so $CH_XML was NOT validated"
fi

# --- secrets ------------------------------------------------------------------
# Generated once and reused. Regenerating ENCRYPTION_KEY after data exists makes
# every stored API key unreadable, so this block never overwrites an existing
# file -- it only fills in keys that are missing.
if [ ! -f "$ENVF" ]; then
  log "secrets   generating $ENVF (chmod 600, gitignored)"
  umask 077
  {
    echo "# Generated by bin/langfuse-up. Never commit. Never print."
    echo "# ENCRYPTION_KEY cannot be changed once traces exist -- rotating it"
    echo "# makes every stored API key undecryptable."
    echo "POSTGRES_PASSWORD=$(openssl rand -hex 24)"
    echo "CLICKHOUSE_PASSWORD=$(openssl rand -hex 24)"
    echo "MINIO_ROOT_PASSWORD=$(openssl rand -hex 24)"
    echo "REDIS_AUTH=$(openssl rand -hex 24)"
    echo "NEXTAUTH_SECRET=$(openssl rand -hex 32)"
    echo "SALT=$(openssl rand -hex 32)"
    echo "ENCRYPTION_KEY=$(openssl rand -hex 32)"
    echo "LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-$(uuidgen | tr 'A-Z' 'a-z')"
    echo "LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-$(uuidgen | tr 'A-Z' 'a-z')"
    echo "LANGFUSE_INIT_USER_EMAIL=chidionyema@gmail.com"
    echo "LANGFUSE_INIT_USER_PASSWORD=$(openssl rand -base64 18 | tr -d '/+=' )aA1"
  } > "$ENVF"
  chmod 600 "$ENVF"
else
  log "secrets   $ENVF exists, left alone"
fi

# --- headroom check -----------------------------------------------------------
# The ceilings in langfuse.yml total 3.63 GiB. Starting into less than that
# produces OOM kills that read as crashes, so say so before it happens rather
# than after (LAW 2: measure, do not hope).
limit=$(docker info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
used=$(docker stats --no-stream --format '{{.MemUsage}}' 2>/dev/null \
       | awk -F'/' '{print $1}' \
       | awk '/MiB/{s+=$1} /GiB/{s+=$1*1024} END{printf "%.0f", s}')
limit_mib=$(( limit / 1048576 ))
free_mib=$(( limit_mib - ${used:-0} ))
log "headroom  docker has ${limit_mib}MiB total, ${used:-0}MiB in use, ${free_mib}MiB free (stack ceilings total 3717MiB)"
if [ "$free_mib" -lt 3717 ]; then
  log "headroom  WARNING: less free than the ceilings total. Containers may be OOM-killed."
  log "headroom  Raise Docker Desktop's memory, or stop something: docker ps"
fi

# --- start --------------------------------------------------------------------
log "start     pulling and starting 7 containers (first run downloads ~2GB)"
"${COMPOSE[@]}" up -d --wait --wait-timeout 600 2>&1 | sed 's/^/          /' || {
  log "start     FAILED -- last 30 lines of langfuse-web:"
  docker logs --tail 30 langfuse-web 2>&1 | sed 's/^/          /' || true
  exit 1
}

log "start     all containers report healthy"
echo
exec "$IDP/bin/langfuse-status"
