#!/usr/bin/env python3
"""Grade the estate against the founder's ethos, one row per tenet (crew#586 CP1).

Reads conscience/tenets.yaml, runs each row's measure command from the checkout root, and
writes reports/conscience.json: the score (rows green / rows), the value each row measured,
and the mode its PR rule runs in. The score is read from this receipt, never from a file
scan (LAW 50). A row with no measure command, or a command that exits 2, is BLIND and the
run exits 2: a tenet nobody can measure is a wish (LAW 44).

  bin/idp-conscience                       grade; print `score N/M`; exit 0 all green, 1 any red, 2 BLIND
  bin/idp-conscience --selftest            prove both ways on tests/fixtures/conscience
  bin/idp-conscience --ledger-fresh-hours H  the `research` row: exit 0 when the crew research
                                             ledger has an entry inside H hours, 1 otherwise,
                                             2 when the ledger cannot be read

CONSCIENCE_TENETS points at another tenets file (fixtures); CONSCIENCE_REPORT at another
receipt path; ESTATE_CODE at the directory holding every checkout (LAW 46).
"""
from __future__ import annotations

import datetime as dt
import json
import os
import pathlib
import subprocess
import sys


def blind(msg: str) -> None:
    print(msg, file=sys.stderr)
    sys.exit(2)

import yaml

IDP = pathlib.Path(__file__).resolve().parents[1]
TENETS = pathlib.Path(os.environ.get("CONSCIENCE_TENETS") or IDP / "conscience" / "tenets.yaml")
REPORT = pathlib.Path(os.environ.get("CONSCIENCE_REPORT") or IDP / "reports" / "conscience.json")
CODE = pathlib.Path(os.environ.get("ESTATE_CODE") or IDP.parent)
REQUIRED = ("name", "ethos", "measure", "reads", "green", "pr_rule", "mode")


def load(path: pathlib.Path) -> list[dict]:
    try:
        rows = yaml.safe_load(path.read_text())["tenets"]
    except (OSError, KeyError, TypeError, yaml.YAMLError) as e:
        blind(f"BLIND cannot read tenets at {path}: {e}")
    for r in rows:
        missing = [k for k in REQUIRED if not r.get(k)]
        if missing:
            blind(f"BLIND tenet {r.get('name', '?')!r} has no {', '.join(missing)}: a tenet without a measure is a wish (LAW 44)")
        if r["reads"] not in ("exit", "stdout") or r["mode"] not in ("warn", "deny"):
            blind(f"BLIND tenet {r['name']!r}: reads must be exit|stdout, mode warn|deny")
    return rows


def green(value: int, rule: str) -> bool:
    op, n = rule.split()
    n = int(n)
    return {"==": value == n, ">=": value >= n, "<=": value <= n, "<": value < n, ">": value > n}[op]


def measure(row: dict, cwd: pathlib.Path) -> tuple[int | None, str]:
    try:
        p = subprocess.run(row["measure"], shell=True, cwd=cwd, capture_output=True, text=True, timeout=600)
    except subprocess.TimeoutExpired:
        return None, "timeout"
    if row["reads"] == "exit":
        return (None, "exit 2 (BLIND)") if p.returncode == 2 else (p.returncode, f"exit {p.returncode}")
    ints = [t for t in (p.stdout.strip().splitlines() or [""])[-1].split() if t.lstrip("-").isdigit()]
    return (int(ints[-1]), f"stdout {ints[-1]}") if ints else (None, "no integer on the last stdout line")


def grade(tenets: pathlib.Path, report: pathlib.Path, cwd: pathlib.Path) -> int:
    rows = load(tenets)
    out, blind = [], False
    for r in rows:
        value, how = measure(r, cwd)
        ok = green(value, r["green"]) if value is not None else None
        blind |= value is None
        out.append({**r, "value": value, "how": how, "green": r["green"], "ok": ok})
        print(f"{'ok   ' if ok else 'BLIND' if ok is None else 'red  '} {r['name']:<15} {how:<32} green when {r['green']}  [{r['mode']}]")
    n_green = sum(1 for o in out if o["ok"])
    receipt = {
        "measured_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"),
        "host": os.uname().nodename,
        "score": {"green": n_green, "total": len(out)},
        "blind": blind,
        "tenets": out,
    }
    report.parent.mkdir(parents=True, exist_ok=True)
    report.write_text(json.dumps(receipt, indent=2) + "\n")
    print(f"score {n_green}/{len(out)} tenets green -> {report}" + (" (BLIND: a row could not be measured)" if blind else ""))
    return 2 if blind else (0 if n_green == len(out) else 1)


def ledger_fresh(hours: int) -> int:
    ledger = CODE / "crew" / "science" / "RESEARCH-LEDGER.jsonl"
    try:
        lines = [json.loads(line) for line in ledger.read_text().splitlines() if line.strip()]
    except (OSError, json.JSONDecodeError) as e:
        print(f"BLIND research ledger unreadable at {ledger}: {e}")
        return 2
    # crew#583: this row used to build `cutoff = now - hours` here and call every entry newer than
    # it fresh. On a Mac whose battery has gone flat the RTC resets to 1970, `cutoff` lands decades
    # before every stamp in the file, and a research ledger that had been dead for years printed a
    # green tenet row. The age now comes from bin/lib/receipt_age.py, the one place in the estate
    # allowed near this arithmetic, and it refuses -- BLIND, exit 2 -- when the clock reads earlier
    # than the newest entry it is grading. A local file carries no served clock the way an object
    # head does, so this is the weaker of the two properties the helper offers, and local_ledger_age
    # documents exactly which one: not "the local clock is absent", but "no clock error can make
    # this row green".
    sys.path.insert(0, str(IDP / "bin" / "lib"))
    from receipt_age import local_ledger_age

    age_h = local_ledger_age(lines, ("ts", "timestamp", "date", "when", "at"), 3600.0, "research",
                             dt.datetime.now(dt.timezone.utc))
    fresh = age_h <= hours
    if age_h == float("inf"):
        print(f"research ledger: no entry carries a stamp, of {len(lines)}")
        return 1
    print(f"research ledger: newest entry {age_h:.1f}h old, inside {hours}h of {len(lines)} entries"
          if fresh else
          f"research ledger: newest entry {age_h:.1f}h old, older than {hours}h of {len(lines)} entries")
    return 0 if fresh else 1


# --- engineering measurers (crew#584, founder 2026-08-28: "why did i need to tel the crew to optinise
# the tests ... the engineerig phisolophi is weak. we should not be renided for the engineering
# tenents"). Each is one number GitHub already holds, printed on the last stdout line so a tenets
# row can read it. `gh` is the estate's GitHub client (LAW 43); the board and the repo are derived
# from the checkout's own remote, never typed (LAW 46). BLIND (exit 2) when gh cannot answer.

def _gh(*args: str) -> str | None:
    try:
        p = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


def _runs(limit: int = 30, status: str | None = None) -> list[dict] | None:
    args = ["run", "list", "--workflow", "ci.yml", "--branch", "main", "--limit", str(limit),
            "--json", "createdAt,updatedAt,conclusion,attempt,databaseId"]
    if status:
        args += ["--status", status]
    out = _gh(*args)
    return None if out is None else json.loads(out)


def _minutes(run: dict) -> float:
    a = dt.datetime.fromisoformat(run["createdAt"].replace("Z", "+00:00"))
    b = dt.datetime.fromisoformat(run["updatedAt"].replace("Z", "+00:00"))
    return (b - a).total_seconds() / 60


def ci_minutes() -> int:
    """Wall-clock minutes of the latest green ci.yml run on main (the loop every merge waits on)."""
    runs = _runs(1, "success")
    if not runs:
        print("BLIND gh cannot list main's ci.yml runs"); return 2
    m = _minutes(runs[0])
    print(f"ci.yml run {runs[0]['databaseId']} on main took {m:.1f} min"); print(int(m + 0.999)); return 0


def ci_minutes_day() -> int:
    """Runner minutes ci.yml spent on main in the last 24 h -- the CI bill, and what a faster gate cuts."""
    runs = _runs(300)
    if runs is None:
        print("BLIND gh cannot list main's ci.yml runs"); return 2
    now = dt.datetime.now(dt.timezone.utc)
    day = [r for r in runs if (now - dt.datetime.fromisoformat(r["createdAt"].replace("Z", "+00:00"))).total_seconds() < 86400]
    total = sum(_minutes(r) for r in day)
    print(f"{len(day)} ci.yml run(s) on main in 24h, {total:.0f} runner-minutes"); print(int(total)); return 0


def flakes(days: int) -> int:
    """Runs on main that failed and then passed on a rerun: a rerun that changes the verdict is a flaky test."""
    runs = _runs(300)
    if runs is None:
        print("BLIND gh cannot list main's ci.yml runs"); return 2
    now = dt.datetime.now(dt.timezone.utc)
    n = sum(1 for r in runs if r.get("attempt", 1) > 1 and r["conclusion"] == "success"
            and (now - dt.datetime.fromisoformat(r["createdAt"].replace("Z", "+00:00"))).days < days)
    print(f"{n} rerun(s) turned a red main run green in {days} day(s)"); print(n); return 0


def prs_older(hours: int) -> int:
    """Open pull requests older than `hours`: a PR nobody merges is inventory rotting (founder: "too many open prs")."""
    out = _gh("pr", "list", "--state", "open", "--limit", "100", "--json", "number,createdAt")
    if out is None:
        print("BLIND gh cannot list open pull requests"); return 2
    now = dt.datetime.now(dt.timezone.utc)
    old = [pr["number"] for pr in json.loads(out)
           if (now - dt.datetime.fromisoformat(pr["createdAt"].replace("Z", "+00:00"))).total_seconds() > hours * 3600]
    print(f"{len(old)} open PR(s) older than {hours}h: {' '.join('#%d' % n for n in old) or 'none'}"); print(len(old)); return 0


def board() -> str | None:
    """The crew board this checkout reports to: <owner of this repo>/crew, or CONSCIENCE_BOARD."""
    if os.environ.get("CONSCIENCE_BOARD"):
        return os.environ["CONSCIENCE_BOARD"]
    owner = _gh("repo", "view", "--json", "owner", "--jq", ".owner.login")
    return f"{owner.strip()}/crew" if owner else None


def act(report: pathlib.Path) -> int:
    """A red row is work, not a report (founder 2026-08-28: "we neasure everything but we dont act
    ont i"). Every red row gets one open issue on the board, keyed by the row's name -- created the
    first hour it is red, commented on every later hour with the fresh value -- so the goal-guard
    injects it into every session and a lane claims it. Green rows open nothing. Returns the number
    of red rows so the caller's exit code still says red."""
    rows = json.loads(report.read_text())["tenets"]
    red = [r for r in rows if r["ok"] is False]
    repo = board()
    if red and repo is None:
        print("BLIND cannot name the board (gh repo view failed); red rows not filed"); return 2
    for r in red:
        title = f"conscience: {r['name']} is red"
        found = _gh("issue", "list", "--repo", repo, "--state", "open", "--search", f'"{title}" in:title',
                    "--json", "number,title", "--jq", f'[.[] | select(.title == "{title}")][0].number')
        line = (f"`{r['name']}` measured **{r['how']}**, green when `{r['green']}`.\n\n"
                f"Ethos: {r['ethos']}\n\nMeasure: `{r['measure']}`\n\n"
                f"Filed by bin/idp-conscience --act; the row goes green when the measure does, and this issue is the work.")
        if found and found.strip():
            _gh("issue", "comment", found.strip(), "--repo", repo, "--body", line)
            print(f"filed {r['name']:<15} -> {repo}#{found.strip()} (updated)")
        else:
            url = _gh("issue", "create", "--repo", repo, "--title", title, "--label", "conscience", "--body",
                      f"Tracked: crew#584\n\n{line}") or ""
            print(f"filed {r['name']:<15} -> {url.strip() or 'create failed'}")
    return len(red)


def selftest() -> int:
    fx = IDP / "tests" / "fixtures" / "conscience"
    import tempfile
    with tempfile.TemporaryDirectory() as d:
        rep = pathlib.Path(d) / "r.json"
        good = subprocess.run([sys.executable, __file__], env={**os.environ, "CONSCIENCE_TENETS": str(fx / "good.yaml"), "CONSCIENCE_REPORT": str(rep)}, capture_output=True, text=True).returncode
        bad = subprocess.run([sys.executable, __file__], env={**os.environ, "CONSCIENCE_TENETS": str(fx / "bad.yaml"), "CONSCIENCE_REPORT": str(rep)}, capture_output=True, text=True).returncode
        wish = subprocess.run([sys.executable, __file__], env={**os.environ, "CONSCIENCE_TENETS": str(fx / "wish.yaml"), "CONSCIENCE_REPORT": str(rep)}, capture_output=True, text=True)
    ok = good == 0 and bad == 1 and wish.returncode == 2 and "LAW 44" in wish.stderr
    print(f"{'ok   ' if ok else 'FAIL '} selftest good={good} (want 0) bad={bad} (want 1) wish={wish.returncode} (want 2, names LAW 44)")
    return 0 if ok else 1


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        sys.exit(selftest())
    if "--ledger-fresh-hours" in sys.argv:
        sys.exit(ledger_fresh(int(sys.argv[sys.argv.index("--ledger-fresh-hours") + 1])))
    if "--ci-minutes" in sys.argv:
        sys.exit(ci_minutes())
    if "--ci-minutes-day" in sys.argv:
        sys.exit(ci_minutes_day())
    if "--flakes-days" in sys.argv:
        sys.exit(flakes(int(sys.argv[sys.argv.index("--flakes-days") + 1])))
    if "--pr-older-hours" in sys.argv:
        sys.exit(prs_older(int(sys.argv[sys.argv.index("--pr-older-hours") + 1])))
    rc = grade(TENETS, REPORT, IDP)
    if "--act" in sys.argv and rc != 2:
        act(REPORT)
    sys.exit(rc)
