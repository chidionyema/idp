#!/usr/bin/env python3
"""idp-signoz-key: mint the prover's SigNoz service-account key and put it in the vault, from CI.

    bin/idp-signoz-key                   keep the key the vault holds while SigNoz still accepts it; mint otherwise
    SIGNOZ_ROTATE=1 bin/idp-signoz-key   mint anew

Root trust (docs/reference/policy/root-trust.md, R52: one root per provider, code mints the rest).
The one root is the SigNoz root login the estate's Terraform wrote to the vault (signoz-root-email,
signoz-root-password; platform/oci/signoz.tf). Under that login this creates one service account
`estate-prover` carrying the vendor's read-only role `signoz-viewer`, one API key on it, and writes
the key as field `key` of vault entry `signoz-prover` through bin/idp-vault-put. No value is printed.

The calls go over a port-forward to the chart's `signoz` service (observability, port 8080), never
through the edge: the edge exposes /api/v2/dashboards alone (platform/observability/httproute.yaml,
route signoz-api) and the session and service-account endpoints stay behind the one login.

Vendor facts, SigNoz repository at v0.138.0 (tests/fixtures/auth.py, serviceaccount.py, role.py;
tests/integration/tests/serviceaccount/02_keys.py, 03_auth.py; read 2026-08-31):
  GET  /api/v2/sessions/context?email=&ref=           -> data.orgs[0].id
  POST /api/v2/sessions/email_password {email,password,orgId} -> data.accessToken
  GET  /api/v1/roles                                   -> data[].{id,name}
  GET|POST /api/v1/service_accounts {name}             -> data[] | data.id
  POST /api/v1/service_account_roles {serviceAccountId, roleId}
  POST /api/v1/service_accounts/{id}/keys {name, expiresAt: 0} -> data.key
  GET  /api/v2/dashboards with SIGNOZ-API-KEY          -> 200 when the key is accepted

Exit 0 ok, 1 FAIL (SigNoz or the vault refused), 2 BLIND (no vault, no cluster, tool missing).
Overrides for tests: SIGNOZ_URL (skips the port-forward), IDP_CLOUD, IDP_VAULT_PUT, IDP_KUBE.
"""

import json
import os
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CLOUD = os.environ.get("IDP_CLOUD") or os.path.join(IDP, "bin", "idp-cloud")
VAULT_PUT = os.environ.get("IDP_VAULT_PUT") or os.path.join(IDP, "bin", "idp-vault-put")
KUBE = os.environ.get("IDP_KUBE") or os.path.join(IDP, "bin", "idp-kube")
ENTRY, FIELD = "signoz-prover", "key"
ACCOUNT, ROLE = "estate-prover", "signoz-viewer"
KEY_HEADER = "SIGNOZ-API-KEY"


def say(level, what):
    print(f"{level:7} signoz-key   {what}")


def vault_get(name):
    p = subprocess.run(
        [CLOUD, "secret", "get", name], capture_output=True, text=True, timeout=120
    )
    return p.stdout.strip() if p.returncode == 0 and p.stdout.strip() else None


def call(base, path, *, method="GET", body=None, bearer=None, key=None):
    req = urllib.request.Request(
        base + path, method=method, headers={"Accept": "application/json"}
    )
    if body is not None:
        req.add_header("Content-Type", "application/json")
    if bearer:
        req.add_header("Authorization", f"Bearer {bearer}")
    if key:
        req.add_header(KEY_HEADER, key)
    data = json.dumps(body).encode() if body is not None else None
    try:
        with urllib.request.urlopen(req, data=data, timeout=30) as r:  # noqa: S310 - localhost port-forward or a test server
            text = r.read().decode("utf-8", "replace")
            status = r.status
    except urllib.error.HTTPError as e:
        status, text = e.code, e.read().decode("utf-8", "replace")
    except Exception as e:  # noqa: BLE001
        return 0, {"error": f"{type(e).__name__}: {e}"}
    try:
        doc = json.loads(text)
    except ValueError:
        doc = {"raw": text[:200]}
    return status, doc


def port_forward():
    """(process, base url) of a port-forward to svc/signoz:8080, or (None, None) when the cluster
    is not readable from here (the laptop runs render only; oke-check.yml -f mode=apply mints)."""
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        port = s.getsockname()[1]
    p = subprocess.Popen(
        [KUBE, "port-forward", "-n", "observability", "svc/signoz", f"{port}:8080"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )
    for _ in range(60):
        if p.poll() is not None:
            return None, (p.stderr.read() or "").strip()[-200:]
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=0.5):
                return p, f"http://127.0.0.1:{port}"
        except OSError:
            time.sleep(0.5)
    p.kill()
    return None, "port-forward never opened its port"


def accepted(base, key):
    status, _ = call(base, "/api/v2/dashboards", key=key)
    return status == 200


def login(base, email, password):
    status, doc = call(
        base,
        "/api/v2/sessions/context?"
        + urllib.parse.urlencode({"email": email, "ref": base}),
    )
    orgs = (
        (doc.get("data") or {}).get("orgs")
        if status == 200 and isinstance(doc, dict)
        else None
    )
    if not orgs:
        return None, f"sessions/context answered {status} {str(doc)[:120]}"
    status, doc = call(
        base,
        "/api/v2/sessions/email_password",
        method="POST",
        body={"email": email, "password": password, "orgId": orgs[0]["id"]},
    )
    token = (
        (doc.get("data") or {}).get("accessToken")
        if status == 200 and isinstance(doc, dict)
        else None
    )
    return (
        token,
        None
        if token
        else f"sessions/email_password answered {status}: the root login the vault holds is refused",
    )


def rows(doc):
    data = doc.get("data") if isinstance(doc, dict) else None
    return data if isinstance(data, list) else []


def mint(base, token, run_id):
    status, doc = call(base, "/api/v1/roles", bearer=token)
    role = next((r["id"] for r in rows(doc) if r.get("name") == ROLE), None)
    if not role:
        return None, f"no role named {ROLE} (roles answered {status})"
    status, doc = call(base, "/api/v1/service_accounts", bearer=token)
    account = next((r["id"] for r in rows(doc) if r.get("name") == ACCOUNT), None)
    if not account:
        status, doc = call(
            base,
            "/api/v1/service_accounts",
            method="POST",
            body={"name": ACCOUNT},
            bearer=token,
        )
        account = (
            (doc.get("data") or {}).get("id")
            if status == 201 and isinstance(doc, dict)
            else None
        )
        if not account:
            return (
                None,
                f"service account {ACCOUNT} not created ({status} {str(doc)[:120]})",
            )
        status, doc = call(
            base,
            "/api/v1/service_account_roles",
            method="POST",
            body={"serviceAccountId": account, "roleId": role},
            bearer=token,
        )
        if status != 201:
            return (
                None,
                f"role {ROLE} not assigned to {ACCOUNT} ({status} {str(doc)[:120]})",
            )
        say("ok", f"service account {ACCOUNT} created with role {ROLE}")
    status, doc = call(
        base,
        f"/api/v1/service_accounts/{account}/keys",
        method="POST",
        body={"name": f"{ACCOUNT}-{run_id}", "expiresAt": 0},
        bearer=token,
    )
    key = (
        (doc.get("data") or {}).get("key")
        if status == 201 and isinstance(doc, dict)
        else None
    )
    return (
        key,
        None if key else f"key not minted on {ACCOUNT} ({status} {str(doc)[:120]})",
    )


def write(key):
    fd, path = tempfile.mkstemp(prefix="signoz-key-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(f"SIGNOZ_PROVER_KEY={key}\n")
        p = subprocess.run(
            [VAULT_PUT, "--merge", ENTRY, f"{FIELD}=SIGNOZ_PROVER_KEY"],
            env=dict(os.environ, ESTATE_ENV_FILE=path),
            capture_output=True,
            text=True,
            timeout=180,
        )
        return p.returncode == 0
    finally:
        os.unlink(path)


def main():
    email, password = vault_get("signoz-root-email"), vault_get("signoz-root-password")
    if not (email and password):
        say(
            "BLIND",
            "signoz-root-email / signoz-root-password unreadable from the vault (platform/oci/signoz.tf writes them; no OCI session here?)",
        )
        return 2
    proc, base = (None, os.environ.get("SIGNOZ_URL"))
    if not base:
        proc, base = port_forward()
        if not proc:
            say("BLIND", f"no port-forward to observability/svc/signoz: {base}")
            return 2
    try:
        held = vault_get(ENTRY)
        have = None
        if held:
            try:
                have = json.loads(held).get(FIELD)
            except ValueError:
                have = None
        if have and not os.environ.get("SIGNOZ_ROTATE") and accepted(base, have):
            say(
                "ok",
                f"{ENTRY}.{FIELD} present and SigNoz accepts it on /api/v2/dashboards; kept",
            )
            return 0
        token, why = login(base, email, password)
        if not token:
            say("FAIL", why)
            return 1
        key, why = mint(base, token, os.environ.get("GITHUB_RUN_ID", "local"))
        if not key:
            say("FAIL", why)
            return 1
        if not accepted(base, key):
            say("FAIL", "the key just minted is refused on /api/v2/dashboards")
            return 1
        if not write(key):
            say("FAIL", f"vault write of {ENTRY}.{FIELD} refused")
            return 1
        say(
            "ok",
            f"{ENTRY}.{FIELD} minted ({ACCOUNT}, role {ROLE}) and written; SigNoz accepts it",
        )
        return 0
    finally:
        if proc:
            proc.kill()


if __name__ == "__main__":
    sys.exit(main())
