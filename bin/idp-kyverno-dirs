#!/usr/bin/env bash
# Which platform directories hold something the cluster would judge at admission: every dir with
# a kustomization.yaml that ships a HelmRelease or a plain workload. One owner for that list,
# because it had two and they disagreed.
#
# crew#623, 2026-08-29: bin/idp-ci found plain workloads with `platform/*/*.yaml` -- one level --
# while it found HelmReleases with `platform/*/*.yaml platform/*/*/*.yaml`. Three directories
# were therefore never judged by anything: platform/commerce/data (a StatefulSet holding the
# money ledger), platform/backstage/base (the portal) and platform/oci/autoscaler. The judge
# said "render clean" about a set that did not include them, which is the crew#539 shape again:
# a verdict that reads green because the thing was never looked at.
#
# Usage: bin/idp-kyverno-dirs [base-ref] [--narrow]
#   no argument   every dir
#   base-ref      only the dirs whose files the diff base-ref...HEAD touches, and every dir when
#                 the judge, a policy, a kyverno fixture or the cluster wiring moved, because then
#                 an unchanged dir's verdict can change too. Prints nothing when nothing is in scope.
#   --narrow      the changed dirs and nothing else, never widening. For the pre-push hook, where
#                 the point is to catch the chart in front of you in seconds rather than to re-judge
#                 the estate: a policy change fans out to every dir, and CI is where that is paid.
set -euo pipefail
# The shell standard's trap (crew#620). This script only prints; there is nothing to unwind, so
# the trap says which line stopped it rather than pretending to clean up after it.
on_exit() {
	local e=$?
	[ "$e" -eq 0 ] || echo "idp-kyverno-dirs: exit $e" >&2
}
trap on_exit EXIT
IDP="$(cd "$(dirname "$0")/.." && pwd)"
cd "$IDP"

all=$({
	grep -lE '^kind: HelmRelease' platform/*/*.yaml platform/*/*/*.yaml 2>/dev/null || true
	grep -lE '^kind: (Deployment|StatefulSet|DaemonSet|Job|CronJob)$' platform/*/*.yaml platform/*/*/*.yaml 2>/dev/null || true
} | xargs -n1 dirname 2>/dev/null | sort -u | while read -r d; do
	[ -f "$d/kustomization.yaml" ] && echo "$d"
done)

base="${1:-}"
narrow="${2:-}"
if [ -z "$base" ]; then
	printf '%s\n' "$all"
	exit 0
fi

changed=$(git diff --name-only "$base...HEAD" 2>/dev/null) || {
	printf '%s\n' "$all"
	exit 0
}
# The verdict is the VALUE of the pipeline, never its exit status: this script sets `pipefail`,
# and `if cmd | grep -q ...` reports the left-hand command's failure as the answer to the
# question (bin/idp-ci rung 1c, the 2026-08-25 port-gate incident).
widening=$(printf '%s\n' "$changed" | grep -cE '^(bin/idp-kyverno-render|bin/idp-kyverno-dirs|bin/idp-ci|tests/fixtures/kyverno/|platform/kyverno/|platform/policies/|clusters/)' || true)
if [ "$narrow" != "--narrow" ] && [ "${widening:-0}" -gt 0 ]; then
	printf '%s\n' "$all"
	exit 0
fi
for d in $all; do printf '%s\n' "$changed" | grep -q "^$d/" && echo "$d"; done
exit 0
