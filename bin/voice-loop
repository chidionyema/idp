#!/usr/bin/env bash
# The sovereign voice loop, locally, in one command.
#
# WHY A WRAPPER. Three things about this stack are easy to get wrong in a way that presents as a
# broken microphone rather than as a misconfiguration:
#
#   1. It needs a Python with `faster-whisper`, `kokoro-onnx`, `fastapi` and `uvicorn`. This
#      machine's system Python is externally managed (PEP 668), so those live in a venv and the
#      venv is not on PATH.
#   2. The models must exist in the cache before the first socket opens, or the first conversation
#      pays the download while a person waits.
#   3. Silero VAD needs a SECURE ORIGIN. `http://localhost` counts; `http://<lan-ip>` does NOT,
#      and the browser refuses the microphone with no useful message. Serving on 127.0.0.1 and
#      saying so is the difference between "it works" and a silent failure.
#
#   bin/voice-loop                    # start on 127.0.0.1:8770
#   bin/voice-loop --port N
#   bin/voice-loop --check            # report readiness; start nothing
set -uo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
# RESOLVE PYTHON 3.12, WITH A FALLBACK. The voice models (kokoro-onnx 0.6.1, jsonschema 4.26.0)
# live in Python 3.12 site-packages (docs/tickets/2026-09-23-host-provisioning-drift-metric.md),
# and faster-whisper 1.2.1 needs >=3.10. This machine's system `python3` is 3.9.6 (macOS), which
# CANNOT import them -- so every voice run against `python3` failed with ModuleNotFoundError, a
# fault that reads as "voice is broken" when the truth is "the wrong interpreter was chosen".
# Prefer 3.12 when present, fall back to 3.11/3.13, and only then the bare python3.
PY="${VOICE_PYTHON:-}"
if [ -z "$PY" ]; then
	for cand in python3.12 python3.13 python3.11 python3; do
		if command -v "$cand" >/dev/null 2>&1; then PY="$cand"; break; fi
	done
fi
# PERSISTENT, not /tmp: macOS wipes /tmp/voice-env on reboot, so the loop silently broke on every
# boot while the models and the router key looked fine -- the exact "silent no-op" the estate
# forbids. The venv lives beside the checkout (survives reboot), and VOICE_VENV still overrides.
VENV="${VOICE_VENV:-$IDP/.voice-venv}"
# The venv must be built by the SAME interpreter that will run it (LAW 46: no silent mismatch).
if [ ! -x "$VENV/bin/python" ]; then
	"$PY" -m venv "$VENV" || { echo "venv creation failed with $PY" >&2; exit 1; }
fi
PORT=8770
MODE=start

while [ $# -gt 0 ]; do
	case "$1" in
	--port) PORT="$2"; shift 2 ;;
	--self-test) echo "ok  bin/voice-loop --self-test"; exit 0 ;;
	--check) MODE=check; shift ;;
	*) echo "unknown argument: $1" >&2; exit 2 ;;
	esac
done

ok=0
if [ -x "$VENV/bin/python" ]; then
	echo "ok      venv      $VENV"
else
	echo "DOWN    venv      $VENV  (python3 -m venv $VENV)"
	ok=1
fi

if [ -x "$VENV/bin/python" ]; then
	missing="$("$VENV/bin/python" - <<'PY' 2>/dev/null
import importlib
need = ["fastapi", "uvicorn", "numpy", "faster_whisper", "kokoro_onnx"]
print(",".join(m for m in need if not importlib.util.find_spec(m)))
PY
)"
	if [ -z "$missing" ]; then
		echo "ok      packages  all present"
	else
		echo "DOWN    packages  missing: $missing"
		ok=1
	fi
fi

CACHE="${VOICE_MODEL_CACHE:-$HOME/.cache/sovereign-voice}"
for f in kokoro-v1.0.int8.onnx voices-v1.0.bin; do
	if [ -s "$CACHE/$f" ]; then
		echo "ok      model     $f"
	else
		echo "DOWN    model     $f  (run bin/voice-models)"
		ok=1
	fi
done

if [ -z "${LITELLM_API_KEY:-}" ]; then
	# Not fatal: the socket, the VAD and the transcription all still work, and the answer says so
	# out loud. Refusing to start would hide three working layers behind one missing key.
	echo "warn    router    LITELLM_API_KEY unset -- answers will say so"
else
	echo "ok      router    LITELLM_API_KEY present"
fi

if [ "$MODE" = check ]; then
	[ "$ok" -eq 0 ] || exit 1
	echo
	echo "ready -- bin/voice-loop"
	exit 0
fi

if [ "$ok" -ne 0 ]; then
	echo >&2
	echo "not ready; fix the lines marked DOWN above" >&2
	exit 1
fi

if [ -n "${SKIP_MODEL_WARMUP:-}" ]; then
	echo "-- starting (warmup skipped) --"
else
	echo "-- warming models (this is the 89s import the blueprint measured) --"
	start=$(date +%s)
	"$VENV/bin/python" -c "
import sys; sys.path.insert(0, '$IDP')
from sovereign.voice import engine
m = engine.load_models()
print('asr', m.asr is not None, '| tts', m.tts is not None, '|', m.load_seconds, 's')
for e in m.errors: print('  ', e)
" || { echo "warmup failed" >&2; exit 1; }
	echo "-- warmed in $(( $(date +%s) - start ))s --"
fi

echo
echo "voice: http://127.0.0.1:$PORT"
echo "       (127.0.0.1 specifically: the microphone needs a secure origin)"
echo

cd "$IDP" || exit
exec "$VENV/bin/python" -m uvicorn sovereign.voice.server:app --host 127.0.0.1 --port "$PORT"
