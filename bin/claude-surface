#!/usr/bin/env python3
"""Switch Claude Code and Claude Desktop between native Claude and Pennyd GLM."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
from datetime import datetime, timezone
from pathlib import Path


HOME = Path.home()
STATE = HOME / ".estate" / "claude-surfaces"
CC = Path(os.environ.get("CLAUDE_CONFIG_DIR", HOME / ".estate" / "harness" / "cc")) / "settings.json"
DESKTOP_ROOT = HOME / "Library" / "Application Support" / "Claude"
DESKTOP = DESKTOP_ROOT / "claude_desktop_config.json"
DESKTOP_LIBRARY = (
    HOME / "Library" / "Application Support" / "Claude-3p" / "configLibrary"
)
DESKTOP_CONFIG_ID = "11111111-1111-4111-8111-111111111111"
HELPER = HOME / ".estate" / "bin" / "pennyd-client-key"
BASE = os.environ.get("PENNYD_URL", "http://127.0.0.1:4200")
PROVIDER_ENV = (
    "ANTHROPIC_BASE_URL",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL",
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "ANTHROPIC_CUSTOM_HEADERS",
)
