#!/usr/bin/env python3
"""The reverse compiler (Diamond Standard, founder 2026-09-01: "Draft the Reverse-Compiler
Hydration Script").

Walks the existing platform tree and expresses what it can as capability intents — the bootstrap
for the JIT compiler: the estate that exists becomes intent-defined without anyone rewriting it by
hand. Every Deployment it can express lands as a draft in intents/drafts/<ns>-<name>.json; what it
cannot express yet is counted by kind and printed, never hidden — a coverage number nobody can
read is not a coverage number (LAW 28).

Drafts are DRAFTS: intents/drafts/ is not read by bin/intent-compile (only intents/*.json is).
Promoting a draft is a human diff: compile it, compare against the hand-written manifests, and
only then move it. Zero drift on adoption means byte-level agreement, which this script does not
claim — it reports what it extracted and what it skipped.
Exit 0 with the report; 2 when the platform tree cannot be read.
"""

import json
import pathlib
import re
import sys
from collections import Counter

HERE = pathlib.Path(__file__).resolve().parents[1]

import yaml  # noqa: E402

SIZE_BY_CPU_LIMIT = [(200, "s"), (500, "m"), (10**9, "l")]


def millicores(v: str) -> int:
    m = re.fullmatch(r"(\d+)m", str(v))
    return int(m.group(1)) if m else int(float(v) * 1000)


def docs(tree: pathlib.Path):
    for f in sorted(tree.rglob("*.yaml")):
        if any(p in {"tests", "compiled"} for p in f.parts):
            continue
        try:
            for d in yaml.safe_load_all(f.read_text()):
                if isinstance(d, dict) and d.get("kind"):
                    yield f, d
        except yaml.YAMLError:
            yield f, {"kind": "UNPARSEABLE"}


def hydrate_deployment(d: dict, hosts: dict[str, str]) -> tuple[dict, list[str]]:
    meta, skipped = d.get("metadata", {}), []
    name = meta.get("name", "unnamed")
    spec = d.get("spec", {})
    tpl = spec.get("template", {}).get("spec", {})
    cs = [c for c in tpl.get("containers", []) if c.get("image")]
    c = cs[0]
    component = c["image"].split("/")[-1].split(":")[0].split("@")[0]
    intent: dict = {
        "capability": "workload",
        "name": name,
        "component": component,
        "purpose": f"hydrated from the live tree; was {meta.get('namespace', '?')}/{name}",
        "replicas": max(2, int(spec.get("replicas", 2))),
    }
    ports = c.get("ports", [])
    if ports and ports[0].get("containerPort", 0) >= 1024:
        intent["port"] = ports[0]["containerPort"]
    env = {}
    for e in c.get("env", []):
        v = e.get("value")
        if v is None or "${" in str(v):
            skipped.append(f"env {e.get('name')}: secret ref or DNA reference")
        else:
            env[e["name"]] = str(v)
    if env:
        intent["env"] = env
    limit = c.get("resources", {}).get("limits", {}).get("cpu")
    if limit:
        mc = millicores(limit)
        intent["size"] = next(s for cap, s in SIZE_BY_CPU_LIMIT if mc <= cap)
    if name in hosts:
        intent["public_host"] = hosts[name]
    if len(cs) > 1:
        skipped.append(f"{len(cs) - 1} extra container(s): multi-container pods are not expressible yet")
    return intent, skipped


def main() -> int:
    tree = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else HERE / "platform"
    if not tree.is_dir():
        print(f"BLIND: {tree} is not a directory")
        return 2
    hosts: dict[str, str] = {}
    deployments, kinds = [], Counter()
    for f, d in docs(tree):
        kinds[d["kind"]] += 1
        if d["kind"] == "HTTPRoute":
            for h in d.get("spec", {}).get("hostnames", []):
                for r in d.get("spec", {}).get("rules", []):
                    for b in r.get("backendRefs", []):
                        if h.endswith(".${ESTATE_ZONE}"):
                            hosts[b.get("name", "")] = h.removesuffix(".${ESTATE_ZONE}")
        elif d["kind"] == "Deployment":
            deployments.append((f, d))
    out = HERE / "intents" / "drafts"
    out.mkdir(parents=True, exist_ok=True)
    written, skipped_all = 0, []
    for f, d in deployments:
        try:
            intent, skipped = hydrate_deployment(d, hosts)
        except (KeyError, IndexError, ValueError) as e:
            skipped_all.append(f"{f.relative_to(HERE)}: not expressible ({e!r})")
            continue
        ns = d.get("metadata", {}).get("namespace", "default")
        (out / f"{ns}-{intent['name']}.json").write_text(
            json.dumps(intent, indent=2, sort_keys=True) + "\n")
        written += 1
        skipped_all += [f"{f.relative_to(HERE)}: {s}" for s in skipped]
    for line in skipped_all:
        print(f"skip  {line}")
    rest = {k: n for k, n in kinds.items() if k != "Deployment"}
    print(f"ok    hydrate  {written}/{len(deployments)} Deployments drafted to intents/drafts/; "
          f"not expressible yet: {sum(rest.values())} resources across {len(rest)} kinds "
          f"(top: {', '.join(f'{k} x{n}' for k, n in kinds.most_common(6))})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
