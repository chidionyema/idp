#!/usr/bin/env python3
"""Refuse a catalog entity whose metadata.links[].url is not an absolute https/http URI.

A relative URL like ``/dagster`` is invisible as a bug until the page renders blank. The
gate refuses it at commit time (pre-commit hook) and at CI time (bin/idp-ci via rules.yaml).

Template substitution variables of the form ``${ESTATE_ZONE}`` inside URLs are permitted:
  https://catalogue.${ESTATE_ZONE}/dagster  -- valid (absolute, https scheme)
  /dagster                                   -- invalid (relative path)
  //catalogue.example.com/dagster            -- invalid (protocol-relative)
  javascript:void(0)                         -- invalid (non-http scheme)

Edge cases handled:
  metadata.links absent                  skipped (no links to validate)
  metadata.links is not a list           refused
  link entry is None                     refused
  link entry missing url                 refused
  url is not a string                    refused
  url is a relative path                 refused
  url is protocol-relative (//...)       refused
  url has a non-http scheme              refused
  url contains ${...} template vars      allowed when the scheme is https:// or http://
  multi-document YAML                    each document validated independently
  empty file                             skipped
  non-YAML file                          parse error reported as failure

Usage:
  idp-catalog-links-gate              scan backstage/ under the repo root
  idp-catalog-links-gate PATH...      scan the given files or directories
  idp-catalog-links-gate --self-test  verify the gate catches the bad fixture; exit 0

Exit 0 on clean, 1 on any violation, 2 on usage / setup error.
"""
from __future__ import annotations

import glob
import os
import sys
from urllib.parse import urlparse

import yaml

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ALLOWED_SCHEMES = {"http", "https"}


def _is_catalog_path(p: str) -> bool:
    """Exclude template skeleton dirs and node_modules; they contain non-entity YAML."""
    norm = p.replace(os.sep, "/")
    return "/skeleton/" not in norm and "/node_modules/" not in norm


def catalog_files(paths: list[str]) -> list[str]:
    found = []
    for p in paths:
        if os.path.isfile(p):
            if _is_catalog_path(p):
                found.append(p)
        elif os.path.isdir(p):
            for ext in ("*.yaml", "*.yml"):
                for f in glob.glob(os.path.join(p, "**", ext), recursive=True):
                    if _is_catalog_path(f):
                        found.append(f)
        else:
            for f in glob.glob(p, recursive=True):
                if _is_catalog_path(f):
                    found.append(f)
    return sorted(set(found))


def parse_entities(path: str) -> list[dict]:
    with open(path, encoding="utf-8-sig") as fh:
        content = fh.read()
    if not content.strip():
        return []
    docs = list(yaml.safe_load_all(content))
    entities = []
    for doc in docs:
        if doc is None:
            continue
        if isinstance(doc, list):
            entities.extend(doc)
        elif isinstance(doc, dict):
            entities.append(doc)
    return entities


def is_backstage_entity(doc: dict) -> bool:
    return (
        isinstance(doc.get("apiVersion"), str)
        and "backstage.io" in doc["apiVersion"]
        and "kind" in doc
    )


def check_file(path: str) -> list[str]:
    failures = []

    try:
        entities = parse_entities(path)
    except yaml.YAMLError as exc:
        return [f"{path}: YAML parse error: {exc}"]
    except OSError as exc:
        return [f"{path}: read error: {exc}"]

    for entity in entities:
        if not isinstance(entity, dict):
            continue
        if not is_backstage_entity(entity):
            continue

        kind = entity.get("kind", "")
        name = (entity.get("metadata") or {}).get("name", "<unnamed>")
        label = f"{path}: {kind}/{name}"

        meta = entity.get("metadata") or {}
        links = meta.get("links")
        if links is None:
            continue

        if not isinstance(links, list):
            failures.append(f"{label}: metadata.links is not a list")
            continue

        for i, link in enumerate(links):
            loc = f"{label} links[{i}]"

            if link is None:
                failures.append(f"{loc}: entry is null")
                continue

            if not isinstance(link, dict):
                failures.append(f"{loc}: entry is not a mapping")
                continue

            url = link.get("url")
            if url is None:
                failures.append(f"{loc}: missing url")
                continue

            if not isinstance(url, str):
                failures.append(f"{loc}: url is not a string (got {type(url).__name__})")
                continue

            if not url.strip():
                failures.append(f"{loc}: url is empty")
                continue

            # Strip Flux/Backstage template vars for scheme detection:
            # https://catalogue.${ESTATE_ZONE}/path  =>  https://catalogue.PLACEHOLDER/path
            stripped = url
            import re
            stripped = re.sub(r"\$\{[^}]+\}", "PLACEHOLDER", stripped)
            stripped = re.sub(r"\$\{\{[^}]+\}\}", "PLACEHOLDER", stripped)

            try:
                parsed = urlparse(stripped)
            except ValueError as exc:
                failures.append(f"{loc}: url parse error: {exc}")
                continue

            if parsed.scheme not in ALLOWED_SCHEMES:
                if not parsed.scheme:
                    failures.append(
                        f"{loc}: url '{url}' is relative or protocol-relative. "
                        f"Use an absolute URL (https://...)."
                    )
                else:
                    failures.append(
                        f"{loc}: url '{url}' uses disallowed scheme '{parsed.scheme}'. "
                        f"Allowed: {', '.join(sorted(ALLOWED_SCHEMES))}"
                    )
                continue

            if not parsed.netloc:
                failures.append(
                    f"{loc}: url '{url}' has no hostname. Use an absolute URL (https://...)."
                )

    return failures


def run(paths: list[str]) -> int:
    files = catalog_files(paths)
    if not files:
        print("ok    catalog-links  no catalog files found")
        return 0

    failures: list[str] = []
    for f in files:
        failures.extend(check_file(f))

    for msg in failures:
        print(f"FAIL  {msg}", file=sys.stderr)

    if not failures:
        print(f"ok    catalog-links  {len(files)} file(s) clean")
        return 0

    print(f"\n{len(failures)} violation(s). Failing.", file=sys.stderr)
    return 1


def self_test() -> int:
    bad_dir = os.path.join(ROOT, "tests", "fixtures", "catalog-links", "bad")
    good_dir = os.path.join(ROOT, "tests", "fixtures", "catalog-links", "good")

    bad_result = run([bad_dir])
    if bad_result == 0:
        print("FAIL  self-test: bad fixture passed but should have failed", file=sys.stderr)
        return 1

    good_result = run([good_dir])
    if good_result != 0:
        print("FAIL  self-test: good fixture failed but should have passed", file=sys.stderr)
        return 1

    print("ok    self-test: bad refused, good passed")
    return 0


def main() -> None:
    args = sys.argv[1:]

    if args == ["--self-test"]:
        sys.exit(self_test())

    if not args:
        paths = [os.path.join(ROOT, "backstage")]
    else:
        paths = args

    sys.exit(run(paths))


if __name__ == "__main__":
    main()
