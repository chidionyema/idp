#!/usr/bin/env python3
"""catalog-render: put the live architecture page on main on a schedule, through a pull request.

crew#236 row 2, second half. bin/catalog-gen and bin/estate-diagram already turn the inventory
into catalog/catalog-info.yaml and docs/architecture/live.md; this job runs them after every
inventory run (scheduler/schedule.yml: com.estate.catalog-render, after: com.estate.inventory)
and lands the page on main. Nothing here is a new collector or renderer.

Why a script at all: the scheduler needs one command, and main is protected by required
checks with no bypass actor, so a direct push is refused. The proven pieces used are a
detached git worktree at origin/main (the same shape as crew's estate-snapshot), a branch
push, `gh pr create` and GitHub's own auto-merge, which lands the change the moment
security-scan and spec-gate pass. What was rejected: pushing straight to main (refused by
the ruleset), a bypass actor (a hole a buyer's engineer finds in one sitting), and a launchd
plist (the estate scheduler is the one scheduler, LAW 19a/20b).

    catalog-render             render, commit, push, open or refresh the PR with auto-merge on
    catalog-render --dry-run   render and print the diff; touch nothing on origin

Exit 0 when the page is on its way to main or unchanged, 1 naming the step that failed,
3 BLIND when there is no inventory to render from.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
WT = Path(os.environ.get("IDP_STATE_WORKTREE") or ROOT.parent / ".idp-state")
BRANCH = "state/live-diagram"
PAGE = "docs/architecture/live.md"
SHOWCASE = "docs/SHOWCASE.md"
TRACE = "docs/TRACE-MATRIX.md"          # crew#495 CP1
NEXT = "docs/NEXT.md"                   # crew#403 CP6
FOUNDER = "docs/FOUNDER.md"             # crew#412 R38
TRACE_JSON = "docs/trace-matrix.json"
INV = Path(os.environ.get("INV") or os.path.expanduser("~/.estate/state/inventory.json"))


def driver_is_stale(driver: Path, on_main: Path) -> bool:
    """crew#474, 2026-08-27: the scheduler runs $IDP/bin/catalog-render from the shared checkout,
    and that checkout was on a peer's feature branch (feat/crew290), so the driver that ran was
    a copy without the estate-showcase step while its own worktree sat on main. The inner steps
    were current; the script driving them was not. Stale means: this file is not the worktree's
    copy and its bytes differ from the worktree's copy at origin/main.
    """
    try:
        if driver.resolve() == on_main.resolve():
            return False
        return driver.read_bytes() != on_main.read_bytes()
    except OSError:
        return False


def should_hand_over(driver: Path, on_main: Path, argv: list[str], env: dict) -> bool:
    """Only the scheduled run hands over. A branch run of a PR that edits this driver must
    execute its own copy (code-2f, idp#377 review 5437850580)."""
    if "--scheduled" not in argv or env.get("CATALOG_RENDER_REEXEC"):
        return False
    return driver_is_stale(driver, on_main)


def reexec_from_worktree(driver: Path, on_main: Path, argv: list[str]) -> None:
    """Hand over to the origin/main copy of this script, once, and never loop."""
    if not should_hand_over(driver, on_main, argv, dict(os.environ)):
        return
    print(f"catalog-render: driver {driver} differs from origin/main; re-running {on_main}")
    os.environ["CATALOG_RENDER_REEXEC"] = "1"
    os.execv(sys.executable, [sys.executable, str(on_main), *argv])


def sh(cmd: list[str], cwd: Path, timeout: int = 120) -> tuple[int, str]:
    p = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout + p.stderr).strip()


def step(label: str, cmd: list[str], cwd: Path, timeout: int = 120) -> str:
    rc, out = sh(cmd, cwd, timeout)
    if rc != 0:
        print(f"FAIL  catalog-render: {label}: {out[:300]}")
        sys.exit(1)
    return out


def main(argv: list[str]) -> int:
    dry = "--dry-run" in argv
    if not INV.is_file():
        print(f"BLIND catalog-render: no inventory at {INV}; com.estate.inventory has not run", file=sys.stderr)
        return 3
    # --prune: after the render PR merges with delete-branch, origin/state/live-diagram is gone but
    # the local remote-ref still holds it, and --force-with-lease refuses with "stale info" (12:20Z).
    step("fetch origin, prune", ["git", "fetch", "-q", "--prune", "origin"], ROOT)
    if not (WT / ".git").exists():
        sh(["git", "worktree", "prune"], ROOT)
        step("create worktree", ["git", "worktree", "add", "--detach", "-q", str(WT), "origin/main"], ROOT)
    step("move worktree to origin/main", ["git", "checkout", "-q", "--detach", "origin/main"], WT)
    reexec_from_worktree(Path(__file__), WT / "bin" / "catalog-render", sys.argv[1:])
    # crew#401 CP5: the founder-surface cards carry a live health stamp on the scheduled render only.
    os.environ["CATALOG_GEN_PROBE"] = "1"
    step("catalog-gen", [sys.executable, str(WT / "bin" / "catalog-gen")], WT, 300)
    # crew#401 CP4: the cluster's catalogue is this file as an OCI artifact (clusters/oke/catalog.yaml).
    # Until 2026-08-27 nothing pushed it on a schedule; the artifact on ghcr was 24 hours behind the
    # inventory and the portal showed a stale estate. Idempotent: same content, same digest. BLIND
    # (no flux/sops/token on this machine) is reported, never hidden, and does not stop the page.
    # crew#516 CP3: dry-run 33106556071 pushed the artifact; --dry-run means nothing leaves this machine.
    if not dry:
        rc, out = sh([str(WT / "bin" / "idp-catalog-push")], WT, 300)
        print(("ok    " if rc == 0 else "BLIND ") + f"catalog-render: catalogue push: {out[-200:]}")
    else:
        print("skip  catalog-render: catalogue push skipped in --dry-run (crew#516 CP3)")
    step("estate-diagram", [sys.executable, str(WT / "bin" / "estate-diagram")], WT)
    # crew#474: the graded page, red rows first, from the same catalogue in the same run.
    # crew#403 CP6: planned / blocking / when, before the showcase so its bar can quote it.
    step("estate-next", [sys.executable, str(WT / "bin" / "estate-next")], WT)
    # crew#412 (R38): the founder's three questions, from GitHub, on the same schedule.
    step("estate-founder", [sys.executable, str(WT / "bin" / "estate-founder")], WT, 300)
    step("estate-showcase", [sys.executable, str(WT / "bin" / "estate-showcase")], WT)
    # crew#495 CP1: the trace matrix is rendered from the same worktree, on the same schedule.
    step("trace-matrix", [sys.executable, str(WT / "bin" / "trace-matrix")], WT)
    rc, diff = sh(["git", "diff", "--stat", "--", PAGE, SHOWCASE, TRACE, TRACE_JSON, NEXT, FOUNDER], WT)
    if not diff:
        print("catalog-render: page unchanged since the last render; nothing to commit")
        return 0
    if dry:
        print(f"catalog-render --dry-run: would commit\n{diff}")
        return 0
    taken = step("inventory time", ["sed", "-n", "s/^# inventory taken: //p", "catalog/catalog-info.yaml"], WT)
    step("stage", ["git", "add", PAGE, SHOWCASE, TRACE, TRACE_JSON, NEXT, FOUNDER], WT)
    step("commit", ["git", "commit", "-q", "-m", f"docs(architecture): live estate page, inventory taken {taken} (crew#401)\n\nAuthor-session: com.estate.catalog-render"], WT)
    step("push", ["git", "push", "-q", "--force-with-lease", "origin", f"HEAD:refs/heads/{BRANCH}"], WT)
    rc, existing = sh(["gh", "pr", "list", "--head", BRANCH, "--state", "open", "--json", "number", "--jq", ".[0].number"], WT)
    if not existing:
        step("open PR", ["gh", "pr", "create", "--base", "main", "--head", BRANCH,
                         "--title", "docs(architecture): live estate page from the scheduled render (crew#401)",
                         "--body", f"No-Issue: scheduled render of {PAGE} from the catalogue (crew#236 row 2).\n\n"
                                   f"Author-session: com.estate.catalog-render\nStandard: Service catalog row, docs/STANDARDS.md\n\n"
                                   "Generated by bin/catalog-render after com.estate.inventory. Auto-merge is on; "
                                   "it lands when security-scan and spec-gate pass.\n\n"
                                   # crew#474: the operating-model gate refuses a body with no laws section
                                   # (idp#376 sat BLOCKED for a day), so the generated body carries one.
                                   "## Architecture laws\n"
                                   f"- LAW 1 zero-gravity: n/a: generated pages only, {PAGE} and {SHOWCASE}\n"
                                   "- LAW 2 fractal: bin/catalog-render -> bin/estate-showcase -> bin/trace-matrix\n"
                                   f"- LAW 3 nervous system: scheduler/schedule.yml com.estate.catalog-render -> {BRANCH}\n"
                                   "- LAW 4 calibration: n/a: no prediction made\n"], WT)
        rc, existing = sh(["gh", "pr", "list", "--head", BRANCH, "--state", "open", "--json", "number", "--jq", ".[0].number"], WT)
    step("auto-merge", ["gh", "pr", "merge", existing, "--auto", "--squash"], WT)
    print(f"catalog-render: {PAGE} pushed to {BRANCH}, PR #{existing} set to auto-merge")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
