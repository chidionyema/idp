#!/usr/bin/env python3
"""Shared pre-commit default: the estate Python standard (founder 2026-08-29, crew#620 CP4,
"platform wide"). Runs in every repo after the repo's own hook, like shell-strict-default.

Every staged .py file must:
  1. pass `ruff check --select E9,F,B,S` (syntax, undefined names, bugbear, security rules;
     S603/S607 ignored, S101 ignored in tests)
  2. be `ruff format` clean
  3. (note only) under bin/ or scripts/: subprocess.run(...) carries check=True
  4. existing files ratchet: a regression is refused, a pre-existing gap is noted (LAW 38)
Fails CLOSED when ruff is missing. Tests: ~/.estate/tests/test_python_strict.py

CI runs the same file: PYTHON_STRICT_RANGE=<base>...<head> grades the commits in that range
instead of the index, so the hook and the CI job can never disagree (one copy, LAW 43).

THE CANARY (2026-10-29). This gate is also the enforcement surface of the estate's ONE
failure-class authority (platform/estate/libexec/failure_class.py). When a file breaks a
standard row, the gate asks the class store whether this failure has already been diagnosed,
corrected and published by someone else. If it has, the gate PRINTS the published correction:
the second agent inherits the fix instead of re-deriving it. If it has not, the class is
recorded as observed, so the next agent sees that it is not the first.

TWO PROPERTIES THIS GATE KEEPS.

  1. IT NEVER REPAIRS WHAT IT GRADES. The CI range used to run `ruff format` and
     `ruff check --fix` over the changed files and then grade the result, which makes the gate
     unfalsifiable: a gate that fixes the defect it is measuring cannot fail on that defect.
     The mutation is gone. The correction is a separate authoring step, and the gate's job is
     to say what is wrong.
  2. IT NEVER FAILS BECAUSE OF THE CANARY. The class store is a convenience, not a dependency:
     if it is unreachable the gate grades the file exactly as it did before.
"""

from __future__ import annotations

import importlib.util
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from contextlib import redirect_stdout
from importlib.machinery import SourceFileLoader
from pathlib import Path

RULES = "E9,F,B,S"
# S603/S607 fire on every list-form subprocess call; S101 is how pytest asserts. Neither is a defect.
IGNORE = "S603,S607"
PER_FILE = "tests/*:S101,test_*.py:S101,*_test.py:S101"
TICKET = "crew#620"
CHECK_RE = re.compile(r"subprocess\.(run|call|Popen)\((?![^)]*check=True)")
RULE_RE = re.compile(r"\b([A-Z]{1,4}[0-9]{3})\b")
SURFACE = "idp-python-strict"
_RUFF_BIN = shutil.which("ruff") or (sys.executable + " -m ruff").split()
RUFF_CMD = _RUFF_BIN if isinstance(_RUFF_BIN, list) else [_RUFF_BIN]


def log(msg: str) -> None:
    if os.environ.get("DEBUG"):
        print(f"python-strict: {msg}", file=sys.stderr)


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], check=True, capture_output=True, text=True
    ).stdout


RANGE = os.environ.get("PYTHON_STRICT_RANGE")  # e.g. origin/main...HEAD in CI
BASE = RANGE.split("...")[0].split("..")[0] if RANGE else "HEAD"


def diff(*flt: str) -> list[str]:
    args = ["diff", *flt] if RANGE is None else ["diff", RANGE, *flt]
    if RANGE is None:
        args.insert(1, "--cached")
    return git(*args, "--name-only").split("\n")


def staged_python() -> tuple[list[str], set[str]]:
    staged = [f for f in diff("--diff-filter=ACM") if f.endswith(".py")]
    added = set(diff("--diff-filter=A"))
    return [f for f in staged if os.path.isfile(f)], added


def ruff_check(path: str, fix: bool = False) -> bool:
    cmd = [
        *RUFF_CMD,
        "check",
        "--quiet",
        "--select",
        RULES,
        "--ignore",
        IGNORE,
        "--per-file-ignores",
        PER_FILE,
        "--",
        path,
    ]
    if fix:
        cmd.insert(3, "--fix")
    return (
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
        ).returncode
        == 0
    )


def ruff_format(path: str, fix: bool = False) -> bool:
    cmd = [*RUFF_CMD, "format"]
    if fix:
        cmd.append("--quiet")
    else:
        cmd.extend(["--check", "--quiet"])
    cmd.extend(["--", path])
    return (
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
        ).returncode
        == 0
    )


def head_copy(path: str) -> str | None:
    """Temp copy of the base version of the file (HEAD, or the range base in CI), or None when new."""
    proc = subprocess.run(
        ["git", "show", f"{BASE}:{path}"], check=False, capture_output=True, text=True
    )
    if proc.returncode != 0:
        return None
    fd, tmp = tempfile.mkstemp(suffix=".py")
    with os.fdopen(fd, "w") as fh:
        fh.write(proc.stdout)
    return tmp


def _fcr_lib() -> str | None:
    """Where the failure-class store lives. None means the canary is simply off."""
    here = Path(__file__).resolve()
    candidates = []
    override = os.environ.get("ESTATE_FCR_LIB")
    if override:
        candidates.append(Path(override))
    candidates.append(Path.home() / ".estate" / "libexec" / "failure_class.py")
    candidates.append(
        here.parent.parent / "platform" / "estate" / "libexec" / "failure_class.py"
    )
    for cand in candidates:
        if cand.is_file():
            return str(cand)
    return None


_FCR_MODULE = None


def _fcr_module():
    """Load the failure-class authority once, in-process.

    The canary used to fork a python process per question. On a loaded machine a fork costs
    seconds, and a gate that costs seconds per staged file is a gate people bypass. The module
    is stdlib-only and importable, so it is imported instead of spawned.
    """
    global _FCR_MODULE
    if _FCR_MODULE is not None:
        return _FCR_MODULE
    lib = _fcr_lib()
    if not lib:
        return None
    try:
        loader = SourceFileLoader("estate_failure_class", lib)
        spec = importlib.util.spec_from_loader("estate_failure_class", loader)
        module = importlib.util.module_from_spec(spec)
        sys.modules["estate_failure_class"] = module
        loader.exec_module(module)
    except Exception:  # noqa: BLE001 -- the canary is never a dependency of the gate
        return None
    _FCR_MODULE = module
    return module


def _fcr(*args: str) -> dict | None:
    """Ask the failure-class authority something. Never raises: the canary is not a dependency."""
    module = _fcr_module()
    if module is None:
        return None
    buf = io.StringIO()
    try:
        with redirect_stdout(buf):
            code = module.main(list(args))
    except Exception:  # noqa: BLE001 -- the canary is never a dependency of the gate
        return None
    if code != 0:
        return None
    try:
        return json.loads(buf.getvalue())
    except ValueError:
        return None


def ruff_codes(path: str) -> list[str]:
    """The rule codes ruff reports for this file, so a failure can be named as a CLASS."""
    cmd = [
        *RUFF_CMD,
        "check",
        "--select",
        RULES,
        "--ignore",
        IGNORE,
        "--per-file-ignores",
        PER_FILE,
        "--",
        path,
    ]
    try:
        proc = subprocess.run(cmd, check=False, capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError):
        return []
    codes: list[str] = []
    for line in proc.stdout.splitlines():
        match = RULE_RE.search(line)
        if match and match.group(1) not in codes:
            codes.append(match.group(1))
    return codes


def main() -> int:
    files, added = staged_python()
    if not files:
        return 0
    if shutil.which("ruff") is None:
        print(
            "REFUSED: ruff is not installed and a Python file is staged. Install: brew install ruff",
            file=sys.stderr,
        )
        return 1
    if RANGE:
        # NO MUTATION HERE. The range used to be rewritten in place by `ruff format` and
        # `ruff check --fix` and then graded, which made the gate unfalsifiable on exactly the
        # defects it exists to catch. The gate measures; the correction is a separate authoring
        # step. Deleted paths need no special handling here: staged_python() keeps only paths
        # that exist, so ruff is never handed a file that is correctly gone.
        pass
    bad = False
    produced: set[str] = set()
    for f in files:
        was = None if f in added else head_copy(f)
        for row, fn in (
            ("ruff check " + RULES, ruff_check),
            ("ruff format", ruff_format),
        ):
            if fn(f):
                continue
            if was is not None and not fn(was):
                print(
                    f"python-strict: {f}: ratchet, already off-standard on HEAD ({row}); retrofit is {TICKET}, not this commit",
                    file=sys.stderr,
                )
                continue
            print(
                f"python-strict: {f}: fails {row} (standard row {'1' if fn is ruff_check else '2'})",
                file=sys.stderr,
            )
            bad = True
            if fn is ruff_check:
                for code in ruff_codes(f):
                    produced.add(code)
                    info = _fcr(
                        "check",
                        "--kind",
                        "python-lint.rule",
                        "--signature",
                        code,
                    )
                    if not info or not info.get("known"):
                        continue
                    if info.get("correction"):
                        print(
                            "python-strict: %s: KNOWN-CLASS %s (python-lint.rule:%s) v%s -- %s"
                            % (
                                f,
                                info.get("class_id"),
                                code,
                                info.get("correction_version"),
                                info.get("correction"),
                            ),
                            file=sys.stderr,
                        )
                    _fcr(
                        "observe",
                        "--class",
                        str(info.get("class_id")),
                        "--surface",
                        SURFACE,
                        "--evidence",
                        "%s:%s" % (f, code),
                    )
        if was:
            os.unlink(was)
        if f.startswith(("bin/", "scripts/")):
            with open(f, encoding="utf-8", errors="replace") as fh:
                n = len(CHECK_RE.findall(fh.read()))
            if n:
                print(
                    f"python-strict: {f}: note, {n} subprocess call(s) without check=True (standard row 3)",
                    file=sys.stderr,
                )
    # ADOPTION. A surface that observed a class and has now stopped producing it has inherited
    # the published correction -- that is the acknowledgement, and it is the fleet-wide
    # adoption evidence. A surface that never observed the class has adopted nothing.
    pending = _fcr("pending", "--surface", SURFACE)
    for item in (pending or {}).get("pending", []):
        if item.get("signature") in produced:
            continue
        _fcr(
            "adopt",
            "--class",
            str(item.get("class_id")),
            "--surface",
            SURFACE,
            "--version",
            str(item.get("version")),
            "--evidence",
            "no occurrence of %s in this run" % item.get("signature"),
        )
    if bad:
        print(
            f"REFUSED: a staged Python file breaks the estate Python standard ({TICKET}). Fix: ruff check --select {RULES} --fix; ruff format",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as exc:
        print(f"python-strict-default: git failed: {exc}", file=sys.stderr)
        sys.exit(1)
