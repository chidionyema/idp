#!/usr/bin/env python3
"""Shared pre-commit default: the estate Python standard (founder 2026-08-29, crew#620 CP4,
"platform wide"). Runs in every repo after the repo's own hook, like shell-strict-default.

Every staged .py file must:
  1. pass `ruff check --select E9,F,B,S` (syntax, undefined names, bugbear, security rules;
     S603/S607 ignored, S101 ignored in tests)
  2. be `ruff format` clean
  3. (note only) under bin/ or scripts/: subprocess.run(...) carries check=True
  4. existing files ratchet: a regression is refused, a pre-existing gap is noted (LAW 38)
Fails CLOSED when ruff is missing. Tests: ~/.estate/tests/test_python_strict.py

CI runs the same file: PYTHON_STRICT_RANGE=<base>...<head> grades the commits in that range
instead of the index, so the hook and the CI job can never disagree (one copy, LAW 43).
"""

from __future__ import annotations

import os
import re
import shutil
import subprocess
import sys
import tempfile

RULES = "E9,F,B,S"
# TEST-CODE EXEMPTIONS. The globs here are `ruff`'s, and `tests/*` matches only a DIRECT child
# of tests/ -- it never matched `sovereign/tests/bdd/...`, which is why 24 test files failed this
# rung on 2026-09-23 after the 318-branch consolidation. `**/tests/**` covers nested suites.
#
# The rules, and why each is not a defect in a test:
#   S101  bare assert -- pytest's assertion idiom, not production input validation
#   S311  random, not for crypto -- statistical test noise
#   S105  "hardcoded password" fires on a VARIABLE NAMED token in a fixture
#   S608  "SQL injection" fires on a test's own query string, which is not user input
# This list is the one `pyproject.toml` already keeps under
# [tool.ruff.lint.per-file-ignores]; the two must agree, and this is the one the rung uses.
#
# FORMAT. `ruff` accepts ONE pattern:rule per flag, and a comma inside the rule list is read as
# the start of the next pattern (measured: `**/tests/**:S101,S311` -> "invalid value 'S311'").
# So the rules are repeated, one flag each, built below rather than written as one string.
_TEST_EXEMPT_RULES = ("S101", "S311", "S105", "S608")
_TEST_GLOBS = ("**/tests/**/*.py", "test_*.py", "*_test.py")
PER_FILE_PARTS = [
    f"--per-file-ignores={g}:{r}" for g in _TEST_GLOBS for r in _TEST_EXEMPT_RULES
]
TICKET = "crew#620"
CHECK_RE = re.compile(r"subprocess\.(run|call|Popen)\((?![^)]*check=True)")
_RUFF_BIN = shutil.which("ruff") or (sys.executable + " -m ruff").split()
RUFF_CMD = _RUFF_BIN if isinstance(_RUFF_BIN, list) else [_RUFF_BIN]


def log(msg: str) -> None:
    if os.environ.get("DEBUG"):
        print(f"python-strict: {msg}", file=sys.stderr)


def git(*args: str) -> str:
    return subprocess.run(
        ["git", *args], check=True, capture_output=True, text=True
    ).stdout


RANGE = os.environ.get("PYTHON_STRICT_RANGE")  # e.g. origin/main...HEAD in CI
BASE = RANGE.split("...")[0].split("..")[0] if RANGE else "HEAD"


def diff(*flt: str) -> list[str]:
    args = ["diff", *flt] if RANGE is None else ["diff", RANGE, *flt]
    if RANGE is None:
        args.insert(1, "--cached")
    return git(*args, "--name-only").split("\n")


def staged_python() -> tuple[list[str], set[str]]:
    staged = [f for f in diff("--diff-filter=ACM") if f.endswith(".py")]
    added = set(diff("--diff-filter=A"))
    return [f for f in staged if os.path.isfile(f)], added


def ruff_check(path: str, fix: bool = False) -> bool:
    cmd = [*RUFF_CMD, "check", "--quiet", "--select", RULES, "--ignore", IGNORE, *PER_FILE_PARTS, "--", path]
    if fix:
        cmd.insert(3, "--fix")
    return (
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
        ).returncode
        == 0
    )


def ruff_format(path: str, fix: bool = False) -> bool:
    cmd = [*RUFF_CMD, "format"]
    if fix:
        cmd.append("--quiet")
    else:
        cmd.extend(["--check", "--quiet"])
    cmd.extend(["--", path])
    return (
        subprocess.run(
            cmd,
            check=False,
            capture_output=True,
        ).returncode
        == 0
    )


def head_copy(path: str) -> str | None:
    """Temp copy of the base version of the file (HEAD, or the range base in CI), or None when new."""
    proc = subprocess.run(
        ["git", "show", f"{BASE}:{path}"], check=False, capture_output=True, text=True
    )
    if proc.returncode != 0:
        return None
    fd, tmp = tempfile.mkstemp(suffix=".py")
    with os.fdopen(fd, "w") as fh:
        fh.write(proc.stdout)
    return tmp


def main() -> int:
    files, added = staged_python()
    if not files:
        return 0
    if shutil.which("ruff") is None:
        print(
            "REFUSED: ruff is not installed and a Python file is staged. Install: brew install ruff",
            file=sys.stderr,
        )
        return 1
    if RANGE:
        # AN EXISTENCE FILTER, NOT ONLY A SUFFIX ONE. `git diff --name-only` lists every changed
        # path, including files this range DELETED. Handing a deleted path to ruff is not a lint
        # finding: ruff answers `E902 No such file or directory`, which reads as a defect in the
        # working tree and is really the checker asking about a file that is correctly gone. The
        # deleted tests (tests/test_incident_crew*.py) reddened every branch that removed one.
        range_files = [
            f
            for f in git("diff", RANGE, "--name-only").split("\n")
            if f.endswith(".py") and os.path.isfile(f)
        ]
        if range_files:
            subprocess.run([*RUFF_CMD, "format", "--quiet", "--"] + range_files, check=False)
            subprocess.run([*RUFF_CMD, "check", "--fix", "--quiet", "--select", RULES, "--ignore", IGNORE, *PER_FILE_PARTS, "--"] + range_files, check=False)
    bad = False
    for f in files:
        was = None if f in added else head_copy(f)
        for row, fn in (
            ("ruff check " + RULES, ruff_check),
            ("ruff format", ruff_format),
        ):
            if fn(f):
                continue
            if was is not None and not fn(was):
                print(
                    f"python-strict: {f}: ratchet, already off-standard on HEAD ({row}); retrofit is {TICKET}, not this commit",
                    file=sys.stderr,
                )
                continue
            print(
                f"python-strict: {f}: fails {row} (standard row {'1' if fn is ruff_check else '2'})",
                file=sys.stderr,
            )
            bad = True
        if was:
            os.unlink(was)
        if f.startswith(("bin/", "scripts/")):
            with open(f, encoding="utf-8", errors="replace") as fh:
                n = len(CHECK_RE.findall(fh.read()))
            if n:
                print(
                    f"python-strict: {f}: note, {n} subprocess call(s) without check=True (standard row 3)",
                    file=sys.stderr,
                )
    if bad:
        print(
            f"REFUSED: a staged Python file breaks the estate Python standard ({TICKET}). Fix: ruff check --select {RULES} --fix; ruff format",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except subprocess.CalledProcessError as exc:
        print(f"python-strict-default: git failed: {exc}", file=sys.stderr)
        sys.exit(1)
