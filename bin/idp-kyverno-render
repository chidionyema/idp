#!/usr/bin/env bash
# Renders every Flux HelmRelease under platform/ the way helm-controller will (helm template,
# then the HelmRelease's own postRenderers patches) and judges the result with the cluster's
# admission policies through the Kyverno CLI. Plain workloads the directory ships as YAML
# (Deployment, StatefulSet, DaemonSet, Job, CronJob, Pod) are judged the same way: until
# 2026-08-26 only HelmReleases were, and platform/llm/litellm.yaml, a plain Deployment, merged
# with an envFrom secretRef the cluster then refused for a day (crew#284). Kyverno judges pods at admission, after merge,
# which is too late; this runs the same ClusterPolicies before the PR is opened.
#
# Usage: bin/idp-kyverno-render <dir-with-kustomization> [more dirs...]
# Policies: this repo's own ClusterPolicies under platform/ are always loaded, from here, because
# they are here (bin/idp-kyverno-own-policies). On top of them: $IDP_KYVERNO_POLICIES (a kustomize
# dir), else prospector's deploy/k8s/policies when that checkout sits beside this one, else the
# same pinned upstream set (public, no token; the two estate-only policies are absent and the
# verdict says so).
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
S="$(mktemp -d)"; trap 'rm -rf "$S"' EXIT
for t in helm kubectl kyverno python3; do command -v "$t" >/dev/null || { echo "BLIND  $t is not installed; nothing was judged"; exit 2; }; done

# Beside the PRIMARY checkout, not beside this one. This said "$IDP/.." until 2026-08-28, and
# every agent session works in a linked worktree under a temp directory with no prospector next to
# it, so the default resolved to nothing and the judge went BLIND on every local run -- which is
# how CI became the only thing in the estate that ever judged a render (crew#516).
primary="$("$IDP/bin/idp-repo-root" "$IDP")"
pol="${IDP_KYVERNO_POLICIES:-$primary/../prospector-main/deploy/k8s/policies}"
if [ -f "$pol/kustomization.yaml" ]; then src="$pol"
else src="$IDP/tests/fixtures/kyverno/upstream"; fi
kubectl kustomize "$src" > "$S/policies.yaml"
own=$("$IDP/bin/idp-kyverno-own-policies" "$IDP/platform" "$S/policies.yaml")
n=$(grep -c '^kind: ClusterPolicy' "$S/policies.yaml")
echo "policies  $n ClusterPolicies: $src plus this repo's platform/"
echo "own       ${own:-none}"

# The fallback set is the pinned upstream library and nothing else. The two policies this estate
# wrote itself -- no-optional-secret-references and money-rail-single-writer -- live in the
# prospector checkout, and they are the two that encode incidents this estate actually had, so a
# verdict reached without them is the one verdict that cannot be trusted.
# crew#539, 2026-08-28: CI has never had that checkout. It judged platform/robusta against 24
# policies, printed "render clean", and the cluster then refused the same Deployment on
# no-optional-secret-references -- the release went Failed, Flux could not remediate it, and
# monitoring and monitoring-rules stayed down for 8h. BLIND, never a pass (LAW 28).
for want in no-optional-secret-references money-rail-single-writer; do
  grep -q "^  name: $want$" "$S/policies.yaml" && continue
  echo "BLIND  policies  $want is not in the set from $src; the estate-only policies were not"
  echo "                 judged. Point IDP_KYVERNO_POLICIES at prospector deploy/k8s/policies."
  exit 2
done

# PolicyExceptions are handed to the CLI as admission sees them: Kyverno honours only the ones in
# namespace kyverno (platform/edge/kyverno.yaml features.policyExceptions), wherever in the estate
# they are declared, so every path a clusters/oke Kustomization points at is rendered once here.
# Incident 2026-08-26 (crew#325): the langfuse exception sat beside the release it excused, the
# directory's namespace transformer rewrote it to observability, and this judge passed a render
# that admission refused for 41 hours.
rm -rf "$S/exceptions"; mkdir -p "$S/exceptions"
python3 - "$IDP" "$S/exceptions" <<'PY'
import sys, yaml, pathlib, subprocess
idp = pathlib.Path(sys.argv[1]); out = pathlib.Path(sys.argv[2]); n = 0; paths = set()
for k in sorted((idp / "clusters/oke").glob("*.yaml")):
    for d in yaml.safe_load_all(open(k)):
        path = ((d or {}).get("spec") or {}).get("path", "")
        if (d or {}).get("kind") == "Kustomization" and path.startswith("./platform/"):
            paths.add(path)
# The estate's own ClusterPolicies (require-priority-class, provider-independence R43, ...) ship in
# the same tree; until 2026-08-28 (crew#66) only the upstream/prospector set was judged here, so a
# platform policy could refuse at admission what this judge had passed. They are appended to the set.
est = 0
for path in sorted(paths):
    r = subprocess.run(["kubectl", "kustomize", str(idp / path)], capture_output=True, text=True, check=True)
    for d in yaml.safe_load_all(r.stdout):
        if d and d.get("kind") == "PolicyException" and d["metadata"].get("namespace") == "kyverno":
            (out / f"{n}.yaml").write_text(yaml.safe_dump(d)); n += 1
        if d and d.get("kind") == "ClusterPolicy":
            # platform/scheduling's kustomization stamps a namespace on its ClusterPolicies; the API
            # server ignores it on a cluster-scoped object, the CLI skips the policy with an error
            # count and no verdict. Strip it so the policy is judged, not skipped.
            d["metadata"].pop("namespace", None)
            with open(out.parent / "policies.yaml", "a") as f: f.write("---\n" + yaml.safe_dump(d)); est += 1
print(f"exceptions {n} PolicyExceptions in namespace kyverno across clusters/oke paths")
print(f"policies  +{est} estate ClusterPolicies from clusters/oke paths (platform/edge, platform/scheduling)")
PY

rc=0
for dir in "$@"; do
  kubectl kustomize "$dir" > "$S/kz.yaml"
  python3 - "$S" "$S/kz.yaml" <<'PY'
import sys, yaml, subprocess, pathlib, json
S = pathlib.Path(sys.argv[1]); docs = [d for d in yaml.safe_load_all(open(sys.argv[2])) if d]
repos = {d["metadata"]["name"]: d["spec"]["url"] for d in docs if d["kind"] == "HelmRepository"}
cms = {d["metadata"]["name"]: d.get("data", {}) for d in docs if d["kind"] == "ConfigMap"}
for hr in (d for d in docs if d["kind"] == "HelmRelease"):
    spec = hr["spec"]["chart"]["spec"]; name = hr["metadata"]["name"]
    # helm-controller installs into spec.targetNamespace when set (k8s-infra -> observability-agent,
    # crew#388); the judge must render where the objects land, or an exception scoped to that
    # namespace looks unused and the DaemonSet fails here while passing on the cluster.
    ns = hr["spec"].get("targetNamespace") or hr["metadata"].get("namespace", "default")
    # helm-controller names the release spec.releaseName, else `<targetNamespace>-<name>` when
    # targetNamespace is set, else the name (crew#483: rendering as `k8s-infra` produced a DaemonSet
    # named k8s-infra-otel-agent, the cluster's is observability-agent-k8s-infra-otel-agent, and a
    # waiver written for the rendered name never matched at admission).
    release = hr["spec"].get("releaseName") or (f'{hr["spec"]["targetNamespace"]}-{name}' if hr["spec"].get("targetNamespace") else name)
    vals = S / f"{name}.values.yaml"; vals.write_text("")
    for v in hr["spec"].get("valuesFrom", []):
        if v["kind"] == "ConfigMap": vals.write_text(cms[v["name"]][v.get("valuesKey", "values.yaml")])
    if "values" in hr["spec"]: vals.write_text(vals.read_text() + "\n" + yaml.safe_dump(hr["spec"]["values"]))
    render = S / f"{name}.render.yaml"
    # An OCI HelmRepository (crew#524, hindsight) is addressed as oci://host/path/<chart>; `--repo`
    # only speaks the HTTP index and helm exits 1, which this script used to read as "no render".
    url = repos[spec["sourceRef"]["name"]]
    chart_ref = ([f"{url.rstrip('/')}/{spec['chart']}"] if url.startswith("oci://")
                 else [spec["chart"], "--repo", url])
    out = subprocess.check_output(["helm", "template", release, *chart_ref,
        "--version", str(spec["version"]), "-n", ns, "-f", str(vals)], text=True, stderr=subprocess.DEVNULL)
    # helm prints `Pulled:`/`Digest:` for an OCI chart on stdout before the first document; kustomize
    # reads that as a resource with no metadata. The render starts at the first `---`.
    render.write_text(out[out.index("\n---\n") + 1:] if out.startswith(("Pulled:", "Digest:")) else out)
    kz = S / f"{name}.kz"; kz.mkdir(); (kz / "render.yaml").write_text(render.read_text())
    patches = [p for pr in hr["spec"].get("postRenderers", []) for p in pr.get("kustomize", {}).get("patches", [])]
    # helm-controller semantics (crew#227, SPIRE): an object that names no namespace lands in the
    # release namespace; one that names its own keeps it, and a Namespace the chart creates keeps
    # its name. The plain `namespace:` field renames chart-made Namespaces to the release namespace
    # and two of them collide ("namespace transformation produces ID conflict").
    (kz / "ns.yaml").write_text(yaml.safe_dump({"apiVersion": "builtin", "kind": "NamespaceTransformer",
        "metadata": {"name": "release-namespace", "namespace": ns}, "unsetOnly": True}))
    (kz / "kustomization.yaml").write_text(yaml.safe_dump({"apiVersion": "kustomize.config.k8s.io/v1beta1", "kind": "Kustomization",
        "transformers": ["ns.yaml"], "resources": ["render.yaml"], "patches": patches}))
    print(f"{name} {ns} {len(patches)}")
PY
  # Plain workloads in the same kustomize output, judged as they are. Services, Ingresses, claims
  # and secret stores too (crew#66, R43): provider-independence refuses those, not only pods.
  python3 - "$S/kz.yaml" "$S/plain-$(echo "$dir" | tr '/' '_').yaml" <<'PY2'
import sys, yaml
kinds = {"Deployment", "StatefulSet", "DaemonSet", "Job", "CronJob", "Pod",
         "Service", "Ingress", "PersistentVolumeClaim", "ClusterSecretStore", "SecretStore"}
docs = [d for d in yaml.safe_load_all(open(sys.argv[1])) if d and d.get("kind") in kinds]
open(sys.argv[2], "w").write(yaml.safe_dump_all(docs) if docs else "")
PY2
done > "$S/releases.txt"
for plain in "$S"/plain-*.yaml; do
  [ -s "$plain" ] || continue
  label=$(basename "$plain" .yaml | sed 's/^plain-//; s/_/\//g')
  exc=(); for x in "$S"/exceptions/*.yaml; do [ -f "$x" ] && exc+=(--exception "$x"); done
  out=$(kyverno apply "$S/policies.yaml" --resource "$plain" "${exc[@]}" 2>&1 || true)
  summary=$(printf '%s\n' "$out" | grep -E '^pass:' | tail -1)
  if printf '%s\n' "$out" | grep -qE '^policy .* failed'; then
    echo "FAIL  plain    $label: $summary"
    printf '%s\n' "$out" | grep -E '^policy .* failed' | sed 's/^/      /'; rc=1
  else echo "ok    plain    $label: $summary"; fi
done
while read -r name ns npatch; do
  kubectl kustomize "$S/$name.kz" > "$S/$name.final.yaml"
  # helm test hooks never reach the cluster (HelmRelease test.enable is off); drop them before judging.
  # Every other hook (pre/post-install, pre/post-upgrade, ...) is admitted like any pod and is
  # judged. Until 2026-08-26 this dropped all hooks, and the langfuse s3 post-upgrade bucket hook
  # merged with no securityContext; Kyverno then refused every Helm upgrade of the release (crew#325).
  python3 - "$S/$name.final.yaml" <<'PY'
import sys, yaml
def _is_test_hook(d):
    hooks = (d["metadata"].get("annotations") or {}).get("helm.sh/hook", "")
    return hooks and all(h.strip().startswith("test") for h in hooks.split(","))
p = sys.argv[1]; docs = [d for d in yaml.safe_load_all(open(p)) if d and not _is_test_hook(d)]
# A chart may emit a key with no value (`volumes:` on kube-prometheus-stack's operator when no
# volume is configured). The API server drops a null field before admission sees it; the CLI
# does not, and disallow-host-path failed the operator over a hostPath it never had (crew#539).
def _drop_null(x):
    if isinstance(x, dict): return {k: _drop_null(v) for k, v in x.items() if v is not None}
    if isinstance(x, list): return [_drop_null(v) for v in x]
    return x
docs = [_drop_null(d) for d in docs]
# Kyverno autogen covers Deployment/StatefulSet/DaemonSet but not Job/CronJob, so the CLI passed a
# migrator Job whose Pod admission then refused (2026-08-25, require-pod-probes). Judge the Pod
# a Job or CronJob would create, with the ownerReference admission would see.
for d in list(docs):
    tpl = d["spec"]["template"] if d["kind"] == "Job" else d["spec"]["jobTemplate"]["spec"]["template"] if d["kind"] == "CronJob" else None
    if tpl: docs.append({"apiVersion": "v1", "kind": "Pod", "metadata": {"name": d["metadata"]["name"] + "-pod", "namespace": d["metadata"].get("namespace"),
        "labels": (tpl.get("metadata") or {}).get("labels") or {}, "ownerReferences": [{"apiVersion": "batch/v1", "kind": "Job", "name": d["metadata"]["name"], "uid": "offline"}]}, "spec": tpl["spec"]})
open(p, "w").write(yaml.safe_dump_all(docs))
PY
  exc=(); for x in "$S"/exceptions/*.yaml; do [ -f "$x" ] && exc+=(--exception "$x"); done
  out=$(kyverno apply "$S/policies.yaml" --resource "$S/$name.final.yaml" "${exc[@]}" 2>&1 || true)
  summary=$(printf '%s\n' "$out" | grep -E '^pass:' | tail -1)
  if printf '%s\n' "$out" | grep -qE '^policy .* failed'; then
    echo "FAIL  render   $name ($ns, $npatch patches): $summary"
    printf '%s\n' "$out" | grep -E '^policy .* failed' | sed 's/^/      /'; rc=1
  else echo "ok    render   $name ($ns, $npatch patches): $summary"; fi
done < "$S/releases.txt"
exit $rc
