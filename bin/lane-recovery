#!/usr/bin/env python3
"""lane-recovery: how long a branch took to go from red back to green.

The estate measures queue-to-land, never recovery. A lane red at 14:00 and green at 14:40 costs
forty minutes nobody counts. This reads the branch's own run history, prints each red -> next-green
episode and the median, and exits 0 even when there is nothing to measure.
"""
from __future__ import annotations

import datetime as dt
import json
import os
import subprocess
import sys

PATH = os.environ.get("PATH", "")
os.environ["PATH"] = os.path.expanduser("~/.local/bin") + ":" + PATH


def runs(branch: str, repo: str) -> list[dict]:
    env = dict(os.environ)
    env["PATH"] = os.path.expanduser("~/.local/bin") + ":" + env.get("PATH", "")
    try:
        p = subprocess.run(  # noqa: S603 - fixed argv, never a shell string
            ["gh", "run", "list", "--repo", repo, "--branch", branch, "--workflow", "ci.yml",
             "--limit", "60", "--json", "conclusion,createdAt"],
            capture_output=True, text=True, timeout=45, env=env,
        )
        if p.returncode != 0:
            print(f"  gh: {(p.stderr or '').strip()[:200]}", file=sys.stderr)
        return json.loads(p.stdout or "[]")
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        print(f"  gh failed: {type(e).__name__}: {e}", file=sys.stderr)
        return []


def main(argv: list[str]) -> int:
    branch = argv[0] if argv else ""
    repo = argv[1] if len(argv) > 1 else "chidionyema/idp"
    if not branch:
        print("usage: bin/lane-recovery <branch>", file=sys.stderr)
        return 2
    rows = sorted(runs(branch, repo), key=lambda r: r.get("createdAt", ""))
    episodes, red_at = [], None
    for r in rows:
        t = dt.datetime.strptime(r["createdAt"], "%Y-%m-%dT%H:%M:%SZ")
        c = r.get("conclusion")
        if c == "failure" and red_at is None:
            red_at = t
        elif c == "success" and red_at is not None:
            episodes.append((red_at, t, (t - red_at).total_seconds() / 60))
            red_at = None
    print(f"lane-recovery: {branch} ({len(rows)} runs)")
    if not episodes:
        print("  no red -> green episode in that window")
        return 0
    for red, green, mins in episodes[-5:]:
        print(f"  red {red:%H:%M} -> green {green:%H:%M}   {mins:5.1f} min")
    mins = sorted(e[2] for e in episodes)
    print(f"  median over {len(episodes)} episode(s): {mins[len(mins) // 2]:.1f} min")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
