#!/usr/bin/env bash
# Root trust for the Sunshine admin credential, one command, no paste (crew#562 path 1; crew#66 root trust).
#   bin/idp-bootstrap-sunshine            mint the credential the portal's /pair proxy sends to Sunshine on the
#                                         estate Mac and write vault entry `sunshine-auth`; an entry that already
#                                         holds all three keys is kept
#   bin/idp-bootstrap-sunshine --check    exit 0 when the vault entry holds authorization/username/password, 1 when not
#   bin/idp-bootstrap-sunshine --rotate   mint anew even though the entry is complete
#   bin/idp-bootstrap-sunshine --adopt    ON THE ESTATE MAC: set Sunshine to the credential in $SUNSHINE_CREDS_DIR
#                                         (files `username` and `password`, the shape the ExternalSecret mounts)
#
# Why the credential is born here and not on the Mac: the Mac holds no cloud identity (laptop OCI
# sessions expire, memory worktree-secrets-path-and-oci-sessions) and the founder never pastes a
# secret (crew#66). CI holds the OIDC identity that writes the vault (oke-check apply, the same step
# shape as hermes-agent-env), so the value is minted on the runner, written once, and read back by
# external-secrets into backstage/sunshine-auth (platform/backstage/overlays/oke/sunshine-egress.yaml)
# and, for adoption, into the hermes-agent pod, whose tailnet sidecar is the only identity the
# locked ACL lets at the Mac (platform/tailscale/policy.hujson: tag:k8s -> tag:founder-mac:22). The
# Mac side is then one line through platform/hermes-agent/mac-run.yaml, run from that pod:
#   mac-run bin/idp-bootstrap-sunshine --adopt    (SUNSHINE_CREDS_DIR carried by scp, never argv)
# Nothing is printed but key NAMES. `authorization` is the ready-made header value the Backstage
# proxy reads from a file (app-config.container.yaml): Basic base64(username:password).
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
CLOUD="$IDP/bin/idp-cloud"
SECRET=sunshine-auth
USERNAME=${SUNSHINE_USERNAME:-estate}
MODE=mint
case "${1:-}" in
  "") ;;
  --check|--rotate|--adopt) MODE=${1#--} ;;
  *) sed -n 2,9p "$0"; exit 2 ;;
esac
say()  { printf '%-7s %-16s %s\n' "$1" "$2" "$3"; }
fail() { say FAIL "$1" "$2"; exit 1; }

if [ "$MODE" = adopt ]; then
  dir=${SUNSHINE_CREDS_DIR:-/run/secrets/sunshine}
  [ -s "$dir/username" ] && [ -s "$dir/password" ] || fail "$SECRET" "no username/password files under $dir"
  command -v sunshine >/dev/null || fail "$SECRET" "no sunshine binary on this host; --adopt runs on the estate Mac"
  # sunshine --creds rewrites the credentials file; the running server reads it on restart
  # (2026-08-28, this Mac: a server that never loaded its credential answered 400 to every PIN).
  sunshine --creds "$(cat "$dir/username")" "$(cat "$dir/password")" >/dev/null 2>&1 \
    || fail "$SECRET" "sunshine --creds refused the credential"
  say ok "$SECRET" "adopted by sunshine on $(hostname -s); restart the server to load it"
  exit 0
fi

complete() { # -> 0 when the vault entry carries all three keys
  local cur; cur=$("$CLOUD" secret get "$SECRET" 2>/dev/null) && [ -n "$cur" ] || return 1
  jq -e '.authorization and .username and .password' <<<"$cur" >/dev/null 2>&1
}
if complete; then
  [ "$MODE" = check ] && { say ok "$SECRET" "vault entry holds authorization/username/password"; exit 0; }
  [ "$MODE" = mint ] && { say ok "$SECRET" "vault entry complete; kept (--rotate to mint anew)"; exit 0; }
else
  [ "$MODE" = check ] && fail "$SECRET" "vault entry absent or incomplete; run $0 to mint"
fi

# Mint: 32 url-safe characters from the kernel, never echoed. The header value is derived once here
# so no reader has to know how Basic auth is spelled.
umask 077
P=$(mktemp -d); trap 'rm -rf "$P"' EXIT
# head first, then filter: `tr </dev/urandom | head` dies of SIGPIPE under pipefail (rc 141) and
# set -e ends the script before the write, silently (first run of this file, 2026-08-28).
password=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-32)
[ ${#password} -eq 32 ] || fail "$SECRET" "the kernel gave fewer than 32 usable characters; rerun"
auth="Basic $(printf '%s:%s' "$USERNAME" "$password" | base64 | tr -d '\n')"
printf 'SUNSHINE_USERNAME=%s\nSUNSHINE_PASSWORD=%s\nSUNSHINE_AUTHORIZATION=%s\n' "$USERNAME" "$password" "$auth" > "$P/env"
ESTATE_ENV_FILE="$P/env" "$IDP/bin/idp-vault-put" "$SECRET" \
  username=SUNSHINE_USERNAME password=SUNSHINE_PASSWORD authorization=SUNSHINE_AUTHORIZATION >/dev/null
complete || fail "$SECRET" "written but does not read back complete"
say ok "$SECRET" "minted (username $USERNAME); adopt on the Mac with --adopt, then the /pair proxy works"
