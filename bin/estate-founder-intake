#!/usr/bin/env python3
"""estate-founder-intake -- every founder prompt, analysed and retrievable.

    estate-founder-intake --text "..."
    estate-founder-intake --file /path/to/prompt.txt
    estate-founder-intake --stdin
    estate-founder-intake --repeat "..."   detect a repeat without publishing
    estate-founder-intake --json

The founder never repeats himself (2026-10-29): a prompt is split into sentences, each
classified as objective, constraint, prohibition, proof_demand, correction or context, the
entities are pulled out (issues, files, quoted text, urls), and the whole thing is published
to unified memory so any session can recall it. A prompt that repeats an earlier one is
reported as a repeat: that is a demotion signal for the agent that made him say it twice.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def _governance_path() -> str:
    """Where the governance package lives: this checkout, or the estate's runtime tree."""

    repo_root = os.path.dirname(HERE)
    for cand in (
        os.environ.get("ESTATE_GOVERNANCE_TREE", ""),
        os.path.join(repo_root, "platform", "estate"),
        os.path.join(repo_root, "runtime", "idp", "platform", "estate"),
        os.path.expanduser("~/.estate/runtime/idp/platform/estate"),
    ):
        if cand and os.path.isfile(os.path.join(cand, "governance", "registry.py")):
            return cand
    raise SystemExit("estate: the governance package was not found (set ESTATE_GOVERNANCE_TREE)")


sys.path.insert(0, _governance_path())

from governance import founder_intake  # noqa: E402


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--text", default="")
    ap.add_argument("--file", default="")
    ap.add_argument("--stdin", action="store_true")
    ap.add_argument("--repeat", default="")
    ap.add_argument("--session", default="")
    ap.add_argument("--no-publish", action="store_true")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args(argv[1:])

    if args.repeat:
        hit = founder_intake.find_repeat(args.repeat)
        if args.json:
            print(json.dumps({"repeat": hit}, indent=2, default=str))
        else:
            if hit:
                print(f"REPEAT  similarity={hit['score']:.2f}  {hit['earlier'].get('text','')[:120]}")
            else:
                print("no repeat found")
        return 0 if not hit else 2

    text = args.text
    if args.file:
        with open(args.file, encoding="utf-8") as f:
            text = f.read()
    if args.stdin:
        text = sys.stdin.read()
    if not text.strip():
        ap.error("no prompt given (--text, --file or --stdin)")

    record = founder_intake.intake(
        text, session=args.session, publish_to_memory=not args.no_publish
    )
    if args.json:
        print(json.dumps(record, indent=2, default=str))
    else:
        print(f"fingerprint: {record.get('fingerprint')}")
        print(f"sentences: {len(record.get('sentences', []))}")
        for row in record.get("sentences", []):
            print(f"  [{row.get('kind')}] {row.get('text','')[:100]}")
        entities = record.get("entities") or {}
        for key, values in entities.items():
            if values:
                print(f"  {key}: {', '.join(str(v) for v in values)}")
        if record.get("repeat"):
            print(f"REPEAT: similar to an earlier prompt ({record['repeat'].get('similarity')})")
        print(f"published: {record.get('published')}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
