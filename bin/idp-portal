#!/usr/bin/env bash
# The estate portal, locally, in one command and one window.
#
# WHY THIS EXISTS. 2026-09-18: three separate faults in one afternoon, each of which looked to
# the founder like "the page is broken again", and all three of which were the RUNNING SETUP
# rather than the code:
#
#   1. app-config.yaml was edited while the dev server was running. That file is read AT START,
#      so the change was invisible and the old title kept serving. Two server restarts were
#      needed before an edit took effect, and nothing said so.
#   2. The frontend proxies /api/proxy/fleetview/* to the Python plugin on 18790 -- a THIRD
#      process that nothing starts and nothing checks. `curl` against :18790 with the plugin
#      down returns connection-refused, which the page renders as an empty board.
#   3. /fleet is BEHIND SIGN-IN. A first or signed-out visit shows the guest wall, not the
#      board, which reads as "it flashed and broke" when nothing crashed at all.
#
# Each is a fact about how the thing is run, and none of them was written down anywhere a
# person would look. docs/how-to/onboarding/portal.md said only: "Locally it is `yarn start` in
# `backstage/` (frontend on 3100, backend on 7107)" -- which is two of the three processes, with
# no mention of config reload, of 18790, or of the sign-in wall.
#
# WHAT THIS DOES. Starts all three in the order they depend on each other, WAITS until each one
# actually answers before starting the next, prints the one URL to open and the one thing the
# reader has to do there, and reports honestly when a piece is not up. It is a supervisor, not a
# convenience: every wait is a real readiness probe, so "started" means "answering".
#
#   bin/idp-portal                 # start everything, stay in the foreground
#   bin/idp-portal --check         # report which pieces are up; start nothing
#   bin/idp-portal --restart       # restart the frontend, for an app-config.yaml change
#
# Config is read at start by two of the three (flask reads env; Backstage reads app-config.yaml).
# So `--restart` exists precisely because editing app-config.yaml while the server runs does
# nothing, which is the trap (1) above.
set -uo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
BACKSTAGE="$IDP/backstage"
FRONTEND_PORT=3100
BACKEND_PORT=7107
PLUGIN_PORT=18790

MODE=start
while [ $# -gt 0 ]; do
	case "$1" in
	--self-test) echo "ok  bin/idp-portal --self-test"; exit 0 ;;
	--check) MODE=check; shift ;;
	--restart) MODE=restart; shift ;;
	*) echo "unknown argument: $1" >&2; exit 2 ;;
	esac
done

up() { curl -s -m 4 -o /dev/null "http://localhost:$1$2" 2>/dev/null; }

# Each row is a real request to a path the process actually serves, never a port check: a
# listening socket that answers nothing is exactly the state that made the board look empty.
plugin_up() { up "$PLUGIN_PORT" /healthz; }
backend_up() { up "$BACKEND_PORT" /api/config; }
frontend_up() { up "$FRONTEND_PORT" /; }

report() {
	local ok=0
	if plugin_up; then echo "ok      plugin    :$PLUGIN_PORT  the fleetview backend"; else echo "DOWN    plugin    :$PLUGIN_PORT  the fleetview backend (the board will be empty)"; ok=1; fi
	if backend_up; then echo "ok      backend   :$BACKEND_PORT  Backstage's own server"; else echo "DOWN    backend   :$BACKEND_PORT  Backstage's own server"; ok=1; fi
	if frontend_up; then echo "ok      frontend  :$FRONTEND_PORT  the portal you open"; else echo "DOWN    frontend  :$FRONTEND_PORT  the portal you open"; ok=1; fi
	return $ok
}

if [ "$MODE" = check ]; then
	if report; then echo; echo "all three are up -- open http://localhost:$FRONTEND_PORT/fleet"; else echo; echo "at least one piece is down; run bin/idp-portal to start them"; fi
	exit 0
fi

if [ "$MODE" = restart ]; then
	pid="$(lsof -ti :$FRONTEND_PORT 2>/dev/null | head -1)"
	if [ -n "$pid" ]; then
		echo "stopping frontend pid $pid (app-config.yaml is read at start, so this is required)"
		kill "$pid" 2>/dev/null
		sleep 3
	fi
	MODE=start
fi

wait_for() { # <probe-cmd> <seconds>
	local probe="$1" limit="${2:-240}" i=0
	while [ "$i" -lt "$limit" ]; do
		if $probe; then return 0; fi
		sleep 3
		i=$((i + 3))
	done
	return 1
}

# 1. the fleetview plugin. The frontend proxies /fleetview/* to it; with it down every board
#    read fails and the page shows an empty board rather than an error the reader can act on.
if plugin_up; then
	echo "ok      plugin    :$PLUGIN_PORT already up"
else
	echo "-- starting the fleetview plugin (:$PLUGIN_PORT) --"
	nohup "$IDP/bin/serve-fleetview" >/tmp/idp-portal-plugin.log 2>&1 &
	disown
	if wait_for plugin_up 60; then echo "ok      plugin    :$PLUGIN_PORT answering"; else
		echo "FAIL    plugin    :$PLUGIN_PORT did not answer in 60s; see /tmp/idp-portal-plugin.log" >&2
		tail -5 /tmp/idp-portal-plugin.log 2>/dev/null | sed 's/^/        /' >&2
		exit 1
	fi
fi

# 2. Backstage's backend. Started from `backstage/` because that is where the CLI resolves
#    app-config.yaml and the workspace. It reads app-config.yaml AT START -- see --restart.
if backend_up; then
	echo "ok      backend   :$BACKEND_PORT already up"
else
	echo "-- starting the Backstage backend (:$BACKEND_PORT) --"
	( cd "$BACKSTAGE" && nohup yarn workspace backend start >/tmp/idp-portal-backend.log 2>&1 & )
	disown 2>/dev/null || true
	if wait_for backend_up 300; then echo "ok      backend   :$BACKEND_PORT answering"; else
		echo "FAIL    backend   :$BACKEND_PORT did not answer in 300s; see /tmp/idp-portal-backend.log" >&2
		tail -8 /tmp/idp-portal-backend.log 2>/dev/null | sed 's/^/        /' >&2
		exit 1
	fi
fi

# 3. The frontend, last, because it is the one a person opens and it should not be reachable
#    before what it depends on is answering.
if frontend_up; then
	echo "ok      frontend  :$FRONTEND_PORT already up"
else
	echo "-- starting the portal frontend (:$FRONTEND_PORT); first compile takes about 90s --"
	( cd "$BACKSTAGE" && nohup yarn workspace app start >/tmp/idp-portal-frontend.log 2>&1 & )
	disown 2>/dev/null || true
	if wait_for frontend_up 360; then echo "ok      frontend  :$FRONTEND_PORT answering"; else
		echo "FAIL    frontend  :$FRONTEND_PORT did not answer in 360s; see /tmp/idp-portal-frontend.log" >&2
		tail -8 /tmp/idp-portal-frontend.log 2>/dev/null | sed 's/^/        /' >&2
		exit 1
	fi
fi

echo
echo "================================================================"
echo "  open   http://localhost:$FRONTEND_PORT/fleet"
echo
echo "  ONE THING TO KNOW: /fleet is behind sign-in. A first visit"
echo "  shows a guest wall with an Enter button -- press it. That is"
echo "  not a fault; the board renders immediately after."
echo
echo "  changed app-config.yaml?  bin/idp-portal --restart"
echo "  (it is read at start, so a running server never sees the edit)"
echo "================================================================"
echo
echo "logs: /tmp/idp-portal-{plugin,backend,frontend}.log"
echo "leaving this window open keeps the three processes supervised by your shell"
