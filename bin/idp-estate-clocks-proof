#!/usr/bin/env python3
"""idp-estate-clocks-proof -- Chronos proves it CAN fail, before it is trusted.

WHY A PROOF COMMAND AND NOT A CLAIM. AGENTS.md section 9, R1 and R2: a gate that
cannot fail is not a gate, and no gate in this estate ships without a falsifier
it must reject. bin/idp-estate-clocks returning 0 tells you the clocks delivered;
on its own it does not tell you the script would have noticed if they had not.
This command makes the difference measurable.

HERMETIC ON PURPOSE. Every case pins BOTH the clock (--now) and the history
(--runs-json), so nothing here touches GitHub. The first draft of this proof read
live history and failed because a real clock's last run was 595 minutes old --
a test broken by the weather, not by the detector. A falsifier that depends on
the world it is testing is not a falsifier; it is a hope with an exit code.

THE CASES:

  1. A clock whose newest scheduled run is inside its tolerance -> MEASURED_OK,
     gate exit 0. The known-good it must accept.
  2. The SAME runs, clock advanced past the tolerance -> MISSED_CYCLE, exit 1.
     The falsifier it must reject. Nothing about the input changed; only time
     passed. If this case ever passes while case 1 passes, the gate is a
     constant and this proof has caught it.
  3. A declared schedule with no scheduled run ever -> MISSED_CYCLE with the
     never-fired note, not silence. The ghost: the shape that made this script
     necessary.
  4. History that cannot be read -> BLIND, exit 2, never 0. (The estate's R1
     failure mode is 'cannot judge' = pass; this proves it does not happen here.)
  5. A retired clock -> not graded, gate passes. Retired is a decision.
  6. A declared workflow absent from the tree -> NOT_HERE, exit 1. This case
     found a real bug: the first version printed GONE and still exited 0.
  7. A human-triggered run must not count as delivery. A clock whose only recent
     runs are workflow_dispatch/push is still dead, and the board must say so --
     this is how a dead cron hides behind a busy human.

    bin/idp-estate-clocks-proof        exit 0 when every case holds

Deterministic, model-free, no secrets, no writes, no network.
"""

from __future__ import annotations

import json
import subprocess
import sys
import tempfile
from pathlib import Path

IDP = Path(__file__).resolve().parent.parent
CLOCKS = IDP / "bin" / "idp-estate-clocks"

# A clock that delivered 20 minutes before NOW, with a 60 minute tolerance.
NOW = "2026-11-08T12:00:00Z"
TOLERANCE_MIN = 60
# Four hours later the SAME history is 260 minutes old against a 60 minute
# tolerance. The first draft advanced four hours against a ONE-WEEK tolerance
# and then asserted a miss: that was arithmetic inside the fixture, not a defect
# in the detector, and it is why this file pins its own numbers.
LATER = "2026-11-08T16:00:00Z"

failures: list[str] = []


def check(name: str, ok: bool, detail: str = "") -> None:
    print(f"  {'ok  ' if ok else 'FAIL'}  {name}" + (f"  -- {detail}" if detail and not ok else ""))
    if not ok:
        failures.append(name)


def run_board(registry: Path, now: str, runs: dict | None = None, *extra: str) -> tuple[int, str, str]:
    argv = [sys.executable, str(CLOCKS), "--registry", str(registry), "--now", now, *extra]
    if runs is not None:
        fixture = registry.parent / "runs.json"
        fixture.write_text(json.dumps(runs), encoding="utf-8")
        argv += ["--runs-json", str(fixture)]
    proc = subprocess.run(argv, capture_output=True, text=True)
    return proc.returncode, proc.stdout or "", proc.stderr or ""


def write_registry(tmp: Path, name: str, obligation: dict) -> Path:
    doc = {
        "legion": 3,
        "name": name,
        "repo": "idp",
        "summary": "fixture for bin/idp-estate-clocks-proof; never scheduled",
        "capabilities": ["delivered-cadence-measurement"],
        "modes": ["gh-runner"],
        "budget": {"max_usd_per_day": 0.01},
        "proof": {"command": "true", "max_seconds": 10},
        "slo": {"success_rate_min": 0.98, "p95_latency_s_max": 300},
        "health": {"max_heartbeat_age_minutes": 45},
        "obligations": [obligation],
    }
    path = tmp / f"{name}.json"
    path.write_text(json.dumps(doc), encoding="utf-8")
    return path


def ob(oid: str, workflow: str, **kw) -> dict:
    """One obligation, with the fixture's tolerance unless the case overrides it."""
    base = {
        "id": oid,
        "kind": "github-workflow",
        "workflow": workflow,
        "declares": "*/5 * * * *",
        "declares_human": "every 5 minutes",
        "owner": "estate",
        "evidence": "proof fixture",
        "max_age_minutes": TOLERANCE_MIN,
        "catch_up": "next tick",
        "state": "active",
    }
    base.update(kw)
    return base


SCHEDULED = {"event": "schedule", "created": "2026-11-08T11:40:00Z", "conclusion": "success",
             "url": "https://example.invalid/run/1", "status": "completed"}


def main() -> int:
    print("chronos proof: the detector must fail on the shapes it exists to catch")

    if not CLOCKS.exists():
        print(f"  FAIL  {CLOCKS} is missing")
        return 1
    if not (IDP / ".github" / "workflows" / "ping.yml").exists():
        print("  FAIL  ping.yml is not in the tree; the fixtures name real workflows")
        return 1

    with tempfile.TemporaryDirectory() as raw_tmp:
        tmp = Path(raw_tmp)

        # ---- case 1: the known-good -----------------------------------------
        good = write_registry(tmp, "case1-good", ob("ping", "ping.yml"))
        code, out, err = run_board(good, NOW, {"ping.yml": [SCHEDULED]}, "--gate")
        check(
            "a clock that delivered inside tolerance is MEASURED_OK and the gate passes",
            code == 0 and "ok    ping" in out,
            f"exit={code} {out.strip()[:150]}{err.strip()[:100]}",
        )

        # ---- case 2: the falsifier -- same runs, later clock ----------------
        code, out, err = run_board(good, LATER, {"ping.yml": [SCHEDULED]}, "--gate")
        check(
            "the SAME runs past the tolerance are MISSED_CYCLE and the gate fails",
            code == 1 and "MISS  ping" in out,
            f"exit={code} {out.strip()[:150]}{err.strip()[:100]}",
        )

        # The property behind case 1 and 2, asserted directly: the verdict is a
        # function of elapsed time, so the gate cannot be a constant.
        code_fresh, _, _ = run_board(good, NOW, {"ping.yml": [SCHEDULED]}, "--gate")
        code_late, _, _ = run_board(good, LATER, {"ping.yml": [SCHEDULED]}, "--gate")
        check(
            "identical evidence yields 0 then 1 as time passes, so the gate is not a constant",
            (code_fresh, code_late) == (0, 1),
            f"fresh={code_fresh} late={code_late}",
        )

        # ---- case 3: the ghost -- declared, never fired ---------------------
        ghost = write_registry(tmp, "case3-ghost", ob("ghost", "ping.yml"))
        code, out, err = run_board(ghost, NOW, {"ping.yml": []}, "--gate")
        check(
            "a clock that has never fired is MISSED_CYCLE, not silence",
            code == 1 and "never fired" in out,
            f"exit={code} {out.strip()[:150]}{err.strip()[:100]}",
        )

        # ---- case 4: BLIND must never pass (R1) -----------------------------
        # No --runs-json and an unresolvable repo: the read fails, and a failed
        # read has to be exit 2. This is the case the estate got wrong before.
        blind = write_registry(tmp, "case4-blind", ob("blind", "ping.yml"))
        argv = [sys.executable, str(CLOCKS), "--registry", str(blind), "--now", NOW,
                "--gate", "--repo", "chidionyema/chronos-proof-repo-that-does-not-exist"]
        proc = subprocess.run(argv, capture_output=True, text=True)
        check(
            "when the clock history cannot be read the gate is BLIND (exit 2), never a pass",
            proc.returncode == 2,
            f"exit={proc.returncode} {(proc.stdout + proc.stderr).strip()[:150]}",
        )

        # ---- case 5: retired is a decision, not a miss ----------------------
        retired = write_registry(
            tmp, "case5-retired", ob("old", "ping.yml", state="retired", catch_up="none - retired")
        )
        code, out, err = run_board(retired, NOW, {"ping.yml": []}, "--gate", "--json")
        retired_row = {}
        try:
            retired_row = json.loads(out)["obligations"][0]
        except (json.JSONDecodeError, KeyError, IndexError):
            retired_row = {}
        check(
            "a retired clock is silent on purpose and does not fail the gate",
            code == 0 and retired_row.get("verdict") == "MEASURED_OK"
            and "retired" in str(retired_row.get("note", "")),
            f"exit={code} row={retired_row}",
        )

        # ---- case 6: a vanished workflow is a finding -----------------------
        absent = write_registry(
            tmp, "case6-absent", ob("absent", "this-workflow-is-not-in-the-tree.yml")
        )
        code, out, err = run_board(absent, NOW, {}, "--gate")
        check(
            "a declared workflow absent from the tree is NOT_HERE and fails the gate",
            code == 1 and "GONE" in out,
            f"exit={code} {out.strip()[:150]}{err.strip()[:100]}",
        )

        # ---- case 7: a human-triggered run is not delivery ------------------
        # The workflow is busy on other triggers and its cron is dead. If this
        # case passed, the board would be blind to exactly the shape it exists
        # to catch: a clock that looks alive because a human keeps running it.
        busy = write_registry(tmp, "case7-busy", ob("busy", "ping.yml"))
        human_runs = [
            {"event": "workflow_dispatch", "created": "2026-11-08T11:55:00Z",
             "conclusion": "success", "url": "https://example.invalid/run/9", "status": "completed"},
            {"event": "push", "created": "2026-11-08T11:50:00Z",
             "conclusion": "success", "url": "https://example.invalid/run/8", "status": "completed"},
        ]
        code, out, err = run_board(busy, NOW, {"ping.yml": human_runs}, "--gate")
        check(
            "a clock kept alive only by human triggers is still MISSED_CYCLE",
            code == 1 and "never fired" in out,
            f"exit={code} {out.strip()[:150]}{err.strip()[:100]}",
        )

    print()
    if failures:
        print(f"chronos proof: FAILED ({len(failures)} case(s)): {'; '.join(failures)}")
        print("A gate that cannot fail is not a gate (AGENTS.md R1/R2). Do not ship this detector.")
        return 1
    print(
        "chronos proof: PASS -- accepts a delivered clock, rejects the same evidence once its\n"
        "tolerance lapses, calls a never-fired clock a finding, ignores human-triggered runs as\n"
        "delivery, goes BLIND rather than green when it cannot read history, never grades a\n"
        "retired clock, and fails on a workflow that has vanished from the tree."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
