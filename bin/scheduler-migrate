#!/usr/bin/env python3
"""Migration: launchd jobs -> the Dagster estate scheduler. R19 lifecycle.

  scheduler-migrate can_apply    preconditions only, touches nothing
  scheduler-migrate apply        idempotent: daemon + webserver up, launchd jobs out
  scheduler-migrate healthcheck  every Dagster daemon healthy
  scheduler-migrate rollback     daemon + webserver down, launchd jobs back
  scheduler-migrate state        JSON of the state the other verbs change

Environment (nothing here names a machine, LAW 46):
  DAGSTER_HOME     instance dir, default $IDP/run/dagster
  SCHEDULER_PORT   webserver port, default 3210
  MIGRATE_LAUNCHD  1 (default) moves launchd jobs; 0 leaves launchd alone (CI, Linux)
  MIGRATE_LEDGER   audit file, default $IDP/run/migrations.jsonl

Every apply and rollback appends who, when, git sha, previous state hash and
verification hash to the ledger (R19 step 4). Runbook: docs/migrations/scheduler.md.
"""
import getpass
import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.request

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HOME = os.environ.setdefault("DAGSTER_HOME", os.path.join(IDP, "run", "dagster"))
PORT = int(os.environ.get("SCHEDULER_PORT", "3210"))
LAUNCHD = os.environ.get("MIGRATE_LAUNCHD", "1") == "1" and sys.platform == "darwin"
LEDGER = os.environ.get("MIGRATE_LEDGER", os.path.join(IDP, "run", "migrations.jsonl"))
VENV = os.path.join(IDP, ".venv", "bin")
PY = os.path.join(VENV, "python") if os.path.exists(os.path.join(VENV, "python")) else sys.executable


def exe(name):
    import shutil
    p = os.path.join(VENV, name)
    return p if os.path.exists(p) else (shutil.which(name) or p)


def sh(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def labels():
    import yaml
    j = yaml.safe_load(open(os.path.join(IDP, "scheduler", "schedule.yml")))
    return sorted(j.get("jobs", j))


def loaded():
    if not LAUNCHD:
        return []
    out = sh(["/bin/launchctl", "list"]).stdout
    have = {line.split("\t")[-1].strip() for line in out.splitlines()[1:]}
    return sorted(l for l in labels() if l in have)


def _pid(name):
    """A process is ours only if $DAGSTER_HOME/<name>.pid names it and it is
    still a dagster process. Matching command lines would let a temp-home gate
    run reach the live daemon (it nearly did on 2026-08-24)."""
    f = os.path.join(HOME, f"{name}.pid")
    try:
        pid = int(open(f).read().strip())
        cmd = sh(["ps", "-o", "command=", "-p", str(pid)]).stdout
        return pid if "dagster" in cmd else None
    except (OSError, ValueError):
        return None


def daemon_pid():
    return _pid("daemon")


def web_pid():
    return _pid("web")


def web_up():
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{PORT}/server_info", timeout=3)
        return True
    except Exception:
        return False


def state():
    cfg = os.path.join(HOME, "dagster.yaml")
    return {
        "daemon_running": daemon_pid() is not None,
        "webserver_running": web_pid() is not None,
        "dagster_yaml_sha": hashlib.sha256(open(cfg, "rb").read()).hexdigest()[:12] if os.path.exists(cfg) else None,
        "launchd_loaded": loaded(),
    }


def state_hash(s):
    return hashlib.sha256(json.dumps(s, sort_keys=True).encode()).hexdigest()[:16]


def ledger(verb, before, after):
    os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
    sha = sh(["git", "-C", IDP, "rev-parse", "--short", "HEAD"]).stdout.strip()
    rec = {"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "who": getpass.getuser(),
           "git": sha, "verb": verb, "previous_state": state_hash(before), "verification": state_hash(after),
           "dagster_home": HOME}
    with open(LEDGER, "a") as fh:
        fh.write(json.dumps(rec, sort_keys=True) + "\n")


def can_apply():
    problems = []
    for name in ("dagster-daemon", "dagster-webserver"):
        if not os.path.exists(exe(name)):
            problems.append(f"{name} not installed (pip install dagster dagster-webserver)")
    r = sh([PY, "-c", "import sys; sys.path.insert(0, %r); from estate_scheduler.definitions import defs; print(len(list(defs.jobs)))" % os.path.join(IDP, "scheduler")])
    if r.returncode:
        problems.append("schedule.yml does not load: " + r.stderr.strip().splitlines()[-1] if r.stderr.strip() else "schedule.yml does not load")
    os.makedirs(HOME, exist_ok=True)
    if not os.access(HOME, os.W_OK):
        problems.append(f"{HOME} not writable")
    if web_up() is False and sh(["lsof", "-nP", f"-iTCP:{PORT}", "-sTCP:LISTEN", "-t"]).stdout.strip():
        problems.append(f"port {PORT} held by something that is not the scheduler UI")
    for p in problems:
        print("can_apply  NO  " + p)
    print(f"can_apply  {'no' if problems else 'yes'}  jobs={r.stdout.strip() or '?'} launchd={'on' if LAUNCHD else 'off'} home={HOME}")
    return 1 if problems else 0


def apply():
    before = state()
    os.makedirs(HOME, exist_ok=True)
    src = open(os.path.join(IDP, "scheduler", "dagster.yaml"), "rb").read()
    dst = os.path.join(HOME, "dagster.yaml")
    if not os.path.exists(dst) or open(dst, "rb").read() != src:
        open(dst, "wb").write(src)
    sched = os.path.join(IDP, "scheduler")
    env = dict(os.environ, DAGSTER_HOME=HOME)
    # Create the SQLite storage once, before any process starts. Daemon and
    # webserver initialising a fresh home concurrently raced the alembic stamp
    # ("more than one head", CI 2026-08-24).
    r = sh([PY, "-c", "from dagster import DagsterInstance; DagsterInstance.get().get_daemon_statuses()"], env=env)
    if r.returncode:
        print("apply      FAIL instance init: " + (r.stderr.strip().splitlines() or ["?"])[-1])
        return 1
    if daemon_pid() is None:
        pr = subprocess.Popen([exe("dagster-daemon"), "run", "-w", os.path.join(sched, "workspace.yaml")],
                              cwd=sched, env=env, stdout=open(os.path.join(HOME, "daemon.out"), "ab"),
                              stderr=subprocess.STDOUT, start_new_session=True)
        open(os.path.join(HOME, "daemon.pid"), "w").write(str(pr.pid))
        print("apply      daemon    started")
    else:
        print("apply      daemon    already running")
    if web_pid() is None:
        pr = subprocess.Popen([exe("dagster-webserver"), "-w", os.path.join(sched, "workspace.yaml"), "-h", "127.0.0.1", "-p", str(PORT)],
                              cwd=sched, env=env, stdout=open(os.path.join(HOME, "web.out"), "ab"),
                              stderr=subprocess.STDOUT, start_new_session=True)
        open(os.path.join(HOME, "web.pid"), "w").write(str(pr.pid))
        print(f"apply      webserver started on {PORT}")
    else:
        print(f"apply      webserver already up on {PORT}")
    moved = 0
    for l in loaded():
        if sh(["/bin/launchctl", "bootout", f"gui/{os.getuid()}/{l}"]).returncode == 0:
            moved += 1
    print(f"apply      launchd   {moved} jobs booted out ({'skipped' if not LAUNCHD else 'checked'})")
    after = state()
    ledger("apply", before, after)
    return 0


def healthcheck(wait=int(os.environ.get("MIGRATE_HEALTH_WAIT", "90"))):
    deadline = time.time() + wait
    code = ""
    while time.time() < deadline:
        r = sh([PY, "-c", "import os; from dagster import DagsterInstance; i=DagsterInstance.get(); s=i.get_daemon_statuses(); "
                          "bad=[k for k,v in s.items() if not v.healthy]; print(','.join(bad) or 'healthy')"], env=dict(os.environ, DAGSTER_HOME=HOME))
        code = (r.stdout.strip() or r.stderr.strip().splitlines()[-1:] or ["?"])[-1] if r.returncode else r.stdout.strip()
        if code == "healthy" and web_up():
            print(f"healthcheck ok   daemons healthy, webserver {PORT} up")
            return 0
        time.sleep(5)
    print(f"healthcheck FAIL {code}; webserver_up={web_up()}")
    return 1


def rollback():
    before = state()
    for name in ("daemon", "web"):
        pid = _pid(name)
        if pid:
            os.kill(pid, 15)
    for _ in range(40):
        if daemon_pid() is None and web_pid() is None:
            break
        time.sleep(0.5)
    # A process that ignored SIGTERM (mid-startup, 2026-08-24) is killed, never
    # forgotten: dropping its pidfile while it lives orphans the port for the next run.
    for name in ("daemon", "web"):
        pid = _pid(name)
        if pid:
            os.kill(pid, 9)
            for _ in range(20):
                if _pid(name) is None:
                    break
                time.sleep(0.25)
        if _pid(name) is None:
            try:
                os.remove(os.path.join(HOME, f"{name}.pid"))
            except OSError:
                pass
    back = 0
    if LAUNCHD:
        for l in labels():
            plist = os.path.expanduser(f"~/Library/LaunchAgents/{l}.plist")
            if os.path.exists(plist) and l not in loaded():
                if sh(["/bin/launchctl", "bootstrap", f"gui/{os.getuid()}", plist]).returncode == 0:
                    back += 1
    print(f"rollback   daemon={'down' if daemon_pid() is None else 'STILL UP'} webserver={'down' if web_pid() is None else 'STILL UP'} launchd {back} jobs back")
    after = state()
    ledger("rollback", before, after)
    return 0 if daemon_pid() is None and web_pid() is None else 1


VERBS = {"can_apply": can_apply, "apply": apply, "healthcheck": healthcheck, "rollback": rollback,
         "state": lambda: print(json.dumps(state(), sort_keys=True)) or 0}
if __name__ == "__main__":
    verb = sys.argv[1] if len(sys.argv) > 1 else ""
    if verb not in VERBS:
        print(__doc__)
        sys.exit(2)
    sys.exit(VERBS[verb]())
