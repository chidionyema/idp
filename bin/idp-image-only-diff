#!/usr/bin/env python3
"""Is this pull request nothing but an image tag the automation wrote? (idp#1046)

WHY IT EXISTS. Founder, 2026-08-31, choosing between two readings of his own release rule:
shipping code he already approved when he merged it is not a second release. So the deploy pull
request from `flux/image-updates` lands on its own, while a change to platform *content* still
waits for his word.

That distinction is only safe if it can be proved rather than assumed. The deploy branch is written
by the image-automation-controller, but it is a normal branch: anything pushed to it would ride to
main under the same automatic merge. This is the proof. A pull request passes only when every
single changed line is a `newTag:` line carrying the controller's own `$imagepolicy` marker, and
the marker on the removed line is the same policy as the marker on the added one. One line of
anything else -- a manifest edit, a replica count, a new file, a deleted one -- and it is refused
and waits for the founder like any other platform change.

  bin/idp-image-only-diff --pr N        ask GitHub for the diff
  bin/idp-image-only-diff --diff FILE   grade a diff already on disk (tests, and a dry run)

`ok|FAIL  image-only  <why>`; exit 0 image tags only, 1 anything else, 2 BLIND (no diff to read --
an empty answer is never treated as an empty diff).
"""

import argparse
import re
import subprocess
import sys

TAG_LINE = re.compile(
    r'^\s*newTag:\s*(?P<tag>\S+)\s*#\s*\{"\$imagepolicy":\s*"(?P<policy>[^"]+)"\s*\}\s*$'
)
# File headers and hunk headers carry + and - but are not content.
HEADER = ("+++", "---")


def grade(diff: str):
    """(ok, reason). Every changed line must be an automation-owned tag line."""
    if not diff.strip():
        return (
            None,
            "the diff came back empty; a pull request with no diff is not an image bump",
        )

    removed, added, files = [], [], set()
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            files.add(line.split(" b/")[-1])
            continue
        if (
            line.startswith(HEADER)
            or line.startswith("@@")
            or line.startswith("index ")
        ):
            continue
        if line.startswith("new file mode") or line.startswith("deleted file mode"):
            return (
                False,
                f"adds or deletes a file, which no image bump does: {line.strip()}",
            )
        if not line.startswith(("+", "-")):
            continue
        body, bucket = line[1:], added if line.startswith("+") else removed
        m = TAG_LINE.match(body)
        if not m:
            return False, (
                f"changes a line that is not an automation-owned image tag, in "
                f"{sorted(files)[-1] if files else 'the diff'}: {body.strip()[:90]!r}"
            )
        bucket.append(m.group("policy"))

    if not added:
        return False, "changes nothing; there is no tag to ship"
    if sorted(added) != sorted(removed):
        return False, (
            f"rewrites which policy owns a line, not just its tag: "
            f"{sorted(removed)} -> {sorted(added)}"
        )
    return (
        True,
        f"{len(added)} image tag line(s) in {len(files)} file(s), and nothing else",
    )


def main(argv):
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--pr")
    g.add_argument("--diff")
    a = ap.parse_args(argv)

    if a.diff:
        diff = open(a.diff, encoding="utf-8").read()
    else:
        p = subprocess.run(
            ["gh", "pr", "diff", a.pr], capture_output=True, text=True, timeout=120
        )
        if p.returncode != 0:
            print(
                f"BLIND   image-only  cannot read the diff of #{a.pr}: "
                f"{(p.stderr or p.stdout).strip()[:120]}"
            )
            return 2
        diff = p.stdout

    ok, why = grade(diff)
    if ok is None:
        print(f"BLIND   image-only  {why}")
        return 2
    print(f"{'ok     ' if ok else 'FAIL   '} image-only  {why}")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
