#!/usr/bin/env bash
# Start Agentgateway and the two MCP servers behind it. Safe to run repeatedly.
#
# Standard: bin/litellm-up's shape, deliberately -- validate the config the service will
# refuse, build a 600 .env nothing prints, `compose up -d`, then prove it answers.
# Rejected: `docker compose up` typed by hand, because it skips the validation below and
# the founder does not run scripts with six flags (LAW 31).
#
# SECRETS. mcp/.env, mode 600, gitignored, never printed (LAW 21).
#   MCP_GATEWAY_KEY   generated once with openssl; every agent presents it as a bearer.
#   GITHUB_MCP_TOKEN  read from the age vault. If the vault has no GITHUB_MCP_TOKEN, the
#                     value is written as "missing" and the github route answers 400 until one
#                     is added -- this script never invents one. An operator may pass one
#                     in the environment for a single run: GITHUB_MCP_TOKEN=... bin/mcp-up.
set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
MCP="$IDP/mcp"
ENVF="$MCP/.env"
AGE_BLOB="${AGE_BLOB:-$(dirname "$IDP")/prospector-main/deploy/secrets.env.age}"   # sibling checkout; migration source until the sops vault lands
AGE_ID="$HOME/.config/prospector/age-key.txt"
COMPOSE=(docker compose --env-file "$ENVF" -f "$MCP/agentgateway.yml")
GATEWAY="http://127.0.0.1:3310"

log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

command -v docker >/dev/null || { echo "docker is not installed"; exit 2; }
docker info >/dev/null 2>&1 || {
  echo "FAIL  the docker daemon is not reachable, so nothing can start."
  echo "      context: $(docker context show 2>/dev/null)"
  echo "      This is an outage to route, not a thing to restart blindly (crew#85)."
  exit 2
}
[ -r "$IDP/catalog/estate.db" ] || { echo "FAIL  $IDP/catalog/estate.db is missing -- bin/idp-up builds it"; exit 2; }
[ -r "$IDP/catalog/catalog-info.yaml" ] || { echo "FAIL  $IDP/catalog/catalog-info.yaml is missing -- bin/idp-up builds it"; exit 2; }
# crew#216 CP1: get_estate_inventory reads the hourly snapshot from the sibling crew
# checkout (the same "sibling checkout" assumption AGE_BLOB above already makes). A
# missing bind-mount source becomes an empty directory inside the container, not an
# error (docker-mounts-home-only-bind-becomes-dir, same class): caught here instead.
STATE_MD_HOST="${ESTATE_STATE_MD_HOST_PATH:-$(dirname "$IDP")/crew/STATE.md}"
[ -r "$STATE_MD_HOST" ] || { echo "FAIL  $STATE_MD_HOST is missing -- scripts/estate-snapshot (crew repo) builds it, or set ESTATE_STATE_MD_HOST_PATH"; exit 2; }
# A source the VM cannot see mounts as an empty directory, silently (2026-08-25: a
# worktree under /private/tmp took the stack down). Refuse before compose runs.
"$IDP/bin/vm-shared-path" "$IDP" "$STATE_MD_HOST" "${ESTATE_CATALOG_HOST_PATH:-$IDP/catalog/catalog-info.yaml}" || exit 2

# Validate the config the service will refuse to start without (same class as the
# ClickHouse XML and the LiteLLM YAML: a config never checked before its reader starts).
CFG="$MCP/agentgateway.yaml"
if python3 -c 'import yaml' >/dev/null 2>&1; then
  if ! python3 -c "import sys,yaml; yaml.safe_load(open(sys.argv[1]))" "$CFG" 2>/tmp/mcp-yaml.$$; then
    echo "FAIL  $CFG is not valid YAML, so agentgateway would refuse it and exit:"
    sed 's/^/        /' /tmp/mcp-yaml.$$
    rm -f /tmp/mcp-yaml.$$
    exit 2
  fi
  rm -f /tmp/mcp-yaml.$$
  log "agentgateway.yaml is valid YAML"
else
  log "BLIND  pyyaml is not importable, so $CFG was NOT validated"
fi

# --- secrets ------------------------------------------------------------------
umask 077
if [ ! -f "$ENVF" ]; then
  token="${GITHUB_MCP_TOKEN:-}"
  if [ -z "$token" ]; then
    if [ -r "$AGE_BLOB" ] && [ -r "$AGE_ID" ] && command -v age >/dev/null; then
      token=$(age -d -i "$AGE_ID" "$AGE_BLOB" | grep -m1 '^GITHUB_MCP_TOKEN=' | cut -d= -f2- || true)
    else
      log "no age vault readable at $AGE_BLOB; GITHUB_MCP_TOKEN left empty"
    fi
  fi
  # An empty token expands to a YAML null in agentgateway.yaml, and agentgateway then
  # refuses the whole config -- which would take the estate route down with it. The word
  # "missing" is not a credential: github-mcp-server rejects it as badly formatted (400),
  # and mcp-status reports that as FAIL.
  {
    echo "# Generated by bin/mcp-up. Never commit. Never print."
    echo "MCP_GATEWAY_KEY=mcp-$(openssl rand -hex 24)"
    echo "GITHUB_MCP_TOKEN=${token:-missing}"
  } > "$ENVF"
  chmod 600 "$ENVF"
  log "wrote $ENVF (mode 600, gitignored, never printed)"
else
  log "$ENVF exists, reusing it"
fi
if grep -q '^GITHUB_MCP_TOKEN=.' "$ENVF" && ! grep -q '^GITHUB_MCP_TOKEN=missing$' "$ENVF"; then
  log "GITHUB_MCP_TOKEN    present"
else
  log "GITHUB_MCP_TOKEN    MISSING - the github route will answer 400 until the vault holds one"
fi

log "starting"
"${COMPOSE[@]}" up -d --build --remove-orphans

log "waiting for the gateway to answer"
key=$(grep -m1 '^MCP_GATEWAY_KEY=' "$ENVF" | cut -d= -f2-)
for _ in $(seq 1 40); do
  code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 5 \
    -H "Authorization: Bearer $key" -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"mcp-up","version":"0"}}}' \
    "$GATEWAY/estate/mcp" 2>/dev/null || true)
  if [ "$code" = "200" ]; then
    log "up: $GATEWAY/{github,estate}/mcp  (bin/mcp-status for the round-trip per backend)"
    exit 0
  fi
  sleep 3
done

echo "FAIL  the gateway did not answer on 127.0.0.1:3310 within 120s."
echo "      $("${COMPOSE[@]}" ps --format '{{.Name}} {{.State}} {{.Status}}' 2>/dev/null | tr '\n' '; ')"
exit 1
