#!/usr/bin/env bash
# Does the cluster read the vault? A runner has no kube path (bin/idp-oke-rebuild: flux row is n/a),
# so when llm./langfuse. stay unpublished nobody can tell whether external-secrets is talking to the
# vault at all (crew#325, 2026-08-26: 404 on the gateway for 30+ minutes, no instrument). OCI Audit
# records every GetSecretBundle* call with the principal that made it; that is the same fact from
# the vault's door. Needs `read audit-events` (platform/oci/policy/estate-operators.statements.json).
#   ok      vault-reads  12 GetSecretBundle call(s) in 90 min by 1 principal(s): oke-workers; last 20:41Z
#   FAIL    vault-reads  0 GetSecretBundle calls in 90 min: external-secrets is not reading the vault
#   BLIND   vault-reads  audit event list failed ...
# Usage: idp-vault-reads [<minutes>]   env: OCI_COMPARTMENT_OCID
set -u
C=${OCI_COMPARTMENT_OCID:?OCI_COMPARTMENT_OCID}
M=${1:-90}
start=$(date -u -v-"${M}"M +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "$M minutes ago" +%Y-%m-%dT%H:%M:%SZ)
end=$(date -u +%Y-%m-%dT%H:%M:%SZ)
out=$(oci audit event list --compartment-id "$C" --start-time "$start" --end-time "$end" --all --output json 2>&1) || {
  echo "BLIND   vault-reads  audit event list failed: $(printf '%s' "$out" | grep -iE 'error|message|NotAuthorized' | head -1 | cut -c1-120)"; exit 2; }
summary=$(printf '%s' "$out" | python3 -c '
import sys, json
d = json.load(sys.stdin)
rows = d.get("data", d) if isinstance(d, dict) else d
hits = [e for e in rows if "GetSecretBundle" in str((e.get("data") or {}).get("event-name", e.get("event-name", "")))]
who = sorted({str(((e.get("data") or {}).get("identity") or {}).get("principal-name") or "?") for e in hits})
last = max((e.get("event-time", "") for e in hits), default="")
print(len(hits), ",".join(who) or "-", (last[11:16] + "Z") if last else "-")
') || { echo "BLIND   vault-reads  audit output unreadable"; exit 2; }
set -- $summary
n=$1; who=$2; last=$3
if [ "$n" -gt 0 ]; then
  echo "ok      vault-reads  $n GetSecretBundle call(s) in $M min by $(printf '%s' "$who" | tr ',' '\n' | grep -c .) principal(s): $who; last $last"
else
  echo "FAIL    vault-reads  0 GetSecretBundle calls in $M min: external-secrets is not reading the vault (ClusterSecretStore estate-vault auth or OCI_VAULT_ID in estate-vars)"; exit 1
fi
