#!/bin/sh
# Laptop-only maintenance fallback. Never a production or cloud dependency.
#
# WHY THIS FILE IS TRACKED (2026-11-11): it was not, and that is how a retired guardian kept
# running for 21h58m. The resident disk guardian was retired on `main` in three places -- the
# program, its launchd template and its cleaner all became tombstones. `main` was right. But this
# loop lived only in `~/.estate/bin`, so it was invisible to `estate-runtime-sync`, invisible to
# review, and it re-ran the STALE `~/.estate/bin/idp-disk-watch` (22 lines, no disable check) every
# 60 seconds. That stale copy took a 45-second cleanup budget per cycle and held the executor's
# 1500 MB floor closed against every command -- including the `launchctl bootout` and the `rm` that
# would have retired it. A disabled guard that cannot be switched off by the doors it guards is
# the circle the founder forbade.
#
# TWO RULES THIS FILE NOW OBEYS:
#
# 1. A tombstoned program is never run. Before starting the watch, `looks_disabled` reads the
#    program's own head for the estate's tombstone marker. If it is retired, this loop refuses
#    instead of running it. A disable expressed only as "the new file exits 1" cannot stop an old
#    file that is already installed, so the caller has to check.
#
# 2. `stop` stops. The previous handler was `trap 'rm -f "$STATE"' EXIT INT TERM`, which removed
#    the pidfile and let `while :` keep going: `stop` printed `stopped` and the daemon was still
#    alive afterwards. A TERM that does not stop the thing is worse than no TERM, because it
#    reports success. The handler now sets `stopping=1` and exits.
set -u
SELF=$0
STATE=${ESTATE_LOCAL_MAINT_STATE:-$HOME/.estate/run/local-maintenance.pid}
LOG=${ESTATE_LOCAL_MAINT_LOG:-$HOME/.estate/local-maintenance.log}
WATCH=${ESTATE_LOCAL_MAINT_WATCH:-$HOME/.estate/bin/idp-disk-watch}
INTERVAL=${ESTATE_LOCAL_MAINT_INTERVAL_S:-60}
HEARTBEAT=${DISK_WATCH_HEARTBEAT:-$HOME/.estate/heartbeats/disk-guardian.json}

alive() {
  [ -s "$STATE" ] || return 1
  pid=$(cat "$STATE" 2>/dev/null || true)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# A recent heartbeat is NOT proof of a healthy guard: the stale guardian wrote one every cycle
# while doing nothing but holding the disk floor closed. It is kept only as a fallback witness
# for a loop started before this file kept a pidfile.
recent() {
  [ -f "$HEARTBEAT" ] && [ -n "$(find "$HEARTBEAT" -mmin -3 -print 2>/dev/null | head -1)" ]
}

# Rule 1: never run a program the estate has retired. The tombstone marker is the same string the
# estate's own tombstones print, so one shape is recognised anywhere.
looks_disabled() {
  [ -f "$WATCH" ] || return 0
  head -40 "$WATCH" 2>/dev/null | grep -qi "DISABLED .*founder order" && return 0
  return 1
}

run() {
  echo "$$" >"$STATE"
  stopping=0
  trap 'stopping=1' INT TERM
  trap 'rm -f "$STATE"' EXIT
  while [ "$stopping" -eq 0 ]; do
    started=$(date +%s)
    if looks_disabled; then
      echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) refused: $WATCH is retired; not running it"
      break
    fi
    "$WATCH" >>"$LOG" 2>&1 || true
    elapsed=$(( $(date +%s) - started ))
    left=$((INTERVAL - elapsed))
    [ "$left" -gt 0 ] || left=1
    # Sleep in a way a TERM can interrupt: `sleep` in the background plus `wait` returns on signal.
    sleep "$left" &
    wait $! 2>/dev/null || true
  done
  echo "stopped"
}

case "${1:-status}" in
  start)
    if looks_disabled; then
      echo "refused: $WATCH is retired 2026-11-11 by founder order; no resident disk guardian is installed" >&2
      exit 1
    fi
    if alive; then echo "running pid=$(cat "$STATE" 2>/dev/null)"; exit 0; fi
    mkdir -p "${STATE%/*}" "${LOG%/*}"
    /Library/Frameworks/Python.framework/Versions/3.12/bin/python3 - "$SELF" "$LOG" <<'PY'
import subprocess
import sys

with open(sys.argv[2], "ab", buffering=0) as log:
    child = subprocess.Popen(
        [sys.argv[1], "run"],
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        close_fds=True,
    )
print(f"started pid={child.pid}")
PY
    ;;
  stop)
    if alive; then
      pid=$(cat "$STATE")
      kill -TERM "$pid" 2>/dev/null || true
      n=0
      while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 20 ]; do
        sleep 0.2
        n=$((n + 1))
      done
      if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid" 2>/dev/null || true
        echo "stopped pid=$pid (escalated: it did not honour TERM)"
      else
        echo "stopped pid=$pid"
      fi
    else
      echo "stopped"
    fi
    rm -f "$STATE"
    ;;
  run) run ;;
  once) "$WATCH" ;;
  status)
    if looks_disabled; then echo "refused: watch is retired"; exit 1; fi
    if alive; then echo "running pid=$(cat "$STATE" 2>/dev/null)"; else echo stopped; exit 1; fi
    ;;
  *) echo "usage: estate-local-maintenance start|stop|status|once" >&2; exit 2 ;;
esac
