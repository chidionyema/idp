#!/usr/bin/env python3
"""Every dispatched job, with what it was asked to do and how it ended.

WHY THIS PAGE EXISTS. The dispatch tool deliberately cannot report when a job finishes -- that is
what makes a turn end and stops a session re-sending its history while it waits. But work nobody
can see is work nobody can trust, so the outcome has to land somewhere. It lands here: the same
ledger `dispatch_job` appends to, rendered as catalog entities the estate's own portal already
knows how to show.

MEASURED, 2026-09-13, why the boundary was needed: one session held 1,727,322 tokens across 7,594
messages and re-sent all of it on every turn -- 177,570 tokens per call, 56 calls in six minutes,
against one key at 83% of its budget. Every one of those calls belonged to an open turn.

THE PAGE READS FILES, NOT PROCESSES. A job's state is its log file's presence and its last line;
it never asks a running process anything, so opening this page cannot block on a job that is
still going. The same rule the tool follows.

A JOB WITH NO LOG IS REPORTED AS SUCH, never as successful. On this estate the failure that
mattered most was a checker that could not see reporting a clean bill.
"""

from __future__ import annotations

import argparse
import json
import pathlib
import sys

DEFAULT_LEDGER = pathlib.Path.home() / ".estate" / "dispatch" / "jobs.jsonl"
# Its own file, NOT folded into backstage/platform/catalog-info.yaml: that one is GENERATED by
# bin/catalog-platform and holds 107 YAML documents, so writing a List into it would corrupt the
# generator's output and be overwritten by its next run. This file is registered as its own
# catalog location in backstage/app-config.yaml, the same door the estate and org catalogs use.
OUT = pathlib.Path("backstage/platform/jobs.catalog-info.yaml")


def rows(ledger: pathlib.Path) -> list[dict]:
    """Read the ledger. Newest first, because that is the one a person is looking for."""
    if not ledger.is_file():
        return []
    out: list[dict] = []
    for line in ledger.read_text(encoding="utf-8", errors="ignore").splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            out.append(json.loads(line))
        except ValueError:
            continue
    out.sort(key=lambda r: r.get("at") or "", reverse=True)
    return out


def state_of(job: dict) -> str:
    """finished / still running / no output recorded.

    The third state is not decoration. A job that wrote nothing is indistinguishable from a job
    that never started, and calling that finished is how a silent failure reads as a success.

    WHERE THE EXIT ACTUALLY IS. `run` writes the command's output to <id>.log and its exit code to
    a separate <id>.exit file -- the log's last line carries no exit. An earlier version of this
    read the log for the word "exited", which was true of a test fixture and false of every real
    job, so a job that finished cleanly was reported as still running. Caught by dispatching a
    real one.
    """
    log = pathlib.Path(job.get("log") or "")
    if not log.is_file():
        return "no output recorded"
    try:
        text = log.read_text(encoding="utf-8", errors="ignore").strip()
    except OSError:
        return "log unreadable"

    exit_file = log.with_suffix(".exit")
    if exit_file.is_file():
        try:
            code = exit_file.read_text(encoding="utf-8").strip()
        except OSError:
            return "log unreadable"
        if code == "0":
            return "exited 0"
        return f"FAILED, exited {code} (see {log})"

    if not text:
        return "started, nothing written yet"
    return "still running"


def entity(job: dict) -> dict:
    jid = job.get("id") or "unnamed"
    state = state_of(job)
    return {
        "apiVersion": "backstage.io/v1alpha1",
        "kind": "Component",
        "metadata": {
            "name": f"job-{jid}".lower().replace("_", "-")[:63],
            "title": job.get("task") or jid,
            # No `cwd` and no raw `command` here, deliberately. Both are machine-local prose --
            # an absolute checkout path, a /tmp scratch file, the shape of whatever an agent
            # typed -- and this dict is written into catalog-info.yaml, which is committed. The
            # hardcode scan caught exactly that on 2026-09-13, when a proof run's own checkout
            # path reached the description. Where and how a job ran are not catalogue facts
            # (LAW 46); WHAT it was for is, and that is already the title.
            "description": (
                f"{state}. Dispatched {job.get('at', 'unknown')}. "
                f"Task: {job.get('task', '')}"
            ),
            "annotations": {"idp.internal/dispatch-id": jid},
            "tags": ["dispatched-job"],
        },
        "spec": {
            "type": "job",
            "lifecycle": "production" if "exited 0" in state else "experimental",
            "owner": "platform-team",
            "system": "estate",
        },
    }


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--ledger", default=str(DEFAULT_LEDGER))
    ap.add_argument("--out", default=str(OUT))
    ap.add_argument(
        "--check",
        action="store_true",
        help="write nothing; fail if the file on disk differs from what would be written",
    )
    args = ap.parse_args()

    jobs = rows(pathlib.Path(args.ledger))
    doc: dict = {"apiVersion": "v1", "kind": "List", "items": [entity(j) for j in jobs]}
    import yaml

    rendered = yaml.safe_dump(doc, sort_keys=False, width=1000, allow_unicode=True)

    out = pathlib.Path(args.out)
    if args.check:
        current = out.read_text(encoding="utf-8") if out.is_file() else ""
        if current != rendered:
            print(
                f"FAIL  jobs-page: {out} is not what the ledger produces. "
                f"Run bin/idp-jobs-page to regenerate.",
                file=sys.stderr,
            )
            return 1
        print(f"ok    jobs-page   {len(jobs)} job(s), the page matches the ledger")
        return 0

    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(rendered, encoding="utf-8")
    if not jobs:
        print(
            f"ok    jobs-page   0 jobs in {args.ledger} -- the page is empty because nothing has "
            f"been dispatched, not because the reader is broken"
        )
    else:
        finished = sum(1 for j in jobs if "exited 0" in state_of(j))
        print(f"ok    jobs-page   {len(jobs)} job(s), {finished} exited 0")
    return 0


if __name__ == "__main__":
    sys.exit(main())
