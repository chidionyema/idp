#!/usr/bin/env python3
"""Refuse a namespace that is born without its fences.

crew#191. The founder's words, 2026-08-24: "Apply a Default Deny All
NetworkPolicy to every namespace" and "Apply strict ResourceQuota and LimitRange
rules to data-ops so a runaway pipeline cannot starve the cluster's brain".

Measured on the `estate` cluster before any of this existed: a pod in one
namespace curled a pod in another by IP, with no credential, HTTP 200 in 4ms.
That is the lateral backdoor, and it is the default state of every namespace
anyone creates.

Four things are checked, and every one of them is checked against the object
itself rather than against a name, a label or a comment:

  1. Every Namespace has a ResourceQuota.
  2. Every Namespace has a LimitRange -- and this is checked *because of* rule 1,
     not alongside it. A ResourceQuota counting requests.cpu makes a pod that
     declares no cpu request UNSCHEDULABLE, refused with "must specify
     limits.cpu". The LimitRange supplies the numbers first. Quota without
     LimitRange is a fence that refuses correct work, which is the outage
     (LAW 38), so a quota with no LimitRange is a defect and not a partial win.
  3. Every Namespace has a NetworkPolicy that selects ALL pods (`podSelector:
     {}`) and denies both directions. A policy that selects some pods by label
     is an allow rule, not a default; the deny has to be the floor.
  4. A namespace that denies Egress has an explicit DNS exception on port 53.
     Without it, name resolution fails in every pod, and the symptom is not
     "blocked" -- it is a five-second timeout on every outbound call, which
     reads as the application being slow. This is the rule that gets forgotten,
     so it is the rule with a gate.

Two modes. The default reads manifests, because manifests are what ArgoCD
applies and what a reviewer sees. `--live` reads the cluster, because a manifest
that is correct and not applied protects nothing. Neither replaces the other and
`bin/idp-ci` runs the first; the second runs when a cluster is reachable, and
says BLIND rather than PASS when it is not (a guard that loses its evidence
reports BLIND, never a verdict).
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.exit("ns-fence-gate needs PyYAML: python3 -m pip install pyyaml")

SYSTEM_NAMESPACES = {"kube-system", "kube-public", "kube-node-lease", "default"}

# The record bin/idp-ns-fence-gen keeps of what the cluster actually holds. That generator refuses
# to write a quota for a namespace the cluster does not have, because a ResourceQuota addressed to
# a namespace that does not exist fails the whole Kustomization and takes every other fence with
# it (idp#1558). This gate has to draw the same line or the two halves disagree: measured
# 2026-09-05, main's offline-gate failed on commerce, demo-sandbox and tigera-operator -- three
# namespaces declared in git, all of them merged deliberately switched off, none of them on the
# cluster, and every one of them correctly skipped by the generator. A namespace listed here and
# unfenced is still a defect; a namespace not listed here has nothing to fence yet, and is fenced
# on the generator's next run once whatever owns it has created it.
LIVE_RECORD = "platform/ns-fences/live-namespaces.txt"


def grading_the_estate(path: str) -> bool:
    """True when the path being read is this repository's own platform/ tree, not a fixture."""
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    target = os.path.abspath(path)
    platform = os.path.join(root, "platform")
    return target == platform or target.startswith(platform + os.sep)


def live_namespaces() -> set[str] | None:
    """What the cluster holds, per the generator's record, or None when there is no record."""
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    path = os.path.join(root, LIVE_RECORD)
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as fh:
        names = {n.strip() for n in fh if n.strip() and not n.lstrip().startswith("#")}
    return names or None


def load_manifests(path: str) -> list[dict]:
    """Every YAML document under `path`, whether it is a file or a directory."""
    files: list[str] = []
    if os.path.isdir(path):
        for root, _dirs, names in os.walk(path):
            files += [
                os.path.join(root, n)
                for n in sorted(names)
                if n.endswith((".yaml", ".yml")) and n != "kustomization.yaml"
            ]
    else:
        files = [path]

    docs: list[dict] = []
    for f in sorted(files):
        with open(f, encoding="utf-8") as fh:
            for doc in yaml.safe_load_all(fh):
                if isinstance(doc, dict) and doc.get("kind"):
                    doc["__file"] = f
                    docs.append(doc)
    return docs


def namespace_of(doc: dict) -> str | None:
    if doc.get("kind") == "Namespace":
        return doc.get("metadata", {}).get("name")
    return doc.get("metadata", {}).get("namespace")


def denies_everything(np: dict) -> tuple[bool, bool]:
    """(sets_ingress_floor, sets_egress_floor) for one policy.

    In Kubernetes the floor is set by *selection*, not by emptiness: the moment a
    policy selects a pod and names a direction in policyTypes, that direction is
    denied for that pod except for the rules the policy itself lists. So a policy
    with `podSelector: {}`, `policyTypes: [Egress]` and a single DNS rule is a
    default egress deny with one hole in it, and reading it as "not a deny"
    because its egress list is non-empty makes this gate refuse a namespace that
    is correctly fenced -- a guard that refuses correct work is the outage
    (LAW 38). I wrote it that way first and the fixture caught it.

    What does disqualify a policy is the selector. `podSelector` matching a label
    is somebody's allow rule for some pods; every pod without that label is
    unprotected, so it cannot be the floor however it is named.
    """
    spec = np.get("spec") or {}
    selector = spec.get("podSelector")
    if selector is None or selector != {}:
        return (False, False)
    types = spec.get("policyTypes") or []
    return ("Ingress" in types, "Egress" in types)


def allows_dns(np: dict) -> bool:
    """True if this policy lets pods reach a DNS server on port 53."""
    spec = np.get("spec") or {}
    if "Egress" not in (spec.get("policyTypes") or []):
        return False
    for rule in spec.get("egress") or []:
        for port in rule.get("ports") or []:
            # A rule with no ports at all opens every port, 53 included.
            if str(port.get("port")) == "53":
                return True
        if not rule.get("ports"):
            return True
    return False


def check(docs: list[dict], source: str, live: set[str] | None = None) -> list[str]:
    """Every defect, as a sentence naming the namespace and what is missing.

    `live` is the set of namespaces the cluster holds. When it is given, a namespace declared in
    git and absent from the cluster is skipped rather than failed -- see LIVE_RECORD above. It is
    never given in --live mode, where every namespace read is by definition on the cluster.
    """
    namespaces = {
        d["metadata"]["name"]: d
        for d in docs
        if d.get("kind") == "Namespace" and d.get("metadata", {}).get("name")
    }
    if not namespaces:
        return [f"{source}: no Namespace object found -- nothing to check, "
                "which is not the same as nothing wrong"]

    by_ns: dict[str, list[dict]] = {n: [] for n in namespaces}
    for d in docs:
        ns = namespace_of(d)
        if ns in by_ns and d.get("kind") != "Namespace":
            by_ns[ns].append(d)

    problems: list[str] = []
    for ns in sorted(namespaces):
        if ns in SYSTEM_NAMESPACES:
            continue
        if live is not None and ns not in live:
            continue
        kinds = [d.get("kind") for d in by_ns[ns]]
        nps = [d for d in by_ns[ns] if d.get("kind") == "NetworkPolicy"]

        if "ResourceQuota" not in kinds:
            problems.append(f"namespace {ns}: no ResourceQuota. A runaway pod here "
                            "takes the whole node with it.")
        if "LimitRange" not in kinds:
            if "ResourceQuota" in kinds:
                problems.append(
                    f"namespace {ns}: a ResourceQuota with no LimitRange. Every pod "
                    "that does not declare cpu and memory will be REFUSED with "
                    "'must specify limits.cpu' -- this fence refuses correct work.")
            else:
                problems.append(f"namespace {ns}: no LimitRange, so no pod gets "
                                "default requests or a ceiling.")

        deny_i = any(denies_everything(np)[0] for np in nps)
        deny_e = any(denies_everything(np)[1] for np in nps)
        if not deny_i:
            problems.append(f"namespace {ns}: no NetworkPolicy denies Ingress for all "
                            "pods. Any pod in the cluster reaches these by IP.")
        if not deny_e:
            problems.append(f"namespace {ns}: no NetworkPolicy denies Egress for all "
                            "pods. A compromised pod here reaches every other "
                            "namespace and the internet.")
        if deny_e and not any(allows_dns(np) for np in nps):
            problems.append(f"namespace {ns}: Egress is denied and nothing allows port "
                            "53. DNS will fail in every pod, and it will look like "
                            "the application is slow, not like a policy.")
    return problems


# A CNI that enforces NetworkPolicy announces itself as a DaemonSet in kube-system. flannel is the
# one in this list that does not enforce policy at all: it routes pods and ignores every policy
# object the API server holds. Measured 2026-09-04: this estate runs kube-flannel-ds and nothing
# else, so sixteen NetworkPolicies were being reported as protection while denying nothing.
POLICY_ENFORCING_CNI = ("cilium", "calico", "canal", "antrea", "kube-router", "weave-net")


def enforcing_cni() -> str | None:
    """The name of whatever in kube-system actually reads a NetworkPolicy, or None."""
    raw = subprocess.run(
        ["kubectl", "get", "daemonset", "-n", "kube-system", "-o", "json"],
        capture_output=True, text=True, timeout=60, check=True).stdout
    names = [d["metadata"]["name"] for d in json.loads(raw)["items"]]
    for n in names:
        if any(c in n for c in POLICY_ENFORCING_CNI):
            return n
    return None


def live_docs() -> list[dict]:
    """The cluster's own objects, or an exception if it is not reachable."""
    out: list[dict] = []
    for kind in ("namespaces", "resourcequotas", "limitranges", "networkpolicies"):
        raw = subprocess.run(
            ["kubectl", "get", kind, "--all-namespaces", "-o", "json"],
            capture_output=True, text=True, timeout=60, check=True).stdout
        out += json.loads(raw)["items"]
    return out


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("path", nargs="?", default="platform/k8s/namespaces",
                    help="manifest file or directory (ignored with --live)")
    ap.add_argument("--live", action="store_true",
                    help="read the running cluster instead of the manifests")
    args = ap.parse_args()

    if args.live:
        try:
            docs, source = live_docs(), "the live cluster"
            cni = enforcing_cni()
        except Exception as exc:  # noqa: BLE001 -- any failure to reach it is the same answer
            print(f"BLIND  ns-fence-gate could not read the cluster: {exc}")
            print("       This is not a pass. Nothing was checked.")
            return 2
        if cni is None:
            policies = sum(1 for d in docs if d.get("kind") == "NetworkPolicy")
            print("FAIL   ns-fence-gate: no CNI in kube-system enforces NetworkPolicy, so the "
                  f"{policies} policy object(s) this cluster holds deny nothing.")
            print("       A quota and a LimitRange still work -- they are admission controllers "
                  "in the API server -- but no answer about network isolation is available here, "
                  "and reporting the namespaces as fenced would be a claim the cluster cannot "
                  "support. Install a policy-enforcing CNI first "
                  "(platform/ns-fences/network/README.md).")
            return 1
    else:
        docs, source = load_manifests(args.path), args.path

    # Only the estate's own manifest tree is graded against the estate's cluster. A fixture
    # directory names namespaces no cluster has, and skipping those would stop this gate proving
    # anything -- the bad fixture would pass by being unknown rather than by being fenced.
    live = None if (args.live or not grading_the_estate(args.path)) else live_namespaces()
    problems = check(docs, source, live)
    if problems:
        holed = len({p.split(":")[0] for p in problems})
        print(f"FAIL   ns-fence-gate: {len(problems)} defect(s) across {holed} "
              f"namespace(s) in {source}")
        for p in problems:
            print(f"       - {p}")
        return 1

    declared = sorted(
        d["metadata"]["name"] for d in docs
        if d.get("kind") == "Namespace"
        and d.get("metadata", {}).get("name") not in SYSTEM_NAMESPACES)
    fenced = [n for n in declared if live is None or n in live]
    for n in declared:
        if live is not None and n not in live:
            print(f"skip   {n}: declared in git, not on the cluster ({LIVE_RECORD}), so there is "
                  "nothing to fence yet; bin/idp-ns-fence-gen writes its fence on the first run "
                  "after it appears")
    if args.live:
        print(f"ok     ns-fence-gate: {len(fenced)} namespace(s) in {source} carry a quota, a "
              f"LimitRange, a both-ways default deny and a DNS exception, and {cni} is on the "
              f"nodes to enforce the deny: {', '.join(fenced)}")
    else:
        # Say what was actually graded. These are files: they declare a fence, they do not apply
        # one, and whether the cluster holds what they declare -- or has anything that would
        # enforce a policy -- is a question only --live can answer.
        print(f"ok     ns-fence-gate: {len(fenced)} namespace(s) DECLARE a quota, a LimitRange, a "
              f"both-ways default deny and a DNS exception in {source}. Whether the cluster holds "
              f"them, and whether anything on it enforces a policy, is --live's answer, not this "
              f"one: {', '.join(fenced)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
