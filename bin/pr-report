#!/usr/bin/env bash
# Reshape one pull request into the input policy/operating_model.rego reads, then run the
# gate. Structured rejection (crew#286 CP10): every deny line carries rule=<name> and a
# fix:, and --comment posts them back on the PR so the author never reads a bare red cross.
#
#   pr-report <number>            write reports/pr.json and run conftest; exit 1 on a deny
#   pr-report <number> --comment  same, and post the deny lines as one PR comment
#
# The budget comes from estate-defaults.yaml infrastructure.monthly_cap_usd (crew#281); a
# number typed here would be a second copy of it.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
n="${1:?pr number}"; comment="${2:-}"
for t in gh jq conftest python3; do command -v "$t" >/dev/null || { echo "BLIND $t missing"; exit 2; }; done
mkdir -p "$IDP/reports"
budget=$(python3 -c "import yaml,sys; print(yaml.safe_load(open(sys.argv[1]))['infrastructure']['monthly_cap_usd'])" "$IDP/estate-defaults.yaml")
gh pr view "$n" --json number,body,labels,files -q '{number: .number, body: .body, labels: [.labels[].name], files: [.files[].path]}' > "$IDP/reports/pr-meta.json" || exit 2
gh pr diff "$n" | grep '^+' | grep -v '^+++' > "$IDP/reports/pr-added.txt" || true
jq -n --slurpfile m "$IDP/reports/pr-meta.json" --rawfile a "$IDP/reports/pr-added.txt" --argjson b "$budget" \
  '{pr: ($m[0] + {added: $a}), budget_monthly_usd: $b}' > "$IDP/reports/pr.json"
out=$(conftest test --parser json -p "$IDP/policy" "$IDP/reports/pr.json" 2>&1); rc=$?
printf '%s\n' "$out" | grep -E 'FAIL|rule=' | sed 's/^.*FAIL - [^-]*- main - //'
if [ "$rc" -ne 0 ] && [ "$comment" = "--comment" ]; then
  body=$(printf 'operating-model gate (policy/operating_model.rego) refused this PR. Each line names the rule and the fix.\n\n'; printf '%s\n' "$out" | grep -o 'rule=.*' | sed 's/^/- /'; printf '\nRe-run: bin/pr-report %s\n' "$n")
  gh pr comment "$n" -b "$body" >/dev/null && echo "commented on #$n"
fi
[ "$rc" -eq 0 ] && echo "PASS    operating-model gate #$n" || echo "FAIL    operating-model gate #$n"
exit "$rc"
