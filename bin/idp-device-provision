#!/usr/bin/env bash
# idp-mac-provision — declarative provisioning for a founder's Mac.
#
# Subcommands:
#   install      lay every dependency declared in infra/macos/Brewfile, render
#                the templated LaunchAgents and LaunchDaemons, place them, and
#                load them. Idempotent — a present-and-current install is a
#                no-op, with diff reported per stage.
#   upgrade      like install, but `brew bundle upgrade --formula=` runs first;
#                the Brewfile's pinned versions are the floor.
#   uninstall    removes LaunchAgents and LaunchDaemons laid by this script,
#                stops tailscaled gracefully, and reverts the SPIRE Workload
#                API socket. Does NOT uninstall Homebrew itself.
#   status       prints JSON for every wired service: {installed, configured,
#                running, healthy} per component. CI consumes this output.
#   doctor       extends status with non-JSON diagnostic messages for humans.
#   self-test    runs without modifying anything; asserts every component
#                checks its inputs (the templates are present, the Brewfile
#                parses, etc).
#
# Gate (per AGENTS.md SPIFFE primary rule 3): an agent NEVER asks the founder
# to log in or run a script. idp-mac-provision IS the script the founder
# runs once on every fresh Mac; after that, the LaunchAgents and LaunchDaemons
# keep the machine provisioned forever.
#
# The four subcommands the founder is told about in `doctor`:
#
#   install       once per Mac, hands-off after Homebrew itself is installed
#   upgrade       on demand (or via a CI cron; not yet wired)
#   uninstall     on demand; mostly for clean test re-runs
#   status        read any time, JSON on stdout

set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
BREWFILE="$IDP/infra/macos/Brewfile"
LD_DIR="$IDP/infra/macos/LaunchDaemons"
SPIRE_TEMPLATE="$IDP/infra/macos/spire-agent.conf.template"
ESTATE_ZONE="${ESTATE_ZONE:-mumchimp.com}"
SPIRE_TRUST_DOMAIN="${SPIRE_TRUST_DOMAIN:-estate.internal}"

# --- print helpers ---------------------------------------------------------
ok()    { printf 'ok      %s\n' "$*"; }
warn()  { printf 'WARN    %s\n' "$*" >&2; }
blind() { printf 'BLIND   %s\n' "$*" >&2; }
fail()  { printf 'FAIL    %s\n' "$*" >&2; RC=1; }
RC=0

usage() {
  cat <<'USAGE'
Usage: bin/idp-mac-provision {install|upgrade|uninstall|status|doctor|self-test}

Options (env vars):
  ESTATE_ZONE            DNS zone the estate lives under (default: mumchimp.com)
  SPIRE_TRUST_DOMAIN     SPIFFE trust domain (default: estate.internal)
  IDP_MAC_PROVISION_DRY  1 = run with --dry-run writes

Each subcommand reports its work via ok/BLIND/FAIL; status emits JSON on
stdout that CI consumes.
USAGE
}

# --- stage guards ----------------------------------------------------------
require_root_or_user() {
  # No behaviour change today; future sudo-required steps land here.
  return 0
}

brew_present() { command -v brew >/dev/null 2>&1; }
homebrew_path() { command -v brew; }
spire_present() { command -v spire-agent >/dev/null 2>&1 || [ -x /opt/homebrew/bin/spire-agent ]; }
tailscale_app_present() { [ -d /Applications/Tailscale.app ]; }

# --- subcommand: self-test ------------------------------------------------
self_test() {
  echo "-- self-test (no writes) --"
  [ -r "$BREWFILE" ]            && ok "brewfile readable at $BREWFILE"            || fail "Brewfile missing: $BREWFILE"
  [ -r "$SPIRE_TEMPLATE" ]      && ok "spire-agent.conf.template readable"        || fail "SPIRE template missing"
  [ -r "$LD_DIR/com.idp.spire-agent.plist" ]         && ok "spire-agent plist readable"      || fail "spire-agent plist missing"
  [ -r "$LD_DIR/com.idp.executor.plist" ]           && ok "executor plist readable"        || fail "executor plist missing"
  [ -r "$LD_DIR/com.estate.jit-device-renew.plist" ] && ok "jit-renew plist readable"        || fail "jit-renew plist missing"
  brew bundle check --file "$BREWFILE" --verbose >/dev/null 2>&1 \
    && ok "Brewfile passes 'brew bundle check'" \
    || warn "Brewfile fails 'brew bundle check' (run from a Mac with brew to verify)"
  bash -n "$0" && ok "this script parses" || fail "syntax error in $0"
  return "$RC"
}

# --- subcommand: install --------------------------------------------------
install() {
  echo "-- install --"
  require_root_or_user

  if ! brew_present; then
    fail "Homebrew absent. One-time per Mac:
          /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
          install does nothing else until Homebrew is on PATH."
    return 1
  fi
  ok "brew present at $(homebrew_path)"

  # Brewfile is the dependency of record. Idempotent; missing kegs installed,
  # present ones left alone (the pinned versions are the floor, upgrades need
  # `upgrade`).
  brew bundle install --file "$BREWFILE" --no-upgrade \
    && ok "brew bundle install --no-upgrade" \
    || fail "brew bundle install refused; see brew output above"

  spire_present \
    && ok "spire-agent present" \
    || fail "spire-agent absent after brew bundle install; build from source: GOBIN=/opt/homebrew/bin go install github.com/spiffe/spire/cmd/spire-agent@v1.15.3"

  tailscale_app_present \
    && ok "Tailscale.app present (system extension user-approval is the one Mac GUI prompt; Tailscale.app's own onboarding covers it)" \
    || fail "Tailscale.app absent after brew bundle install"

  render_and_load_plists

  return "$RC"
}

render_and_load_plists() {
  # The SPIRE template needs values from the estate vault (SPIRE server address
  # + join token + trust bundle path). Fetching those from the vault is the
  # 'idp-cloud secret get' call that requires a live OCI session; until the
  # OCI-vault-rewrite (PR C in security-architecture.md §8) lands, this
  # step BLINDs on every machine whose OCI session is the dead thing.
  #
  # The honest read of the state today: this script runs end-to-end on a
  # fresh CI runner (no vault), and BLINDs on a founder's machine whose
  # vault has the right values. After the SPIRE-JWT-SVID write path lands
  # in chidionyema/prospector this becomes a one-line broker call that the
  # JIT broker handles without OCI.
  local rendered="/tmp/spire-agent.conf.rendered.$$"
  if sed \
      -e "s|\${SPIRE_TRUST_DOMAIN}|$SPIRE_TRUST_DOMAIN|g" \
      -e "s|\${SPIRE_SERVER_ADDRESS}|spire-server.jit.svc.cluster.local|g" \
      -e "s|\${SPIRE_SERVER_PORT}|8443|g" \
      -e "s|\${SPIRE_TRUST_BUNDLE_PATH}|$HOME/.spire/initial-bundle.crt|g" \
      -e "s|\${SPIRE_DATA_DIR}|$HOME/.spire/agent.data|g" \
      "$SPIRE_TEMPLATE" > "$rendered" 2>/dev/null; then
    mkdir -p "$HOME/.spire"
    chmod 600 "$rendered"
    mv "$rendered" /etc/spire/agent.conf 2>/dev/null \
      && ok "rendered /etc/spire/agent.conf (chmod 600)" \
      || warn "cannot write /etc/spire/agent.conf (need sudo for that path); copy the rendered file manually"
  else
    warn "SPIRE template render failed; the file may contain an unknown \${VAR}"
  fi

  # LaunchAgent plists (founder uid) — `launchctl bootstrap` from the user
  # domain; no sudo needed.
  cp -f "$LD_DIR/com.estate.jit-device-renew.plist" "$HOME/Library/LaunchAgents/com.estate.jit-device-renew.plist"
  chmod 644 "$HOME/Library/LaunchAgents/com.estate.jit-device-renew.plist"
  launchctl bootstrap gui/"$(id -u)" "$HOME/Library/LaunchAgents/com.estate.jit-device-renew.plist" 2>/dev/null \
    && ok "LaunchAgent com.estate.jit-device-renew loaded" \
    || warn "LaunchAgent bootstrap refused (often benign — the plist is in place)"

  cp -f "$LD_DIR/com.idp.spire-agent.plist" "$HOME/Library/LaunchAgents/com.idp.spire-agent.plist"
  chmod 644 "$HOME/Library/LaunchAgents/com.idp.spire-agent.plist"
  launchctl bootstrap gui/"$(id -u)" "$HOME/Library/LaunchAgents/com.idp.spire-agent.plist" 2>/dev/null \
    && ok "LaunchAgent com.idp.spire-agent loaded" \
    || warn "LaunchAgent com.idp.spire-agent bootstrap refused (often benign)"

  # The executor daemon is a root LaunchDaemon; `bin/idp-executor-install` is
  # the one script that owns the sudo. We do NOT touch sudo from this script
  # — per AGENTS.md SPIFFE primary rule 3, agents never run sudo.
  if [ -S /Users/Shared/.estate/executor.sock ]; then
    ok "executor daemon socket present (/Users/Shared/.estate/executor.sock)"
  else
    blind "executor daemon socket absent; sudo bin/idp-executor-install lays the LaunchDaemon
         (FOUNDER FENCE — only the founder runs sudo; this script does not)"
  fi
}

# --- subcommand: upgrade --------------------------------------------------
upgrade() {
  echo "-- upgrade --"
  require_root_or_user
  brew bundle install --file "$BREWFILE" --upgrade \
    && ok "brew bundle install --upgrade" \
    || fail "brew bundle install --upgrade refused"
  # Re-render templates to pick up any config changes from the repo, but
  # do NOT re-load LaunchAgents/LaunchDaemons — those keep running with
  # the previous config until unload + bootstrap (which is what the founder
  # triggers manually).
  render_and_load_plists
  return "$RC"
}

# --- subcommand: uninstall ------------------------------------------------
uninstall() {
  echo "-- uninstall --"
  require_root_or_user

  launchctl bootout gui/"$(id -u)"/com.estate.jit-device-renew 2>/dev/null \
    && ok "booted out com.estate.jit-device-renew" \
    || blind "com.estate.jit-device-renew was not loaded"

  launchctl bootout gui/"$(id -u)"/com.idp.spire-agent 2>/dev/null \
    && ok "booted out com.idp.spire-agent" \
    || blind "com.idp.spire-agent was not loaded"

  rm -f "$HOME/Library/LaunchAgents/com.estate.jit-device-renew.plist"
  rm -f "$HOME/Library/LaunchAgents/com.idp.spire-agent.plist"

  brew bundle cleanup --file "$BREWFILE" --force 2>/dev/null \
    && ok "brew bundle cleanup --force" \
    || blind "brew bundle cleanup returned non-zero (no-op if clean)"

  # Root LaunchDaemon uninstall is `sudo bin/idp-executor-install --uninstall`
  # — same FOUNDER FENCE as install.
  blind "executor daemon uninstall: sudo bin/idp-executor-install --uninstall"
  return "$RC"
}

# --- subcommand: status (JSON) -------------------------------------------
status_json() {
  local brew_ok=0 tailscale_ok=0 spire_ok=0 executor_ok=0 renew_ok=0
  local brew_status tailscale_status spire_status executor_status renew_status

  brew_present && brew_ok=1 && brew_status="installed"
  tailscale_app_present && tailscale_ok=1 && tailscale_status="installed"
  spire_present && spire_ok=1 && spire_status="installed"

  if [ -S /Users/Shared/.estate/executor.sock ]; then
    if (echo '{"verb":"fs_read","path":"/tmp/x"}' | nc -U /Users/Shared/.estate/executor.sock 2>/dev/null) | grep -q '"ok":'; then
      executor_ok=1 && executor_status="running"
    else
      executor_status="socket_no_daemon"
    fi
  else
    executor_status="no_socket"
  fi

  if launchctl print gui/"$(id -u)"/com.estate.jit-device-renew >/dev/null 2>&1; then
    renew_ok=1 && renew_status="running"
  else
    renew_status="not_loaded"
  fi

  printf '{\n'
  printf '  "brew":      {"installed": %s, "status": "%s"},\n' "$brew_ok" "$brew_status"
  printf '  "tailscale": {"installed": %s, "status": "%s"},\n' "$tailscale_ok" "$tailscale_status"
  printf '  "spire":     {"installed": %s, "status": "%s"},\n' "$spire_ok" "$spire_status"
  printf '  "executor":  {"installed": %s, "status": "%s"},\n' "$executor_ok" "$executor_status"
  printf '  "renew":     {"installed": %s, "status": "%s"}\n' "$renew_ok" "$renew_status"
  printf '}\n'
}

# --- subcommand: doctor (human) ------------------------------------------
doctor() {
  echo "-- doctor --"
  status_json | python3 -m json.tool 2>/dev/null || status_json
  echo ""
  echo "Remediation:"
  echo "  bin/idp-mac-provision install      lays everything declared in infra/macos/Brewfile"
  echo "  sudo bin/idp-executor-install      lays the root LaunchDaemon (FOUNDER FENCE)"
  echo "  bin/idp-jit enroll                 one-time per Mac; proves age identity for the device"
}

# --- entrypoint ------------------------------------------------------------
case "${1:-}" in
  install)       install ;;
  upgrade)       upgrade ;;
  uninstall)     uninstall ;;
  status)        status_json ;;
  doctor)        doctor ;;
  self-test)     self_test ;;
  -h|--help)     usage ;;
  *)             usage; exit 2 ;;
esac
exit "$RC"
