#!/usr/bin/env python3
"""idp-mcp-first-gate — a state question answered by shell recon instead of the platform.

WHY THIS EXISTS (measured 2026-09-19, one session, asked one question: "is component X live?").
It was answered wrong twice. The session read `docs/reports/flux-state.md` — an artifact a
scheduled workflow rewrites every 15 minutes — and reported a row dated the previous day as the
current state of the cluster. It quoted an `oke-check` job log the same way, as if a log were a
live read. It searched `~/.claude/projects/*.jsonl` — OTHER SESSIONS' PRIVATE TRANSCRIPTS — to
infer what a peer could do, and built a confident answer from someone else's working memory. It
reported the wrong CNI for the cluster by quoting a commit message from weeks earlier.

At no point did it call the tool that answers the question directly. ADR 0006 settled this on
2026-08-25: the platform answers for itself, and a question about estate state is one
`mcp__estate__*` call. The rule was written down and had no mechanism behind it, so the habit
survived the rule.

WHY IT GRADES A COMMAND AND NOT A MODEL. This gate reads a command string. It has no opinion
about, and no dependency on, which agent produced it: a Claude session, a DeepSeek session, a
local model, or a person at a terminal are refused or permitted by the same bytes. That property
is the whole point. A guard wired into one vendor's hook system binds that vendor's sessions and
silently exempts every other harness running on the same machine — which is the arrangement this
file exists to avoid.

WHAT IT DOES NOT DO. It cannot see what an agent concluded from an allowed read, and it does not
try. It refuses three specific substitutions for a query the platform already serves:

  1. a scheduled report read as live truth        (docs/reports/*.md)
  2. another session's transcript read as state   (~/.claude/projects, ~/.pi/agent/sessions)
  3. ad-hoc reads of the twin's store             (sqlite3 catalog/estate.db)

Each carries a typed escape marker, because none of the three is illegitimate in itself — it is
illegitimate AS A SUBSTITUTE for the call. An absolute fence would also be LAW 38: on
2026-09-19 `get_estate_state` answered `available: false` ("the producer has not written one"),
so a rule that refused the read and offered nothing in its place would be an outage.

USAGE
    idp-mcp-first-gate --command 'cat docs/reports/flux-state.md'   # exit 1, refused
    idp-mcp-first-gate --selftest
"""

from __future__ import annotations

import argparse
import re
import sys

# (id, pattern, marker, message)
RULES = (
    (
        "stale_report_as_truth",
        re.compile(r"\b(?:cat|head|tail|less|more|bat|sed|awk|grep)\b[^;&|]*\bdocs/reports/[\w./-]+\.md"),
        "report-read-intended",
        "docs/reports/*.md is a scheduled SNAPSHOT, not current state. Every file there is "
        "generated by estate-state.yml and committed by a bot; its own header names the instant "
        "it was read. Ask the platform: get_estate_state() or get_workload_state(app).",
    ),
    (
        "peer_transcript_recon",
        re.compile(r"(?:~|\$HOME|/Users/[\w.-]+)?/?\.(?:claude/projects|pi/agent/sessions)/[\w./*{}-]*"),
        "transcript-intended",
        "Another session's transcript is not a state source. Those files record what a session "
        "BELIEVED, including beliefs it later corrected, so quoting one produces a confident "
        "answer that cannot be checked. Ask the peer on the crew board, or ask the platform.",
    ),
    (
        "estate_store_bypass",
        re.compile(
            r"\bsqlite3\b[^;&|]*\bcatalog/estate\.db\b"
            r"|\b(?:cat|head|tail|less|xxd|strings)\b[^;&|]*\bcatalog/estate\.db\b"
        ),
        "store-direct-intended",
        "catalog/estate.db is an input to the MCP tools, not a query surface. Reading it "
        "directly skips the staleness envelope and the byte ceiling, and returns raw rows as "
        "the answer. Ask the graph: get_catalog_drift(), get_workload_state(app), or "
        "bin/estate-twin-runtime for the twin itself.",
    ),
)

# Both dispositions, so the gate is shown to permit as well as refuse (LAW 38).
SELFTEST_REFUSE = (
    "cat docs/reports/flux-state.md",
    "head -50 docs/reports/inventory.md",
    "grep -rln agent-reader ~/.claude/projects/*/*.jsonl",
    "cat ~/.pi/agent/sessions/x/y.jsonl",
    "sqlite3 catalog/estate.db 'select * from nodes'",
    "cat catalog/estate.db",
)
SELFTEST_PERMIT = (
    "bin/estate-twin-runtime --once --blast-radius 3",
    "git log -1 --format=%ad -- docs/reports/flux-state.md",
    "head -3 docs/reports/flux-state.md # report-read-intended",
    "bin/idp-kube get pods -n via-negativa",
    "pytest -q tests/test_x.py",
)


def evaluate(command: str) -> list[tuple[str, str]]:
    """Every rule this command trips, as (id, message). A marker turns its rule off."""
    hits = []
    for rule_id, pattern, marker, message in RULES:
        if marker in command:
            continue
        if pattern.search(command):
            hits.append((rule_id, message))
    return hits


def evaluate_file(path: str) -> list[tuple[str, str]]:
    """Grade a shell script line by line.

    The registry hands a session rule the paths it changed, so this gate must read a file the
    way bin/idp-hardcode-scan reads one. A marker on the line turns that line's rule off;
    comments are skipped, so the fixtures can explain themselves without tripping the gate.
    """
    hits: list[tuple[str, str]] = []
    with open(path, encoding="utf-8", errors="replace") as fh:
        for raw in fh:
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            for rule_id, message in evaluate(line):
                if (rule_id, message) not in hits:
                    hits.append((rule_id, message))
    return hits


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("paths", nargs="*", help="script(s) to grade, as the session plane passes them")
    parser.add_argument("--command", help="a single command string to grade")
    parser.add_argument("--selftest", action="store_true", help="prove the gate both ways")
    args = parser.parse_args(argv)

    if args.selftest:
        bad = 0
        for cmd in SELFTEST_REFUSE:
            if not evaluate(cmd):
                print(f"FAIL  refused case was permitted: {cmd}")
                bad = 1
        for cmd in SELFTEST_PERMIT:
            if evaluate(cmd):
                print(f"FAIL  permitted case was refused: {cmd}")
                bad = 1
        if bad:
            print("FAIL  mcp-first  the gate does not discriminate; it may not be trusted")
            return 1
        print(
            f"ok    mcp-first  {len(SELFTEST_REFUSE)} substitution(s) refused, "
            f"{len(SELFTEST_PERMIT)} legitimate read(s) permitted"
        )
        return 0

    if args.command:
        hits = evaluate(args.command)
        if not hits:
            return 0
        _report(hits)
        return 1

    if not args.paths:
        parser.error("a path, --command or --selftest is required")

    total = 0
    for path in args.paths:
        hits = evaluate_file(path)
        if hits:
            print(f"{path}:", file=sys.stderr)
            _report(hits)
            total += 1
    if total:
        return 1
    print(f"ok    mcp-first  {len(args.paths)} file(s) read the platform, not a substitute")
    return 0


def _report(hits: list[tuple[str, str]]) -> None:
    markers = dict((r[0], r[2]) for r in RULES)
    for rule_id, message in hits:
        print(f"REFUSED  {rule_id}: {message}", file=sys.stderr)
        print(f"         If you mean it, append  # {markers[rule_id]}", file=sys.stderr)


if __name__ == "__main__":
    sys.exit(main())
