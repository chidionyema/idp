#!/usr/bin/env bash
# bin/idp-install-deps -- installs every binary the CI matrix requires, at the same pinned
# versions CI uses (.github/actions/estate-tools/action.yml).
#
# Model-agnostic: works on macOS (darwin arm64/amd64) and Linux (amd64/arm64).
# Idempotent: already-correct installs are skipped in under a second.
# Called by bin/idp-install-hooks so a fresh clone bootstraps the full toolset automatically.
#
# Installs to ~/.cache/estate-tools/ (same path as CI) and adds it to PATH if needed.
case "${1:-}" in
  -h|--help)
    echo "bin/idp-install-deps -- install every binary bin/idp-ci requires, at CI-pinned versions."
    echo "Idempotent. Installs to ~/.cache/estate-tools/ (same path as CI). Called by bin/idp-install-hooks."
    exit 0
    ;;
esac
set -euo pipefail

TOOLS_DIR="$HOME/.cache/estate-tools"
mkdir -p "$TOOLS_DIR"

# Exact versions pinned in .github/actions/estate-tools/action.yml
KYVERNO_VER="1.19.0"
HELM_VER="3.19.0"
CONFTEST_VER="0.62.0"
FLUX_VER="2.9.4"
KUSTOMIZE_VER="5.7.1"
KUBECONFORM_VER="0.8.0"
SOPS_VER="3.13.3"
TEMPORAL_VER="1.9.1"
# nats-server -- the laptop estate bus (JetStream on loopback, ai.estate.nats.plist). It was NOT
# in this list and nothing else provisioned it, so when ~/.cache/estate-tools was refreshed on
# 2026-11-10 every other tool was re-fetched and nats-server silently vanished. ai.estate.nats
# has KeepAlive, so launchd retried forever and every retry exited 126 'cannot execute'; the
# estate-bus critical entry then read 127.0.0.1:4222 refused and the estate went blind on its
# bus while the board still showed a loaded job. The pin matches ai.estate.nats.plist,
# platform/messaging/go.mod and the chart, all on 2.14.6.
NATS_VER="2.14.6"
YAMLLINT_VER="1.37.1"   # pip, not a release binary; .github/workflows/ci.yml and fast-gate.yml pin the same

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
[ "$ARCH" = "x86_64" ] && ARCH="amd64"
[ "$ARCH" = "aarch64" ] && ARCH="arm64"

fail=0
_ok()   { printf 'ok    deps    %s\n' "$*"; }
_inst() { printf 'install deps  %s\n' "$*"; }
_fail() { printf 'FAIL  deps    %s\n' "$*"; fail=1; }

_need_curl() {
  command -v curl >/dev/null || { _fail "curl not found -- install curl first"; exit 1; }
}

# Check installed version; tries version/--version/-v; matches with or without 'v' prefix
_ver_ok() {
  local bin="$1" want="$2"
  local path; path="$TOOLS_DIR/$bin"
  [ -x "$path" ] || return 1
  local bare="${want#v}"
  local out
  out="$("$path" version 2>&1; "$path" --version 2>&1; "$path" -v 2>&1; true)"
  echo "$out" | grep -qE "$want|$bare"
}

# Fetch a release that ships a bare binary (no archive) straight into TOOLS_DIR.
_fetch_raw() {
  local name="$1" url="$2"
  local tmp; tmp="$(mktemp -d)"
  _need_curl
  if curl -sSL --retry 3 --retry-delay 2 -o "$tmp/$name" "$url" 2>/dev/null && [ -s "$tmp/$name" ]; then
    mv "$tmp/$name" "$TOOLS_DIR/$name"
    chmod +x "$TOOLS_DIR/$name"
    rm -rf "$tmp"
    return 0
  else
    rm -rf "$tmp"; return 1
  fi
}

_fetch() {
  local name="$1" url="$2" strip="${3:-0}"
  local tmp; tmp="$(mktemp -d)"
  _need_curl
  if curl -sSL --retry 3 --retry-delay 2 "$url" | tar -xz -C "$tmp" 2>/dev/null; then
    if [ "$strip" -gt 0 ]; then
      find "$tmp" -maxdepth "$((strip+1))" -name "$name" -type f | head -1 | xargs -I{} cp {} "$TOOLS_DIR/$name"
    else
      cp "$tmp/$name" "$TOOLS_DIR/$name" 2>/dev/null || \
        find "$tmp" -name "$name" -type f | head -1 | xargs -I{} cp {} "$TOOLS_DIR/$name"
    fi
    chmod +x "$TOOLS_DIR/$name"
    rm -rf "$tmp"
    return 0
  else
    rm -rf "$tmp"; return 1
  fi
}

# kyverno -- release archive uses x86_64/arm64, not amd64
_KYV_ARCH="$ARCH"; [ "$ARCH" = "amd64" ] && _KYV_ARCH="x86_64"
if _ver_ok kyverno "v$KYVERNO_VER"; then
  _ok "kyverno $KYVERNO_VER"
else
  _inst "kyverno $KYVERNO_VER"
  URL="https://github.com/kyverno/kyverno/releases/download/v${KYVERNO_VER}/kyverno-cli_v${KYVERNO_VER}_${OS}_${_KYV_ARCH}.tar.gz"
  if _fetch kyverno "$URL"; then _ok "kyverno $KYVERNO_VER installed"
  else _fail "kyverno install failed (url: $URL)"; fi
fi

# helm
if _ver_ok helm "v$HELM_VER"; then
  _ok "helm $HELM_VER"
else
  _inst "helm $HELM_VER"
  URL="https://get.helm.sh/helm-v${HELM_VER}-${OS}-${ARCH}.tar.gz"
  if _fetch helm "$URL" 1; then _ok "helm $HELM_VER installed"
  else _fail "helm install failed (url: $URL)"; fi
fi

# conftest -- release archive capitalises OS name (Darwin/Linux)
if _ver_ok conftest "$CONFTEST_VER"; then
  _ok "conftest $CONFTEST_VER"
else
  _inst "conftest $CONFTEST_VER"
  CF_OS="Linux"; [ "$OS" = "darwin" ] && CF_OS="Darwin"
  CF_ARCH="$ARCH"; [ "$ARCH" = "amd64" ] && CF_ARCH="x86_64"
  URL="https://github.com/open-policy-agent/conftest/releases/download/v${CONFTEST_VER}/conftest_${CONFTEST_VER}_${CF_OS}_${CF_ARCH}.tar.gz"
  if _fetch conftest "$URL"; then _ok "conftest $CONFTEST_VER installed"
  else _fail "conftest install failed (url: $URL)"; fi
fi

# flux
if _ver_ok flux "$FLUX_VER"; then
  _ok "flux $FLUX_VER"
else
  _inst "flux $FLUX_VER"
  URL="https://github.com/fluxcd/flux2/releases/download/v${FLUX_VER}/flux_${FLUX_VER}_${OS}_${ARCH}.tar.gz"
  if _fetch flux "$URL"; then _ok "flux $FLUX_VER installed"
  else _fail "flux install failed (url: $URL)"; fi
fi

# kustomize
if _ver_ok kustomize "v$KUSTOMIZE_VER"; then
  _ok "kustomize $KUSTOMIZE_VER"
else
  _inst "kustomize $KUSTOMIZE_VER"
  URL="https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2Fv${KUSTOMIZE_VER}/kustomize_v${KUSTOMIZE_VER}_${OS}_${ARCH}.tar.gz"
  if _fetch kustomize "$URL"; then _ok "kustomize $KUSTOMIZE_VER installed"
  else _fail "kustomize install failed (url: $URL)"; fi
fi

# kubeconform
if _ver_ok kubeconform "$KUBECONFORM_VER"; then
  _ok "kubeconform $KUBECONFORM_VER"
else
  _inst "kubeconform $KUBECONFORM_VER"
  URL="https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VER}/kubeconform-${OS}-${ARCH}.tar.gz"
  if _fetch kubeconform "$URL"; then _ok "kubeconform $KUBECONFORM_VER installed"
  else _fail "kubeconform install failed (url: $URL)"; fi
fi

# sops -- Level-0 estate tool (bin/idp-workstation-bootstrap TOOLS row) that decrypts the
# estate-secrets vault. Without it scripts/secret-load fails "sops: command not found", so no
# key can be read by name and every caller that needs one BLINDs. Ships a bare binary, no archive.
if _ver_ok sops "$SOPS_VER"; then
  _ok "sops $SOPS_VER"
else
  _inst "sops $SOPS_VER"
  URL="https://github.com/getsops/sops/releases/download/v${SOPS_VER}/sops-v${SOPS_VER}.${OS}.${ARCH}"
  if _fetch_raw sops "$URL"; then _ok "sops $SOPS_VER installed"
  else _fail "sops install failed (url: $URL)"; fi
fi

# temporal -- the CLI whose dev server the cp27 acceptance scenarios start (temporal.cli_binary,
# sovereign/shadow/config_keys.py) instead of the SDK downloading one. CI's runner has it on PATH;
# a workstation without it failed all three cp27 scenarios with "temporal CLI not on PATH".
if _ver_ok temporal "$TEMPORAL_VER"; then
  _ok "temporal $TEMPORAL_VER"
else
  _inst "temporal $TEMPORAL_VER"
  URL="https://github.com/temporalio/cli/releases/download/v${TEMPORAL_VER}/temporal_cli_${TEMPORAL_VER}_${OS}_${ARCH}.tar.gz"
  if _fetch temporal "$URL"; then _ok "temporal $TEMPORAL_VER installed"
  else _fail "temporal install failed (url: $URL)"; fi
fi

# nats-server -- the loopback estate bus that ai.estate.nats.plist supervises (JetStream is what
# carries voice steers and every agent event). The plist execs $TOOLS_DIR/nats-server, so the
# binary and the supervisor are two halves of one contract; while only the plist existed,
# KeepAlive restarted a missing binary every few seconds, each attempt exited 126, and nothing
# said so: the job showed as loaded while 127.0.0.1:4222 refused every client (estate-bus FAIL).
# `nats-server --version` prints "nats-server: v2.14.6", which _ver_ok's version/--version probe
# matches. The release ships an archive under a nested dir, so it needs the strip=1 form.
if _ver_ok nats-server "v$NATS_VER"; then
  _ok "nats-server $NATS_VER"
else
  _inst "nats-server $NATS_VER"
  URL="https://github.com/nats-io/nats-server/releases/download/v${NATS_VER}/nats-server-v${NATS_VER}-${OS}-${ARCH}.tar.gz"
  if _fetch nats-server "$URL" 1; then _ok "nats-server $NATS_VER installed"
  else _fail "nats-server install failed (url: $URL)"; fi
fi

# yamllint -- the yamllint rung in bin/idp-ci and .githooks/pre-commit refuse when it is missing,
# rather than skipping. It is a Python package, so it gets its own venv under TOOLS_DIR (no
# --user install into whichever python3 is first on PATH) and a symlink beside the binaries.
if _ver_ok yamllint "$YAMLLINT_VER"; then
  _ok "yamllint $YAMLLINT_VER"
else
  _inst "yamllint $YAMLLINT_VER"
  if python3 -m venv "$TOOLS_DIR/yamllint-venv" >/dev/null 2>&1 \
     && "$TOOLS_DIR/yamllint-venv/bin/pip" install -q "yamllint==$YAMLLINT_VER" >/dev/null 2>&1; then
    ln -sf "$TOOLS_DIR/yamllint-venv/bin/yamllint" "$TOOLS_DIR/yamllint"
    _ok "yamllint $YAMLLINT_VER installed"
  else _fail "yamllint install failed (python3 -m venv + pip install yamllint==$YAMLLINT_VER)"; fi
fi

# python 3.12 -- the interpreter ci.yml's offline-gate runs bin/idp-ci on, with the same pip lines.
# macOS ships 3.9, and the gate on 3.9 is a different program (bin/idp-ci, "the workstation's
# interpreter is CI's"). One venv for every worktree; fleetview-backend, the only editable
# requirement, is left out here and put on PYTHONPATH by bin/idp-ci from the checkout it runs in.
# Rebuilt only when a requirements file changes, and then in place: uv installs just the delta.
# The cold build was ~17 min on a 2017 i5, nearly all of it rustc: cryptography stopped shipping
# x86_64 macOS wheels at 49, so uv compiles it from source, and uv's cache had been pruned when the
# disk filled. Wheels uv had to build are copied to $_WH, outside that cache, and offered back with
# --find-links -- same version as CI, compiled once per machine.
_REPO="$(cd "$(dirname "$0")/.." && pwd)"
_PYV="$TOOLS_DIR/py312-venv"
_WH="$TOOLS_DIR/wheelhouse"
_PYSTAMP="$(cat "$_REPO"/sovereign/requirements*.txt | shasum -a 256 | cut -c1-16)"
if [ -x "$_PYV/bin/python" ] && [ "$(cat "$_PYV/.idp-stamp" 2>/dev/null)" = "$_PYSTAMP" ]; then
  _ok "python $("$_PYV/bin/python" -c 'import sys; print(sys.version.split()[0])') (gate venv)"
elif ! command -v uv >/dev/null 2>&1; then
  _fail "python gate venv needs uv to fetch 3.12: curl -LsSf https://astral.sh/uv/install.sh | sh"
else
  _inst "python 3.12 gate venv (sovereign/requirements*.txt)"
  _req="$(mktemp)"
  grep -v '^-e ' "$_REPO/sovereign/requirements-dev.txt" | sed "s#^-r requirements.txt#-r $_REPO/sovereign/requirements.txt#" > "$_req"
  if uv venv -q --allow-existing --python 3.12 "$_PYV" \
     && mkdir -p "$_WH" && uv pip install -q --python "$_PYV/bin/python" --find-links "$_WH" -r "$_req" \
          check-jsonschema sqlite-utils pyyaml dagster dagster-webserver "yamllint==$YAMLLINT_VER" \
          ruff==0.15.18 "mkdocs<2" mkdocs-techdocs-core; then
    find "$(uv cache dir)"/sdists-v* -name '*.whl' -exec cp -n {} "$_WH"/ \; 2>/dev/null
    printf '%s' "$_PYSTAMP" > "$_PYV/.idp-stamp"; _ok "python gate venv installed"
  else _fail "python gate venv install failed (uv pip install into $_PYV)"; fi
  rm -f "$_req"
fi

# docker -- daemon must be reachable for the compose validation rung in bin/idp-ci
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  _ok "docker (daemon reachable)"
elif command -v docker >/dev/null 2>&1; then
  printf 'WARN  deps    docker installed but daemon not running\n'
  [ "$OS" = "darwin" ] && printf '      start Docker Desktop or: open -a Docker\n'
  [ "$OS" = "linux"  ] && printf '      sudo systemctl start docker\n'
else
  printf 'WARN  deps    docker not installed\n'
  [ "$OS" = "darwin" ] && printf '      macOS: brew install --cask docker && open -a Docker\n'
  [ "$OS" = "linux"  ] && printf '      Linux: sudo apt-get install -y docker.io && sudo systemctl start docker\n'
  printf '      (required for docker compose validation rung in bin/idp-ci)\n'
fi

# PATH -- make the tools RESOLVABLE, do not ask a human to edit a profile.
#
# This block used to print "add export PATH=... to ~/.zshrc" and return success. Measured
# 2026-11-11 on this machine: the line WAS in ~/.zshrc and `zsh -lc 'echo $PATH'` still did not
# contain TOOLS_DIR, while `sh -c 'echo $PATH'` never reads a profile at all. Non-interactive
# shells are exactly where the executor, the pre-push hook and launchd run, so the advice could
# never reach the place that needed it -- and the installer exited 0 while saying so.
#
# The consequence was not cosmetic. `rg` is the command AGENTS.md section 10 REQUIRES agents to
# use instead of `grep -r`; with ~/.local/bin off the gate's PATH every search returned 0 hits
# with a clean exit, so "this does not exist" and "the binary is missing" were the same answer.
# `gh` was the same class: absent entirely, and every claim-gate died with FileNotFoundError
# instead of returning a verdict.
#
# So: link each tool into a directory a NON-INTERACTIVE shell already searches. /usr/local/bin
# is on the default PATH of every shell here (measured: env -i sh -c 'echo $PATH' ->
# /usr/gnu/bin:/usr/local/bin:/bin:/usr/bin:. ) and is user-writable on this machine, so no
# sudo and no second copy of the binary -- a symlink into the real install.
_LINK_DIR="/usr/local/bin"
# The question is NOT "is this dir on MY PATH" -- an interactive shell has ~/.local/bin and the
# gate shell does not, so asking that way links nothing precisely when it matters (measured: the
# first version of this block ran with ~/.local/bin on PATH, concluded it was reachable, and left
# `rg` unresolvable to every gate). Ask the gate's own shell instead.
_gate_reaches() {
  env -i HOME="$HOME" sh -c "command -v $1" >/dev/null 2>&1
}
_need_path=()
for _t in "$TOOLS_DIR" "$HOME/.local/bin"; do
  [ -d "$_t" ] || continue
  for _f in "$_t"/*; do
    [ -f "$_f" ] && [ -x "$_f" ] || continue
    _gate_reaches "$(basename "$_f")" || { _need_path+=("$_t"); break; }
  done
done
if [ "${#_need_path[@]}" -gt 0 ]; then
  if [ -d "$_LINK_DIR" ] && [ -w "$_LINK_DIR" ]; then
    _linked=0
    for _d in "${_need_path[@]}"; do
      [ -d "$_d" ] || continue
      for _f in "$_d"/*; do
        [ -f "$_f" ] && [ -x "$_f" ] || continue
        _n=$(basename "$_f")
        # skip a tool the gate shell already reaches through some other directory: never shadow
        # a different binary that is already resolvable.
        _gate_reaches "$_n" && continue
        ln -sf "$_f" "$_LINK_DIR/$_n" 2>/dev/null && _linked=$((_linked + 1))
      done
    done
    _ok "$_linked tool(s) linked into $_LINK_DIR so non-interactive shells resolve them"
  else
    # No writable PATH dir to link into. Say WHICH tool is unreachable and fail: a green install
    # whose tools no gate can find is the defect this block exists to prevent.
    _fail "$_LINK_DIR is not writable; these installs stay unreachable to gates: ${_need_path[*]}"
  fi
fi

# The tool AGENTS.md names, proven resolvable from a shell with NO profile at all. This is a
# refusal, not a warning: an agent whose `rg` is missing reports "no matches" for a thing that
# exists, which is a wrong answer wearing a green exit code.
for _t in rg gh; do
  if _gate_reaches "$_t"; then
    :
  elif [ -x "$HOME/.local/bin/$_t" ]; then
    _fail "$_t exists at ~/.local/bin/$_t but no non-interactive shell resolves it"
  else
    _fail "$_t is not installed (AGENTS.md section 10 requires rg; claim-gate requires gh)"
  fi
done

[ "$fail" -eq 0 ] && printf 'ok    deps    all estate-tools at CI-pinned versions\n'
exit "$fail"
