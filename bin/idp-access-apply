#!/usr/bin/env bash
# Provision the front door's OIDC client (platform/access) with every input read from where it
# already lives: zone from estate-config, vault/key/compartment from platform/oci outputs, the
# Cloudflare token from the estate vault. Nothing typed, nothing pasted (crew#281, LAW 46).
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
export SUPPRESS_LABEL_WARNING=True
zone=$(awk '/ESTATE_ZONE:/{print $2}' "$IDP/clusters/oke/estate-config.yaml")
export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}
# compartment: the CI variable when the job sets it (access-apply.yml), else the vault, as bin/idp-vault-put
C="${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$IDP/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}"
sid=$(oci vault secret list --compartment-id "$C" --name cloudflare-api-token --query 'data[0].id' --raw-output)
# vault and key: the ones the existing estate secrets already live in (no Terraform state needed)
V=$(oci vault secret get --secret-id "$sid" --query 'data."vault-id"' --raw-output)
K=$(oci vault secret get --secret-id "$sid" --query 'data."key-id"' --raw-output)
CLOUDFLARE_API_TOKEN=$(oci secrets secret-bundle get --secret-id "$sid" --query 'data."secret-bundle-content".content' --raw-output | base64 -d)
export CLOUDFLARE_API_TOKEN
# crew#281 CP4: Zero Trust resources need an account-scoped token. Until the estate token carries
# Account -> Zero Trust: Edit, /accounts answers an empty list and there is nothing to apply. The
# scheduled job (access-apply.yml) then exits 0 with this line and tries again on the next tick.
accounts=$(curl -sS --max-time 20 -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" https://api.cloudflare.com/client/v4/accounts \
  | python3 -c 'import sys,json; d=json.load(sys.stdin); print(len(d.get("result") or []))')
if [ "$accounts" = "0" ]; then
  echo "WAITING access  cloudflare token sees 0 accounts (needs Account -> Zero Trust: Edit); nothing applied"; exit 0
fi
echo "ok      access  cloudflare token sees $accounts account(s)"
: "${ESTATE_FOUNDER_EMAIL:?set ESTATE_FOUNDER_EMAIL (the email the front door admits)}"
: "${ESTATE_TEAM_NAME:=${zone%%.*}}"
# existing placeholder secrets are imported, never re-created (409 otherwise)
CID=$(oci vault secret list --compartment-id "$C" --name oauth2-proxy-client-id --query 'data[0].id' --raw-output 2>/dev/null || true)
CSEC=$(oci vault secret list --compartment-id "$C" --name oauth2-proxy-client-secret --query 'data[0].id' --raw-output 2>/dev/null || true)
# remote state when idp-oci-login rendered backend_override.tf (CI always; laptop after login)
if [ -f "$IDP/platform/access/backend_override.tf" ]; then tofu -chdir="$IDP/platform/access" init -input=false -migrate-state -force-copy >/dev/null
else echo "BLIND   state   platform/access/backend_override.tf missing: local state; run bin/idp-oci-login"; tofu -chdir="$IDP/platform/access" init -input=false >/dev/null; fi
tofu -chdir="$IDP/platform/access" "${1:-plan}" -input=false \
  -var "zone=$zone" -var "team_name=$ESTATE_TEAM_NAME" -var "founder_emails=[\"$ESTATE_FOUNDER_EMAIL\"]" \
  -var "compartment_ocid=$C" -var "vault_ocid=$V" -var "key_ocid=$K" \
  -var "client_id_secret_ocid=${CID:-}" -var "client_secret_secret_ocid=${CSEC:-}"
