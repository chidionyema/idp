#!/usr/bin/env python3
"""kubeconform grades TYPE on the exact bytes bin/idp-kyverno-render already produced for Kyverno
to grade POLICY on: kustomize build, helm template, the release's own postRenderers.

ONE render, judged twice -- but only when the caller passes --rendered. bin/idp-ci rung 9c does:
rung 9 sets IDP_RENDER_KEEP on the kyverno render it was already paying for, and hands this
script the kept directory, so the type check costs the render nothing (measured 2026-08-31:
kubeconform over 16 rendered files, 0.4 s). Called with no --rendered this script drives its own
render, which is a SECOND render of the same dirs -- convenient for a laptop, ~160 s on the
hosted runner (crew#584 measured that rung), never how CI calls it.

Why this exists (idp#1027, commit cd9911df): kustomize build re-emits every scalar plain, Flux's
envsubst then substituted a bare GitHub App id numeral into a quoted field, and the result typed
`spec.appID` an int where the GithubAccessToken CRD (generators.external-secrets.io/v1alpha1)
declares a string -- ".spec.appID: expected string, got 4740261". Kyverno grades whether a Pod is
ALLOWED; nothing before this script graded whether a field is the TYPE its schema declares.
tests/test_incident_idp1027_appid_types_as_a_string.py holds that exact shape as a permanent,
never-BLIND-passes fixture; this script is the estate's ongoing coverage of every other rendered
manifest, every PR, before merge.

Schema sourcing, decided once (LAW 43 -- kubeconform is the mature tool, not reinvented):
  * Built-in Kubernetes kinds (Deployment, Service, ...) come from kubeconform's own `default`
    schema location, a network fetch of yannh/kubernetes-json-schema pinned to the Kubernetes
    version below. The render this script drives already needs the network (helm pulls charts,
    CI clones the prospector policy checkout for bin/idp-kyverno-render), so this is not a new
    class of dependency the offline-gate job did not already carry.
  * The CRDs this estate actually ships against (Flux, external-secrets, Kyverno, Tailscale) are
    vendored under tests/fixtures/kubeconform/crd-schemas, pulled once from
    datreeio/CRDs-catalog, rather than fetched live from that catalog on every run: this repo has
    an offline-gate job, and idp#1027's own regression fixture must never go BLIND because a
    catalog CDN blinked. The set is eleven files (LAW 23, the smaller road) -- it is not a mirror
    of the whole catalog and is not trying to be one.
  * SPIRE ships no entry in datreeio/CRDs-catalog (spire-controller-manager's ClusterSPIFFEID is
    not published there); its resources, and any other CRD this estate adds without a vendored
    schema, fall through to `-ignore-missing-schemas`: kubeconform counts and prints them as
    `skipped`, visibly, in the same summary line as everything it did judge -- never silently
    treated as passing (LAW 28).

What this does NOT catch, stated because a control named for an incident that cannot catch it on
the live tree is this estate's third defect class: Flux substitutes ${vars} in the CLUSTER, after
everything here. In a render, `appID: ${githubAppIDQuoted}` is the literal string
"${githubAppIDQuoted}" -- a string, so it type-checks clean either way, and this rung would NOT
have refused idp#1027 on platform/hermes-agent. What refuses that exact shape is the permanent
fixture below (tests/test_incident_idp1027_appid_types_as_a_string.py), which holds the
post-substitution bytes. The live rung's coverage is every OTHER type error in every rendered
manifest -- a field typed int where its schema says string, a misspelled enum, a map where a list
belongs -- a class nothing in this pipeline graded before. Closing the substitution gap on the
live tree needs a stand-in value per key and is not this change.

Usage: bin/idp-kubeconform [platform-dir ...]      # renders, then judges (a second render)
       bin/idp-kubeconform --rendered DIR [dir...] # judges a render the caller already has;
                                                   # naming the dirs it should hold makes a
                                                   # partial render BLIND, never a pass
Exit 0 clean, 1 with each invalid or unrenderable resource printed, 2 (BLIND, never a pass) when
kubeconform is not installed or the render did not produce anything to judge.
"""

from __future__ import annotations

import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile

IDP = pathlib.Path(__file__).resolve().parents[1]
CRD_SCHEMAS = IDP / "tests" / "fixtures" / "kubeconform" / "crd-schemas"
# platform/oci/variables.tf pins the OKE cluster to v1.35.2; kubeconform's default schema fetch
# (yannh/kubernetes-json-schema) has not published that minor version yet (checked 2026-08-31:
# newest tag is v1.34.11). Nearest published minor, and configurable because the cluster's
# version and the schema registry's coverage move on two different clocks.
DEFAULT_K8S_VERSION = "1.34.11"
BAD_STATUSES = {"statusInvalid", "statusError"}


def platform_dirs(argv: list[str]) -> list[str]:
    if argv:
        return argv
    out = subprocess.run(
        [str(IDP / "bin" / "idp-kyverno-dirs")],
        check=True,
        capture_output=True,
        text=True,
    )
    return [d for d in out.stdout.splitlines() if d]


def render(dirs: list[str], keep: pathlib.Path) -> subprocess.CompletedProcess:
    env = {**os.environ, "IDP_RENDER_KEEP": str(keep)}
    return subprocess.run(
        [str(IDP / "bin" / "idp-kyverno-render"), *dirs],
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )


def missing_dirs(dirs: list[str], rendered: list[pathlib.Path]) -> list[str]:
    have = {p.name for p in rendered}
    return [d for d in dirs if f"kz-{d.replace('/', '_')}.yaml" not in have]


def judge(rendered: list[pathlib.Path], what: list[str]) -> int:
    """Type-check files that are already rendered. The two callers differ only in who
    paid for the render: bin/idp-ci rung 9c hands over rung 9's, a laptop drives its own."""
    kc = subprocess.run(
        [
            "kubeconform",
            "-summary",
            "-output",
            "json",
            "-ignore-missing-schemas",
            "-kubernetes-version",
            os.environ.get("IDP_KUBECONFORM_K8S_VERSION", DEFAULT_K8S_VERSION),
            "-schema-location",
            "default",
            "-schema-location",
            f"{CRD_SCHEMAS}/{{{{.Group}}}}/{{{{.ResourceKind}}}}_{{{{.ResourceAPIVersion}}}}.json",
            *[str(p) for p in rendered],
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        report = json.loads(kc.stdout)
    except json.JSONDecodeError:
        print("FAIL   kubeconform did not return a report:")
        sys.stderr.write(kc.stdout + kc.stderr)
        return 1
    for r in report.get("resources", []):
        if r["status"] in BAD_STATUSES:
            print(
                f"FAIL   {r['filename']}: {r['kind']} {r.get('name', '')} ({r['version']}): {r['msg']}"
            )
    s = report["summary"]
    line = f"valid={s['valid']} invalid={s['invalid']} errors={s['errors']} skipped={s['skipped']}"
    if s["invalid"] or s["errors"]:
        print(f"FAIL   kubeconform  {line}")
        return 1
    print(f"ok     kubeconform  {line} ({len(what)} source(s): {', '.join(what)})")
    return 0


def main(argv: list[str]) -> int:
    if shutil.which("kubeconform") is None:
        print(
            "BLIND  kubeconform is not installed; no rendered manifest was type-checked"
        )
        return 2
    handed_over = None
    if argv and argv[0] == "--rendered":
        if len(argv) < 2:
            print(
                "usage: bin/idp-kubeconform --rendered DIR [platform-dir ...]",
                file=sys.stderr,
            )
            return 64
        handed_over = pathlib.Path(argv[1])
        argv = argv[2:]
    if handed_over is not None:
        rendered = sorted(handed_over.glob("*.yaml"))
        if not rendered:
            print(
                f"BLIND  {handed_over} holds no rendered YAML; nothing was type-checked"
            )
            return 2
        # A handed-over render can be PARTIAL: bin/idp-kyverno-render copies out whatever it
        # produced even when it died early, and on 2026-08-31 main's own run 33355097800 died
        # exactly that way -- two chart downloads reset by the peer, so platform/healing and
        # platform/spire never rendered. Judging the survivors and printing `ok` would be a pass
        # over a subset, this estate's silent-green class (4 on the ledger). Any dir named on the
        # command line whose render is missing makes the whole verdict BLIND.
        gap = missing_dirs(argv, rendered) if argv else []
        if gap:
            print(
                f"BLIND  the handed-over render is missing {', '.join(gap)}; "
                "a subset was not judged and no verdict is given for any of it"
            )
            return 2
        return judge(rendered, argv or [f"handed over: {handed_over}"])
    dirs = platform_dirs(argv)
    if not dirs:
        print("BLIND  no platform dir to render; nothing was type-checked")
        return 2
    keep = pathlib.Path(tempfile.mkdtemp(prefix="idp-kubeconform-"))
    try:
        proc = render(dirs, keep)
        rendered = sorted(keep.glob("*.yaml"))
        if proc.returncode == 2:
            print(
                "BLIND  bin/idp-kyverno-render could not judge the whole policy set; "
                "kubeconform judges the same render and got none of it"
            )
            sys.stderr.write(proc.stdout + proc.stderr)
            return 2
        gap = missing_dirs(dirs, rendered)
        if gap:
            print(f"FAIL   render did not complete for: {', '.join(gap)}")
            sys.stderr.write(proc.stdout + proc.stderr)
            return 1
        if not rendered:
            print("BLIND  the render produced no YAML; nothing was type-checked")
            return 2
        return judge(rendered, dirs)
    finally:
        shutil.rmtree(keep, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
