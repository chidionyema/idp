#!/usr/bin/env bash
# bin/idp-slow-tests -- rewrite tests/slow-files.txt from a `pytest --durations=0` log.
#
# The list is the ONLY thing bin/idp-tests-for guesses about. Every test file that is not on it
# is cheap and always runs, so a new or renamed test file is always run until someone measures it
# slow. That is the safe direction: a stale list costs seconds, never coverage.
#
# pytest-split was the obvious tool and is rejected: it splits one suite across CI shards by
# recorded duration, which is a different question from "which tests must always run", and it
# would put a plugin on every runner to hold a file that pytest's own built-in --durations=0
# already prints. Nothing here is a new measurement mechanism.
#
#   .venv/bin/python -m pytest tests -n 4 -q --durations=0 > /tmp/d.log
#   bin/idp-slow-tests /tmp/d.log            # rewrite the list
#   bin/idp-slow-tests /tmp/d.log --check    # exit 1 if the committed list is stale
#
# SLOW_SECONDS (default 3) is the line. Measured 2026-08-29 on the estate Mac at -n 4: the suite
# is 2397 processor-seconds; at 3s, 216 of 324 timed files stay cheap and cost 164 of those
# seconds, about 41 seconds of waiting on four workers, and 108 files stay guessed.
set -euo pipefail
trap 'echo "FAIL  slow-tests: exit $? at line $LINENO" >&2' ERR
IDP="$(cd "$(dirname "$0")/.." && pwd)"
LOG="${1:?usage: bin/idp-slow-tests <durations.log> [--check]}"
OUT="$IDP/tests/slow-files.txt"
py="${IDP_PY:-}"
main="$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)/.."
for c in "$IDP/.venv/bin/python" "$main/.venv/bin/python"; do [ -n "$py" ] || { [ -x "$c" ] && py="$c"; }; done
py="${py:-python3}"
new=$(
	"$py" - "$LOG" "${SLOW_SECONDS:-3}" <<'PY'
import collections, re, sys
per = collections.Counter()
for line in open(sys.argv[1]):
    m = re.match(r"^\s*([0-9.]+)s\s+(?:call|setup|teardown)\s+(\S+)", line)
    if m:
        per[m.group(2).split("::")[0]] += float(m.group(1))
th = float(sys.argv[2])
slow = sorted(f for f, s in per.items() if s >= th)
if not slow:
    sys.exit("no file reached the threshold; that log is not a full run")
print(f"# Generated by bin/idp-slow-tests from a `pytest --durations=0` log. Do not edit by hand.")
print(f"# Every test file NOT listed here is cheap and is ALWAYS run by bin/idp-tests-for.")
print(f"# Threshold {th}s of processor time. {len(slow)} files, out of {len(per)} the run timed.")
print("\n".join(slow))
PY
)
if [ "${2:-}" = --check ]; then
	if [ "$new" = "$(cat "$OUT" 2>/dev/null)" ]; then
		echo "ok    slow-tests: $OUT matches that run"
		exit 0
	fi
	echo "FAIL  slow-tests: $OUT is stale; run bin/idp-slow-tests $LOG" >&2
	exit 1
fi
printf '%s\n' "$new" >"$OUT"
echo "ok    slow-tests: $(grep -cv '^#' "$OUT") slow file(s) written to tests/slow-files.txt"
