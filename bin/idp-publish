#!/usr/bin/env bash
# Make the primary portal URL reachable from the public internet, or stop.
#
# Separate from bin/idp-up on purpose. Starting the portal and publishing it to
# the world are different decisions with different blast radii, and LAW 21 says
# the default is closed. This command says exactly what becomes visible before
# it does anything.
set -euo pipefail

host=$(tailscale status --json | /usr/local/bin/jq -r '.Self.DNSName' | sed 's/\.$//')
DB="$HOME/dev/code/idp/catalog/estate.db"

case "${1:-}" in
  on)
    echo "About to make this readable by anyone with the URL:"
    echo
    if [ -f "$DB" ]; then
      sqlite3 "$DB" "select '  ' || count(*) || ' ' || kind || 's, with their paths and status' from assets group by kind order by count(*) desc"
    fi
    echo "  no credentials, no secrets, no transcripts"
    echo
    echo "  URL: https://$host:8443/"
    echo
    tailscale funnel --bg --https=8443 "http://127.0.0.1:3100"
    echo "PUBLIC. Stop it with: bin/idp-publish off"
    ;;
  off)
    tailscale funnel --https=8443 off 2>/dev/null || true
    tailscale serve --bg --https=8443 "http://127.0.0.1:3100" >/dev/null 2>&1 || true
    echo "Not public. https://$host:8443/ is tailnet only again."
    ;;
  *)
    echo "usage: idp-publish on|off" >&2
    tailscale funnel status 2>&1 | sed 's/^/  /'
    exit 2
    ;;
esac
