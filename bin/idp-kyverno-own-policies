#!/usr/bin/env python3
"""Every ClusterPolicy this repo ships under platform/, appended to a rendered policy set.

crew#516, 2026-08-28: bin/idp-kyverno-render read the sibling prospector checkout and never this
repo, so three ClusterPolicies the estate ships and the cluster enforces --
platform/edge/kyverno-secrets-policy.yaml, platform/scheduling/capacity-affinity.yaml,
platform/scheduling/require-priority-class.yaml -- were applied to no render, ever. Same class as
crew#539 one file up: a rule that stops a merge on the cluster and not before it.

They are found by walking platform/, never by a list, so a policy added tomorrow is judged
tomorrow with nobody remembering this file exists.

Usage: own-policies.py <platform-dir> <rendered-policies.yaml>   # appends, prints what it added
"""
import os
import sys

import yaml


def cluster_policies(root):
    for dirpath, _, names in os.walk(root):
        for n in sorted(names):
            if not n.endswith((".yaml", ".yml")):
                continue
            path = os.path.join(dirpath, n)
            try:
                docs = list(yaml.safe_load_all(open(path)))
            except (yaml.YAMLError, UnicodeDecodeError):
                # A Helm values template or a chart's own multi-doc is not a policy; a file the
                # loader cannot read has no `kind: ClusterPolicy` to miss.
                continue
            for d in docs:
                if isinstance(d, dict) and d.get("kind") == "ClusterPolicy":
                    name = (d.get("metadata") or {}).get("name")
                    if name:
                        yield name, os.path.relpath(path, root), d


def main(root, out):
    have = {
        d["metadata"]["name"]
        for d in yaml.safe_load_all(open(out))
        if isinstance(d, dict) and d.get("kind") == "ClusterPolicy" and (d.get("metadata") or {}).get("name")
    }
    added = []
    for name, rel, doc in cluster_policies(root):
        # The rendered set wins a name collision: it is what the cluster runs today.
        if name in have:
            continue
        have.add(name)
        added.append((name, rel))
        with open(out, "a") as f:
            f.write("---\n" + yaml.safe_dump(doc, sort_keys=False))
    print(" ".join(f"{n}({p})" for n, p in added))


if __name__ == "__main__":
    main(sys.argv[1], sys.argv[2])
