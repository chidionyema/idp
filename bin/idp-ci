# 11. crew#219 R39: the acceptance suite is executable. The 35 Gherkin files in
#     features/sovereign-bus/ were prose until now -- crew#200 measured "61
#     .feature files in idp, 0 step dirs". pytest-bdd binds them to pytest, so
#     this is one more leg of the gate that already exists and not a second
#     runner (the tool rejected is behave, which brings its own).
#
#     Proved both ways in the same run, because a gate only ever seen passing
#     has never been shown to refuse (LAW 38): the unbound fixture must fail
#     with StepDefinitionNotFoundError -- not merely fail, or a typo in a
#     feature path would satisfy the guard -- and the real suite must pass.
# crew#584, measured on run 33202098401: these two suites took 132 of offline-gate's 211 s, and
# ci.yml's bdd job ran the same two suites again, strictly, in parallel. In CI the bdd job owns
# them and offline-gate sets IDP_CI_SKIP_PYTEST=1; locally (pre-push, bin/idp-ci by hand) they run.
if [ "${IDP_CI_SKIP_PYTEST:-0}" = 1 ]; then
  say "skip  bdd+incident: run once, by the ci bdd job (IDP_CI_SKIP_PYTEST=1)"
else
BDD_PY="$MPY"
"$BDD_PY" -c 'import pytest_bdd' >/dev/null 2>&1 || BDD_PY=python3
# crew#584 zero-bottleneck law (founder 2026-08-28: "zero bottleneck law optinise ruthlessly"): run
# 33198380701 spent 106 s here and 73 s in 8b on one of the runner's four cores. pytest-xdist is
# already a dev dependency; when it imports, both rungs fan out. Missing xdist is serial, never a skip.
XD=""; "$BDD_PY" -c 'import xdist' >/dev/null 2>&1 && XD="-n auto"
if ! "$BDD_PY" -c 'import pytest_bdd' >/dev/null 2>&1; then
  say "FAIL  bdd      pytest-bdd is not installed: pip install -r sovereign/requirements-dev.txt"; fail=1
else
  # Captured, never piped into grep: this script sets pipefail and pytest exits
  # non-zero on purpose here, which is the incident guard 1c is about.
  bdd_bad=$("$BDD_PY" -m pytest "$IDP/sovereign/tests/fixtures/bdd/unbound" -q 2>&1)
  bdd_good=$("$BDD_PY" -m pytest "$IDP/sovereign/tests/bdd" -q $XD 2>&1); bdd_good_rc=$?
  if printf '%s' "$bdd_bad" | grep 'StepDefinitionNotFoundError' >/dev/null && [ "$bdd_good_rc" -eq 0 ]; then
    say "ok    bdd      $(printf '%s' "$bdd_good" | grep -oE '[0-9]+ passed' | head -1), $(printf '%s' "$bdd_good" | grep -c '^  pending ') feature(s) pending; an unbound step is refused"
    printf '%s' "$bdd_good" | grep '^  pending ' | sed 's/^/      /'
  else
    say "FAIL  bdd      sovereign/tests/bdd (rc=$bdd_good_rc), or the unbound fixture was not refused for the right reason"
    printf '%s\n' "$bdd_good" | tail -25 | sed 's/^/      /'
    printf '%s\n' "$bdd_bad" | tail -5 | sed 's/^/  bad /'
    fail=1
  fi
fi

# 8b. Every incident test (rung 4, one per bug, named for it). Incident 2026-08-25: six
#     tests/test_incident_*.py files existed and none ran anywhere -- this script ran four
#     named files and the bdd suite, ci.yml ran sovereign/tests/bdd. A PR body that says
#     "bin/idp-ci runs the incident test on every PR" was a claim with no receipt. Tests
#     that need kyverno or a sibling checkout skip as BLIND and say so; a skip is printed.
inc=$("$BDD_PY" -m pytest -q -p no:cacheprovider $XD "$IDP"/tests/test_incident_*.py 2>&1); inc_rc=$?
if [ "$inc_rc" -eq 0 ]; then
  say "ok    incident $(printf '%s' "$inc" | grep -oE '[0-9]+ passed' | head -1), $(printf '%s' "$inc" | grep -oE '[0-9]+ skipped' | head -1 || printf '0 skipped') (BLIND skips)"
  printf '%s\n' "$inc" | grep -oE 'BLIND: [^)]*' | sort -u | sed 's/^/      /'
else
  say "FAIL  incident tests/test_incident_*.py (rc=$inc_rc)"; printf '%s\n' "$inc" | tail -20 | sed 's/^/      /'; fail=1
fi
fi  # IDP_CI_SKIP_PYTEST

# 8c. The docs site builds strict (ADR 0002, crew#603). Every page is in a Diataxis folder
#     (tutorials, how-to, reference, explanation, decisions), every nav entry resolves and no
#     link is dead. Before this rung the sweep that moved 169 files could break every Backstage
#     techdocs page and nothing here would say so. BLIND when mkdocs is missing, never a pass.
#     Scoped on a pull request (2026-09-04): the site is built from docs/ and mkdocs.yml and
#     nothing else, so a diff that touches neither cannot change the verdict this rung reached
#     on main. Measured at 11 s on run 33868999215.
if ! touched docs/ mkdocs.yml bin/idp-ci; then
  say "ok    docs     no docs/ or mkdocs.yml change against $IDP_CI_BASE; the site was built on main"
elif command -v mkdocs >/dev/null; then
  mkd=$(cd "$IDP" && mkdocs build --strict -q -d "${TMPDIR:-/tmp}/idp-ci-site.$$" 2>&1); mkd_rc=$?
  rm -rf "${TMPDIR:-/tmp}/idp-ci-site.$$"
  if [ "$mkd_rc" -eq 0 ]; then
    say "ok    docs     mkdocs --strict built $(cd "$IDP" && grep -cE '^\s+- .*\.md$' mkdocs.yml) nav page(s)"
  else
    say "FAIL  docs     mkdocs --strict (rc=$mkd_rc)"; printf '%s\n' "$mkd" | tail -20 | sed 's/^/      /'; fail=1
  fi
else say "BLIND docs     mkdocs not installed; the docs site was not built"; fail=1; fi

# 9. Every Flux HelmRelease under platform/ renders clean against the cluster's Kyverno
#    ClusterPolicies (helm template + the release's own postRenderers), both ways: the
#    unpatched-chart fixture must be refused. Kyverno judges at admission, after merge;
#    this judges before the PR. BLIND (rc 2) when helm/kyverno are missing, never a pass.
if command -v kyverno >/dev/null && command -v helm >/dev/null; then
  # Every HelmRelease dir, plus any dir shipping a plain workload (crew#284: the litellm
  # Deployment was never judged and the cluster refused it after merge; crew#539 2026-08-28: the
  # robusta release carried no postRenderers, was never judged, and admission refused it on 15 rules).
  # bin/idp-kyverno-dirs owns this list (crew#623: two globs here disagreed and three dirs,
  # platform/commerce/data among them, were judged by nothing at all).
  dirs=$(cd "$IDP" && bin/idp-kyverno-dirs)
  # rc 2 is BLIND: the judge ran but not against the whole policy set, and crew#539 is what that
  # costs -- CI printed "render clean" for a Deployment admission refused, because the two
  # estate-only policies live in prospector and CI had no copy. Blind and failing are different
  # facts and the operator needs to be told which one this is.
  # crew#584 zero-bottleneck law: this rung was 160 s of the 422 s run 33198380701 spent in
  # bin/idp-ci, and #625's parallel render bought 12 s of it on the hosted runner. On a pull
  # request (IDP_CI_BASE names the base ref, set by ci.yml) only the dirs the diff touches are
  # judged; the whole set is judged on main, and on any PR that moves the judge, a policy, a
  # kyverno fixture or the cluster wiring, because then every render's verdict can change. A
  # dir with no changed file cannot render differently from main, where it was judged.
  kyv_scope="every dir"
  if [ -n "${IDP_CI_BASE:-}" ] && changed=$(cd "$IDP" && git diff --name-only "$IDP_CI_BASE...HEAD" 2>/dev/null); then
    # clusters/oke/flux-system/ is Flux's own controllers (gotk-components.yaml) and the sync
    # wiring. Nothing in it is a postBuild substitution source and no platform render reads it, so
    # a change there cannot alter any render's verdict -- unlike clusters/oke/estate-config.yaml,
    # which is a substitution source and stays in the escalation below. Measured 2026-09-04:
    # idp#1431 added one annotation to clusters/oke/flux-system/kustomization.yaml, escalated to
    # every dir, and offline-gate's bin/idp-ci step ran over 8 min against 56 s on the run before.
    if printf '%s\n' "$changed" | grep -vE '^clusters/oke/flux-system/' | grep -E '^(bin/idp-kyverno-render|bin/idp-ci|tests/fixtures/kyverno/|platform/kyverno/|platform/policies/|clusters/)' >/dev/null ; then
      kyv_scope="every dir: the judge, a policy or the cluster wiring changed"
    else
      scoped=$(for d in $dirs; do printf '%s\n' "$changed" | grep "^$d/" >/dev/null && echo "$d"; done)
      kyv_scope="$(printf '%s\n' "$scoped" | grep -c .) of $(printf '%s\n' "$dirs" | grep -c .) dirs changed against $IDP_CI_BASE"
      dirs="$scoped"
    fi
  fi
  if [ -z "$dirs" ] && [ "$kyv_scope" != "every dir" ]; then
    say "ok    kyverno  no platform dir changed against $IDP_CI_BASE; every render was judged on main (scoped: $kyv_scope)"
    dirs=skip
  fi
  # IDP_RENDER_KEEP: rung 9c type-checks these exact bytes. One render, judged twice -- Kyverno
  # for POLICY here, kubeconform for TYPE below. Rendering again would cost this job the whole
  # 160 s again (crew#584 measured it), so the render this rung already pays for is handed over.
  [ "$dirs" = skip ] || kyv=$( (cd "$IDP" && IDP_RENDER_KEEP="$tmp/render" bin/idp-kyverno-render $dirs) 2>&1 ); kyv_rc=$?
  if [ "$dirs" = skip ]; then :
  elif [ -z "$dirs" ]; then say "FAIL  kyverno  no platform dir shipped a HelmRelease or a workload; the judge had nothing"; fail=1
  elif [ "$kyv_rc" = 2 ]; then
    say "BLIND kyverno  the judge did not see the whole policy set; no render was judged"
    printf '%s\n' "$kyv" | grep '^BLIND' | sed 's/^/      /'; fail=1
  elif [ "$kyv_rc" != 0 ]; then
    say "FAIL  kyverno  a HelmRelease or workload render fails admission policy"
    # crew#292: this line was `grep -E '^(FAIL|      )'`. It reads the verdict shapes the judge
    # prints when it reaches a verdict, and nothing else. A render that dies before any verdict --
    # kustomize `error: must build at directory`, a helm template failure, a missing chart -- prints
    # neither shape, the grep matched nothing, and the operator was left with the headline and a bare
    # underline: no dir, no policy, no cause (offline-gate on run 33173089759). An instrument that
    # destroys the cause is not an instrument (LAW 28) and nobody can attribute from it (LAW 29).
    # Every line that is not an `ok` verdict travels, tail-capped so one rung stays one screen.
    #
    # crew#292 again, 2026-08-28: the cap above was `| tail -40` over the whole block, and with two
    # failing dirs it ate the first one whole. Measured on the shipped block: `platform/state` with 25
    # policy lines followed by `platform/litellm` with 25 gives 52 non-`ok` lines, the cap keeps the
    # last 40, and `FAIL  plain    platform/state` survives in zero of them -- the block opens
    # mid-stream on `policy rule-12 -> state-collector failed` with no dir above it and nothing saying
    # 12 lines were cut. The operator reads one failing dir where there are two and attributes to the
    # wrong one: the same shape the `grep -E '^(FAIL|      )'` above cost us (LAW 28, LAW 29), moved
    # to a threshold instead of removed. That case is not hypothetical -- it is what a Kyverno policy
    # bump looks like, which is exactly when the cap fires.
    #
    # So the cap stays 40 lines total (a rung is still one screen) but it is no longer blind or
    # silent: the `FAIL` lines are the index into the failure and are printed first, uncapped, then
    # one line saying how many were dropped, then the tail of what is left. Under 40 lines this is
    # byte-identical to the block above it.
    body=$(printf '%s\n' "$kyv" | grep -vE '^ok ')
    n=$(printf '%s\n' "$body" | grep -c . )
    if [ "$n" -gt 40 ]; then
      dirs_failed=$(printf '%s\n' "$body" | grep -c '^FAIL')
      printf '%s\n' "$body" | grep '^FAIL' | sed 's/^/      /'
      say "      ... $((n - 40)) of $n lines dropped by the cap; $dirs_failed dir(s) failed, named above"
      rest=$((40 - dirs_failed - 1)); [ "$rest" -lt 0 ] && rest=0
      printf '%s\n' "$body" | grep -vE '^FAIL' | tail -n "$rest" | sed 's/^/      /'
    else
      printf '%s\n' "$body" | sed 's/^/      /'
    fi
    fail=1
  elif (cd "$IDP" && bin/idp-kyverno-render tests/fixtures/kyverno/must-fail >/dev/null 2>&1); then
    say "FAIL  kyverno  the must-fail fixture passed; the judge admits an unpatched chart"; fail=1
  else say "ok    kyverno  $(echo "$dirs" | tr '\n' ' ')render clean; the unpatched-chart fixture is refused ($kyv_scope)"; fi
else say "FAIL  kyverno  helm or kyverno CLI not installed -- run bin/idp-install-deps"; fail=1; fi

# 9c. idp#1027 (run 33339964930): the cluster refused `.spec.appID: expected string, got 4740261`
#     -- a field typed int where its CRD declares a string. Kyverno grades whether a resource is
#     ALLOWED and passed that shape happily; nothing in this pipeline graded whether a field is
#     the TYPE its schema declares. kubeconform does, on rung 9's render (IDP_RENDER_KEEP above),
#     against kubeconform's built-in Kubernetes schemas plus the CRD schemas vendored under
#     tests/fixtures/kubeconform/crd-schemas. Kinds with no vendored schema are counted and
#     printed as `skipped`, never silently passed (LAW 28). BLIND, never a pass, with no binary.
#     What this rung does NOT catch is stated in bin/idp-kubeconform's docstring: Flux substitutes
#     ${vars} in the cluster, so a render holds the literal "${githubAppIDQuoted}" -- a string
#     either way. The idp#1027 shape itself is held by
#     tests/test_incident_idp1027_appid_types_as_a_string.py, which judges the post-substitution
#     bytes. This rung is the ongoing coverage of every other type error in every rendered manifest.
if [ "${dirs:-}" = skip ]; then say "ok    types    no platform dir changed against ${IDP_CI_BASE:-main}; every render was type-checked on main"
elif [ ! -d "$tmp/render" ]; then say "BLIND types    rung 9 kept no render; nothing was type-checked"; fail=1
else
  # $dirs is passed so a render that died early (a chart download reset by the peer, as main's
  # own run 33355097800 did) is BLIND, never an `ok` over the files that happened to survive.
  # shellcheck disable=SC2086
  kcf=$( (cd "$IDP" && bin/idp-kubeconform --rendered "$tmp/render" $dirs) 2>&1 ); kcf_rc=$?
  if [ "$kcf_rc" = 0 ]; then say "ok    types    $(printf '%s' "$kcf" | tail -1 | sed 's/^ok *kubeconform *//')"
  elif [ "$kcf_rc" = 2 ]; then say "BLIND types    kubeconform did not judge the render:"; printf '%s\n' "$kcf" | sed 's/^/      /'; fail=1
  else say "FAIL  types    a rendered manifest does not match the type its schema declares:"; printf '%s\n' "$kcf" | sed 's/^/      /'; fail=1; fi
fi

# 9b. crew#483: Flux post-build substitution judged with the tool Flux runs. Every Kustomization
#     that declares postBuild renders (kustomize build | flux envsubst --strict) with its sources'
#     keys; the fixture carrying an unescaped shell `${out%% *}` must be refused and the `$$`
#     form must pass. BLIND (rc 2) when flux or kustomize is missing, never a pass.
es_out=$(cd "$IDP" && bin/idp-envsubst-gate 2>&1); es_rc=$?
if [ "$es_rc" -eq 2 ]; then say "BLIND envsubst $(printf '%s' "$es_out" | tail -1)"; fail=1
elif [ "$es_rc" -eq 0 ] && (cd "$IDP" && bin/idp-envsubst-gate tests/fixtures/envsubst/good >/dev/null 2>&1) && ! (cd "$IDP" && bin/idp-envsubst-gate tests/fixtures/envsubst/bad >/dev/null 2>&1); then
  say "ok    envsubst $(printf '%s' "$es_out" | grep -c '^ok') Kustomization(s) substitute clean; the unescaped-shell fixture is refused"
else say "FAIL  envsubst a postBuild Kustomization is refused by flux envsubst --strict, or the fixtures did not prove both ways:"; printf '%s\n' "$es_out" | grep -v '^ok' | sed 's/^/      /'; fail=1; fi

# 10. crew#269 row 3: a Component with no URL a person can open fails the PR, both ways.
#     The clean fixture must pass bin/catalog-links-check and a checkout with no remote
#     must be refused. Row 2 made every route an Open link; this keeps a linkless
#     entity from landing again (sweep on the live inventory before this: N=2).
lk="$tmp/links-bad"; mkdir -p "$lk"
if INV="$FIX" OUT="$a" python3 "$IDP/bin/catalog-gen" >/dev/null 2>&1 \
   && lk_ok=$(python3 "$IDP/bin/catalog-links-check" "$a/catalog-info.yaml") \
   && INV="$IDP/tests/fixtures/inventory.no-remote.json" OUT="$lk" python3 "$IDP/bin/catalog-gen" >/dev/null 2>&1 \
   && ! python3 "$IDP/bin/catalog-links-check" "$lk/catalog-info.yaml" >/dev/null 2>&1; then
  say "ok    links    $lk_ok; a checkout with no remote is refused"
else say "FAIL  links    catalog-links-check passed a linkless Component or refused the clean fixture"; fail=1; fi


# crew#584 CP2: this gate mirrors what CI runs, so a laptop that has not wired core.hooksPath at
# .githooks is one where the pre-push hook does not fire and the local gate above never blocks a
# push -- the exact class of failure that cost idp#3627 three CI cycles on 2026-09-16. Loud
# banner, not a refusal (a fence a correct machine cannot satisfy is an outage, LAW 38): the
# founder always sees whether his clone will actually refuse a bad push.
_hp="$(git -C "$IDP" config --local core.hooksPath 2>/dev/null || true)"
if [ "$_hp" != ".githooks" ] && [ -z "${IDP_CI_BASE:-}" ]; then
  echo ""
  echo "  WARN  hooks   core.hooksPath is ${_hp:-unset} -- .githooks/pre-push will NOT run on push"
  echo "                run: bin/idp-install-hooks (idempotent) to close the gap"
  echo ""
fi

# Local evidence chain: developer-local, only meaningful outside CI. Skip when IDP_CI_BASE
# is set (the runner has no agent session; the file would be whatever a developer's local wrote,
# and rebases routinely break the chain -- measured on 2026-09-22, offline-gate on run 35751378908).
if [ -z "${IDP_CI_BASE:-}" ]; then
  if python3 "$IDP/bin/idp-local-evidence-gate" "$IDP/.aevum/local.jsonl" >/dev/null 2>&1; then
    say "ok    local-evidence chain present and intact"
  else
    say "FAIL  local-evidence .aevum/local.jsonl is empty or chain is broken -- no agent action has been recorded"; fail=1
  fi
else
  say "skip  local-evidence developer-local; CI cannot have an agent session"
fi

# ADR 0030: Jev scope guard -- no direct TypeSafeClient calls outside mcp/plugins/jev.py.
# This is the forcing function that ensures every Jev call goes through the MCP plugin,
# so every decision lands in estate.db and the API key lives in one place.
if python3 "$IDP/bin/idp-jev-scope-guard" >/dev/null 2>&1; then
  say "ok    jev-scope no direct TypeSafeClient calls outside mcp/plugins/jev.py"
else
  say "FAIL  jev-scope direct TypeSafeClient usage found; route through mcp/plugins/jev.py"; fail=1
fi

timing_summary
[ "$fail" -eq 0 ] && say "PASS  idp-ci" || say "FAIL  idp-ci"
# --full: write sentinel on success so the pre-push hook proceeds without re-running.
if [ "$FULL" = 1 ] && [ "$fail" -eq 0 ]; then
  _sha=$(git -C "$IDP" rev-parse HEAD 2>/dev/null || echo unknown)
  mkdir -p "$HOME/.cache/idp-ci-verified"
  touch "$HOME/.cache/idp-ci-verified/$_sha"
  say "ok    verified  sentinel written for $_sha"
fi
exit "$fail"
# Decision 0028: the evidence layer's live case. This is not the fixture pair again -- it grades
# the REAL manifest the cluster reconciles, and it asserts the two properties whose absence is
# silent: (1) aevum.yaml is wired into the observability kustomization, so the Deployment is
# actually applied rather than sitting in the tree unreferenced, and (2) it never configures the
# in-memory store, which reports a valid empty chain after every restart. A gate that graded only
# its own fixtures would never see either.
if grep -q '^  - aevum.yaml$' "$IDP/platform/observability/kustomization.yaml" \
   && ! grep -q 'in-memory' "$IDP/platform/observability/aevum.yaml" \
   && grep -q 'initialize_ledger_schema' "$IDP/platform/observability/aevum.yaml" \
   && grep -q 'sigchain=sigchain' "$IDP/platform/observability/aevum.yaml" \
   && python3 "$IDP/bin/idp-evidence-gate" "$IDP/tests/fixtures/aevum-evidence/good/chain.json" >/dev/null 2>&1 \
   && ! python3 "$IDP/bin/idp-evidence-gate" "$IDP/tests/fixtures/aevum-evidence/bad/chain.json" >/dev/null 2>&1; then
  say "ok    evidence the evidence layer is applied, is configured with a persistent store, and its gate refuses an altered record while passing a clean one"
else say "FAIL  evidence the evidence layer is unreferenced by its kustomization, or is configured on the in-memory store, or its gate does not discriminate"; fail=1; fi

# incident 2026-09-12: platform/observability/aevum.yaml shipped external-secrets.io/v1beta1, a
# version this estate had already migrated off. CI was green -- the file is valid YAML -- and the
# failure appeared only in Flux, where the observability Kustomization went NotReady and took the
# chaos and science rows down with it on their dependency. The live case here grades the real tree,
# not the fixture pair.
if python3 "$IDP/bin/idp-api-version-gate" "$IDP/platform" "$IDP/clusters" >/dev/null 2>&1 \
   && ! python3 "$IDP/bin/idp-api-version-gate" "$IDP/tests/fixtures/api-version/bad" >/dev/null 2>&1 \
   && python3 "$IDP/bin/idp-api-version-gate" "$IDP/tests/fixtures/api-version/good" >/dev/null 2>&1; then
  say "ok    apiversion no manifest in platform/ or clusters/ names a group/version this estate has migrated off"
else say "FAIL  apiversion a manifest names a retired group/version, or the gate does not discriminate"; fail=1; fi
fi
