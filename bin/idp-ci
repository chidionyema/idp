# LAW 32 at the PR (founder, 2026-08-25): a new bin file needs docs/tutorials/demo + docs/how-to/onboarding;
# every such page has 200 chars of prose and is in the nav. Proved both ways in one run.
if python3 "$IDP/bin/law32-gate" --added bin/supply-chain >/dev/null 2>&1 \
   && ! python3 "$IDP/bin/law32-gate" --added bin/feature-with-no-pages >/dev/null 2>&1 \
   && python3 "$IDP/bin/law32-gate" >/dev/null 2>&1; then
