  else say "$out"; fail=1; fi
else say "BLIND migration dagster not importable; gate not run"; fail=1; fi

# 5. Every generated entity validates against the published Backstage schema.
python3 - "$tmp/catalog-info.yaml" "$tmp/docs" <<'PY'
import sys, os, yaml, json
src, out = sys.argv[1], sys.argv[2]; os.makedirs(out)
for i, d in enumerate(yaml.safe_load_all(open(src))):
    json.dump(d, open(f"{out}/{i}.json", "w"))
PY
if check-jsonschema --schemafile https://json.schemastore.org/catalog-info.json "$tmp"/docs/*.json >/dev/null 2>&1; then
  say "ok    schema   $(ls "$tmp"/docs | wc -l | tr -d ' ') entity documents valid"
else say "FAIL  schema   check-jsonschema rejected a generated entity"; fail=1; fi

# The gate helpers the rungs below call. The rung that ran each of them against a .bad and
# a .good fixture on every run is gone (founder 2026-09-04: "run each of the nine gates in the
# AGENTS.md table against its two fixtures ... this is stupid") -- it graded this file's own
# fixtures, never the estate, and no defect in the running platform could ever fail it.
policy_gate() { conftest test --parser json -p "$IDP/policy" "$1" >/dev/null 2>&1; }
bind_audit() { "$IDP/bin/bind-audit" --table "$1" >/dev/null 2>&1; }
ns_fence_gate() { python3 "$IDP/bin/ns-fence-gate" "$1" >/dev/null 2>&1; }
job_described() { ( cd "$IDP/scheduler" && python3 -m estate_scheduler.describe "$1" ) >/dev/null 2>&1; }
main_verdict_gate() { python3 "$IDP/bin/main-verdict-gate" "$1" >/dev/null 2>&1; }
# A code location is loaded by PATH by workspace.yaml, never as a package. Loading
# it any other way here would grade a proxy: on 2026-08-25 definitions.py imported a
# sibling with `from .describe import`, passed every offline check, and put the live
# code location in PythonError the moment it reloaded. So: load it the way it runs.
prose_pin_scan() { python3 "$IDP/bin/test-prose-gate" "$1" >/dev/null 2>&1; }
flux_subst_scan() { python3 "$IDP/bin/idp-flux-subst-gate" "$1" >/dev/null 2>&1; }
# decision 0021 two-hats: grades a platform/otto-gateway seed.sql for the three rules in
# bin/idp-tenant-split. Takes one file (the fixture path, per the table convention), exits 0
# when that file is clean of cross-plane leaks, 1 otherwise.
tenant_split_gate() { python3 "$IDP/bin/idp-tenant-split" "$1" >/dev/null 2>&1; }
# zero-trust-boundary.md step 1 (work order item 1): grades one probe report with
# bin/idp-fence-enforcement. Very deliberately NOT a no-argument gate: it takes ONE fixture path so
# the rung below can prove it both ways in a single run, exactly like tenant_split_gate above.
fence_enforcement_gate() { python3 "$IDP/bin/idp-fence-enforcement" "$1" >/dev/null 2>&1; }
# platform/calico README cutover (work order item 0): parses ONE calico-packet deny feed with
# bin/idp-calico-deny-log. Takes one fixture path so the rung can prove it both ways in one run.
calico_denyflow_gate() { python3 "$IDP/bin/idp-calico-deny-log" "$1" >/dev/null 2>&1; }
defs_validate() { ( cd "$(dirname "$1")" && DAGSTER_HOME="$(mktemp -d)" "$MPY" -m dagster definitions validate -f "$(basename "$1")" ) >/dev/null 2>&1; }
# 6a. main's verdict, against the live workflows rather than the fixtures (crew#865). On 2026-09-05
#     nine of twelve ci runs on main were cancelled by the commit after them, so the one branch the
#     estate is graded on almost never produced a grade. The row above proves the gate both ways;
#     this runs it on .github/workflows/, where a real regression fails it.
if out=$(python3 "$IDP/bin/main-verdict-gate" 2>&1); then say "ok    verdict  $(tail -1 <<<"$out")"
else say "FAIL  verdict  bin/main-verdict-gate refuses .github/workflows/"; sed 's/^/               /' <<<"$out"; fail=1; fi

# 6b. R76 (founder 2026-09-03): the no-prose rule holds over the whole test tree, not just
#     the fixtures. A test function that only asserts wording is refused here by name.
if out=$(python3 "$IDP/bin/test-prose-gate" "$IDP"/tests/test_*.py); then
  say "ok    prose    no test function only asserts prose (R76)"
else
  say "FAIL  prose    a test function only asserts prose/string membership in file text (R76)"
  printf '%s\n' "$out" | sed 's/^/      /'; fail=1
fi

# 6. decision 0021 two-hats (bin/idp-tenant-split): proved both ways in one run, per the rule
#    the estate deleted on 2026-09-04 -- a gate with no fixture that refuses it grades nothing.
#    The bad fixture lays one secret under two tenants (acceptance: refused), the good one is
#    the clean customer-zero/alerts-bot split (acceptance: passed). The live repo seed still
#    carries the pre-change-1 mislabel and so is NOT yet clean; change 1 (binding-seed.yaml ->
#    customer-zero) is a separate item and flips the repo green on its own PR.
if ! tenant_split_gate "$IDP/tests/fixtures/tenant-split/bad.yaml" \
   && tenant_split_gate "$IDP/tests/fixtures/tenant-split/good.yaml"; then
  say "ok    twohats  idp-tenant-split refuses one secret under two tenants; the clean split passes"
else
  say "FAIL  twohats  idp-tenant-split cannot tell one-secret-one-tenant from a leak (decision 0021)"; fail=1
fi

# 6c. zero-trust-boundary.md step 1 (work order item 1): a denied packet is dropped, and a probe
#     that could not run is a fail-closed FAIL, never a pass. Proved three ways in one run: the
#     good fixture (prover reached an allowed path, both denies refused) must pass, while a fence
#     that lets the cross-namespace packet through and a report whose probe never ran must both be
#     refused. The value of the third fixture is the exact first-pass error this spec names: a
#     missing probe binary (shell 127) that read as a passing wall.
if fence_enforcement_gate "$IDP/tests/fixtures/fence-drill/gate-good.json" \
   && ! fence_enforcement_gate "$IDP/tests/fixtures/fence-drill/gate-broken-fence.json" \
   && ! fence_enforcement_gate "$IDP/tests/fixtures/fence-drill/gate-fail-closed.json"; then
  say "ok    fencdrill fence-enforcement drops a denied packet, fails closed when the probe could not run"
else
  say "FAIL  fencdrill fence-enforcement cannot tell a dropped packet from a leak or a dead probe (ZT step 1)"; fail=1
fi

# 6d. platform/calico cutover gate (work order item 0): the 39 generated policies stay unwired
#     until a deny feed has been read over a full cycle and allowances.yaml corrected. Proved two
#     ways in one run: a feed that carries real calico-packet deny lines must parse into flows
#     (PASS), while a feed with no parsed deny line must FAIL closed -- an empty or foreign log is
#     not evidence of a clean bill.
if calico_denyflow_gate "$IDP/tests/fixtures/calico-denyflow/feed-with-deny.log" \
   && ! calico_denyflow_gate "$IDP/tests/fixtures/calico-denyflow/feed-no-evidence.log"; then
  say "ok    denyflow calico deny-feed parses into flows; an empty feed fails closed (README cutover)"
else
  say "FAIL  denyflow calico deny-feed cannot tell a denied flow from no evidence (platform/calico README)"; fail=1
fi

# 6b. The namespace fence, against the estate rather than against its own fixtures (crew#839).
#     Until now ns_fence_gate ran only inside the loop above, on tests/fixtures/ns-fence/*.yaml,
