#!/usr/bin/env bash
# One-time tenancy bootstrap for ADR 0004, repeatable and unattended except for one browser
# login. Rejected: `oci setup config` (interactive, writes the private key unvaulted to disk,
# and puts the key on the founder's own admin user). This script:
#   1. logs in once through the browser (the founder's one browser login, token lives one
#      hour; crew#345: this bootstrap is the only path that needs it -- every session reads
#      the estate through receipts, bin/idp-cluster-state and oke-check.yml on OIDC);
#   2. creates compartment `estate`, group `estate-operators`, user `estate-tofu` and one
#      least-privilege policy, all idempotent;
#   3. generates the API key pair here, registers the PUBLIC half on estate-tofu, and stores
#      the private half in the sops vault. The private key is never in Downloads, never in
#      argv, never printed (LAW 21).
# Re-running is safe: existing IAM objects are reused; a new key is added only with --rotate.
set -euo pipefail

if [ "${1:-}" = "--self-test" ]; then echo "ok  bin/idp-oci-bootstrap --self-test"; exit 0; fi
IDP="$(cd "$(dirname "$0")/.." && pwd)"
# estate-secrets sits beside the main checkout, even when this runs from a worktree under .claude/worktrees (crew#408)
MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
VAULT="${ESTATE_SECRETS:-$(dirname "$MAIN")/estate-secrets}"
export SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}"
ENV_NAME="${OCI_ENV:-dev}"
for t in oci sops openssl jq; do command -v "$t" >/dev/null || { echo "BLIND $t missing"; exit 2; }; done
[ -d "$VAULT/secrets/$ENV_NAME" ] || { echo "BLIND vault not at $VAULT"; exit 2; }

# 2026-09-18: this was one line -- `sops -d ... 2>/dev/null` -- and it cost the founder three
# commands in a row. `2>/dev/null` hid sops's own error, `set -e` then killed the script at the
# FIRST vget call (line 48, OCI_REGION), so execution never reached line 51's guard. The script
# exited 100 with no stdout and no stderr, and `bin/idp-oci-login` -- whose only advice is to run
# this script -- sent him straight back. Two scripts pointing at each other, neither speaking.
#
# The two failures are different and must read differently:
#   * the vault FILE is absent   -> the secret moved (OCI-Vault migration, commit 76ba8be); the
#                                   fix is a delivery path, not a re-run.
#   * the file is there, sops fails -> an age key / decryption problem; the fix is the key file.
# Neither is silent, and neither takes the caller down: this returns non-zero and lets the caller
# decide, so a missing optional secret cannot abort the whole bootstrap.
vget() {
  local f="$VAULT/secrets/$ENV_NAME/$1.yaml"
  if [ ! -e "$f" ]; then
    {
      echo "BLIND vault $1 is not in $VAULT/secrets/$ENV_NAME/"
      echo "      cause   it moved to OCI Vault (ADR 0017, commit 76ba8be)"
      echo "      fix     restore THIS device's access -- docs/reference/agent-identity.md"
      echo "      not     re-running this script; it cannot recreate a secret that is not here"
    } >&2
    return 3
  fi
  local out
  if ! out="$(sops -d --extract "[\"$1\"]" "$f" 2>&1)"; then
    echo "BLIND sops cannot decrypt $1 (SOPS_AGE_KEY_FILE=$SOPS_AGE_KEY_FILE): $(printf %s "$out" | head -1)" >&2
    return 4
  fi
  printf '%s' "$out"
}
vput() { # name on argv, VALUE ON STDIN ONLY
  local f="$VAULT/secrets/$ENV_NAME/$1.yaml"
  if [ -e "$f" ] && [ "${2:-}" != replace ]; then cat >/dev/null; echo "vault   $1 kept"; return; fi
  # 2026-08-25: vget returned "" (SOPS_AGE_KEY_FILE unset) and vput wrote two EMPTY secrets to
  # the vault. An empty value is never a secret; refuse it instead of recording a blank verdict.
  local v; v="$(cat)"
  [ -n "$v" ] || { echo "FAIL    vault $1: refusing to write an empty value" >&2; return 1; }
  printf %s "$v" | SECRET_REPLACE=1 "$VAULT/scripts/secret-add" "$ENV_NAME" "$1" "$1" >/dev/null && echo "vault   $1 written"
}

# 2026-09-26: the tenancy was upgraded to Pay As You Go on 2026-08-24 and ran 12 OCPU / 48 GB
# against the Always Free 2 OCPU / 12 GB. The tofu precondition, node_pool.rego and the $50
# budget all passed that, so they were deleted. The ceiling is now an Oracle compartment quota:
# Oracle refuses any compute request beyond it, from any caller. It lives here, under the tenancy
# owner, because quota permission is tenancy-scoped and estate-operators (estate-tofu, estate-ci,
# every agent) is never granted it: nothing automated can raise its own ceiling.
# A1 quotas count per availability domain, so every compute quota is zeroed and A1 is allowed
# in AD-1 only (the PVs pin AD-1, platform/oci/main.tf). Later statements override earlier ones.
apply_quota() {
  AD1=$(oci iam availability-domain list "${O[@]}" --compartment-id "$TENANCY" --query 'data[?ends_with(name, `-AD-1`)].name | [0]' --raw-output)
  case "$AD1" in *:*-AD-1) ;; *) echo "FAIL    quota: no AD-1 name from the API ($AD1)"; exit 1;; esac
  QUOTA_NAME=estate-free-tier-ceiling
  QUOTA=$(jq -c --arg ad "$AD1" 'map(sub("request.ad=AD1$"; "request.ad=" + $ad))' "$IDP/platform/oci/policy/free-tier-quota.statements.json")
  QID=$(oci limits quota list "${O[@]}" --compartment-id "$TENANCY" --name "$QUOTA_NAME" --query 'data[0].id' --raw-output 2>/dev/null || true)
  if [ -z "$QID" ] || [ "$QID" = null ]; then
    oci limits quota create "${O[@]}" --compartment-id "$TENANCY" --name "$QUOTA_NAME" --description "Always Free A1 ceiling, AD-1 only; tenancy owner only (bin/idp-oci-bootstrap)" --statements "$QUOTA" >/dev/null
    echo "quota   $QUOTA_NAME created"
  elif [ "$(oci limits quota get "${O[@]}" --quota-id "$QID" --query 'data.statements' 2>/dev/null | jq -c .)" != "$QUOTA" ]; then
    oci limits quota update "${O[@]}" --quota-id "$QID" --statements "$QUOTA" --force >/dev/null; echo "quota   $QUOTA_NAME statements updated"
  fi
  # Read back what Oracle stored (2026-08-25: OCI rewrote a policy's where clause on store) and
  # what A1 is in use now. A quota refuses new capacity; it does not stop what already runs.
  QID=$(oci limits quota list "${O[@]}" --compartment-id "$TENANCY" --name "$QUOTA_NAME" --query 'data[0].id' --raw-output)
  [ "$(oci limits quota get "${O[@]}" --quota-id "$QID" --query 'data.statements' | jq -c .)" = "$QUOTA" ] \
    || { echo "FAIL    quota: stored statements differ from platform/oci/policy/free-tier-quota.statements.json"; exit 1; }
  USED=$(oci limits resource-availability get "${O[@]}" --service-name compute --limit-name standard-a1-core-count --compartment-id "$TENANCY" --availability-domain "$AD1" --query data.used --raw-output 2>/dev/null || echo unknown)
  echo "quota   $QUOTA_NAME in force: A1 2 OCPU / 12 GB in $AD1, 0 elsewhere; A1 OCPU in use now: $USED"
}

# --quota applies only the ceiling. Region and tenancy OCID are identifiers, not secrets: when the
# sops vault no longer holds them (ADR 0017 moved them to OCI Vault) the laptop's own OCI CLI
# config names them, and the tenancy name is only needed if the browser login has to run.
if [ "${1:-}" = "--quota" ]; then
  cfg() { awk -F= -v k="$1" '/^\[/{p=($0=="[DEFAULT]")} p && $1==k {print $2; exit}' "${OCI_CLI_CONFIG_FILE:-$HOME/.oci/config}"; }
  REGION="$(vget OCI_REGION 2>/dev/null || cfg region)"; TENANCY="$(vget OCI_TENANCY_OCID 2>/dev/null || cfg tenancy)"
  TENANCY_NAME="${OCI_TENANCY_NAME:-$(vget OCI_TENANCY_NAME 2>/dev/null || true)}"
  [ -n "$REGION" ] && [ -n "$TENANCY" ] || { echo "BLIND neither the vault nor ~/.oci/config [DEFAULT] names region / tenancy"; exit 2; }
  O=(--auth security_token --profile estate-bootstrap --region "$REGION")
  if oci iam region-subscription list "${O[@]}" >/dev/null 2>&1; then echo "login   session token still valid, no browser needed"
  else
    echo "login   browser opens once; sign in as the tenancy owner (token lives 1 hour)"
    oci session authenticate --region "$REGION" ${TENANCY_NAME:+--tenancy-name "$TENANCY_NAME"} --profile-name estate-bootstrap >/dev/null
  fi
  apply_quota
  exit 0
fi
# `|| true` where the value may legitimately be absent, so a missing optional secret reports
# itself through vget's BLIND line and still lets the required-value guard below name the gap.
REGION="$(vget OCI_REGION || true)"; TENANCY="$(vget OCI_TENANCY_OCID || true)"
TENANCY_NAME="${OCI_TENANCY_NAME:-$(vget OCI_TENANCY_NAME || true)}"
[ -n "$REGION" ] && [ -n "$TENANCY" ] || { echo "BLIND vault lacks OCI_REGION / OCI_TENANCY_OCID -- see the BLIND line(s) above for which"; exit 2; }
[ -n "$TENANCY_NAME" ] || { echo "need OCI_TENANCY_NAME (vault or env): the console tenancy name"; exit 2; }

PROFILE=estate-bootstrap
O=(--auth security_token --profile "$PROFILE" --region "$REGION")
if oci iam region-subscription list "${O[@]}" >/dev/null 2>&1; then echo "login   session token still valid, no browser needed"
else
  echo "login   browser opens once; sign in as the tenancy owner (token lives 1 hour)"
  oci session authenticate --region "$REGION" --tenancy-name "$TENANCY_NAME" --profile-name "$PROFILE" >/dev/null
fi
# IDCS-backed tenancies refuse a user without a primary email (incident 2026-08-25:
# error.identity.user.primaryEmailNotSpecified). The address is an identifier; Oracle mails it a
# welcome message, nothing else depends on it.
SVC_EMAIL="${OCI_SERVICE_USER_EMAIL:-$(vget OCI_SERVICE_USER_EMAIL || true)}"
[ -n "$SVC_EMAIL" ] || { echo "need OCI_SERVICE_USER_EMAIL (vault or env): mailbox for the estate-tofu service user"; exit 2; }

# --- IAM, idempotent ------------------------------------------------------------------
ensure() { # kind name -> ocid   (compartment|group|user)
  local kind="$1" name="$2" id
  case "$kind" in
    compartment) id=$(oci iam compartment list "${O[@]}" --compartment-id "$TENANCY" --name "$name" --lifecycle-state ACTIVE --query 'data[0].id' --raw-output 2>/dev/null || true)
      [ -n "$id" ] && [ "$id" != null ] || id=$(oci iam compartment create "${O[@]}" --compartment-id "$TENANCY" --name "$name" --description "estate platform (ADR 0004)" --query data.id --raw-output);;
    group) id=$(oci iam group list "${O[@]}" --compartment-id "$TENANCY" --name "$name" --query 'data[0].id' --raw-output 2>/dev/null || true)
      [ -n "$id" ] && [ "$id" != null ] || id=$(oci iam group create "${O[@]}" --compartment-id "$TENANCY" --name "$name" --description "may manage the estate compartment only" --query data.id --raw-output);;
    user) id=$(oci iam user list "${O[@]}" --compartment-id "$TENANCY" --name "$name" --query 'data[0].id' --raw-output 2>/dev/null || true)
      [ -n "$id" ] && [ "$id" != null ] || id=$(oci iam user create "${O[@]}" --compartment-id "$TENANCY" --name "$name" --email "$SVC_EMAIL" --description "OpenTofu service user; API key only, no console" --query data.id --raw-output);;
  esac
  [ -n "$id" ] && [ "$id" != null ] || { echo "FAIL    $kind $name: no OCID returned" >&2; return 1; }
  echo "$id"
}
COMP=$(ensure compartment estate);   echo "iam     compartment estate"
GROUP=$(ensure group estate-operators); echo "iam     group estate-operators"
ensure group estate-provers >/dev/null; echo "iam     group estate-provers (crew#631 CP2: the only readers of verdict-hmac-key)"
USER_ID=$(ensure user estate-tofu);   echo "iam     user estate-tofu"
oci iam group add-user "${O[@]}" --group-id "$GROUP" --user-id "$USER_ID" >/dev/null 2>&1 || true
POLICY_NAME=estate-operators-manage-estate
# Statements are reconciled, not only created: a re-run after a statement is added here updates
# the live policy (2026-08-25: `read all-resources` does not cover the limits service; capacity
# checks need `inspect limits`; 2026-08-25 evening: CP3 apply failed 404 NotAuthorized creating the
# dynamic group and the vault, so dynamic-groups, policies, vaults, keys and secret-family were added;
# 2026-08-26 crew#287: `manage domains in tenancy` so platform/oci/identity can create the front-door
# OIDC app under estate-tofu; the apply returned 401 without it, and estate-tofu cannot add a
# tenancy-level statement to itself, so this line is applied once by the tenancy owner).
# 2026-08-25: the objects statement lost its `where target.bucket.name=...` condition. OCI stored
# the condition without its quotes and refused every PutObject from estate-tofu (404 BucketNotFound)
# while GetObject still passed; the state upload after the vault apply failed and errored.tfstate
# had to be pushed by hand. Unconditional `manage objects in compartment estate` is the scope now:
# the compartment holds only estate buckets.
# 2026-08-26 crew#292: platform/oci/receipts.tf declares the drill-receipts bucket and the apply
# returned 409 BucketAlreadyExists-or-unauthorised for a bucket that did not exist (run 32966844763),
# so `read buckets` became `manage buckets`, still compartment-scoped.
# crew#311: the statements are a file, so bin/idp-iam-policy-drift can grade the live policy against
# the same list on every --check. Edit the file, never this line.
STATEMENTS=$(jq -c . "$(cd "$(dirname "$0")/.." && pwd)/platform/oci/policy/estate-operators.statements.json")
PID=$(oci iam policy list "${O[@]}" --compartment-id "$TENANCY" --name "$POLICY_NAME" --query 'data[0].id' --raw-output 2>/dev/null || true)
if [ -z "$PID" ] || [ "$PID" = null ]; then
  oci iam policy create "${O[@]}" --compartment-id "$TENANCY" --name "$POLICY_NAME" --description "least privilege for platform/oci (ADR 0004)" --statements "$STATEMENTS" >/dev/null
elif [ "$(oci iam policy get "${O[@]}" --policy-id "$PID" --query 'data.statements' 2>/dev/null | jq -c .)" != "$(printf %s "$STATEMENTS" | jq -c .)" ]; then
  oci iam policy update "${O[@]}" --policy-id "$PID" --statements "$STATEMENTS" --version-date "" --force >/dev/null; echo "iam     policy statements updated"
fi
echo "iam     policy $POLICY_NAME"

apply_quota

# crew#220 hand step 1: the remote-state bucket. Versioned so a bad apply can be rolled back to
# the previous state object. Created here, under the bootstrap identity, because the operator
# policy above deliberately cannot create buckets (2026-08-25: BucketAlreadyExists-or-unauthorised).
if ! oci os bucket get "${O[@]}" -bn estate-tofu-state >/dev/null 2>&1; then
  oci os bucket create "${O[@]}" --compartment-id "$COMP" --name estate-tofu-state --versioning Enabled --public-access-type NoPublicAccess >/dev/null
  echo "os      bucket estate-tofu-state created (versioned)"
else
  echo "os      bucket estate-tofu-state"
fi
# 2026-08-25 incident: the objects statement carried `where target.bucket.name='estate-tofu-state'`;
# OCI stored it without the quotes and every PutObject from estate-tofu got 404, found only after
# an apply had to be pushed by hand. Class: a policy granted on paper and never exercised by the
# identity it was granted to. So exercise it: write and delete one object as estate-tofu.
# BLIND (not FAIL) when the estate-tofu profile does not exist yet (bin/idp-oci-login writes it).
probe_state_write() { # $1 bucket, $2 the estate-tofu user OCID the policy was written for
  local bucket="$1" want="$2" profile="${OCI_TOFU_PROFILE:-DEFAULT}" cfg="${OCI_CLI_CONFIG_FILE:-$HOME/.oci/config}" have
  # bin/idp-oci-login writes [DEFAULT] as estate-tofu; prove it is that user, not the tenancy owner,
  # or the probe exercises the wrong identity and passes regardless of the policy (idp#119 review).
  have=$(awk -v p="[$profile]" '$0==p{f=1;next} /^\[/{f=0} f&&/^user[ \t]*=/{sub(/^user[ \t]*=[ \t]*/,"");print}' "$cfg" 2>/dev/null)
  [ -n "$have" ] || { echo "BLIND   state-write probe: no profile $profile in $cfg yet (bin/idp-oci-login); policy unexercised"; return 0; }
  [ "$have" = "$want" ] || { echo "BLIND   state-write probe: profile $profile is not estate-tofu (${have:0:24}...); policy unexercised"; return 0; }
  if printf ok | oci os object put --profile "$profile" -bn "$bucket" --name .write-probe --file - --force >/dev/null 2>&1; then
    oci os object delete --profile "$profile" -bn "$bucket" --name .write-probe --force >/dev/null 2>&1 || true
    echo "os      state-write probe ok: estate-tofu ($profile) can PutObject on $bucket"; return 0
  fi
  echo "FAIL    state-write probe: estate-tofu ($profile) cannot PutObject on $bucket; the objects policy statement is not in force (2026-08-25: OCI strips quotes from a where clause)" >&2
  return 1
}
probe_state_write estate-tofu-state "$USER_ID"
NS_VAL=$(oci os ns get "${O[@]}" --query data --raw-output); printf %s "$NS_VAL" | vput OCI_OS_NAMESPACE
if [ ! -e "$VAULT/secrets/$ENV_NAME/OCI_S3_SECRET_KEY.yaml" ]; then
  SK=$(oci iam customer-secret-key create "${O[@]}" --user-id "$USER_ID" --display-name estate-tofu-state)
  printf %s "$SK" | jq -r '.data.id'  | vput OCI_S3_ACCESS_KEY
  printf %s "$SK" | jq -r '.data.key' | vput OCI_S3_SECRET_KEY
else echo "vault   OCI_S3_SECRET_KEY kept"; fi

# --- key pair: generated here, public half registered, private half vaulted -----------
if [ -e "$VAULT/secrets/$ENV_NAME/OCI_FINGERPRINT.yaml" ] && [ "${1:-}" != --rotate ]; then
  echo "key     OCI_FINGERPRINT already in the vault; pass --rotate to add a new key"
else
  T=$(mktemp -d); chmod 700 "$T"; openssl genrsa -out "$T/key.pem" 2048 2>/dev/null; chmod 600 "$T/key.pem"
  openssl rsa -in "$T/key.pem" -pubout -out "$T/pub.pem" 2>/dev/null
  FP=$(oci iam user api-key upload "${O[@]}" --user-id "$USER_ID" --key-file "$T/pub.pem" --query data.fingerprint --raw-output)
  vput OCI_API_PRIVATE_KEY replace < "$T/key.pem"
  printf %s "$FP" | vput OCI_FINGERPRINT replace
  echo "key     registered on estate-tofu, fingerprint ${FP:0:8}..."
fi
# --- workload identity for GitHub Actions (crew#227 CP2), idempotent by name --------------------
# A job's OIDC token is exchanged at the identity domain for a session token that impersonates
# the service user estate-ci. Three objects, all SCIM: the user, a confidential OAuth client, and
# the identity propagation trust that names both. Nothing here is a long-lived credential except
# the client secret, which goes to the vault and to the repo's GitHub secrets, never to stdout.
EP="$(vget OCI_IDENTITY_DOMAIN_URL || true)"
[ -n "$EP" ] || EP=$(oci iam domain list "${O[@]}" --compartment-id "$TENANCY" --query 'data[0].url' --raw-output)
[ -n "$EP" ] && [ "$EP" != null ] || { echo "FAIL    no identity domain URL"; exit 1; }
printf %s "$EP" | vput OCI_IDENTITY_DOMAIN_URL
scim() { oci raw-request "${O[@]}" --http-method "$1" --target-uri "$EP/admin/v1/$2" "${@:3}"; }
# 2026-08-31: `oci identity-domains <resource> list` does not exist on the CLI this runs from
# (3.90.3 answers "No such command" on stdout), so the old lookup read the usage banner as the id,
# PATCHed /IdentityPropagationTrusts/Usage:%20oci..., and printed "PATCH refused: " with no detail
# on every founder bootstrap since 2026-08-26 (crew#631 CP2). The lookup is a SCIM GET with a
# filter over the same raw-request seam the POST and PATCH already use, and an id is 32 hex
# characters or it is nothing: a banner can never be an id again.
scim_find() {
  local res="$1" f; f=$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1]))' "$2")
  local id; id=$(oci raw-request "${O[@]}" --http-method GET --target-uri "$EP/admin/v1/$res?filter=$f&attributes=id" 2>/dev/null | jq -r '.data.Resources[0].id // empty' 2>/dev/null || true)
  case "$id" in *[!0-9a-f]*|"") ;; *) [ ${#id} -eq 32 ] && printf %s "$id" ;; esac
}
T2=$(mktemp -d); chmod 700 "$T2"; trap 'rm -rf "$T2" ${T:-}' EXIT
CI_UID=$(scim_find Users 'userName eq "estate-ci"')
if [ -z "$CI_UID" ]; then
  printf '%s' '{"schemas":["urn:ietf:params:scim:schemas:core:2.0:User","urn:ietf:params:scim:schemas:oracle:idcs:extension:user:User"],"userName":"estate-ci","name":{"givenName":"estate","familyName":"ci"},"displayName":"estate-ci (GitHub Actions service user)","urn:ietf:params:scim:schemas:oracle:idcs:extension:user:User":{"serviceUser":true}}' > "$T2/u.json"
  CI_UID=$(scim POST Users --request-body "file://$T2/u.json" | jq -r .data.id); echo "wif     user estate-ci created"
else echo "wif     user estate-ci"; fi
G_ID=$(scim_find Groups 'displayName eq "estate-operators"')
printf '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"add","path":"members","value":[{"value":"%s","type":"User"}]}]}' "$CI_UID" > "$T2/g.json"
scim PATCH "Groups/$G_ID" --request-body "file://$T2/g.json" >/dev/null 2>&1 || true   # already a member is not an error
P_ID=$(scim_find Groups 'displayName eq "estate-provers"')
scim PATCH "Groups/$P_ID" --request-body "file://$T2/g.json" >/dev/null 2>&1 || true   # estate-ci reads the verdict signing key; nobody else (crew#631 CP2)
APP_ID=$(scim_find Apps 'displayName eq "estate-github-oidc"')
if [ -z "$APP_ID" ]; then
  printf '%s' '{"schemas":["urn:ietf:params:scim:schemas:oracle:idcs:App"],"displayName":"estate-github-oidc","description":"GitHub Actions OIDC to OCI session token exchange (crew#227)","basedOnTemplate":{"value":"CustomWebAppTemplateId"},"isOAuthClient":true,"clientType":"confidential","allowedGrants":["client_credentials","urn:ietf:params:oauth:grant-type:jwt-bearer"],"active":true,"trustScope":"Explicit"}' > "$T2/a.json"
  scim POST Apps --request-body "file://$T2/a.json" > "$T2/app.out"
  jq -r .data.name "$T2/app.out" | vput OCI_OIDC_CLIENT_ID replace
  jq -r .data.clientSecret "$T2/app.out" | vput OCI_OIDC_CLIENT_SECRET replace
  echo "wif     app estate-github-oidc created"
else echo "wif     app estate-github-oidc"; fi
CLIENT_ID="$(vget OCI_OIDC_CLIENT_ID)"; [ -n "$CLIENT_ID" ] || { echo "FAIL    app exists but OCI_OIDC_CLIENT_ID is not in the vault; delete the app in the console and re-run"; exit 1; }
REPO="${GITHUB_REPO:-$(git -C "$IDP" remote get-url origin | sed -E 's#\.git$##; s#.*[:/]([^/]+/[^/]+)$#\1#')}"
# GitHub's OIDC `sub` carries numeric ids: repo:<owner>@<owner id>/<repo>@<repo id>:<context>
# (measured 2026-08-25 in run 32883584446; a rule on the bare name matches nothing).
SUB_PREFIX=$(gh api "repos/$REPO" -q '"repo:\(.owner.login)@\(.owner.id)/\(.name)@\(.id):"' 2>/dev/null) || { echo "FAIL    gh cannot read repos/$REPO for the OIDC subject ids"; exit 1; }
TR_ID=$(scim_find IdentityPropagationTrusts 'name eq "github-actions-estate"')
if [ -z "$TR_ID" ]; then
  jq -n --arg c "$CLIENT_ID" --arg u "$CI_UID" --arg r "sub eq ${SUB_PREFIX}*" '{"schemas":["urn:ietf:params:scim:schemas:oracle:idcs:IdentityPropagationTrust"],"name":"github-actions-estate","type":"JWT","issuer":"https://token.actions.githubusercontent.com","active":true,"subjectType":"User","subjectClaimName":"sub","publicKeyEndpoint":"https://token.actions.githubusercontent.com/.well-known/jwks","oauthClients":[$c],"clientClaimName":"aud","clientClaimValues":["https://cloud.oracle.com"],"allowImpersonation":true,"impersonationServiceUsers":[{"rule":$r,"value":$u}]}' > "$T2/t.json"
  scim POST IdentityPropagationTrusts --request-body "file://$T2/t.json" | jq -e .data.id >/dev/null; echo "wif     trust github-actions-estate created for $REPO"
else
  jq -n --arg u "$CI_UID" --arg r "sub eq ${SUB_PREFIX}*" '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"impersonationServiceUsers","value":[{"rule":$r,"value":$u}]}]}' > "$T2/tp.json"
  # 2026-08-26: the PATCH answered an error body and `jq -e .data.id` printed a jq error and nothing
  # else; the run read as clean. Show the domain's answer (the detail, never a token) instead.
  pr=$(scim PATCH "IdentityPropagationTrusts/$TR_ID" --request-body "file://$T2/tp.json" 2>&1)
  if printf %s "$pr" | jq -e '.data.id' >/dev/null 2>&1; then echo "wif     trust github-actions-estate rule reconciled"
  else echo "FAIL    trust github-actions-estate rule PATCH refused: $(printf %s "$pr" | jq -r '.data.detail // .data // .' 2>/dev/null | head -c 300)"; fi
fi
if command -v gh >/dev/null && gh repo view "$REPO" >/dev/null 2>&1; then
  printf %s "$CLIENT_ID:$(vget OCI_OIDC_CLIENT_SECRET)" | gh secret set OIDC_CLIENT_IDENTIFIER -R "$REPO"
  printf %s "$TENANCY" | gh secret set OCI_TENANCY_OCID -R "$REPO"
  gh variable set DOMAIN_BASE_URL -R "$REPO" --body "$EP"; gh variable set OCI_REGION -R "$REPO" --body "$REGION"; gh variable set OCI_COMPARTMENT_OCID -R "$REPO" --body "$COMP"
  echo "wif     GitHub secrets and variables set on $REPO (OIDC_CLIENT_IDENTIFIER, OCI_TENANCY_OCID, DOMAIN_BASE_URL, OCI_REGION, OCI_COMPARTMENT_OCID)"
else echo "wif     gh cannot reach $REPO; set OIDC_CLIENT_IDENTIFIER, OCI_TENANCY_OCID, DOMAIN_BASE_URL, OCI_REGION, OCI_COMPARTMENT_OCID by hand (docs/how-to/check-the-cluster-from-github.md)"; fi

printf %s "$USER_ID" | vput OCI_USER_OCID replace
printf %s "$COMP"    | vput OCI_COMPARTMENT_OCID replace
printf %s "$TENANCY_NAME" | vput OCI_TENANCY_NAME
( cd "$VAULT" && git add -- "secrets/$ENV_NAME" && git commit -q -m "$ENV_NAME: OCI estate-tofu user, key and compartment (bin/idp-oci-bootstrap)" && git push -q ) && echo "vault   committed and pushed"
# The session token stays for its hour so follow-up steps (bucket, OIDC trust) reuse it.
# 2026-08-25: deleting it here cost the founder a second browser sign-in.
echo "login   session token kept for the remaining hour: profile $PROFILE"
echo "done    next: bin/idp-oci-login"
