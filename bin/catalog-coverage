#!/usr/bin/env python3
"""catalog-coverage -- how much of the estate the catalog actually knows.

    bin/catalog-coverage          # the coverage table, from the record
    bin/catalog-coverage --json   # machine-readable
    bin/catalog-coverage --fresh  # walk the estate again, then print

WHAT IT PRINTS. One row per plane: the universe (how many objects the plane has),
how many are classified, how many are uncatalogued and why, and whether the plane
was BLIND. A blind plane is a row with a reason, never a green zero.

WHY THIS EXISTS. The catalog was abandoned twice because a list of things looked
complete while a third of it was guesses. The coverage table is the thing that
cannot be: it is computed from what the collectors actually saw, and a plane that
could not be read says so in the row that describes it.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from catalog.census.census import run_census  # noqa: E402
from catalog.census.planes import CollectorConfig  # noqa: E402
from catalog.census.store import Record, RecordError  # noqa: E402


def _print_rows(rows: list[dict]) -> None:
    print("plane     universe  classified  uncatalogued  blind")
    for row in rows:
        print(
            f"{row['plane']:<9} {row['universe']:>8}  {row['classified']:>10}  "
            f"{row['uncatalogued']:>12}  {row['blind']:>5}"
        )
        detail = row.get("detail")
        if isinstance(detail, str):
            try:
                detail = json.loads(detail)
            except json.JSONDecodeError:
                detail = {}
        detail = detail or {}
        if detail.get("blind_reason"):
            print(f"          blind: {detail['blind_reason']}")
        for reason, count in sorted((detail.get("reasons") or {}).items()):
            print(f"          {reason}: {count}")
        examples = detail.get("examples") or []
        if examples:
            print(f"          e.g. {', '.join(examples[:3])}")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="The catalog's coverage table.")
    parser.add_argument("--json", action="store_true", help="print JSON")
    parser.add_argument(
        "--fresh", action="store_true", help="walk the estate again before printing"
    )
    args = parser.parse_args(argv)

    if args.fresh:
        census = run_census(cfg=CollectorConfig())
        rows = census.coverage
    else:
        try:
            record = Record()
            rows = record.query(
                "select plane, universe, classified, uncatalogued, blind, last_run, detail"
                " from coverage order by plane"
            )
        except RecordError as exc:
            print(f"the record could not be read: {exc}", file=sys.stderr)
            return 1

    if args.json:
        print(json.dumps(rows, indent=2, sort_keys=True))
    else:
        _print_rows(rows)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
