#!/usr/bin/env python3
"""The drills row: are the scheduled drills actually firing? (crew#292 CP2)

    bin/idp-drills-row <drills/catalogue.yaml> <repo root>

Prints one `drills` row per catalogue entry, one `schedule` row per scheduled workflow, and a
summary row; exit 0 green, 1 a drill is stale or never ran or its cron fired under 80% of what
it promises in the last 24h, 2 BLIND (cannot ask GitHub). The firing count exists because on
2026-08-28 every hourly cron on the account fired 1-3 times a day (crew#554): "last green 1.2h
ago" from a push run said nothing about whether the schedule was alive. Called by bin/idp-verify (laptop, behind a
live Backstage) and by bin/idp-verify-drill (hourly in CI on the machine identity). It lived as
a heredoc inside bin/idp-verify until 2026-08-28, where nothing scheduled ever reached it:
idp-verify exits early when Backstage is not on 7107, and no workflow runs idp-verify at all.
"""
import json, os, subprocess, sys
from datetime import datetime, timedelta, timezone

import yaml

cat_path, root = sys.argv[1], sys.argv[2]


def row(status, text):
    print("%-9s %-9s %s" % (status, "drills", text))


try:
    entries = (yaml.safe_load(open(cat_path, encoding="utf-8")) or {}).get("drills") or []
except FileNotFoundError:
    row("BLIND", "no %s -- nothing declares which drills should be running" % cat_path)
    sys.exit(2)
if not entries:
    row("BLIND", "%s declares no drills" % cat_path)
    sys.exit(2)


def gh(args):
    return subprocess.run(["gh"] + args, cwd=root, capture_output=True, text=True, timeout=60)


# One authentication probe for the whole row: an unauthenticated gh answers the same "not logged
# in" for every workflow, which would print N identical FAILs for one missing token. Freshness
# that cannot be measured is BLIND, never green (LAW 45 step 5).
try:
    auth = gh(["auth", "status"])
except FileNotFoundError:
    row("BLIND", "gh is not installed -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
except subprocess.TimeoutExpired:
    row("BLIND", "gh auth status timed out -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
if auth.returncode != 0:
    row("BLIND", "gh is not authenticated (run: gh auth login) -- drill freshness unknown, not green")
    sys.exit(2)



def _field(spec, lo, hi):
    """One cron field -> the set of matching values. Supports *, a, a-b, a,b, and /step."""
    out = set()
    for part in spec.split(","):
        step = 1
        if "/" in part:
            part, step = part.split("/", 1)
            step = int(step)
        if part == "*":
            a, b = lo, hi
        elif "-" in part:
            a, b = (int(x) for x in part.split("-", 1))
        else:
            a = b = int(part)
        out.update(range(a, b + 1, step))
    return out


def expected_firings(cron, end, hours=24):
    """How many minutes in the window (end-hours, end] the 5-field cron matches. 0 when the cron
    is unparseable, so an odd spec is never graded as 'fired 0 of 0'."""
    try:
        m, h, dom, mon, dow = cron.split()
        mins, hrs = _field(m, 0, 59), _field(h, 0, 23)
        doms, mons, dows = _field(dom, 1, 31), _field(mon, 1, 12), _field(dow, 0, 7)
    except (ValueError, TypeError):
        return 0
    dows = {d % 7 for d in dows}
    dom_any, dow_any = dom == "*", dow == "*"
    count = 0
    t = end.replace(second=0, microsecond=0)
    for i in range(hours * 60):
        x = t - timedelta(minutes=i)
        if x.minute in mins and x.hour in hrs and x.month in mons:
            dm, dw = x.day in doms, (x.isoweekday() % 7) in dows
            # cron semantics: when both day fields are restricted, either one matching fires
            ok = (dm or dw) if not (dom_any or dow_any) else (dm if dow_any else dw)
            if ok:
                count += 1
    return count


def scheduled_firings(wf, since):
    """Firings of one workflow in the last 24h: GitHub's own schedule, plus workflow_dispatch by the
    estate's GitHub App (platform/drills/drill-dispatcher.yaml, crew#554 CP3) -- the App only
    dispatches when GitHub's cron did not, so the two never double-count an hour. A human dispatch
    is a hand, not a clock, and does not count. Returns (fired, by_app); None if gh failed."""
    try:
        r = gh(["run", "list", "--workflow", wf, "--limit", "300",
                "--json", "createdAt,event,actor"])
    except subprocess.TimeoutExpired:
        return None
    if r.returncode != 0:
        return None
    try:
        runs = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        return None
    fired, by_app = 0, 0
    for x in runs:
        if x.get("createdAt", "") < since:
            continue
        ev = x.get("event")
        if ev == "schedule":
            fired += 1
        elif ev == "workflow_dispatch" and str((x.get("actor") or {}).get("login", "")).endswith("[bot]"):
            fired += 1
            by_app += 1
    return fired, by_app


now = datetime.now(timezone.utc)
graded, stale, pending = 0, [], 0
for d in entries:
    name = d.get("name", "?")
    wf = d.get("workflow", "")
    job = d.get("job")
    label = "%s%s" % (name, "" if not job or job == name else " (job %s)" % job)
    if d.get("pending"):
        pending += 1
        row("n/a", "%-22s %s not merged yet -- declared in the catalogue, never graded" % (label, wf))
        continue
    graded += 1
    # GitHub keeps run history for a deleted workflow, so a retired file still answers "last
    # green 0.2h ago" for a while (idp#178 review, 2026-08-26: the workflow retired in #167
    # kept being graded from its run history). The file on disk is the only honest source.
    if not os.path.isfile(os.path.join(root, ".github", "workflows", wf)):
        stale.append(name)
        row("FAIL", "%-22s .github/workflows/%s does not exist -- the catalogue names a retired workflow; fix the entry or the file" % (label, wf))
        continue
    try:
        r = gh(["run", "list", "--workflow", wf, "--status", "success", "--limit", "1",
                "--json", "updatedAt"])
    except subprocess.TimeoutExpired:
        stale.append(name)
        row("FAIL", "%-22s gh run list --workflow %s timed out" % (label, wf))
        continue
    if r.returncode != 0:
        stale.append(name)
        detail = ((r.stderr or "").strip().splitlines() or [""])[0]
        row("FAIL", "%-22s gh could not list runs of %s: %s" % (label, wf, detail))
        continue
    try:
        runs = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        runs = []
    if not runs:
        stale.append(name)
        row("FAIL", "%-22s no successful run of %s has ever been recorded (cron %s)"
            % (label, wf, d.get("schedule", "?")))
        continue
    ts = datetime.strptime(runs[0]["updatedAt"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    age = (now - ts).total_seconds() / 3600.0
    cap = float(d.get("max_age_hours", 26))
    if age > cap:
        stale.append(name)
        row("FAIL", "%-22s %s last green %.1fh ago, older than %gh (cron %s)"
            % (label, wf, age, cap, d.get("schedule", "?")))
    else:
        row("ok", "%-22s %s last green %.1fh ago (max %gh)" % (label, wf, age, cap))

# --- the schedule itself: fired / expected in the last 24h, once per workflow (several
# catalogue entries share oke-check.yml). Under 80% is red: a green "last green" from a push run
# is not a heartbeat. Crons that promise nothing in this window (weekly) are not graded.
since = (now - timedelta(hours=24)).strftime("%Y-%m-%dT%H:%M:%SZ")
seen = {}
for d in entries:
    wf, cron = d.get("workflow", ""), d.get("schedule")
    if d.get("pending") or not cron or wf in seen:
        continue
    if not os.path.isfile(os.path.join(root, ".github", "workflows", wf)):
        continue
    want = expected_firings(cron, now)
    if want == 0:
        continue
    counted = scheduled_firings(wf, since)
    seen[wf] = (counted, want)
    if counted is None:
        stale.append("schedule:" + wf)
        row("FAIL", "%-22s %s runs in 24h could not be listed (cron %s)" % ("schedule", wf, cron))
        continue
    got, by_app = counted
    how = "cron %s, %d dispatched by the App" % (cron, by_app)
    if got < 0.8 * want:
        stale.append("schedule:" + wf)
        row("FAIL", "%-22s %s fired %d of %d promised in 24h (%s) -- GitHub dropped the schedule and the dispatcher did not cover it, crew#554"
            % ("schedule", wf, got, want, how))
    else:
        row("ok", "%-22s %s fired %d of %d promised in 24h (%s)" % ("schedule", wf, got, want, how))

tail = " (%d pending)" % pending if pending else ""
dead = [x for x in stale if x.startswith("schedule:")]
old_ = [x for x in stale if not x.startswith("schedule:")]
if stale:
    parts = []
    if old_:
        parts.append("%d of %d stale: %s" % (len(old_), graded, ", ".join(old_)))
    if dead:
        parts.append("%d of %d schedules dropped: %s" % (len(dead), len(seen), ", ".join(x[9:] for x in dead)))
    row("FAIL", "; ".join(parts) + tail)
    sys.exit(1)
row("ok", "%d/%d green within window, %d/%d schedules alive%s" % (graded, graded, len(seen), len(seen), tail))
sys.exit(0)
