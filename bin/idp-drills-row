#!/usr/bin/env python3
"""The drills row: are the scheduled drills actually firing? (crew#292 CP2)

    bin/idp-drills-row <drills/catalogue.yaml> <repo root>

Prints one `drills` row per catalogue entry and a summary row; exit 0 green, 1 a drill is
stale or never ran, 2 BLIND (cannot ask GitHub). Called by bin/idp-verify (laptop, behind a
live Backstage) and by bin/idp-verify-drill (hourly in CI on the machine identity). It lived as
a heredoc inside bin/idp-verify until 2026-08-28, where nothing scheduled ever reached it:
idp-verify exits early when Backstage is not on 7107, and no workflow runs idp-verify at all.
"""
import json, os, subprocess, sys
from datetime import datetime, timezone

import yaml

cat_path, root = sys.argv[1], sys.argv[2]


def row(status, text):
    print("%-9s %-9s %s" % (status, "drills", text))


try:
    entries = (yaml.safe_load(open(cat_path, encoding="utf-8")) or {}).get("drills") or []
except FileNotFoundError:
    row("BLIND", "no %s -- nothing declares which drills should be running" % cat_path)
    sys.exit(2)
if not entries:
    row("BLIND", "%s declares no drills" % cat_path)
    sys.exit(2)


def gh(args):
    return subprocess.run(["gh"] + args, cwd=root, capture_output=True, text=True, timeout=60)


# One authentication probe for the whole row: an unauthenticated gh answers the same "not logged
# in" for every workflow, which would print N identical FAILs for one missing token. Freshness
# that cannot be measured is BLIND, never green (LAW 45 step 5).
try:
    auth = gh(["auth", "status"])
except FileNotFoundError:
    row("BLIND", "gh is not installed -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
except subprocess.TimeoutExpired:
    row("BLIND", "gh auth status timed out -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
if auth.returncode != 0:
    row("BLIND", "gh is not authenticated (run: gh auth login) -- drill freshness unknown, not green")
    sys.exit(2)

now = datetime.now(timezone.utc)
graded, stale, pending = 0, [], 0
for d in entries:
    name = d.get("name", "?")
    wf = d.get("workflow", "")
    job = d.get("job")
    label = "%s%s" % (name, "" if not job or job == name else " (job %s)" % job)
    if d.get("pending"):
        pending += 1
        row("n/a", "%-22s %s not merged yet -- declared in the catalogue, never graded" % (label, wf))
        continue
    graded += 1
    # GitHub keeps run history for a deleted workflow, so a retired file still answers "last
    # green 0.2h ago" for a while (idp#178 review, 2026-08-26: the workflow retired in #167
    # kept being graded from its run history). The file on disk is the only honest source.
    if not os.path.isfile(os.path.join(root, ".github", "workflows", wf)):
        stale.append(name)
        row("FAIL", "%-22s .github/workflows/%s does not exist -- the catalogue names a retired workflow; fix the entry or the file" % (label, wf))
        continue
    try:
        r = gh(["run", "list", "--workflow", wf, "--status", "success", "--limit", "1",
                "--json", "updatedAt"])
    except subprocess.TimeoutExpired:
        stale.append(name)
        row("FAIL", "%-22s gh run list --workflow %s timed out" % (label, wf))
        continue
    if r.returncode != 0:
        stale.append(name)
        detail = ((r.stderr or "").strip().splitlines() or [""])[0]
        row("FAIL", "%-22s gh could not list runs of %s: %s" % (label, wf, detail))
        continue
    try:
        runs = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        runs = []
    if not runs:
        stale.append(name)
        row("FAIL", "%-22s no successful run of %s has ever been recorded (cron %s)"
            % (label, wf, d.get("schedule", "?")))
        continue
    ts = datetime.strptime(runs[0]["updatedAt"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    age = (now - ts).total_seconds() / 3600.0
    cap = float(d.get("max_age_hours", 26))
    if age > cap:
        stale.append(name)
        row("FAIL", "%-22s %s last green %.1fh ago, older than %gh (cron %s)"
            % (label, wf, age, cap, d.get("schedule", "?")))
    else:
        row("ok", "%-22s %s last green %.1fh ago (max %gh)" % (label, wf, age, cap))

tail = " (%d pending)" % pending if pending else ""
if stale:
    row("FAIL", "%d of %d stale: %s%s" % (len(stale), graded, ", ".join(stale), tail))
    sys.exit(1)
row("ok", "%d/%d green within window%s" % (graded, graded, tail))
sys.exit(0)
