#!/usr/bin/env bash
# crew#539 (2026-08-28): the cluster could not heal itself. coredns died behind the Cilium chain,
# so Flux could not resolve github.com, so the merged revert (idp#514) never reached the cluster;
# and no session had a kube path: runners sit outside control_plane_allowed_cidrs and the laptop
# session token is the thing crew#345 retired. A hand into the cluster has to come from the same
# machine identity that plans and applies it: bin/idp-oke-rebuild --break-glass admits the
# runner's /32 through tofu for one job, runs ONE named playbook below, and puts the list back.
#
# Usage: bin/idp-oke-break-glass <playbook>      (--list prints the names)
# Every playbook prints one receipt line per step and exits non-zero when a step fails. A
# playbook is added here, reviewed, and named in the workflow input; nothing is typed ad hoc.
set -uo pipefail
K="kubectl --request-timeout=60s"
FAILED=""
step() { local name="$1"; shift; local out rc; out=$("$@" 2>&1); rc=$?
  printf '%-5s %-22s rc=%-3s %s\n' "$([ $rc -eq 0 ] && echo ok || echo FAIL)" "$name" "$rc" "$(printf %s "$out" | tail -1 | cut -c1-110)"
  [ $rc -eq 0 ] || { FAILED="$FAILED $name"; printf '%s\n' "$out" | tail -6 | sed 's/^/      | /'; }; return $rc; }
show() { local name="$1"; shift; echo "--- $name"; "$@" 2>&1 | head -60; }

# diagnose: read-only. Nodes, the system pods, every Flux source and Kustomization, the failing
# HelmReleases and the last warnings. This is the first playbook of any incident.
pb_diagnose() {
  show nodes $K get nodes -o wide
  show kube-system $K get pods -n kube-system -o wide
  show cni-chain $K get ds,deploy -n kube-system -l app.kubernetes.io/part-of=cilium
  show gitrepositories $K get gitrepositories -A
  show kustomizations $K get kustomizations -A
  show helmreleases-not-ready $K get helmreleases -A --no-headers
  show warnings $K get events -A --field-selector type=Warning --sort-by=.lastTimestamp
  $K get nodes >/dev/null || FAILED="$FAILED nodes"
}

# cilium-unchain: execute idp#514 by hand. The Cilium HelmRelease (and the Kustomization that
# owns it) go first so helm-controller uninstalls the DaemonSet and operator; the chained CNI
# config Cilium wrote to every node is removed by a privileged one-shot DaemonSet (cni.uninstall
# is off by default in Cilium 1.14+, so pod removal leaves 05-cilium.conflist behind and every new
# pod sandbox would still call a cilium-cni whose agent is gone); coredns is restarted onto the
# flannel-only chain; then Flux fetches main and converges on the tree without Cilium.
pb_cilium_unchain() {
  step flux-kustomization $K delete kustomization -n flux-system cilium --ignore-not-found --wait=false
  step helmrelease $K delete helmrelease -n kube-system cilium --ignore-not-found --wait=false
  step wait-daemonset $K wait --for=delete ds/cilium -n kube-system --timeout=180s
  # helm-controller may itself be wedged behind the same DNS: the workloads go directly then
  $K get ds cilium -n kube-system >/dev/null 2>&1 && step daemonset-direct $K delete ds cilium -n kube-system --ignore-not-found
  step operator $K delete deploy cilium-operator -n kube-system --ignore-not-found
  step cni-config-cleanup $K apply -f - <<'YAML'
apiVersion: apps/v1
kind: DaemonSet
metadata: { name: cni-unchain, namespace: kube-system, labels: { app: cni-unchain, crew: "539" } }
spec:
  selector: { matchLabels: { app: cni-unchain } }
  template:
    metadata: { labels: { app: cni-unchain } }
    spec:
      tolerations: [{ operator: Exists }]
      # run 33132419902 (diagnose): with the chain left behind every new sandbox fails at cilium-cni,
      # so the helper itself would never start on the pod network. hostNetwork pods call no CNI.
      hostNetwork: true
      hostPID: true
      priorityClassName: system-node-critical
      containers:
        - name: unchain
          image: public.ecr.aws/docker/library/busybox:1.36
          securityContext: { privileged: true }
          command: ["/bin/sh", "-c", "rm -fv /host/etc/cni/net.d/*cilium* /host/etc/cni/net.d/.cilium* ; ls -la /host/etc/cni/net.d ; sleep 3600"]
          volumeMounts: [{ name: cni, mountPath: /host/etc/cni/net.d }]
      volumes: [{ name: cni, hostPath: { path: /etc/cni/net.d } }]
YAML
  step cni-config-rolled $K rollout status ds/cni-unchain -n kube-system --timeout=180s
  step cni-config-receipt sh -c "$K logs -n kube-system -l app=cni-unchain --tail=20 --prefix"
  step cni-config-remove $K delete ds cni-unchain -n kube-system --ignore-not-found --wait=false
  step coredns-restart $K rollout restart deploy/coredns -n kube-system
  step coredns-ready $K rollout status deploy/coredns -n kube-system --timeout=180s
  step dns-answers $K run dns-probe-$$ --rm -i --restart=Never --image=public.ecr.aws/docker/library/busybox:1.36 --command -- nslookup github.com
  step flux-source flux reconcile source git flux-system -n flux-system --timeout=3m
  step flux-tree flux reconcile kustomization flux-system -n flux-system --timeout=5m
  show kustomizations $K get kustomizations -A
}

case "${1:-}" in
  --list) echo "diagnose cilium-unchain"; exit 0 ;;
  diagnose) pb_diagnose ;;
  cilium-unchain) pb_cilium_unchain ;;
  *) echo "usage: $0 <diagnose|cilium-unchain>"; exit 64 ;;
esac
[ -z "$FAILED" ] && { echo "PASS  break-glass $1"; exit 0; }
echo "FAIL  break-glass $1 broken:$FAILED"; exit 1
