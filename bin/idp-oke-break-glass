#!/usr/bin/env bash
# crew#539 (2026-08-28): the cluster could not heal itself. coredns died behind the Cilium chain,
# so Flux could not resolve github.com, so the merged revert (idp#514) never reached the cluster;
# and no session had a kube path: runners sit outside control_plane_allowed_cidrs and the laptop
# session token is the thing crew#345 retired. A hand into the cluster has to come from the same
# machine identity that plans and applies it: bin/idp-oke-rebuild --break-glass admits the
# runner's /32 through tofu for one job, runs ONE named playbook below, and puts the list back.
#
# Usage: bin/idp-oke-break-glass <playbook>      (--list prints the names)
# Every playbook prints one receipt line per step and exits non-zero when a step fails. A
# playbook is added here, reviewed, and named in the workflow input; nothing is typed ad hoc.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
K="kubectl --request-timeout=60s"
FAILED=""
step() { local name="$1"; shift; local out rc; out=$("$@" 2>&1); rc=$?
  printf '%-5s %-22s rc=%-3s %s\n' "$([ $rc -eq 0 ] && echo ok || echo FAIL)" "$name" "$rc" "$(printf %s "$out" | tail -1 | cut -c1-110)"
  [ $rc -eq 0 ] || { FAILED="$FAILED $name"; printf '%s\n' "$out" | tail -6 | sed 's/^/      | /'; }; return $rc; }
show() { local name="$1"; shift; echo "--- $name"; "$@" 2>&1 | head -60; }
# show_redacted is show for anything that prints a workload's own output: same shape, every line
# through redact() first, so reading a log is never the thing that leaks a token (LAW 21).
# crew#483 reuses this for the collector/agent logs and the ClickHouse count queries, which carry
# the admin password as a --password argument; redact() (defined below, crew#516) is the one
# redaction helper in bin/ (`rg redact bin/`, 2026-08-28) and covers both cases already.
show_redacted() { local name="$1"; shift; echo "--- $name"; "$@" 2>&1 | redact | head -60; }

# dns_probe <pod-name> <nodeName-or-empty> <fqdn> [namespace]: one busybox nslookup, pinned to a
# node when one is named, run in kube-system unless a namespace is given (dns-per-namespace asks
# from inside the failing namespace), shaped like every platform workload so kyverno admits it
# (see the comment above pb_cilium_unchain). Prints the pod's phase and its answer, then removes it.
probe_pod() {
  # probe_pod <pod-name> <nodeName-or-empty> <namespace> <command-json>: one busybox pod, restricted
  # profile, pinned to a node when one is named; prints its log and removes it. dns_probe and
  # tcp_probe are the two shapes.
  local name="$1" node="$2" ns="$3" cmd="$4" pin=""
  [ -n "$node" ] && pin="  nodeName: $node"
  step "$name-clear" $K delete pod/"$name" -n "$ns" --ignore-not-found --wait=true --timeout=60s
  step "$name-apply" $K apply -f - <<YAML
apiVersion: v1
kind: Pod
metadata: { name: $name, namespace: $ns, labels: { app: dns-probe, crew: "539" } }
spec:
  restartPolicy: Never
  priorityClassName: system-cluster-critical
  tolerations: [{ operator: Exists }]
$pin
  securityContext: { runAsNonRoot: true, runAsUser: 65534, seccompProfile: { type: RuntimeDefault } }
  containers:
    - name: probe
      image: public.ecr.aws/docker/library/busybox:1.36
      command: $cmd
      resources: { requests: { cpu: 10m, memory: 16Mi }, limits: { cpu: 100m, memory: 32Mi } }
      readinessProbe: { exec: { command: ["true"] } }
      livenessProbe: { exec: { command: ["true"] } }
      securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
YAML
  step "$name-answers" $K wait pod/"$name" -n "$ns" --for=jsonpath='{.status.phase}'=Succeeded --timeout=180s
  show "$name-log" $K logs pod/"$name" -n "$ns"   # show, not step: one line per target is the receipt
  step "$name-remove" $K delete pod/"$name" -n "$ns" --ignore-not-found --wait=false
}

dns_probe() {
  local name="$1" node="$2" fqdn="$3" ns="${4:-kube-system}"
  probe_pod "$name" "$node" "$ns" "[\"nslookup\", \"$fqdn\"]"
}

# tcp_probe <pod-name> <nodeName> <namespace> "<host:port> ...": one busybox `nc -z -w3` per
# target, printing `ok host:port` or `FAIL host:port`; the pod exits 0 either way so the log is
# the receipt, not the phase.
tcp_probe() {
  local name="$1" node="$2" ns="$3" targets="$4" script
  script="for t in $targets; do h=\${t%:*}; p=\${t##*:}; if nc -z -w3 \$h \$p; then echo ok \$t; else echo FAIL \$t; fi; done"
  probe_pod "$name" "$node" "$ns" "[\"sh\", \"-c\", \"$script\"]"
}

# dns-per-node: run 33140351385 (diagnose at b4f7bec) showed clickhouse failing on
# "Cannot use ZooKeeper host signoz-zookeeper-0.signoz-zookeeper-headless:2181 due to DNS error"
# and langfuse-web on "Can't reach database server at langfuse-postgresql:5432" while every
# Service had endpoints and no node reported pressure: the pods could not resolve, and both sat
# on one node. One nslookup of an in-cluster name and one of github.com is run pinned to EVERY
# node, so a DNS fault is attributed to the node it lives on before anything is restarted.
pb_dns_per_node() {
  local node i=0
  for node in $($K get nodes -o jsonpath='{.items[*].metadata.name}'); do
    i=$((i+1))
    echo "--- node $node"
    dns_probe "dns-probe-svc-$i" "$node" kubernetes.default.svc.cluster.local
    dns_probe "dns-probe-ext-$i" "$node" github.com
  done
  show coredns $K get pods -n kube-system -l k8s-app=kube-dns -o wide
  show coredns-log sh -c "$K logs -n kube-system -l k8s-app=kube-dns --tail=20 --prefix | grep -vE ' - .* NOERROR ' | tail -30"
}

# telemetry_log <namespace> <pod-name-substring>: the pod's own log, all containers, or a named
# reason nothing printed -- a chart rename that moves the pod name is then visible in the run
# instead of a silently empty section.
telemetry_log() {
  local ns="$1" pat="$2" pod
  pod=$($K get pods -n "$ns" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}' 2>/dev/null | grep -m1 "$pat")
  [ -n "$pod" ] || { echo "no pod matching *$pat* in $ns"; return 0; }
  $K logs "$pod" -n "$ns" --all-containers --tail=80 --prefix 2>&1
}
# collector_config_dump: the ConfigMap the signoz-otel-collector mounts, found by name rather than
# typed (the chart's exact ConfigMap name is not declared anywhere in platform/, LAW 46), filtered
# to the receiver/exporter/endpoint lines a chart upgrade or a values change would move.
collector_config_dump() {
  local cm
  cm=$($K get configmap -n observability -o name 2>/dev/null | grep -m1 otel-collector | sed 's#^configmap/##')
  [ -n "$cm" ] || { echo "no ConfigMap matching *otel-collector* in observability"; return 0; }
  $K get configmap "$cm" -n observability -o yaml 2>&1 \
    | grep -E '^[[:space:]]*(receivers|exporters|clickhouselogsexporter|clickhousetracesexporter|clickhousemetricswrite|otlp|endpoint|datasource):'
}
# clickhouse_counts_15m: crew#483 (run 33156980292, 08:45Z): pods_running=80 pods_seen=1 missing=80
# backend_errors={} -- the coverage query answered and answered nearly empty, which is not the same
# fault as a backend nothing can reach. The same three tables telemetry-coverage.yaml queries
# (platform/observability/telemetry-coverage.yaml QUERIES), counted for the last 15 minutes instead
# of the coverage job's 60, from inside the ClickHouse pod itself (kubectl exec, native protocol,
# no extra network hop or exporter needed to answer "is anything landing right now"). The admin
# password is read once from the Secret every other init container in this namespace already
# reads the same way (platform/observability/langfuse.yaml:85) and is never echoed.
clickhouse_counts_15m() {
  local chpod pw
  chpod=$($K get pods -n observability -l clickhouse.altinity.com/chi -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [ -n "$chpod" ] || { echo "no pod with label clickhouse.altinity.com/chi in observability"; return 0; }
  pw=$($K get secret clickhouse-auth -n observability -o jsonpath='{.data.password}' 2>/dev/null)
  # crew#483 CI: a Secret lookup that returns anything other than well-formed base64 (missing,
  # empty, or a CI fixture standing in for an unscripted call) still reaches `base64 -d` on the
  # bare `pw=$(... | base64 -d)` form -- `base64 -d` does not refuse malformed input, it emits
  # whatever bytes the input decodes to, including raw non-UTF-8 bytes that then ride along as a
  # --password argument and corrupt every downstream log this playbook's own invocation record is
  # read back from (bdd/offline-gate run 33160519723: `UnicodeDecodeError ... invalid start byte`,
  # traced to "ok" -> byte 0xa2). Refuse to decode anything that is not valid base64 shape instead.
  # A compound `if ... || ! printf | grep -q ...; then` line trips bin/idp-ci's
  # pipeverdict_scan guard (bin/idp-ci:54-62): its printf/echo/cat/head exemption only
  # recognizes a bare `if printf | grep -q; then` pipeline, not one clause of an `||`
  # chain. Compute the base64-shape check into a plain variable first, outside any
  # if/elif/while condition, so no grep -q pipe's exit status ever sits inside one.
  pw_b64_shaped=0
  printf '%s' "$pw" | grep -E '^[A-Za-z0-9+/]*={0,2}$' >/dev/null && pw_b64_shaped=1
  if [ -z "$pw" ] || [ $(( ${#pw} % 4 )) -ne 0 ] || [ "$pw_b64_shaped" -eq 0 ]; then
    echo "clickhouse-auth secret in observability did not decode to a usable password"
    return 0
  fi
  pw=$(printf '%s' "$pw" | base64 -d 2>/dev/null)
  $K exec -n observability "$chpod" -c clickhouse -- clickhouse-client --user admin --password "$pw" -q \
    "SELECT 'logs', count() FROM signoz_logs.distributed_logs_v2 WHERE timestamp > toUInt64(toUnixTimestamp(now()) - 900) * 1000000000" 2>&1
  $K exec -n observability "$chpod" -c clickhouse -- clickhouse-client --user admin --password "$pw" -q \
    "SELECT 'traces', count() FROM signoz_traces.distributed_signoz_index_v3 WHERE timestamp > now() - INTERVAL 900 SECOND" 2>&1
  $K exec -n observability "$chpod" -c clickhouse -- clickhouse-client --user admin --password "$pw" -q \
    "SELECT 'metrics', count() FROM signoz_metrics.distributed_time_series_v4 WHERE unix_milli > (toUnixTimestamp(now()) - 900) * 1000" 2>&1
}
# otlp_endpoints_by_workload: every Deployment carrying OTEL_EXPORTER_OTLP_ENDPOINT, read from the
# live objects (never from the checked-out manifests -- what is APPLIED is what can be wrong).
otlp_endpoints_by_workload() {
  $K get deploy -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\t"}{range .spec.template.spec.containers[*].env[?(@.name=="OTEL_EXPORTER_OTLP_ENDPOINT")]}{.value}{end}{"\n"}{end}' 2>/dev/null \
    | awk -F'\t' '$2!=""'
}

# diagnose: read-only. Nodes, the system pods, every Flux source and Kustomization, the failing
# HelmReleases and the last warnings. This is the first playbook of any incident.
pb_diagnose() {
  # K8sGPT already runs in the cluster (platform/healing/analyzer, backend = the estate LiteLLM):
  # its findings are Result objects and until 2026-08-29 nothing read them (founder: "why are we
  # not using it"). Printed first so the plain-English cause is above the raw state.
  show k8sgpt-results sh -c "$K get results.core.k8sgpt.ai -A -o jsonpath='{range .items[*]}{.spec.kind}/{.metadata.namespace}/{.spec.name}{\"\n\"}{range .spec.error[*]}{\"  error: \"}{.text}{\"\n\"}{end}{\"  \"}{.spec.details}{\"\n\n\"}{end}'"
  show nodes $K get nodes -o wide
  # Run 33139372173: every red pod sat on one node and every failure was "the process is not
  # answering on its port" (clickhouse startup probe refused x202, signoz 500, langfuse P1001,
  # redis closed). That is what starvation looks like; the reason is on the node, not in the
  # pod. Node conditions, live usage and allocated requests/limits are read first so the repair
  # can be attributed (LAW 29) before a probe or a resource line is touched.
  show node-pressure sh -c "$K top nodes; $K get nodes -o jsonpath='{range .items[*]}{.metadata.name}{\"\t\"}{range .status.conditions[*]}{.type}={.status}{\" \"}{end}{\"\n\"}{end}'; $K describe nodes | grep -E '^Name:|Allocated resources|^  (cpu|memory|ephemeral-storage) ' "
  show kube-system $K get pods -n kube-system -o wide
  show cni-chain $K get ds,deploy -n kube-system -l app.kubernetes.io/part-of=cilium
  show gitrepositories $K get gitrepositories -A
  show kustomizations $K get kustomizations -A
  # idp#685 and idp#697, 2026-08-29: Kustomization/mcp and Kustomization/temporal each timed out
  # after 20 min on `ExternalSecret/<ns>/ghcr-pull status: InProgress`, five identical bot posts
  # over three hours and not one line saying why, because a diagnose printed kustomizations,
  # helmreleases, pods and k8sgpt findings and never an ExternalSecret. The Kustomization row can
  # only ever repeat the object name it is waiting on; the reason is on that object's own Ready
  # condition, and on the store it reads through. Both are printed here, store first: one unready
  # ClusterSecretStore is every ExternalSecret behind it, and reading the dependents first invites
  # the repair to start at the wrong end (LAW 29, attribute before you repair).
  show clustersecretstores-not-ready sh -c "$K get clustersecretstores.external-secrets.io -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type==\"Ready\")]}{.status}{\"\t\"}{end}{.metadata.name}{\"\t\"}{range .status.conditions[?(@.type==\"Ready\")]}{.reason}: {.message}{end}{\"\n\"}{end}' 2>&1"
  show externalsecrets-not-ready sh -c "$K get externalsecrets.external-secrets.io -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type==\"Ready\")]}{.status}{\"\t\"}{.reason}{\"\t\"}{end}{.metadata.namespace}/{.metadata.name}{\"\tstore=\"}{.spec.secretStoreRef.kind}/{.spec.secretStoreRef.name}{\"\t\"}{range .status.conditions[?(@.type==\"Ready\")]}{.message}{end}{\"\n\"}{end}' 2>&1"
  # Run 33226089358 (idp#648, 2026-08-29): backstage-namespace said "timeout waiting for
  # Namespace/backstage status: Terminating" for 16 min and nothing said why. A Terminating
  # namespace carries the reason on its own conditions (NamespaceContentRemaining names the
  # kinds, NamespaceDeletionDiscoveryFailure names an APIService that will not answer).
  show namespaces-terminating $K get ns -o jsonpath='{range .items[?(@.status.phase=="Terminating")]}{.metadata.name}{"\n"}{range .status.conditions[?(@.status=="True")]}{"  "}{.type}: {.message}{"\n"}{end}{end}'
  # The printer column truncates the Ready message to `...`, and the reason is always past the cut:
  # run 33149570222 printed `admission webhook "validate.kyverno.svc-fail" denied the request: ...`
  # for robusta and never the policy name, so the diagnose named the wall and not the door. Reading
  # the condition directly is what the stalled-deployments row below already does.
  show helmreleases-not-ready $K get helmreleases -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type=="Ready")]}{.status}{"\t"}{end}{.metadata.namespace}/{.metadata.name}{"\t"}{.metadata.creationTimestamp}{"\t"}{range .status.conditions[?(@.type=="Ready")]}{.reason}: {.message}{end}{"\n"}{end}'
  # A HelmRelease says "Deployment X status: Failed" and nothing else; the reason lives on the
  # Deployment's Progressing condition and on the pods it could not roll (run 33136391785 printed
  # the HelmRelease line for langfuse-web three times and never why).
  show stalled-deployments $K get deploy -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type=="Progressing")]}{.status}{"\t"}{end}{.metadata.namespace}/{.metadata.name}{"\t"}{.status.readyReplicas}/{.spec.replicas}{"\t"}{range .status.conditions[?(@.type=="Progressing")]}{.reason}: {.message}{end}{"\n"}{end}'
  show pods-not-running $K get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded -o wide
  # 2026-08-29 01:05Z: Namespace/backstage sat in Terminating for 46 minutes while every Flux row
  # behind backstage-namespace cascaded, and diagnose printed nothing about it -- the namespace
  # phase and what still holds it were the two lines the whole outage needed (LAW 28).
  show namespaces-terminating sh -c "$K get ns -o jsonpath='{range .items[?(@.status.phase==\"Terminating\")]}{.metadata.name}{\"\\t\"}{.metadata.deletionTimestamp}{\"\\t\"}{range .status.conditions[?(@.status==\"True\")]}{.type}: {.message}{\"; \"}{end}{\"\\n\"}{end}'"
  # Run 33138549588 named the stalled ReplicaSet and stopped: the pod was Running, so the reason
  # (a readiness probe, a crash, a mount) was only in its events and log. Every pod that is
  # Running but not Ready is described and its last log lines printed; for pods that ended in
  # Failed (a CronJob erroring every tick) the newest one per namespace is read the same way.
  local unready failed
  unready=$($K get pods -A -o jsonpath='{range .items[?(@.status.phase=="Running")]}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{" "}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' 2>/dev/null | awk '$1=="False"{print $2" "$3}')
  failed=$($K get pods -A --field-selector=status.phase=Failed --sort-by=.metadata.creationTimestamp -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' 2>/dev/null | awk '{last[$1]=$2} END{for (ns in last) print ns" "last[ns]}')
  local ns name
  printf '%s\n%s\n' "$unready" "$failed" | while read -r ns name; do
    [ -n "$name" ] || continue
    show "pod $ns/$name" sh -c "$K describe pod $name -n $ns | sed -n '/^Node:/p;/^Containers:/,\$p' | grep -E '^Node:|State|Reason|Exit Code|Ready|Message|Warning|Normal|Liveness|Readiness|Back-off|Failed|Error' | tail -25"
    show "log $ns/$name" $K logs "$name" -n "$ns" --all-containers --tail=30 --prefix
    # crew#570 CP1, proved 2026-08-28T12:46Z (run 33172282641). A crash-looping container is
    # BETWEEN attempts for most of any window this runs in, so the current log is empty and the
    # words that name the fault exist only in the previous attempt. The robusta init crash-loop
    # held six Flux kustomizations not-Ready for hours, and the one line of cause --
    #   cp: preserving times for '/venv-writable/.': Operation not permitted
    # -- was never once printed by the tail above. --previous exits nonzero when there is no
    # previous attempt, which is the ordinary case here and is not an error.
    show "log-previous $ns/$name" sh -c "$K logs '$name' -n '$ns' --all-containers --previous --tail=30 --prefix 2>&1 | tail -30"
  done
  # crew#539, 2026-08-28 (run 33169347978): robusta-runner sat in Init:CrashLoopBackOff for 4h in
  # phase Pending, so the branch above (Running, not Ready) never tailed it and the run listed the
  # pod without a word from it. A pod whose init container crashes is Pending, and its init log is
  # the only line that says why; --all-containers includes init containers.
  local pending
  pending=$($K get pods -A --field-selector=status.phase=Pending -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' 2>/dev/null)
  while read -r ns name; do
    [ -n "$name" ] || continue
    # The restart count and the reason live in the pod's events, not in either log: it was
    # `Back-off restarting failed container setup-venv ... (x7 over 5m44s)` that said the init
    # container was looping rather than merely slow to start.
    show "pod $ns/$name" sh -c "$K describe pod $name -n $ns | sed -n '/^Node:/p;/^Containers:/,\$p' | grep -E '^Node:|State|Reason|Exit Code|Ready|Message|Warning|Normal|Liveness|Readiness|Back-off|Failed|Error' | tail -25"
    show "init-log $ns/$name" $K logs "$name" -n "$ns" --all-containers --tail=30 --prefix
    # An init container that crash-loops is the case this block was written for, and it is exactly
    # the case whose current log is empty between attempts. Without this line the block reports a
    # Pending pod and says nothing about why (crew#570 CP1).
    show "init-log-previous $ns/$name" sh -c "$K logs '$name' -n '$ns' --all-containers --previous --tail=30 --prefix 2>&1 | tail -30"
  done <<<"$pending"
  # langfuse-web could not reach langfuse-postgresql:5432 while the postgres pod was Running: a
  # Service with no ready address is the difference, and it is only visible on the Endpoints.
  # Run 33144117286: idp#536 raised clickhouse to 4Gi, Helm reported signoz.v40, and the pod kept
  # logging "maximum: 1.80 GiB" because nothing rolled it. Helm -> ClickHouseInstallation ->
  # StatefulSet -> pod is four links; print the memory limit at each so the broken one is named.
  show clickhouse-installation sh -c "$K get chi -A -o wide 2>&1; $K get chi -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{\"\tCHI podTemplate limits: \"}{range .spec.templates.podTemplates[*]}{.spec.containers[0].resources.limits}{end}{\"\n\"}{end}' 2>&1; $K get sts -A -l clickhouse.altinity.com/chi -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{\"\tsts limits: \"}{.spec.template.spec.containers[0].resources.limits}{\"\tobservedGeneration=\"}{.status.observedGeneration}{\" generation=\"}{.metadata.generation}{\"\n\"}{end}' 2>&1; $K get pods -A -l clickhouse.altinity.com/chi -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{\"\tpod limits: \"}{.spec.containers[0].resources.limits}{\"\n\"}{end}' 2>&1"
  # kubectl logs takes no -A (idp#538 review): resolve the operator's namespace first.
  # run 33145711762: `-l app=clickhouse-operator` matched nothing (the signoz chart labels the
  # operator pod by its own names); the pod is found by name, which every chart version keeps
  show clickhouse-operator-log sh -c "set -- \$($K get pods -A --no-headers 2>/dev/null | awk '\$2 ~ /clickhouse-operator/ {print \$1, \$2; exit}'); [ -n \"\${2:-}\" ] || { echo 'no pod named *clickhouse-operator*'; exit 0; }; $K logs -n \"\$1\" \"\$2\" --all-containers --tail=40 --prefix 2>&1 | tail -40"
  # Run 33143467334: 21 descheduler pods in Error with no row saying whether the CronJob's later
  # runs succeed; jobs are the receipt, pods are the history.
  show cronjobs $K get cronjobs,jobs -A
  show endpoints-empty sh -c "$K get endpoints -A | awk 'NR==1 || \$3==\"<none>\"'"
  show warnings sh -c "$K get events -A --field-selector type=Warning --sort-by=.lastTimestamp | tail -60"
  # Run 33210647434 (2026-08-28): the warnings table printed `admission webhook "validate.kyverno.svc-fail"
  # denied the request: ...` for replicaset tailscale/operator -- the column cut the policy name and
  # the rule off, and bin/idp-kyverno-render passes the same manifest locally, so the row that names
  # the policy the cluster holds is the only way to see the drift. Full messages, admission only.
  # crew#718 CP7, 2026-08-30: the line above was written for exactly this and STILL lost the answer.
  # A Kyverno denial message is multi-line -- the policy and rule names are on the lines AFTER the
  # one carrying `admission webhook`, so a plain grep keeps the useless half and drops the half that
  # names the policy. Runs 33332291556 and 33333488911 both printed
  # `tailscale/operator-56cf79864d: Error creating: admission webhook "validate.kyverno.svc-fail"
  # denied the request:` and then nothing, for the second time in two days, while
  # bin/idp-kyverno-render passes the same manifest locally. -A keeps the continuation lines.
  show admission-denials sh -c "$K get events -A --field-selector reason=FailedCreate -o jsonpath='{range .items[*]}{.lastTimestamp} {.involvedObject.namespace}/{.involvedObject.name}: {.message}{\"\\n\"}{end}' 2>/dev/null | grep -i -A 6 'admission webhook' | tail -60; true"
  # The policy report is the authority when the event is truncated anyway: Kyverno records every
  # failed rule by name against the resource, and it survives the event's one-hour TTL.
  show policy-reports sh -c "$K get policyreport,clusterpolicyreport -A -o jsonpath='{range .items[*]}{range .results[?(@.result==\"fail\")]}{.policy}/{.rule}: {.message}{\"\\n\"}{end}{end}' 2>/dev/null | sort -u | tail -40; true"
  # 2026-08-29 (run 33229461240): a claim that names no class gets the cluster default injected
  # before Kyverno sees it; a provider-named default made every new claim fail. Both facts are
  # read here so the next such outage is one diagnose run, not ninety minutes.
  show storage-classes $K get storageclasses
  # crew#307 (2026-08-29, founder: "gods view isn't there", "everything that has an interface"): the
  # founder's surfaces come from /estate/founder/catalog-info.yaml in the catalogue pod. Three rows
  # say whether the file is there, whether the catalogue read it, and what it holds.
  show catalogue-founder-file sh -c "$K exec -n backstage deploy/catalogue -- ls -la /estate /estate/founder 2>&1"
  show catalogue-founder-configmap sh -c "$K get configmap founder-catalog estate-catalog -n backstage -o jsonpath='{range .items[*]}{.metadata.name}{\"\t\"}{.metadata.creationTimestamp}{\"\n\"}{end}' 2>&1"
  # crew#626 CP15: the drill on idp#808 lands on /auth/sign-in?error=OAuthCallback after the SSO
  # click, with and without AUTH_CUSTOM_ID_TOKEN. The laptop has no cluster key by design, so the
  # only place the callback error is readable is here: the auth lines of langfuse-web, and the
  # three non-secret AUTH_CUSTOM_* values the pod actually runs with (never the client secret).
  show langfuse-auth-env sh -c "$K exec -n observability deploy/langfuse-web -- sh -c 'env | grep -E \"^AUTH_CUSTOM_(ISSUER|ID_TOKEN|SCOPE|NAME|ALLOW_ACCOUNT_LINKING)=|^NEXTAUTH_URL=\"' 2>&1 | sort"
  show langfuse-auth-log sh -c "$K logs -n observability deploy/langfuse-web --all-containers --tail=3000 2>&1 | grep -iE 'oauth|callback|issuer|id_token|jwt|openid|next-auth|\[next-auth\]' | tail -60"
  show catalogue-log-locations sh -c "$K logs -n backstage deploy/catalogue --all-containers --tail=2000 2>&1 | grep -iE 'founder|location|catalog.*(error|fail|refus|invalid)' | tail -40"
  show catalogue-entities sh -c "$K exec -n backstage deploy/catalogue -- sh -c 'wget -qO- http://catalogue.backstage.svc:3100/api/catalog/entities?filter=spec.type=founder-surface | head -c 600' 2>&1"
  show claims-not-bound sh -c "$K get pvc -A --field-selector=status.phase!=Bound 2>/dev/null; true"
  # The audit of the rules by the cluster: Kyverno scans every existing object in the background and
  # records which rule would refuse it. A rule with fails here is a rule that judges reality, not
  # what we wrote (founder, 2026-08-29: "get all the regexes and audit").
  show policy-report-fails sh -c "$K get policyreports,clusterpolicyreports -A -o json 2>/dev/null | jq -r '[.items[].results[]? | select(.result==\"fail\") | \"\\(.policy)/\\(.rule)\"] | group_by(.) | map(\"\\(length)\\t\\(.[0])\") | .[]' | sort -rn | head -40; true"
  show admission-denials-live sh -c "$K get admissionreports -A -o json 2>/dev/null | jq -r '[.items[].spec.results[]? | select(.result==\"fail\") | \"\\(.policy)/\\(.rule)\"] | group_by(.) | map(\"\\(length)\\t\\(.[0])\") | .[]' | sort -rn | head -20; true"
  # --- telemetry (crew#483): run 33156980292 (08:45Z) printed pods_running=80 pods_seen=1
  # missing=80 backend_errors={} and nothing above ever looks at the collector's own words -- the
  # pod-not-ready branch above only tails a pod when it is unready, and both telemetry components
  # were Ready throughout. This answers where the other 79 pods' telemetry is lost: pod health for
  # signoz-otel-collector and both k8s-infra components; each one's own log; the collector's live
  # receiver/exporter config; the ClickHouse row counts for the last 15 minutes from the exact
  # tables the coverage job queries; the OTLP endpoint every workload is told to use; and which
  # Deployments actually carry that env var. Read-only throughout.
  local ns
  for ns in observability observability-agent; do
    show "telemetry-pods-$ns" $K get pods -n "$ns" -o wide
  done
  show_redacted collector-log telemetry_log observability otel-collector
  show_redacted k8s-infra-agent-log telemetry_log observability-agent otel-agent
  show_redacted k8s-infra-deployment-log telemetry_log observability-agent otel-deployment
  show collector-config collector_config_dump
  show_redacted clickhouse-counts-15m clickhouse_counts_15m
  show otlp-endpoint-declared $K get helmrelease k8s-infra -n observability-agent -o jsonpath='{"k8s-infra otelCollectorEndpoint: "}{.spec.values.otelCollectorEndpoint}{"\n"}'
  show otlp-endpoint-workloads otlp_endpoints_by_workload
  $K get nodes >/dev/null || FAILED="$FAILED nodes"
}

# cilium-unchain: execute idp#514 by hand. The Cilium HelmRelease (and the Kustomization that
# owns it) go first so helm-controller uninstalls the DaemonSet and operator; the chained CNI
# config Cilium wrote to every node is removed by a privileged one-shot DaemonSet (cni.uninstall
# is off by default in Cilium 1.14+, so pod removal leaves 05-cilium.conflist behind and every new
# pod sandbox would still call a cilium-cni whose agent is gone); coredns is restarted onto the
# flannel-only chain; then Flux fetches main and converges on the tree without Cilium. This is
# also the rollback for cilium-replace (below): after this runs, re-apply the flannel DaemonSet
# cilium-replace saved to $RUNNER_TEMP/kube-flannel-ds.yaml.
pb_cilium_unchain() {
  step flux-kustomization $K delete kustomization -n flux-system cilium --ignore-not-found --wait=false
  step helmrelease $K delete helmrelease -n kube-system cilium --ignore-not-found --wait=false
  step wait-daemonset $K wait --for=delete ds/cilium -n kube-system --timeout=180s
  # helm-controller may itself be wedged behind the same DNS: the workloads go directly then
  $K get ds cilium -n kube-system >/dev/null 2>&1 && step daemonset-direct $K delete ds cilium -n kube-system --ignore-not-found
  step operator $K delete deploy cilium-operator -n kube-system --ignore-not-found
  step cni-config-cleanup $K apply -f - <<'YAML'
apiVersion: apps/v1
kind: DaemonSet
metadata: { name: cni-unchain, namespace: kube-system, labels: { app: cni-unchain, crew: "539" } }
spec:
  selector: { matchLabels: { app: cni-unchain } }
  template:
    metadata: { labels: { app: cni-unchain } }
    spec:
      tolerations: [{ operator: Exists }]
      # run 33132419902 (diagnose): with the chain left behind every new sandbox fails at cilium-cni,
      # so the helper itself would never start on the pod network. hostNetwork pods call no CNI.
      hostNetwork: true
      hostPID: true
      priorityClassName: system-node-critical
      containers:
        - name: unchain
          image: public.ecr.aws/docker/library/busybox:1.36
          securityContext: { privileged: true }
          command: ["/bin/sh", "-c", "rm -fv /host/etc/cni/net.d/*cilium* /host/etc/cni/net.d/.cilium* ; ls -la /host/etc/cni/net.d ; sleep 3600"]
          volumeMounts: [{ name: cni, mountPath: /host/etc/cni/net.d }]
      volumes: [{ name: cni, hostPath: { path: /etc/cni/net.d } }]
YAML
  step cni-config-rolled $K rollout status ds/cni-unchain -n kube-system --timeout=180s
  step cni-config-receipt sh -c "$K logs -n kube-system -l app=cni-unchain --tail=20 --prefix"
  step cni-config-remove $K delete ds cni-unchain -n kube-system --ignore-not-found --wait=false
  step coredns-restart $K rollout restart deploy/coredns -n kube-system
  step coredns-ready $K rollout status deploy/coredns -n kube-system --timeout=180s
  # run 33133317589: with sandboxes working again, the admission webhooks that were rescheduled
  # during the outage (external-secrets webhook, kyverno admission) still sat in a dead sandbox,
  # so every ExternalSecret/ClusterSecretStore dry-run failed with EOF and secret-store plus its
  # ~35 dependents stayed not Ready. Restart them onto fresh sandboxes before Flux reconciles.
  step webhooks-restart $K rollout restart deploy -n external-secrets
  step kyverno-restart $K rollout restart deploy -n kyverno
  step webhooks-ready $K rollout status deploy -n external-secrets --timeout=180s
  step kyverno-ready $K rollout status deploy -n kyverno --timeout=180s
  # kyverno (runs 33133317589, 33134611331): a `kubectl run` pod is refused by require-run-as-nonroot,
  # require-ro-rootfs, restrict-seccomp-strict, disallow-default-namespace, require-pod-probes and
  # require-requests-limits, so the probe is a full Pod manifest in kube-system shaped like every
  # platform workload. nslookup needs no root, no writable fs and no privilege.
  dns_probe dns-probe '' github.com
  step flux-source flux reconcile source git flux-system -n flux-system --timeout=3m
  step flux-tree flux reconcile kustomization flux-system -n flux-system --timeout=5m
  # run 33134611331: reconciling flux-system does not cascade to its children, so secret-store kept
  # the dry-run EOF from before the webhook restart in its status. Force it, then read the tree.
  step secret-store flux reconcile kustomization secret-store -n flux-system --timeout=5m
  show kustomizations $K get kustomizations -A
}

# cilium-replace: crew#539 CP12 correction (founder, 2026-08-28, twice: "are we getting hubble or
# not" -> yes). idp#505 chained Cilium after OKE's flannel; idp#514 reverted it because chaining
# took coredns down and Flux could not even fetch the revert. The supported shape, Oracle's own
# tutorial (https://docs.oracle.com/en/learn/oke-flannel-to-cilium-cni-plugin/index.html), is
# Cilium REPLACING flannel: the flannel DaemonSet is saved first (rollback material) then removed,
# Cilium installs from platform/cni/cilium-values.yaml (ipam.mode=kubernetes,
# kubeProxyReplacement=false, Hubble on), and every non-hostNetwork pod in the namespaces that
# must come back first is deleted so the kubelet reschedules it onto the new network -- one
# namespace at a time, --wait=false so this does not block on a pod the new CNI has not reached
# yet. THE FOUNDER FROZE DRAIN AND CORDON FOR THIS PLAYBOOK (crew#539 5449358659, the node-drain
# cordon window itself paged as an outage): cilium-replace never cordons and never drains: a pod
# is deleted and the scheduler places its replacement, nothing is evicted off a node by name.
# Rollback: bin/idp-oke-break-glass cilium-unchain, then `kubectl apply -f` the saved
# kube-flannel-ds.yaml (cilium-replace does not re-apply it itself: the two rollback steps are
# reviewed by a human before they run on a cluster mid-outage).
pb_cilium_replace() {
  local receipt_dir="${RUNNER_TEMP:-/tmp}" ns pods pod
  step flannel-save sh -c "$K get ds kube-flannel-ds -n kube-system -o yaml > '$receipt_dir/kube-flannel-ds.yaml'"
  step flannel-delete $K delete -n kube-system daemonset kube-flannel-ds
  step cilium-install helm install cilium oci://quay.io/cilium/charts/cilium --version 1.20.1 --namespace kube-system -f "$IDP/platform/cni/cilium-values.yaml"
  step cilium-ready $K rollout status ds/cilium -n kube-system --timeout=600s
  for ns in flux-system observability edge backstage identity drills; do
    pods=$($K get pods -n "$ns" -o jsonpath='{range .items[?(@.spec.hostNetwork!=true)]}{.metadata.name}{" "}{end}' 2>/dev/null)
    for pod in $pods; do
      step "reschedule-$ns-$pod" $K delete pod "$pod" -n "$ns" --wait=false
    done
  done
  show cilium-pods $K get pods -n kube-system
  show pods-not-running $K get pods -A --field-selector=status.phase!=Running,status.phase!=Succeeded
}

# dns-per-namespace: run 33141542523 (dns-per-node at 421fe6d) resolved an in-cluster and an
# external name from every node, so the DNS plane is sound; yet clickhouse still logged
# "ZooKeeper host signoz-zookeeper-0.signoz-zookeeper-headless:2181 ... Temporary DNS error" and
# coredns answered NXDOMAIN to that pod for chi-signoz-clickhouse-cluster-0-0.observability.svc,
# a per-replica Service the operator should hold. The names that fail are the namespace's own
# headless Services, which resolve only while their pods are ready. For every namespace holding a
# Ready=False HelmRelease: list its Services and EndpointSlices, resolve every headless Service
# from a probe pod INSIDE that namespace (its policies, its search path), then grep coredns for
# that namespace's names that did not answer NOERROR.
pb_dns_per_namespace() {
  local namespaces ns name i=0
  namespaces=$($K get helmreleases -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{" "}{.metadata.namespace}{"\n"}{end}' 2>/dev/null | awk '$1=="False"{print $2}' | sort -u)
  echo "--- namespaces-not-ready"; printf '%s\n' "${namespaces:-none}"
  for ns in $namespaces; do
    echo "--- namespace $ns"
    show "$ns-services" $K get svc,endpointslices -n "$ns"
    for name in $($K get svc -n "$ns" -o jsonpath='{range .items[?(@.spec.clusterIP=="None")]}{.metadata.name}{" "}{end}'); do
      i=$((i+1))
      dns_probe "dns-probe-ns-$i" '' "$name.$ns.svc.cluster.local" "$ns"
    done
    show "$ns-coredns-log" sh -c "$K logs -n kube-system -l k8s-app=kube-dns --tail=2000 2>&1 | grep -F '.$ns.svc.' | grep -v NOERROR | tail -40"
  done
}

# tcp-per-node: run 33143467334 (diagnose at 66db95a) had langfuse-web on 10.0.148.221 failing
# `P1001 Can't reach database server at langfuse-postgresql:5432` while langfuse-postgresql was in
# neither pods-not-running nor endpoints-empty and dns-per-namespace (33142680663) resolved every
# name. dns-per-node only proved UDP to coredns's ClusterIP, which a node can answer locally. The
# untested path is pod-to-pod TCP through a ClusterIP across nodes: from a probe inside each
# not-Ready namespace, pinned to every node in turn, connect to every Service port of that
# namespace and print the reachable matrix beside the pods' placement.
pb_tcp_per_node() {
  local namespaces ns node targets i=0
  namespaces=$($K get helmreleases -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{" "}{.metadata.namespace}{"\n"}{end}' 2>/dev/null | awk '$1=="False"{print $2}' | sort -u)
  echo "--- namespaces-not-ready"; printf '%s\n' "${namespaces:-none}"
  for ns in $namespaces; do
    echo "--- namespace $ns"
    show "$ns-placement" $K get pods -n "$ns" -o wide
    # first port of every ClusterIP Service: the one its clients name (postgres 5432, redis 6379)
    targets=$($K get svc -n "$ns" -o jsonpath='{range .items[?(@.spec.clusterIP!="None")]}{.metadata.name}{"."}'"$ns"'{".svc.cluster.local:"}{.spec.ports[0].port}{" "}{end}')
    [ -z "$targets" ] && { echo "no ClusterIP Service in $ns"; continue; }
    for node in $($K get nodes -o jsonpath='{.items[*].metadata.name}'); do
      i=$((i+1))
      echo "--- from node $node into $ns"
      tcp_probe "tcp-probe-$i" "$node" "$ns" "$targets"
    done
  done
  show networkpolicies $K get networkpolicies,ciliumnetworkpolicies -A 2>&1
}

# helm-retry: a HelmRelease that failed during an outage stays Failed after the outage ends,
# because helm-controller spends its remediation retries once and then waits for a spec change
# (langfuse: "Deployment/observability/langfuse-web status: Failed" 31h after the Cilium chain).
# `flux reconcile --reset` zeroes the failure counters and runs the upgrade again on the healthy
# cluster; a release that is Ready is left alone. Then the Kustomizations that depend on those
# releases are reconciled so their status is fresh (reconcile does not cascade, idp#525).
# crew#516 CP4 / crew#524 CP5, 2026-08-28: The Architect's gateway was 1/1 Ready and Applied for
# 15h while Telegram answered nobody, and the estate had no way to find out why. `diagnose` tails a
# pod's log only when the pod is NOT ready, the estate MCP that exposes get_workload_logs answers
# 401, and the founder's Mac gateway -- the fallback -- had been booted out as step one of the
# cutover. A deployment reporting healthy is not the product working, and there was no route to the
# difference (LAW 28). This playbook is that route: read-only, and it never prints a secret VALUE.
#
# What it answers, in the order the failure happens: does the pod exist and has it been restarting;
# did ESO actually produce the env Secret and which KEY NAMES landed in it (a missing
# TELEGRAM_BOT_TOKEN is silent -- the gateway starts fine and simply serves no chat); and what the
# container itself says. Every log line goes through redact(), so a token pasted into a log by the
# app does not become a CI artefact.
redact() {
  # Telegram bot tokens are <8-10 digits>:<~35 chars>; the length is not contractual, so the rule
  # is {30,} rather than the 35 the current ones happen to be. The second pattern catches anything
  # after a key/token/secret/password word, and its value class includes ':' so a two-part value is
  # taken whole -- without that, `TOKEN=1234567890:AAA...` redacts to nothing, because the digits
  # before the colon are only 10 characters. Neither rule is a substitute for not logging secrets:
  # this is the floor, so that reading a log can never be the thing that leaks one.
  sed -E -e 's/[0-9]{8,10}:[A-Za-z0-9_-]{30,}/<REDACTED-BOT-TOKEN>/g' \
         -e 's/(([Tt][Oo][Kk][Ee][Nn]|[Kk][Ee][Yy]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd])["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"']?)[A-Za-z0-9_.:\-]{12,}/\1<REDACTED>/g'
}

# router-spend (crew#568, founder 2026-08-29: "claude code has monopolised the scene ... we are not
# utilising our agents"): who actually calls the model router, through which key, on which lane, and
# what it cost. The router's own ledger (LiteLLM_SpendLogs in litellm-db) is the only honest answer;
# a file scan says who is CONFIGURED to call it, never who did (LAW 50). Read-only: psql over the
# pod's unix socket (trust auth, no password handled), aliases and totals only, never a key value.
pb_router_spend() {
  local ns=llm dbns=estate-db pod
  # The ledger moved onto the shared estate-db: platform/llm/litellm.yaml composes DATABASE_URL
  # against estate-rw.estate-db.svc.cluster.local. The pod this read used to exec into, litellm-db-0,
  # no longer exists, so every run since the consolidation answered "pods litellm-db-0 not found"
  # and the router's spend was unreadable -- an accounting blind spot, not an empty ledger
  # (run 33914769721, 2026-09-04). The primary is found by label so a failover does not break it.
  pod=$($K get pods -n "$dbns" -l 'cnpg.io/cluster=estate,role=primary' -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [ -n "$pod" ] || { echo "FAIL  no primary pod for cnpg cluster 'estate' in $dbns"; return 1; }
  local q='psql -U postgres -d litellm -At -F "|" -c'
  show router-pods $K get pods -n "$ns" -o wide
  show db-primary sh -c "echo $dbns/$pod"
  show_redacted spend-by-consumer-and-lane sh -c "$K exec -n $dbns $pod -c postgres -- $q \"select coalesce(v.key_alias, 'no-alias:' || left(s.api_key, 8)) as consumer, s.model, count(*) as calls, round(sum(s.spend)::numeric, 4) as usd, sum(s.total_tokens) as tokens, min(s.\\\"startTime\\\")::date as first, max(s.\\\"startTime\\\")::date as last from \\\"LiteLLM_SpendLogs\\\" s left join \\\"LiteLLM_VerificationToken\\\" v on v.token = s.api_key group by 1, 2 order by 3 desc limit 40\" 2>&1"
  show_redacted spend-per-day-14d sh -c "$K exec -n $dbns $pod -c postgres -- $q \"select \\\"startTime\\\"::date as day, count(*) as calls, round(sum(spend)::numeric, 4) as usd from \\\"LiteLLM_SpendLogs\\\" where \\\"startTime\\\" > now() - interval '14 days' group by 1 order by 1\" 2>&1"
  show_redacted spend-today-by-hour-and-consumer sh -c "$K exec -n $dbns $pod -c postgres -- $q \"select date_trunc('hour', s.\\\"startTime\\\") as hour, coalesce(v.key_alias, 'no-alias:' || left(s.api_key, 8)) as consumer, s.model, count(*) as calls, sum(s.total_tokens) as tokens from \\\"LiteLLM_SpendLogs\\\" s left join \\\"LiteLLM_VerificationToken\\\" v on v.token = s.api_key where s.\\\"startTime\\\" > now() - interval '36 hours' group by 1,2,3 order by 1 desc, 5 desc limit 60\" 2>&1"
  show_redacted virtual-keys sh -c "$K exec -n $dbns $pod -c postgres -- $q \"select coalesce(key_alias, '(none)') as alias, round(spend::numeric, 4) as usd, max_budget, budget_duration, created_at::date, expires::date from \\\"LiteLLM_VerificationToken\\\" order by spend desc limit 40\" 2>&1"
}

pb_architect_doctor() {
  local ns=hermes-agent
  show pods $K get pods -n "$ns" -o wide
  show restarts $K get pods -n "$ns" -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.containerStatuses[*].restartCount}{"\t"}{.status.containerStatuses[*].lastState.terminated.reason}{"\n"}{end}'
  show externalsecrets $K get externalsecrets -n "$ns" -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{range .status.conditions[*]}{.type}={.status} {.reason}: {.message}{end}{"\n"}{end}'
  # alerts-firing: what Alertmanager holds for this namespace right now, so a down pod is read here
  # as the alert it raised, not only as a pod row (2026-08-29: Otto down 4h, nobody could say whether
  # KubePodNotReady had fired). amtool runs inside the alertmanager pod; no port-forward, no hand.
  show alerts-firing sh -c "am=\$($K get pods -n ${AM_NS:-monitoring} -l app.kubernetes.io/name=alertmanager -o jsonpath='{.items[0].metadata.name}' 2>/dev/null); [ -n \"\$am\" ] || { echo no-alertmanager-pod; exit 0; }; $K exec -n ${AM_NS:-monitoring} \"\$am\" -c alertmanager -- amtool --alertmanager.url=http://localhost:${AM_PORT:-9093} alert query namespace=$ns -o simple 2>&1 || echo query-failed"
  # KEY NAMES only. `-o jsonpath={.data}` would print the values; keys() prints what the pod can
  # read, which is the whole question -- an env Secret missing TELEGRAM_BOT_TOKEN is the silent way
  # for a green pod to serve nobody.
  # go-template, not jsonpath: `{range $.data}{@}{end}` iterates the map and prints the VALUES.
  # This prints the keys and nothing else -- what the pod can read, never what it reads.
  show env-key-names $K get secret hermes-agent-env -n "$ns" -o go-template='{{range $k, $v := .data}}{{$k}}{{"\n"}}{{end}}'
  # crew#63 A1: the Architect's verification ledger, read where it lives (HERMES_HOME=/data on the
  # gateway PVC). A count of 0 after real work is the finding, not a guess (LAW 29).
  show verification-events $K exec deploy/hermes-agent-gateway -n "$ns" -- python3 -c 'import sqlite3,os; p="/data/verification_evidence.db"; print("db-missing" if not os.path.exists(p) else sqlite3.connect(p).execute("select count(*), min(rowid), max(rowid) from verification_events").fetchone())'
  show_redacted claim-gate-verdicts sh -c "$K logs deploy/hermes-agent-gateway -n $ns --all-containers --tail=5000 2>&1 | grep -ciE 'UNVERIFIED|claim_gate' || echo 0"
  show_redacted telegram-lifecycle sh -c "$K logs deploy/hermes-agent-gateway -n $ns --all-containers --tail=2000 2>&1 | grep -iE 'telegram|getupdates|conflict|409|unauthoriz|401|polling|sink|allowed_user' | tail -40"
  show_redacted gateway-log sh -c "$K logs deploy/hermes-agent-gateway -n $ns --all-containers --tail=80 --prefix 2>&1"
  show_redacted gateway-log-previous sh -c "$K logs deploy/hermes-agent-gateway -n $ns --all-containers --tail=40 --previous 2>&1 || echo 'no previous container (it has not restarted)'"
}

# otto-parity: crew#561, the from-scratch proof product will demand. Read-only. Each step is a
# parity item from crew#561, graded from inside the running pod, never from a file on a laptop:
# the gateway is up and not restarting, mac-run reaches the founder's Mac and runs a command
# there, the memory service answers, the model lane is the estate router, and the cron lanes
# are installed. A red step is the finding.
pb_otto_parity() {
  local ns=hermes-agent d=deploy/hermes-agent-gateway
  step gateway-ready $K rollout status "$d" -n "$ns" --timeout=60s
  step no-restart-loop sh -c "r=\$($K get pods -n $ns -l app=hermes-agent-gateway -o jsonpath='{.items[0].status.containerStatuses[?(@.name==\"gateway\")].restartCount}'); echo restarts=\$r; [ \"\${r:-0}\" -lt 5 ]"
  # Founder, 2026-08-30 04:34Z: "ok key-mounted went green on a key that could not be used". The row
  # asserts what mac-run needs: the runtime uid reads the mounted key and makes a private copy of it.
  step key-usable $K exec "$d" -n "$ns" -c gateway -- sh -c 'k=/run/secrets/hermes-agent-mac-run/id_ed25519; test -r "$k" || { echo "key unreadable by $(id -u)"; exit 1; }; ls -ln "$k"; echo key-usable'
  # ssh uses the mounted file directly (no copy): decided from run 33294804159, graded here since.
  # The proxy is read from the pod's own mac-run (the sidecar's SOCKS door), never typed here (LAW 46).
  step key-direct $K exec "$d" -n "$ns" -c gateway -- sh -c 'k=/run/secrets/hermes-agent-mac-run/id_ed25519; ls -ln "$k"; proxy=$(grep -o "nc -x [^ ]* %h %p" "$(command -v mac-run)" | head -1); ssh -i "$k" -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="${HERMES_HOME:-/data}/known_hosts" -o ConnectTimeout=5 -o ProxyCommand="$proxy" "$FOUNDER_MAC_USER@$FOUNDER_MAC_TS_IP" hostname 2>&1 | tail -3'
  # run 33291368505: mac-run died on "cp: cannot create regular file '/tmp/...': Permission denied"
  # and nothing here said who owned /tmp. Eyes first (LAW 28): the container's id and /tmp's owner.
  show tmp-owner $K exec "$d" -n "$ns" -c gateway -- sh -c 'id; ls -land /tmp; ls -lan /tmp | head -6'
  step tailnet-up $K exec "$d" -n "$ns" -c tailscale -- tailscale --socket=/tmp/tailscaled.sock status --json --peers=false
  step mac-run-hostname $K exec "$d" -n "$ns" -c gateway -- mac-run hostname
  # crew#561 row 4 class: the plumbing was green while Otto believed it had no GitHub. The row
  # runs the shipped doors from inside the pod: the git binary answers and gh holds a live login.
  # Two defects, both found on run 33347928190 (2026-08-31). First it ended in a pipe:
  # `gh auth status 2>&1 | tail -3` returns tail's status, so the row printed "You are not logged
  # into any GitHub hosts" and still reported rc=0 -- the silent-green class this row exists to
  # catch. Second, and why the first went unnoticed, it graded a process Otto never uses: the
  # credential is a file under HERMES_ENV_DIR (Kyverno secrets-not-from-env-vars refuses pod env,
  # crew#341) and deploy/k8s/entrypoint.sh exports it for the agent, so a bare `kubectl exec` shell
  # inherits nothing. Fixing only the pipe would have turned a false green into a false red on a pod
  # where Otto's own gh works (LAW 38). The row now exports the env dir first, exactly as
  # repo-workspace below does, and then keeps gh's own exit code.
  step git-in-pod $K exec "$d" -n "$ns" -c gateway -- sh -c 'for f in "$HERMES_ENV_DIR"/*; do n=$(basename "$f"); case "$n" in [A-Z_][A-Z0-9_]*) export "$n=$(cat "$f")";; esac; done; git --version && { s=$(gh auth status 2>&1); rc=$?; printf "%s\n" "$s" | tail -3; exit $rc; }'
  step hindsight-answers $K exec "$d" -n "$ns" -c gateway -- python3 -c 'import os,urllib.request; u=os.environ["HINDSIGHT_API_URL"]; print(u, urllib.request.urlopen(u+"/health", timeout=5).status)'
  step cron-lanes-installed sh -c "$K exec $d -n $ns -c gateway -- python3 -c 'import json; j=json.load(open(\"/data/cron/jobs.json\")); n=len(j.get(\"jobs\", j) if isinstance(j, dict) else j); print(\"jobs=%d\" % n); raise SystemExit(0 if n else 1)'"
  # crew#561 CP5 as a row, not a listing: the primary lane is the estate router, read from the
  # pod's own rendered config, and no vendor key decides a turn.
  step model-lane-is-router $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "import yaml; c=yaml.safe_load(open(\"/data/config.yaml\")); m=c[\"model\"]; u=m[\"base_url\"]; assert m[\"provider\"]==\"custom\" and u.endswith(\"/v1\") and \"llm.\" in u, m; print(\"primary\", u)"'
  # crew#561 CP1: repos as a workspace on the pod's own volume, cloned with the pod's own token.
  # The push is a dry run: it proves the credential writes without leaving a branch behind.
  step repo-workspace $K exec "$d" -n "$ns" -c gateway -- sh -c 'for f in /run/secrets/hermes-agent-env/*; do n=$(basename "$f"); case "$n" in [A-Z_][A-Z0-9_]*) export "$n=$(cat "$f")";; esac; done; test -n "${GITHUB_TOKEN:-}" || { echo "no GITHUB_TOKEN in the env dir"; exit 1; }; rm -rf /data/workspace/idp; git clone -q --depth 1 "https://x-access-token:${GITHUB_TOKEN}@github.com/chidionyema/idp" /data/workspace/idp && cd /data/workspace/idp && git checkout -q -b otto/parity-probe && git push -q --dry-run origin otto/parity-probe && echo "clone, branch and push (dry run) ok from $(git rev-parse --short HEAD)"'
  # crew#561 CP2: the ServiceAccount reads its own namespace and nothing else. Both halves are
  # graded: a yes inside the namespace and a no outside it (a role that reads everything is red).
  step sa-reads-own-namespace $K auth can-i list pods -n "$ns" --as="system:serviceaccount:$ns:hermes-agent"
  # crew#736 (founder 2026-08-31 09:41Z, "eradicate agent trust"): this row was red on all 17 runs
  # since idp#1013 and printed NOTHING, so a broken command and a real leak read the same. Every
  # branch now prints the answer: no = ok, yes = the leak, anything else = the check is blind.
  step sa-blind-elsewhere sh -c "a=\$($K auth can-i list secrets -n kube-system --as=system:serviceaccount:$ns:hermes-agent 2>&1 | tr -d '\r' | head -1); echo \"kube-system secrets: \${a:-<no answer>}\"; case \"\$a\" in no*) exit 0;; yes*) echo 'LEAK: the account reads kube-system secrets'; exit 1;; *) echo 'BLIND: the check got no yes/no'; exit 1;; esac"
  # crew#736: which bindings, anywhere in the cluster, name Otto's account. rbac.yaml on main binds
  # it once, in its own namespace; anything else is drift the lockdown playbook deletes.
  step bindings-outside-namespace sh -c "$K get rolebindings,clusterrolebindings -A -o json 2>&1 | python3 -c '
import json, sys
d = json.load(sys.stdin)
bad = []
for b in d.get(\"items\", []):
    ns = b[\"metadata\"].get(\"namespace\", \"\")
    for sub in b.get(\"subjects\") or []:
        if sub.get(\"kind\") == \"ServiceAccount\" and sub.get(\"name\") == \"hermes-agent\" and sub.get(\"namespace\") == \"$ns\":
            if b[\"kind\"] == \"ClusterRoleBinding\" or ns != \"$ns\":
                bad.append(\"%s %s/%s -> %s/%s\" % (b[\"kind\"], ns or \"-\", b[\"metadata\"][\"name\"], b[\"roleRef\"][\"kind\"], b[\"roleRef\"][\"name\"]))
print(\"bindings outside $ns naming hermes-agent: %d\" % len(bad))
for x in bad: print(x)
sys.exit(1 if bad else 0)
'"
  # crew#561 CP3: the estate MCP answers the pod with the pod's own key, at the URL the pod's
  # config names (never typed here, LAW 46). Only the status is printed, never the key.
  # crew#717 wave 1 (founder 2026-08-30 "i need otto sorted once and for all"): memory, voice
  # and observability graded from inside the pod. toolsets-available is the inventory receipt:
  # what the runtime says is on, and the env each dark toolset still needs.
  show toolsets-available $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "
from tools.registry import registry
a = registry.get_available_toolsets()
want = (\"web\", \"browser\", \"vision\", \"image_gen\", \"tts\", \"cronjob\", \"delegation\", \"code_execution\", \"memory\", \"session_search\", \"computer_use\")
for ts in sorted(set(a) & set(want)):
    print(ts, a[ts][\"available\"], \",\".join(a[ts][\"requirements\"]) or \"-\")
"'
  step memory-survives-restart $K exec "$d" -n "$ns" -c gateway -- sh -c 'test -s /data/state.db && ls -l /data/state.db'
  step memory-volume-bound sh -c "$K get pvc -n $ns | grep Bound"
  step memory-hindsight-answers $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "
import os, urllib.request
u = os.environ[\"HINDSIGHT_API_URL\"]
err = None
for path in (\"/health\", \"/\"):
    try:
        print(path, urllib.request.urlopen(u + path, timeout=10).status)
        break
    except Exception as e:
        err = e
else:
    raise SystemExit(str(err))
"'
  step langfuse-key-mounted $K exec "$d" -n "$ns" -c gateway -- sh -c 'for f in LANGFUSE_PUBLIC_KEY LANGFUSE_SECRET_KEY; do test -s "/run/secrets/hermes-agent-env/$f" || exit 1; printf "%s bytes=%s\n" "$f" "$(wc -c < /run/secrets/hermes-agent-env/$f)"; done'
  step otto-emits-traces $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "
import base64, json, os, urllib.request
u = os.environ[\"LANGFUSE_BASE_URL\"]
pk = open(\"/run/secrets/hermes-agent-env/LANGFUSE_PUBLIC_KEY\").read().strip()
sk = open(\"/run/secrets/hermes-agent-env/LANGFUSE_SECRET_KEY\").read().strip()
tok = base64.b64encode((pk + \":\" + sk).encode()).decode()
r = urllib.request.urlopen(urllib.request.Request(u + \"/api/public/traces?limit=1\", headers={\"Authorization\": \"Basic \" + tok}), timeout=15)
d = json.loads(r.read().decode())
print(r.status, \"traces_total\", d.get(\"meta\", {}).get(\"totalItems\"))
"'
  step tts-edge-answers $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "import edge_tts; print(\"edge-tts importable\")"'
  # crew#561, founder 2026-08-30 "Otto need to be mandated also else may forget": the entrypoint reads
  # estate state at boot and logs READ or BLIND; a boot with neither line is a boot that forgot.
  step estate-state-read-at-start sh -c "l=\$($K logs $d -n $ns -c gateway 2>&1 | grep -m1 '^estate-state: '); echo \"\${l:-no 'estate-state:' line in the gateway log: the boot never read the estate state (hermes-v2 entrypoint, crew#736 CP2)}\"; case \"\$l\" in 'estate-state: READ '*) exit 0;; *) exit 1;; esac"
  step estate-mcp-answers $K exec "$d" -n "$ns" -c gateway -- sh -c 'python3 -c "
import json, os, sys, urllib.request, yaml
c = yaml.safe_load(open(\"/data/config.yaml\"))
url = ((c or {}).get(\"mcp_servers\") or {}).get(\"estate\", {}).get(\"url\")
if not url:
    print(\"config.yaml has no mcp_servers.estate.url: the estate MCP is not configured for Otto (crew#736 CP2)\"); sys.exit(1)
key = open(\"/run/secrets/hermes-agent-env/ESTATE_MCP_KEY\").read().strip()
body = json.dumps({\"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"initialize\", \"params\": {\"protocolVersion\": \"2025-03-26\", \"capabilities\": {}, \"clientInfo\": {\"name\": \"otto-parity\", \"version\": \"0\"}}}).encode()
r = urllib.request.urlopen(urllib.request.Request(url, body, {\"Authorization\": \"Bearer \" + key, \"Content-Type\": \"application/json\", \"Accept\": \"application/json, text/event-stream\"}), timeout=15)
print(url, r.status, \"session\" if r.headers.get(\"Mcp-Session-Id\") else \"no-session\")
"'
}

# otto-lockdown: crew#736 step 1 (founder 2026-08-31 09:20Z: "Revoke that ClusterRoleBinding
# immediately ... scale Otto to 0 replicas until the foundational runtime is actually stable").
# Deletes every binding outside hermes-agent that names Otto's account (drift: rbac.yaml on main
# never binds it elsewhere), suspends the Flux row that owns platform/hermes-agent so the next
# reconcile does not undo the scale, and scales the gateway to zero. Reversible: `flux resume` and
# the feature flag PR bring it back. Not read-only.
pb_otto_lockdown() {
  local ns=hermes-agent
  show bindings-before sh -c "$K get rolebindings,clusterrolebindings -A -o json 2>&1 | python3 -c '
import json, sys
for b in json.load(sys.stdin).get(\"items\", []):
    ns = b[\"metadata\"].get(\"namespace\", \"\")
    if any(s.get(\"kind\") == \"ServiceAccount\" and s.get(\"name\") == \"hermes-agent\" and s.get(\"namespace\") == \"$ns\" for s in b.get(\"subjects\") or []):
        print(b[\"kind\"], ns or \"-\", b[\"metadata\"][\"name\"], \"drift\" if (b[\"kind\"] == \"ClusterRoleBinding\" or ns != \"$ns\") else \"own-namespace\")
'"
  local kind bns name tag
  while read -r kind bns name tag; do
    [ "$tag" = drift ] || continue
    if [ "$kind" = ClusterRoleBinding ]; then step "delete-$name" $K delete clusterrolebinding "$name"
    else step "delete-$bns-$name" $K delete rolebinding "$name" -n "$bns"; fi
  done < <($K get rolebindings,clusterrolebindings -A -o json 2>/dev/null | python3 -c '
import json, sys
for b in json.load(sys.stdin).get("items", []):
    ns = b["metadata"].get("namespace", "")
    if any(s.get("kind") == "ServiceAccount" and s.get("name") == "hermes-agent" and s.get("namespace") == "hermes-agent" for s in b.get("subjects") or []):
        print(b["kind"], ns or "-", b["metadata"]["name"], "drift" if (b["kind"] == "ClusterRoleBinding" or ns != "hermes-agent") else "own-namespace")
')
  local row; row=$(flux get kustomizations -n flux-system 2>/dev/null | awk '$1=="hermes-agent"{print $1}')
  if [ -n "$row" ]; then step suspend-flux-row flux suspend kustomization "$row" -n flux-system
  else echo "n/a   suspend-flux-row       no Flux Kustomization named hermes-agent; the scale holds until its owner row reconciles"; fi
  step scale-to-zero $K scale deploy/hermes-agent-gateway -n "$ns" --replicas=0
  step gateway-gone sh -c "$K wait pod -n $ns -l app=hermes-agent-gateway --for=delete --timeout=120s 2>&1 || true; n=\$($K get pods -n $ns -l app=hermes-agent-gateway --no-headers 2>/dev/null | wc -l | tr -d ' '); echo pods=\$n; [ \"\$n\" = 0 ]"
  show bindings-after sh -c "$K get rolebindings,clusterrolebindings -A -o json 2>&1 | python3 -c '
import json, sys
n = sum(1 for b in json.load(sys.stdin).get(\"items\", []) if any(s.get(\"name\") == \"hermes-agent\" and s.get(\"namespace\") == \"$ns\" for s in b.get(\"subjects\") or []) and (b[\"kind\"] == \"ClusterRoleBinding\" or b[\"metadata\"].get(\"namespace\") != \"$ns\"))
print(\"bindings outside $ns naming hermes-agent:\", n)
'"
}

# otto-restore: the undo of otto-lockdown (LAW 16, crew#736). Resumes the Flux row so the
# deployment's own replica count (gateway.yaml) comes back, then waits for the gateway to answer.
pb_otto_restore() {
  local ns=hermes-agent
  local row; row=$(flux get kustomizations -n flux-system 2>/dev/null | awk '$1=="hermes-agent"{print $1}')
  if [ -n "$row" ]; then
    step resume-flux-row flux resume kustomization "$row" -n flux-system --timeout=3m
    step reconcile-row flux reconcile kustomization "$row" -n flux-system --timeout=3m
  else
    echo "n/a   resume-flux-row        no Flux Kustomization named hermes-agent; scaling by hand"
    step scale-to-one $K scale deploy/hermes-agent-gateway -n "$ns" --replicas=1
  fi
  step gateway-back sh -c "$K rollout status deploy/hermes-agent-gateway -n $ns --timeout=180s 2>&1 | tail -1"
  show gateway-after $K get deploy/hermes-agent-gateway -n "$ns"
}

# healthchecks-door: crew#684, 2026-08-30 07:0xZ. Read-only. idp#957 (Host header) and idp#962 (enrol
# sets the read-only key on pod start) both rolled and the Ops tile still read "Healthchecks
# answered 401" (login drill 33298467426). Every layer between the portal and Healthchecks is
# graded here from inside the two pods, never from a manifest: the key each side holds (hashes,
# never values), that they are the same key, that enrol ran, and that the key opens the door
# with the exact headers the portal proxy sends. A red row is the finding.
pb_healthchecks_door() {
  local hns=healthchecks hd=deploy/healthchecks pns=backstage pd=deploy/catalogue
  local pk=/run/secrets/healthchecks-ro/HC_API_KEY_RO hk=/run/secrets/healthchecks/RO_KEY
  step portal-key-mounted $K exec "$pd" -n "$pns" -- sh -c "test -s $pk && printf 'bytes=%s sha=%s\n' \"\$(wc -c < $pk)\" \"\$(sha256sum < $pk | cut -c1-12)\""
  step hc-key-mounted $K exec "$hd" -n "$hns" -c healthchecks -- sh -c "test -s $hk && printf 'bytes=%s sha=%s\n' \"\$(wc -c < $hk)\" \"\$(sha256sum < $hk | cut -c1-12)\""
  step keys-agree sh -c "a=\$($K exec $pd -n $pns -- sh -c 'sha256sum < $pk' | cut -c1-12); b=\$($K exec $hd -n $hns -c healthchecks -- sh -c 'sha256sum < $hk' | cut -c1-12); echo portal=\$a healthchecks=\$b; [ \"\$a\" = \"\$b\" ]"
  show_redacted enrol-log sh -c "$K logs $hd -n $hns -c migrate-and-enrol --tail=5"
  # The DB row, not the file: the key enrol saved is the one the API authorises against.
  # The container exports its secret files itself (the policy secrets-not-from-env-vars); so does this row.
  step key-enrolled $K exec "$hd" -n "$hns" -c healthchecks -- sh -c "for f in /run/secrets/healthchecks/*; do export \"\$(basename \"\$f\")=\$(cat \"\$f\")\"; done; cd /opt/healthchecks && python manage.py shell -c \"from hc.accounts.models import Project; k=open('$hk').read(); ps=list(Project.objects.all()); print('projects', [(p.name, len(p.api_key_readonly or ''), p.api_key_readonly == k) for p in ps]); raise SystemExit(0 if any(p.api_key_readonly == k for p in ps) else 1)\""
  # Django's own answer to the key, from inside the Healthchecks pod: no proxy, no network in the path.
  step door-opens-locally $K exec "$hd" -n "$hns" -c healthchecks -- sh -c "python -c \"import os,urllib.request as u; k=open('$hk').read(); r=u.Request('http://127.0.0.1:8000/api/v3/checks/', headers={'X-Api-Key': k, 'Host': os.environ['ALLOWED_HOSTS'].split(',')[0]}); print(u.urlopen(r, timeout=10).status)\""
  # Exactly the request the portal proxy makes (backstage/app-config.container.yaml: X-Api-Key from
  # the mounted file, Host = ALLOWED_HOSTS), sent from the portal pod with the portal's own key.
  step door-opens $K exec "$pd" -n "$pns" -- node -e "const fs=require('fs'),http=require('http');const key=fs.readFileSync('$pk','utf8');const host=process.env.HEALTHCHECKS_HOST;const r=http.request({host:'healthchecks.healthchecks.svc',port:8000,path:'/api/v3/checks/',headers:{'X-Api-Key':key,'Host':host}},res=>{let t='';res.on('data',d=>t+=d);res.on('end',()=>{console.log('status',res.statusCode,'host',host,'key_len',key.length,'key_ends_with_newline',key.endsWith('\\n'));console.log(t.slice(0,120));process.exit(res.statusCode===200?0:1)})});r.on('error',e=>{console.log(String(e));process.exit(1)});r.end()"
}

# catalogue-roll: crew#412, 2026-08-28: idp#564 (c6e6026) pinned the right portal image at 11:00Z
# and the serving ReplicaSet was still catalogue-8647bbdc59 seventy minutes later (login-drill
# 33168523304 red, "0 founder-surface entities"). The estate had a playbook to retry a HelmRelease
# and none to make Flux apply a Kustomization now, so the founder surface waited on the interval
# (LAW 20, LAW 31). This forces the git source and the backstage Kustomization, waits on the
# rollout, and prints the image the Deployment serves -- the run itself answers "is the portal on
# main now", instead of the next oke-check happening to notice.
pb_catalogue_roll() {
  step flux-source flux reconcile source git flux-system -n flux-system --timeout=3m
  step backstage flux reconcile kustomization backstage -n flux-system --with-source --timeout=5m
  show image $K get deploy catalogue -n backstage -o jsonpath='{.spec.template.spec.containers[0].image}{"\n"}'
  # crew#684, 2026-08-30 04:19Z: the login drill read 502 on /api/catalog/entities during a roll,
  # and the body was the edge's own "Starting up" page (platform/edge/status-page.yaml), which
  # Traefik serves when no backend answered. The only record left afterwards was the startup-probe
  # warnings every catalogue pod prints while it warms up, which is noise on every roll and not a
  # cause. Whether the Service ever had zero ready endpoints during the roll was never measured, so
  # the roll measures it: once a second, the ready addresses on the catalogue EndpointSlice, and a
  # red row naming every second the door had nothing behind it (maxUnavailable 1 / maxSurge 0 in
  # the overlay promises one replica serves throughout; this is the row that proves the promise).
  local door_watch door_pid door_empty door_total
  door_watch=$(mktemp)
  ( while :; do
      printf '%s %s\n' "$(date -u +%H:%M:%S)" "$($K get endpointslice -n backstage -l kubernetes.io/service-name=catalogue -o jsonpath='{range .items[*].endpoints[?(@.conditions.ready==true)]}{.addresses[0]} {end}' 2>/dev/null)"
      sleep 1
    done ) > "$door_watch" &
  door_pid=$!
  step rollout $K rollout status deploy/catalogue -n backstage --timeout=10m
  kill "$door_pid" 2>/dev/null || true
  wait "$door_pid" 2>/dev/null || true
  door_empty=$(awk 'NF<2' "$door_watch" | wc -l | tr -d ' ')
  door_total=$(wc -l < "$door_watch" | tr -d ' ')
  if [ "$door_empty" -eq 0 ]; then
    step door-backed echo "door-backed: a ready catalogue endpoint in every one of $door_total samples"
  else
    step door-backed sh -c "echo 'door unbacked for $door_empty of $door_total samples:'; awk 'NF<2' '$door_watch'; exit 1"
  fi
  rm -f "$door_watch"
  show replicasets $K get rs -n backstage
  show roll-events $K get events -n backstage --sort-by=.lastTimestamp
  show pods $K get pods -n backstage -o wide
  # login-drill 33170826547 (12:24Z, after the roll to main-1747): five of the six locations that
  # app-config.container.yaml declares are registered and /estate/founder/catalog-info.yaml is not.
  # Two different faults print the same count: the projected ConfigMap never reached the mount, or
  # the catalogue read it and refused it. The mount listing and the catalogue's own words about
  # that location are the only two lines that tell them apart, so the roll prints both.
  show founder-mount $K exec deploy/catalogue -n backstage -- ls -la /estate /estate/founder
  show_redacted founder-location sh -c "$K logs deploy/catalogue -n backstage --tail=4000 2>&1 | grep -iE 'founder|/estate/|location' | tail -40"
}

# 2026-08-29 01:05Z (founder ruling the same night, idp#686): idp#648 moved the portal's
# namespace.yaml between two Flux rows; the old row pruned Namespace/backstage, the delete hung in
# Terminating on leftover finalizers, the new row waited on it, and the front door answered 404
# for the hour it took to find out. This playbook is the repair for a namespace stuck in
# Terminating: print the namespace's own conditions (which name what holds it), list every
# object still inside it, clear the finalizers on those objects -- never on the namespace itself,
# never a delete -- and then ask Flux to reconcile the row that recreates it. When the condition
# is NamespaceDeletionDiscoveryFailure the block is a dead APIService, not an object; that is
# printed and left, because deleting an APIService is a different decision.
# crew#625 CP2. The pull secret every ghcr namespace mirrors is the Kubernetes Secret
# backstage/ghcr-pull (platform/image-automation/pull-secret.yaml: ClusterSecretStore ghcr-pull,
# kubernetes provider, remoteNamespace backstage). bin/idp-flux-bootstrap:55 writes it from a
# laptop into flux-system, backstage, prospector and edge; Flux never owns it. On 2026-08-29 the
# backstage namespace was pruned and recreated (idp#648, run 33226089358) and the Secret went with
# it: ExternalSecret temporal/ghcr-pull and mcp/ghcr-pull read `could not get secret data from
# provider` (diagnose 33253645144) and the temporal chart's Job could not pull. The same bytes
# survived in the other three namespaces, so the repair copies from the first that still holds it
# and never needs the laptop. The value travels through a file, never argv or stdout (LAW 21).
pb_ghcr_pull_restore() {
  local src="" ns tmp
  for ns in flux-system prospector edge; do
    if $K get secret ghcr-pull -n "$ns" -o name >/dev/null 2>&1; then src="$ns"; break; fi
  done
  echo "--- source"; echo "${src:-none}"
  [ -n "$src" ] || { FAILED="$FAILED ghcr-pull-source"; echo "FAIL  no namespace still holds ghcr-pull; re-run bin/idp-flux-bootstrap"; return 1; }
  tmp=$(mktemp); trap 'rm -f "$tmp"' RETURN
  step "read $src" sh -c "$K get secret ghcr-pull -n $src -o jsonpath='{.data.\\.dockerconfigjson}' | base64 -d > '$tmp' && [ -s '$tmp' ]"
  step "write backstage" sh -c "$K create secret generic ghcr-pull -n backstage --type=kubernetes.io/dockerconfigjson --from-file=.dockerconfigjson='$tmp' --dry-run=client -o yaml | $K apply -f -"
  for ns in temporal mcp; do
    step "resync $ns" $K annotate externalsecret ghcr-pull -n "$ns" force-sync="$(date -u +%Y%m%dT%H%M%SZ)" --overwrite
  done
  step temporal-hr flux reconcile helmrelease temporal -n temporal --timeout=5m
  show externalsecrets sh -c "$K get externalsecret -A | grep ghcr-pull"
  show pods-temporal $K get pods -n temporal -o wide
}

pb_namespace_unstick() {
  local stuck ns
  stuck=$($K get ns -o jsonpath='{range .items[?(@.status.phase=="Terminating")]}{.metadata.name}{"\n"}{end}')
  echo "--- namespaces-terminating"; printf '%s\n' "${stuck:-none}"
  for ns in $stuck; do
    show "conditions $ns" $K get ns "$ns" -o jsonpath='{range .status.conditions[?(@.status=="True")]}{.type}: {.message}{"\n"}{end}'
    show "remaining $ns" sh -c "$K api-resources --verbs=list --namespaced -o name | xargs -n1 -I{} $K get {} -n $ns --ignore-not-found -o name 2>/dev/null"
    local objs
    objs=$($K api-resources --verbs=list --namespaced -o name | xargs -n1 -I{} $K get {} -n "$ns" --ignore-not-found -o jsonpath='{range .items[?(@.metadata.finalizers)]}{.kind}/{.metadata.name}{"\n"}{end}' 2>/dev/null | tr 'A-Z' 'a-z')
    local o
    for o in $objs; do
      step "unfinalize $ns/$o" $K patch "$o" -n "$ns" --type=merge -p '{"metadata":{"finalizers":null}}'
    done
    step "gone $ns" $K wait ns "$ns" --for=delete --timeout=3m
  done
  step flux-source flux reconcile source git flux-system -n flux-system --timeout=3m
  step backstage-namespace flux reconcile kustomization backstage-namespace -n flux-system --timeout=5m
  step backstage flux reconcile kustomization backstage -n flux-system --timeout=5m
  show namespaces $K get ns
  show pods $K get pods -n backstage -o wide
}

# webhooks-restart: run 33297528033 (crew#633, crew#661 CP1, 2026-08-30): every pod create in the
# estate was refused by `validate.kyverno.svc-fail` with an EMPTY reason (tailscale/operator since
# 2026-08-28T12:43Z, healing/estate), and kustomization/edge read `failed calling webhook
# "mutate-policy.kyverno.svc": Post "https://kyverno-svc.kyverno.svc:443/policymutate": EOF`.
# The admission controller was 1/1 Available the whole time. An empty denial is the API server
# failing to reach the webhook with failurePolicy Fail, not a policy matching; the same class as
# run 33133317589 in cilium-unchain (webhook pods left in a dead sandbox after the CNI change).
# cilium-unchain is the wrong tool now: it rewrites CNI files. This is the narrow half of it:
# restart the two webhook deployments onto fresh sandboxes, then reconcile the rows that cached
# the EOF (reconcile does not cascade, idp#525). Attribute before repair (LAW 2b): the playbook
# refuses to restart anything unless the cluster's own events show the webhook fault right now.
# Breaker (crew#678 CP2): WEBHOOKS_RESTART_MAX attempts (2) per WEBHOOKS_RESTART_COOLOFF_S (6 h),
# recorded on the kyverno admission Deployment (annotations estate.idp/webhooks-restart-attempts
# and estate.idp/webhooks-restart-last, epoch seconds); an open breaker prints BREAKER OPEN with
# the reset command and fails the playbook. Reset:
#   kubectl annotate deploy kyverno-admission-controller -n kyverno estate.idp/webhooks-restart-attempts-
pb_webhooks_restart() {
  local events fault
  events=$($K get events -A -o jsonpath='{range .items[*]}{.lastTimestamp}{" "}{.involvedObject.namespace}{"/"}{.involvedObject.name}{" "}{.message}{"\n"}{end}' 2>/dev/null)
  fault=$(printf '%s\n' "$events" | grep -E 'failed calling webhook|admission webhook "[a-z-]+\.kyverno\.svc(-fail)?" denied the request: *$' | tail -8)
  echo "--- webhook-fault"; printf '%s\n' "${fault:-none}"
  if [ -z "$fault" ]; then
    echo "no webhook fault in the cluster's events (no 'failed calling webhook', no empty kyverno denial); nothing to restart"
    step "no-fault-measured" sh -c "exit 1"; return 1
  fi
  local max_attempts="${WEBHOOKS_RESTART_MAX:-2}" cooloff="${WEBHOOKS_RESTART_COOLOFF_S:-21600}" now attempts last
  now=$(date -u +%s)
  attempts=$($K get deploy kyverno-admission-controller -n kyverno -o jsonpath='{.metadata.annotations.estate\.idp/webhooks-restart-attempts}' 2>/dev/null); attempts="${attempts:-0}"
  last=$($K get deploy kyverno-admission-controller -n kyverno -o jsonpath='{.metadata.annotations.estate\.idp/webhooks-restart-last}' 2>/dev/null); last="${last:-0}"
  case "$attempts" in '' | *[!0-9]*) attempts=0 ;; esac
  case "$last" in '' | *[!0-9]*) last=0 ;; esac
  if [ $((now - last)) -ge "$cooloff" ]; then attempts=0; fi
  if [ "$attempts" -ge "$max_attempts" ]; then
    echo "BREAKER OPEN webhooks-restart kyverno/kyverno-admission-controller: $attempts attempts since $(date -u -d "@$last" +%FT%TZ 2>/dev/null || date -u -r "$last" +%FT%TZ); reset: kubectl annotate deploy kyverno-admission-controller -n kyverno estate.idp/webhooks-restart-attempts-"
    step "breaker-open-webhooks-restart" sh -c "exit 1"; return 1
  fi
  $K annotate deploy kyverno-admission-controller -n kyverno --overwrite "estate.idp/webhooks-restart-attempts=$((attempts + 1))" "estate.idp/webhooks-restart-last=$now" >/dev/null 2>&1 || true
  show webhook-pods-before $K get pods -n kyverno -o wide
  step webhooks-restart $K rollout restart deploy -n external-secrets
  step kyverno-restart $K rollout restart deploy -n kyverno
  step webhooks-ready $K rollout status deploy -n external-secrets --timeout=180s
  step kyverno-ready $K rollout status deploy -n kyverno --timeout=180s
  show webhook-pods-after $K get pods -n kyverno -o wide
  # The rows that cached the EOF, in dependency order: the policies, the secret store and its
  # ~35 dependents, the private network, the remote-hands door that waits on it.
  local k
  for k in edge secret-store tailscale guacamole; do
    step "reconcile-$k" flux reconcile kustomization "$k" -n flux-system --timeout=5m </dev/null
  done
  show admission-denials-after sh -c "$K get events -A --field-selector reason=FailedCreate -o jsonpath='{range .items[*]}{.lastTimestamp}{\" \"}{.involvedObject.namespace}{\"/\"}{.involvedObject.name}{\": \"}{.message}{\"\\n\"}{end}' | tail -8"
  show kustomizations $K get kustomizations -A
}

pb_helm_retry() {
  local failed
  failed=$($K get helmreleases -A -o jsonpath='{range .items[*]}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{" "}{.metadata.namespace}{" "}{.metadata.name}{"\n"}{end}' 2>/dev/null | awk '$1=="False"{print $2" "$3}')
  echo "--- helmreleases-failed"; printf '%s\n' "${failed:-none}"
  # run 33259031857 (crew#626 CP15): langfuse-redis-d5f84c9dc-kxdth sat Init:0/1 for 8 h with no pod
  # IP and PodReadyToStartContainers=False; the kubelet never retried the sandbox and every
  # reconcile --reset stalled on the same Deployment. A pod whose sandbox has not started after
  # 30 min is recreated by its owner: delete it, and the retry below has something new to watch.
  local stuck
  stuck=$($K get pods -A -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{" "}{.metadata.creationTimestamp}{" "}{range .status.conditions[?(@.type=="PodReadyToStartContainers")]}{.status}{end}{"\n"}{end}' 2>/dev/null \
    | awk -v cutoff="$(date -u -d '30 minutes ago' +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -v-30M +%Y-%m-%dT%H:%M:%SZ)" '$4=="False" && $3<cutoff {print $1" "$2}')
  echo "--- pods-sandbox-never-started"; printf '%s\n' "${stuck:-none}"
  local pns pname
  while read -r pns pname; do
    [ -n "$pname" ] || continue
    step "recreate-$pname" $K delete pod "$pname" -n "$pns" --wait=false
  done <<<"$stuck"
  # crew#678 CP2 (founder 2026-08-30: self-healing needs a circuit breaker). Each HelmRelease
  # gets HELM_RETRY_MAX attempts (3) inside one HELM_RETRY_COOLOFF_S window (6 h); the count and
  # the last attempt live on the object itself (annotations estate.idp/helm-retry-attempts and
  # estate.idp/helm-retry-last, epoch seconds) so the Mac and the workflow read one record. An
  # open breaker is printed as BREAKER OPEN with the reset command and fails the playbook, so a
  # release nobody can retry is loud, never a quiet skip. Reset:
  #   kubectl annotate helmrelease <name> -n <ns> estate.idp/helm-retry-attempts-
  local max_attempts="${HELM_RETRY_MAX:-3}" cooloff="${HELM_RETRY_COOLOFF_S:-21600}" now open=0
  now=$(date -u +%s)
  local ns name attempts last
  while read -r ns name; do
    [ -n "$name" ] || continue
    attempts=$($K get helmrelease "$name" -n "$ns" -o jsonpath='{.metadata.annotations.estate\.idp/helm-retry-attempts}' 2>/dev/null); attempts="${attempts:-0}"
    last=$($K get helmrelease "$name" -n "$ns" -o jsonpath='{.metadata.annotations.estate\.idp/helm-retry-last}' 2>/dev/null); last="${last:-0}"
    # A hand-edited or missing annotation is a fresh breaker, never an arithmetic crash (set -u).
    case "$attempts" in '' | *[!0-9]*) attempts=0 ;; esac
    case "$last" in '' | *[!0-9]*) last=0 ;; esac
    if [ $((now - last)) -ge "$cooloff" ]; then attempts=0; fi
    if [ "$attempts" -ge "$max_attempts" ]; then
      echo "BREAKER OPEN helm-retry $ns/$name: $attempts attempts since $(date -u -d "@$last" +%FT%TZ 2>/dev/null || date -u -r "$last" +%FT%TZ); reset: kubectl annotate helmrelease $name -n $ns estate.idp/helm-retry-attempts-"
      open=$((open + 1)); continue
    fi
    $K annotate helmrelease "$name" -n "$ns" --overwrite "estate.idp/helm-retry-attempts=$((attempts + 1))" "estate.idp/helm-retry-last=$now" >/dev/null 2>&1 || true
    step "retry-$name" flux reconcile helmrelease "$name" -n "$ns" --reset --timeout=15m </dev/null
  done <<<"$failed"
  [ "$open" -eq 0 ] || step "breaker-open-$open-releases" sh -c "exit 1"
  show helmreleases $K get helmreleases -A --no-headers
  step observability flux reconcile kustomization observability -n flux-system --timeout=5m
  show kustomizations $K get kustomizations -A
}

# k8sgpt-analyze: print every K8sGPT finding (cause + fix in plain English) and force a fresh
# scan by restarting the analyzer so the results are minutes old, not hours.
pb_k8sgpt_analyze() {
  # run 33233870612 (crew#503): rescan printed "No resources found in healing namespace" and the
  # playbook still PASSED. The operator (k8sgpt-operator-controller-manager 1/1) had never turned
  # the K8sGPT object into an analyzer deployment, and nothing here said why. Eyes first: the
  # object's status, the secret it names, and the operator's own log; then the restart is refused
  # when there is nothing to restart, so an absent analyzer is a FAIL, not a silent green.
  show k8sgpt-object sh -c "$K get k8sgpt.core.k8sgpt.ai -n healing -o wide; $K get k8sgpt.core.k8sgpt.ai -n healing -o jsonpath='{range .items[*]}{.metadata.name}{\" status=\"}{.status}{\"\n\"}{end}'"
  show k8sgpt-secret sh -c "$K get externalsecret,secret -n healing 2>&1 | grep -iE 'NAME|k8sgpt'; $K get externalsecret -n healing -o jsonpath='{range .items[*]}{.metadata.name}{\" \"}{range .status.conditions[*]}{.type}={.status} {.message}{end}{\"\n\"}{end}'"
  show k8sgpt-deployments $K get deploy,pods -n healing -o wide
  # Manager container only: the kube-rbac-proxy sidecar logs a 'TLS handshake error' every 10s and the
  # old 'error' grep drowned the reconciler in it (run 33235032630: 30 lines of proxy noise, status empty).
  show k8sgpt-operator-log sh -c "$K logs -n healing deploy/k8sgpt-operator-controller-manager -c manager --tail=200 2>&1 | grep -viE 'TLS handshake' | tail -40"
  show k8sgpt-describe sh -c "$K describe k8sgpt estate -n healing 2>&1 | tail -40"
  show healing-events sh -c "$K get events -n healing --sort-by=.lastTimestamp 2>&1 | tail -20"
  # Run 33239797940: the table view cut Kyverno's denial to "denied the request: ..." and the policy
  # name lived in the lines kubectl dropped. Print every FailedCreate message whole.
  show healing-denials sh -c "$K get events -n healing --field-selector reason=FailedCreate -o jsonpath='{range .items[*]}{.lastTimestamp} {.involvedObject.kind}/{.involvedObject.name}: {.message}{\"\\n\"}{end}' 2>/dev/null | tail -c 4000; true"
  # The operator names the analyzer Deployment after the K8sGPT object and labels it app=<name>
  # (k8sgpt-operator pkg/resources/k8sgpt.go: Name: config.Name, MatchLabels app: config.Name).
  # The old selector app.kubernetes.io/name=k8sgpt matched nothing by construction.
  # run 33237896443 (dispatched 18s after idp#725 merged) and 33238265861 both graded the object Flux had
  # not applied yet (`No Cache: false` on the cluster, true on main). Name that instead of a false FAIL.
  applied=$($K get kustomization healing-analyzer -n flux-system -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null || true)
  if [ -n "${GITHUB_SHA:-}" ] && [ -n "$applied" ] && [ "${applied##*:}" != "$GITHUB_SHA" ]; then
    echo "BLIND k8sgpt-analyze  Flux has not applied this commit yet: healing-analyzer is at ${applied##*:}, this run is $GITHUB_SHA; re-run after the next reconcile"
    return 0
  fi
  # runs 33237896443 and 33238265861 graded the object Flux had not applied yet (`No Cache: false` on
  # the cluster, true on main) and printed a false FAIL. Name the stale revision instead.
  applied=$($K get kustomization healing-analyzer -n flux-system -o jsonpath='{.status.lastAppliedRevision}' 2>/dev/null || true)
  if [ -n "${GITHUB_SHA:-}" ] && [ -n "$applied" ] && [ "${applied##*:}" != "$GITHUB_SHA" ]; then
    echo "BLIND k8sgpt-analyze  Flux has not applied this commit yet: healing-analyzer is at ${applied##*:}, this run is $GITHUB_SHA; re-run after the next reconcile"
    return 0
  fi
  if [ -z "$($K get deployment -n healing -l app=estate -o name 2>/dev/null)" ]; then
    echo "FAIL  k8sgpt-analyze  no analyzer deployment in healing: the operator has not reconciled the K8sGPT object (see k8sgpt-operator-log above)"
    FAILED="$FAILED k8sgpt-analyzer-absent"
    return 0
  fi
  step rescan $K rollout restart deployment -n healing -l app=estate
  step rescan-ready $K rollout status deployment -n healing -l app=estate --timeout=3m
  show k8sgpt-results sh -c "$K get results.core.k8sgpt.ai -A -o jsonpath='{range .items[*]}{.spec.kind}/{.metadata.namespace}/{.spec.name}{\"\n\"}{range .spec.error[*]}{\"  error: \"}{.text}{\"\n\"}{end}{\"  \"}{.spec.details}{\"\n\n\"}{end}'"
}

# node-drain: run 33144789785 + diagnose 33144117286 (crew#539 5448912676): every crashing
# observability pod (clickhouse, langfuse-web, langfuse-worker) sat on the 6h-old spot replacement
# 10.0.148.221, each timing out to a Service whose backend was on that same node, while the
# replica on the other node and every cross-node probe answered. A node whose same-node ClusterIP
# path drops packets is retired the way Kubernetes retires a node: cordon, drain, and let the
# cluster-autoscaler remove the empty node and add a fresh one. The target is not typed: it is the
# Ready node carrying the most pods that are not Running/Succeeded, and the placement before and
# after is the receipt. Undo: node-uncordon.
sick_pods() {
  # "<node> <ns>/<pod> <phase> <ready…>" for every Pending pod and every Running pod with any
  # container not ready. Succeeded and Failed are finished pods (Jobs); idp#540 review: 21 Failed
  # descheduler pods on the healthy node would have out-voted the three crashers
  $K get pods -A -o jsonpath='{range .items[*]}{.spec.nodeName}{" "}{.metadata.namespace}{"/"}{.metadata.name}{" "}{.status.phase}{" "}{range .status.containerStatuses[*]}{.ready}{" "}{end}{"\n"}{end}' 2>/dev/null \
    | awk '$1!="" && $3!="Succeeded" && $3!="Failed" { sick=($3!="Running"); for(i=4;i<=NF;i++) if($i=="false") sick=1; if(sick) print }'
}
ready_nodes() { $K get nodes -o jsonpath='{range .items[*]}{.metadata.name}{" "}{range .status.conditions[?(@.type=="Ready")]}{.status}{end}{"\n"}{end}' 2>/dev/null | awk '$2=="True"{print $1}'; }
# the pick is among Ready nodes only: a NotReady node is the cloud layer's to replace, and draining
# it would only evict pods the scheduler has already given up on
pick_sick_node() { sick_pods | awk -v r="$(ready_nodes | tr '\n' ' ')" 'BEGIN{split(r,a," "); for(i in a) ok[a[i]]=1} ok[$1]{n[$1]++} END{for(k in n) print n[k], k}' | sort -rn | head -1 | awk '{print $2}'; }
# drain_preflight <node>: prints "ok preflight ..." and returns 0, or prints the FAIL lines and
# returns 1. Two refusals: a PodDisruptionBudget with disruptionsAllowed 0 that covers a pod on the
# node (kubectl drain would wait on it until its timeout), and the pods leaving the node asking for
# more cpu or memory than the other Ready nodes have free (they would leave as Pending). DaemonSet
# pods stay on the node and count for neither; mirror pods likewise.
DRAIN_PREFLIGHT_PY=$(cat <<'PYEOF'
import json, re, sys
node = sys.argv[1]
pods_j, pdb_j, nodes_j = sys.stdin.read().split("@@SEP@@\n")
def load(t):
    try: return json.loads(t).get("items", [])
    except Exception: return []
pods, pdbs, nodes = load(pods_j), load(pdb_j), load(nodes_j)
def qty(v, kind):
    if v is None: return 0.0
    v = str(v)
    m = re.fullmatch(r"([0-9.]+)([a-zA-Z]*)", v)
    if not m: return 0.0
    n, u = float(m.group(1)), m.group(2)
    if kind == "cpu": return n / 1000 if u == "m" else n
    mult = {"": 1, "Ki": 2**10, "Mi": 2**20, "Gi": 2**30, "Ti": 2**40, "k": 1e3, "M": 1e6, "G": 1e9, "T": 1e12}
    return n * mult.get(u, 1)
def stays(p):
    owners = p.get("metadata", {}).get("ownerReferences") or []
    return any(o.get("kind") == "DaemonSet" for o in owners) or "kubernetes.io/config.mirror" in (p.get("metadata", {}).get("annotations") or {})
def req(p, kind):
    return sum(qty((c.get("resources") or {}).get("requests", {}).get(kind), kind) for c in p.get("spec", {}).get("containers", []))
def phase_counts(p): return p.get("status", {}).get("phase") in ("Succeeded", "Failed")
leaving = [p for p in pods if p.get("spec", {}).get("nodeName") == node and not stays(p) and not phase_counts(p)]
fail = []
# A PDB selector this playbook cannot evaluate is a refusal, not a skip. Measured by 09cd04a6
# (idp#543 review 5449475253): a 0-disruption PDB selecting by matchExpressions read as an empty
# matchLabels dict, matched nothing, and the node was cordoned with RC 0 -- the exact silent pass
# the 06:20Z outage came through. matchLabels is the only shape proved here, so anything else in
# a namespace that has pods leaving refuses and names what it could not read.
for b in pdbs:
    st = b.get("status") or {}
    if st.get("disruptionsAllowed", 1) != 0: continue
    ns, bname = b["metadata"]["namespace"], b["metadata"]["name"]
    here = [p for p in leaving if p["metadata"]["namespace"] == ns]
    if not here: continue
    spec_sel = b.get("spec", {}).get("selector")
    sel = (spec_sel or {}).get("matchLabels") or {}
    if spec_sel is None or (spec_sel or {}).get("matchExpressions") or not sel:
        shape = "matchExpressions" if (spec_sel or {}).get("matchExpressions") else ("null selector" if spec_sel is None else "empty selector")
        fail.append(f"FAIL  node-drain: PodDisruptionBudget {ns}/{bname} allows 0 disruptions and its selector is a {shape}, which this playbook cannot evaluate; {len(here)} pod(s) leaving {node} are in {ns} and it may cover them; refusing")
        continue
    for p in here:
        if all((p["metadata"].get("labels") or {}).get(k) == v for k, v in sel.items()):
            fail.append(f"FAIL  node-drain: PodDisruptionBudget {ns}/{bname} allows 0 disruptions and covers {ns}/{p['metadata']['name']}; drain would wait on it until timeout; refusing")
need_cpu, need_mem = sum(req(p, "cpu") for p in leaving), sum(req(p, "memory") for p in leaving)
peers = []
for n in nodes:
    name = n["metadata"]["name"]
    ready = any(c.get("type") == "Ready" and c.get("status") == "True" for c in n.get("status", {}).get("conditions", []))
    if name == node or not ready or n.get("spec", {}).get("unschedulable"): continue
    alloc = n.get("status", {}).get("allocatable") or {}
    used_cpu = sum(req(p, "cpu") for p in pods if p.get("spec", {}).get("nodeName") == name and not phase_counts(p))
    used_mem = sum(req(p, "memory") for p in pods if p.get("spec", {}).get("nodeName") == name and not phase_counts(p))
    peers.append((name, max(0.0, qty(alloc.get("cpu"), "cpu") - used_cpu), max(0.0, qty(alloc.get("memory"), "memory") - used_mem)))
free_cpu, free_mem = sum(c for _, c, _ in peers), sum(m for _, _, m in peers)
gi = lambda b: f"{b/2**30:.2f}Gi"
if need_cpu > free_cpu or need_mem > free_mem:
    fail.append(f"FAIL  node-drain: {len(leaving)} pod(s) leaving {node} request cpu {need_cpu:.2f} / memory {gi(need_mem)}; the other Ready nodes have cpu {free_cpu:.2f} / memory {gi(free_mem)} free; they would leave as Pending; refusing")
# A cluster total is not a placement. Measured by 09cd04a6 (idp#543 review 5449475253): one 4Gi
# pod leaving with two peers at 3Gi free each passed the total check and drained, and the pod had
# nowhere to land. The scheduler fits a pod on ONE node, so every pod leaving must fit on one.
for p in leaving:
    pc, pm = req(p, "cpu"), req(p, "memory")
    if any(fc >= pc and fm >= pm for _, fc, fm in peers): continue
    best = ", ".join(f"{n} cpu {c:.2f} / memory {gi(m)}" for n, c, m in peers) or "none"
    fail.append(f"FAIL  node-drain: {p['metadata']['namespace']}/{p['metadata']['name']} requests cpu {pc:.2f} / memory {gi(pm)} and no single Ready node has room for it (free: {best}); the scheduler places per node, not per cluster; refusing")
    break
if fail:
    print("\n".join(fail)); sys.exit(1)
print(f"ok    preflight              {len(leaving)} pod(s) leaving need cpu {need_cpu:.2f} / memory {gi(need_mem)}, other Ready nodes have cpu {free_cpu:.2f} / memory {gi(free_mem)} free and each leaving pod fits on one of them; no PodDisruptionBudget at 0 covers them")
print("namespaces=" + ",".join(sorted({p["metadata"]["namespace"] for p in leaving})))
PYEOF
)
# alert_silence add|expire: founder 2026-08-28 06:43Z, "catalogue says no available server, lots of
# errors coming on telegram" — the 06:36Z catalogue 503 was this playbook's own cordon window
# (crew#539 5449358659). A planned drain pages the founder as if it were an outage, so the window
# is silenced in Alertmanager and the silence is expired again when the playbook ends. amtool is
# Alertmanager's own client and ships in its image (LAW 43): no alert state is hand-rolled here.
#
# THE MATCHER IS THE NAMESPACE, NOT THE NODE. Found by 09cd04a6 (idp#543 review 5449475253):
# `node=<name>` silenced nothing, because no alerting rule under platform/monitoring carries a
# node label and the telegram route groups by [alertname, namespace]
# (platform/monitoring/alertmanager-config.yaml:30). A silence can only match a label the alert
# actually has, so the window is silenced per namespace of the pods that are leaving — one
# silence each, every id expired when the playbook ends.
AM_NS="${AM_NS:-monitoring}"
AM_PORT="${AM_PORT:-9093}"   # in-pod, reached through kubectl exec; declared in catalog/ports.yaml
alert_silence() {
  local action="$1" arg="${2:-}" pod ns id ids=""
  pod=$($K get pods -n "$AM_NS" -l app.kubernetes.io/name=alertmanager -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
  [ -n "$pod" ] || { echo "no alertmanager pod in $AM_NS: not silencing"; return 0; }
  case "$action" in
    add)
      for ns in $(printf '%s' "$arg" | tr ',' ' '); do
        id=$($K exec -n "$AM_NS" "$pod" -c alertmanager -- amtool --alertmanager.url=http://localhost:$AM_PORT silence add "namespace=$ns" --duration=30m --comment="idp-oke-break-glass node-drain (crew#539)" 2>/dev/null | tail -1)
        [ -n "$id" ] && ids="${ids:+$ids }$id"
      done
      printf '%s\n' "$ids" ;;
    expire)
      for id in $arg; do
        $K exec -n "$AM_NS" "$pod" -c alertmanager -- amtool --alertmanager.url=http://localhost:$AM_PORT silence expire "$id" >/dev/null 2>&1
      done ;;
  esac
}

drain_preflight() {
  local node="$1"
  { $K get pods -A -o json 2>/dev/null; echo '@@SEP@@'; $K get pdb -A -o json 2>/dev/null; echo '@@SEP@@'; $K get nodes -o json 2>/dev/null; } \
    | python3 -c "$DRAIN_PREFLIGHT_PY" "$node"
}

pb_node_drain() {
  show nodes-before $K get nodes -o wide
  show pods-not-ready-by-node sh -c "$(declare -f sick_pods); K='$K'; sick_pods | sort"
  local node; node=$(pick_sick_node)
  [ -n "$node" ] || { echo "no pod outside Running/Succeeded on a Ready node: nothing to drain"; return 0; }
  echo "--- target $node"
  # refusing to drain the last Ready node: the workloads would have nowhere to go and the API's
  # own pods (coredns, kube-proxy are DaemonSets, but the autoscaler and flux are not) would be evicted into Pending
  local ready; ready=$(ready_nodes | wc -l | tr -d ' ')
  [ "$ready" -gt 1 ] || { echo "FAIL  node-drain: $node is the only Ready node; refusing"; FAILED="$FAILED node-drain"; return 1; }
  # run 33147195670: cordon ok, then drain timed out after 10m on the single-replica clickhouse
  # pod (its PodDisruptionBudget allows 0 disruptions) while langfuse-postgresql and the catalogue
  # sat Pending on <none>: the other node had no room. The cordon itself was the outage. Both are
  # knowable before anything is touched, so both are checked first and either refuses the drain.
  local verdict; verdict=$(drain_preflight "$node") || { printf '%s\n' "$verdict"; FAILED="$FAILED node-drain"; return 1; }
  # the preflight's last line names the namespaces the pods are leaving; that is what Alertmanager
  # can actually match on, so it is what gets silenced. It is not part of the human verdict.
  local nss; nss=$(printf '%s\n' "$verdict" | sed -n 's/^namespaces=//p')
  printf '%s\n' "$verdict" | grep -v '^namespaces='
  local silence; silence=$(alert_silence add "$nss")
  echo "--- silence ${silence:-none}"
  step cordon $K cordon "$node"
  step drain $K drain "$node" --ignore-daemonsets --delete-emptydir-data --timeout=600s
  alert_silence expire "$silence"   # the window closes with the playbook, however the drain ended
  show nodes-after $K get nodes -o wide
  show pods-after $K get pods -A -o wide --field-selector=status.phase!=Succeeded
}
pb_node_uncordon() {
  local n
  for n in $($K get nodes -o jsonpath='{range .items[?(@.spec.unschedulable==true)]}{.metadata.name}{" "}{end}'); do step "uncordon-$n" $K uncordon "$n"; done
  show nodes $K get nodes -o wide
}

# chi-resize: run 33147086133 (diagnose after idp#536): the signoz HelmRelease carries 4Gi for
# clickhouse, and "Helm upgrade failed ... pre-upgrade hooks failed: timeout waiting for
# Job/observability/signoz-telemetrystore-migrator". The migrator's init containers wait for a
# ClickHouse that is Ready; ClickHouse exits 137 at the old 2Gi every few minutes; the 4Gi that
# would let it live sits behind the hook that waits for it. Helm cannot break its own deadlock,
# so the ClickHouseInstallation is patched to the value the HelmRelease already declares (read
# from the values ConfigMap, never typed here); the Altinity operator rolls the StatefulSet, the
# pod comes up at 4Gi, the migrator finishes and the next Helm reconcile converges on the same
# value: there is nothing to undo, the patch IS the declared state.
CHI_VALUES="${CHI_VALUES:-observability/signoz-values}"   # <namespace>/<ConfigMap> holding values.yaml
chi_links() {
  $K get chi -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\tCHI podTemplate limits: "}{range .spec.templates.podTemplates[*]}{.spec.containers[0].resources.limits}{end}{"\n"}{end}' 2>&1
  $K get sts -A -l clickhouse.altinity.com/chi -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\tsts limits: "}{.spec.template.spec.containers[0].resources.limits}{"\n"}{end}' 2>&1
  $K get pods -A -l clickhouse.altinity.com/chi -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\tpod limits: "}{.spec.containers[0].resources.limits}{"\t"}{.status.phase}{"\n"}{end}' 2>&1
}
pb_chi_resize() {
  local want
  want=$($K get configmap "${CHI_VALUES#*/}" -n "${CHI_VALUES%/*}" -o jsonpath='{.data.values\.yaml}' 2>/dev/null \
    | python3 -c 'import sys,json,yaml; r=(yaml.safe_load(sys.stdin) or {}).get("clickhouse",{}).get("resources"); print(json.dumps(r,separators=(",",":")) if r else "")')
  [ -n "$want" ] || { echo "FAIL  chi-resize: no clickhouse.resources in ConfigMap $CHI_VALUES"; FAILED="$FAILED chi-resize"; return 1; }
  local want_mem
  want_mem=$(printf %s "$want" | python3 -c 'import sys,json; print(json.load(sys.stdin).get("limits",{}).get("memory",""))')
  [ -n "$want_mem" ] || { echo "FAIL  chi-resize: the declared resources carry no limits.memory"; FAILED="$FAILED chi-resize"; return 1; }
  echo "--- want $want"
  show chi-before chi_links
  local row ns name
  for row in $($K get chi -A -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{" "}{end}' 2>/dev/null); do
    ns="${row%/*}"; name="${row#*/}"
    step "patch-$name" $K patch chi "$name" -n "$ns" --type=json -p "[{\"op\":\"replace\",\"path\":\"/spec/templates/podTemplates/0/spec/containers/0/resources\",\"value\":$want}]"
    # run 33148549633: the patch landed on the CHI and `rollout status` answered "complete" in the
    # same second -- against the OLD StatefulSet, because the Altinity operator reconciles
    # CHI -> sts asynchronously. chi-after then printed 2Gi at sts and pod and the run still PASSed.
    # Wait for the operator to carry the value onto the sts spec first; only then wait for the roll.
    step "reconcile-$name" $K wait sts -n "$ns" -l "clickhouse.altinity.com/chi=$name" --for=jsonpath='{.spec.template.spec.containers[0].resources.limits.memory}'="$want_mem" --timeout=600s
    step "rollout-$name" $K rollout status sts -n "$ns" -l "clickhouse.altinity.com/chi=$name" --timeout=600s
  done
  show chi-after chi_links
}

# registries-conf: READ-ONLY. What the container runtime on each node is actually configured to do
# with an unqualified image name. Founder 2026-08-31, doc
# ~/.claude/docs/founder/2026-08-31T0243Z-one-your-nodes-are-configured-to-reject-what-5434b31f.md:
# "your nodes are configured to reject what the world ships. short-name-mode = enforcing with no
# unqualified-search-registries means every third-party chart default fails on arrival. That's not
# an incident stream, it's a setting." He is right that it is a setting and that six file edits were
# never the answer to a node-level policy. This playbook is the read that has to come before the
# write: the kubelet Event on 2026-08-31 said `returns ambiguous list`, and containers/image emits
# that text when short-name-mode is enforcing AND the search list has MORE THAN ONE entry -- it is
# the ambiguity that is refused, not the emptiness. An empty list gives different text. So the fix
# he names (set the list to exactly ["docker.io"]) and the fix the message implies are different
# edits, and which one is correct is a fact on the node, not a choice. Read it, then change it.
#
# hostPath, mounted read-only, on /etc/containers -- the file the runtime reads, not a manifest that
# claims what it says. Nothing here writes.
pb_registries_conf() {
  local node i=0
  for node in $($K get nodes -o jsonpath='{.items[*].metadata.name}'); do
    i=$((i+1))
    echo "--- node $node"
    local name="registries-read-$i"
    step "$name-clear" $K delete pod/"$name" -n kube-system --ignore-not-found --wait=true --timeout=60s
    step "$name-apply" $K apply -f - <<YAML
apiVersion: v1
kind: Pod
metadata: { name: $name, namespace: kube-system, labels: { app: registries-read } }
spec:
  restartPolicy: Never
  priorityClassName: system-cluster-critical
  tolerations: [{ operator: Exists }]
  nodeName: $node
  securityContext: { runAsNonRoot: true, runAsUser: 65534, seccompProfile: { type: RuntimeDefault } }
  volumes:
    - name: etc-containers
      hostPath: { path: /etc/containers, type: Directory }
  containers:
    - name: read
      image: public.ecr.aws/docker/library/busybox:1.36
      # No shell variable in this string: it sits inside an unquoted heredoc, so the OUTER shell
      # would expand anything with a $ before the pod ever saw it. `grep -r . dir/` prints
      # file:line and needs no loop variable. shellcheck SC2154 caught exactly that.
      command: ["sh", "-c", "echo '== registries.conf'; cat /host/registries.conf 2>&1; echo; echo '== registries.conf.d, as file:line'; grep -r . /host/registries.conf.d/ 2>&1"]
      volumeMounts: [{ name: etc-containers, mountPath: /host, readOnly: true }]
      resources: { requests: { cpu: 10m, memory: 16Mi }, limits: { cpu: 100m, memory: 32Mi } }
      readinessProbe: { exec: { command: ["true"] } }
      livenessProbe: { exec: { command: ["true"] } }
      securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: [ALL] } }
YAML
    step "$name-answers" $K wait pod/"$name" -n kube-system --for=jsonpath='{.status.phase}'=Succeeded --timeout=180s
    show "$name-log" $K logs pod/"$name" -n kube-system
    step "$name-remove" $K delete pod/"$name" -n kube-system --ignore-not-found --wait=false
  done
}

case "${1:-}" in
  --list) echo "diagnose architect-doctor otto-parity otto-lockdown otto-restore healthchecks-door cilium-unchain cilium-replace helm-retry webhooks-restart namespace-unstick ghcr-pull-restore k8sgpt-analyze dns-per-node dns-per-namespace tcp-per-node node-drain node-uncordon chi-resize catalogue-roll router-spend registries-conf"; exit 0 ;;
  diagnose) pb_diagnose ;;
  architect-doctor) pb_architect_doctor ;;
  otto-parity) pb_otto_parity ;;
  otto-lockdown) pb_otto_lockdown ;;
  otto-restore) pb_otto_restore ;;
  healthchecks-door) pb_healthchecks_door ;;
  router-spend) pb_router_spend ;;
  dns-per-node) pb_dns_per_node ;;
  dns-per-namespace) pb_dns_per_namespace ;;
  tcp-per-node) pb_tcp_per_node ;;
  cilium-unchain) pb_cilium_unchain ;;
  cilium-replace) pb_cilium_replace ;;
  helm-retry) pb_helm_retry ;;
  webhooks-restart) pb_webhooks_restart ;;
  k8sgpt-analyze) pb_k8sgpt_analyze ;;
  catalogue-roll) pb_catalogue_roll ;;
  node-drain) pb_node_drain ;;
  node-uncordon) pb_node_uncordon ;;
  chi-resize) pb_chi_resize ;;
  namespace-unstick) pb_namespace_unstick ;;
  ghcr-pull-restore) pb_ghcr_pull_restore ;;
  registries-conf) pb_registries_conf ;;
  *) echo "usage: $0 <$(sed -n 's/^  --list) echo "\(.*\)"; exit 0 ;;$/\1/p' "$0" | tr " " "|")>"; exit 64 ;;
esac
[ -z "$FAILED" ] && { echo "PASS  break-glass $1"; exit 0; }
echo "FAIL  break-glass $1 broken:$FAILED"; exit 1
