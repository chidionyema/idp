#!/usr/bin/env python3
"""Refuse a catalogue whose references name entities nobody defines.

Backstage resolves an entity reference lazily: an unresolvable dependsOn, owner
or system renders as an ordinary link and only 404s when a person clicks it. So
a catalogue can look complete and be broken, which is the empty-shell failure
wearing a graph. This is the gate; bin/idp-ci runs it both ways.

Exit 0 and print a one-line summary when every reference resolves. Exit 1 and
print each offender when one does not, or when two documents claim the same ref.
"""
import sys, yaml

REF_FIELDS = ("owner", "system", "domain", "parent")
LIST_FIELDS = ("dependsOn", "dependencyOf", "providesApis", "consumesApis",
               "subcomponentOf", "memberOf", "children", "hasPart", "partOf")


def refs_of(doc):
    spec = doc.get("spec") or {}
    for f in REF_FIELDS:
        v = spec.get(f)
        if isinstance(v, str) and v:
            yield f, v
    for f in LIST_FIELDS:
        v = spec.get(f)
        if isinstance(v, str):
            v = [v]
        for item in v or []:
            if isinstance(item, str) and item:
                yield f, item


def normalise(ref, default_kind):
    """A reference may be bare (platform), kinded (group:platform) or full."""
    kind, _, rest = ref.partition(":")
    if not rest:
        kind, rest = default_kind, ref
    ns, _, name = rest.rpartition("/")
    return f"{kind.lower()}:{(ns or 'default').lower()}/{name.lower()}"


DEFAULT_KIND = {"owner": "group", "system": "system", "domain": "domain",
                "parent": "group", "memberOf": "group", "children": "group",
                "providesApis": "api", "consumesApis": "api",
                "subcomponentOf": "component", "partOf": "system",
                "hasPart": "component", "dependsOn": "component",
                "dependencyOf": "component"}


def main(paths):
    defined, dupes, used = {}, [], []
    for path in paths:
        for doc in yaml.safe_load_all(open(path)):
            if not isinstance(doc, dict) or "kind" not in doc:
                continue
            md = doc.get("metadata") or {}
            ref = (f"{doc['kind'].lower()}:"
                   f"{(md.get('namespace') or 'default').lower()}/{str(md.get('name','')).lower()}")
            if ref in defined:
                dupes.append((ref, defined[ref], path))
            defined[ref] = path
            for field, raw in refs_of(doc):
                used.append((ref, field, normalise(raw, DEFAULT_KIND.get(field, "component")), raw))

    dangling = [(src, f, tgt, raw) for src, f, tgt, raw in used if tgt not in defined]
    for ref, first, second in dupes:
        print(f"DUPLICATE {ref} defined in {first} and {second}")
    for src, f, tgt, raw in dangling:
        print(f"DANGLING  {src} spec.{f} -> {raw}  (no entity {tgt})")
    if dupes or dangling:
        print(f"{len(defined)} entities, {len(used)} references, "
              f"{len(dangling)} dangling, {len(dupes)} duplicate")
        return 1
    print(f"{len(defined)} entities, {len(used)} references, all resolve")
    return 0


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print("usage: catalog-refcheck <catalog-info.yaml> [more...]", file=sys.stderr)
        sys.exit(2)
    sys.exit(main(sys.argv[1:]))
