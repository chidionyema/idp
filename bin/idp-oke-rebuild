#!/usr/bin/env bash
# crew#220 (founder 2026-08-25): "repeatable, idempotent, fully automated, one shot, then add it
# to the drills. Port the platform anywhere in the shortest possible time, zero downtime."
#
# One script, three modes, every step idempotent, every step a receipt line "ok|FAIL|BLIND name rc
# seconds". Exit 0 only when the platform answers: nodes Ready, every Flux Kustomization ready,
# https://<host>/ 200 with a valid certificate, /catalog holds the pack count in platform/oci/clusters/<name>.env.
#
#   --check              zero-downtime drill (daily): no drift in tofu, cluster serving. Default.
#   --apply              one-shot bring-up or converge: login, tofu apply, flux bootstrap, verify.
#   --teardown-rebuild   the full drill: tofu destroy, then --apply. Downtime for the whole run.
#                        Run against a second cluster with OCI_CLUSTER_NAME=estate-drill; the
#                        Always Free A1 allowance is one node, so a parallel drill cluster needs
#                        paid capacity (founder decision, crew#220).
#
# LAW 43: every step is the mature tool (oci, tofu, flux, kubectl, curl). This file only orders
# them, times them and refuses to say PASS for a step it could not measure.
set -uo pipefail
export SUPPRESS_LABEL_WARNING=True
IDP="$(cd "$(dirname "$0")/.." && pwd)"
TF="$IDP/platform/oci"
MODE="${1:---check}"   # --plan-pool: crew#289, the node-pool decision with its cost line
export OCI_CLUSTER_NAME="${OCI_CLUSTER_NAME:-estate}"
# LAW 46: no product hostname or pack count in this script. Each cluster's expectations live in
# platform/oci/clusters/<name>.env; env vars override; nothing known means the row is BLIND, never a
# measurement of production while a drill cluster serves nothing (review idp#96, 2026-08-25).
CL="$TF/clusters/$OCI_CLUSTER_NAME.env"
if [ -f "$CL" ]; then while IFS='=' read -r k v; do case "$k" in ''|'#'*) ;; *) [ -n "${!k:-}" ] || export "$k=$v";; esac; done <"$CL"; fi
HOST="${OKE_HOST:-}"; API="${OKE_API_HOST:-}"; WANT_PACKS="${WANT_PACKS:-}"
export KUBECONFIG="$HOME/.kube/oke-$OCI_CLUSTER_NAME"
K="kubectl --request-timeout=90s"   # 20s was blown by a loaded laptop (2026-08-25) and reported the cluster down
T0=$(date +%s); FAILED=""
step() { # name, then the command; prints one receipt line, records failures, never exits early on FAIL
  local name="$1"; shift; local s out rc; s=$(date +%s)
  out=$("$@" 2>&1); rc=$?
  printf '%-5s %-18s rc=%-3s %4ss  %s\n' "$([ $rc -eq 0 ] && echo ok || echo FAIL)" "$name" "$rc" "$(( $(date +%s) - s ))" "$(printf %s "$out" | tail -1 | cut -c1-100)"
  # the failing step's own words: any Error/Message line first (an OCI 400 sits above tofu's 8-line
  # footer and was hidden in run 32930359052, crew#289), then the tail
  [ $rc -eq 0 ] || { FAILED="$FAILED $name"; { printf '%s\n' "$out" | grep -iE '(^|[^a-z])(error|message)[^a-z]' | head -6; printf '%s\n' "$out" | tail -8; } | awk '!seen[$0]++' | sed 's/^/      | /'; }
  return $rc
}
blind() { printf 'BLIND %-18s %s\n' "$1" "$2"; FAILED="$FAILED $1"; }
for t in oci tofu flux kubectl curl python3; do command -v "$t" >/dev/null || { blind tools "$t missing"; echo "exit 2"; exit 2; }; done

# --- node-pool decision (crew#289 CP3): no identity needed, the estimate is the module's own ---
if [ "$MODE" = "--plan-pool" ]; then
  cd "$TF" || { echo "FAIL  cd $TF"; exit 2; }
  tofu init -backend=false -input=false -no-color >/dev/null 2>&1 || { blind capacity "tofu init -backend=false failed"; echo "exit 2"; exit 2; }
  TFVARS=(-var "cluster_name=$OCI_CLUSTER_NAME" -var tenancy_ocid=unused -var compartment_ocid=unused -var ssh_public_key=unused)
  # crew#289 CP3: the node-pool decision and its cost line, from the module's own estimate
  # (local.capacity in main.tf, no apply needed) judged by policy/node_pool.rego. Prints
  # one of: FREE (inside the Always Free allowance), STAGED (paid, under the budget) or
  # FOUNDER ACTION (over it); exit 0 for the first two, 1 for the third.
  mkdir -p "$IDP/reports"
  if ! printf 'jsonencode({capacity = local.capacity})\n' | tofu console "${TFVARS[@]}" 2>/dev/null | python3 -c 'import sys,json; print(json.dumps(json.loads(json.loads(sys.stdin.read()))))' > "$IDP/reports/capacity.json"; then
    blind capacity "tofu console could not evaluate local.capacity"; echo "exit 2"; exit 2; fi
  python3 - "$IDP/reports/capacity.json" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))["capacity"]
paid = c["ocpus"] > c["free"]["ocpus"] or c["memory_gb"] > c["free"]["memory_gb"]
line = f'node pool {c["ocpus"]} OCPU / {c["memory_gb"]} GB, free allowance {c["free"]["ocpus"]}/{c["free"]["memory_gb"]}, estimated USD {c["monthly_usd"]:.2f} a month, budget USD {c["monthly_cap_usd"]}'
print(("FREE   " if not paid else "STAGED " if c["monthly_usd"] <= c["monthly_cap_usd"] else "FOUNDER ACTION (paid billing) ") + line)
PY
  if conftest test --parser json -p "$IDP/policy" "$IDP/reports/capacity.json" >/dev/null 2>&1; then echo "ok    node-pool policy/node_pool.rego passes reports/capacity.json"; exit 0
  else conftest test --parser json -p "$IDP/policy" "$IDP/reports/capacity.json" 2>&1 | grep -i fail | head -3; exit 1; fi
fi

# --- identity and inputs (idempotent: renders the same files every run) ---------------------
step login "$IDP/bin/idp-oci-login" || { echo "exit 2: no OCI identity"; exit 2; }

# --- state backend: remote when the bucket exists, else local and said so ---------------------
cd "$TF" || { echo "FAIL  cd $TF"; exit 2; }
if [ -f backend_override.tf ]; then
  # never -migrate-state/-force-copy: a stale local state would overwrite the shared remote (bin/idp-state-guard)
  "$IDP/bin/idp-state-guard" "$TF"
  step state-remote tofu init -input=false -no-color -reconfigure
else
  step state-local tofu init -input=false -no-color
  blind state-remote "no backend_override.tf: state is one local file (crew#220 hand step 1); run bin/idp-oci-bootstrap"
fi

# --- the cluster -------------------------------------------------------------------------------
TFVARS=(-input=false -no-color -var "cluster_name=$OCI_CLUSTER_NAME")
case "$MODE" in
  --check)
    # rc=2 is drift. Say which resources, not the plan's closing note: a tail nobody can read is
    # not an instrument (LAW 28; every run 02:22Z-02:28Z on 2026-08-26 failed with a hidden diff).
    # On a pull_request the planned changes ARE the PR (oke-check.yml sets OKE_CHECK_EXPECT_CHANGES=1):
    # rc=2 is shown and passes. On schedule/dispatch rc=2 is drift and fails (run 32925504695 on
    # 2026-08-26 failed #160 on its own capacity change, and rule-guard blocks merges on a red check).
    if step tofu-plan tofu plan -detailed-exitcode -lock=false -out="$TF/check.tfplan" "${TFVARS[@]}"; then :; else
      rc=$?
      [ -f "$TF/check.tfplan" ] && tofu show -no-color "$TF/check.tfplan" | grep -E '^\s*# .* (will|must) be |^Plan:' | sed 's/^/      | drift: /'
      if [ "$rc" -eq 2 ] && [ "${OKE_CHECK_EXPECT_CHANGES:-0}" = "1" ]; then
        FAILED="${FAILED% tofu-plan}"
        printf '%-5s %-18s rc=%-3s %4ss  %s\n' ok tofu-plan 2 0 "pull_request: the changes above are this PR, not drift"
      fi
    fi
    rm -f "$TF/check.tfplan" ;;
  --apply)
    # a create of a resource whose live namesake exists is a lost-state re-create: import, never apply
    step recreate-guard "$IDP/bin/idp-recreate-guard" "$TF" "${TFVARS[@]}" || { echo "exit 3: recreate-guard refused; import the live resource"; exit 3; }
    step tofu-apply tofu apply -auto-approve "${TFVARS[@]}"
    # A runner has no kube path (outside control_plane_allowed_cidrs) and a node-pool change needs
    # no Flux bootstrap: Flux is already on the cluster and reconciles the new node itself (crew#289).
    if [ -n "${OCI_CI:-}" ]; then echo "n/a   flux-bootstrap     no kube path from a runner; Flux already bootstrapped, a node-pool change needs none"
    else step flux-bootstrap "$IDP/bin/idp-flux-bootstrap"; fi ;;
  --teardown-rebuild)
    step tofu-destroy tofu destroy -auto-approve "${TFVARS[@]}"
    step recreate-guard "$IDP/bin/idp-recreate-guard" "$TF" "${TFVARS[@]}" || { echo "exit 3: recreate-guard refused; import the live resource"; exit 3; }
    step tofu-apply tofu apply -auto-approve "${TFVARS[@]}"
    step flux-bootstrap "$IDP/bin/idp-flux-bootstrap" ;;
  *) echo "usage: $0 [--check|--apply|--teardown-rebuild|--plan-pool]"; exit 64 ;;
esac

# --- verify: the platform answers, measured from outside ---------------------------------------
nodes_ready() { local o n; o=$($K get nodes --no-headers) || return 1; n=$(printf '%s\n' "$o" | grep -c '^[^ ]'); [ "$n" -ge 1 ] || { echo "0 nodes"; return 1; }; printf '%s\n' "$o" | awk '$2!="Ready"{f=1} END{exit f}' && echo "$n node(s) Ready" || { echo "not all Ready: $(printf '%s\n' "$o" | awk '{print $1":"$2}' | tr '\n' ' ')"; return 1; }; }
flux_ready() { local o n bad; o=$($K get kustomizations -A --no-headers) || return 1; n=$(printf '%s\n' "$o" | grep -c '^[^ ]'); [ "$n" -ge 1 ] || { echo "0 Kustomizations"; return 1; }; bad=$(printf '%s\n' "$o" | awk '$4!="True"{print $2}' | tr '\n' ' '); [ -z "$bad" ] && echo "$n Kustomizations ready" || { echo "not ready: $bad"; return 1; }; }
site_200()  { local c; c=$(curl -sS -m 20 -o /dev/null -w '%{http_code}' "https://$HOST/") && [ "$c" = 200 ] && echo "https://$HOST/ $c, cert valid" || { echo "https://$HOST/ -> ${c:-no answer}"; return 1; }; }
packs()     { local n; n=$(curl -sS -m 20 "https://$API/catalog" | python3 -c 'import sys,json;d=json.load(sys.stdin);print(len(d) if isinstance(d,list) else len(d.get("packs",d)))') && [ "$n" = "$WANT_PACKS" ] && echo "$n packs" || { echo "catalog: ${n:-unreadable}, want $WANT_PACKS"; return 1; }; }
# A GitHub runner is outside control_plane_allowed_cidrs, so it has no kube path. Nodes are then
# measured through the OCI API (same fact, other door); Flux state is not reachable from there
# and the site and catalog rows stand in for it. Said as n/a, never as ok (crew#227 CP2).
nodes_oci() { local o; o=$(oci ce node-pool list --compartment-id "$(awk -F'"' '/^compartment_ocid/{print $2}' terraform.tfvars)" --query 'data[].{n:name,s:"lifecycle-state"}' --output json) || return 1
  jq -er 'if length==0 then "no node pools" | halt_error(1) else (map(select(.s!="ACTIVE")) as $bad | if ($bad|length)>0 then "node pools not ACTIVE: \($bad|map(.n)|join(" "))" | halt_error(1) else "\(length) node pool(s) ACTIVE (OCI API)" end) end' <<<"$o"; }
if [ -f "$KUBECONFIG" ]; then
  step nodes nodes_ready
  step flux flux_ready
else
  step nodes nodes_oci
  printf 'n/a   %-18s %s\n' flux "no kube path from this host (outside control_plane_allowed_cidrs); site and catalog rows stand in"
fi
if [ -n "$HOST" ] && [ -n "$API" ] && [ -n "$WANT_PACKS" ]; then step site site_200; step catalog packs
else blind site "no OKE_HOST/OKE_API_HOST/WANT_PACKS for cluster $OCI_CLUSTER_NAME: add $TF/clusters/$OCI_CLUSTER_NAME.env"; blind catalog "same"; fi

echo "---"
if [ -z "$FAILED" ]; then echo "PASS  $MODE cluster=$OCI_CLUSTER_NAME $(( $(date +%s) - T0 ))s"; exit 0; fi
echo "FAIL  $MODE cluster=$OCI_CLUSTER_NAME $(( $(date +%s) - T0 ))s broken:$FAILED"; exit 1
