#!/usr/bin/env bash
# bin/idp-escrow — a full copy of every repository the estate runs on, written by GitHub itself
# to a second cloud, six times a day, with no laptop and no new account (crew#290 layer 4).
#
# WHY. crew#290 measured 2026-08-26: every load-bearing repository has exactly one remote and it
# is GitHub, so GitHub is a single point of failure for the board every session reads before it
# acts. The only escrow writer was the Mac's launchd job (estate_bundle_push.sh, every two hours),
# and its bundles for a repo that has a remote are incremental -- "restores only next to its
# remote", its own words -- so a GitHub loss restored 8 of 24 repos (bin/idp-recover-drill, run
# 33131027676) and a Mac loss stopped the writer. The 2026-08-26 answer was "the founder creates
# a Codeberg account"; that is a founder paste step (crew#66 no-toil, LAW 27/31) and it never
# happened. This job needs no second git host: `git bundle` is the whole history of a repository
# in one file, and the estate already owns object storage on a second cloud (Cloudflare R2, the
# bucket the Mac's escrow and the recover drill both use).
#
# WHAT. On the exchanged OIDC session (the identity verify-drill.yml and oke-check.yml run on)
# it mints an App installation token narrowed to the read-only lane `recovery`, lists every
# repository that installation can see (no hand-typed list: a repo the App is installed on is
# escrowed, one it is not on is named in the row), `git clone --mirror`s each, writes one bundle
# of every ref to R2 at mirrors/<owner>/<repo>/latest.bundle with a manifest beside it, and reads
# every upload back: the store's own MD5 must equal the file's, and `git bundle verify` must
# pass on the downloaded copy (LAW 15: two angles, the upload receipt is never the proof).
# A repository whose refs have not moved since the last manifest is skipped, so a quiet day costs
# a few list calls. Mac-side bundles live under bundles/ and are never touched.
#
# SECRETS. The R2 keys are read from the vault entry prospector-engine-env on the OIDC identity
# and reach rclone through RCLONE_S3_* environment variables, never argv. No static credential
# is in the workflow. The App token is read-only and dies within the hour.
#
# Rows, then one verdict line (FAIL when a row is red, BLIND exit 2 when it cannot be measured):
#   ok      github-app   installation token minted for lane recovery (read-only); installation sees 6 repo(s)
#   ok      escrow       chidionyema/idp 5 ref(s) 41.2 MiB written, read back md5 equal, bundle verifies
#   ok      escrow       chidionyema/crew unchanged since last escrow (refs sha 3f1c…); skipped
#   ok      idp-escrow   6/6 repositories escrowed to R2 mirrors/ (4 written, 2 unchanged)
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
IDP="$(cd "$(dirname "$0")/.." && pwd)"
COMP="${OCI_COMPARTMENT_OCID:?OCI_COMPARTMENT_OCID}"
VAULT_NAME="${ESTATE_VAULT_NAME:-estate-secrets}"
WORK="${ESCROW_WORK:-$(mktemp -d)}"
OUT="${ESCROW_RECEIPT_DIR:-$WORK/receipt}"
mkdir -p "$OUT"
PREFIX="${ESCROW_PREFIX:-mirrors}"
red=0
blind=0
okn=0
written=0
unchanged=0
total=0
say() { printf '%-7s %-12s %s\n' "$1" "$2" "$3" | tee -a "$OUT/rows.txt"; }
ok() {
	say ok "$1" "$2"
	okn=$((okn + 1))
}
fail() {
	say FAIL "$1" "$2"
	red=$((red + 1))
}
bl() {
	say BLIND "$1" "$2"
	blind=$((blind + 1))
}
for c in oci git jq rclone curl python3; do command -v "$c" >/dev/null || {
	say BLIND idp-escrow "$c is not installed"
	exit 2
}; done
[ "${OCI_CLI_AUTH:-}" = security_token ] || {
	say BLIND idp-escrow "OCI_CLI_AUTH is '${OCI_CLI_AUTH:-}', not security_token: no exchanged session in this environment"
	exit 2
}

# --- the vault, by name: a runner has no tofu state to ask (bin/idp-recover-drill's rule) --------
V=$(oci kms management vault list --compartment-id "$COMP" --all \
	--query "data[?\"display-name\"=='$VAULT_NAME' && \"lifecycle-state\"=='ACTIVE'].id | [0]" --raw-output 2>/dev/null || true)
[ -n "$V" ] && [ "$V" != null ] || {
	say BLIND vault "no ACTIVE vault named $VAULT_NAME in the compartment"
	exit 2
}
export ESTATE_VAULT_OCID="$V"

# --- github-app: a read-only token, and the installation's own list of what it can see ---------
tok=$("$IDP/bin/idp-github-app" token recovery 2>"$OUT/github-app.err" | cat) || true
if ! [[ "$tok" =~ ^ghs_[A-Za-z0-9_.-]+$ ]]; then
	say BLIND github-app "no installation token: $(grep -m1 '^DIAG' "$OUT/github-app.err" 2>/dev/null || tail -1 "$OUT/github-app.err" 2>/dev/null || true)"
	exit 2
fi
curl -sS -H "Authorization: Bearer $tok" -H "Accept: application/vnd.github+json" \
	"https://api.github.com/installation/repositories?per_page=100" >"$OUT/installation-repos.json" 2>"$OUT/installation-repos.err" || true
repos=$(jq -r '.repositories[]? | select(.archived|not) | .full_name' "$OUT/installation-repos.json" 2>/dev/null || true)
if [ -z "$repos" ]; then
	say BLIND github-app "token minted but the installation lists no repositories: $(jq -r '.message // empty' "$OUT/installation-repos.json" 2>/dev/null | cut -c1-80)"
	exit 2
fi
ok github-app "installation token minted for lane recovery (read-only); installation sees $(wc -l <<<"$repos" | tr -d ' ') repo(s)"

# --- r2: the second cloud's keys, from the vault, into the environment and never argv ----------
if ! env_json=$("$IDP/bin/idp-cloud" secret get prospector-engine-env 2>"$OUT/r2.err") || [ -z "$env_json" ]; then
	say BLIND r2 "vault entry prospector-engine-env not readable: $(tail -1 "$OUT/r2.err" | cut -c1-120)"
	exit 2
fi
RCLONE_S3_PROVIDER=Cloudflare
export RCLONE_S3_PROVIDER
RCLONE_S3_ENDPOINT="https://$(jq -r .R2_ACCOUNT_ID <<<"$env_json").r2.cloudflarestorage.com"
export RCLONE_S3_ENDPOINT
RCLONE_S3_ACCESS_KEY_ID=$(jq -r .R2_ACCESS_KEY_ID <<<"$env_json")
export RCLONE_S3_ACCESS_KEY_ID
RCLONE_S3_SECRET_ACCESS_KEY=$(jq -r .R2_SECRET_ACCESS_KEY <<<"$env_json")
export RCLONE_S3_SECRET_ACCESS_KEY
B=$(jq -r '.R2_BUCKET // "prospector-packs"' <<<"$env_json")
unset env_json
rclone lsf ":s3:$B/" --max-depth 1 >/dev/null 2>"$OUT/rclone.err" || {
	say BLIND r2 "bucket $B not listable with the vault's R2 keys: $(tail -1 "$OUT/rclone.err" | cut -c1-120)"
	exit 2
}

# --- escrow: one full bundle per repository, skipped when its refs have not moved ---------------
auth=$(printf 'x-access-token:%s' "$tok" | base64 | tr -d '\n')
for r in $repos; do
	total=$((total + 1))
	key="$PREFIX/$r"
	d="$WORK/$(tr / _ <<<"$r").git"
	if ! git -c credential.helper= -c "http.extraHeader=Authorization: Basic $auth" clone -q --mirror "https://github.com/$r" "$d" 2>"$OUT/clone.err"; then
		fail escrow "$r clone --mirror failed: $(tail -1 "$OUT/clone.err" | cut -c1-120)"
		continue
	fi
	refs=$(git -C "$d" for-each-ref --format='%(refname) %(objectname)' | sort)
	nrefs=$(printf '%s\n' "$refs" | grep -c . || true)
	if [ "$nrefs" -eq 0 ]; then
		ok escrow "$r has no refs (empty repository); nothing to escrow"
		unchanged=$((unchanged + 1))
		continue
	fi
	refsha=$(printf '%s\n' "$refs" | sha256sum | cut -c1-64)
	prev=$(rclone cat ":s3:$B/$key/manifest.json" 2>/dev/null | jq -r '.refs_sha256 // empty' 2>/dev/null || true)
	if [ "$prev" = "$refsha" ]; then
		ok escrow "$r unchanged since last escrow (refs sha ${refsha:0:8}); skipped"
		unchanged=$((unchanged + 1))
		continue
	fi
	bundle="$WORK/$(tr / _ <<<"$r").bundle"
	if ! git -C "$d" bundle create "$bundle" --all 2>"$OUT/bundle.err"; then
		fail escrow "$r bundle create failed: $(tail -1 "$OUT/bundle.err" | cut -c1-120)"
		continue
	fi
	bytes=$(wc -c <"$bundle" | tr -d ' ')
	md5=$(md5sum "$bundle" | cut -c1-32)
	if ! rclone copyto "$bundle" ":s3:$B/$key/latest.bundle" 2>"$OUT/upload.err"; then
		fail escrow "$r upload failed: $(tail -1 "$OUT/upload.err" | cut -c1-120)"
		continue
	fi
	# read back, two angles: the store's own hash of what it holds, and git's verdict on a fresh download
	remote_md5=$(rclone hashsum md5 ":s3:$B/$key/latest.bundle" 2>/dev/null | cut -c1-32)
	if [ "$remote_md5" != "$md5" ]; then
		fail escrow "$r read back: store md5 ${remote_md5:-none} != local $md5"
		continue
	fi
	if ! rclone copyto ":s3:$B/$key/latest.bundle" "$bundle.back" 2>"$OUT/download.err" || ! git -C "$d" bundle verify "$bundle.back" >/dev/null 2>"$OUT/verify.err"; then
		fail escrow "$r read back: downloaded bundle does not verify: $(tail -1 "$OUT/verify.err" 2>/dev/null | cut -c1-120)"
		continue
	fi
	head=$(git -C "$d" rev-parse HEAD 2>/dev/null || true)
	jq -n --arg repo "$r" --arg refs_sha256 "$refsha" --argjson refs "$nrefs" --arg head "$head" --argjson bytes "$bytes" --arg md5 "$md5" \
		--arg written_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg run "${GITHUB_RUN_ID:-local}" \
		'{repo:$repo, refs_sha256:$refs_sha256, refs:$refs, head:$head, bytes:$bytes, md5:$md5, written_at:$written_at, run:$run, restore:"git clone latest.bundle <dir>"}' >"$WORK/manifest.json"
	rclone copyto "$WORK/manifest.json" ":s3:$B/$key/manifest.json" 2>"$OUT/manifest.err" || {
		fail escrow "$r manifest upload failed: $(tail -1 "$OUT/manifest.err" | cut -c1-120)"
		continue
	}
	cp "$WORK/manifest.json" "$OUT/$(tr / _ <<<"$r").manifest.json"
	ok escrow "$r $nrefs ref(s) $(python3 -c "print(f'{$bytes/1048576:.1f} MiB')") written, read back md5 equal, bundle verifies"
	written=$((written + 1))
	rm -f "$bundle" "$bundle.back"
	rm -rf "$d"
done

# --- verdict ------------------------------------------------------------------------------------
if [ "$red" -gt 0 ]; then
	say FAIL idp-escrow "$red of $total repositories not escrowed (rows above)"
	exit 1
fi
say ok idp-escrow "$total/$total repositories escrowed to R2 $B/$PREFIX/ ($written written, $unchanged unchanged)"
