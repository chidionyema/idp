#!/usr/bin/env bash
# crew#584 CP-H: run a laptop process inside the staging namespace of the estate cluster.
#
#   bin/idp-dev hermes-agent -- python main.py
#
# mirrord (brew install metalbear-co/mirrord/mirrord) plugs the process into the cluster. Which
# way depends on what staging holds:
#   - Deployment/<service> exists in staging  -> .mirrord/<service>.json, retargeted at staging:
#     the process sees that pod's env, files (read-only), DNS and a copy of its traffic.
#   - nothing named <service> in staging      -> .mirrord/staging.json, targetless: the process
#     gets the namespace's network and DNS (every cluster service by name) and nothing else.
# Either way the agent lands in staging, the one namespace platform/edge/dev-loop-policy.yaml
# admits it into; production never carries the label, so the cluster refuses a wrong target.
# The kubeconfig is bin/idp-kube's (never a hand-set context). Grading, same shape as bin/idp-*:
# `BLIND   dev  <why>` exit 2 when the cluster cannot be reached, mirrord's own exit code otherwise.
set -euo pipefail
on_exit() {
	rc=$?
	case $rc in 0 | 2 | 64) ;; *) printf 'FAIL    dev  exit %s\n' "$rc" >&2 ;; esac
}
trap on_exit EXIT
IDP=$(cd "$(dirname "$0")/.." && pwd)
NS=staging
blind() {
	printf 'BLIND   dev  %s\n' "$1" >&2
	exit 2
}
svc="${1:-}"
[ -n "$svc" ] || {
	echo "usage: bin/idp-dev <service> [-- <command...>]" >&2
	exit 64
}
shift
[ "${1:-}" = "--" ] && shift
command -v mirrord >/dev/null || blind "mirrord is not installed: brew install metalbear-co/mirrord/mirrord"
kc=$("$IDP/bin/idp-kube") || blind "bin/idp-kube could not reach the cluster"
KC=${kc##* }
if KUBECONFIG="$KC" kubectl -n "$NS" get deployment "$svc" >/dev/null 2>&1; then
	cfg="$IDP/.mirrord/$svc.json"
	[ -f "$cfg" ] || blind "staging holds deployment/$svc but .mirrord/$svc.json is missing"
	printf 'ok      dev  %s: attached to deployment/%s in %s (mirror, fs read)\n' "$svc" "$svc" "$NS"
	export MIRRORD_TARGET_NAMESPACE="$NS" MIRRORD_AGENT_NAMESPACE="$NS"
else
	cfg="$IDP/.mirrord/staging.json"
	printf 'ok      dev  %s: no deployment/%s in %s, running targetless (network + dns only)\n' "$svc" "$svc" "$NS"
fi
[ $# -gt 0 ] || exit 0
KUBECONFIG="$KC" exec mirrord exec -f "$cfg" -- "$@"
