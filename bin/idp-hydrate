#!/usr/bin/env bash
# crew#488 CP1/CP2: hydrate whatever cluster KUBECONFIG points at from this repository's Flux tree.
#
# One definition of "the drill" for every provider: flux install, the estate config, one
# GitRepository pinned to the commit under test, every Kustomization under clusters/oke/. The k3d
# job and the k3s job of .github/workflows/portability-drill.yml both run this, so a buyer's
# engineer can point KUBECONFIG at any cluster and run the same five commands.
#
# Env: SHA (commit to pin), REF (branch that holds it); GITHUB_REPOSITORY (owner/repo) as GitHub
# sets it. Nothing here names a cloud, a host or a home directory (LAW 46).
set -euo pipefail
: "${SHA:?commit to pin}" "${REF:?branch holding SHA}" "${GITHUB_REPOSITORY:?owner/repo}"
here=$(cd "$(dirname "$0")/.." && pwd)
flux install --components-extra=image-reflector-controller,image-automation-controller
kubectl apply -f "$here/clusters/oke/estate-config.yaml"
flux create source git flux-system --url="https://github.com/${GITHUB_REPOSITORY}" --branch="$REF" --commit="$SHA" --interval=10m
for f in "$here"/clusters/oke/*.yaml; do kubectl apply -f "$f"; done
echo "applied $(kubectl get kustomizations -A --no-headers | wc -l) Kustomizations"
