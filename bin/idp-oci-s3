#!/usr/bin/env bash
# provider-adapter: oci — the object store's S3-compatible door, signed by curl with the state-backend
# keys the sops envelope already holds (OCI_S3_ACCESS_KEY / OCI_S3_SECRET_KEY, the same pair
# platform/oci's remote state uses). It exists for a machine with no OCI identity: a Mac's laptop
# sessions are retired (crew#345) and it holds no API key, yet it must read one bucket object (the job
# monitor's ping key, crew#163). bin/idp-cloud calls it when `oci os object get` cannot answer.
#   idp-oci-s3 get BUCKET NAME      body on stdout; exit 1 NotFound (404), exit 2 BLIND (no keys / no curl)
# env: OCI_OS_NAMESPACE, OCI_REGION, OCI_S3_ACCESS_KEY, OCI_S3_SECRET_KEY (else the sops envelope), ESTATE_SECRETS
set -u
IDP=$(cd "$(dirname "$0")/.." && pwd)
blind() { printf 'BLIND   oci-s3  %s\n' "$1" >&2; exit 2; }
[ "${1:-}" = get ] && [ -n "${2:-}" ] && [ -n "${3:-}" ] || blind "usage: idp-oci-s3 get BUCKET NAME"
BUCKET=$2; NAME=$3
command -v curl >/dev/null || blind "curl missing"
vget() {
  local v; v=${!1:-}
  if [ -z "$v" ] && command -v sops >/dev/null; then
    local MAIN; MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")
    export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}
    v=$(sops -d --extract "[\"$1\"]" "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/${OCI_ENV:-dev}/$1.yaml" 2>/dev/null)
  fi
  [ -n "$v" ] || blind "no $1 in the environment or the envelope"
  printf '%s' "$v"
}
NS=$(vget OCI_OS_NAMESPACE) || exit 2; REG=$(vget OCI_REGION) || exit 2
AK=$(vget OCI_S3_ACCESS_KEY) || exit 2; SK=$(vget OCI_S3_SECRET_KEY) || exit 2
code=$(curl -sS --max-time 20 -o "${TMPDIR:-/tmp}/oci-s3.$$" -w '%{http_code}' --aws-sigv4 "aws:amz:$REG:s3" --user "$AK:$SK" \
  "https://$NS.compat.objectstorage.$REG.oraclecloud.com/$BUCKET/$NAME") || { rm -f "${TMPDIR:-/tmp}/oci-s3.$$"; blind "curl failed against the S3 door"; }
case "$code" in
  200) cat "${TMPDIR:-/tmp}/oci-s3.$$"; rm -f "${TMPDIR:-/tmp}/oci-s3.$$"; exit 0;;
  404) rm -f "${TMPDIR:-/tmp}/oci-s3.$$"; echo "NotFound: $BUCKET/$NAME" >&2; exit 1;;
  *)   rm -f "${TMPDIR:-/tmp}/oci-s3.$$"; blind "S3 door answered HTTP $code for $BUCKET/$NAME";;
esac
