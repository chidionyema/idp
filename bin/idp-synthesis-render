#!/usr/bin/env python3
"""Render a synthesis markdown file to a single self-contained HTML page.

House style lifted from docs/tooling-foundations.html so this page sits beside the
existing generated reports rather than introducing a second look.

    python3 bin/idp-synthesis-render DOC.md [--out FILE]

Deliberately dependency-free (no markdown lib): the subset used by the synthesis docs is
headings, paragraphs, fenced code, pipe tables, blockquotes, and lists -- and a converter
that handles exactly that is auditable in a way a general markdown pipeline is not.
"""

from __future__ import annotations

import argparse
import html
import pathlib
import re
import sys

CSS = """
:root{
  --ground:#F5F7F5; --surface:#FFFFFF; --surface-2:#EDF1EE;
  --ink:#15201B; --ink-soft:#525E58; --ink-faint:#7C8880;
  --line:#DCE2DD; --line-strong:#C3CDC6;
  --accent:#17624F; --accent-soft:#DCEDE6;
  --warn:#9A5713; --warn-soft:#F6E9D8;
  --stop:#8C2E2E; --stop-soft:#F4DEDE;
  --shadow:0 1px 2px rgba(21,32,27,.05),0 8px 24px -12px rgba(21,32,27,.18);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ground:#0F1512; --surface:#161D19; --surface-2:#1D2622;
    --ink:#E6EDE8; --ink-soft:#9AA79F; --ink-faint:#77857D;
    --line:#26312B; --line-strong:#374339;
    --accent:#5CBEA1; --accent-soft:#17302A;
    --warn:#D3934A; --warn-soft:#33261A;
    --stop:#D57272; --stop-soft:#331E1E;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -14px rgba(0,0,0,.7);
  }
}
:root[data-theme="dark"]{
  --ground:#0F1512; --surface:#161D19; --surface-2:#1D2622;
  --ink:#E6EDE8; --ink-soft:#9AA79F; --ink-faint:#77857D;
  --line:#26312B; --line-strong:#374339;
  --accent:#5CBEA1; --accent-soft:#17302A;
  --warn:#D3934A; --warn-soft:#33261A;
  --stop:#D57272; --stop-soft:#331E1E;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px -14px rgba(0,0,0,.7);
}
*{box-sizing:border-box}
body{
  background:var(--ground); color:var(--ink);
  font-family:"Public Sans",-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif;
  font-size:17px; line-height:1.62; margin:0; -webkit-font-smoothing:antialiased;
}
.wrap{max-width:960px;margin:0 auto;padding:0 20px 96px}
main{display:flex;flex-direction:column;gap:44px}
