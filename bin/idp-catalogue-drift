#!/usr/bin/env python3
"""crew#401 CP4: the hostnames the cluster publishes, diffed against the catalogue.

The catalogue is what the founder sees: backstage/**/catalog-info.yaml in this repo plus every
`type: url` location app-config.container.yaml names (products are onboarded by URL, crew#282,
so a product hostname is only ever registered there). An HTTPRoute the catalogue does not name
is a surface nobody can find from the portal. A url location that cannot be fetched is BLIND,
never a clean row and never a FAIL blamed on the product. The cluster-state
receipt (platform/state/cluster-state.yaml, key `hostnames`) is the live list, read the way
bin/idp-cluster-state reads it: from Object Storage, never a kube path. Same row grammar:

    ok      catalogue-drift  0 unregistered of N live hostnames
    FAIL    catalogue-drift  M unregistered: a.zone, b.zone       -- exit 1
    BLIND   catalogue-drift  <why>                                 -- exit 2, nothing graded

    bin/idp-catalogue-drift                 read the live receipt through bin/idp-cluster-state --json
    bin/idp-catalogue-drift --receipt FILE  grade a receipt body on disk (the tests)
"""
from __future__ import annotations

import glob
import json
import os
import re
import subprocess
import sys
import urllib.request

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def zone() -> str:
    with open(os.path.join(IDP, "clusters", "oke", "estate-config.yaml"), encoding="utf-8") as fh:
        m = re.search(r"^\s*ESTATE_ZONE:\s*(\S+)", fh.read(), re.M)
    if not m:
        print("BLIND   catalogue-drift  clusters/oke/estate-config.yaml carries no ESTATE_ZONE"); sys.exit(2)
    return m.group(1)


def catalogue_hosts(z: str) -> set[str]:
    hosts: set[str] = set()
    for f in glob.glob(os.path.join(IDP, "backstage", "**", "catalog-info.yaml"), recursive=True):
        with open(f, encoding="utf-8") as fh:
            for m in re.finditer(r"url:\s*[\"']?https?://([^\"'/\s]+)", fh.read()):
                hosts.add(m.group(1).replace("${ESTATE_ZONE}", z).lower())
    return hosts


def url_location_hosts(z: str) -> tuple[set[str], str]:
    """Hosts named by the catalog-info.yaml files app-config.container.yaml onboards by URL.
    Returns (hosts, error); error names the first location that did not fetch."""
    cfg = os.environ.get("IDP_APP_CONFIG") or os.path.join(IDP, "backstage", "app-config.container.yaml")
    with open(cfg, encoding="utf-8") as fh:
        targets = re.findall(r"-\s*type:\s*url\s*\n\s*target:\s*(\S+)", fh.read())
    hosts: set[str] = set()
    for t in targets:
        raw = re.sub(r"^https://github\.com/([^/]+/[^/]+)/blob/", r"https://raw.githubusercontent.com/\1/", t)
        req = urllib.request.Request(raw)
        if os.environ.get("GH_TOKEN") and raw.startswith("https://raw.githubusercontent.com/"):
            req.add_header("Authorization", f"Bearer {os.environ['GH_TOKEN']}")
        try:
            with urllib.request.urlopen(req, timeout=20) as resp:
                text = resp.read().decode("utf-8", "replace")
        except Exception as e:  # noqa: BLE001 - the row reports BLIND with the reason
            return hosts, f"{t}: {e}"[:200]
        for m in re.finditer(r"url:\s*[\"']?https?://([^\"'/\s]+)", text):
            hosts.add(m.group(1).replace("${ESTATE_ZONE}", z).lower())
    return hosts, ""


def receipt_body(arg: str | None) -> dict:
    if arg:
        with open(arg, encoding="utf-8") as fh:
            text = fh.read()
    else:
        # The reader exits non-zero whenever the cluster-state row is FAIL (Flux not ready, a pod
        # pending). The hostnames list does not depend on that grade, so the exit code is not
        # read here; only a receipt with no JSON body is BLIND (crew#401 first live row, 02:37Z).
        reader = os.environ.get("IDP_CLUSTER_STATE_BIN") or os.path.join(IDP, "bin", "idp-cluster-state")
        r = subprocess.run([reader, "--json"], capture_output=True, text=True)
        text = r.stdout
    for line in reversed(text.strip().splitlines()):
        if line.startswith("{"):
            return json.loads(line)
    print("BLIND   catalogue-drift  receipt carries no JSON body"); sys.exit(2)


def main() -> int:
    arg = sys.argv[sys.argv.index("--receipt") + 1] if "--receipt" in sys.argv else None
    body = receipt_body(arg)
    live = body.get("hostnames")
    if not isinstance(live, list):
        print("BLIND   catalogue-drift  receipt carries no hostnames list (collector predates crew#401 CP4, or the HTTPRoute list failed: "
              f"{str(body.get('hostnames_error', ''))[:120]})")
        return 2
    z = zone()
    known = catalogue_hosts(z)
    url_hosts, err = url_location_hosts(z)
    if err:
        print(f"BLIND   catalogue-drift  a url location in app-config.container.yaml did not fetch: {err}"); return 2
    known |= url_hosts
    if not known:
        print("BLIND   catalogue-drift  the catalogue names no https URL; nothing to diff against"); return 2
    unregistered = sorted(h for h in {x.lower() for x in live} if h not in known)
    if unregistered:
        print(f"FAIL    catalogue-drift  {len(unregistered)} unregistered of {len(live)} live hostnames: {', '.join(unregistered)}")
        return 1
    print(f"ok      catalogue-drift  0 unregistered of {len(live)} live hostnames ({len(known)} in the catalogue)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
