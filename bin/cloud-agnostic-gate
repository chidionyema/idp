#!/usr/bin/env python3
"""Count provider-specific references in the platform outside the compute provisioner.

Founder, 2026-08-25 (crew#250, R36): "the platform (idp) must not know or care who owns the
servers it runs on." Spec: features/cloud-agnostic/disposable-compute-universal-state.feature,
scenario "No provider-specific service or annotation in the platform".

Scanned: platform/** manifests and code. Exempt: the raw compute provisioner (platform/oci),
the one ClusterSecretStore (platform/secret-store) and the per-cluster rows (clusters/*), which
are the three places a cloud is allowed to be named. Comment lines are not counted.
Exit 0 at zero, 1 with each offending line printed, 2 when the root cannot be read (BLIND).
Proved both ways: CLOUD_AGNOSTIC_ROOT=<dir> scans that tree; tests/fixtures/cloud-agnostic/{good,bad}.
Untracked files are skipped when the root is a git checkout (crew#516 CP6): bin/idp-oci-login renders
platform/<module>/backend_override.tf with the object-storage endpoint and credentials for a session,
and the gate graded that rendered file as a leak. A file git does not hold cannot ship.

crew#66 CP5e: a file under bin/ may declare itself the provider adapter (the one that signs in
or reads the tenancy-root IAM) with `# provider-adapter: <provider>` in its first three lines;
its provider-specific lines are then skipped, and the prefix `bin/idp-oci-` / `bin/idp-iam-` is
the only path allowed to carry that marker (a declaration anywhere else is itself a finding:
a caller hiding behind the marker).
"""
import os
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path(os.environ.get("CLOUD_AGNOSTIC_ROOT") or pathlib.Path(__file__).resolve().parents[1])
SCAN = ["platform", "bin"]
EXEMPT = ("platform/oci/", "platform/secret-store/", "clusters/")
SUFFIXES = {".yaml", ".yml", ".py", ".ts", ".tf", ".sh", ".json"}
PATTERN = re.compile(
    r"oraclecloud\.com|oci-load-balancer|objectstorage\.|"
    r"service\.beta\.kubernetes\.io/aws-|alb\.ingress\.kubernetes\.io|eks\.amazonaws\.com|dynamodb|"
    r"cloud\.google\.com/|pubsub\.googleapis|"
    r"^\s*(oracle|aws|gcpsm|azurekv):\s*$"  # ExternalSecrets provider blocks outside the store
)
# crew#66 CP5e: a file that IS the provider door (signs in / reads the tenancy-root IAM) declares
# itself with this marker on line 1-3; the marker is honoured only when the path starts with one
# of ADAPTER_ALLOWED_PREFIXES.
ADAPTER_MARK = re.compile(r"^# provider-adapter: (oci|aws|gcp|azure)\b")
ADAPTER_ALLOWED_PREFIXES = ("bin/idp-oci-", "bin/idp-iam-")


def _untracked(root: pathlib.Path) -> set[str]:
    """Paths git does not track under root, relative to root; empty when root is not a checkout."""
    try:
        out = subprocess.run(
            ["git", "-C", str(root), "ls-files", "--others", "-z"],
            capture_output=True, text=True, check=True,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        return set()
    return {p for p in out.split("\0") if p}


def declared_adapter(path: pathlib.Path) -> str | None:
    """Provider name when `path`'s first three lines declare an adapter, else None (crew#66 CP5e)."""
    try:
        with path.open() as fp:
            for _ in range(3):
                line = fp.readline()
                if not line:
                    return None
                m = ADAPTER_MARK.match(line)
                if m:
                    return m.group(1)
    except OSError:
        return None
    return None


def _adapter_marker_line(path: pathlib.Path) -> int:
    """Line number (1-indexed) of the first ADAPTER_MARK in `path`'s first three lines, else 1."""
    try:
        with path.open() as fp:
            for n, line in enumerate(fp, 1):
                if n > 3:
                    break
                if ADAPTER_MARK.match(line):
                    return n
    except OSError:
        pass
    return 1


def main() -> int:
    if not ROOT.is_dir():
        print(f"BLIND: {ROOT} is not a directory")
        return 2
    hits = []
    adapters = []
    untracked = _untracked(ROOT)
    for top in SCAN:
        for f in sorted((ROOT / top).rglob("*")):
            # crew#66 CP5e: the operator scripts under bin/ carry no extension; a tracked, extensionless
            # bin/ file is scanned too, or the adapter marker is never read where it is actually placed.
            if not f.is_file() or (f.suffix not in SUFFIXES and not (top == "bin" and f.suffix == "")):
                continue
            rel = f.relative_to(ROOT).as_posix()
            if f.resolve() == pathlib.Path(__file__).resolve():
                continue  # the gate names the patterns it hunts; it is not a finding against itself
            if rel.startswith(EXEMPT) or "/.terraform/" in rel or rel in untracked:
                continue
            provider = declared_adapter(f)
            if provider is not None:
                if not rel.startswith(ADAPTER_ALLOWED_PREFIXES):
                    hits.append(f"{rel}:{_adapter_marker_line(f)}: provider-adapter declared outside {ADAPTER_ALLOWED_PREFIXES}")
                    continue
                adapters.append((provider, rel))
                continue
            for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
                if line.lstrip().startswith("#"):
                    continue
                if PATTERN.search(line):
                    hits.append(f"{rel}:{n}: {line.strip()}")
    for h in hits:
        print(h)
    for provider, rel in adapters:
        print(f"adapter {provider}  {rel}")
    print(f"cloud-agnostic-gate: {len(hits)} provider-specific line(s) outside the provisioner")
    print(f"cloud-agnostic-gate: {len(adapters)} declared adapter file(s)")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
