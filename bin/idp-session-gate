#!/usr/bin/env python3
"""The session-plane caller for the gates that grade a TURN, not a pull request.

Why this exists (founder, 2026-09-13): "after hours and hours ... wtf is going on". The estate had
built the gate that refuses a claim with no tool call behind it -- bin/idp-epistemic -- and wired it
to the `ci` plane. CI reads a pull request. A false claim is made in a conversation. The gate was
therefore never in the room where the defect happens, and the same defect returned for hours while a
green row said it was guarded.

The founder's own observation is the design rule: the only guard he has ever felt fire is the
128,000-token ceiling, and it fires because it sits where the turn is. This file puts the turn-level
gates in that same place.

`bin/idp-rules` already knows which gates are turn-level and how to invoke them -- this is a caller
for it, not a second registry. The rows are read from rules.yaml; nothing is duplicated here.

    idp-session-gate --transcript <path.jsonl>     grade one session's transcript
    idp-session-gate --all                         grade every estate transcript
    idp-session-gate --list                        what this would run, and on which plane

Exit 0 clean, 1 when any turn-level gate refuses, 2 fail-closed (a gate could not be read).
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# The rows that grade a TURN. A rule is turn-level when the thing it catches exists inside a
# conversation and is gone by merge time, and when the gate ITSELF takes a session transcript.
#
# Two rows are deliberately NOT here, and both reasons are worth keeping, because both were silent
# failures that made this caller look wired while it graded nothing:
#
#   cost-proof       reads a pull request body against a file list (--pr-body, --files). No session
#                    mode exists. It was listed here from its name alone, was handed a transcript,
#                    exited 2, and that 2 saturated to BLIND over a real FAIL from a row above it.
#   circuit-breaker  takes --finding/--target, or --replay <fixture>. It reads a FLEET of targets,
#                    not a conversation; a session has no set of targets to correlate.
#
# A gate is listed here because its interface takes a transcript, never because its name sounds
# like it should.
#
# circuit-breaker IS here, and the reason is worth keeping: it holds its N=3 count in memory by
# default, so in a turn -- where every call is a fresh process -- it could never reach the lock and
# was structurally blind. It is a turn-level gate the moment it is given a store, so this caller
# gives it one (see session_store) and asks the gate's own --help whether it takes one.
TURN_LEVEL_ROWS = (
    "epistemic",
    "trajectory",
    "circuit-breaker",
)

# A gate that cannot answer inside this is not a gate; it is a hang (LAW 55).
GATE_TIMEOUT_S = 55


def load_rows() -> list[dict]:
    """Read rules.yaml -- the one registry. bin/idp-rules reads this same file; `list` prints a
    table, not JSON, so this reads the source rather than a second interface invented for it."""
    path = REPO / "rules.yaml"
    try:
        import yaml
    except ImportError:
        print("BLIND session-gate PyYAML is not importable", file=sys.stderr)
        sys.exit(2)

    try:
        data = yaml.safe_load(path.read_text())
    except (OSError, yaml.YAMLError) as e:
        print(f"BLIND session-gate could not parse rules.yaml: {e}", file=sys.stderr)
        sys.exit(2)

    rows = data if isinstance(data, list) else (data or {}).get("rules", [])
    if not rows:
        print("BLIND session-gate the registry is empty", file=sys.stderr)
        sys.exit(2)
    return rows


def turn_level(rows: list[dict]) -> list[dict]:
    """The rows this caller is responsible for, and the ones named but missing."""
    by_id = {(r.get("id") or r.get("name") or ""): r for r in rows}

    missing = [rid for rid in TURN_LEVEL_ROWS if rid not in by_id]
    if missing:
        # Fail closed: a row that was renamed or deleted must stop this, not quietly pass.
        print(
            f"BLIND session-gate these turn-level rows are not in rules.yaml: {', '.join(missing)}",
            file=sys.stderr,
        )
        sys.exit(2)

    return [by_id[rid] for rid in TURN_LEVEL_ROWS]


# A tool's own --help does not change inside one run, so it is asked once per process and then
# remembered. Measured: asking it per row made a 6.9s grade take 27.7s, which is the blocking call
# this estate was told to eradicate -- my own code, added while removing exactly that.
_ACCEPTS_CACHE: dict[tuple[str, ...], bool] = {}


def _accepts(runner: str | list[str], flag: str) -> bool:
    """Does this gate's own --help advertise `flag`?

    `runner` is the row's full run argv (e.g. ["python3", "bin/idp-circuit-breaker"]), never just
    its first word: asking `python3 --help` answers a question about python, not about the gate.

    Asked of the tool, never kept as a list of names in this file. A gate that grows a --store is
    picked up the moment it declares one; a gate that drops it stops being handed one. Typing a
    name here would be a second registry, and a second registry drifts.
    """
    cmd = [runner] if isinstance(runner, str) else list(runner)
    key = tuple(cmd + [flag])
    if key in _ACCEPTS_CACHE:
        return _ACCEPTS_CACHE[key]
    try:
        proc = subprocess.run(
            cmd + ["--help"], capture_output=True, text=True, timeout=15, cwd=REPO
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        # Never cache a failure to ask: a transient miss must not become a permanent no.
        return False
    _ACCEPTS_CACHE[key] = flag in (proc.stdout + proc.stderr)
    return _ACCEPTS_CACHE[key]


def run_row(row: dict, transcript: Path | None, store: Path | None = None) -> tuple[int, str]:
    """Invoke one row's argv.

    A transcript is handed to a row only when that row's own cases pass a bare positional path --
    the registry's way of saying "this gate grades a file, give it one". Nothing is passed to a row
    that documents no such case.

    `store` is a per-session durable record. It exists because circuit-breaker keeps its state
    IN MEMORY by default (`Breaker()` with no store), so a turn that levels three identical findings
    across three targets can never reach the N=3 lock: each call is a fresh process and sees one
    finding. The row is proved both ways in CI, where a single process reads the whole fixture, and
    was structurally blind in every turn. A session-scoped store is what makes it a turn-level gate.
    """
    argv = list(row.get("run") or [])
    if not argv:
        return 2, f"no run argv on row {row.get('id')}"

    # A case passes a bare path when an argument neither starts with a dash nor follows one.
    def _bare_path(case: dict) -> bool:
        args = [str(a) for a in (case.get("args") or [])]
        prev_dashed = False
        for a in args:
            if a.startswith("-"):
                prev_dashed = True
                continue
            if not prev_dashed:
                return True
            prev_dashed = False  # this value belonged to the flag before it
        return False

    takes_path = any(_bare_path(c) for c in (row.get("cases") or []) if not c.get("live"))
    if transcript is not None and takes_path:
        argv = argv + [str(transcript)]

    # Rows that hold state across invocations are given a store. It is a property of the gate's own
    # interface (it documents --store), never a hardcoded list of names. The question is asked of
    # the row's FULL run argv, not its first word -- asking `python3 --help` asks about python.
    row_cmd = list(row.get("run") or [])
    if store is not None and _accepts(row_cmd, "--store"):
        argv = argv + ["--store", str(store)]

    try:
        proc = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=GATE_TIMEOUT_S,
            cwd=REPO,
        )
    except subprocess.TimeoutExpired:
        return 2, f"{row.get('id')} exceeded {GATE_TIMEOUT_S}s"
    except FileNotFoundError as e:
        return 2, f"{row.get('id')} could not run: {e}"

    body = (proc.stdout + proc.stderr).strip()
    return proc.returncode, body


def estate_transcripts() -> list[Path]:
    """Every live session transcript, newest first."""
    root = Path(os.environ.get("PI_SESSIONS", Path.home() / ".pi" / "agent" / "sessions"))
    if not root.exists():
        return []
    files = [p for p in root.rglob("*.jsonl") if p.is_file()]
    files.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    return files


def session_store(transcript: Path) -> Path:
    """The durable record for THIS session, named after the transcript it belongs to.

    Session-scoped on purpose. A shared store would let one session's findings lock another
    session's target -- the lock is meant to stop one agent acting linearly, not to make unrelated
    work impossible (R38, a guard that refuses correct work is an outage).
    """
    root = Path(os.environ.get("PI_SESSION_STATE", Path.home() / ".estate" / "session-state"))
    root.mkdir(parents=True, exist_ok=True)
    return root / f"{transcript.stem}.circuit-breaker.jsonl"


def grade_one(transcript: Path, rows: list[dict], quiet_ok: bool, store: bool = True) -> int:
    worst = 0
    state = session_store(transcript) if store else None
    for row in rows:
        rc, body = run_row(row, transcript, state)
        rid = row.get("id")
        if rc == 0:
            if not quiet_ok:
                print(f"  ok    {rid}")
            continue
        if rc == 2:
            # Fail closed: a gate that could not answer is never a pass.
            print(f"  BLIND {rid}", file=sys.stderr)
            if body:
                print("      " + body.replace("\n", "\n      "), file=sys.stderr)
            worst = max(worst, 2)
            continue
        print(f"  FAIL  {rid}", file=sys.stderr)
        if body:
            print("      " + body.replace("\n", "\n      "), file=sys.stderr)
        worst = max(worst, 1)
    return worst


def self_test() -> int:
    """Exercise the real paths, so `bin/idp-script-compiles` can prove this script runs.

    A script that has never executed is not built (LAW 45). Every branch here is the one a turn
    takes: the registry reads, the rows resolve, a bad fixture is refused, a good one passes, and a
    missing rule fails closed.
    """
    checks: list[tuple[str, bool]] = []

    rows = load_rows()
    checks.append(("registry loads", len(rows) > 40))

    by_id = {r.get("id"): r for r in rows}
    checks.append(("every turn-level row exists", all(r in by_id for r in TURN_LEVEL_ROWS)))

    # A row that takes a bare positional path is handed a transcript; one that does not is not.
    def bare(case: dict) -> bool:
        args = [str(a) for a in (case.get("args") or [])]
        dashed = False
        for a in args:
            if a.startswith("-"):
                dashed = True
            elif not dashed:
                return True
            else:
                dashed = False
        return False

    ep = by_id["epistemic"]
    cb = by_id["circuit-breaker"]
    checks.append(("epistemic takes a path", any(bare(c) for c in ep.get("cases") or [])))
    checks.append(("circuit-breaker does not", not any(bare(c) for c in cb.get("cases") or [])))

    # The store is granted by asking the tool, not by naming it here.
    checks.append(
        ("circuit-breaker advertises --store", _accepts(["python3", "bin/idp-circuit-breaker"], "--store"))
    )

    # Grading a script that does not parse must be refused, not crash.
    rc, _ = run_row({"id": "x", "run": ["python3", "/nonexistent/xyz"]}, None)
    checks.append(("an unrunnable row is BLIND, not a pass", rc == 2))

    bad = REPO / "tests/fixtures/epistemic/bad/session.jsonl"
    good = REPO / "tests/fixtures/trajectory/good/session.jsonl"
    if bad.exists():
        checks.append(("the bad fixture is refused", run_row(ep, bad)[0] == 1))
    if good.exists():
        checks.append(("a good fixture passes", run_row(by_id["trajectory"], good)[0] == 0))

    failed = [name for name, ok in checks if not ok]
    for name, ok in checks:
        print(f"  {'ok  ' if ok else 'FAIL'} {name}")
    if failed:
        print(f"  {len(failed)} of {len(checks)} checks failed")
        return 1
    print(f"  {len(checks)} checks, all pass")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(add_help=True, description=__doc__.split("\n")[0])
    ap.add_argument("--transcript", type=Path, help="grade one session transcript")
    ap.add_argument("--all", action="store_true", help="grade every estate transcript")
    ap.add_argument("--list", action="store_true", help="print the turn-level rows and exit")
    ap.add_argument("--quiet", action="store_true", help="print only refusals")
    ap.add_argument("--self-test", action="store_true", help="prove this script runs")
    args = ap.parse_args(argv[1:])

    if args.self_test:
        return self_test()

    rows = turn_level(load_rows())

    if args.list:
        for r in rows:
            print(f"  {r.get('id'):20s} {' '.join(r.get('run') or [])}")
        print(f"  {len(rows)} turn-level row(s)")
        return 0

    if args.transcript:
        if not args.transcript.exists():
            print(f"BLIND session-gate no such transcript: {args.transcript}", file=sys.stderr)
            return 2
        return grade_one(args.transcript, rows, quiet_ok=args.quiet)

    if args.all:
        transcripts = estate_transcripts()
        if not transcripts:
            print("BLIND session-gate no transcripts found", file=sys.stderr)
            return 2
        worst = 0
        for t in transcripts:
            print(f"  {t.name}")
            worst = max(worst, grade_one(t, rows, quiet_ok=True))
        return worst

    print(__doc__.strip())
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
