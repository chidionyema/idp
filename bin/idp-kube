#!/usr/bin/env bash
# crew#66, founder 2026-08-28: "Laptop kubeconfig points at a local k3d that isn't running — well it
# shouldn't, don't repeat mistakes … solve once and forever." Sessions were running bare `kubectl`
# against whatever ~/.kube/config pointed at (a dead k3d-estate context, connection refused on
# 127.0.0.1:6445) and grading the estate BLIND while the cluster was fine.
#
# This is the one way a laptop or a runner speaks to the estate cluster. The kubeconfig comes from
# bin/idp-cloud cluster kubeconfig (the same path oke-check.yml and bin/idp-verify-drill use), never
# from a hand-set context, and it is cached under $XDG_STATE_HOME/idp for IDP_KUBE_MAX_AGE_MIN
# minutes (default 30) so a session pays the cloud round trip once.
#   bin/idp-kube get pods -n observability
#   bin/idp-kube --refresh get nodes          # rebuild the kubeconfig now
#   bin/idp-kube                              # print the kubeconfig path only
# Grading, same shape as every bin/idp-*: `BLIND   kube  <why>` exit 2 when no cluster could be
# reached; the why names bin/idp-oci-login when the session is the gap. kubectl's own exit code
# otherwise. rule-guard (claude-guards policy/command.rego, bare_kubectl) refuses bare kubectl and
# names this file.
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
blind() { printf 'BLIND   kube  %s\n' "$1" >&2; exit 2; }
STATE="${IDP_KUBE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/idp}"
KC="$STATE/kubeconfig"
MAX_MIN="${IDP_KUBE_MAX_AGE_MIN:-30}"
refresh=0
if [ "${1:-}" = "--refresh" ]; then refresh=1; shift; fi
command -v kubectl >/dev/null || blind "kubectl is not installed"
fresh=0
if [ "$refresh" -eq 0 ] && [ -f "$KC" ] && [ -n "$(find "$KC" -mmin "-$MAX_MIN" 2>/dev/null)" ]; then fresh=1; fi
if [ "$fresh" -eq 0 ]; then
  cl=$("$IDP/bin/idp-cloud" cluster list 2>&1) || blind "cluster list failed: $(printf '%s' "$cl" | tail -1 | cut -c1-160) -- refresh the session with bin/idp-oci-login"
  # crew#345: the cluster is picked by name (OCI_CLUSTER_NAME, default estate), never by position;
  # a compartment with several ACTIVE clusters made NR==1 mint a kubeconfig for the wrong one.
  want="${OCI_CLUSTER_NAME:-estate}"
  cid=$(printf '%s\n' "$cl" | awk -v n="$want" '$1==n{print $2; exit}')
  [ -n "$cid" ] || blind "no ACTIVE cluster named $want; ACTIVE: $(printf '%s\n' "$cl" | awk '{print $1}' | paste -sd, -) -- set OCI_CLUSTER_NAME"
  mkdir -p "$STATE" && chmod 700 "$STATE"
  out=$("$IDP/bin/idp-cloud" cluster kubeconfig "$cid" --file "$KC" 2>&1) || blind "create-kubeconfig failed ($want): $(printf '%s' "$out" | tail -1 | sed -E 's/.*"code": "([^"]+)".*"message": "([^"]+)".*/\1: \2/' | cut -c1-240)"
  chmod 600 "$KC"
  # The OCI CLI writes `command: oci`, a bare name, and that is only findable when the caller has a
  # login shell's PATH. Headlamp.app launched from Finder does not: a GUI app inherits
  # /usr/bin:/bin:/usr/sbin:/sbin, `oci` lives outside all four, the exec plugin cannot run, and
  # Headlamp falls back to the one thing ADR 0003 and ADR 0007 refuse -- "Please paste your
  # authentication token". So the path is resolved here, once, at the moment the file is minted.
  # Resolved with command -v, never written down: the machine is not named in a tracked file (LAW 46).
  OCI_BIN="$(command -v oci || true)"
  if [ -n "$OCI_BIN" ]; then
    tmp="$KC.$$"
    # The CLI also prints an API-key advisory on every call unless SUPPRESS_LABEL_WARNING is set;
    # the plugin's env block carries it, so no consumer needs a shell that exports it.
    sed -e "s|^\( *command: \)oci *$|\1$OCI_BIN|" -e 's|^\( *\)env: \[\] *$|\1env: [{name: SUPPRESS_LABEL_WARNING, value: "True"}]|' "$KC" >"$tmp" && mv "$tmp" "$KC" && chmod 600 "$KC"
  fi
fi
if [ $# -eq 0 ]; then printf 'ok      kube  kubeconfig %s\n' "$KC"; exit 0; fi
KUBECONFIG="$KC" exec kubectl "$@"
