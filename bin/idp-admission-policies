#!/usr/bin/env python3
"""idp-admission-policies: the cluster's admission policies, as a table, from the tree and nothing else.

Founder, 2026-08-28: "i need our security polices available to all crew, we must never be confused
about how security works." Two ClusterPolicies had been written and never installed (crew#341's
secrets-not-from-env-vars sat in no kustomization for two days; the whole edge row dry-run failed
before Kyverno's CRD existed). A page that lists them by hand would have listed those too. This
prints the table docs/reference/security-policy.md carries under "## Cluster admission policies";
tests/test_incident_crew488_cp5_root_reds_are_never_green.py refuses the page when the two differ,
so the page can only say what the tree does.

Columns: policy, mode (Audit or Enforce, per rule when they differ), what it refuses (the policy's own title annotation), the
Flux layer that applies it, the file. A policy in no layer prints `NOT APPLIED` and exits 1.
"""
from __future__ import annotations

import os
import sys

import yaml

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def layers() -> dict[str, str]:
    out = {}
    d = os.path.join(ROOT, "clusters", "oke")
    for f in sorted(os.listdir(d)):
        if not f.endswith(".yaml"):
            continue
        with open(os.path.join(d, f), encoding="utf-8") as fh:
            for doc in yaml.safe_load_all(fh):
                if doc and doc.get("kind") == "Kustomization":
                    out[str((doc.get("spec") or {}).get("path", "")).lstrip("./")] = doc["metadata"]["name"]
    return out


def mode(spec: dict) -> str:
    """Kyverno 1.13+ sets the action per rule (validate.failureAction); older policies set it once
    (spec.validationFailureAction); a rule that says nothing is Audit, which is Kyverno's default."""
    default = spec.get("validationFailureAction", "Audit")
    acts = [((r.get("validate") or {}).get("failureAction") or default) for r in spec.get("rules", [])] or [default]
    kinds = sorted(set(acts))
    if len(kinds) == 1:
        return kinds[0]
    return ", ".join(f"{k} {acts.count(k)}" for k in kinds)


def rows() -> list[dict]:
    by_path = layers()
    out = []
    for dirpath, _, files in os.walk(os.path.join(ROOT, "platform")):
        for f in sorted(files):
            if not f.endswith(".yaml"):
                continue
            full = os.path.join(dirpath, f)
            with open(full, encoding="utf-8") as fh:
                text = fh.read()
            if "kind: ClusterPolicy" not in text:
                continue
            rel_dir = os.path.relpath(dirpath, ROOT)
            kust = os.path.join(dirpath, "kustomization.yaml")
            wired = False
            if os.path.exists(kust):
                with open(kust, encoding="utf-8") as fh:
                    wired = f in (yaml.safe_load(fh) or {}).get("resources", [])
            layer = by_path.get(rel_dir) if wired else None
            for doc in yaml.safe_load_all(text):
                if not doc or doc.get("kind") != "ClusterPolicy":
                    continue
                ann = doc["metadata"].get("annotations") or {}
                out.append({
                    "policy": doc["metadata"]["name"],
                    "mode": mode(doc.get("spec") or {}),
                    "refuses": ann.get("policies.kyverno.io/title", "(no title annotation)"),
                    "layer": layer or "NOT APPLIED",
                    "file": os.path.relpath(full, ROOT),
                })
    return sorted(out, key=lambda r: r["policy"])


def table() -> str:
    lines = ["| Policy | Mode | Refuses | Flux layer | File |", "|---|---|---|---|---|"]
    for r in rows():
        lines.append(f"| `{r['policy']}` | {r['mode']} | {r['refuses']} | `{r['layer']}` | `{r['file']}` |")
    return "\n".join(lines) + "\n"


def main() -> int:
    t = table()
    sys.stdout.write(t)
    return 1 if "NOT APPLIED" in t else 0


if __name__ == "__main__":
    sys.exit(main())
