#!/usr/bin/env python3
"""Build and load the image bundle the shadow-verify workflow restores from cache.

The shadow brings a throwaway k3d cluster up, installs Flux, and reconciles the
platform paths under test. On a fresh runner every one of those pods pulls from
ghcr, and the k3d node image alone is ~1GB. The bundle pre-bakes the images
every shadow-verify needs (bin/idp-shadow-bundle-images.txt) and exports a tar
the cache step restores; shadow-verify imports the tar into the k3d image
store before the cluster comes up, so pods never pull from ghcr.

Three halves are exposed so a test or the populate workflow can drive each:
  list_images      -- one canonical image per line, comments and blanks dropped
  derive_flux      -- runs `flux install --export`, returns the four image refs
  cache_key        -- one canonical actions/cache key for both workflows
  bundle_export    -- docker pull then docker save; writes the tar
  bundle_import    -- docker load on the same tar; idempotent (docker skips existing)

The k3d image import command itself runs in the workflow (it talks to the
k3d-internal docker socket); this script only handles docker pull/save/load
and the cache-key computation so it is testable without a k3d install.
"""

from __future__ import annotations

import hashlib
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
IMAGES_FILE = HERE / "idp-shadow-bundle-images.txt"


def list_images(path: Path = IMAGES_FILE) -> list[str]:
    """Every image in the bundle manifest, in file order, comments and blanks
    dropped, duplicates preserved (docker pulls each at most once, in any
    case)."""
    images: list[str] = []
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        images.append(line)
    return images


def derive_flux_images() -> list[str]:
    """The four flux controller image refs, from the manifest the shadow will
    apply. Output is sorted+deduped so the cache key is stable across runs.
    Requires `flux` on PATH and `yq` to read the install manifest."""
    out = subprocess.run(
        ["flux", "install", "--export"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    yq = subprocess.run(
        ["yq", "-o=tsv", '.. | select(has("image")).image'],
        input=out,
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    images = sorted({line.strip() for line in yq.splitlines() if line.strip()})
    if not images:
        raise SystemExit("flux install --export yielded no images; check the flux CLI")
    return images


def cache_key(
    manifest: Path = IMAGES_FILE, flux_images: list[str] | None = None
) -> str:
    """The single actions/cache key both the populate workflow and shadow-verify
    compute. The flux portion is a hash of the derived list (not the literal
    list) so a Flux release with the same four images in the same order still
    reuses the cache; a different version produces a different hash and a
    cache miss, which is what we want on upgrade."""
    h = hashlib.sha256()
    h.update(manifest.read_bytes())
    if flux_images is not None:
        h.update(b"\n".join(s.encode() for s in flux_images))
    return f"shadow-bundle-{h.hexdigest()[:16]}"


def bundle_export(images: list[str], tar: Path) -> None:
    """docker pull each, then docker save them all to a single tar.

    docker pull is idempotent (a cached layer is free). docker save with
    multiple refs writes them all into one tar; a workflow can `k3d image
    import` the same tar without unpacking it on the runner."""
    if not images:
        raise SystemExit("no images to export; check bin/idp-shadow-bundle-images.txt")
    for img in images:
        subprocess.run(["docker", "pull", img], check=True)
    subprocess.run(["docker", "save", "-o", str(tar), *images], check=True)


def bundle_import(tar: Path) -> None:
    """docker load the tar; idempotent for whatever docker already has."""
    if not tar.exists():
        raise SystemExit(f"bundle tar not found: {tar}")
    subprocess.run(["docker", "load", "-i", str(tar)], check=True)


def _self_test() -> int:
    # The script lives in the bin/ directory; pytest loads it via
    # SourceFileLoader. The shell entry points are small wrappers.
    argv = sys.argv[1:]
    if not argv:
        raise SystemExit(
            f"usage: {sys.argv[0]} export <tar> | key [--flux-list <file>] | flux-images"
        )
    cmd = argv[0]
    if cmd == "export":
        out = Path(argv[1])
        out.parent.mkdir(parents=True, exist_ok=True)
        bundle_export(list_images(), out)
        print(f"ok  bundle  {out} ({out.stat().st_size} bytes)")
        return 0
    if cmd == "flux-images":
        for img in derive_flux_images():
            print(img)
        return 0
    if cmd == "key":
        flux = None
        if "--flux-list" in argv:
            p = Path(argv[argv.index("--flux-list") + 1])
            flux = [line.strip() for line in p.read_text().splitlines() if line.strip()]
        print(cache_key(flux_images=flux))
        return 0
    raise SystemExit(f"unknown subcommand: {cmd}")


if __name__ == "__main__":
    sys.exit(_self_test())
