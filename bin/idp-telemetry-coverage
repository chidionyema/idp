#!/usr/bin/env bash
# crew#320 / LAW 50: read the cluster's telemetry-coverage receipt from Object Storage. The CronJob
# in platform/observability/telemetry-coverage.yaml diffs Running pods (API server) against pods
# seen in ClickHouse (SigNoz logs and metrics, last hour) every 15 minutes and writes
# state/telemetry-coverage from the node's instance principal; this reads it with whatever OCI
# auth the caller has (a runner's exchanged OIDC session in oke-check.yml). Same grading shape as
# bin/idp-cluster-state, which it was copied from.
#   ok      telemetry-coverage  <line 1 of the receipt>   -- fresh, missing=0
#   FAIL    telemetry-coverage  <why>                     -- receipt missing, stale, or a Running pod the backend never saw
#   BLIND   telemetry-coverage  <why>                     -- no oci CLI, no session, or the backend could not be queried
# Print the JSON body (the missing pods) with --json. Max age 60 min. Override TELEMETRY_COVERAGE_MAX_AGE_MIN.
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
BUCKET="${DRILL_RECEIPT_BUCKET:-estate-drill-receipts}"
MAX_MIN="${TELEMETRY_COVERAGE_MAX_AGE_MIN:-60}"
blind() { printf 'BLIND   telemetry-coverage  %s\n' "$1"; exit 2; }
fail()  { printf 'FAIL    telemetry-coverage  %s\n' "$1"; exit 1; }
command -v python3 >/dev/null || blind "python3 is not installed"
head=$("$IDP/bin/idp-cloud" object head --bucket "$BUCKET" --name state/telemetry-coverage 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
  case "$head" in
    *"404"*|*NotFound*|*"not found"*) fail "no receipt state/telemetry-coverage in bucket $BUCKET: the CronJob has never completed (Flux row telemetry-coverage not reconciled, or the bucket is not applied yet)" ;;
    *) blind "object head failed: $(printf '%s' "$head" | tail -1 | cut -c1-160)" ;;
  esac
fi
body=$("$IDP/bin/idp-cloud" object get --bucket "$BUCKET" --name state/telemetry-coverage 2>/dev/null)
# crew#539 (2026-08-28 00:28Z, run 33129788480): the outage receipt (36 Flux rows, 40 pods with
# their last log) outgrew ARG_MAX and `python3: Argument list too long` graded the estate BLIND
# at the moment it needed reading. The body travels by file, never by argv.
bodyf=$(mktemp); trap 'rm -f "$bodyf"' EXIT; printf '%s' "$body" > "$bodyf"
IDP_LIB="$IDP/bin/lib" python3 - "$head" "$bodyf" "$MAX_MIN" "${1:-}" <<'PY'
import os as _os
def _body_arg(a):
    # crew#539: the receipt is a file path when the caller wrote it out (ARG_MAX, run 33129788480); a literal body is still accepted for the test harnesses.
    return (open(a, encoding='utf-8', errors='replace').read() if _os.path.isfile(a) else a).strip()
import json, re, sys
sys.path.insert(0, _os.environ.get("IDP_LIB", ""))
from receipt_age import receipt_age  # crew#583 CP2: the store's clock, never this machine's
head, body, max_min, flag = sys.argv[1], _body_arg(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
line1, _, rest = body.partition("\n")
try:
    head = json.loads(head)
except Exception as e:
    print(f"BLIND   telemetry-coverage  object head was not readable JSON: {e}"); sys.exit(2)
age = receipt_age(head, 60.0, "telemetry-coverage")
if line1.startswith("BLIND "):
    print(f"BLIND   telemetry-coverage  {line1[:160]}"); sys.exit(2)
def why():
    # LAW 28: a FAIL that hides its cause is not an instrument. The receipt body names
    # every backend the query could not reach and every pod it never saw; print both.
    try:
        b = json.loads(rest)
    except Exception:
        return "  (receipt body is not JSON)"
    errs = b.get("backend_errors") or {}
    miss = b.get("missing") or []
    out = "".join(f"\n        backend {k}: {str(v)[:200]}" for k, v in errs.items())
    out += "".join(f"\n        never seen: {m.get('ns')}/{m.get('pod')}" for m in miss[:8])
    if len(miss) > 8:
        out += f"\n        ... and {len(miss) - 8} more"
    # crew#539 CP12: Hubble (platform/cni/cilium-values.yaml, applied by cilium-replace) is proved
    # by the flows it labelled with a radio-room workload; a count of 0 in the last hour is the
    # CNI not observing pods.
    if "hubble_radio_flows" in b and int(b["hubble_radio_flows"]) <= 0:
        out += f"\n        hubble: {b['hubble_radio_flows']} hubble_flows_processed_total series named a radio-room workload in the last hour (platform/cni/cilium-values.yaml)"
    return out
if not line1.startswith("ok "):
    print(f"FAIL    telemetry-coverage  receipt does not start with ok: {line1[:120]!r}{why()}")
    if flag == "--json":
        print(rest)
    sys.exit(1)
if age > max_min:
    print(f"FAIL    telemetry-coverage  receipt is {age:.0f} min old (max {max_min:.0f}): {line1[:120]}"); sys.exit(1)
kv = dict(m.groups() for m in re.finditer(r"(\w+)=(-?\d+)", line1))
if kv.get("missing") != "0" or int(kv.get("pods", 0)) == 0:
    print(f"FAIL    telemetry-coverage  pods={kv.get('pods')} missing={kv.get('missing')}: {line1[:120]}{why()}"); sys.exit(1)
# crew#539 CP12: a receipt written before the Hubble row (no hubble_radio_flows) is graded as a
# miss, never as clean (same rule as cluster-state's flux_not_ready, crew#406).
if int(kv.get("hubble_radio_flows", 0)) <= 0:
    print(f"FAIL    telemetry-coverage  hubble_radio_flows={kv.get('hubble_radio_flows', 'absent')}: {line1[:120]}{why()}"); sys.exit(1)
print(f"ok      telemetry-coverage  {line1} ({age:.0f} min ago)")
if flag == "--json":
    print(rest)
PY
