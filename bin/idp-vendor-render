#!/usr/bin/env python3
"""Render the two LiteLLM router configs from the vendor registry.

One vendor, one place (founder 2026-09-02, the groq removal): platform/vendors/consoles.yaml
is the only file that names a model vendor. Each vendor's `router:` block carries its lanes
and fallback chains; this tool splices them into llm/config.base.yaml and
platform/llm/config.base.yaml and writes llm/config.yaml and platform/llm/config.yaml.
Adding or removing a vendor is one registry edit plus one run of this tool; the rendered
pair is committed, and --check (run by bin/idp-ci and tests/test_llm_row.py) fails when the
committed files do not match a fresh render, so the pair can never drift from the registry.

Registry shape, per vendor, all fields optional:
    router:
      lanes: |              # model_list entries both routers serve (comments ride along)
      cluster_lanes: |      # entries only the cluster serves (capability aliases)
      fallbacks: |          # fallback chains for the lanes above
      cluster_fallbacks: |  # chains only the cluster carries
      console_lanes: [name] # model groups served from litellm-db and owned by the founder in
                            # the LiteLLM console: nothing is rendered for them and no key is
                            # held in git, but a chain here may name one (2026-09-04 -- a model
                            # declared in this config is read-only in the console, so a lane
                            # whose key he rotates himself must not be declared here).
Block content is stored flush left; the marker's field decides the indent it gets back.

Deterministic: same inputs, same bytes, every run (the idempotency rule in AGENTS.md).
Exit 0 ok; 1 drift under --check; 2 a missing or malformed input.
"""

import pathlib
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[1]
REG = ROOT / "platform/vendors/consoles.yaml"
HEADER = (
    "# GENERATED by bin/idp-vendor-render -- vendor lanes and fallback chains come from\n"
    "# platform/vendors/consoles.yaml (`router:` blocks), everything else from {base}.\n"
    "# Edit those two, never this file; bin/idp-ci fails when this file and a fresh render differ.\n"
)
TARGETS = [
    ("llm/config.yaml", "llm/config.base.yaml"),
    ("platform/llm/config.yaml", "platform/llm/config.base.yaml"),
]
BRIDGE = "platform/human-vault-bridge/externalsecrets.yaml"
BRIDGE_HEADER = """# GENERATED by bin/idp-vendor-render -- one ExternalSecret per vendor per namespace, from the
# `targets:` of every vendor in platform/vendors/consoles.yaml whose store_default is human-vault.
# Edit the registry, never this file; bin/idp-ci fails when this file and a fresh render differ.
#
# The human door, wired (decision 0017). A key the founder drops into Bitwarden Secrets Manager
# under the name in a target's `bw:` field lands in the cluster as a Secret named human-<vendor>,
# in the namespace that consumes it, within the refresh interval. Nothing is pasted into a portal
# and no value is ever typed into this repository.
#
# Why one ExternalSecret per vendor rather than one per namespace holding every key: External
# Secrets fails an ExternalSecret whole when any one of its `data` entries names a secret the store
# does not hold. Split this way, a vendor whose key has not been dropped in yet fails only its own
# Secret, and its status line names exactly which key is missing -- so the set of failing bridge
# ExternalSecrets IS the list of keys still to add, with no separate inventory to keep true.
#
# Addressing is by name, not by Bitwarden id, and that is load-bearing. `dataFrom.find` was
# measured on 2026-09-07 against bitwarden-sdk-server v0.6.0 and it IGNORES `name.regexp`: a find
# for `^NO_SUCH_KEY_AT_ALL$` returned the project's unrelated secret and `rewrite` then renamed it
# onto the field. A bridge built on find would quietly serve one vendor's value under every other
# vendor's key. `data[].remoteRef.key: <name>` resolves exactly, and refuses when the name is
# absent, which is the behaviour a credential path must have.
"""
# marker line (stripped) -> (registry field, indent the block gets in the output)
FIELDS = {
    "# @vendor-lanes@": ("lanes", 2),
    "# @vendor-cluster-lanes@": ("cluster_lanes", 2),
    "# @vendor-fallbacks@": ("fallbacks", 4),
    "# @vendor-cluster-fallbacks@": ("cluster_fallbacks", 4),
}
KNOWN = {f for f, _ in FIELDS.values()} | {"console_lanes"}


def blocks(vendors: dict, field: str, indent: int) -> str:
    out = []
    for name, v in vendors.items():
        router = v.get("router") or {}
        unknown = set(router) - KNOWN
        if unknown:
            raise SystemExit(
                f"BLIND   vendor-render   {name}: router field(s) {sorted(unknown)} unknown to the renderer"
            )
        txt = router.get(field)
        if txt:
            pad = " " * indent
            out.append(
                "\n".join(
                    pad + ln if ln.strip() else ""
                    for ln in txt.rstrip("\n").split("\n")
                )
            )
    return "\n\n".join(out)


SEED = "platform/human-vault-bridge/pushsecrets.yaml"
SEED_HEADER = """# GENERATED by bin/idp-vendor-render -- do not edit; change platform/vendors/consoles.yaml.
#
# The seeding half of the human door. externalsecrets.yaml carries keys DOWN from the founder's
# Bitwarden Secrets Manager into the estate; this file carries the ones the estate already holds
# UP into Bitwarden once, so he never has to find and retype a key the platform is already using.
#
# updatePolicy: IfNotExists is the whole safety argument. A PushSecret with the default Replace
# would rewrite the founder's value from the estate's copy on every refresh, so the moment he
# rotated a key it would be silently reverted -- the exact opposite of what the door is for.
# IfNotExists writes only into an empty slot: it fills what he has never set and never touches
# what he has. deletionPolicy: None so that deleting this file leaves his vault as it is.
#
# A source Secret or field that does not exist fails this PushSecret alone, the same way a
# missing Bitwarden name fails one ExternalSecret alone (measured 2026-09-07: one absent key
# takes down the whole object it sits in, and nothing else).
"""


def seed(vendors: dict) -> str:
    """One PushSecret per key, never one per source Secret.

    Grouping several keys into one object would tie them together: a single field the estate
    has never held -- MOONSHOT_API_KEY sits in the registry and in no Secret -- fails the whole
    object and seeds none of its siblings. One key, one object, one failure.
    """
    rows = {}
    for name, v in sorted(vendors.items()):
        if v.get("store_default") != "human-vault":
            continue
        for t in v.get("targets") or []:
            if not t.get("bw") or not t.get("ns") or t.get("derived"):
                continue
            # Keyed by (namespace, name), not by name: one Bitwarden secret is often held in
            # more than one place -- TELEGRAM_ALERTS_BOT_TOKEN sits in flux-system/flux-telegram
            # and in notify/notify-apprise-founder-telegram. Seeding from every holder costs
            # nothing (IfNotExists means the first one to arrive wins and the rest no-op) and
            # means the seed still happens when one of the holders does not exist yet.
            # A target with no vault `entry` has no cluster Secret to seed Bitwarden FROM:
            # the founder's copy IS the only copy (minimax, 2026-09-10, after the vault copies
            # were proved revoked and unset). Nothing to push, so no PushSecret -- the
            # ExternalSecret in the other direction is the whole relationship.
            if not t.get("entry"):
                continue
            rows.setdefault((t["ns"], t["bw"]), (t["entry"], t["field"]))
    docs = []
    for (ns, bw), (entry, field) in sorted(rows.items()):
        docs.append(f"""apiVersion: external-secrets.io/v1alpha1
kind: PushSecret
metadata:
  name: seed-{bw.lower().replace("_", "-")}
  namespace: {ns}
spec:
  refreshInterval: 1h
  updatePolicy: IfNotExists
  deletionPolicy: None
  secretStoreRefs:
    - {{ kind: ClusterSecretStore, name: human-vault }}
  selector:
    secret: {{ name: {entry} }}
  data:
    - match:
        secretKey: {field}
        remoteRef: {{ remoteKey: {bw} }}""")
    return "\n---\n".join(docs) + "\n"


def bridge(vendors: dict) -> str:
    """The ExternalSecrets that carry a founder-held key from Bitwarden into the namespaces."""
    docs = []
    for name, v in sorted(vendors.items()):
        if v.get("store_default") != "human-vault":
            continue
        by_ns: dict = {}
        for t in v.get("targets") or []:
            # `derived:` targets are computed from another field (kimi's API base is the key's
            # host), so no human ever drops them anywhere and nothing bridges them.
            if not t.get("bw") or not t.get("ns") or t.get("derived"):
                continue
            by_ns.setdefault(t["ns"], {})[t["field"]] = t["bw"]
        for ns, fields in sorted(by_ns.items()):
            rows = "\n".join(
                f"    - secretKey: {f}\n      remoteRef: {{ key: {bw} }}"
                for f, bw in sorted(fields.items())
            )
            docs.append(
                f"""apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: human-{name.replace("_", "-")}
  namespace: {ns}
spec:
  refreshInterval: 1m
  secretStoreRef: {{ kind: ClusterSecretStore, name: human-vault }}
  target: {{ name: human-{name.replace("_", "-")}, creationPolicy: Owner }}
  data:
{rows}"""
            )
    return "\n---\n".join(docs) + "\n"


def console_lanes(vendors: dict) -> set:
    """Model groups served from litellm-db instead of from this file.

    They render nothing, so without this the check below would read a chain
    that names one as a chain naming no lane. The founder owns their keys in
    the LiteLLM console, and a lane he can delete cannot also be declared in
    a config the console treats as read-only (2026-09-04).
    """
    out = set()
    for v in vendors.values():
        out |= set((v.get("router") or {}).get("console_lanes") or [])
    return out


def render(vendors: dict, base_text: str, base_name: str) -> str:
    lines = []
    for line in base_text.splitlines():
        spec = FIELDS.get(line.strip())
        if spec:
            lines.append(blocks(vendors, spec[0], spec[1]))
        else:
            lines.append(line)
    return HEADER.format(base=base_name) + "\n".join(lines) + "\n"


def main() -> int:
    check = "--check" in sys.argv[1:]
    try:
        vendors = yaml.safe_load(REG.read_text())["vendors"]
    except Exception as e:  # a broken registry is blindness, not drift
        print(f"BLIND   vendor-render   {REG}: {e}")
        return 2
    rc = 0
    bridge_text = BRIDGE_HEADER + bridge(vendors)
    bridge_out = ROOT / BRIDGE
    if check:
        if not bridge_out.is_file() or bridge_out.read_text() != bridge_text:
            print(
                f"FAIL    vendor-render   {BRIDGE} does not match a render from the registry; run bin/idp-vendor-render"
            )
            rc = 1
        else:
            print(f"ok      vendor-render   {BRIDGE} matches the registry")
    else:
        bridge_out.parent.mkdir(parents=True, exist_ok=True)
        bridge_out.write_text(bridge_text)
        n = bridge_text.count("kind: ExternalSecret")
        print(f"ok      vendor-render   wrote {BRIDGE} ({n} ExternalSecrets)")

    seed_text = SEED_HEADER + seed(vendors)
    seed_out = ROOT / SEED
    if check:
        if not seed_out.is_file() or seed_out.read_text() != seed_text:
            print(
                f"FAIL    vendor-render   {SEED} does not match a render from the registry; run bin/idp-vendor-render"
            )
            rc = 1
        else:
            print(f"ok      vendor-render   {SEED} matches the registry")
    else:
        seed_out.parent.mkdir(parents=True, exist_ok=True)
        seed_out.write_text(seed_text)
        n = seed_text.count("kind: PushSecret")
        print(f"ok      vendor-render   wrote {SEED} ({n} PushSecrets)")

    for out_rel, base_rel in TARGETS:
        base = ROOT / base_rel
        if not base.is_file():
            print(f"BLIND   vendor-render   no {base_rel}")
            return 2
        text = render(vendors, base.read_text(), base_rel)
        try:
            parsed = yaml.safe_load(text)
            lanes = {m["model_name"] for m in parsed["model_list"]} | console_lanes(vendors)
            for entry in parsed["router_settings"]["fallbacks"]:
                for src, chain in entry.items():
                    missing = ({src} | set(chain)) - lanes
                    if missing:
                        print(
                            f"FAIL    vendor-render   {out_rel}: fallback names no lane serves: {sorted(missing)}"
                        )
                        return 2
        except Exception as e:
            print(f"FAIL    vendor-render   {out_rel} would not parse: {e}")
            return 2
        out = ROOT / out_rel
        if check:
            if not out.is_file() or out.read_text() != text:
                print(
                    f"FAIL    vendor-render   {out_rel} does not match a render from the registry; run bin/idp-vendor-render"
                )
                rc = 1
            else:
                print(f"ok      vendor-render   {out_rel} matches the registry")
        else:
            out.write_text(text)
            print(
                f"ok      vendor-render   wrote {out_rel} ({len(text.splitlines())} lines)"
            )
    return rc


if __name__ == "__main__":
    sys.exit(main())
