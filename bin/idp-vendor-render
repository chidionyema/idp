#!/usr/bin/env python3
"""Render the two LiteLLM router configs from the vendor registry.

One vendor, one place (founder 2026-09-02, the groq removal): platform/vendors/consoles.yaml
is the only file that names a model vendor. Each vendor's `router:` block carries its lanes
and fallback chains; this tool splices them into llm/config.base.yaml and
platform/llm/config.base.yaml and writes llm/config.yaml and platform/llm/config.yaml.
Adding or removing a vendor is one registry edit plus one run of this tool.

This tool used to render the human-vault bridge too (one ExternalSecret and one PushSecret
per vendor target) into two committed files. It does not any more: platform/vendors is a
Helm chart whose templates read consoles.yaml at its own root, and Flux renders the bridge
in the cluster (platform/human-vault-bridge/helmrelease.yaml, 2026-09-22). A derived file
that is never committed cannot go stale, which is what happened on 36a0a0e09 and what the
deleted `generated` CI job was paid to notice five minutes too late.

Registry shape, per vendor, all fields optional:
    router:
      lanes: |              # model_list entries both routers serve (comments ride along)
      cluster_lanes: |      # entries only the cluster serves (capability aliases)
      fallbacks: |          # fallback chains for the lanes above
      cluster_fallbacks: |  # chains only the cluster carries
      console_lanes: [name] # model groups served from litellm-db and owned by the founder in
                            # the LiteLLM console: nothing is rendered for them and no key is
                            # held in git, but a chain here may name one (2026-09-04 -- a model
                            # declared in this config is read-only in the console, so a lane
                            # whose key he rotates himself must not be declared here).
Block content is stored flush left; the marker's field decides the indent it gets back.

Deterministic: same inputs, same bytes, every run (the idempotency rule in AGENTS.md).
Exit 0 ok; 1 drift under --check; 2 a missing or malformed input.
"""

import pathlib
import re
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[1]
REG = ROOT / "platform/vendors/consoles.yaml"
RENEWALS = ROOT / "platform/vendors/renewals.yaml"
HEADER = (
    "# GENERATED by bin/idp-vendor-render -- vendor lanes and fallback chains come from\n"
    "# platform/vendors/consoles.yaml (`router:` blocks), everything else from {base}.\n"
    "# Edit those two, never this file; bin/idp-ci fails when this file and a fresh render differ.\n"
)
TARGETS = [
    ("llm/config.yaml", "llm/config.base.yaml"),
    ("platform/llm/config.yaml", "platform/llm/config.base.yaml"),
]
# marker line (stripped) -> (registry field, indent the block gets in the output)
FIELDS = {
    "# @vendor-lanes@": ("lanes", 2),
    "# @vendor-cluster-lanes@": ("cluster_lanes", 2),
    "# @vendor-fallbacks@": ("fallbacks", 4),
    "# @vendor-cluster-fallbacks@": ("cluster_fallbacks", 4),
}
KNOWN = {f for f, _ in FIELDS.values()} | {"console_lanes"}


def denied_providers() -> set:
    """The providers whose estate subscription is not renewed.

    The founder bound the governance to the provider (2026-10-29): a provider whose sessions
    keep breaking the estate's laws loses its lanes. A denial that only lives in a report is
    not a denial -- so the denial lives in platform/vendors/renewals.yaml, and the renderer
    reads it and drops the lanes. No renewal record means nothing is denied.
    """
    if not RENEWALS.is_file():
        return set()
    try:
        data = yaml.safe_load(RENEWALS.read_text()) or {}
    except Exception:  # a broken record denies nobody: the estate keeps serving
        return set()
    rows = data.get("renewals") or {}
    if not isinstance(rows, dict):
        return set()
    return {
        str(name)
        for name, body in rows.items()
        if isinstance(body, dict) and body.get("status") == "denied"
    }


def lane_names(vendor: dict) -> set:
    """The model groups one vendor serves, read from its lane blocks."""
    router = vendor.get("router") or {}
    names = set()
    for field in ("lanes", "cluster_lanes"):
        text = router.get(field) or ""
        names.update(re.findall(r"model_name:\s*([\w.\-]+)", text))
    return names


HOST_RE = re.compile(r"api_base:\s*https?://([^/\s]+)")
URL_HOST_RE = re.compile(r"https?://([^/\s\"]+)")
CRED_RE = re.compile(r"api_key:\s*os\.env(?:ironment)?/([A-Za-z0-9_]+)")
CRED_ANY_RE = re.compile(r"os\.env(?:ironment)?/([A-Za-z0-9_]+)")
ENTRY_RE = re.compile(r"^-\s*model_name:\s*([\w.\-]+)\s*$")


def spend_signals(vendor: dict) -> tuple:
    """The endpoints and the credential one vendor's lanes spend.

    A provider is not the registry block that happens to name it: the MiniMax account is
    spent by rows declared under other vendors' blocks too (the `default`, `fast` and
    `voice` pools carry a MiniMax row). So a denial has to be keyed on what is spent --
    the endpoint and the credential -- not on where the row was declared.
    """
    router = vendor.get("router") or {}
    text = "\n".join(router.get(f) or "" for f in ("lanes", "cluster_lanes"))
    return set(HOST_RE.findall(text)), set(CRED_RE.findall(text))


def strip_denied_rows(text: str, hosts: set, creds: set) -> str:
    """Drop every lane row that spends a denied provider, wherever it was declared.

    The rows are edited line by line: a dropped row takes its own lines and nothing else,
    so the comments that explain the block around it stay.
    """
    if not (hosts or creds):
        return text
    lines = text.split("\n")
    out = []
    i = 0
    while i < len(lines):
        if not ENTRY_RE.match(lines[i]):
            out.append(lines[i])
            i += 1
            continue
        j = i + 1
        while j < len(lines) and (lines[j][:1] in (" ", "\t") or lines[j] == ""):
            j += 1
        entry = "\n".join(lines[i:j])
        if (set(HOST_RE.findall(entry)) & hosts) or (set(CRED_RE.findall(entry)) & creds):
            i = j
            continue
        out.extend(lines[i:j])
        i = j
    return "\n".join(out)


def strip_denied_pass_through(text: str, hosts: set, creds: set) -> str:
    """Drop the pass-through endpoints that spend a denied provider.

    The image pass-through spends the MiniMax account directly (the key rides in a
    header, not in a lane), so a denial that left it in place would still pay the
    provider it just refused to renew.
    """
    if not (hosts or creds):
        return text
    lines = text.split("\n")
    out = []
    i = 0
    while i < len(lines):
        m = re.match(r"^(\s*)pass_through_endpoints:\s*$", lines[i])
        if not m:
            out.append(lines[i])
            i += 1
            continue
        key_indent = len(m.group(1))
        j = i + 1
        while j < len(lines) and lines[j].startswith(" ") and (
            len(lines[j]) - len(lines[j].lstrip()) > key_indent
        ):
            j += 1
        block = lines[i + 1 : j]
        kept = []
        k = 0
        while k < len(block):
            em = re.match(r"^(\s*)-\s*path:", block[k])
            if not em:
                kept.append(block[k])
                k += 1
                continue
            entry_indent = len(em.group(1))
            e = k + 1
            while e < len(block) and block[e].startswith(" ") and (
                len(block[e]) - len(block[e].lstrip()) > entry_indent
            ):
                e += 1
            entry = "\n".join(block[k:e])
            if (set(URL_HOST_RE.findall(entry)) & hosts) or (
                set(CRED_ANY_RE.findall(entry)) & creds
            ):
                k = e
                continue
            kept.extend(block[k:e])
            k = e
        if kept:
            out.append(lines[i])
            out.extend(kept)
        i = j
    return "\n".join(out)


class Denial:
    """What a denied provider costs the estate, and what a denial must remove.

    Three things, and all three are spend: the provider's own lanes, the rows anywhere
    that spend its endpoint or its credential, and the groups that then serve nothing.
    """

    def __init__(self, vendors: dict):
        self.providers = denied_providers()
        self.hosts: set = set()
        self.creds: set = set()
        self.groups: set = set()
        self.rows: dict = {}
        for name, v in vendors.items():
            if name not in self.providers:
                continue
            self.groups |= lane_names(v)
            hosts, creds = spend_signals(v)
            self.hosts |= hosts
            self.creds |= creds
        before: dict = {}
        after: dict = {}
        for name, v in vendors.items():
            if name in self.providers:
                continue
            router = v.get("router") or {}
            for field in ("lanes", "cluster_lanes"):
                text = router.get(field) or ""
                if not text:
                    continue
                stripped = strip_denied_rows(text, self.hosts, self.creds)
                self.rows[(name, field)] = stripped
                for group in re.findall(r"- model_name:\s*([\w.\-]+)", text):
                    before[group] = before.get(group, 0) + 1
                for group in re.findall(r"- model_name:\s*([\w.\-]+)", stripped):
                    after[group] = after.get(group, 0) + 1
        for group, count in before.items():
            if after.get(group, 0) == 0:
                self.groups.add(group)


def filter_chain(text: str, denied_lanes: set) -> str:
    """Strip denied lanes out of the fallback chains, and drop the chains left empty.

    The comments in the chain blocks are the estate's record of WHY a chain is shaped the way
    it is, so the text is edited line by line rather than re-serialised.
    """
    out = []
    for line in text.split("\n"):
        m = re.match(r"^(\s*)- ([\w.\-]+):\s*\[([^\]]*)\]\s*$", line)
        if m:
            src = m.group(2)
            items = [i.strip() for i in m.group(3).split(",") if i.strip()]
            if src in denied_lanes:
                continue
            kept = [i for i in items if i not in denied_lanes]
            if not kept:
                continue
            line = f"{m.group(1)}- {src}: [{', '.join(kept)}]"
        out.append(line)
    return "\n".join(out)


def blocks(vendors: dict, field: str, indent: int, denial: Denial) -> str:
    denied = denial.providers
    denied_lanes = denial.groups
    out = []
    for name, v in vendors.items():
        if name in denied:
            continue
        router = v.get("router") or {}
        unknown = set(router) - KNOWN
        if unknown:
            raise SystemExit(
                f"BLIND   vendor-render   {name}: router field(s) {sorted(unknown)} unknown to the renderer"
            )
        txt = denial.rows.get((name, field), router.get(field))
        if txt:
            if field in ("fallbacks", "cluster_fallbacks"):
                txt = filter_chain(txt, denied_lanes)
            pad = " " * indent
            out.append(
                "\n".join(
                    pad + ln if ln.strip() else ""
                    for ln in txt.rstrip("\n").split("\n")
                )
            )
    return "\n\n".join(out)


def console_lanes(vendors: dict) -> set:
    """Model groups served from litellm-db instead of from this file.

    They render nothing, so without this the check below would read a chain
    that names one as a chain naming no lane. The founder owns their keys in
    the LiteLLM console, and a lane he can delete cannot also be declared in
    a config the console treats as read-only (2026-09-04).
    """
    out = set()
    denied = denied_providers()
    for name, v in vendors.items():
        if name in denied:
            continue
        out |= set((v.get("router") or {}).get("console_lanes") or [])
    return out


def render(vendors: dict, base_text: str, base_name: str) -> str:
    denial = Denial(vendors)
    lines = []
    for line in base_text.splitlines():
        spec = FIELDS.get(line.strip())
        if spec:
            lines.append(blocks(vendors, spec[0], spec[1], denial))
        else:
            lines.append(line)
    text = HEADER.format(base=base_name) + "\n".join(lines) + "\n"
    return strip_denied_pass_through(text, denial.hosts, denial.creds)


def main() -> int:
    check = "--check" in sys.argv[1:]
    try:
        vendors = yaml.safe_load(REG.read_text())["vendors"]
    except Exception as e:  # a broken registry is blindness, not drift
        print(f"BLIND   vendor-render   {REG}: {e}")
        return 2
    rc = 0
    for out_rel, base_rel in TARGETS:
        base = ROOT / base_rel
        if not base.is_file():
            print(f"BLIND   vendor-render   no {base_rel}")
            return 2
        text = render(vendors, base.read_text(), base_rel)
        try:
            parsed = yaml.safe_load(text)
            lanes = {m["model_name"] for m in parsed["model_list"]} | console_lanes(vendors)
            for entry in parsed["router_settings"]["fallbacks"]:
                for src, chain in entry.items():
                    missing = ({src} | set(chain)) - lanes
                    if missing:
                        print(
                            f"FAIL    vendor-render   {out_rel}: fallback names no lane serves: {sorted(missing)}"
                        )
                        return 2
        except Exception as e:
            print(f"FAIL    vendor-render   {out_rel} would not parse: {e}")
            return 2
        out = ROOT / out_rel
        if check:
            if not out.is_file() or out.read_text() != text:
                print(
                    f"FAIL    vendor-render   {out_rel} does not match a render from the registry; run bin/idp-vendor-render"
                )
                rc = 1
            else:
                print(f"ok      vendor-render   {out_rel} matches the registry")
        else:
            out.write_text(text)
            print(
                f"ok      vendor-render   wrote {out_rel} ({len(text.splitlines())} lines)"
            )
    return rc


if __name__ == "__main__":
    sys.exit(main())
