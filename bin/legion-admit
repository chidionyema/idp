#!/usr/bin/env python3
"""Admit a Legion mission before any model runs: its scope, then provider capacity.

Trusted, pre-inference stage of agent-sandbox.yml (idp#8283). Every bound the
submit lane enforces used to be discovered only after the model had been paid
for: a 429 from every provider (#7838), seven files against a five-file limit
(#8061), a patch to .github/ (#8165). This door moves both decisions in front
of inference and reuses the submit lane's own predicate, so admission and
delivery cannot classify a change differently.

  scope     the mission names its exact files on a `Scope:` line (or a CLAIM-style
            `paths=` token). They are validated by idp-agent-base-apply.admit(), the
            same Proof 2 boundary the submit lane applies, at the exact commit the
            agent will start from. No scope, or an inadmissible one: REFUSED, exit 2.
  capacity  paid or cost-unverified legacy vendor routes are refused without any
            network call. Only catalogue-free zero-price auto routes can be probed;
            that classification alone is not provider-side billing certification.

Writes into --out: scope.json (the exact bytes the submit lane verifies),
scope.sha256, contract.txt (appended to the agent's task) and admission.json.
Never prints a credential or the provider's response body.
"""

from __future__ import annotations

import argparse
import calendar
import hashlib
import importlib.util
import json
import math
import os
import re
import subprocess
import sys
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path
from urllib.parse import urlsplit

sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
EXIT_SCOPE = 2
EXIT_CAPACITY = 75
PROBE_TIMEOUT_S = float(os.environ.get("LEGION_PROBE_TIMEOUT_S", "15"))

# Provider lanes, OpenAI-compatible, as the estate already calls them
# (platform/llm/pennyd/providers/gemini.toml, platform/llm/config.local.yaml).
LANES = {
    "google": (
        "LEGION_GOOGLE_BASE",
        "https://generativelanguage.googleapis.com/v1beta/openai",
        "GEMINI_API_KEY",
    ),
    "minimax": ("LEGION_MINIMAX_BASE", "https://api.minimax.io/v1", "MINIMAX_API_KEY"),
}

SCOPE_LINE = re.compile(r"^\s*\**scope\**\s*:\s*\**\s*(.+?)\s*$", re.I | re.M)
PATHS_TOKEN = re.compile(r"(?<![\w-])paths=(\S+)")


def _applicator():
    spec = importlib.util.spec_from_file_location(
        "idp_agent_base_apply", HERE / "idp-agent-base-apply.py"
    )
    mod = importlib.util.module_from_spec(spec)
    sys.path.insert(0, str(HERE))
    spec.loader.exec_module(mod)
    return mod


def declared_scope(mission: str) -> list[str]:
    """The exact files a mission declares. One declaration only: two is ambiguous."""
    found = [m.group(1) for m in SCOPE_LINE.finditer(mission)]
    found += [m.group(1) for m in PATHS_TOKEN.finditer(mission)]
    if not found:
        raise ValueError(
            "REFUSED: SCOPE_UNDECLARED: the mission names no `Scope:` line; "
            "an unscoped run is refused before inference"
        )
    if len(set(found)) > 1:
        raise ValueError(
            "REFUSED: SCOPE_AMBIGUOUS: the mission declares more than one scope"
        )
    paths = [
        p.strip().strip("`'\"") for p in re.split(r"[,\s]+", found[0]) if p.strip()
    ]
    if not paths:
        raise ValueError("REFUSED: SCOPE_UNDECLARED: the scope line is empty")
    if any(c in p for p in paths for c in "*?[]{}"):
        raise ValueError("REFUSED: SCOPE_NOT_EXACT: scope names exact files, not globs")
    return paths


def refuse_new_python(paths: list[str]) -> None:
    """bin/language-gate refuses a new Python file without a Language-Exception trailer, and the
    submit lane writes the commit message, not the agent: such a scope can never land. Say so
    before inference (#7516/#8194 class: refused at the commit hook after the model ran)."""
    new_py = [
        p
        for p in paths
        if p.endswith(".py")
        and not p.startswith("tests/")
        and subprocess.run(
            ["git", "cat-file", "-e", f"HEAD:{p}"], capture_output=True
        ).returncode
    ]
    if new_py:
        raise ValueError(
            "REFUSED: LANGUAGE_GATE: new Python file(s) in scope cannot land through the submit "
            "lane (bin/language-gate): " + ", ".join(new_py[:5])
        )


def admit_scope(mission: str) -> tuple[bytes, dict]:
    app = _applicator()
    paths = declared_scope(mission)
    envelope = app.admit(paths)  # raises ValueError on any refusal
    refuse_new_python(paths)
    raw = json.dumps(envelope, sort_keys=True, separators=(",", ":")).encode()
    return raw, envelope


def contract(envelope: dict, limit: int) -> str:
    files = "\n".join(f"  - {p}" for p in envelope["paths"])
    return (
        "\n\nLEGION ADMISSION (trusted, enforced at submit):\n"
        f"You may change ONLY these files, at most {limit} of them, nothing under .github/ or .githooks/:\n"
        f"{files}\n"
        "A NEW file must not be Python (bin/language-gate refuses it at commit); tests/ excepted.\n"
        "Any other change makes the whole patch refused. Base commit: "
        f"{envelope['base']}\n"
    )


def probe(lane: str, model: str) -> dict:
    env_base, default_base, key_env = LANES[lane]
    key = os.environ.get(key_env, "")
    if not key:
        return {"lane": lane, "model": model, "verdict": "no-key"}
    base = os.environ.get(env_base, default_base).rstrip("/")
    # Legacy Gemini/MiniMax probes can consume paid API tokens. Without an existing
    # independently authenticated no-charge entitlement, they cannot run remotely.
    # Loopback is retained solely for the real local HTTP falsifier in this suite.
    if urlsplit(base).hostname not in {"localhost", "127.0.0.1", "::1"}:
        return {"lane": lane, "model": model, "verdict": "cost-unverified"}
    body = json.dumps(
        {
            "model": model,
            "messages": [{"role": "user", "content": "ping"}],
            "max_tokens": 1,
        }
    ).encode()
    req = urllib.request.Request(
        f"{base}/chat/completions",
        data=body,
        headers={"Authorization": f"Bearer {key}", "Content-Type": "application/json"},
        method="POST",
    )
    t0 = time.monotonic()
    try:
        with urllib.request.urlopen(req, timeout=PROBE_TIMEOUT_S) as resp:  # noqa: S310 - fixed https lanes
            status = resp.status
    except urllib.error.HTTPError as exc:
        status = exc.code
    except (urllib.error.URLError, TimeoutError, OSError):
        status = 0
    ms = int((time.monotonic() - t0) * 1000)
    verdict = {
        200: "capacity",
        429: "rate-limited",
        401: "authentication",
        403: "authentication",
        404: "model-unavailable",
        0: "transport",
    }.get(
        status,
        "capacity"
        if 200 <= status < 300
        else ("unavailable" if status >= 500 else f"http-{status}"),
    )
    return {
        "lane": lane,
        "model": model,
        "status": status,
        "ms": ms,
        "verdict": verdict,
    }


def chain(harness: str, model: str, failover: bool) -> list[tuple[str, str]]:
    if harness == "gemini":
        lanes = [("google", model or "gemini-3.5-flash")]
        if failover:
            lanes.append(("minimax", "MiniMax-M2.7"))
        return lanes
    if harness == "pi":
        return [("minimax", model or "MiniMax-M2.7")]
    return []  # claude-code proves its own provider live before running (bin/claude-anthropic)


# Registry data, not the worker, selects provider and model.
# Only OpenAI-compatible bearer routes are admitted by this adapter.
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def zero_catalogue_cost(route: dict) -> bool:
    """Necessary zero-price boundary, not proof of the account's remaining free quota."""
    return (
        isinstance(route, dict)
        and route.get("class") == "free"
        and type(route.get("price_in")) in (int, float)
        and type(route.get("price_out")) in (int, float)
        and route["price_in"] == 0
        and route["price_out"] == 0
    )


def auto_candidates(directory: Path, env: dict) -> list[dict]:
    # LEGION_PAID_PROVIDERS cannot grant new expenditure, even when set on a
    # historic workflow/environment. A new paid lane requires separate authority.
    disabled = set(env.get("LEGION_DISABLED_PROVIDERS", "").split(",")) - {""}
    routes = []
    for path in sorted(directory.glob("*.toml")):
        spec = tomllib.loads(path.read_text())
        provider = spec["id"]
        if provider != path.stem:
            raise ValueError("provider registry identity mismatch")
        if provider in disabled or spec["dialect"] != "openai":
            continue
        auth = spec["auth"]
        key = auth.get("key_env", "")
        path_suffix = spec["request_path"]
        base = spec["base_url"].rstrip("/") + path_suffix.removesuffix(
            "/chat/completions"
        )
        url = urlsplit(base)
        if (
            auth["kind"] != "bearer"
            or not re.fullmatch(r"[A-Z][A-Z0-9_]*_API_KEY", key)
            or not env.get(key)
            or url.scheme != "https"
            or not url.hostname
            or url.username
            or url.password
            or url.query
            or url.fragment
            or not path_suffix.endswith("/chat/completions")
            or not path_suffix.startswith("/")
        ):
            continue
        for model in spec["models"]:
            cls = model["class"]
            if cls != "free":
                continue
            context = model["context_window"]
            cost_in = model["price_in_per_mtok"]
            cost_out = model["price_out_per_mtok"]
            if (
                context < 65536
                or not all(math.isfinite(v) and v >= 0 for v in (cost_in, cost_out))
                or (cls == "free" and (cost_in or cost_out))
            ):
                continue
            routes.append(
                {
                    "provider": provider,
                    "model": model["id"],
                    "base": base,
                    "key_env": key,
                    "context": context,
                    "class": cls,
                    "price_in": cost_in,
                    "price_out": cost_out,
                    "probe_tokens": max(256, model.get("min_output_tokens", 0)),
                }
            )
    return sorted(
        routes,
        key=lambda r: (
            r["class"] != "free",
            r["price_in"] + r["price_out"],
            r["provider"],
            r["model"],
        ),
    )


def auto_probe(route: dict, env: dict) -> dict:
    if not zero_catalogue_cost(route):
        return {"provider": route.get("provider", "UNKNOWN"),
                "model": route.get("model", "UNKNOWN"),
                "verdict": "cost-unverified"}
    payload = {
        "model": route["model"],
        "messages": [
            {"role": "user", "content": 'Call legion_ready with {"ready":true}.'}
        ],
        "tools": [
            {
                "type": "function",
                "function": {
                    "name": "legion_ready",
                    "description": "Readiness proof",
                    "parameters": {
                        "type": "object",
                        "properties": {"ready": {"type": "boolean"}},
                        "required": ["ready"],
                    },
                },
            }
        ],
        "tool_choice": "required",
        "max_tokens": route["probe_tokens"],
    }
    req = urllib.request.Request(
        route["base"] + "/chat/completions",
        data=json.dumps(payload).encode(),
        headers={
            "Authorization": "Bearer " + env[route["key_env"]],
            "Content-Type": "application/json",
        },
        method="POST",
    )
    verdict = "transport"
    try:
        with urllib.request.build_opener(NoRedirect()).open(
            req, timeout=PROBE_TIMEOUT_S
        ) as resp:
            reply = json.loads(resp.read(1024 * 1024))
        matching = reply.get("model") == route["model"]
        calls = reply["choices"][0]["message"].get("tool_calls", [])
        valid = any(
            c["function"]["name"] == "legion_ready"
            and json.loads(c["function"]["arguments"]) == {"ready": True}
            for c in calls
        )
        verdict = "capacity" if matching and valid else "tool-or-model-unverified"
    except urllib.error.HTTPError as exc:
        verdict = {
            401: "authentication",
            403: "authentication",
            402: "funding",
            429: "rate-limited",
        }.get(exc.code, f"http-{exc.code}")
    except (ValueError, TypeError, KeyError, IndexError, AttributeError):
        verdict = "invalid-response"
    except (urllib.error.URLError, TimeoutError, OSError):
        pass
    return {
        "provider": route["provider"],
        "model": route["model"],
        "verdict": verdict,
    }


# An exhausted account is not retried unchanged on the next run (founder, 2026-11-19 21:46,
# #8283: "persist provider 429/cooldown across runs; do not retry an unchanged exhausted
# account"). Seconds a provider stays cooling after each verdict; the workflow carries the
# file between runs in the Actions cache.
COOLDOWN_S = {"rate-limited": 3600, "funding": 86400, "authentication": 86400}


# The launch settings every admitted auto route runs under (auto_launch). Fitness is only
# evidence for the configuration that was measured, so the gate compares against these.
LAUNCH_CONTEXT_CAP = 32768
LAUNCH_MAX_TOKENS = 4096


def fitness_filter(routes: list[dict], ledger: Path | None, now: float) -> tuple[list[dict], list[dict]]:
    """Admit only routes with a fresh FIT verdict from bin/lane-fitness (idp#3525 UX-02).

    Founder, 2026-11-27: "we should never have a dead lane, we should know well ahead of time at
    the point of admission". A probe that answers proves the lane is reachable, not that it can do
    a mission: MEASURED 2026-11-27, openrouter nemotron-3.5-lightning:free passed every capacity
    probe and failed every real mission with an empty patch. Unknown is refused, never assumed:
    no ledger, no record, an expired record, or a record measured under other launch settings.
    """
    kept, refused = [], []
    for r in routes:
        rec = None
        if ledger is not None:
            for f in sorted(ledger.glob("*.json")) if ledger.is_dir() else []:
                try:
                    d = json.loads(f.read_text())
                except (OSError, ValueError):
                    continue
                if (
                    d.get("schema") == "estate.lane-fitness.v1"
                    and d.get("provider") == r["provider"]
                    and d.get("model") == r["model"]
                ):
                    rec = d
                    break
        why = None
        if rec is None:
            why = "no-fitness-record"
        elif rec.get("context_window") != min(r["context"], LAUNCH_CONTEXT_CAP) or rec.get(
            "max_tokens"
        ) != LAUNCH_MAX_TOKENS:
            why = "measured-under-other-settings"
        else:
            try:
                expires = calendar.timegm(time.strptime(rec["expires_at"], "%Y-%m-%dT%H:%M:%SZ"))
            except (KeyError, TypeError, ValueError):
                expires = 0
            if expires <= now:
                why = "fitness-expired"
            elif rec.get("verdict") != "FIT":
                why = f"unfit:{rec.get('reason', 'unknown')}"
        if why is None:
            kept.append(r)
        else:
            refused.append({"provider": r["provider"], "model": r["model"], "verdict": why})
    return kept, refused


def load_cooldown(path: Path | None, now: float) -> dict:
    """{provider: until_epoch} still in force; an unreadable file is an empty one."""
    if not path or not path.is_file():
        return {}
    try:
        data = json.loads(path.read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {
        str(k): float(v)
        for k, v in data.items()
        if isinstance(v, (int, float)) and float(v) > now
    }


def save_cooldown(path: Path | None, cooldown: dict, now: float) -> None:
    if not path:
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    live = {k: v for k, v in sorted(cooldown.items()) if v > now}
    path.write_text(json.dumps(live, sort_keys=True))


def auto_select(
    routes: list[dict],
    env: dict,
    probe_fn=auto_probe,
    cooldown: dict | None = None,
    now: float | None = None,
) -> tuple[dict | None, list[dict]]:
    """First route that proves capacity; providers still cooling are not probed at all.

    `cooldown` is updated in place: a provider that answers rate-limited, funding or
    authentication cools for COOLDOWN_S[verdict] seconds from `now`."""
    observations = []
    unavailable = set()
    cooldown = {} if cooldown is None else cooldown
    now = time.time() if now is None else now
    for route in routes:
        # Defence in depth: reject injected or stale paid admission records
        # before invoking even an injected probe callback.
        if not zero_catalogue_cost(route):
            observations.append({"provider": route.get("provider", "UNKNOWN"),
                                 "model": route.get("model", "UNKNOWN"),
                                 "verdict": "cost-unverified"})
            continue
        provider = route["provider"]
        if provider in unavailable:
            continue
        if cooldown.get(provider, 0) > now:
            unavailable.add(provider)
            observations.append(
                {
                    "provider": provider,
                    "model": route["model"],
                    "verdict": "cooling",
                    "until": int(cooldown[provider]),
                }
            )
            continue
        result = probe_fn(route, env)
        observations.append(result)
        if result["verdict"] == "capacity":
            cooldown.pop(provider, None)
            return route, observations
        if result["verdict"] in COOLDOWN_S:
            cooldown[provider] = now + COOLDOWN_S[result["verdict"]]
        if result["verdict"] in {
            "authentication",
            "funding",
            "rate-limited",
            "transport",
        }:
            unavailable.add(provider)
    return None, observations


def verify_agent_scope(paths: list[str]) -> None:
    """Refuse runaway model edits before downstream sealing and CI.

    Admission constrains the intended paths; this checks the *actual* working
    tree, including untracked files, before the workflow runs git add -A.
    The independent trusted submit stage repeats the boundary check.
    """
    allowed = set(paths)
    if not allowed:
        raise ValueError("REFUSED: AGENT_SCOPE_EMPTY")
    changed = set()
    for argv in (
        ("git", "diff", "--name-only", "--no-renames", "-z", "HEAD"),
        ("git", "ls-files", "--others", "--exclude-standard", "-z"),
    ):
        result = subprocess.run(argv, check=True, capture_output=True)
        changed.update(
            name.decode("utf-8", errors="surrogateescape")
            for name in result.stdout.split(b"\0")
            if name
        )
    if not changed:
        raise ValueError("REFUSED: AGENT_EMPTY_PATCH")
    outside = changed - allowed
    if outside:
        raise ValueError(
            f"REFUSED: AGENT_SCOPE_ESCAPE: {len(outside)} file(s) outside admitted scope"
        )


# One fixed token per launch refusal. The launcher's stdout is shared with an untrusted
# worker, so only these tokens are printed, never an exception's own text.
LAUNCH_REFUSALS = (
    ("REFUSED: AGENT_EMPTY_PATCH", "AGENT_EMPTY_PATCH"),
    ("REFUSED: AGENT_SCOPE_ESCAPE", "AGENT_SCOPE_ESCAPE"),
    ("REFUSED: AGENT_SCOPE_EMPTY", "AGENT_SCOPE_EMPTY"),
    ("COST_UNVERIFIED", "COST_UNVERIFIED"),
    ("provider admission base mismatch", "ADMISSION_BASE_MISMATCH"),
    ("provider admission mismatch", "ADMISSION_MISMATCH"),
    ("provider not admitted", "PROVIDER_NOT_ADMITTED"),
    ("provider registry identity mismatch", "REGISTRY_IDENTITY_MISMATCH"),
)


def launch_refusal_class(exc: BaseException) -> str:
    """The class of a launch refusal: a fixed token, UNCLASSIFIED_<type> when unknown."""
    if isinstance(exc, ValueError) and not isinstance(exc, json.JSONDecodeError):
        text = str(exc)
        for prefix, token in LAUNCH_REFUSALS:
            if text.startswith(prefix):
                return token
    return "UNCLASSIFIED_" + type(exc).__name__.upper()


def auto_launch(
    directory: Path, record: dict, task: str, session_dir: Path, env: dict
) -> int:
    selected = record.get("route")
    # A prior admission is not spend authority. Recheck at actual egress.
    if not zero_catalogue_cost(selected):
        raise ValueError("COST_UNVERIFIED: paid or unknown model route")
    env = dict(env)
    env[env.get("ADMITTED_KEY_ENV", "")] = env.get("LEGION_SELECTED_KEY", "")
    if record.get("decision") != "ADMITTED" or selected not in auto_candidates(
        directory, env
    ):
        raise ValueError("provider not admitted")
    if selected["provider"] != env.get("ADMITTED_PROVIDER") or selected[
        "model"
    ] != env.get("ADMITTED_MODEL"):
        raise ValueError("provider admission mismatch")
    if (
        record.get("base")
        != subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip()
    ):
        raise ValueError("provider admission base mismatch")
    # Only the selected credential reaches the untrusted harness.
    child = {
        k: v
        for k, v in env.items()
        if k
        in {
            "PATH",
            "HOME",
            "USER",
            "LOGNAME",
            "LANG",
            "LC_ALL",
            "TERM",
            "TMPDIR",
            "RUNNER_TEMP",
        }
    }
    child["LEGION_SELECTED_KEY"] = env[selected["key_env"]]
    config = Path(child["RUNNER_TEMP"]) / "legion-pi"
    config.mkdir(mode=0o700, exist_ok=False)
    child["PI_CODING_AGENT_DIR"] = str(config)
    (config / "models.json").write_text(
        json.dumps(
            {
                "providers": {
                    "estate-admitted": {
                        "baseUrl": selected["base"],
                        "api": "openai-completions",
                        "apiKey": "$LEGION_SELECTED_KEY",
                        "models": [
                            {
                                "id": selected["model"],
                                "name": selected["model"],
                                "contextWindow": min(selected["context"], LAUNCH_CONTEXT_CAP),
                                "maxTokens": LAUNCH_MAX_TOKENS,
                                "input": ["text"],
                                "reasoning": False,
                            }
                        ],
                    }
                }
            }
        )
    )
    rc = subprocess.run(
        [
            "pi",
            "-p",
            "--provider",
            "estate-admitted",
            "--model",
            selected["model"],
            "--session-dir",
            str(session_dir),
            task,
        ],
        env=child,
        stdin=subprocess.DEVNULL,
        timeout=240,
        check=False,
    ).returncode
    if rc == 0:
        verify_agent_scope(record["paths"])
    return rc


def main() -> int:
    ap = argparse.ArgumentParser(prog="legion-admit")
    ap.add_argument(
        "--mission-env", default="TASK", help="env var holding the mission text"
    )
    ap.add_argument("--harness", default=os.environ.get("HARNESS", "gemini"))
    ap.add_argument("--model", default=os.environ.get("MODEL", ""))
    ap.add_argument("--failover", default=os.environ.get("LEGION_FAILOVER", "0"))
    ap.add_argument("--out", type=Path, required=True)
    ap.add_argument("--launch-admitted", type=Path)
    ap.add_argument(
        "--fitness-dir",
        type=Path,
        default=Path(os.environ["LEGION_FITNESS_DIR"]) if os.environ.get("LEGION_FITNESS_DIR") else None,
        help="bin/lane-fitness ledger; an auto route without a fresh FIT record is refused",
    )
    ap.add_argument("--session-dir", type=Path)
    ap.add_argument(
        "--skip-capacity", action="store_true", help="scope only (tests, dry admission)"
    )
    ap.add_argument(
        "--cooldown-file",
        type=Path,
        default=Path(os.environ["LEGION_COOLDOWN_FILE"])
        if os.environ.get("LEGION_COOLDOWN_FILE")
        else None,
        help="provider cooldown carried between runs ({provider: until_epoch})",
    )
    args = ap.parse_args()
    registry = HERE.parent / "platform/llm/pennyd/providers"
    if args.launch_admitted:
        if not args.session_dir:
            return EXIT_SCOPE
        try:
            return auto_launch(
                registry,
                json.loads(args.launch_admitted.read_text()),
                os.environ.get(args.mission_env, ""),
                args.session_dir,
                dict(os.environ),
            )
        except (ValueError, OSError, KeyError, TypeError) as exc:
            print(f"REFUSED: {launch_refusal_class(exc)}")
            return EXIT_SCOPE
    args.out.mkdir(parents=True, exist_ok=True)
    record: dict = {"harness": args.harness}
    try:
        raw, envelope = admit_scope(os.environ.get(args.mission_env, ""))
    except (ValueError, OSError) as exc:
        record["decision"] = "REFUSED_SCOPE"
        record["reason"] = str(exc)[:400]
        (args.out / "admission.json").write_text(json.dumps(record, sort_keys=True))
        print(f"::error::{record['reason']}")
        return EXIT_SCOPE
    digest = hashlib.sha256(raw).hexdigest()
    (args.out / "scope.json").write_bytes(raw)
    (args.out / "scope.sha256").write_text(digest + "\n")
    import verify_three_proofs  # on sys.path via _applicator(); the one source of the limit

    (args.out / "contract.txt").write_text(
        contract(envelope, verify_three_proofs.MAX_FILES_PER_CHANGE)
    )
    record.update(
        {"scope_sha256": digest, "paths": envelope["paths"], "base": envelope["base"]}
    )

    probes = []
    if args.harness == "auto" and not args.skip_capacity:
        now = time.time()
        cooldown = load_cooldown(args.cooldown_file, now)
        try:
            routes = auto_candidates(registry, dict(os.environ))
            routes, unfit = fitness_filter(routes, args.fitness_dir, now)
            chosen, probes = auto_select(
                routes, dict(os.environ), cooldown=cooldown, now=now
            )
        except (ValueError, OSError, KeyError, TypeError):
            chosen, probes, unfit = None, [], []
        save_cooldown(args.cooldown_file, cooldown, now)
        record["probes"] = probes
        record["fitness"] = unfit
        if chosen is None and unfit and not probes:
            record["decision"] = "REFUSED_UNFIT"
            (args.out / "admission.json").write_text(json.dumps(record, sort_keys=True))
            summary = ", ".join(f"{u['provider']}/{u['model']}={u['verdict']}" for u in unfit)
            print(f"::error::REFUSED: NO_FIT_LANE before inference: {summary}")
            return EXIT_CAPACITY
        if chosen is None:
            record["decision"] = "REFUSED_CAPACITY"
            (args.out / "admission.json").write_text(json.dumps(record, sort_keys=True))
            print("::error::REFUSED: NO_ELIGIBLE_TOOL_CAPABLE_WORKER before inference")
            return EXIT_CAPACITY
        record.update(provider=chosen["provider"], model=chosen["model"], route=chosen)
    elif not args.skip_capacity:
        for lane, model in chain(args.harness, args.model, args.failover == "1"):
            p = probe(lane, model)
            probes.append(p)
            if p["verdict"] == "capacity":
                record["provider"] = lane
                record["model"] = model
                break
        record["probes"] = probes
        if probes and "provider" not in record:
            record["decision"] = "REFUSED_CAPACITY"
            (args.out / "admission.json").write_text(json.dumps(record, sort_keys=True))
            summary = ", ".join(f"{p['lane']}={p['verdict']}" for p in probes)
            print(f"::error::REFUSED: CAPACITY_EXHAUSTED before inference: {summary}")
            return EXIT_CAPACITY
    record["decision"] = "ADMITTED"
    (args.out / "admission.json").write_text(json.dumps(record, sort_keys=True))
    line = f"ADMITTED scope={digest[:12]} files={len(envelope['paths'])}"
    if "provider" in record:
        line += f" provider={record['provider']}"
    print(line)
    gh_out = os.environ.get("GITHUB_OUTPUT")
    if gh_out:
        with open(gh_out, "a", encoding="utf-8") as fh:
            fh.write(f"scope_sha256={digest}\n")
            fh.write(f"scope_json={raw.decode()}\n")
            fh.write(f"provider={record.get('provider', '')}\n")
            fh.write(f"model={record.get('model', '')}\n")
            key_env = record.get("route", {}).get("key_env", "")
            fh.write(f"key_env={key_env}\n")
            fh.write(f"key_secret={'SEED_' + key_env if key_env else ''}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
