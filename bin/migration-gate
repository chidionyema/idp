#!/usr/bin/env bash
# migration-gate <script>: R22 mechanism 1 (crew#186 CP1). Three phases on a
# pristine temp environment. Any phase red fails the PR.
#   1 apply           healthcheck passes
#   2 apply again     exit 0 and the state is byte-identical (idempotent)
#   3 rollback        state equals the pre-migration snapshot (reversible)
# The script must speak the R19 verbs: can_apply apply healthcheck rollback state.
# Environment is isolated: DAGSTER_HOME, ledger and port are temp; launchd is off.
set -uo pipefail
script="${1:?usage: migration-gate <script>}"
tmp="$(mktemp -d)"
export DAGSTER_HOME="$tmp/home" MIGRATE_LEDGER="$tmp/migrations.jsonl" MIGRATE_LAUNCHD=0 SCHEDULER_PORT="${GATE_PORT:-3299}"
say() { printf '%s\n' "$*"; }
fail() { say "FAIL  migration $script: $*"; "$script" rollback >/dev/null 2>&1; rm -rf "$tmp"; exit 1; }

"$script" can_apply >/dev/null || fail "can_apply refused"
pre="$("$script" state)"
"$script" apply >/dev/null || fail "phase 1 apply exited non-zero"
"$script" healthcheck >/dev/null || fail "phase 1 healthcheck red"
s1="$("$script" state)"
"$script" apply >/dev/null || fail "phase 2 second apply exited non-zero"
s2="$("$script" state)"
[ "$s1" = "$s2" ] || fail "phase 2 second apply changed state: $s1 -> $s2"
"$script" rollback >/dev/null || fail "phase 3 rollback exited non-zero"
post="$("$script" state)"
# The config file the migration wrote stays on disk; everything live must match.
strip() { python3 -c "import json,sys; d=json.load(sys.stdin); d.pop('dagster_yaml_sha'); print(json.dumps(d, sort_keys=True))"; }
[ "$(printf '%s' "$pre" | strip)" = "$(printf '%s' "$post" | strip)" ] || fail "phase 3 rollback did not restore pre-state: $pre -> $post"
n=$(wc -l < "$MIGRATE_LEDGER" | tr -d ' ')
rm -rf "$tmp"
say "ok    migration $(basename "$script"): apply healthy, second apply identical, rollback restored pre-state, $n ledger rows"
