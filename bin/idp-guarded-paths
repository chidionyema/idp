#!/usr/bin/env bash
# Every path listed here requires a signed X-Idp-Auth trailer on the HEAD commit that touches it.
# bin/idp-ci-guarded-paths enforces this server-side; the local pre-push hook echoes the same set.
# The rule: policy files, hook infrastructure, and this list itself cannot be changed without a
# founder signature. Cryptographic guarantee, not memory.
#
# The founder's work surface is guarded too (founder 2026-09-29: "founders work surface broken is a
# security breach", "needs firewalled from agent carelessness", "need clearance to work on it"):
# the /fleet Reactor and home modules, their e2e tests, the fleetview-backend sidecar and its image,
# the catalogue's deploy manifests, and the regression gates that protect them, so a gate cannot be
# weakened in the same unsigned PR that breaks what it guards.
cat <<'PATHS'
platform/edge/otel-endpoint-exception.yaml
platform/edge/inject-otel-endpoint.yaml
platform/edge/require-otel-endpoint.yaml
platform/policies/kyverno/
.githooks/
bin/idp-auth
bin/idp-auth-verify
docs/keys/
bin/idp-guarded-paths
bin/idp-ci-guarded-paths
backstage/packages/app/src/modules/room/
backstage/packages/app/src/modules/home/
backstage/packages/app/e2e-tests/fleet
backstage/plugins/fleetview-backend/
fleetview-backend.Dockerfile
platform/backstage/
tests/test_fleetview_image_imports.py
tests/test_guarded_paths_fires.py
PATHS
