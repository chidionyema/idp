#!/usr/bin/env python3
"""The ticket state machine (crew#631 CP5). A ticket an agent calls done is not done: it is
RESOLVED_PENDING_VERIFICATION until the prover's verdict says so.

  bin/idp-ticket-verify [--apply] [--repo OWNER/crew] [--idp OWNER/idp] [--app-login LOGIN]

Rules, applied to every open ticket carrying one of the three labels:
  1. VERIFIED or REJECTED set by anyone but the prover App is reverted to
     RESOLVED_PENDING_VERIFICATION. Only the prover moves a ticket forward.
  2. VERIFIED with no PASS verdict younger than 24 h on the ticket's surface is reverted.
  3. RESOLVED_PENDING_VERIFICATION becomes VERIFIED on a fresh PASS verdict completed after the
     label was set, REJECTED on a FAIL completed after it, and waits otherwise.
The surface is the ticket's `Verify: <surface>` line (surfaces: the verdict-<surface>.yml
workflows in idp). A ticket with no such line is told once and left alone.
Without --apply nothing is changed; every ticket prints one line either way:
`ok|FAIL|BLIND  ticket-verify  #N <state> -> <state>: <why>`.
"""

import json
import os
import re
import subprocess
import sys
import tempfile
import time

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, IDP)
from probes import verdict as V  # noqa: E402

PENDING, VERIFIED, REJECTED = "RESOLVED_PENDING_VERIFICATION", "VERIFIED", "REJECTED"
LABELS = {
    PENDING: ("FBCA04", "an agent says done; the prover has not"),
    VERIFIED: ("0E8A16", "the prover's fresh PASS verdict says done"),
    REJECTED: ("B60205", "the prover's verdict says it is not done"),
}
FRESH_S = 24 * 3600  # a VERIFIED ticket needs a PASS younger than this
SURFACE_RE = re.compile(r"^\s*Verify:\s*([a-z0-9-]+)\s*$", re.M | re.I)
NO_SURFACE_MARK = "<!-- ticket-verify: no-surface -->"


def gh(*args, ok=(0,)):
    r = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=120)
    if r.returncode not in ok:
        raise RuntimeError(
            r.stderr.strip() or r.stdout.strip() or f"gh {' '.join(args)} failed"
        )
    return r.stdout


def epoch(s):
    return V._epoch(s)


# ---- the decision, pure: (issue, timeline events, verdict record or None, now, app_login) ----
def last_label_event(events, name):
    hit = [
        e
        for e in events
        if e.get("event") == "labeled" and (e.get("label") or {}).get("name") == name
    ]
    return hit[-1] if hit else None


def decide(labels, events, verdict, now, app_login):
    """Returns (new_state or None, why). new_state None means leave the ticket as it is."""
    state = next(
        (label for label in (VERIFIED, REJECTED, PENDING) if label in labels), None
    )
    if state is None:
        return None, "no verification label"
    setter = last_label_event(events, state)
    who = (setter or {}).get("actor", {}).get("login", "?")
    since = epoch(setter["created_at"]) if setter else 0
    if state in (VERIFIED, REJECTED) and who != app_login:
        return (
            PENDING,
            f"{state} was set by {who}, not the prover ({app_login}); reverted",
        )
    if verdict is None:
        if state == VERIFIED:
            return PENDING, "no verdict at all on this surface; reverted"
        return None, "no verdict yet on this surface; waiting"
    vstate, vwhy = V.grade(verdict, None, now=now)
    v_done = epoch(verdict["completed_at"])
    if state == VERIFIED:
        if vstate == "PASS" and now - v_done <= FRESH_S:
            return None, f"PASS verdict {int(now - v_done)}s old holds"
        return (
            PENDING,
            f"no PASS verdict younger than {FRESH_S}s ({vstate}: {vwhy}); reverted",
        )
    if state == REJECTED:
        return None, f"rejected by the prover: {vwhy}"
    # PENDING
    if v_done < since:
        return (
            None,
            f"newest verdict predates the label ({verdict['completed_at']}); waiting for the next prover run",
        )
    if vstate == "PASS":
        return (
            VERIFIED,
            f"PASS on {verdict['artifact_digest'][:24]} at {verdict['completed_at']} ({verdict['evidence_ref']})",
        )
    if vstate in ("FAIL", "BLOCKED", "ERROR"):
        return REJECTED, f"{vstate}: {vwhy} ({verdict['evidence_ref']})"
    return None, f"verdict {vstate}: {vwhy}; waiting"


# ---- GitHub side ----
def ensure_labels(repo, apply):
    have = set(
        json.loads(gh("api", f"repos/{repo}/labels?per_page=100", "--jq", "[.[].name]"))
    )
    for name, (color, desc) in LABELS.items():
        if name in have:
            continue
        if apply:
            gh(
                "api",
                f"repos/{repo}/labels",
                "-f",
                f"name={name}",
                "-f",
                f"color={color}",
                "-f",
                f"description={desc}",
            )
        print(
            f"ok      ticket-verify  label {name} {'created' if apply else 'missing (created with --apply)'}"
        )


def tickets(repo):
    out = gh("api", f"repos/{repo}/issues?state=open&labels={PENDING}&per_page=100")
    seen = {i["number"]: i for i in json.loads(out) if "pull_request" not in i}
    for label in (VERIFIED, REJECTED):
        for i in json.loads(
            gh("api", f"repos/{repo}/issues?state=open&labels={label}&per_page=100")
        ):
            if "pull_request" not in i:
                seen[i["number"]] = i
    return [seen[n] for n in sorted(seen)]


def timeline(repo, n):
    return json.loads(gh("api", f"repos/{repo}/issues/{n}/timeline?per_page=100"))


_verdicts = {}


def newest_verdict(idp, surface):
    if surface in _verdicts:
        return _verdicts[surface]
    out = gh(
        "api",
        f"repos/{idp}/actions/workflows/verdict-{surface}.yml/runs?branch=main&status=completed&per_page=1",
        "--jq",
        ".workflow_runs[0].id // empty",
    ).strip()
    v = None
    if out:
        with tempfile.TemporaryDirectory() as d:
            gh(
                "run",
                "download",
                out,
                "-R",
                idp,
                "-n",
                f"verdict-{surface}",
                "-D",
                d,
                ok=(0, 1),
            )
            p = os.path.join(d, "verdict.json")
            if os.path.exists(p):
                with open(p) as f:
                    v = json.load(f)
    _verdicts[surface] = v
    return v


def move(repo, n, frm, to, why, apply):
    if not apply:
        return
    gh("api", "-X", "DELETE", f"repos/{repo}/issues/{n}/labels/{frm}", ok=(0, 1))
    gh("api", f"repos/{repo}/issues/{n}/labels", "-f", f"labels[]={to}")
    gh(
        "api",
        f"repos/{repo}/issues/{n}/comments",
        "-f",
        f"body=ticket-verify: {frm} -> {to}. {why}",
    )


def main(argv):
    apply = "--apply" in argv

    def opt(name, default):
        return argv[argv.index(name) + 1] if name in argv else default

    owner = (
        os.environ.get("GITHUB_REPOSITORY_OWNER")
        or gh("api", "/user", "--jq", ".login").strip()
    )
    repo = opt("--repo", f"{owner}/crew")
    idp = opt("--idp", f"{owner}/idp")
    app_login = opt(
        "--app-login", os.environ.get("TICKET_VERIFY_APP_LOGIN", "estate-agents[bot]")
    )
    now = time.time()
    try:
        ensure_labels(repo, apply)
        items = tickets(repo)
    except RuntimeError as e:
        print(f"BLIND   ticket-verify  cannot read {repo}: {e}")
        return 2
    rc = 0
    for i in items:
        n = i["number"]
        labels = {label["name"] for label in i.get("labels", [])}
        m = SURFACE_RE.search(i.get("body") or "")
        if not m:
            print(
                f"FAIL    ticket-verify  #{n} names no surface: add a `Verify: <surface>` line (verdict-<surface>.yml in idp)"
            )
            if apply and NO_SURFACE_MARK not in (i.get("body") or ""):
                bodies = gh(
                    "api",
                    f"repos/{repo}/issues/{n}/comments?per_page=100",
                    "--jq",
                    "[.[].body]",
                )
                if NO_SURFACE_MARK not in bodies:
                    gh(
                        "api",
                        f"repos/{repo}/issues/{n}/comments",
                        "-f",
                        f"body={NO_SURFACE_MARK}\nticket-verify: this ticket names no surface, so no verdict can verify it. Add a line `Verify: langfuse` (or another verdict-<surface>.yml) to the body.",
                    )
            rc = 1
            continue
        surface = m.group(1).lower()
        try:
            v = newest_verdict(idp, surface)
            ev = timeline(repo, n)
        except RuntimeError as e:
            print(f"BLIND   ticket-verify  #{n} {surface}: {e}")
            rc = 2
            continue
        state = next(
            label for label in (VERIFIED, REJECTED, PENDING) if label in labels
        )
        new, why = decide(labels, ev, v, now, app_login)
        if new is None:
            print(f"ok      ticket-verify  #{n} {state} stays: {why}")
            continue
        move(repo, n, state, new, why, apply)
        print(
            f"{'ok' if apply else 'FAIL':<8}ticket-verify  #{n} {state} -> {new}{'' if apply else ' (dry run)'}: {why}"
        )
        if not apply:
            rc = 1
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
