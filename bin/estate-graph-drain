#!/bin/bash
# Turn the router's spool (platform/llm/graph_capture.py) into estate-graph entities. No agent runs this.
#
# Every 10 minutes (launchd/ai.estate.graph-drain.plist.tmpl, from ~/.estate/bin -- launchd cannot
# run anything under ~/Documents, TCC): each ~/.estate/graph-spool/<session>.md idle for IDLE_MIN
# is moved into the graph's sessions/ dir, registered with `growmos add`, and `growmos ingest`
# extracts it through the laptop router on the free groq lane (llama3.2 locally took >300s a chunk).
# graph_capture skips those calls (Python-urllib), so extraction is never itself captured.
#
# The graph is ESTATE_GRAPH_ROOT (default ~/.estate/graph/estate-graph, a clone of
# chidionyema/estate-graph that ~/Documents/code/estate-graph points at). The result is committed
# and pushed there. One line per run in ~/.estate/graph-drain.log.
set -uo pipefail
export PATH="$HOME/Library/Python/3.9/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
ROOT="${ESTATE_GRAPH_ROOT:-$HOME/.estate/graph/estate-graph}"
SPOOL="${ESTATE_GRAPH_SPOOL:-$HOME/.estate/graph-spool}"
IDLE_MIN="${ESTATE_GRAPH_IDLE_MIN:-10}"
LIMIT="${ESTATE_GRAPH_INGEST_LIMIT:-40}"
MODEL="${ESTATE_GRAPH_MODEL:-groq}"
LOG="$HOME/.estate/graph-drain.log"
say() { echo "$(date -u +%FT%TZ) $*" >>"$LOG"; }

[ -d "$ROOT/.growmos" ] || { say "BLIND no graph at $ROOT"; exit 1; }
mkdir -p "$SPOOL" "$ROOT/sessions"

moved=0
agents=""
while IFS= read -r f; do
	[ -n "$f" ] || continue
	dst="$ROOT/sessions/$(date -u +%Y%m%dT%H%M%SZ)-$(basename "$f")"
	mv "$f" "$dst" && growmos --root "$ROOT" add "$dst" >/dev/null 2>&1 && {
		moved=$((moved + 1))
		# Per-agent attribution: graph_capture stamps every exchange `agent=<name>`
		# (x-estate-agent / metadata / virtual-key alias / harness UA, never invented),
		# so the drained source itself carries who owned it.
		for a in $(rg -o 'agent=[A-Za-z0-9_.-]+' "$dst" 2>/dev/null | sort -u); do
			agents="$agents ${a#agent=}"
		done
	}
done <<EOF
$(find "$SPOOL" -maxdepth 1 -name '*.md' -mmin +"$IDLE_MIN" 2>/dev/null)
EOF

# groq is keyed on the router, so the caller key is needed (founder approved 2026-09-28): the same
# staged SOPS file and age key bin/litellm-local decrypts at start. Never printed or written.
STAGE="$HOME/.estate/litellm-local"
key="$(SOPS_AGE_KEY_FILE="${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}" \
	"$STAGE/sops" -d --extract '["LITELLM_API_KEY"]' "$STAGE/caller/LITELLM_LAPTOP_KEY.yaml" 2>/dev/null)"
[ -n "$key" ] || { say "moved=$moved ingest=BLOCKED no local caller key"; exit 1; }
# Failure mode (2026-10-17, #6403): the groq lane times out or returns malformed JSON
# in most runs (socket.timeout / JSONDecodeError); failed sources stay `pending`, so a
# bounded retry of the same ingest pass recovers them. Attempts and backoff are env-tunable.
ATTEMPTS="${ESTATE_GRAPH_INGEST_ATTEMPTS:-3}"
BACKOFF_S="${ESTATE_GRAPH_RETRY_BACKOFF_S:-20}"
rc=1
attempt=0
out=""
while [ "$attempt" -lt "$ATTEMPTS" ]; do
	attempt=$((attempt + 1))
	out="$(cd "$ROOT" && GROWMOS_PROVIDER=openai GROWMOS_BASE_URL=http://127.0.0.1:4000/v1 \
		GROWMOS_API_KEY="$key" GROWMOS_EXTRACT_MODEL="$MODEL" GROWMOS_REASON_MODEL="$MODEL" \
		GROWMOS_CALL_TIMEOUT="${ESTATE_GRAPH_CALL_TIMEOUT:-420}" \
		growmos --root "$ROOT" ingest --limit "$LIMIT" 2>&1)"
	rc=$?
	[ "$rc" -eq 0 ] && break
	[ "$attempt" -lt "$ATTEMPTS" ] && sleep "$BACKOFF_S"
done
entities=$(wc -l <"$ROOT/.growmos/entities.jsonl" | tr -d ' ')

if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
	git -C "$ROOT" add -A &&
		git -C "$ROOT" commit -q -m "graph-drain: $moved session(s) spooled by the router" &&
		{ git -C "$ROOT" push -q origin HEAD 2>/dev/null || say "push failed (kept locally)"; }
fi
agent_list=""
[ -n "$agents" ] && agent_list=" agents=$(printf '%s\n' $agents | sort -u | tr '\n' ',' | sed 's/,$//')"
say "moved=$moved entities=$entities ingest_rc=$rc attempts=$attempt$agent_list $(printf '%s' "$out" | tail -2 | tr '\n' ' ' | cut -c1-300)"
