#!/usr/bin/env bash
# Dispatch ONE oke-check.yml break-glass playbook, refusing to queue behind another (crew#412, 2026-08-28).
#
# Why: oke-check.yml runs under `concurrency: {group: oke-check-<event>, cancel-in-progress: false}`.
# GitHub Actions keeps exactly ONE pending run per group: the moment a second dispatch arrives
# while one is pending, the older pending run is CANCELLED, not queued (run 33172458777,
# catalogue-roll, cancelled 12:46:35Z by the diagnose dispatch 33172481714 twenty seconds later).
# GitHub has no queue-depth setting, so the guard is here: dispatch only when no workflow_dispatch
# run of the workflow is pending; a run already in progress is fine, the new one becomes the one
# pending slot. Same refusal as bin/idp-oke-rebuild for an unknown playbook (exit 64).
#
# Use: bin/idp-oke-dispatch <playbook>        (mode=break-glass on main)
#      bin/idp-oke-dispatch --check           (mode=check on main)
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
WORKFLOW="${OKE_WORKFLOW:-oke-check.yml}"
REPO_ARGS=(); [ -n "${IDP_REPO:-}" ] && REPO_ARGS=(--repo "$IDP_REPO")
[ $# -eq 1 ] || { echo "usage: idp-oke-dispatch <playbook> | --check"; exit 64; }
if [ "$1" = --check ]; then
  INPUTS=(-f mode=check)
else
  "$IDP/bin/idp-oke-break-glass" --list | tr ' ' '\n' | grep -x "$1" >/dev/null \
    || { echo "exit 64: unknown playbook '$1'; known: $("$IDP/bin/idp-oke-break-glass" --list)"; exit 64; }
  INPUTS=(-f mode=break-glass -f "playbook=$1")
fi
pending=$(gh run list "${REPO_ARGS[@]}" --workflow "$WORKFLOW" --event workflow_dispatch --status queued --limit 5 --json databaseId --jq '.[].databaseId')
pending="$pending$(gh run list "${REPO_ARGS[@]}" --workflow "$WORKFLOW" --event workflow_dispatch --status pending --limit 5 --json databaseId --jq '.[].databaseId')"
if [ -n "$pending" ]; then
  echo "exit 75: $WORKFLOW already has a pending workflow_dispatch run ($(echo "$pending" | tr '\n' ' ')); a second dispatch would cancel it (GitHub keeps one pending run per concurrency group). Wait for it to start, then dispatch."
  exit 75
fi
gh workflow run "$WORKFLOW" "${REPO_ARGS[@]}" --ref main "${INPUTS[@]}"
