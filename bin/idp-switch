#!/usr/bin/env bash
# Repoint the primary URL at the other renderer. This is the 10-second switch.
#
#   idp-switch fallback    http://<host>:8443/  ->  Datasette
#   idp-switch primary     http://<host>:8443/  ->  Backstage
#
# The 0-second switch needs no command at all: both renderers are already
# running at their own URLs, so the answer to "Backstage is broken" is to open
# the other link. This command exists for the case where the link itself has
# been handed to somebody -- a buyer, a page, a Telegram message -- and the
# thing behind it has to change without the link changing.
set -euo pipefail

case "${1:-}" in
  primary|backstage) target=3100; name="Backstage" ;;
  fallback|datasette) target=8001; name="Datasette" ;;
  *) echo "usage: idp-switch primary|fallback" >&2; exit 2 ;;
esac

# Refuse to point the public link at something that is not answering. A switch
# to a dead renderer is not a failover, it is a second outage.
# curl writes %{http_code} even on failure -- "000" -- so an `|| echo down`
# here produced "000down", which matched neither branch and let the switch
# proceed to a dead renderer. Read the code and decide on it.
code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 4 "http://127.0.0.1:$target" 2>/dev/null || true)
case "$code" in ""|000) code=down ;; esac
if [ "$code" = "down" ]; then
  echo "idp-switch: $name on 127.0.0.1:$target is not answering -- refusing to switch to it" >&2
  echo "            start it with bin/idp-up, or switch to the other one" >&2
  exit 1
fi

# `|| echo` matters: on the first ever switch there is nothing on 8443, grep
# exits 1, and under `set -e` the script would die reporting nothing wrong.
before=$(tailscale serve status 2>/dev/null | grep -A1 '8443' | tail -1 | tr -s ' ' || true)
[ -n "$before" ] || before="(nothing was published on 8443)"
tailscale serve --bg --http=8443 "http://127.0.0.1:$target" >/dev/null
host=$(tailscale status --json | /usr/local/bin/jq -r '.Self.DNSName' | sed 's/\.$//')

echo "was:  $before"
echo "now:  http://$host:8443/  ->  $name (127.0.0.1:$target, HTTP $code)"
# Probed through the tailnet listener with an explicit Host header rather than
# by name. This Mac does not resolve its own MagicDNS name -- other devices on
# the tailnet do -- so resolving here would report a failure that is not one.
tsip=$(tailscale ip -4 2>/dev/null | head -1)
if [ -n "$tsip" ]; then
  curl -fsS -o /dev/null -w 'live: the tailnet listener answered %{http_code} in %{time_total}s\n' \
    --max-time 10 -H "Host: $host:8443" "http://$tsip:8443/" 2>/dev/null \
    || echo "live: the tailnet listener on 8443 did not answer"
fi
