#!/usr/bin/env bash
# agent-launchctl-guard -- an agent may not restart the critical services it keeps breaking.
#
#   agent-launchctl-guard --install    link into PATH (~/.local/bin/launchctl)
#   agent-launchctl-guard --self-test   prove both directions
#
# MEASURED 2026-11-19: this agent touched the live router six times in one session
# (bootstrap, three kickstarts, two config edits, one tunnel enable). Each time it believed a
# measurement; each time it took risk with the estate's most critical service. A rule in a chat
# is not a control. This is: the verb itself refuses unless a live instruction names the service.
#
#   touching com.estate.pennyd / ai.estate.router-tunnel needs
#     ~/.estate/instructions/live/<INS-ID>.json   {"service":"pennyd","expires_at":<epoch>}
#   everything else passes through untouched.
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
REAL=/bin/launchctl
LOG="$HOME/.estate/log/launchctl-guard.log"
LIVE="$HOME/.estate/instructions/live"

case "${1:-}" in
  --install)
    mkdir -p "$HOME/.local/bin"; ln -sf "$SELF" "$HOME/.local/bin/launchctl"
    echo "installed: $HOME/.local/bin/launchctl -> $SELF"; exit 0 ;;
  --self-test)
    "$SELF" kickstart -k "gui/$(id -u)/com.estate.pennyd" >/dev/null 2>&1
    [ $? -eq 3 ] && echo "ok  kickstart pennyd refused" || { echo "FAIL pennyd not refused"; exit 1; }
    "$SELF" list >/dev/null 2>&1 && echo "ok  list passes" || { echo "FAIL list blocked"; exit 1; }
    exit 0 ;;
esac

case " $* " in
  *pennyd*|*router-tunnel*)
    target=pennyd
    case " $* " in *router-tunnel*) target=router-tunnel ;; esac
    ok=0
    for f in "$LIVE"/*.json; do
      [ -f "$f" ] || continue
      python3 - "$f" "$target" <<'PY' && ok=1 && break
import json,sys,time
try: d=json.load(open(sys.argv[1]))
except Exception: sys.exit(1)
sys.exit(0 if d.get("service")==sys.argv[2] and float(d.get("expires_at",0))>time.time() else 1)
PY
    done
    if [ "$ok" != "1" ]; then
      printf '%s REFUSED launchctl %s (no live instruction for %s) cwd=%s\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" "$target" "$PWD" >> "$LOG"
      printf 'REFUSED: launchctl %s touches %s and no live instruction authorises it.\n' "$*" "$target" >&2
      printf 'Create one: ~/.estate/bin/instruction new --text "restart %s" --session <agent>\n' "$target" >&2
      exit 3
    fi
    printf '%s ALLOWED launchctl %s (instruction present)\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*" >> "$LOG"
    ;;
esac
exec "$REAL" "$@"
