#!/usr/bin/env bash
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
for n in dagster-daemon dagster-web; do
  f="$IDP/run/$n.pid"; [ -f "$f" ] && { kill "$(cat "$f")" 2>/dev/null && echo "stopped $n"; rm -f "$f"; }
done
pkill -f "dagster-daemon run.*$IDP/scheduler" 2>/dev/null; pkill -f "dagster-webserver.*$IDP/scheduler" 2>/dev/null; true
