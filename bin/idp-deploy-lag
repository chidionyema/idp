#!/usr/bin/env python3
"""Is what the cluster runs the thing that was built? (idp#1046)

WHY THIS EXISTS. On 2026-08-30 the estate stopped deploying and every instrument stayed green for
thirteen hours. A deploy here is a pull request: image-automation-controller writes the new tag onto
`flux/image-updates` and a workflow opens the pull request that carries it to main. That pull
request stopped merging at 2026-08-30T14:45Z. Nothing noticed, because nothing was looking:

  ci on main                green -- it grades the build, not the deploy
  build-multiarch           green -- the image exists in ghcr, which was never in doubt
  login-drill               green -- it signs in to the portal, and the old portal signs in fine
  image-update-pr           RED, on a robot branch nobody reads

Every one of those answers a question about a part. None of them answers the only question that
matters to the person looking at the portal: is the thing I merged the thing that is running?

WHAT IT GRADES. For every image tag the automation owns -- the `newTag:` lines carrying an
`$imagepolicy` marker under platform/ and clusters/ -- it compares main against the branch the
controller writes to. The controller's branch IS the estate's own answer to "the newest image the
policy would pick", so no registry credential and no cluster read is needed, and the comparison
cannot be fooled by a build that succeeded into a registry nothing points at.

A difference is not a failure: a deploy in flight is normal. A difference that has stood longer than
the bound is the failure, and the bound is configurable (DEPLOY_LAG_MAX_HOURS, --max-lag-hours).

Grading, like every bin/idp-*: one line per surface, `ok|FAIL|BLIND  deploy-lag  <why>`.
Exit 0 all current, 1 something is stuck, 2 BLIND -- the refs could not be read, which is never
reported as green. An estate that cannot tell whether it is deploying is not deploying.

  bin/idp-deploy-lag [--max-lag-hours H] [--branch flux/image-updates] [--json]
"""

import argparse
import datetime as dt
import json
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# The marker the image-automation-controller writes beside every line it owns.
TAGGED = re.compile(
    r"^newTag:\s*(?P<tag>\S+)\s*#\s*\{\"\$imagepolicy\":\s*\"(?P<policy>[^\"]+)\""
)
DEFAULT_MAX_LAG_HOURS = float(os.environ.get("DEPLOY_LAG_MAX_HOURS", "2"))


def git(*args, check=True):
    p = subprocess.run(
        ["git", "-C", ROOT, *args], capture_output=True, text=True, timeout=120
    )
    if check and p.returncode != 0:
        raise RuntimeError(f"git {' '.join(args)}: {(p.stderr or p.stdout).strip()}")
    return p.stdout


def tags_at(ref):
    """{policy: (path, tag)} for every automation-owned tag line at `ref`."""
    out = git(
        "grep",
        "-n",
        "--full-name",
        "imagepolicy",
        ref,
        "--",
        "platform",
        "clusters",
        check=False,
    )
    found = {}
    for line in out.splitlines():
        # `git grep <ref>` emits `<ref>:<path>:<lineno>:<content>`.
        if not line.startswith(ref + ":"):
            continue
        rest = line[len(ref) + 1 :]
        try:
            path, _lineno, content = rest.split(":", 2)
        except ValueError:
            continue
        m = TAGGED.match(content.strip())
        if m:
            found[m.group("policy")] = (path, m.group("tag"))
    return found


def age_hours(ref, path, now):
    """How long `ref` has carried its current version of `path`."""
    stamp = git("log", "-1", "--format=%cI", ref, "--", path, check=False).strip()
    if not stamp:
        return None
    when = dt.datetime.fromisoformat(stamp)
    return (now - when).total_seconds() / 3600.0


def main(argv):
    ap = argparse.ArgumentParser()
    ap.add_argument("--max-lag-hours", type=float, default=DEFAULT_MAX_LAG_HOURS)
    ap.add_argument(
        "--branch", default=os.environ.get("IMAGE_UPDATE_BRANCH", "flux/image-updates")
    )
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args(argv)

    live, newest = (
        f"origin/{os.environ.get('DEPLOY_LAG_BASE', 'main')}",
        f"origin/{a.branch}",
    )
    for ref in (live, newest):
        if git("rev-parse", "--verify", "--quiet", ref, check=False).strip() == "":
            print(
                f"BLIND   deploy-lag  {ref} cannot be read; fetch it before grading -- an estate "
                f"that cannot tell whether it is deploying is not deploying"
            )
            return 2

    now = dt.datetime.now(dt.timezone.utc)
    have, want = tags_at(live), tags_at(newest)
    if not want:
        print(
            f"BLIND   deploy-lag  no $imagepolicy tag lines found at {newest}; the marker moved "
            f"or the branch is empty, and a check that measures nothing is not a check"
        )
        return 2

    rows, rc = [], 0
    for policy in sorted(want):
        path, new = want[policy]
        old = have.get(policy, (path, None))[1]
        if old == new:
            rows.append({"policy": policy, "state": "ok", "tag": new, "lag_hours": 0.0})
            print(f"ok      deploy-lag  {policy} is running {new}")
            continue
        lag = age_hours(newest, path, now)
        if lag is None:
            rows.append({"policy": policy, "state": "BLIND", "tag": old})
            print(
                f"BLIND   deploy-lag  {policy} differs but {newest} has no history for {path}"
            )
            rc = max(rc, 2)
            continue
        state = "FAIL" if lag > a.max_lag_hours else "ok"
        rows.append(
            {
                "policy": policy,
                "state": state,
                "running": old,
                "built": new,
                "lag_hours": round(lag, 2),
                "path": path,
            }
        )
        if state == "FAIL":
            rc = max(rc, 1)
            print(
                f"FAIL    deploy-lag  {policy} is running {old} but {new} was built "
                f"{lag:.1f}h ago and has not reached main (bound {a.max_lag_hours:g}h); "
                f"the deploy pull request from {a.branch} is not merging"
            )
        else:
            print(
                f"ok      deploy-lag  {policy} deploy in flight, {lag:.1f}h "
                f"(bound {a.max_lag_hours:g}h)"
            )

    if a.json:
        print(json.dumps({"rows": rows, "max_lag_hours": a.max_lag_hours}, indent=2))
    return rc


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
