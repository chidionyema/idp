#!/usr/bin/env python3
"""Every layer the cluster runs, as catalogue entities (crew#459, founder 2026-08-29: "where are all
our components, tools, services ... all the tooling we use in our cluster is hidden away").

Reads the Flux Kustomizations under clusters/<cluster>/*.yaml, the one list of what the cluster is
made of, and writes backstage/platform/catalog-info.yaml: one System per area and one Component
(type `platform-layer`) per Kustomization, with `backstage.io/kubernetes-label-selector` set to the
label Flux stamps on every object it applies, so the Kubernetes plugin finds the live pods with
nothing typed by hand. `spec.dependsOn` mirrors Flux `dependsOn`. A layer whose own manifests carry
a `kind: HTTPRoute` or `kind: Ingress` also gets one `kind: API`, linked with `providesApis`, its
hostname read off that manifest -- so the APIs tab answers "what can I call" instead of staying
empty. Nothing here names a host, a provider or a path outside the repository (LAW 46, R36).

    bin/catalog-platform            # rewrite the file
    bin/catalog-platform --check    # exit 1 when the file is stale (the gate)
"""

import glob
import os
import sys

import yaml

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CLUSTER = os.environ.get("CLUSTER", "oke")
OUT = os.path.join(ROOT, "backstage", "platform", "catalog-info.yaml")
TYPE = "platform-layer"

# area -> (title, one sentence a buyer reads)
