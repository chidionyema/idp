def kustomizations():
    rows = []
    for f in sorted(glob.glob(os.path.join(ROOT, "clusters", CLUSTER, "*.yaml"))):
        for d in yaml.safe_load_all(open(f)):
            if d and d.get("kind") == "Kustomization":
                rows.append(d)
    return rows


def q(s):
    return "'" + str(s).replace("'", "''") + "'"


def render(rows):
    names = {r["metadata"]["name"] for r in rows}
    missing = sorted(names - set(LAYERS))
    if missing:
        sys.exit(
            f"catalog-platform: no plain-English row for {missing}; add it to LAYERS in bin/catalog-platform"
        )
    out = [
        "# GENERATED by bin/catalog-platform from clusters/%s/*.yaml. Do not edit; edit LAYERS there."
        % CLUSTER,
        "# One System per area, one Component per Flux Kustomization. The Kubernetes plugin reads the live",
        "# pods through the label Flux stamps on every applied object (crew#459).",
    ]
    used = {LAYERS[n][0] for n in names}
    for area in SYSTEMS:
        if area not in used:
            continue
        title, desc = SYSTEMS[area]
        out += [
            "---",
            "apiVersion: backstage.io/v1alpha1",
            "kind: System",
            "metadata:",
            f"  name: {area}",
            f"  title: {q(title)}",
            f"  description: {q(desc)}",
            "  tags: [platform]",
            "spec:",
            "  owner: group:default/platform",
            "  domain: platform",
        ]
    for r in sorted(rows, key=lambda r: r["metadata"]["name"]):
        n = r["metadata"]["name"]
        area, title, desc = LAYERS[n]
        spec = r["spec"]
        out += [
            "---",
            "apiVersion: backstage.io/v1alpha1",
            "kind: Component",
            "metadata:",
            f"  name: layer-{n}",
            f"  title: {q(title)}",
            f"  description: {q(desc)}",
            "  annotations:",
            f"    backstage.io/kubernetes-label-selector: {q('kustomize.toolkit.fluxcd.io/name=' + n)}",
            f"    estate/flux-kustomization: {q(n)}",
            f"    estate/path: {q(spec.get('path', './'))}",
            f"    estate/cluster: {q(CLUSTER)}",
            f"  tags: [platform, {area}]",
            "spec:",
            f"  type: {TYPE}",
            "  lifecycle: production",
            "  owner: group:default/platform",
            f"  system: {area}",
        ]
        deps = [d["name"] for d in spec.get("dependsOn", []) if d.get("name") in names]
        if deps:
            out.append("  dependsOn:")
            out += [f"    - component:default/layer-{d}" for d in deps]
    return "\n".join(out) + "\n"


def main(argv):
    text = render(kustomizations())
    if "--check" in argv:
        cur = open(OUT).read() if os.path.exists(OUT) else ""
        if cur != text:
            print(
                "FAIL    catalog-platform  backstage/platform/catalog-info.yaml is stale; run bin/catalog-platform"
            )
            return 1
        print(
            f"ok      catalog-platform  {text.count('kind: Component')} layers, {text.count('kind: System')} systems current"
        )
        return 0
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    open(OUT, "w").write(text)
    print(
        f"ok      catalog-platform  wrote {os.path.relpath(OUT, ROOT)}: {text.count('kind: Component')} layers, {text.count('kind: System')} systems"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
