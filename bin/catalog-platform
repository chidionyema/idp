# kustomization name -> (path, title) for the layer's own web UI, opened through the
# Backstage backend proxy (LAW 46: never a hostname typed here; the proxy entry in
# backstage/app-config.yaml is the door, the same shape as /holmes). A layer with no entry
# here gets no UI link; the catalog never invents a URL it cannot back.
UI_DOORS = {
    "dagster": ("https://catalogue.${ESTATE_ZONE}/dagster", "Open the scheduler"),
}


# Layers launched by hand, on purpose, so they never sit in clusters/<cluster>/*.yaml: the buyer
# sandbox is launched by the founder's portal button (docs/runbooks/demo-sandbox.md) and reaped on a
# one-hour timer. The catalogue still records it -- the launch stamps exactly the label the
# selector below matches, so the page lights up while the sandbox lives and reads empty after.
IMPERATIVE = [
    {
        "apiVersion": "kustomize.toolkit.fluxcd.io/v1",
        "kind": "Kustomization",
        "metadata": {"name": "demo-sandbox"},
        "spec": {"path": "./platform/sandbox/vcluster"},
    },
]


def kustomizations():
    rows = []
    for f in sorted(glob.glob(os.path.join(ROOT, "clusters", CLUSTER, "*.yaml"))):
        for d in yaml.safe_load_all(open(f)):
            if (
                d
                and d.get("kind") == "Kustomization"
                and str(d.get("apiVersion", "")).startswith("kustomize.toolkit")
            ):
                rows.append(d)
    return rows + [dict(r) for r in IMPERATIVE]


def q(s):
    return "'" + str(s).replace("'", "''") + "'"


def http_hostnames(src):
    """Hostnames a layer declares reachable over HTTP: kind: HTTPRoute (spec.hostnames) or
    kind: Ingress (spec.rules[].host), read only from the *.yaml files sitting directly in the
    Kustomization's own spec.path -- never typed here as a literal (LAW 46, R36). A layer with
    neither gets no API: an API entity with no reachable interface is a promise the catalogue
    cannot back."""
    hosts = []
    for f in sorted(glob.glob(os.path.join(src, "*.yaml"))):
        try:
            docs = list(yaml.safe_load_all(open(f)))
        except yaml.YAMLError:
            continue
        for d in docs:
            if not isinstance(d, dict):
                continue
            if d.get("kind") == "HTTPRoute":
                hosts += (d.get("spec") or {}).get("hostnames", [])
            elif d.get("kind") == "Ingress":
                hosts += [
                    rule["host"]
                    for rule in (d.get("spec") or {}).get("rules", [])
                    if rule.get("host")
                ]
    return sorted(set(hosts))


def observability_doors(rows):
    """The estate's two observability doors -- logs/metrics (signoz.*) and model traces
    (langfuse.*) -- read from the observability layer's own route manifests via
    http_hostnames, never typed here (LAW 46). Founder, 2026-08-31 (crew#758): a layer's
    logs and traces are opened from its catalogue page, not from a URL he has to remember."""
    for r in rows:
        if r["metadata"]["name"] == "observability":
            src = os.path.normpath(os.path.join(ROOT, r["spec"].get("path", "./")))
            hosts = http_hostnames(src)
            signoz = next((h for h in hosts if h.startswith("signoz.")), None)
            langfuse = next((h for h in hosts if h.startswith("langfuse.")), None)
            return signoz, langfuse
    return None, None


def emits_model_traces(src):
    """A layer traces to Langfuse when its own manifests project LANGFUSE_ keys into the
    workload -- the same self-gating the pods use, so the link exists exactly when traces do."""
    for f in sorted(glob.glob(os.path.join(src, "*.yaml"))):
        try:
            if "LANGFUSE_" in open(f).read():
                return True
        except OSError:
            continue
    return False


def missing_owners(layers):
    """Which LAYERS rows carry no owner -- pulled out of render() so rules.yaml can prove this
    guard both ways (a fixture LAYERS dict) without exercising the real cluster/catalog paths."""
    return sorted(n for n in layers if not layers[n][3])


def render(rows):
    names = {r["metadata"]["name"] for r in rows}
    missing = sorted(names - set(LAYERS))
    if missing:
        sys.exit(
            f"catalog-platform: no plain-English row for {missing}; add it to LAYERS in bin/catalog-platform"
        )
    no_owner = [n for n in missing_owners(LAYERS) if n in names]
    if no_owner:
        sys.exit(
            f"catalog-platform: no owner for {no_owner}; every LAYERS row's 4th field must be a real group"
        )
    out = [
        "# GENERATED by bin/catalog-platform from clusters/%s/*.yaml. Do not edit; edit LAYERS there."
        % CLUSTER,
        "# One System per area, one Component per Flux Kustomization. The Kubernetes plugin reads the live",
        "# pods through the label Flux stamps on every applied object (crew#459).",
    ]
    used = {LAYERS[n][0] for n in names}
    signoz_door, langfuse_door = observability_doors(rows)
    for area in SYSTEMS:
        if area not in used:
            continue
        title, desc = SYSTEMS[area]
        out += [
            "---",
            "apiVersion: backstage.io/v1alpha1",
            "kind: System",
            "metadata:",
            f"  name: {area}",
            f"  title: {q(title)}",
            f"  description: {q(desc)}",
            "  tags: [platform]",
            "spec:",
            # An area (e.g. "resilience") groups many layers with different owners; it has no
            # single owning team of its own, so it stays the blanket default on purpose -- the
            # per-layer Component/API owner below is the one that must be a real, named owner.
            "  owner: group:default/platform",
            "  domain: platform",
        ]
    for r in sorted(rows, key=lambda r: r["metadata"]["name"]):
        n = r["metadata"]["name"]
        area, title, desc, owner = LAYERS[n]
        spec = r["spec"]
        src = os.path.normpath(os.path.join(ROOT, spec.get("path", "./")))
        hosts = http_hostnames(src)
        out += [
            "---",
            "apiVersion: backstage.io/v1alpha1",
            "kind: Component",
            "metadata:",
            f"  name: layer-{n}",
            f"  title: {q(title)}",
            f"  description: {q(desc)}",
            "  annotations:",
            f"    backstage.io/kubernetes-label-selector: {q('kustomize.toolkit.fluxcd.io/name=' + n)}",
            f"    estate/flux-kustomization: {q(n)}",
            f"    estate/path: {q(spec.get('path', './'))}",
            f"    estate/cluster: {q(CLUSTER)}",
            f"  tags: [platform, {area}]",
        ]
        # crew#758: every layer's page opens its own observability. The logs door is the
        # estate's one log backend; the traces door appears exactly on the layers whose
        # manifests project Langfuse keys, so a link never promises traces that do not land.
        doors = []
        if signoz_door:
            doors.append(("Live logs and metrics", f"https://{signoz_door}"))
        if langfuse_door and emits_model_traces(src):
            doors.append(("Model traces", f"https://{langfuse_door}"))
        if n in UI_DOORS:
            ui_path, ui_title = UI_DOORS[n]
            doors.append((ui_title, ui_path))
        if doors:
            out.append("  links:")
            for door_title, door_url in doors:
                out += [f"    - url: {door_url}", f"      title: {q(door_title)}"]
        out += [
            "spec:",
            f"  type: {TYPE}",
            "  lifecycle: production",
            f"  owner: {owner}",
            f"  system: {area}",
        ]
        if hosts:
            out += ["  providesApis:", f"    - api:default/{n}-api"]
        deps = [d["name"] for d in spec.get("dependsOn", []) if d.get("name") in names]
        if deps:
            out.append("  dependsOn:")
            out += [f"    - component:default/layer-{d}" for d in deps]
        # crew#459 follow-up: a layer with an HTTPRoute or an Ingress is reachable over HTTP, so
        # the APIs tab gets an entry, not an empty tab -- "what can I call" answered from the
        # cluster's own manifests, never invented.
        if hosts:
            host_str = " and ".join(hosts)
            out += [
                "---",
                "apiVersion: backstage.io/v1alpha1",
                "kind: API",
                "metadata:",
                f"  name: {n}-api",
                f"  description: {q(title + ': the HTTP interface, answering at ' + host_str + '.')}",
                "spec:",
                "  type: openapi",
                "  lifecycle: production",
                f"  owner: {owner}",
                f"  system: system:default/{area}",
                "  definition: |",
                f"    # Not published. {n} answers at {host_str}; this entity",
                "    # exists so the catalogue records that the interface is reachable and who owns it.",
            ]
    return "\n".join(out) + "\n"


def main(argv):
    if "--check-fixture" in argv:
        # rules.yaml's catalog-platform-owner rule: proves missing_owners() refuses a row with
        # no owner and passes a full one, without touching the real cluster/ tree or OUT.
        path = argv[argv.index("--check-fixture") + 1]
        fixture = runpy.run_path(path)
        bad = missing_owners(fixture["LAYERS"])
        if bad:
            print(f"FAIL    catalog-platform  no owner for {bad}")
            return 1
        print(f"ok      catalog-platform  every layer in {path} carries an owner")
        return 0
    text = render(kustomizations())
    if "--check" in argv:
        cur = open(OUT).read() if os.path.exists(OUT) else ""
        if cur != text:
            print(
                "FAIL    catalog-platform  backstage/platform/catalog-info.yaml is stale; run bin/catalog-platform"
            )
            return 1
        print(
            f"ok      catalog-platform  {text.count('kind: Component')} layers, {text.count('kind: System')} systems current"
        )
        return 0
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    open(OUT, "w").write(text)
    print(
        f"ok      catalog-platform  wrote {os.path.relpath(OUT, ROOT)}: {text.count('kind: Component')} layers, {text.count('kind: System')} systems"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
