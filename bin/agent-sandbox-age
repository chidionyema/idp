#!/usr/bin/env bash
# Install the exact, trusted age binary in each ephemeral GitHub runner job.
# No Ubuntu mirror dependency and no mutable latest-release resolution.
# Claim: chidionyema/idp#7972
set -euo pipefail

if [[ "$(uname -s)" != Linux || "$(uname -m)" != x86_64 ]]; then
  echo "::error::age bootstrap supports only Linux amd64; refusing unpinned architecture" >&2
  exit 2
fi

version=v1.3.2
digest=cbe24006683f8eb669266162894b9a522a1af52f2665fbc63a4bb032ed26ac10
url="https://github.com/FiloSottile/age/releases/download/${version}/age-${version}-linux-amd64.tar.gz"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
archive="$tmp/age.tar.gz"

# The archive digest is a mandatory, non-overridable constant. Never run or
# install binaries before checking it. An unavailable upstream fails closed.
curl --fail --location --silent --show-error --retry 3 \
  --retry-all-errors --connect-timeout 10 --max-time 120 \
  --output "$archive" "$url"
printf '%s  %s\n' "$digest" "$archive" | sha256sum --check --status || {
  echo "::error::age archive digest mismatch; refusing untrusted binary" >&2
  exit 3
}

tar -xzf "$archive" -C "$tmp" age/age age/age-keygen
test -f "$tmp/age/age" && test -f "$tmp/age/age-keygen" || {
  echo "::error::pinned age archive missing executables" >&2
  exit 4
}
sudo install -m 0755 "$tmp/age/age" /usr/local/bin/age
sudo install -m 0755 "$tmp/age/age-keygen" /usr/local/bin/age-keygen
age --version
