#!/usr/bin/env python3
"""Report, or retire, launchd agents that schedule.yml already runs under Dagster.

crew#85 (2026-08-27): 39 of 43 schedule.yml jobs were still bootstrapped as launchd agents and
fired from both schedulers: 2,109 launchd runs since boot on top of the Dagster runs, one of
them the Fly poll every 60 s. STANDARDS row 46 makes Dagster the scheduler; the import (idp#12)
wrote schedule.yml and left the plists loaded. Daemons (KeepAlive) never appear in schedule.yml,
so they are never touched here.

Usage: idp-launchd-retire            report; exit 1 when any overlap exists
       idp-launchd-retire --apply    bootout each overlapping agent and move its plist to
                                     $LAUNCH_AGENTS.retired-by-dagster/ (undo: move back, bootstrap)
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

import yaml

ROOT = Path(__file__).resolve().parents[1]
SCHEDULE = ROOT / "scheduler" / "schedule.yml"
AGENTS = Path(os.environ.get("LAUNCH_AGENTS", Path.home() / "Library" / "LaunchAgents"))
RETIRED = AGENTS.with_name(AGENTS.name + ".retired-by-dagster")


def loaded_labels() -> set[str]:
    out = subprocess.run(["launchctl", "list"], capture_output=True, text=True, check=True).stdout
    return {ln.split("\t")[-1] for ln in out.splitlines()[1:] if ln}


def overlap(jobs: set[str], loaded: set[str]) -> list[str]:
    return sorted(jobs & loaded)


def main(argv: list[str]) -> int:
    jobs = set(yaml.safe_load(SCHEDULE.read_text())["jobs"])
    both = overlap(jobs, loaded_labels())
    print(f"launchd-retire: {len(both)} of {len(jobs)} schedule.yml jobs are also loaded in launchd")
    if not both:
        return 0
    if "--apply" not in argv:
        for j in both:
            print(f"  BOTH  {j}")
        print(f"run with --apply to bootout them and park the plists in {RETIRED}")
        return 1
    RETIRED.mkdir(exist_ok=True)
    uid = os.getuid()
    failed = 0
    for j in both:
        r = subprocess.run(["launchctl", "bootout", f"gui/{uid}/{j}"], capture_output=True, text=True)
        plist = AGENTS / f"{j}.plist"
        if plist.exists():
            plist.rename(RETIRED / plist.name)
        ok = r.returncode == 0
        failed += not ok
        print(f"  {'retired' if ok else 'FAILED '} {j}  {r.stderr.strip()[:80]}")
    print(f"launchd-retire: {len(both) - failed} retired, {failed} failed; undo: mv {RETIRED}/<label>.plist {AGENTS}/ && launchctl bootstrap gui/{uid} {AGENTS}/<label>.plist")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
