#!/usr/bin/env bash
# Start the catalogue and publish it on the tailnet.
#
# ONE RENDERER. Founder ruling, 2026-08-24: "ive seen 5 ui faces today", and
# "backstge is for catalog". Backstage is the catalogue and there is no second
# one. The Datasette fallback this script used to start on 8001 served the same
# facts under the title "Estate catalogue -- fallback renderer", which meant the
# owner of the estate met two pages claiming to be the catalogue and had no way
# to know which one to believe.
#
# The argument it was removed against was availability: a second renderer with
# no shared runtime survives a broken node_modules or a Backstage upgrade. That
# is a real property and it is not worth what it cost. A fallback nobody was
# told about is not availability, it is a second source of truth that is right
# by coincidence. If the portal being down during an upgrade becomes a real
# problem, the answer is to make the upgrade not take it down.
#
#   catalogue   Backstage   node   localhost:3100
set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
RUN="$IDP/logs"; mkdir -p "$RUN"
PORT_PRIMARY=3100

log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

# THE TAILSCALE BINARY IS NOT ON launchd's PATH (2026-10-05). This script runs hourly under
# launchd with PATH=/usr/bin:/bin:/usr/sbin:/sbin, and Tailscale.app installs its CLI at
# /Applications/Tailscale.app/Contents/MacOS/Tailscale -- which is not on it. So the old
# bare `command -v tailscale` was false every hour, the publish block below never ran, and
# `tailscale serve status` stayed "No serve config" while this script still logged a
# catalogue URL (it printed its own guess, not Tailscale's answer). The founder's phone then
# loaded /fleet over plain http://<host>:8443, where window.isSecureContext is false and the
# microphone can never be granted -- read for days as "microphone blocked", a permission
# bug, when the door that publishes the page had simply never been opened.
# Resolved by name, then by each place an install can live, and only used if it answers.
tailscale_bin() {
	if command -v tailscale >/dev/null 2>&1; then command -v tailscale; return 0; fi
	for c in /Applications/Tailscale.app/Contents/MacOS/Tailscale \
	         /usr/local/bin/tailscale /opt/homebrew/bin/tailscale; do
		if [ -x "$c" ]; then printf '%s' "$c"; return 0; fi
	done
	return 1
}

# 1. Regenerate the catalogue from the one source. db-gen stays: estate.db is
#    the queryable copy of the same facts, and dropping a renderer is not a
#    reason to stop producing the data underneath it.
#
#    SKIP WHEN NOTHING CHANGED, so a warm reboot does not spend ~2 minutes of full CPU
#    regenerating a byte-identical catalogue from an unchanged inventory. Measured: the
#    inventory was 4 days old and catalog-gen still re-ran at 97% CPU before the board could
#    boot -- that is the "red star" in "one minute cold start". catalog-gen is deterministic
#    (bin/idp-ci runs it twice and fails on a byte of difference), so a catalogue newer than
#    both the inventory AND the generator is already correct, not merely "probably fine".
#    FORCE=1 re-runs it regardless, for the day the inventory or generator changes in place.
CATALOG="$IDP/catalog/catalog-info.yaml"
INVENTORY="${INV:-$HOME/.estate/state/inventory.json}"
GEN="$IDP/bin/catalog-gen"
DB="$IDP/catalog/estate.db"
if [ "${FORCE:-0}" = "1" ] || [ ! -f "$CATALOG" ] || [ "$INVENTORY" -nt "$CATALOG" ] || [ "$GEN" -nt "$CATALOG" ]; then
	"$IDP/bin/catalog-gen"
else
	log "catalogue unchanged -- skipping catalog-gen (FORCE=1 to re-run)"
fi
if [ "${FORCE:-0}" = "1" ] || [ ! -f "$DB" ] || [ "$CATALOG" -nt "$DB" ]; then
	"$IDP/bin/db-gen"
else
	log "estate.db unchanged -- skipping db-gen"
fi

# 2. The catalogue.
if [ -d "$IDP/backstage/node_modules" ]; then
  # localhost, NOT 127.0.0.1. Backstage's app binds [::1] only, so a v4 probe
  # returns 000 and this script concludes it is down every single time -- then
  # starts a second `yarn start` on top of a portal that was already serving.
  # Measured 2026-08-24: curl 127.0.0.1:3100 -> 000, curl localhost:3100 -> 200,
  # while lsof showed `node 56620 IPv6 TCP [::1]:3100 (LISTEN)`.
  # BOTH PORTS, not just the frontend. `yarn start` runs app (3100) and backend
  # (7107) as one process; the frontend binds first, so a 3100-only probe reads
  # "up" while every /api/proxy/* still falls through to the SPA and the portal
  # shows an empty fleet. Measured 2026-09-21: 3100 answered, 7107 was refused,
  # and "no sessions" looked like a backend bug rather than a startup race.
  # The probe must be a route the backend serves WITHOUT credentials, or readiness
  # never turns true. Measured 2026-09-21 on this backend: /api/openapi.json and
  # /api/health are 404 (plugin not mounted), /api/catalog/entities and
  # /api/proxy/* are 401 (alive but gated). Only guest auth answers 200 unauth'd.
  backend_up() { curl -fsS -o /dev/null "http://localhost:7107/api/auth/guest/refresh" 2>/dev/null; }
  if ! curl -fsS -o /dev/null "http://localhost:$PORT_PRIMARY" 2>/dev/null || ! backend_up; then
    ( cd "$IDP/backstage"
      export NVM_DIR="$HOME/.nvm"; . "$NVM_DIR/nvm.sh" >/dev/null
      # The node version is RESOLVED, never typed. This line named v22.13.1,
      # which is not installed on this host (only v20.19.2 and v22.15.1 are), so
      # under launchd it put a nonexistent bin/ at the front of PATH and yarn ran
      # against whatever node happened to be found -- the "works in my terminal,
      # dies under launchd" class of bug. `nvm use` picks the default alias.
      nvm use --silent default >/dev/null 2>&1 || nvm use --silent 22 >/dev/null 2>&1
      export PORT="$PORT_PRIMARY"
      nohup yarn start > "$RUN/backstage.log" 2>&1 &
      echo $! > "$RUN/backstage.pid" )
    log "catalogue starting on $PORT_PRIMARY and backend on 7107 (pid $(cat "$RUN/backstage.pid")) -- first boot takes a minute"
    # WAIT FOR THE BACKEND, so the hourly run does not race its own child and the
    # caller (idp-verify) does not start probing a portal that is half up.
    for _ in $(seq 1 60); do backend_up && break; sleep 2; done
    backend_up && log "backend 7107 answering" || log "backend 7107 NOT up after 120s -- see $RUN/backstage.log"
  else
    log "catalogue already up on $PORT_PRIMARY and backend on 7107"
  fi
else
  log "catalogue NOT BUILT ($IDP/backstage/node_modules missing) -- nothing is serving"
fi

# 4. Publish on the tailnet. Not the public internet: the catalogue is a map of
#    every asset the estate owns, and LAW 21 says the default is closed. Going
#    public is bin/idp-publish, which is one command and the founder's call.
if TS_BIN="$(tailscale_bin)"; then
  # 8443 is only claimed when nothing holds it. This runs hourly under launchd,
  # and re-pointing it every hour would silently undo a hand-made change to
  # where the published link goes -- the link would move back on its own, which
  # is the worst kind of bug because it looks like it worked and then does not.
  # Captured, not piped: this script runs under `set -o pipefail`, so a failing
  # `tailscale serve status` would decide the branch instead of the match.
  serve_status=$("$TS_BIN" serve status 2>/dev/null || true)
  if printf '%s' "$serve_status" | grep ':8443' >/dev/null ; then
    log "publish   8443 already points somewhere -- left alone"
  else
    "$TS_BIN" serve --bg --http=8443 "http://127.0.0.1:$PORT_PRIMARY" >/dev/null 2>&1 || true
  fi
  # The published origin, read back from Tailscale rather than composed here: an https
  # Funnel entry is the only origin where a phone's browser will grant the microphone, and
  # the log has to say which one is actually live.
  host=$("$TS_BIN" status --json 2>/dev/null | jq -r '.Self.DNSName' | sed 's/\.$//')
  if printf '%s' "$serve_status" | grep -q ':8443'; then
    log "catalogue http://$host:8443/  (tailnet, http -- voice needs /publish for https)"
  else
    log "catalogue http://$host:8443/"
  fi
else
  log "publish   tailscale CLI not found -- :8443 NOT published, /fleet is localhost-only"
fi

"$IDP/bin/idp-status"

# 5. Up is not the same as correct. On 2026-08-24 Backstage rejected 141 of 194
#    entities and served the remaining 53 as a healthy-looking portal, so the
#    last step is proving what is published matches the inventory. --wait
#    because a cold Backstage takes a couple of minutes to ingest.
echo
"$IDP/bin/idp-verify" --wait
