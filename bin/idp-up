#!/usr/bin/env bash
# Start the catalogue and publish it on the tailnet.
#
# ONE RENDERER. Founder ruling, 2026-08-24: "ive seen 5 ui faces today", and
# "backstge is for catalog". Backstage is the catalogue and there is no second
# one. The Datasette fallback this script used to start on 8001 served the same
# facts under the title "Estate catalogue -- fallback renderer", which meant the
# owner of the estate met two pages claiming to be the catalogue and had no way
# to know which one to believe.
#
# The argument it was removed against was availability: a second renderer with
# no shared runtime survives a broken node_modules or a Backstage upgrade. That
# is a real property and it is not worth what it cost. A fallback nobody was
# told about is not availability, it is a second source of truth that is right
# by coincidence. If the portal being down during an upgrade becomes a real
# problem, the answer is to make the upgrade not take it down.
#
# IN A CONTAINER, NOT `yarn start`. Founder directive the same day: "we also
# cannot accept the brittle yarn start laptop hack ... containerize the
# application exactly as it will run in k8s". What this script used to do was
# source nvm, pin a Node path that exists on exactly one machine, and background
# a webpack dev server with nohup. The image is built by backstage/Dockerfile and
# run by backstage/compose.yml; both explain themselves. The k3s cluster takes
# the same image in Phase 2 and this script loses its compose lines.
#
#   catalogue   Backstage   container   127.0.0.1:3100
set -euo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
RUN="$IDP/logs"; mkdir -p "$RUN"
PORT_PRIMARY=3100
COMPOSE="$IDP/backstage/compose.yml"
ENVFILE="$IDP/backstage/.env"

log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

# 1. Regenerate the catalogue from the one source. db-gen stays: estate.db is
#    the queryable copy of the same facts, and dropping a renderer is not a
#    reason to stop producing the data underneath it.
"$IDP/bin/catalog-gen"
"$IDP/bin/db-gen"

# 2. The database password. Generated once, here, so there is no default
#    password in any file and nobody has to remember to change one. `umask 077`
#    rather than a chmod after the fact: the file is never briefly world-readable.
#    idp/.gitignore covers `**/.env`, and the value is never printed.
#
#    THE PASSWORD AND THE VOLUME ARE ONE PAIR, AND LOSING HALF BRICKS THE STACK.
#    Postgres reads POSTGRES_PASSWORD only when it initialises an empty data
#    directory. After that the password lives in the volume, and .env is the
#    only copy of the matching half. So a missing .env next to an existing
#    volume is not a fresh start -- it silently generates a password that
#    cannot ever match, and every Backstage plugin then fails with `password
#    authentication failed for user "backstage"`. Measured 2026-08-25: that is
#    exactly what happened here, and the top-level report was "catalogue FAILED
#    to become healthy" over 40 lines of plugin stack traces, none of which
#    named the cause. It cost a full debugging round to attribute.
#
#    Refuse only that one combination. .env present is always fine (it matches,
#    or it initialises); no .env and no volume is a genuine first boot.
PROJECT="$(basename "$(dirname "$COMPOSE")")"
PGVOL="${PROJECT}_pgdata"

if [ ! -f "$ENVFILE" ] && docker volume inspect "$PGVOL" >/dev/null 2>&1; then
  cat >&2 <<EOF
FATAL  $ENVFILE is missing but the volume $PGVOL already exists.

       Postgres took its password from that file when the volume was created,
       and the file was the only copy. Generating a new one here would produce
       a stack where every plugin fails authentication.

       The volume holds no source of truth -- Backstage re-ingests the whole
       catalogue from catalog/catalog-info.yaml on boot -- so the fix is to
       discard it and let both halves be created together:

           docker compose -f $COMPOSE down -v
           $0

       Do that only if you accept losing anything else in $PGVOL.
EOF
  exit 1
fi

if [ ! -f "$ENVFILE" ]; then
  ( umask 077; printf 'POSTGRES_PASSWORD=%s\n' "$(openssl rand -base64 30 | tr -d '\n/+=')" > "$ENVFILE" )
  log "secret    generated $ENVFILE (not printed, not committed)"
fi

# 3. The catalogue. `up -d` is idempotent -- compose reconciles to the declared
#    state, so running this hourly under launchd cannot start a second copy.
#    That is the whole reason the old probe-then-nohup shape is gone: it probed
#    127.0.0.1 while the dev server bound [::1], concluded "down" on every run,
#    and stacked another `yarn start` on a portal that was already serving.
if ! docker compose -f "$COMPOSE" up -d --wait --wait-timeout 300 2>&1 | sed 's/^/          /'; then
  log "catalogue FAILED to become healthy -- last 40 lines:"
  docker compose -f "$COMPOSE" logs --tail 40 catalogue | sed 's/^/          /'
  # Name the one cause the stack traces bury. Backstage reports a database
  # auth failure once per plugin, so the real line is thirteen frames deep and
  # reads like a code fault rather than a mismatched credential.
  if docker compose -f "$COMPOSE" logs catalogue 2>/dev/null | grep -q 'password authentication failed'; then
    log "cause     the password in $ENVFILE does not match the one inside $PGVOL."
    log "fix       docker compose -f $COMPOSE down -v && $0"
  fi
  exit 1
fi
log "catalogue up and healthy on 127.0.0.1:$PORT_PRIMARY"

# 4. Publish on the tailnet. Not the public internet: the catalogue is a map of
#    every asset the estate owns, and LAW 21 says the default is closed. Going
#    public is bin/idp-publish, which is one command and the founder's call.
if command -v tailscale >/dev/null; then
  # 8443 is only claimed when nothing holds it. This runs hourly under launchd,
  # and re-pointing it every hour would silently undo a hand-made change to
  # where the published link goes -- the link would move back on its own, which
  # is the worst kind of bug because it looks like it worked and then does not.
  if tailscale serve status 2>/dev/null | grep -q ':8443'; then
    log "publish   8443 already points somewhere -- left alone"
  else
    tailscale serve --bg --http=8443 "http://127.0.0.1:$PORT_PRIMARY" >/dev/null 2>&1 || true
  fi
  host=$(tailscale status --json | /usr/local/bin/jq -r '.Self.DNSName' | sed 's/\.$//')
  log "catalogue http://$host:8443/"
fi

"$IDP/bin/idp-status"

# 5. Up is not the same as correct. On 2026-08-24 Backstage rejected 141 of 194
#    entities and served the remaining 53 as a healthy-looking portal, so the
#    last step is proving what is published matches the inventory. --wait
#    because a cold Backstage takes a couple of minutes to ingest.
echo
"$IDP/bin/idp-verify" --wait
