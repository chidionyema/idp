#!/usr/bin/env python3
"""Remind every commit/push stage to operationalise proven, reversible work early.

This is deliberately non-blocking: risk decides immediacy, not ceremony. High-blast-radius paths
require a rollback and monitoring assessment first; low-risk work that removes repeated friction
can be deployed and measured without waiting for the Greenlane.
"""

from __future__ import annotations

import argparse
import os
import subprocess

HIGH_RISK = (
    ".github/",
    ".githooks/",
    "clusters/",
    "deploy/",
    "installer/",
    "platform/estate/governance/",
    "platform/intercloud/",
    "platform/llm/",
    "platform/muster/",
    "policy/",
    "scheduler/",
)


def assess(paths: list[str]) -> dict[str, str]:
    """A bounded, deterministic first-pass risk assessment."""
    high = [path for path in paths if path.startswith(HIGH_RISK)]
    if high:
        return {
            "risk": "high",
            "next": (
                "assess blast radius and rollback, deploy the reversible slice if it is safe, "
                "capture yield now"
            ),
        }
    return {
        "risk": "low",
        "next": (
            "operationalise now where reversible, capture yield with before/after evidence, "
            "then let Greenlane ratify the landed tree"
        ),
    }


def changed_paths() -> list[str]:
    for argv in (
        ["git", "diff", "--cached", "--name-only"],
        ["git", "diff", "--name-only"],
    ):
        proc = subprocess.run(argv, capture_output=True, text=True)
        if proc.returncode == 0 and proc.stdout.strip():
            return [line for line in proc.stdout.splitlines() if line.strip()]
    return []


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--stage", required=True, choices=("commit", "pre-push", "push"))
    parser.add_argument("--instruction", default=os.environ.get("ESTATE_INSTRUCTION", ""))
    parser.add_argument("--paths", default="")
    args = parser.parse_args()

    paths = (
        [path for path in args.paths.split(",") if path]
        if args.paths
        else changed_paths()
    )
    verdict = assess(paths)
    print(
        f"OPERATIONALISE NOW [{args.stage}]: {verdict['next']}. "
        "Do not wait for Greenlane when the change is reversible, measured and fixes a "
        "repeated failure."
    )
    if args.instruction:
        print(
            f"  capture yield: bin/instruction evidence {args.instruction} "
            "--kind yield --ref '<before/after metric + command output>'"
        )
    else:
        print(
            "  capture yield: bind the INS-* instruction, then run "
            "`bin/instruction evidence <id> --kind yield --ref '<before/after>'`"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
