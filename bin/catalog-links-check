#!/usr/bin/env python3
"""crew#269 row 3: a Component the founder cannot open is refused.

Founder, 2026-08-25: "how do i know what the backstage url is". Row 2 put every
published hostname into the catalogue as an Open link; this row keeps it there.
Every Component (a service or a website: the things a person opens) must carry
at least one `links[].url` that is http(s) and fully substituted. Resources
(ledgers, guards, scheduled jobs, ports) are files and sockets, not pages, and
are not graded here. Measured on the 2026-08-25T20:59Z inventory before this
gate: 24 Components, 2 with no URL (AwesomeProject, mumchimp-medusa).

Usage: catalog-links-check [catalog-info.yaml]   (default: catalog/ in this checkout)
Exit 0 and one `catalog: every entity carries a URL` line, or exit 1 naming each
offender. Exit 2 when the file is missing: BLIND, never a pass.
"""
import os
import sys

import yaml

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
path = sys.argv[1] if len(sys.argv) > 1 else os.path.join(IDP, "catalog", "catalog-info.yaml")
if not os.path.isfile(path):
    print(f"catalog: BLIND no {path}", file=sys.stderr)
    sys.exit(2)
with open(path) as f:
    docs = [d for d in yaml.safe_load_all(f) if d]
components = [d for d in docs if d.get("kind") == "Component"]
bad = []
for d in components:
    urls = [l.get("url", "") for l in (d.get("metadata", {}).get("links") or [])]
    if not any(u.startswith(("http://", "https://")) and "${" not in u for u in urls):
        a = d["metadata"].get("annotations", {})
        bad.append(f"{d['metadata']['name']} ({a.get('estate/path') or a.get('estate/route') or '?'})")
if bad:
    print(f"catalog: {len(bad)} of {len(components)} Components carry no URL a person can open:")
    for b in bad:
        print(f"  {b}")
    print("  a repo needs a git remote on github.com (LAW 24); a route needs its hostname in the catalogue")
    sys.exit(1)
print(f"catalog: every entity carries a URL ({len(components)} Components)")
