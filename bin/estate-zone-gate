#!/usr/bin/env python3
"""The estate's DNS zone is written once, in clusters/<cluster>/estate-config.yaml (ESTATE_ZONE).
Founder, 2026-08-26 (crew#269): "as always configurable". Every other platform file refers to it
as ${ESTATE_ZONE}, substituted by Flux postBuild, so a zone migration is one value and a reconcile.
Spec: features/gates/estate-zone.feature.
Scanned: platform/** (same suffixes as cloud-agnostic-gate). Exempt: platform/oci (the compute
provisioner records the host it measured), clusters/* (where the value lives) and platform/ai (the AI Act
register is data read by bin/ai-act-gate and bin/conformity-report, never substituted by Flux). Comment lines are
not counted. Exit 0 clean, 1 with each literal printed, 2 (BLIND) when no config declares a zone
or the root cannot be read: a gate that lost its evidence reports BLIND, never a verdict.
Proved both ways in bin/idp-ci on tests/fixtures/estate-zone/{good,bad}.
"""
import os
import pathlib
import re
import sys

ROOT = pathlib.Path(os.environ.get("ESTATE_ZONE_ROOT") or pathlib.Path(__file__).resolve().parents[1])
SCAN = ["platform"]
EXEMPT = ("platform/oci/", "clusters/", "platform/ai/")  # platform/ai: the AI Act register, read as data by ai-act-gate and conformity-report, never templated by Flux; it records the URL of a live system
SUFFIXES = {".yaml", ".yml", ".py", ".ts", ".tf", ".sh", ".json", ".env"}
ZONE_KEY = re.compile(r"^\s*ESTATE_ZONE:\s*['\"]?([A-Za-z0-9.-]+)['\"]?\s*$", re.M)


def zones() -> set[str]:
    found = set()
    for f in sorted((ROOT / "clusters").rglob("estate-config.yaml")):
        found.update(ZONE_KEY.findall(f.read_text()))
    return found


def main() -> int:
    if not ROOT.is_dir():
        print(f"BLIND: {ROOT} is not a directory")
        return 2
    zs = zones()
    if not zs:
        print("BLIND: no clusters/*/estate-config.yaml declares ESTATE_ZONE")
        return 2
    pat = re.compile(r"(?<![A-Za-z0-9-])(" + "|".join(re.escape(z) for z in sorted(zs)) + r")(?![A-Za-z0-9-])")
    hits = []
    for top in SCAN:
        for f in sorted((ROOT / top).rglob("*")):
            if not f.is_file() or f.suffix not in SUFFIXES:
                continue
            rel = f.relative_to(ROOT).as_posix()
            if rel.startswith(EXEMPT):
                continue
            for n, line in enumerate(f.read_text(errors="replace").splitlines(), 1):
                if line.lstrip().startswith("#"):
                    continue
                if pat.search(line):
                    hits.append(f"{rel}:{n}: {line.strip()}")
    for h in hits:
        print(h)
    print(f"{'FAIL' if hits else 'ok'}    zone     {len(hits)} literal zone name(s) outside clusters/*/estate-config.yaml; zone(s): {', '.join(sorted(zs))}")
    return 1 if hits else 0


if __name__ == "__main__":
    sys.exit(main())
