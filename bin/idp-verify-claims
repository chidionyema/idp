#!/usr/bin/env python3
"""A claim is a command the pipeline runs, never text the author types (crew#628 CP1).

WHY. Founder, 2026-08-29 14:2xZ: "WHAT HAPPENED TO OUR VERIFICATION LAYER/STACK BECAUSE
EVERYONE IS NOW BULLSHITTING", "NO ONE IS PROVING OR VERIFYING ANYTHING"; 21:0xZ: "CREW HAVE
TO ... MONITOR THEIR STATEMENTS AGAINST REALITY". Measured on crew#628: 30 guards read the PR
body or the command line, none reads the world; bin/idp-catalog-push exited 0 on a ghcr 403
across 10 merges that each carried a complete, hand-typed evidence block.

WHAT IT DOES. Reads the pull request body, takes every `Verify:` line, runs each command on
the runner, and writes the real output back into the body between the verify-claims markers.
A red command is a red check. A pull request that touches platform/, clusters/ or bin/idp-*
with no `Verify:` line is red too: a change to the world with no claim about the world.

  Verify: `bin/idp-cluster-state`
  Verify: `python3 -m pytest -q tests/test_x.py`
  Verify: `curl -sSf -o /dev/null -w '%{http_code}' https://catalogue.example/`

ONLY READS. A Verify command may observe (bin/idp-*, kubectl get/describe, flux get, curl,
gh, python3, pytest); a command that would change the world (apply, delete, patch, push,
merge, dispatch, run, create, edit) is refused before it runs. The verifier proves; it never
acts (founder 2026-08-29: no crew path to production).

WHAT IT CANNOT SEE (LAW 45 step 5). It proves the command's output on the runner at that
moment, not that the command is the right claim; an author can name a weak command. The
audit of that is a human's (crew#652). A command that needs cluster credentials the workflow
did not provide comes back BLIND (exit 2 from the tool) and is graded red, never green.

Modes: --pr N [--repo owner/name] [--dry-run]; --selftest (offline decision table).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys

START = "<!-- verify-claims:start -->"
END = "<!-- verify-claims:end -->"
VERIFY = re.compile(r"(?m)^Verify:\s*`([^`\n]+)`\s*$")
WORLD_PATHS = re.compile(r"^(platform/|clusters/|bin/idp-)")
ALLOWED_HEADS = (
    "bin/idp-",
    "bin/",
    "python3",
    "pytest",
    "kubectl get",
    "kubectl describe",
    "flux get",
    "curl",
    "gh ",
    "jq",
    "grep",
    "test ",
    "ls ",
)
FORBIDDEN = re.compile(
    r"\b(apply|delete|patch|push|merge|dispatch|create|edit|rollout|scale|exec|cp|rm|mv|sed -i|tee|workflow run|reconcile|suspend|resume)\b"
)
TAIL_LINES = 40
TIMEOUT = 300


def claims(body: str) -> list[str]:
    return VERIFY.findall(body or "")


def allowed(cmd: str) -> str | None:
    """None when the command may run; otherwise the reason it may not."""
    c = cmd.strip()
    if not c.startswith(ALLOWED_HEADS):
        return f"not an observing command (must start with one of {', '.join(ALLOWED_HEADS)})"
    if FORBIDDEN.search(c):
        return "names a world-changing verb; the verifier only observes"
    return None


def run_one(cmd: str, cwd: str) -> dict:
    why = allowed(cmd)
    if why:
        return {"cmd": cmd, "exit": 99, "out": f"REFUSED: {why}"}
    try:
        p = subprocess.run(
            cmd, shell=True, cwd=cwd, capture_output=True, text=True, timeout=TIMEOUT
        )
        out = (p.stdout + p.stderr).strip().splitlines()
        return {"cmd": cmd, "exit": p.returncode, "out": "\n".join(out[-TAIL_LINES:])}
    except subprocess.TimeoutExpired:
        return {"cmd": cmd, "exit": 124, "out": f"TIMEOUT after {TIMEOUT}s"}


def section(results: list[dict], run_url: str, touches_world: bool) -> str:
    lines = [
        START,
        "## Verification evidence (generated)",
        f"Generated by `bin/idp-verify-claims` in {run_url or 'a local run'}; nothing here was typed by the author.",
    ]
    if not results:
        lines.append(
            "No `Verify:` line in this pull request."
            + (
                " It touches the world (platform/, clusters/ or bin/idp-*), so this is RED."
                if touches_world
                else ""
            )
        )
    for r in results:
        mark = "ok " if r["exit"] == 0 else "RED"
        lines += [
            f"- {mark} `{r['cmd']}` exit {r['exit']}",
            "```",
            r["out"] or "(no output)",
            "```",
        ]
    lines.append(END)
    return "\n".join(lines)


def splice(body: str, new: str) -> str:
    body = body or ""
    if START in body and END in body:
        return body[: body.index(START)] + new + body[body.index(END) + len(END) :]
    return body.rstrip() + "\n\n" + new + "\n"


def verdict(results: list[dict], touches_world: bool) -> int:
    if not results:
        return 1 if touches_world else 0
    return 1 if any(r["exit"] != 0 for r in results) else 0


def gh(args: list[str]) -> str:
    return subprocess.run(
        ["gh", *args], check=True, capture_output=True, text=True
    ).stdout


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--pr")
    ap.add_argument("--repo", default=os.environ.get("GITHUB_REPOSITORY"))
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    if not a.pr:
        ap.error("--pr is required")
    info = json.loads(
        gh(["pr", "view", a.pr, "--repo", a.repo, "--json", "body,files"])
    )
    touches_world = any(WORLD_PATHS.match(f["path"]) for f in info.get("files", []))
    results = [run_one(c, os.getcwd()) for c in claims(info.get("body", ""))]
    run_url = os.environ.get("RUN_URL", "")
    new = section(results, run_url, touches_world)
    print(new)
    if not a.dry_run:
        num = gh(
            [
                "pr",
                "view",
                a.pr,
                "--repo",
                a.repo,
                "--json",
                "number",
                "--jq",
                ".number",
            ]
        ).strip()
        subprocess.run(
            [
                "gh",
                "api",
                "-X",
                "PATCH",
                f"repos/{a.repo}/pulls/{num}",
                "-f",
                "body=" + splice(info.get("body", ""), new),
            ],
            check=True,
            capture_output=True,
            text=True,
        )
    return verdict(results, touches_world)


def selftest() -> int:
    body = "Text\nVerify: `bin/idp-cluster-state`\nVerify: `python3 -c 'print(1)'`\nVerify: `kubectl apply -f x`\n"
    cases = [
        ("three claims parsed", len(claims(body)), 3),
        ("observing command allowed", allowed("bin/idp-cluster-state"), None),
        ("apply refused", allowed("kubectl apply -f x") is not None, True),
        ("push refused", allowed("gh pr merge 1") is not None, True),
        ("a shell rm refused", allowed("rm -rf /") is not None, True),
        ("green results pass", verdict([{"exit": 0}], True), 0),
        ("one red result fails", verdict([{"exit": 0}, {"exit": 1}], False), 1),
        ("no claim on a world change fails", verdict([], True), 1),
        ("no claim on a doc change passes", verdict([], False), 0),
        (
            "splice replaces the old section",
            splice(
                "a\n" + START + "\nold\n" + END + "\nz", START + "\nnew\n" + END
            ).count("old"),
            0,
        ),
        (
            "splice appends when absent",
            splice("a", START + "\nnew\n" + END).count("new"),
            1,
        ),
        (
            "real command runs",
            run_one("python3 -c 'print(42)'", os.getcwd())["out"],
            "42",
        ),
    ]
    bad = [c for c in cases if c[1] != c[2]]
    for n, got, want in cases:
        print(f"  {'ok ' if got == want else 'BAD'} {n}: got {got!r}, want {want!r}")
    print(json.dumps({"cases": len(cases), "failed": len(bad)}))
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
