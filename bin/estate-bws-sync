#!/usr/bin/env python3
from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HOME = Path.home()
ROOT = HOME / ".estate" / "secrets" / "bws"
IDENTITY = "https://identity.bitwarden.com"
API = "https://api.bitwarden.com"
ORG = "a9f79fcf-7059-4bad-94ab-b4b900acc259"
VAULT = "/Users/roseonyema/Documents/code/idp/bin/idp-cloud"
IDP = "/Users/roseonyema/Documents/code/idp"
SOPS = "/usr/local/bin/sops"
AGE_KEY = HOME / ".config" / "prospector" / "age-key.txt"
INTERVAL = 10
STOP = False


def recipient() -> str:
    env = (os.environ.get("BWS_SOPS_RECIPIENT") or "").strip()
    if env:
        return env
    try:
        for line in AGE_KEY.read_text().splitlines():
            m = re.search(r"public key:\s*(age1\w+)", line)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def log(msg: str) -> None:
    print(time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()) + " " + msg, flush=True)


def write_atomic(path: Path, data: str, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(data)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def read_json(path: Path, default: dict) -> dict:
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def token(arg_file: str, sops_file: str) -> tuple[str, str]:
    env = (os.environ.get("BWS_ACCESS_TOKEN") or "").strip()
    if env:
        return env, "env"
    if arg_file:
        try:
            v = Path(arg_file).read_text().strip()
            if v:
                return v, "file"
        except OSError:
            pass
    if sops_file and Path(sops_file).exists():
        try:
            out = subprocess.run([SOPS, "-d", "--extract", '["token"]', sops_file],
                                 capture_output=True, text=True, timeout=15,
                                 env={**os.environ, "SOPS_AGE_KEY_FILE": str(AGE_KEY)})
            v = out.stdout.strip().strip('"')
            if out.returncode == 0 and v:
                return v, "sops"
        except (subprocess.SubprocessError, OSError):
            pass
    for _ in range(2):
        try:
            p = subprocess.run([VAULT, "secret", "get", "bitwarden-machine"],
                               capture_output=True, text=True, timeout=15, cwd=IDP)
        except subprocess.TimeoutExpired:
            continue
        except (subprocess.SubprocessError, OSError):
            return "", "unreadable"
        v = p.stdout.strip()
        return (v, "estate-vault") if v else ("", "none")
    return "", "unreadable"


def auth(identity: str, tok: str) -> tuple[str, str]:
    for cid in ("user", "organization"):
        body = urllib.parse.urlencode({"grant_type": "client_credentials", "client_id": cid,
                                       "client_secret": tok, "scope": "api.secrets"}).encode()
        req = urllib.request.Request(identity.rstrip("/") + "/connect/token", data=body,
                                     headers={"Content-Type": "application/x-www-form-urlencoded"})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                at = json.loads(r.read().decode()).get("access_token") or ""
            if at:
                return at, ""
        except urllib.error.HTTPError as exc:
            last = "rejected:%d" % exc.code
        except OSError:
            last = "unreachable"
    return "", last if "last" in dir() else "unreachable"


def fetch(api: str, at: str, org: str) -> list[dict]:
    out: list[dict] = []
    cont = None
    for _ in range(20):
        url = "%s/secrets?organizationId=%s" % (api.rstrip("/"), org)
        if cont:
            url += "&continuationToken=" + urllib.parse.quote(cont)
        req = urllib.request.Request(url, headers={"Authorization": "Bearer " + at,
                                                   "Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            d = json.loads(r.read().decode())
        if not isinstance(d.get("data"), list):
            raise ValueError("secret list missing")
        out += d["data"]
        cont = d.get("continuationToken")
        if not cont:
            break
    return out


def encrypt(value: str, dest: Path, rcpt: str) -> None:
    plain = dest.with_suffix(".plain.tmp")
    write_atomic(plain, "value: " + json.dumps(value) + "\n")
    enc = dest.with_suffix(".enc.tmp")
    p = subprocess.run([SOPS, "-e", "--age", rcpt, "--input-type", "yaml",
                        "--output-type", "yaml", str(plain)],
                       capture_output=True, text=True, timeout=30)
    try:
        if p.returncode != 0:
            raise RuntimeError("sops failed: " + (p.stderr or "").strip()[:200])
        write_atomic(enc, p.stdout)
        os.replace(enc, dest)
    finally:
        for f in (plain, enc):
            try:
                f.unlink()
            except OSError:
                pass


def audit(path: Path, action: str, key: str, rev: str, value: str) -> None:
    line = json.dumps({"ts": int(time.time()), "action": action, "key": key, "revision": rev,
                       "sha256": hashlib.sha256(value.encode()).hexdigest()[:16],
                       "bytes": len(value)}, sort_keys=True)
    with path.open("a") as fh:
        fh.write(line + "\n")


def metrics(path: Path, st: dict, events: dict) -> None:
    lines = [
        "# HELP bws_sync_last_success_timestamp_seconds Last complete reconciliation.",
        "# TYPE bws_sync_last_success_timestamp_seconds gauge",
        "bws_sync_last_success_timestamp_seconds %d" % st.get("last_success", 0),
        "# HELP bws_sync_secrets Secrets currently mirrored.",
        "# TYPE bws_sync_secrets gauge",
        "bws_sync_secrets %d" % st.get("secrets", 0),
        "# HELP bws_sync_state 1 when the sync is healthy.",
        "# TYPE bws_sync_state gauge",
        "bws_sync_state %d" % (1 if st.get("state") == "ok" else 0),
        "# HELP bws_sync_events_total Applied changes by action.",
        "# TYPE bws_sync_events_total counter",
    ]
    for action, n in sorted(events.items()):
        lines.append('bws_sync_events_total{action="%s"} %d' % (action, n))
    write_atomic(path, "\n".join(lines) + "\n", 0o644)


def cycle(cfg: dict) -> dict:
    root: Path = cfg["root"]
    state_path = root / "state.json"
    state = read_json(state_path, {"keys": {}, "events": {}})
    tok, source = token(cfg["token_file"], cfg["token_sops"])
    if not tok:
        return finish(root, state, "auth_rejected" if source in ("none", "unreadable") else "no_token",
                      "credential %s" % source)
    at, why = auth(cfg["identity"], tok)
    if not at:
        return finish(root, state, "auth_rejected", "identity %s" % why)
    try:
        secrets = fetch(cfg["api"], at, cfg["org"])
    except (urllib.error.URLError, OSError, ValueError) as exc:
        return finish(root, state, "unreachable", repr(exc)[:160])

    rcpt = cfg["recipient"]
    keys = state.get("keys", {})
    events = state.get("events", {})
    seen = set()
    changed = 0
    for s in secrets:
        key = s.get("key") or ""
        if not key or not re.fullmatch(r"[A-Za-z0-9_.-]{1,120}", key):
            continue
        seen.add(key)
        rev = str(s.get("revisionDate") or "")
        value = s.get("value") or ""
        sha = hashlib.sha256(value.encode()).hexdigest()
        prev = keys.get(key) or {}
        if prev.get("rev") == rev and prev.get("sha") == sha:
            continue
        dest = root / "secrets" / (key + ".yaml")
        encrypt(value, dest, rcpt)
        action = "update" if prev else "add"
        keys[key] = {"rev": rev, "sha": sha, "at": int(time.time())}
        events[action] = events.get(action, 0) + 1
        audit(root / "audit.jsonl", action, key, rev, value)
        changed += 1
        log("%s %s rev=%s" % (action, key, rev[:10]))

    missing = [k for k in keys if k not in seen]
    if missing and not secrets and keys:
        state["empty_streak"] = state.get("empty_streak", 0) + 1
        if state["empty_streak"] < 2:
            return finish(root, state, "suspicious_empty",
                          "%d mirrored but the source returned none; deletions held" % len(keys))
    state["empty_streak"] = 0
    if missing and (secrets or state["empty_streak"] >= 2):
        for k in missing:
            try:
                (root / "secrets" / (k + ".yaml")).unlink()
            except OSError:
                pass
            keys.pop(k, None)
            events["delete"] = events.get("delete", 0) + 1
            audit(root / "audit.jsonl", "delete", k, "", "")
            changed += 1
            log("delete %s" % k)

    state["keys"] = keys
    state["events"] = events
    state["secrets"] = len(keys)
    state["last_success"] = int(time.time())
    write_atomic(state_path, json.dumps(state, indent=2, sort_keys=True) + "\n")
    return finish(root, state, "ok", "%d changed" % changed)


def finish(root: Path, state: dict, status: str, reason: str) -> dict:
    root.mkdir(parents=True, exist_ok=True)
    state["state"] = status
    state["reason"] = reason
    state["at"] = int(time.time())
    write_atomic(root / "state.json", json.dumps(state, indent=2, sort_keys=True) + "\n")
    write_atomic(root / "status.json", json.dumps(
        {"state": status, "reason": reason, "at": state["at"],
         "secrets": state.get("secrets", 0),
         "last_success": state.get("last_success", 0)}, indent=2, sort_keys=True) + "\n", 0o644)
    metrics(root / "metrics.prom", state, state.get("events", {}))
    return state


def main() -> int:
    ap = argparse.ArgumentParser(prog="estate-bws-sync")
    ap.add_argument("--once", action="store_true")
    ap.add_argument("--interval", type=int, default=INTERVAL)
    ap.add_argument("--root", default=str(ROOT))
    ap.add_argument("--identity", default=IDENTITY)
    ap.add_argument("--api", default=API)
    ap.add_argument("--org", default=ORG)
    ap.add_argument("--token-file", default="")
    ap.add_argument("--token-sops", default=str(HOME / ".estate" / "secrets" / "dev" / "bitwarden-machine.yaml"))
    a = ap.parse_args()
    cfg = {"root": Path(a.root), "identity": a.identity, "api": a.api, "org": a.org,
           "token_file": a.token_file, "token_sops": a.token_sops, "recipient": recipient()}
    if not cfg["recipient"]:
        log("no age recipient; refusing to write plaintext")
        return 2
    if a.once:
        st = cycle(cfg)
        log("state=%s reason=%s secrets=%d" % (st["state"], st.get("reason"), st.get("secrets", 0)))
        return 0 if st["state"] == "ok" else 1

    def stop(*_):
        global STOP
        STOP = True

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    log("sync start identity=%s api=%s interval=%ds root=%s" % (a.identity, a.api, a.interval, a.root))
    while not STOP:
        st = cycle(cfg)
        log("state=%s reason=%s secrets=%d" % (st["state"], st.get("reason"), st.get("secrets", 0)))
        wait = a.interval if st["state"] == "ok" else max(a.interval, 60)
        for _ in range(wait * 10):
            if STOP:
                break
            time.sleep(0.1)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
