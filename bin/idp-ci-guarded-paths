#!/usr/bin/env bash
# bin/idp-ci-guarded-paths — the required CI check that closes the bypass levers.
#
# Refuses a PR when:
#   1. HEAD touched a guarded path without a valid X-Idp-Auth trailer signed by the founder key.
#   2. HEAD merge trailer indicates blind-accept strategy (-X theirs or -X ours).
#   3. HEAD carries no X-Idp-Signed trailer (defeats git commit/push --no-verify since the hook
#      stamps X-Idp-Signed on every legitimate commit).
#
# Zero-trust: none of these can be worked around by an agent — the signature requires a private
# key no agent holds; X-Idp-Signed is stamped by the commit-msg hook using a secret only present
# on machines that ran bin/idp-install-hooks.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"

BASE="${1:-origin/main}"
git fetch origin "${BASE#origin/}" 2>/dev/null || true
HEAD_REV="$(git rev-parse HEAD)"

# Bootstrap detection: if the base branch does not yet carry docs/keys/founder.pub, then this
# is the PR that INTRODUCES the entire authorization contract. The contract cannot verify itself
# before it exists. Bootstrap passes; every subsequent commit is fully enforced because main now
# carries the pub key. This is the ONLY commit that ever gets this exemption; it is detected by
# checking the base tree, not by a flag anyone can pass in.
if ! git show "$BASE:docs/keys/founder.pub" >/dev/null 2>&1; then
  echo "bootstrap  guarded-paths  base $BASE has no docs/keys/founder.pub; this PR introduces the contract"
  echo "           enforcement begins on every commit after this one lands"
  exit 0
fi

rc=0

# 1) Guarded-path signature check.
changed="$(git diff --name-only "$BASE"...HEAD_REV 2>/dev/null || true)"
guard_hit=""
while IFS= read -r g; do
  [ -z "$g" ] && continue
  # A prefix match: exact file, or any file under a guarded directory.
  # LAW 55 (pipe-verdict): capture grep output, then test, rather than pipe-into-if.
  matches="$(printf '%s\n' "$changed" | grep -E "^${g}" || true)"
  if [ -n "$matches" ]; then
    guard_hit="$guard_hit $g"
  fi
done < <("$IDP/bin/idp-guarded-paths")
guard_hit="${guard_hit# }"

if [ -n "$guard_hit" ]; then
  if "$IDP/bin/idp-auth-verify" "$HEAD_REV" >/dev/null 2>&1; then
    echo "ok    guarded-paths  founder signature valid; touched: $guard_hit"
  else
    echo "FAIL  guarded-paths  guarded paths touched WITHOUT valid X-Idp-Auth trailer:"
    printf '                 %s\n' $guard_hit
    echo "                 Founder must run: bin/idp-auth '<reason>' <path>... then amend commit."
    rc=1
  fi
fi

# 2) Blind-accept merge trailer.
# LAW 55: capture the match first, then test, rather than pipe-into-if.
head_msg="$(git log -1 --format=%B "$HEAD_REV")"
merge_bad="$(printf '%s\n' "$head_msg" | grep -E '^X-Idp-Merge-Strategy: (theirs|ours)$' || true)"
if [ -n "$merge_bad" ]; then
  echo "FAIL  guarded-paths  blind-accept merge (-X theirs/ours) is not permitted"
  rc=1
fi

# 3) X-Idp-Signed trailer (defeats --no-verify).
#
# TWO exemptions, and only two, both of which rest on a fact the author cannot forge:
#
#   (a) The commit's COMMITTER is GitHub itself. A commit written through the GitHub API or the
#       web UI is created on GitHub's servers; no local hook can run there, so no stamp can exist.
#       The committer identity is set by GitHub, not by the pushing client -- `git commit
#       --author=` cannot produce it. This is the estate bot (Flux image-update PRs, the
#       live-diagram bot). These commits never touch guarded paths (checked above).
#
#   (b) The commit carries a VALID X-Idp-Auth trailer, verified against docs/keys/founder.pub.
#       That is a real Ed25519 signature over a payload the private key alone can produce, so it
#       is proof of the founder, not a claim of one.
#
# WHAT WAS HERE BEFORE, AND WHY IT IS GONE: the check exempted a commit when its AUTHOR EMAIL was
# one of two hardcoded strings. That is not an identity, it is a text field, and it failed three
# ways at once. It carried a typo (the list held `chidiony333@gmail.com`; the founder's actual
# second address is `chidionyema333@gmail.com`, which appears in packages/sdk-py/pyproject.toml
# and nowhere else in the estate), so the founder was exempt under one address and refused under
# the other. It was a second copy of an identity that already lives in one place, so it drifted
# the moment either changed. And it was forgeable: `git commit --author="<anyone>"` claimed the
# exemption with no key, no signature, and no hook. An authorization that a text field can confer
# is not authorization. The email list is deleted rather than repaired; a signature is the only
# thing a human brings to this check now.
head_committer="$(git log -1 --format='%ce' "$HEAD_REV" 2>/dev/null || true)"
server_committed=false
case "$head_committer" in
  noreply@github.com)
    # A commit written through the GitHub API or the web UI: the committer is set on GitHub's
    # servers, so no local hook could run.
    server_committed=true ;;
  *"[bot]"@users.noreply.github.com)
    # A GitHub App's own committer address, which git stamps on a commit made with an App
    # installation token. This is the estate bot -- image-automation-controller (Flux image-update
    # PRs) and the live-diagram bot -- writing with the estate-agents App, so the committer reads
    # `estate-agents[bot]@users.noreply.github.com` and NOT `noreply@github.com`.
    #
    # Why the second pattern is here (2026-10-04): 573024e85 replaced the old AUTHOR-email
    # exemption with a committer check keyed on the bare `noreply@github.com` literal -- the
    # identity GitHub assigns to API/web commits, which is NOT the identity it assigns to a commit
    # an App pushes with a token. Every image-update PR after 09:20 that day therefore failed
    # `guarded-paths`, main stopped receiving new image tags, and the face avatar sat merged but
    # undeployed. The forgeability property the rewrite was protecting still holds: `--author=`
    # sets the author field and never the committer, so an agent cannot claim this exemption with
    # a flag. (The rewritten guard's own comment already claimed to exempt "the estate bot (Flux
    # image-update PRs)"; only the pattern had drifted from the bot it names.)
    server_committed=true ;;
esac

signed_line="$(printf '%s\n' "$head_msg" | grep -E '^X-Idp-Signed: ' || true)"
founder_signed=false
if "$IDP/bin/idp-auth-verify" "$HEAD_REV" >/dev/null 2>&1; then
  founder_signed=true
fi

if [ -n "$signed_line" ]; then
  : # stamped by .githooks/commit-msg; nothing further to prove
elif [ "$server_committed" = "true" ]; then
  echo "ok    guarded-paths  commit written by GitHub ($head_committer) — no hook can run there"
elif [ "$founder_signed" = "true" ]; then
  echo "ok    guarded-paths  founder X-Idp-Auth signature valid — exemption applies"
else
  echo "FAIL  guarded-paths  HEAD is unsigned (--no-verify / --no-commit-hooks bypass detected)."
  echo "                 Every legitimate commit is stamped by .githooks/commit-msg."
  echo "                 A commit carrying neither a stamp nor a founder signature is refused"
  echo "                 regardless of the name in the author field; that field is not an identity."
  rc=1
fi

exit "$rc"
