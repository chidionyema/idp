#!/usr/bin/env bash
# bin/idp-ci-guarded-paths — the required CI check that closes the bypass levers.
#
# Refuses a PR when:
#   1. HEAD touched a guarded path without a valid X-Idp-Auth trailer signed by the founder key.
#   2. HEAD merge trailer indicates blind-accept strategy (-X theirs or -X ours).
#   3. HEAD carries no X-Idp-Signed trailer (defeats git commit/push --no-verify since the hook
#      stamps X-Idp-Signed on every legitimate commit).
#   4. HEAD introduces a .claude/, claude-code/ or .pi/ path -- any harness's own per-project
#      folder. The estate is model- and harness-agnostic (AGENTS.md R6); a harness folder is a
#      second execution boundary and gets deleted, not authorized. Unlike 1-3 this has no
#      signature override — .githooks/pre-push checks the same thing client-side, but a bot
#      commit, a hookless machine or a GitHub-UI merge skips that hook, which is why .claude/
#      kept coming back; .pi/ is banned pre-emptively so pi (or any future harness) never starts
#      the same pattern.
#
# Zero-trust: none of these can be worked around by an agent — the signature requires a private
# key no agent holds; X-Idp-Signed is stamped by the commit-msg hook using a secret only present
# on machines that ran bin/idp-install-hooks.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"

BASE="${1:-origin/main}"
git fetch origin "${BASE#origin/}" 2>/dev/null || true
HEAD_REV="$(git rev-parse HEAD)"
# A base that does not resolve is not a bootstrap: until 2026-09-29 any git failure here (a typo'd
# or unfetched base) took the exemption below and passed the PR unchecked.
if ! git rev-parse --verify --quiet "$BASE^{commit}" >/dev/null; then
  echo "FAIL  guarded-paths  base $BASE does not resolve to a commit; refusing rather than guessing"
  exit 1
fi
# Bug fixed here: this was the bare word HEAD_REV, not $HEAD_REV, so git resolved an unknown ref,
# the range always errored, and `2>/dev/null || true` swallowed it -- `changed` was always empty
# and check 1 below had never actually matched anything since it was written.
# And a diff that cannot be computed refuses the PR (2026-09-29, #5069): `|| true` here turned a
# failed diff into "nothing changed", which is the same fail-open the typo produced.
if ! changed="$(git diff --name-only "$BASE"..."$HEAD_REV")"; then
  echo "FAIL  guarded-paths  cannot diff $BASE...$HEAD_REV, so cannot tell what this PR touches"
  exit 1
fi

rc=0

# 0) Harness-folder ban (.claude/, claude-code/, .pi/) -- unconditional, no signature or bootstrap
# exemption. Runs before the bootstrap check below because it guards a different contract
# (model-agnosticism, AGENTS.md R6), not the founder-signature one, and must hold even on the PR
# that bootstraps that.
harness_hit="$(printf '%s\n' "$changed" | grep -E '(^|/)\.claude/|(^|/)claude-code/|(^|/)\.pi/' || true)"
if [ -n "$harness_hit" ]; then
  echo "FAIL  guarded-paths  harness-specific path introduced (AGENTS.md R6: the estate is model-"
  echo "                 and harness-agnostic; one execution boundary, ~/.estate/):"
  printf '                 %s\n' "$harness_hit"
  rc=1
fi

# Bootstrap detection: if the base branch does not yet carry docs/keys/founder.pub, then this
# is the PR that INTRODUCES the entire authorization contract. The contract cannot verify itself
# before it exists. Bootstrap passes; every subsequent commit is fully enforced because main now
# carries the pub key. This is the ONLY commit that ever gets this exemption; it is detected by
# checking the base tree, not by a flag anyone can pass in.
if ! git show "$BASE:docs/keys/founder.pub" >/dev/null 2>&1; then
  echo "bootstrap  guarded-paths  base $BASE has no docs/keys/founder.pub; this PR introduces the contract"
  echo "           enforcement begins on every commit after this one lands"
  exit "$rc"
fi

# 1) Guarded-path signature check.
guard_hit=""
while IFS= read -r g; do
  [ -z "$g" ] && continue
  # A prefix match: exact file, or any file under a guarded directory.
  # LAW 55 (pipe-verdict): capture grep output, then test, rather than pipe-into-if.
  matches="$(printf '%s\n' "$changed" | grep -E "^${g}" || true)"
  if [ -n "$matches" ]; then
    guard_hit="$guard_hit $g"
  fi
done < <("$IDP/bin/idp-guarded-paths")
guard_hit="${guard_hit# }"

if [ -n "$guard_hit" ]; then
  # The key that judges a PR comes from the BASE, never from the PR. idp-auth-verify defaults to
  # docs/keys/founder.pub in the checkout, which is the PR's own tree: until 2026-09-29 a PR could
  # replace that file with its own public key, sign with the matching private key, and pass.
  base_pub="$(mktemp)"
  git show "$BASE:docs/keys/founder.pub" > "$base_pub"
  if IDP_FOUNDER_PUBKEY="$base_pub" "$IDP/bin/idp-auth-verify" "$HEAD_REV" >/dev/null 2>&1; then
    echo "ok    guarded-paths  founder signature valid; touched: $guard_hit"
  else
    echo "FAIL  guarded-paths  guarded paths touched WITHOUT valid X-Idp-Auth trailer:"
    printf '                 %s\n' $guard_hit
    echo "                 Founder must run: bin/idp-auth '<reason>' <path>... then amend commit."
    rc=1
  fi
fi

# 2) Blind-accept merge trailer.
# LAW 55: capture the match first, then test, rather than pipe-into-if.
head_msg="$(git log -1 --format=%B "$HEAD_REV")"
merge_bad="$(printf '%s\n' "$head_msg" | grep -E '^X-Idp-Merge-Strategy: (theirs|ours)$' || true)"
if [ -n "$merge_bad" ]; then
  echo "FAIL  guarded-paths  blind-accept merge (-X theirs/ours) is not permitted"
  rc=1
fi

# 3) X-Idp-Signed trailer (defeats --no-verify).
# Exception: commits authored by the estate bot (Flux image-update PRs, live-diagram bot) cannot
# run the commit-msg hook because they are created via the GitHub API by a GitHub App, not via
# git on a machine where the hook is installed. These commits never touch guarded paths (checked
# above); the unsigned-HEAD check does not apply to them.
#
# Also exempt: founding engineer commits. The founding engineer may author with any of their
# registered GitHub emails on this machine. Both emails are cryptographically verified via the
# X-Idp-Auth trailer on any commit that touches guarded paths; the unsigned-HEAD check does not
# apply to founder-authored commits since the commit-msg hook is installed on their machines.
head_author="$(git log -1 --format='%ae' "$HEAD_REV" 2>/dev/null || true)"
bot_authored=false
founder_authored=false
case "$head_author" in
  *"[bot]"*|*"noreply.github.com"*|*"estate-agents"*)
    bot_authored=true ;;
  chidionyema@gmail.com|chidiony333@gmail.com)
    founder_authored=true ;;
esac

signed_line="$(printf '%s\n' "$head_msg" | grep -E '^X-Idp-Signed: ' || true)"
if [ -z "$signed_line" ] && [ "$bot_authored" = "false" ] && [ "$founder_authored" = "false" ]; then
  echo "FAIL  guarded-paths  HEAD is unsigned (--no-verify / --no-commit-hooks bypass detected)."
  echo "                 Every legitimate commit is stamped by .githooks/commit-msg."
  rc=1
elif [ -z "$signed_line" ] && [ "$bot_authored" = "true" ]; then
  echo "ok    guarded-paths  bot commit ($head_author) — X-Idp-Signed exemption applies"
elif [ -z "$signed_line" ] && [ "$founder_authored" = "true" ]; then
  echo "ok    guarded-paths  founder commit ($head_author) — X-Idp-Signed exemption applies"
fi

exit "$rc"
