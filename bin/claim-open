#!/usr/bin/env python3
"""claim-open -- declare a claim correctly, in one command, before lane-submit.

WHY. 2026-10-10. I invoked lane-submit four times and claim-gate refused four times, one
requirement per round-trip: no `Claim:` line, then no `Agent:` line, then the issue was not
labelled `in-progress`, then the issue had no `CLAIM` comment. Every refusal was correct and every
one was stated plainly -- by bin/claim-gate's own docstring, which lists all four requirements and
which I had not read. The cost is not the four round-trips; it is that the gate is felt as an
obstacle rather than used as a contract, and that the next agent, and the one after, pay the same
four. Writing a claim is mechanical, so it should be a command, not a thing each agent
re-discovers.

WHAT IT DOES. Given the files the change touches, it makes the contract true and then runs
claim-gate to prove it:

    1. finds or creates the open GitHub issue the work is declared on;
    2. posts the `CLAIM agent=<name> paths=<glob,...> heartbeat=<UTC>` comment, with paths derived
       from the change's own files so the globs actually cover them;
    3. stamps `Claim: #<n>` and `Agent: <name>` into the current commit message (no-op if already
       present), so the two trailers cannot drift from the issue they name.

Last, it runs bin/claim-gate over the same range. A green claim-gate is the point of the command.

    bin/claim-open --issue 5708                       # declare on an existing issue
    bin/claim-open --title "feat(x): do the thing"    # or open one
    bin/claim-open --issue 5708 --agent otto

The `in-progress` label is not applied and not needed: since 2026-10-10 the heartbeat is the only
statement of liveness (see bin/claim-gate's docstring for the measurement behind that).

The paths default to every file this branch adds or changes against origin/main, which is exactly
the set claim-gate will judge, so `paths=` cannot silently under-cover the change. AGENTS.md §1 is
the reason: measure the claim against the thing, not against what the author remembers changing.
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PLATFORM_ESTATE = os.path.join(IDP, "platform", "estate")
if PLATFORM_ESTATE not in sys.path:
    sys.path.insert(0, PLATFORM_ESTATE)

from context.claim_contract import ClaimContractError, format_claim  # noqa: E402


def resolve_repo() -> str:
    """The checkout to measure and claim: the one you are standing in, not this script's repo.

    2026-10-22. Every git call here used to run with `cwd=IDP`, the checkout the script lives in.
    From a worktree that is the wrong tree: `bin/claim-open` in
    ~/.estate/worktrees/epic-090 reported "change touches 13 file(s): web/app/case-studies/page.tsx
    ..." -- none of them in the branch -- and refused on an old commit's claim (#6698) belonging to
    another agent, because it had read the dev checkout's HEAD instead of the lane's. So no worktree
    lane could declare itself, and the workaround was to hand-post the CLAIM comment and run
    bin/claim-gate with GITHUB_REPOSITORY exported.

    A claim is about a tree and a range, so the tree is the question: a git worktree knows its own
    top level, and that is the answer in both cases (a worktree's top level is the worktree).
    ESTATE_CLAIM_REPO overrides it for the odd caller that is not in the tree at all. The last
    resort is this script's own repo, which keeps the old single-checkout behaviour intact.
    """
    explicit = os.environ.get("ESTATE_CLAIM_REPO", "").strip()
    if explicit:
        return os.path.abspath(explicit)
    p = subprocess.run(  # noqa: S603, S607 -- fixed argv, no shell
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        timeout=SUBPROCESS_BUDGET_S,
    )
    root = p.stdout.strip()
    # Only a tree that can prove a claim is usable: a cwd inside some other repository (or no
    # repository) falls back rather than claiming against files this script cannot gate.
    if p.returncode == 0 and root and os.path.exists(os.path.join(root, "bin", "claim-gate")):
        return root
    return IDP


# Every subprocess below reaches the network (gh) or another script, and an unbounded
# subprocess.run turns a stalled dependency into a door that never returns: the session sees no
# output, no exit and no reason, so it hand-solves the claim -- exactly the duplication the claim
# exists to prevent. Measured 2026-11-10: this script blocked in select() for 45s and answered
# only when an external alarm killed it, at which point the real error ("no such instruction")
# surfaced. A stall must become a verdict inside the budget, naming the command that stalled.
SUBPROCESS_BUDGET_S = 20
REPO = resolve_repo()
GATE = os.path.join(REPO, "bin", "claim-gate")

# The two trailer regexes are claim-gate's own, copied deliberately rather than imported: a gate
# that imports its writer can be made to agree with it by editing one file, and then a green gate
# proves nothing. If claim-gate changes its contract, this file must be changed to match it, and
# the diff shows that.
CLAIM_REF = re.compile(r"^Claim:\s*(?:([\w.-]+/[\w.-]+))?#(\d+)\s*$", re.M)
AGENT = re.compile(r"^Agent:\s*(\S+)\s*$", re.M)
INSTRUCTION_TRAILER = re.compile(r"^Instruction:\s*(INS-[A-Za-z0-9-]+)\s*$", re.M)
PLAN_TRAILER = re.compile(r"^Plan:\s*([0-9a-fA-F]{64})\s*$", re.M)


class ClaimPreconditionError(ValueError):
    """The instruction or plan cannot lawfully back a claim."""


def _plan_contract():
    source = os.path.join(REPO, "platform", "estate", "memory", "plan.py")
    if not os.path.isfile(source):
        raise ClaimPreconditionError(f"the plan contract is missing at {source}")
    spec = importlib.util.spec_from_file_location("claim_open_plan_contract", source)
    if spec is None or spec.loader is None:
        raise ClaimPreconditionError(f"the plan contract cannot be loaded at {source}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def claim_plan(
    session: str, instruction: str, *, ledger_dir: str | os.PathLike[str] | None = None
) -> tuple[dict, str]:
    """Load and validate the exact plan a claim is allowed to execute."""
    plan_contract = _plan_contract()
    plan_contract.PLAN_LEDGER_DIR = str(
        ledger_dir
        or os.environ.get(
            "ESTATE_PLAN_LEDGER_DIR", os.path.expanduser("~/.estate/plans")
        )
    )
    plan = plan_contract.ledger_plan(session)
    if not plan:
        raise ClaimPreconditionError(f"session {session} declared no plan")
    problems = plan_contract.claim_contract_problems(plan, instruction)
    if problems:
        raise ClaimPreconditionError("; ".join(problems))
    return plan, plan_contract.plan_digest(plan)


def collect_current_session(session: str) -> None:
    """Refresh the machine-owned prompts and import this session before claiming."""
    env = {**os.environ, "IDP_ROOT": IDP}
    collector = os.path.join(REPO, "bin", "founder-prompt-collector")
    tracker = os.path.join(REPO, "bin", "instruction")
    for command, label in (
        ([sys.executable, collector, "collect"], "prompt collector"),
        (
            [sys.executable, tracker, "import-prompts", "--session", session],
            "instruction import",
        ),
    ):
        proc = run(command, env=env, timeout=60)
        if proc.returncode != 0:
            raise ClaimPreconditionError(
                proc.stderr.strip() or f"{label} failed with exit {proc.returncode}"
            )


def claim_body(
    *,
    agent: str,
    instruction: str,
    plan: dict,
    digest: str,
    paths: list[str],
    heartbeat: str,
) -> str:
    """The canonical machine line followed by the complete plan for human review."""
    lines = [
        format_claim(
            agent=agent,
            instruction=instruction,
            plan=digest,
            paths=paths,
            heartbeat=heartbeat,
        ),
        f"Goal: {plan.get('goal', '')}",
    ]
    for subgoal in plan.get("subgoals") or []:
        sid = subgoal.get("id", "")
        lines.append(f"Subgoal {sid}: {subgoal.get('text', '')}")
        scenario = (plan.get("bdd") or {}).get(sid) or {}
        lines.append(
            "BDD: Given {given}; When {when}; Then {then}".format(
                given=scenario.get("given", ""),
                when=scenario.get("when", ""),
                then=scenario.get("then", ""),
            )
        )
        for edge in (plan.get("edgecases") or {}).get(sid) or []:
            lines.append(f"Edge case: {edge}")
        for effect in (plan.get("effects") or {}).get(sid) or []:
            lines.append(f"Second-order effect: {effect}")
    return "\n".join(lines)


def with_trailers(
    message: str, *, num: int, agent: str, instruction: str, digest: str
) -> str:
    """Bind the commit to the same three records the claim comment names."""
    body = message.rstrip("\n")
    if not CLAIM_REF.search(body):
        body += f"\n\nClaim: #{num}"
    if not AGENT.search(body):
        body += f"\nAgent: {agent}"
    if not INSTRUCTION_TRAILER.search(body):
        body += f"\nInstruction: {instruction}"
    if not PLAN_TRAILER.search(body):
        body += f"\nPlan: {digest}"
    return body


def run(cmd: list[str], **kw: object) -> subprocess.CompletedProcess[str]:
    """Run a fixed argv under a hard time budget (see SUBPROCESS_BUDGET_S).

    A stall becomes a ClaimPreconditionError naming the command, so the caller prints a verdict
    instead of hanging. ClaimPreconditionError is caught in main() and exits non-zero, which is
    the same path as every other precondition refusal -- one refusal shape, not two.
    """
    budget = kw.pop("timeout", None) or SUBPROCESS_BUDGET_S
    try:
        return subprocess.run(  # noqa: S603 -- caller passes a fixed argv, never a shell string
            cmd,  # noqa: S607
            capture_output=True,
            text=True,
            cwd=REPO,
            timeout=budget,
            **kw,  # type: ignore[arg-type]
        )
    except subprocess.TimeoutExpired:
        raise ClaimPreconditionError(
            f"{' '.join(cmd[:2])} did not answer within {budget}s: the dependency is stalled, "
            f"so no claim was posted (ran {' '.join(cmd[:3])!r}). "
            "Run that command directly to see why."
        ) from None
    except OSError as exc:
        raise ClaimPreconditionError(
            f"could not run {' '.join(cmd[:2])!r}: {exc}"
        ) from None


def git(*a: str) -> str:
    p = run(["git", *a])
    if p.returncode != 0:
        sys.exit(f"FAIL    claim-open  git {' '.join(a)}: {p.stderr.strip()[:200]}")
    return p.stdout


def gh(*a: str, check: bool = True) -> str:
    p = run(["gh", *a])
    if check and p.returncode != 0:
        sys.exit(f"FAIL    claim-open  gh {' '.join(a)}: {p.stderr.strip()[:300]}")
    return p.stdout


def repo() -> str:
    return gh("repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner").strip()


def changed_files(base: str) -> list[str]:
    """Every path this branch touches against base -- the same set claim-gate will require."""
    out = git("diff", "--name-only", f"{base}..HEAD")
    return [f for f in out.splitlines() if f.strip()]


def globs_for(files: list[str], declared: list[str] = ()) -> list[str]:
    """One glob per file, plus the paths declared ahead of the change.

    claim-gate matches with fnmatch, so a plain path is already a valid glob. Globbing a whole
    directory would over-cover: it would let a later commit to a neighbouring file land on this
    claim without being declared. So each file is named exactly, which keeps `paths=` equal to the
    change. `declared` is the focus stated before the file exists: bin/estate-memory-enforce
    refuses to create a file no claim covers, so a new file has to be declared first.
    """
    globs = sorted(set(files) | {d.strip() for d in declared if d.strip()})
    if not globs:
        sys.exit(
            "FAIL    claim-open  no changed files against origin/main and no --paths:\n"
            "                    a claim covers a change, so there is nothing to declare"
        )
    return globs


def find_issue(
    title: str | None,
    issue: int | None,
    *,
    instruction: str,
    plan: dict,
    digest: str,
) -> int:
    if issue:
        return issue
    assert title, "argparse guarantees one of --issue/--title"
    # Reuse an open issue with this exact title rather than opening a duplicate: re-running the
    # command, or a retried lane, must not litter the tracker with the same claim.
    out = gh("issue", "list", "--state", "open", "--search", title,
             "--limit", "5", "--json", "number,title")
    for row in json.loads(out or "[]"):
        if row.get("title") == title:
            print(f"ok      claim-open  reusing open issue #{row['number']} with this title")
            return int(row["number"])
    body = (
        "Declared by bin/claim-open.\n\n"
        "This issue is the claim the change lands on (AGENTS.md \u00a75): claim-gate requires it to be\n"
        "open and to carry a live CLAIM comment covering the files the change touches.\n"
        "bin/claim-open makes both of those true in one command.\n"
        f"\nInstruction: {instruction}\nPlan: {digest}\nGoal: {plan.get('goal', '')}\n"
    )
    url = gh("issue", "create", "--title", title, "--body", body).strip()
    num = int(url.rstrip("/").split("/")[-1])
    print(f"ok      claim-open  opened issue #{num}")
    return num


def ensure_open(num: int) -> None:
    d = json.loads(gh("issue", "view", str(num), "--json", "state"))
    if d.get("state") != "OPEN":
        sys.exit(f"FAIL    claim-open  issue #{num} is not open: a claim-gate claim must be open")


def post_claim(
    num: int,
    agent: str,
    paths: list[str],
    *,
    instruction: str,
    plan: dict,
    digest: str,
) -> None:
    hb = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    try:
        body = claim_body(
            agent=agent,
            instruction=instruction,
            plan=plan,
            digest=digest,
            paths=paths,
            heartbeat=hb,
        )
    except ClaimContractError as exc:
        sys.exit(f"FAIL    claim-open  invalid claim contract: {exc}")
    gh("issue", "comment", str(num), "--body", body)
    print(
        f"ok      claim-open  claimed #{num} as {agent} for {instruction} "
        f"({len(paths)} path{'s' if len(paths)!=1 else ''})"
    )


def stamp_trailers(
    num: int,
    agent: str,
    *,
    instruction: str,
    digest: str,
) -> None:
    msg = git("log", "-1", "--format=%B")
    have_claim = CLAIM_REF.search(msg)
    have_agent = AGENT.search(msg)
    have_instruction = INSTRUCTION_TRAILER.search(msg)
    have_plan = PLAN_TRAILER.search(msg)
    if have_claim and have_agent and have_instruction and have_plan:
        if have_claim.group(2) != str(num) or have_agent.group(1) != agent:
            sys.exit(
                f"FAIL    claim-open  this commit already claims #{have_claim.group(2)} as "
                f"{have_agent.group(1)}, not #{num} as {agent}.\n"
                "                    Amend deliberately; do not silently re-point a commit's claim."
            )
        if (
            have_instruction.group(1) != instruction
            or have_plan.group(1).lower() != digest.lower()
        ):
            sys.exit(
                "FAIL    claim-open  this commit is already bound to another instruction "
                "or plan; revise the plan and amend deliberately"
            )
        print(
            f"ok      claim-open  commit already carries Claim: #{num}, Agent: {agent}, "
            f"Instruction: {instruction}, Plan: {digest[:12]}"
        )
        return
    body = msg.rstrip("\n")
    if not have_claim:
        body += f"\n\nClaim: #{num}"
    if not have_agent:
        body += f"\nAgent: {agent}"
    if not have_instruction:
        body += f"\nInstruction: {instruction}"
    if not have_plan:
        body += f"\nPlan: {digest}"
    # --amend rewrites the message only; the tree is untouched, so this cannot lose work.
    p = run(["git", "commit", "--amend", "-q", "-m", body])
    if p.returncode != 0:
        sys.exit(f"FAIL    claim-open  could not stamp trailers: {p.stderr.strip()[:200]}")
    print(
        f"ok      claim-open  stamped Claim: #{num}, Agent: {agent}, "
        f"Instruction: {instruction}, Plan: {digest[:12]} into the commit"
    )


def note_claim(num: int) -> None:
    """Tell this machine's focus register the claim exists now, not at the next ledger poll.

    The ledger is read through gh and cached; without the note, bin/estate-memory-enforce
    refuses the first edit after claim-open as unclaimed. A failed note costs only that delay.
    """
    sys.path.insert(0, os.path.join(IDP, "platform", "estate", "memory"))
    try:
        import focus  # noqa: PLC0415 -- optional: a checkout without it still claims

        focus.note_claim(num)
    except (ImportError, OSError) as e:
        print(f"warn    claim-open  focus note not written ({e}): the hook sees it next poll")


def instruction_payload(instruction: str) -> dict:
    binary = os.path.join(REPO, "bin", "instruction")
    if not os.path.isfile(binary):
        raise ClaimPreconditionError(f"the instruction tracker is missing at {binary}")
    proc = run([sys.executable, binary, "show", instruction, "--json"])
    if proc.returncode != 0:
        raise ClaimPreconditionError(
            proc.stderr.strip() or f"instruction {instruction} does not exist"
        )
    try:
        payload = json.loads(proc.stdout)
    except ValueError as exc:
        raise ClaimPreconditionError(
            f"instruction {instruction} did not return JSON"
        ) from exc
    if payload.get("state") in {"verified", "abandoned"}:
        raise ClaimPreconditionError(
            f"instruction {instruction} is already {payload.get('state')}"
        )
    return payload


def bind_instruction(instruction: str, *, session: str) -> None:
    binary = os.path.join(REPO, "bin", "instruction")
    proc = run(
        [
            sys.executable,
            binary,
            "sync-plan",
            instruction,
            "--session",
            session,
        ]
    )
    if proc.returncode != 0:
        raise ClaimPreconditionError(
            proc.stderr.strip() or "the instruction could not store the plan"
        )


def link_claim(
    instruction: str,
    *,
    num: int,
    agent: str,
    repo_slug: str,
    digest: str,
) -> None:
    binary = os.path.join(REPO, "bin", "instruction")
    proc = run(
        [
            sys.executable,
            binary,
            "link",
            instruction,
            "--owner",
            agent,
            "--claim",
            f"{repo_slug}#{num}",
            "--note",
            f"claim opened against plan {digest}",
        ]
    )
    if proc.returncode != 0:
        raise ClaimPreconditionError(
            proc.stderr.strip() or "the claim could not be linked to the instruction"
        )


def main() -> int:
    ap = argparse.ArgumentParser(prog="claim-open", description=__doc__.split("\n")[0])
    ap.add_argument("--issue", type=int, help="claim an existing issue")
    ap.add_argument("--title", help="open (or reuse) an issue with this title")
    ap.add_argument("--agent", default=os.environ.get("ESTATE_AGENT", ""),
                    help="claiming agent; default: $ESTATE_AGENT, else refuse")
    ap.add_argument(
        "--session",
        default=os.environ.get("ESTATE_SESSION_ID", ""),
        help="the session whose plan is claimed; default: $ESTATE_SESSION_ID",
    )
    ap.add_argument(
        "--instruction",
        required=True,
        help="the INS-* instruction this claim executes",
    )
    ap.add_argument("--base", default="origin/main", help="the range the claim covers")
    ap.add_argument("--paths", default="",
                    help="comma-separated paths to declare before they change (new files)")
    ap.add_argument("--check-only", action="store_true",
                    help="write nothing; only run claim-gate over this range")
    a = ap.parse_args()
    if not a.issue and not a.title:
        ap.error("one of --issue or --title is required")
    # Fail closed on identity (#6407): the old default was the literal string
    # "otto", so every agent that skipped --agent/ESTATE_AGENT claimed as otto
    # and claim-gate could not tell agents apart. No default is honest — refuse.
    if not a.agent:
        sys.exit("FAIL    claim-open  no agent identity: pass --agent <name> or set ESTATE_AGENT")
    if not a.session:
        sys.exit(
            "FAIL    claim-open  no session identity: pass --session <id> or set "
            "ESTATE_SESSION_ID"
        )

    if not os.path.exists(GATE):
        sys.exit(f"FAIL    claim-open  no bin/claim-gate at {GATE}: cannot prove the claim here")

    try:
        if not a.check_only:
            collect_current_session(a.session)
        tracked = instruction_payload(a.instruction)
        if tracked.get("session") and tracked["session"] != a.session:
            raise ClaimPreconditionError(
                f"instruction {a.instruction} belongs to session {tracked['session']}, "
                f"not {a.session}"
            )
        plan, digest = claim_plan(a.session, a.instruction)
        if not a.check_only:
            bind_instruction(a.instruction, session=a.session)
    except ClaimPreconditionError as exc:
        sys.exit(f"FAIL    claim-open  {exc}")

    base = git("merge-base", a.base, "HEAD").strip()
    files = changed_files(base)
    paths = globs_for(files, a.paths.split(","))
    print(f"      claim-open  change touches {len(files)} file(s): {', '.join(files[:5])}"
          + (f" (+{len(files)-5} more)" if len(files) > 5 else ""))

    if not a.check_only:
        num = find_issue(
            a.title,
            a.issue,
            instruction=a.instruction,
            plan=plan,
            digest=digest,
        )
        ensure_open(num)
        post_claim(
            num,
            a.agent,
            paths,
            instruction=a.instruction,
            plan=plan,
            digest=digest,
        )
        # With nothing committed yet, HEAD is main's commit: there is no commit of ours to stamp.
        if files:
            stamp_trailers(
                num,
                a.agent,
                instruction=a.instruction,
                digest=digest,
            )
        repo_slug = repo()
        try:
            link_claim(
                a.instruction,
                num=num,
                agent=a.agent,
                repo_slug=repo_slug,
                digest=digest,
            )
        except ClaimPreconditionError as exc:
            sys.exit(f"FAIL    claim-open  {exc}")
        note_claim(num)

    repo_slug = repo()
    env = {**os.environ, "GITHUB_REPOSITORY": repo_slug}
    p = subprocess.run(  # noqa: S603 -- fixed argv; GATE is a path in this repo
        [GATE, base, "HEAD"],  # noqa: S607
        capture_output=True, text=True, cwd=REPO, env=env,
    )
    sys.stdout.write(p.stdout)
    sys.stderr.write(p.stderr)
    return p.returncode


if __name__ == "__main__":
    raise SystemExit(main())
