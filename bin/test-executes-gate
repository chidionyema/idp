#!/usr/bin/env bash
# A test that executes nothing is not a test.
#
# On 2026-09-04 the founder had 322 files deleted from tests/ in one commit (519d59e8): every
# one of them opened this repository's own YAML, JSON or shell and asserted what it said. The
# file it read and the expectation it held were the same statement written twice, so none of
# them could catch a defect -- what they caught was a deliberate decision, at the cost of a red
# run and a wait every time one was made. 169 were named test_incident_*: an incident answered
# with a pin on the symptom instead of a fix for the cause.
#
# Within the hour a session opened a new one. Deleting the class once does not stop the next
# session writing it, so this refuses a NEW test file that runs nothing (LAW 45). It grades
# behaviour, not wording: does this file start a process, open a socket or make a request. A
# file that already exists is never graded -- only what a change adds.
#
# It also refuses the NAME. A file called test_incident_<date-or-ticket> is a note about one
# instance, and the naming convention is what reproduces the practice: a session reads the
# directory, sees the pattern, and writes the next one. A new test names the rule it holds.
#
# LAW 46: the checkout is computed from this script, never named."
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
BASE="${1:-origin/main}"

# The ways a python test reaches outside its own process. A file with none of these can only be
# reading the repository and asserting what it read.
# `docker` is anchored as an attribute access: the bare word matches the path "Dockerfile",
# which a reads-only test opens, and hermes-v2's test_incident_crew751 passed this gate as
# "runs something" on exactly that. `importlib` and `spec_from_file` load a module of this
# repository and call it, which is running something.
# `http.server` and `http.client` are here because a test that stands up a real HTTP door on
# loopback and posts to it is the strongest kind of behavioural test in this repository, and
# the list did not name it: tests/test_the_jit_ledger_leaves_the_node_it_was_written_on.py
# drives a real OTLP collector through four failure modes and was refused as reading files.
#
# `exec(` and `compile(` are here for the third shape, found on chidionyema/idp#3315: a test
# that lifts a program out of a manifest (a ConfigMap's `apply.py`, a Job's inline script),
# compiles it and CALLS it. That is the strongest test of a manifest whose code lives in a
# string -- it grades the exact bytes the cluster will run, not a copy of them -- and it was
# refused because the test's own file calls `exec` with a variable rather than importing a
# module by name. A gate that cannot see this shape pushes such a test back to asserting the
# manifest's TEXT, which is the thing this gate exists to refuse.
#
# `ast.parse` IS DELIBERATELY NOT HERE. A test can parse a file and assert its SHAPE without
# running anything, and that would slip past this gate while still measuring nothing. Measured
# on the same change: a test whose only work is to parse bin/catalog-render and check a
# function name passes `ast.parse` and passes bin/test-prose-gate too, so the two gates
# together would have called it behavioural. `exec(` is the line -- if the string does not run,
# this pattern does not match.
EXECUTES='subprocess|requests\.|httpx|socket\.|urllib\.request|http\.server|http\.client|os\.system|pexpect|docker\.|kubernetes\.client|importlib|spec_from_file|exec\(|compile\('

# tests/fixtures/ is excluded because a file there is a fixture, not a test. The pairs this
# repository grades gates with include python files, and one of them is a test that reads a
# path and nothing else ON PURPOSE -- that is the input the gate under test is supposed to
# judge. Judging it here refuses the fixture for being the thing it exists to be, which is a
# guard refusing correct work (LAW 38). Found on chidionyema/idp#2559, where the regression
# pair for bin/idp-rule-coverage could not be added at all.
added=$(cd "$IDP" && git diff --name-only --diff-filter=A "$BASE...HEAD" -- 'tests/*.py' ':(exclude)tests/fixtures/*' 2>/dev/null)
[ -n "$added" ] || { echo "ok    executes  no new test file in this change"; exit 0; }

bad=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  if grep -qE "$EXECUTES" "$IDP/$f"; then
    case "$(basename "$f")" in
      test_incident_*)
        echo "FAIL  executes  $f is named for the day something broke, not for the rule it holds."
        echo "                A file named test_incident_* is a note about one instance; the next"
        echo "                session reads the name and writes the next one. Name the invariant."
        bad=1
        ;;
      *) echo "ok    executes  $f runs something" ;;
    esac
  else
    echo "FAIL  executes  $f asserts this repository's own files back at it and runs nothing."
    echo "                Grade what the value causes -- a render admission accepts, a request the"
    echo "                service answers, a workload that starts -- or delete the file. 322 of"
    echo "                these were deleted on 2026-09-04 (519d59e8); do not write the 323rd."
    bad=1
  fi
done <<< "$added"
exit "$bad"
