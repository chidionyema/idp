#!/usr/bin/env python3
"""crew#584: the platform options are a register with a planner, not a list of things to remember.

Founder 2026-08-29: "we need all options, we need to be able to run heavyweight infra ... also to run
a leaner shop ... the flexibility to run and scale any combination of options ... the options need
to take into account the infra requirements and allocate accordingly."

  bin/idp-features plan [--set feature=tier ...]   sum the enabled tiers against the node: fits or not,
                                                   the smallest node that fits, and its monthly price
  bin/idp-features floors                          what git asks for per switch (container requests + PVCs)
                                                   and per tier; suspended switches are marked
  bin/idp-features enable <feature> <tier>         flip the Flux switches for that tier (suspend: false on
                                                   its Kustomizations, true on the feature's other tiers),
                                                   write the node size if the combination needs a bigger
                                                   one, then print the plan
  bin/idp-features check                           exit 1 if a switch in the register names no Kustomization

One source of truth each (LAW 51 memoize): tiers and switches in platform/features/features.yaml; the
switches in clusters/<cluster>/*.yaml (`suspend:` on a Flux Kustomization); node shape and OCI A1 rates
in platform/oci/variables.tf; requests in the manifests under each Kustomization's path. Nothing here
is typed twice, so a price or a floor that changes in its file changes the plan without an edit.
"""
from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys

import yaml

ROOT = pathlib.Path(__file__).resolve().parents[1]
REGISTER = ROOT / "platform" / "features" / "features.yaml"
VARIABLES = ROOT / "platform" / "oci" / "variables.tf"
HOURS_MONTH = 730  # the factor platform/oci/main.tf prices capacity_monthly_usd with
SELECTABLE = {None, "on", "trial"}  # tier statuses the planner may enable today


def register() -> dict:
    return yaml.safe_load(REGISTER.read_text())


def tf_number(name: str, text: str) -> float:
    m = re.search(r'variable "%s" \{[^}]*?default\s*=\s*([0-9.]+)' % re.escape(name), text, re.S)
    if not m:
        sys.exit(f"FAIL    features  {VARIABLES.relative_to(ROOT)} has no default for {name}")
    return float(m.group(1))


def node_shape() -> dict:
    t = VARIABLES.read_text()
    return {k: tf_number(k, t) for k in (
        "worker_ocpus", "worker_memory_gb", "free_ocpus", "free_memory_gb",
        "a1_ocpu_usd_per_hour", "a1_memory_gb_usd_per_hour")}


def price(ocpus: float, memory_gb: float, shape: dict) -> float:
    paid_cpu = max(0.0, ocpus - shape["free_ocpus"])
    paid_mem = max(0.0, memory_gb - shape["free_memory_gb"])
    return round((paid_cpu * shape["a1_ocpu_usd_per_hour"] + paid_mem * shape["a1_memory_gb_usd_per_hour"]) * HOURS_MONTH, 2)


# ---------------------------------------------------------------- switches (clusters/<cluster>/*.yaml)

def cluster_files(cluster: str) -> list[pathlib.Path]:
    return sorted((ROOT / "clusters" / cluster).glob("*.yaml"))


def kustomizations(cluster: str) -> dict[str, tuple[pathlib.Path, str | None, bool]]:
    """name -> (file, spec.path, suspended) for every Flux Kustomization the cluster applies."""
    out = {}
    for f in cluster_files(cluster):
        for doc in yaml.safe_load_all(f.read_text()):
            if not doc or doc.get("kind") != "Kustomization" or not str(doc.get("apiVersion", "")).startswith("kustomize.toolkit"):
                continue
            spec = doc.get("spec", {})
            out[doc["metadata"]["name"]] = (f, spec.get("path"), bool(spec.get("suspend", False)))
    return out


def set_suspend(cluster: str, name: str, suspended: bool) -> pathlib.Path:
    """Set `suspend:` on one Kustomization, in place, keeping every comment around it."""
    kust = kustomizations(cluster)
    if name not in kust:
        sys.exit(f"FAIL    features  no Kustomization {name} under clusters/{cluster}/")
    f = kust[name][0]
    docs = f.read_text().split("\n---\n")
    for i, doc in enumerate(docs):
        if not re.search(r"^kind: Kustomization$", doc, re.M) or not re.search(r"^  name: %s$" % re.escape(name), doc, re.M):
            continue
        value = "true" if suspended else "false"
        if re.search(r"^  suspend: ", doc, re.M):
            doc = re.sub(r"^  suspend: \S+", f"  suspend: {value}", doc, count=1, flags=re.M)
        else:
            doc = re.sub(r"^spec:\n", f"spec:\n  suspend: {value}\n", doc, count=1, flags=re.M)
        docs[i] = doc
        break
    f.write_text("\n---\n".join(docs))
    return f


# ---------------------------------------------------------------- floors from git (LAW 51 memoize)

def _qty_cpu(v) -> float:
    s = str(v)
    return float(s[:-1]) / 1000 if s.endswith("m") else float(s)


def _qty_gb(v) -> float:
    s = str(v)
    units = {"Ki": 1 / 1024 / 1024, "Mi": 1 / 1024, "Gi": 1, "Ti": 1024, "K": 1e-6, "M": 1e-3, "G": 1, "T": 1e3}
    for u, k in units.items():
        if s.endswith(u):
            return float(s[: -len(u)]) * k
    return float(s) / 1024 ** 3


def _walk(node, acc: dict):
    if isinstance(node, dict):
        req = node.get("requests") if "limits" in node or "requests" in node else None
        if isinstance(req, dict):
            acc["cpu"] += _qty_cpu(req.get("cpu", 0))
            acc["memory_gb"] += _qty_gb(req.get("memory", 0))
            acc["storage_gb"] += _qty_gb(req.get("storage", 0))
        for v in node.values():
            _walk(v, acc)
    elif isinstance(node, list):
        for v in node:
            _walk(v, acc)


def requests_under(path: str | None) -> dict:
    acc = {"cpu": 0.0, "memory_gb": 0.0, "storage_gb": 0.0}
    if not path or (ROOT / path).resolve() == ROOT:
        return acc  # no path, or the catalogue row (path ./): catalog-info files, no workload
    for f in sorted((ROOT / path).rglob("*.yaml")):
        try:
            for doc in yaml.safe_load_all(f.read_text()):
                _walk(doc, acc)
        except yaml.YAMLError:
            continue  # templated files (envsubst) are not the planner's business
    return {k: round(v, 2) for k, v in acc.items()}


# ---------------------------------------------------------------- the plan

def tier_of(feature: dict, name: str) -> dict:
    for t in feature["tiers"]:
        if str(t["name"]) == name:
            return t
    sys.exit(f"FAIL    features  {feature['name']} has no tier {name}; tiers: {[str(t['name']) for t in feature['tiers']]}")


def selection(reg: dict, overrides: dict[str, str]) -> dict[str, dict]:
    chosen = {}
    for feat in reg["features"]:
        name = overrides.get(feat["name"], str(feat["default"]))
        chosen[feat["name"]] = tier_of(feat, name)
    unknown = set(overrides) - set(chosen)
    if unknown:
        sys.exit(f"FAIL    features  unknown feature(s) {sorted(unknown)}")
    return chosen


def plan(reg: dict, overrides: dict[str, str], cluster: str = "oke") -> tuple[list[str], bool, dict]:
    """Sum what git asks for across the unique set of enabled switches (a switch two features share is
    counted once), plus the typed floor of any tier whose switch does not exist yet (status planned)."""
    data = plan_data(reg, overrides, cluster)
    today = data["node_today"]
    sm = data.get("node_smallest")
    return format_plan(data), today["fits"], sm or data["node_today"]


def plan_data(reg: dict, overrides: dict[str, str], cluster: str = "oke") -> dict:
    """Compute structured plan data: features, totals, node fit, switch list.
    Returns a dict suitable for JSON serialisation (crew#857)."""
    shape, kust = node_shape(), kustomizations(cluster)
    chosen = selection(reg, overrides)
    switches = set(reg["core"]["switches"])
    for p in reg.get("products", []):
        if str(p.get("default", "on")) == "on":
            switches |= set(p["switches"])
    features_out = []
    planned = {"cpu": 0.0, "memory_gb": 0.0, "storage_gb": 0.0}
    failures = []
    for fname, tier in chosen.items():
        st = tier.get("status")
        if st in SELECTABLE:
            got = {k: round(sum(requests_under(kust[s][1])[k] for s in tier.get("switches", []) if s in kust), 2) for k in planned}
            note = ""
            switches |= set(tier.get("switches", []))
        else:
            got = dict(tier.get("floor", planned))
            note = f"{st}: typed floor, no manifests yet"
            for k in planned:
                planned[k] += got[k]
        entry = {"name": fname, "tier": str(tier["name"]),
                 "cpu": got["cpu"], "memory_gb": got["memory_gb"], "storage_gb": got["storage_gb"],
                 "title": tier.get("what", tier.get("title", "")),
                 "note": note}
        features_out.append(entry)
        for dep in tier.get("depends", []):
            if dep in chosen and str(chosen[dep]["name"]) == "off":
                failures.append(f"{fname}/{tier['name']} depends on {dep}, which is off")
    total = dict(planned)
    for sw in switches:
        if sw in kust:
            for k, v in requests_under(kust[sw][1]).items():
                total[k] += v
    total = {k: round(v, 2) for k, v in total.items()}
    reserved = reg["node"]["reserved"]
    today = {"name": f"today {int(shape['worker_ocpus'])}/{int(shape['worker_memory_gb'])}",
             "ocpus": shape["worker_ocpus"], "memory_gb": shape["worker_memory_gb"]}

    def fits(size):
        return total["cpu"] <= size["ocpus"] - reserved["cpu"] and total["memory_gb"] <= size["memory_gb"] - reserved["memory_gb"]

    smallest_node = next((s for s in sorted(reg["node"]["sizes"], key=lambda s: (price(s["ocpus"], s["memory_gb"], shape), s["ocpus"])) if fits(s)), None)
    return {
        "features": features_out,
        "total": {"cpu": total["cpu"], "memory_gb": total["memory_gb"], "storage_gb": total["storage_gb"]},
        "depend_failures": failures,
        "switches_count": len(switches),
        "switches": sorted(switches),
        "reserved": {"cpu": reserved["cpu"], "memory_gb": reserved["memory_gb"]},
        "node_today": {"name": today["name"], "ocpus": today["ocpus"], "memory_gb": today["memory_gb"],
                       "usd_month": price(today["ocpus"], today["memory_gb"], shape),
                       "fits": fits(today)},
        "node_smallest": None if smallest_node is None else {
            "name": smallest_node["name"], "ocpus": smallest_node["ocpus"],
            "memory_gb": smallest_node["memory_gb"],
            "usd_month": price(smallest_node["ocpus"], smallest_node["memory_gb"], shape)},
    }


def parse_set(items: list[str]) -> dict[str, str]:
    out = {}
    for it in items or []:
        if "=" not in it:
            sys.exit(f"FAIL    features  --set wants feature=tier, got {it!r}")
        k, v = it.split("=", 1)
        out[k] = v
    return out


def cmd_plan(a):
    data = plan_data(register(), parse_set(a.set), a.cluster)
    errors = any(l.startswith("FAIL") for l in data.get("depend_failures", []))
    if a.json:
        print(json.dumps(data, indent=2))
    else:
        print("\n".join(format_plan(data)))
    return 1 if errors else 0


def format_plan(data: dict) -> list[str]:
    """Format structured plan data as human-readable lines."""
    lines = []
    for f in data["features"]:
        line = f"feature {f['name']:<20} tier {f['tier']:<10} cpu {f['cpu']:<5} memory_gb {f['memory_gb']:<5} storage_gb {f['storage_gb']}"
        if f.get("note"):
            line += f"  ({f['note']})"
        lines.append(line)
    for dep in data.get("depend_failures", []):
        lines.append(f"FAIL    features  {dep}")
    t = data["total"]
    r = data["reserved"]
    lines.append(f"total cpu {t['cpu']} memory_gb {t['memory_gb']} storage_gb {t['storage_gb']} (git requests over {data['switches_count']} switches + node reserve cpu {r['cpu']} memory_gb {r['memory_gb']})")
    today = data["node_today"]
    lines.append(f"node {today['name']} usd_month {today['usd_month']} fits {'yes' if today['fits'] else 'no'}")
    sm = data.get("node_smallest")
    if sm:
        lines.append(f"smallest {sm['name']} ocpus {sm['ocpus']} memory_gb {sm['memory_gb']} usd_month {sm['usd_month']}")
    else:
        lines.append("smallest NONE: no size in the register holds this combination; add a size or drop a tier")
    lines.append("switches on: " + " ".join(sorted(data["switches"])))
    return lines


def cmd_check(a):
    reg, kust, bad = register(), kustomizations(a.cluster), []
    for sw in reg["core"]["switches"]:
        if sw not in kust:
            bad.append(f"core switch {sw}")
    for feat in reg["features"]:
        for tier in feat["tiers"]:
            if tier.get("status") not in SELECTABLE:
                continue  # planned / needs-split: the switch does not exist yet by design
            for sw in tier.get("switches", []):
                if sw not in kust:
                    bad.append(f"{feat['name']}/{tier['name']} switch {sw}")
    for p in reg.get("products", []):
        for sw in p["switches"]:
            if sw not in kust:
                bad.append(f"product {p['name']} switch {sw}")
    if bad:
        print("FAIL    features  switches naming no Kustomization under clusters/%s/: %s" % (a.cluster, "; ".join(bad)))
        return 1
    print(f"ok      features  every selectable switch is a Kustomization under clusters/{a.cluster}/")
    return 0


def cmd_floors(a):
    reg, kust = register(), kustomizations(a.cluster)
    measured = {name: requests_under(path) for name, (_, path, _) in kust.items()}
    for name in sorted(measured):
        m = measured[name]
        print(f"switch {name:<22} cpu {m['cpu']:<6} memory_gb {m['memory_gb']:<7} storage_gb {m['storage_gb']}{'' if kust[name][2] is False else '  (suspended)'}")
    rows = [("core", None, reg["core"])] + [(f["name"], str(t["name"]), t) for f in reg["features"] for t in f["tiers"]]
    for fname, tname, row in rows:
        if row.get("status") not in SELECTABLE or not row.get("switches"):
            continue
        got = {k: round(sum(measured.get(s, {}).get(k, 0) for s in row["switches"]), 2) for k in ("cpu", "memory_gb", "storage_gb")}
        label = fname if tname is None else f"{fname}/{tname}"
        print(f"tier   {label:<28} cpu {got['cpu']:<5} memory_gb {got['memory_gb']:<5} storage_gb {got['storage_gb']}")
    return 0


def cmd_enable(a):
    reg = register()
    feat = next((f for f in reg["features"] if f["name"] == a.feature), None) or sys.exit(f"FAIL    features  unknown feature {a.feature}")
    tier = tier_of(feat, a.tier)
    if tier.get("status") not in SELECTABLE:
        sys.exit(f"FAIL    features  {a.feature}/{a.tier} is {tier['status']}: not selectable until its switch exists")
    on = set(tier.get("switches", []))
    off = {s for t in feat["tiers"] for s in t.get("switches", [])} - on
    shared = {s for f in reg["features"] if f is not feat for t in f["tiers"] for s in t.get("switches", [])} | set(reg["core"]["switches"])
    touched = []
    for sw in sorted(on):
        touched.append(set_suspend(a.cluster, sw, False))
    for sw in sorted(off - shared):  # a switch another feature also uses is never turned off here
        touched.append(set_suspend(a.cluster, sw, True))
    lines, fits, size = plan(reg, {a.feature: a.tier}, a.cluster)
    print("\n".join(lines))
    if not fits and size.get("name", "").startswith("A1-"):
        tfvars = ROOT / "platform" / "oci" / "node.auto.tfvars"
        tfvars.write_text(f"# written by bin/idp-features enable {a.feature} {a.tier}: the enabled combination needs this node\n"
                          f"worker_ocpus     = {int(size['ocpus'])}\nworker_memory_gb = {int(size['memory_gb'])}\n")
        touched.append(tfvars)
    print("changed: " + " ".join(sorted({str(p.relative_to(ROOT)) for p in touched})))
    return 0


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="idp-features", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--cluster", default="oke")
    sub = ap.add_subparsers(dest="verb", required=True)
    p = sub.add_parser("plan"); p.add_argument("--set", action="append", metavar="feature=tier"); p.add_argument("--json", action="store_true"); p.set_defaults(fn=cmd_plan)
    sub.add_parser("floors").set_defaults(fn=cmd_floors)
    sub.add_parser("check").set_defaults(fn=cmd_check)
    e = sub.add_parser("enable"); e.add_argument("feature"); e.add_argument("tier"); e.set_defaults(fn=cmd_enable)
    a = ap.parse_args(argv)
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main())
