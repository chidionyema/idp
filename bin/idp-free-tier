#!/usr/bin/env python3
"""crew#488 CP3: the free-tier allowance, measured every day, against what the estate relies on.

OCI halved the Always Free A1 allowance on 2026-06-15 (ADR 0004) and the estate found out when
the node pool would not schedule. The cost risk is not the bill, it is the allowance shrinking
under a cluster sized to it. This asks the limits API what the tenancy is granted today for
VM.Standard.A1.Flex cores and memory and for block storage, and grades it against the free
allowance the tofu module assumes (platform/oci/variables.tf: free_ocpus, free_memory_gb) and the
size it provisions (worker_ocpus, worker_memory_gb). Runs in oke-check.yml with the runner's
exchanged OIDC session, like bin/idp-chaos-drill.

Prints one line, like every drill:
  ok      free-tier  A1 limit 2 OCPU / 12 GB, block 200 GB; module assumes 2 / 12, provisions 4 / 24 (2 OCPU / 12 GB paid)
  FAIL    free-tier  A1 core limit 1 is below the 2 the module assumes free   -- the allowance was cut; ADR 0004 again
  BLIND   free-tier  <why>                                                    -- no oci CLI, no session, or a limits call failed

Usage: idp-free-tier            (queries OCI; needs OCI_TENANCY_OCID and an oci session)
       idp-free-tier --json     (also prints the numbers as one JSON line for the STATE.md row)
"""
from __future__ import annotations

import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
VARS = os.path.join(ROOT, "platform", "oci", "variables.tf")


def module_numbers(path: str = VARS) -> dict[str, int]:
    """The defaults in platform/oci/variables.tf. A tfvars override is applied by oke-rebuild, not here:
    this row grades the allowance the module is written against."""
    text = open(path, encoding="utf-8").read()
    out: dict[str, int] = {}
    for name in ("worker_ocpus", "worker_memory_gb", "free_ocpus", "free_memory_gb"):
        m = re.search(r'variable "%s"\s*\{[^}]*?default\s*=\s*(\d+)' % name, text, re.S)
        if not m:
            raise ValueError(f"{path}: no integer default for {name}")
        out[name] = int(m.group(1))
    return out


def grade(limits: dict[str, int], module: dict[str, int]) -> str:
    """Pure. limits: a1_cores, a1_memory_gb, block_gb as the tenancy is granted them today."""
    if limits["a1_cores"] < module["free_ocpus"]:
        return f"FAIL    free-tier  A1 core limit {limits['a1_cores']} is below the {module['free_ocpus']} the module assumes free"
    if limits["a1_memory_gb"] < module["free_memory_gb"]:
        return f"FAIL    free-tier  A1 memory limit {limits['a1_memory_gb']} GB is below the {module['free_memory_gb']} the module assumes free"
    if limits["a1_cores"] < module["worker_ocpus"] or limits["a1_memory_gb"] < module["worker_memory_gb"]:
        return (f"FAIL    free-tier  A1 limit {limits['a1_cores']} OCPU / {limits['a1_memory_gb']} GB cannot hold the "
                f"{module['worker_ocpus']} / {module['worker_memory_gb']} the module provisions")
    paid_c = max(0, module["worker_ocpus"] - module["free_ocpus"])
    paid_m = max(0, module["worker_memory_gb"] - module["free_memory_gb"])
    paid = f"{paid_c} OCPU / {paid_m} GB paid" if (paid_c or paid_m) else "all free"
    return (f"ok      free-tier  A1 limit {limits['a1_cores']} OCPU / {limits['a1_memory_gb']} GB, block {limits['block_gb']} GB; "
            f"module assumes {module['free_ocpus']} / {module['free_memory_gb']}, provisions "
            f"{module['worker_ocpus']} / {module['worker_memory_gb']} ({paid})")


def oci_json(*args: str) -> list:
    out = subprocess.run(["oci", *args, "--output", "json"], capture_output=True, text=True, timeout=120)
    if out.returncode != 0:
        raise RuntimeError(f"oci {' '.join(args[:4])}: {out.stderr.strip().splitlines()[-1][:160] if out.stderr.strip() else 'rc ' + str(out.returncode)}")
    return json.loads(out.stdout or "{}").get("data", [])


def limit_value(tenancy: str, service: str, name: str) -> int:
    rows = oci_json("limits", "value", "list", "--compartment-id", tenancy, "--service-name", service, "--name", name, "--all")
    vals = [int(r["value"]) for r in rows if r.get("value") is not None]
    if not vals:
        raise RuntimeError(f"limits value list returned no rows for {service}/{name}")
    return max(vals)  # per-AD limits: the best AD is the one the node pool lives in


def main(argv: list[str]) -> int:
    blind = lambda why: (print(f"BLIND   free-tier  {why}"), 2)[1]
    if not shutil.which("oci"):
        return blind("oci CLI is not installed")
    tenancy = os.environ.get("OCI_TENANCY_OCID", "")
    if not tenancy:
        return blind("OCI_TENANCY_OCID is not set")
    try:
        module = module_numbers()
        limits = {
            "a1_cores": limit_value(tenancy, "compute", "standard-a1-core-count"),
            "a1_memory_gb": limit_value(tenancy, "compute", "standard-a1-memory-count"),
            "block_gb": limit_value(tenancy, "block-storage", "total-storage-gb"),
        }
    except (RuntimeError, ValueError, OSError, subprocess.TimeoutExpired, json.JSONDecodeError) as exc:
        return blind(str(exc)[:200])
    line = grade(limits, module)
    print(line)
    if "--json" in argv:
        print(json.dumps({"limits": limits, "module": module, "verdict": line.split()[0]}))
    return 0 if line.startswith("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
