#!/usr/bin/env bash
# crew#516 CP5 / LAW 50: read the cluster's science-facts receipt from Object Storage. The CronJob
# in platform/science/science-facts.yaml counts, per source, the science rows the estate collector's
# backend holds for the last 24 hours (ClickHouse, attribute science.source) every hour and writes
# science/facts from the node's instance principal; this reads it with whatever OCI auth the caller
# has. Same grading shape as bin/idp-telemetry-coverage, which it was copied from.
#   ok      science-facts  <line 1 of the receipt>   -- fresh, at least one source, every otlp source in --sources seen
#   FAIL    science-facts  <why>                     -- receipt missing, stale, no source reached the backend, or a registered source never seen
#   BLIND   science-facts  <why>                     -- no oci CLI, no session, or the backend could not be queried
# --json prints the body. --sources <crew science/sources.json> diffs the closed world: every
# source declaring `receiver: otlp` must appear in the receipt. Max age 120 min; override
# SCIENCE_FACTS_MAX_AGE_MIN.
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
BUCKET="${DRILL_RECEIPT_BUCKET:-estate-drill-receipts}"
MAX_MIN="${SCIENCE_FACTS_MAX_AGE_MIN:-120}"
SOURCES=""; JSON=""
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON=1 ;;
    --sources) SOURCES="$2"; shift ;;
    *) printf 'usage: %s [--json] [--sources sources.json]\n' "$0" >&2; exit 64 ;;
  esac
  shift
done
blind() { printf 'BLIND   science-facts  %s\n' "$1"; exit 2; }
fail()  { printf 'FAIL    science-facts  %s\n' "$1"; exit 1; }
command -v python3 >/dev/null || blind "python3 is not installed"
head=$("$IDP/bin/idp-cloud" object head --bucket "$BUCKET" --name science/facts 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
  case "$head" in
    *"404"*|*NotFound*|*"not found"*) fail "no receipt science/facts in bucket $BUCKET: the CronJob has never completed (Flux row science not reconciled, or the bucket is not applied yet)" ;;
    *) blind "object head failed: $(printf '%s' "$head" | tail -1 | cut -c1-160)" ;;
  esac
fi
body=$("$IDP/bin/idp-cloud" object get --bucket "$BUCKET" --name science/facts 2>/dev/null)
# crew#539 (2026-08-28 00:28Z, run 33129788480): the outage receipt (36 Flux rows, 40 pods with
# their last log) outgrew ARG_MAX and `python3: Argument list too long` graded the estate BLIND
# at the moment it needed reading. The body travels by file, never by argv.
bodyf=$(mktemp); trap 'rm -f "$bodyf"' EXIT; printf '%s' "$body" > "$bodyf"
python3 - "$head" "$bodyf" "$MAX_MIN" "$JSON" "$SOURCES" <<'PY'
import os as _os
def _body_arg(a):
    # crew#539: the receipt is a file path when the caller wrote it out (ARG_MAX, run 33129788480); a literal body is still accepted for the test harnesses.
    return (open(a, encoding='utf-8', errors='replace').read() if _os.path.isfile(a) else a).strip()
import json, re, sys
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
head, body, max_min, flag, sources_path = sys.argv[1], _body_arg(sys.argv[2]), float(sys.argv[3]), sys.argv[4], sys.argv[5]
line1, _, rest = body.partition("\n")
try:
    lm = json.loads(head)["last-modified"]
except Exception as e:
    print(f"BLIND   science-facts  object head carried no last-modified: {e}"); sys.exit(2)
age = (datetime.now(timezone.utc) - parsedate_to_datetime(lm)).total_seconds() / 60
if line1.startswith("BLIND "):
    print(f"BLIND   science-facts  {line1[:160]}"); sys.exit(2)
try:
    b = json.loads(rest)
except Exception:
    b = {}
def why():
    # LAW 28: a FAIL that hides its cause is not an instrument.
    out = "".join(f"\n        backend {k}: {str(v)[:200]}" for k, v in (b.get("backend_errors") or {}).items())
    return out
if not line1.startswith("ok "):
    print(f"FAIL    science-facts  receipt does not start with ok: {line1[:160]!r}{why()}")
    if flag:
        print(rest)
    sys.exit(1)
if age > max_min:
    print(f"FAIL    science-facts  receipt is {age:.0f} min old (max {max_min:.0f}): {line1[:120]}"); sys.exit(1)
kv = dict(m.groups() for m in re.finditer(r"(\w+)=(\d+)", line1))
if int(kv.get("sources", 0)) == 0:
    print(f"FAIL    science-facts  sources=0: {line1[:120]}{why()}"); sys.exit(1)
if sources_path:
    reg = json.load(open(sources_path))
    reg = reg if isinstance(reg, list) else reg.get("sources", [])
    want = sorted(s["name"] for s in reg if s.get("receiver") == "otlp")
    seen = set(b.get("sources") or {})
    missing = [n for n in want if n not in seen]
    if missing:
        print(f"FAIL    science-facts  {len(missing)} of {len(want)} otlp sources never reached the backend in the window: "
              + ", ".join(missing[:8]) + (f" ... and {len(missing) - 8} more" if len(missing) > 8 else ""))
        sys.exit(1)
    print(f"ok      science-facts  {line1} ({age:.0f} min ago); all {len(want)} otlp sources seen")
else:
    print(f"ok      science-facts  {line1} ({age:.0f} min ago)")
if flag:
    print(rest)
PY
