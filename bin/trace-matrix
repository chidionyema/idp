#!/usr/bin/env python3
"""trace-matrix: requirement -> scenario -> test, generated from the repository (crew#495 CP1).

Founder, 2026-08-27: "we need this definitely: a trace matrix". A traceability matrix is the
NASA/DO-178 artefact that says, for every requirement, which scenario states it and which
test runs it. Here the requirement is a Gherkin Feature, the scenario is its Scenario, and
the test is the pytest-bdd module that loads the feature with scenarios("..."), the same
binding rule bin/spec-gate enforces. Nothing on the page is typed by a person: a row that
cannot be derived from git and the test files does not exist (R29).

    bin/trace-matrix            render docs/TRACE-MATRIX.md and docs/trace-matrix.json
    bin/trace-matrix --check    same, then exit 1 when any feature is bound by no test

Grades per feature: BOUND (a test loads it), PENDING (the test is marked pending, so the
scenarios are skipped, not run), PROSE (under docs/prose/, intent that nothing runs, by rule),
UNBOUND (under features/ with no test; the defect). Unbound rows print first.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(os.environ.get("TRACE_MATRIX_ROOT") or Path(__file__).resolve().parent.parent)
OUT = ROOT / "docs" / "TRACE-MATRIX.md"
OUT_JSON = ROOT / "docs" / "trace-matrix.json"

# The same two rules bin/spec-gate uses, so the matrix and the gate cannot disagree.
SPEC_RE = re.compile(r"(^|/)(tests?|spec|features)/|(^|/)test_[^/]*\.py$|_test\.[a-z]+$|\.test\.[a-z]+$|\.spec\.[a-z]+$")
SCENARIO_RE = re.compile(r"^\s*Scenario( Outline)?:\s*(.+?)\s*$", re.M)
FEATURE_RE = re.compile(r"^\s*Feature:\s*(.+?)\s*$", re.M)
PENDING_RE = re.compile(r"pytest\.mark\.pending")
BOUND, PENDING, PROSE, UNBOUND = "BOUND", "PENDING", "PROSE", "UNBOUND"
PROSE_DIR = "docs/prose/"  # bin/spec-gate: a feature here is intent, run by nothing, and moves back under features/ the day a test names it (crew#297)


def git(root: Path, *args: str) -> str:
    return subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True, check=False).stdout


def rows(root: Path) -> list[dict]:
    files = git(root, "ls-files").split()
    tests = {f: (root / f).read_text(errors="ignore") for f in files if SPEC_RE.search(f) and not f.endswith(".feature")}
    out = []
    for f in sorted(x for x in files if x.endswith(".feature")):
        text = (root / f).read_text(errors="ignore")
        base = re.escape(os.path.basename(f))
        loads = re.compile(r"scenarios?\(\s*[\"'][^\"']*" + base + r"[\"']")
        bound_by = sorted(t for t, body in tests.items() if loads.search(body))
        if not bound_by:
            status = PROSE if f.startswith(PROSE_DIR) else UNBOUND
        else:
            status = PENDING if all(PENDING_RE.search(tests[t]) for t in bound_by) else BOUND
        added = git(root, "log", "--diff-filter=A", "--format=%h|%s", "-1", "--", f).strip()
        sha, _, subject = added.partition("|")
        pr = re.search(r"\(#(\d+)\)\s*$", subject)
        ticket = re.search(r"\b(crew#\d+)", subject)
        feature = FEATURE_RE.search(text)
        out.append({
            "feature": f,
            "title": feature.group(1) if feature else os.path.basename(f),
            "scenarios": [m.group(2) for m in SCENARIO_RE.finditer(text)],
            "bound_by": bound_by,
            "status": status,
            "added_in": sha,
            "pr": int(pr.group(1)) if pr else None,
            "ticket": ticket.group(1) if ticket else None,
        })
    order = {UNBOUND: 0, PENDING: 1, PROSE: 2, BOUND: 3}
    return sorted(out, key=lambda r: (order[r["status"]], r["feature"]))


def render(matrix: list[dict], taken: str) -> str:
    n_scen = sum(len(r["scenarios"]) for r in matrix)
    by = {s: [r for r in matrix if r["status"] == s] for s in (BOUND, PENDING, PROSE, UNBOUND)}
    run_scen = sum(len(r["scenarios"]) for r in by[BOUND])
    lines = [
        "# Trace matrix",
        "",
        f"GENERATED by `bin/trace-matrix` from every tracked `*.feature` file and the tests that load them "
        f"(`scenarios(\"...\")`, the bin/spec-gate rule), taken {taken}. Unbound rows first. Do not edit by hand.",
        "",
        "## The bar",
        "",
        f"- Features: **{len(by[BOUND])} BOUND**, **{len(by[PENDING])} PENDING**, **{len(by[PROSE])} PROSE**, **{len(by[UNBOUND])} UNBOUND** of {len(matrix)}",
        f"- PROSE is a feature under `{PROSE_DIR}`: intent that nothing runs, by the spec-gate rule; it is counted, not failed. UNBOUND is a feature under `features/` with no test, and fails `--check`.",
        f"- Scenarios: **{run_scen} run by a test** of {n_scen}",
        "",
        "## Requirement -> scenario -> test",
        "",
        "| Status | Feature | Scenarios | Bound by | Added in |",
        "|---|---|---|---|---|",
    ]
    for r in matrix:
        scen = "<br>".join(r["scenarios"]) or "(none)"
        bound = "<br>".join(f"`{t}`" for t in r["bound_by"]) or "nothing runs it"
        added = (f"#{r['pr']}" if r["pr"] else r["added_in"] or "?") + (f" {r['ticket']}" if r["ticket"] else "")
        lines.append(f"| {r['status']} | `{r['feature']}`<br>{r['title']} | {scen} | {bound} | {added} |")
    return "\n".join(lines) + "\n"


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description="requirement -> scenario -> test matrix, generated")
    ap.add_argument("--check", action="store_true", help="exit 1 when any feature is bound by no test")
    ap.add_argument("--out", type=Path, default=OUT)
    ap.add_argument("--json", type=Path, default=OUT_JSON)
    a = ap.parse_args(argv)
    taken = git(ROOT, "log", "-1", "--format=%cI").strip() or "?"
    matrix = rows(ROOT)
    a.out.parent.mkdir(parents=True, exist_ok=True)
    a.out.write_text(render(matrix, taken))
    a.json.write_text(json.dumps(matrix, indent=1) + "\n")
    unbound = [r for r in matrix if r["status"] == UNBOUND]
    prose = sum(1 for r in matrix if r["status"] == PROSE)
    n_scen = sum(len(r["scenarios"]) for r in unbound)
    word = "FAIL " if (a.check and unbound) else "ok   "
    print(f"{word} trace-matrix  {len(matrix)} features, {len(unbound)} unbound ({n_scen} scenarios nothing runs), {prose} prose -> {a.out.relative_to(ROOT) if a.out.is_relative_to(ROOT) else a.out}")
    return 1 if (a.check and unbound) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
