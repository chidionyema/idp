#!/usr/bin/env bash
# bin/idp-loop-meter -- how long a pull request takes to go green, this week against last
# (crew#584 CP4; founder 2026-08-28: "get faster at getting faster").
#
# GitHub is the ledger: every `ci` run on a pull_request event has a createdAt and an updatedAt,
# and the median of (updatedAt - createdAt) over successful runs is the number a person feels
# when they open a PR. Nothing is written anywhere; the meter reads what already exists (LAW 43).
#
#   idp-loop-meter [repo]        prints one line and exits
#     0  this week's median is not more than 20% slower than last week's (or last week is empty)
#     1  this week is more than 20% slower than last week: the loop got slower, say so loudly
#     2  BLIND: gh cannot list runs
#
# "Now" is the newest run's createdAt: the clock that stamped the ledger, never this machine's
# (crew#583, tests/test_guard_freshness_is_never_measured_against_this_machines_clock.py).
set -uo pipefail
repo="${1:-${IDP_REPO:-chidionyema/idp}}"
week=$((7 * 86400))
runs=$(gh run list --repo "$repo" --workflow ci --event pull_request --status success \
         --json createdAt,updatedAt --limit 1000 2>/dev/null) || { echo "BLIND loop-meter: gh cannot list ci runs for $repo"; exit 2; }
[ -n "$runs" ] && [ "$runs" != "null" ] || { echo "BLIND loop-meter: gh returned no runs for $repo"; exit 2; }
read -r this_n this_med last_n last_med < <(printf '%s' "$runs" | python3 -c '
import json, sys, statistics
from datetime import datetime, timezone
week = int(sys.argv[1])
def ts(s): return int(datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp())
runs = [(ts(r["createdAt"]), ts(r["updatedAt"])) for r in json.load(sys.stdin)]
now = max((c for c, _ in runs), default=0)
this, last = [], []
for c, u in runs:
    if now - week <= c <= now: this.append(u - c)
    elif now - 2 * week <= c < now - week: last.append(u - c)
med = lambda xs: int(statistics.median(xs)) if xs else 0
print(len(this), med(this), len(last), med(last))
' "$week")
line="median PR wall-clock this week ${this_med}s (n=$this_n), last week ${last_med}s (n=$last_n)"
if [ "$this_n" -eq 0 ]; then echo "BLIND loop-meter: no green PR run in the last 7 days on $repo"; exit 2; fi
if [ "$last_n" -gt 0 ] && [ "$((this_med * 100))" -gt "$((last_med * 120))" ]; then
  echo "FAIL  loop-meter: the loop got slower -- $line"; exit 1
fi
echo "ok    loop-meter: $line"
