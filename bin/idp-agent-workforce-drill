#!/usr/bin/env python3
"""The agent-workforce drill (crew#729 step 3): is the agent workforce taking its queue?

    bin/idp-agent-workforce-drill

Reads two surfaces from outside the cluster, with no kube path and no laptop session token:

  1. the board (GitHub issues of <owner>/crew in any of the crew's queued lanes), through `gh`
     with GH_TOKEN, an installation token of the estate's App;
  2. Langfuse's public API at https://langfuse.<zone>, with the project keys in
     LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY.

The property that breaks, and the only thing graded: a queued ticket is planned within the
grace period, and every plan the crew leaves has a trace behind it (LAW 50). Exit 0 with an
`ok` line, 1 with a `FAIL` line naming the ticket, 2 `BLIND` when a surface cannot be read --
a drill that lost its evidence reports BLIND, never green (silent green is the defect class).

Everything the estate is allowed to name comes from clusters/oke/estate-config.yaml (LAW 46):
ESTATE_GITHUB_OWNER for the board, ESTATE_ZONE for the Langfuse door. Overridable for tests and
for a hosted Langfuse: AGENT_WORKFORCE_BOARD (owner/repo), AGENT_WORKFORCE_QUEUE_LABEL, LANGFUSE_HOST,
AGENT_WORKFORCE_GRACE_MINUTES (default 60), AGENT_WORKFORCE_WINDOW_HOURS (default 24).
"""

from __future__ import annotations

import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta
from pathlib import Path

IDP = Path(__file__).resolve().parents[1]
# Ages are measured against GitHub's own clock, never this machine's (crew#583): the Date header
# of a response GitHub just served is the same authority that stamped created_at.
sys.path.insert(0, str(IDP / "bin" / "lib"))
from receipt_age import served_now  # noqa: E402 - path has to be set before the import

CLAIM_MARK = "Optimised:"  # the plan comment's last line; the crew's own claim mark (src/agent_workforce/main.py)
TRACE_NAME = "agent-workforce.run"  # the root span the crew opens on every worked ticket


def row(status: str, text: str) -> None:
    print("%-6s %-11s %s" % (status, "agent-workforce", text))


def config(key: str) -> str | None:
    text = (IDP / "clusters" / "oke" / "estate-config.yaml").read_text(encoding="utf-8")
    m = re.search(r"^\s*%s:\s*\"?([^\"\n]+)\"?\s*$" % re.escape(key), text, re.M)
    return m.group(1).strip() if m else None


def gh_json(path: str) -> list | dict | None:
    """One `gh api` call; None when GitHub cannot be asked (the caller reports BLIND)."""
    try:
        r = subprocess.run(
            ["gh", "api", "--paginate", path],
            capture_output=True,
            text=True,
            timeout=120,
            check=False,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        # --paginate concatenates arrays; a single page is a plain array already
        pages = [json.loads(p) for p in re.split(r"\]\s*\[", r.stdout) if p.strip()]
        out: list = []
        for p in pages:
            out += p if isinstance(p, list) else [p]
        return out


def when(stamp: str) -> datetime:
    return datetime.fromisoformat(stamp.replace("Z", "+00:00"))


def langfuse_traces(host: str, pk: str, sk: str, since: datetime) -> int | None:
    """How many traces named TRACE_NAME Langfuse holds since `since`; None when unreachable."""
    q = urllib.parse.urlencode(
        {"name": TRACE_NAME, "fromTimestamp": since.isoformat(), "limit": 100}
    )
    auth = base64.b64encode(f"{pk}:{sk}".encode()).decode()
    req = urllib.request.Request(
        f"{host.rstrip('/')}/api/public/traces?{q}",
        headers={"Authorization": f"Basic {auth}", "Accept": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            body = json.loads(r.read() or b"{}")
    except (urllib.error.URLError, json.JSONDecodeError, TimeoutError):
        return None
    data = body.get("data")
    if not isinstance(data, list):
        return None
    return len(data)


# The lanes the workforce takes work from; the same default the image carries. A label the
# board does not carry matches nothing, which is how the first deployment idled for a
# fortnight without ever taking a ticket (crew#850 CP0).
QUEUE_LABELS = "lane:platform,lane:agents,lane:observability,lane:security,lane:process,lane:dr"


def main() -> int:
    now = served_now()
    if now is None:
        row(
            "BLIND",
            "GitHub did not answer `gh api -i rate_limit` with a Date header; no age can be measured",
        )
        return 2
    grace = timedelta(minutes=float(os.environ.get("AGENT_WORKFORCE_GRACE_MINUTES", "60")))
    window = timedelta(hours=float(os.environ.get("AGENT_WORKFORCE_WINDOW_HOURS", "24")))
    labels = [
        name.strip()
        for name in os.environ.get("AGENT_WORKFORCE_QUEUE_LABELS", QUEUE_LABELS).split(",")
        if name.strip()
    ]
    owner = config("ESTATE_GITHUB_OWNER")
    board = os.environ.get("AGENT_WORKFORCE_BOARD") or (f"{owner}/crew" if owner else None)
    if not board:
        row(
            "BLIND",
            "clusters/oke/estate-config.yaml names no ESTATE_GITHUB_OWNER; no board to read",
        )
        return 2
    zone = config("ESTATE_ZONE")
    host = os.environ.get("LANGFUSE_HOST") or (
        f"https://langfuse.{zone}" if zone else None
    )
    pk, sk = (
        os.environ.get("LANGFUSE_PUBLIC_KEY", ""),
        os.environ.get("LANGFUSE_SECRET_KEY", ""),
    )

    since = now - window
    # GitHub's `labels` filter is an AND, so one call per lane and merge by issue number.
    merged: dict[int, dict] = {}
    for name in labels:
        q = urllib.parse.urlencode(
            {"labels": name, "state": "all", "since": since.isoformat(), "per_page": 100}
        )
        answer = gh_json(f"repos/{board}/issues?{q}")
        if answer is None:
            row(
                "BLIND",
                f"cannot list {board} issues labelled {name} through gh (GH_TOKEN?)",
            )
            return 2
        for issue in answer:
            if isinstance(issue, dict) and "pull_request" not in issue:
                merged.setdefault(int(issue["number"]), issue)
    issues = list(merged.values())

    planned: list[tuple[int, datetime]] = []
    waiting: list[tuple[int, float]] = []
    for issue in issues:
        n = int(issue["number"])
        comments = gh_json(f"repos/{board}/issues/{n}/comments?per_page=100")
        if comments is None:
            row("BLIND", f"cannot read the comments of {board}#{n}")
            return 2
        plans = [
            when(c["created_at"])
            for c in comments
            if CLAIM_MARK in (c.get("body") or "")
        ]
        if plans:
            newest = max(plans)
            if newest >= since:
                planned.append((n, newest))
        elif issue.get("state") == "open":
            age = now - when(issue["created_at"])
            if age > grace:
                waiting.append((n, age.total_seconds() / 60))

    if waiting:
        n, minutes = max(waiting, key=lambda w: w[1])
        row(
            "FAIL",
            f"{board}#{n} has waited {minutes:.0f} min for a plan (grace {grace.total_seconds() / 60:.0f}); the crew is not taking its queue",
        )
        return 1

    if not planned:
        # Nothing was queued past the grace period and nothing was worked: the queue is empty.
        # That is the state of the world, printed as such -- an empty queue is not a dead crew,
        # and a dead crew shows up here the moment a ticket is seeded (docs/runbooks/agent-workforce.md).
        row(
            "ok",
            f"queue empty: no queued ticket on {board} waited past {grace.total_seconds() / 60:.0f} min and none was planned in the last {window.total_seconds() / 3600:.0f}h",
        )
        return 0

    if not (host and pk and sk):
        row(
            "BLIND",
            f"{len(planned)} plan comment(s) on {board} but no Langfuse door or keys to confirm the trace",
        )
        return 2
    oldest_plan = min(p[1] for p in planned)
    traces = langfuse_traces(host, pk, sk, oldest_plan - timedelta(hours=1))
    if traces is None:
        row(
            "BLIND",
            f"{len(planned)} plan comment(s) on {board} but {host} did not answer /api/public/traces",
        )
        return 2
    if traces == 0:
        n = max(planned, key=lambda p: p[1])[0]
        row(
            "FAIL",
            f"the crew planned {board}#{n} but no trace named {TRACE_NAME} reached Langfuse (LAW 50)",
        )
        return 1
    tickets = ", ".join(f"#{n}" for n, _ in sorted(planned))
    row(
        "ok",
        f"planned {tickets} on {board} in the last {window.total_seconds() / 3600:.0f}h; {traces} trace(s) named {TRACE_NAME} in Langfuse",
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
