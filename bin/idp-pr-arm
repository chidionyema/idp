#!/usr/bin/env bash
# Arm a robot-opened pull request for merge, or say plainly that it is waiting on the founder.
#
# crew#267 / idp#1046. Every robot in the estate ended its run with `gh pr merge --auto`, and on
# 2026-08-30 the repository's `allow_auto_merge` was set to false alongside the founder-only-releases
# ruleset (created 2026-08-30T17:18Z, rules: pull_request, non_fast_forward, deletion). GitHub then
# answers that call with `GraphQL: Auto merge is not allowed for this repository
# (enablePullRequestAutoMerge)` and the step exits 1. Five callers did it, so five robots went red
# and stayed red: the catalogue deploy (image-update-pr), the shop deploy (the same branch),
# catalog-render, kini-finish, pr-age and conscience.
#
# The cost was not the red run. It was that nobody was told the estate had stopped deploying:
# idp#1011 carried the portal build from 2026-08-30T14:45Z onward and never merged, so
# catalogue.mumchimp.com served main-2913 for thirteen hours while every merge to main built an
# image nothing pointed at. clusters/oke/edge.yaml:154-160 records another lane hitting the same
# wall on the shop and moving the tag by hand rather than fixing the class.
#
# A robot cannot merge an infra pull request here and should not try: the founder approves every
# platform/, clusters/ and edge release (his ruling, 2026-08-30). So this tool asks GitHub what the
# repository actually allows and reports the true state, one line, `ok|waiting|FAIL  pr-arm  <why>`.
#
#   bin/idp-pr-arm <number> [--squash|--merge|--rebase]
#
# exit 0 armed, or waiting on the founder. exit 1 only when the pull request itself is broken.
set -euo pipefail
# shellcheck disable=SC2329  # invoked by the EXIT trap below
on_exit() {
	local rc=$?
	[ "$rc" -eq 0 ] || echo "FAIL    pr-arm  exited $rc"
	exit "$rc"
}
trap on_exit EXIT

n=${1:?usage: bin/idp-pr-arm <pr-number> [--squash|--merge|--rebase]}
how=${2:---squash}
repo=${GH_REPO:-${GITHUB_REPOSITORY:-chidionyema/idp}}

case "$how" in
--squash | --merge | --rebase) ;;
*)
	echo "FAIL    pr-arm  unknown merge method $how"
	exit 1
	;;
esac

allowed=$(gh api "repos/$repo" --jq '.allow_auto_merge' 2>/dev/null || echo unknown)

if [ "$allowed" = true ]; then
	gh pr merge "$n" --auto "$how" -R "$repo"
	echo "ok      pr-arm  #$n auto-merge armed ($how)"
	exit 0
fi

# Not an error, and not something a retry fixes. Name the one action that moves it.
echo "waiting pr-arm  #$n is open and green-or-pending; auto-merge is off on $repo (allow_auto_merge=$allowed), so the merge is the founder's: https://github.com/$repo/pull/$n"
exit 0
