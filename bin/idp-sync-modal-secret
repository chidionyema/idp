#!/usr/bin/env python3
"""Sync one vault entry, or a named set of Bitwarden Secrets Manager entries, into one Modal
secret.

The problem this replaces: `ephemeral/agent.py` (mums-concierge) already reads
`modal.Secret.from_name("kms-master-key")` etc, but nothing in this estate ever put those secrets
into Modal except a person typing `modal secret create ... KEY=VALUE` by hand once, off-vault --
so a rotation in Bitwarden/estate-vault never reaches Modal, and there is no receipt of what was
sent. This script is the missing other half of R52 for Modal: the vault (or Bitwarden, for the
fields only Bitwarden holds) stays the one source of truth, and Modal's copy is a sync, not a
second place someone edits.

Two sources, because this estate has two: `estate-vault` (OCI Vault, read by bin/idp-cloud, holds
secrets this estate mints itself -- e.g. concierge-tunnel) and Bitwarden Secrets Manager (holds
secrets a vendor console hands out with no create-API, e.g. Twilio's; a founder pastes them once,
decision 0017/0020). `--from-bitwarden` reads Bitwarden directly with the estate's own machine
account (`bitwarden-machine` in estate-vault, the same credential and `bws` client vault-
bootstrap.yml already uses) -- it does NOT read the cluster's `human-twilio` Secret that
platform/human-vault-bridge/externalsecrets.yaml materializes from the same fields, because no
identity this estate mints for an agent or a CI job may read a Secret's value out of the cluster
(platform/rbac-floor/agent-reader.yaml and platform/jit/rbac.yaml both withhold it, by design,
LAW 21) -- Bitwarden is the actual origin, so reading it directly is one hop, not two, and needs
no new grant anywhere.

Never runs `modal token new`: this estate's own rule (R52, R75, bin/idp-set-root) is that the
Modal root lives once, as SEED_MODAL_TOKEN_ID / SEED_MODAL_TOKEN_SECRET (a GitHub Actions repo
secret, minted by bin/idp-set-root modal), never in a laptop's ~/.modal.toml. This script only
ever uses whatever MODAL_TOKEN_ID/MODAL_TOKEN_SECRET are already in its environment -- normally
set by the estate-bootstrap.yml CI job, not typed by a person before running this.

Usage:
    bin/idp-sync-modal-secret <vault-entry> [modal-secret-name]
    bin/idp-sync-modal-secret --from-bitwarden KEY1,KEY2,... <modal-secret-name>
    bin/idp-sync-modal-secret --preflight <vault-entry>

    vault-entry           Name of an idp-cloud secret, e.g. "concierge-tunnel".
    --from-bitwarden K,.. Reads these Bitwarden Secrets Manager entries by name (the same names
                          an ExternalSecret's remoteRef.key already uses, e.g. TWILIO_AUTH_TOKEN)
                          via the `bws` CLI, using the estate's bitwarden-machine access token.
                          Requires `bws` on PATH -- the caller installs it (pinned, checksummed,
                          same block as .github/workflows/vault-bootstrap.yml).
    modal-secret-name     Defaults to the vault-entry name (LAW 44: one fact, one name,
                          everywhere); mandatory for --from-bitwarden, since there is no single
                          source name a list of keys could default from.
    --preflight           Checks the vault entry is readable and `modal` can reach the API with
                          whatever MODAL_TOKEN_ID/MODAL_TOKEN_SECRET are already set -- writes
                          nothing to Modal. Not available for --from-bitwarden.

What it never does: print a field's value, log the source's contents, or fall back to a
placeholder when a field is empty -- an empty value is sent to Modal as sent, not silently dropped,
so a rotation that clears a field is reflected here rather than papered over with a stale copy.

Exit 2 (BLIND) when --from-bitwarden cannot reach Bitwarden at all (no `bws` on PATH, the machine
token refused, the identity call failing) -- a fence this runner cannot satisfy refuses nothing
else it could have judged (LAW 38), but it does mean the fact never reached Modal this run, and a
deploy that needs it should treat that exit code as real, not paper over it. A named key that
Bitwarden answers about but does not have is FAIL (1): the account works, the value just was
never pasted.
"""

from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

IDP = Path(__file__).resolve().parent.parent


def say(status: str, tag: str, msg: str) -> None:
    print(f"{status:<7} {tag:<20} {msg}")


def fail(tag: str, msg: str) -> None:
    say("FAIL", tag, msg)
    sys.exit(1)


def blind(tag: str, msg: str) -> None:
    say("BLIND", tag, msg)
    sys.exit(2)


def _read_vault(name: str) -> dict[str, str]:
    proc = subprocess.run(
        [str(IDP / "bin" / "idp-cloud"), "secret", "get", name],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        fail("vault", f"{name} not readable from estate-vault")
    try:
        fields: dict[str, str] = json.loads(proc.stdout)
    except json.JSONDecodeError:
        fail("vault", f"{name} did not decode as JSON")
        return {}  # unreachable, keeps type-checkers happy
    if not fields:
        fail("vault", f"{name} has no fields")
    return fields


def _bws_token() -> str:
    proc = subprocess.run(
        [str(IDP / "bin" / "idp-cloud"), "secret", "get", "bitwarden-machine"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        blind("bitwarden", "bitwarden-machine not readable from estate-vault")
    token = proc.stdout.strip()
    # The founder may have pasted the raw token or a JSON wrapper; accept both shapes (same
    # tolerance as .github/workflows/vault-bootstrap.yml, which reads this same vault entry).
    try:
        wrapped = json.loads(token)
        if isinstance(wrapped, dict) and "token" in wrapped:
            token = wrapped["token"]
    except json.JSONDecodeError:
        pass
    return token.strip('"')


def _read_bitwarden(keys: list[str]) -> dict[str, str]:
    bws = shutil.which("bws")
    if not bws:
        blind("bitwarden", "no bws CLI on PATH")
    env = dict(os.environ)
    env["BWS_ACCESS_TOKEN"] = _bws_token()
    listed = subprocess.run(
        [bws, "secret", "list", "--output", "json"],
        capture_output=True,
        text=True,
        env=env,
        timeout=30,
    )
    if listed.returncode != 0:
        blind("bitwarden", f"secret list failed: {listed.stderr.strip()[-200:]}")
    try:
        rows = json.loads(listed.stdout)
    except json.JSONDecodeError:
        blind("bitwarden", "secret list did not decode as JSON")
        return {}  # unreachable, keeps type-checkers happy
    by_key = {row.get("key"): row.get("id") for row in rows if row.get("key") in keys}
    missing = [k for k in keys if k not in by_key]
    if missing:
        fail("bitwarden", f"not in Secrets Manager (never pasted?): {', '.join(missing)}")
    fields: dict[str, str] = {}
    for key, secret_id in by_key.items():
        got = subprocess.run(
            [bws, "secret", "get", secret_id, "--output", "json"],
            capture_output=True,
            text=True,
            env=env,
            timeout=30,
        )
        if got.returncode != 0:
            fail("bitwarden", f"{key} not readable: {got.stderr.strip()[-200:]}")
        try:
            fields[key] = json.loads(got.stdout)["value"]
        except (json.JSONDecodeError, KeyError):
            fail("bitwarden", f"{key} did not decode as a Bitwarden secret")
    return fields


def _push_to_modal(modal_name: str, fields: dict[str, str]) -> None:
    # `modal secret create KEY=VALUE` on argv is a process listing (ps, an audit log, a crashed
    # subprocess's argv in a core dump) away from readable -- exactly what LAW 21 means by "never
    # appears anywhere it can be read again." `--from-json` on a short-lived file (mode 0600,
    # deleted with the tempdir) keeps every value off argv and stdout, and JSON has no dotenv-style
    # ambiguity over a value that itself contains `=` or a newline.
    with tempfile.TemporaryDirectory() as tmp:
        json_path = Path(tmp) / "secret.json"
        json_path.write_text(json.dumps(fields))
        json_path.chmod(0o600)
        result = subprocess.run(
            ["modal", "secret", "create", modal_name, "--from-json", str(json_path), "--force"],
            capture_output=True,
            text=True,
        )
    if result.returncode != 0:
        fail("modal", f"secret create {modal_name} failed: {result.stderr.strip()[-300:]}")
    say("OK", "modal", f"{modal_name} synced ({len(fields)} field(s))")


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] in ("--help", "-h"):
        print(__doc__)
        return

    if args and args[0] == "--from-bitwarden":
        args = args[1:]
        if len(args) != 2:
            fail(
                "usage",
                "bin/idp-sync-modal-secret --from-bitwarden KEY1,KEY2,... <modal-secret-name>",
            )
        fields = _read_bitwarden(args[0].split(","))
        _push_to_modal(args[1], fields)
        return

    preflight = False
    if args and args[0] == "--preflight":
        preflight = True
        args = args[1:]
    if len(args) not in (1, 2):
        fail(
            "usage",
            "bin/idp-sync-modal-secret [--preflight] <vault-entry> [modal-secret-name] | "
            "--from-bitwarden KEY1,KEY2,... <modal-secret-name>",
        )
    source = args[0]
    modal_name = args[1] if len(args) == 2 else source

    if preflight:
        check = subprocess.run(
            [str(IDP / "bin" / "idp-cloud"), "secret", "get", source],
            capture_output=True,
            text=True,
        )
        if check.returncode != 0 or not check.stdout.strip():
            fail("vault", f"{source} not readable from estate-vault")
        # `modal secret list` is read-only (names only, no values) but actually calls Modal's API,
        # unlike `modal profile current` which only reads the local config file and would report
        # "fine" against an expired or wrong token.
        modal_check = subprocess.run(
            ["modal", "secret", "list"], capture_output=True, text=True, timeout=30
        )
        if modal_check.returncode != 0:
            fail("modal", f"modal CLI not authenticated: {modal_check.stderr.strip()[-200:]}")
        say("OK", "preflight", f"{source} readable, modal API reachable")
        return

    _push_to_modal(modal_name, _read_vault(source))


if __name__ == "__main__":
    main()
