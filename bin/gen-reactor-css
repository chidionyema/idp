#!/usr/bin/env python3
"""Generate the Reactor's utility-class CSS from the markup that uses it.

    bin/gen-reactor-css [--write]

WHY THIS IS GENERATED. The Reactor is authored in Tailwind's vocabulary; this project has no
Tailwind, so a bridge file was maintained by hand -- and it drifted badly. Measured 2026-09-20:
`bg-black/40`, `bg-black/60`, `top-36`, `gap-2`, `px-2` and **83 others** were used in the markup
and ABSENT from the CSS. A missing class does not fail loudly -- it silently does nothing and the
element falls back to the browser default, which is how a `bg-black/40` button rendered as
`rgb(239,239,239)` white and a tab strip rendered as 9px black-on-grey.

Running this and committing the output removes the whole class of defect: every class in the
component has a rule, and the generator NAMES anything it cannot resolve rather than skipping it.

Prints the CSS to stdout; `--write` appends/updates the block in styles.css between the markers.
"""
from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
SRC = ROOT / "backstage/packages/app/src/modules/room/ui/FleetReactorApp.tsx"
CSS = ROOT / "backstage/packages/app/src/styles.css"
BEGIN = "/* ==== REACTOR UTILITIES — GENERATED by bin/gen-reactor-css ==== */"
END = "/* ==== END GENERATED ==== */"

# Tailwind's scale, including the halves that the first generator dropped.
SP = {
    "0": "0px", "0.5": "0.125rem", "1": "0.25rem", "1.5": "0.375rem", "2": "0.5rem",
    "2.5": "0.625rem", "3": "0.75rem", "3.5": "0.875rem", "4": "1rem", "5": "1.25rem",
    "6": "1.5rem", "7": "1.75rem", "8": "2rem", "9": "2.25rem", "10": "2.5rem", "11": "2.75rem",
    "12": "3rem", "14": "3.5rem", "16": "4rem", "20": "5rem", "24": "6rem", "28": "7rem",
    "32": "8rem", "36": "9rem", "40": "10rem", "44": "11rem", "48": "12rem", "52": "13rem",
    "56": "14rem", "60": "15rem", "64": "16rem", "72": "18rem", "80": "20rem", "96": "24rem",
    "full": "100%", "auto": "auto",
}
FS = {
    "[7px]": "7px", "[8px]": "8px", "[9px]": "9px", "[10px]": "10px", "[11px]": "11px",
    "[12px]": "12px", "[13px]": "13px", "[15px]": "15px", "[20px]": "20px",
    "xs": "0.75rem", "sm": "0.875rem", "base": "1rem", "lg": "1.125rem", "xl": "1.25rem",
    "2xl": "1.5rem", "3xl": "1.875rem",
}
RAD = {"none": "0", "sm": "0.125rem", "md": "0.375rem", "lg": "0.5rem", "xl": "0.75rem",
       "2xl": "1rem", "3xl": "1.5rem", "full": "9999px"}
SHD = {"sm": "0 1px 2px 0 rgba(0,0,0,.35)", "md": "0 4px 6px -1px rgba(0,0,0,.4)",
       "lg": "0 10px 15px -3px rgba(0,0,0,.45)", "xl": "0 20px 25px -5px rgba(0,0,0,.5)",
       "2xl": "0 25px 50px -12px rgba(0,0,0,.6)"}
# Named palette plus Tailwind's numeric scale, both as r,g,b so one regex covers `bg-cyan-500/20`.
COL = {
    "white": "255,255,255", "black": "0,0,0", "transparent": "0,0,0",
    "cyan": "0,240,255", "amber": "255,170,0", "red": "255,0,85", "green": "0,255,170",
    "blue": "59,130,246", "gray": "107,114,128", "slate": "100,116,139",
}
NUM = {
    "50": "248,250,252", "100": "241,245,249", "200": "226,232,240", "300": "203,213,225",
    "400": "148,163,184", "500": "100,116,139", "600": "71,85,105", "700": "51,65,85",
    "800": "30,41,59", "900": "15,23,42",
}
NUM_CYAN = {"100": "207,250,254", "300": "103,232,249", "400": "34,211,238", "500": "6,182,212", "600": "8,145,178"}
NUM_AMBER = {"300": "252,211,77", "400": "251,191,36", "500": "245,158,11", "600": "217,119,6"}
NUM_RED = {"300": "252,165,165", "400": "248,113,113", "500": "239,68,68", "600": "220,38,38"}
NUM_GREEN = {"300": "134,239,172", "400": "74,222,128", "500": "34,197,94", "600": "22,163,74"}


def rgb_for(name: str, shade: str | None) -> str | None:
    if shade is None:
        return COL.get(name)
    if name == "cyan" and shade in NUM_CYAN:
        return NUM_CYAN[shade]
    if name == "amber" and shade in NUM_AMBER:
        return NUM_AMBER[shade]
    if name == "red" and shade in NUM_RED:
        return NUM_RED[shade]
    if name == "green" and shade in NUM_GREEN:
        return NUM_GREEN[shade]
    if name in ("gray", "slate") and shade in NUM:
        return NUM[shade]
    if name in ("white", "black"):
        return COL[name]
    return None


def esc(c: str) -> str:
    return re.sub(r"([./\[\]()#%:,])", r"\\\1", c)


def classes_in_markup() -> set[str]:
    src = SRC.read_text()
    out: set[str] = set()
    # plain className="..."
    for m in re.finditer(r'className="([^"]*)"', src):
        out |= {c.strip() for c in m.group(1).split() if c.strip() and "$" not in c}
    # template literals: take the STATIC parts only, skipping ${...}
    for m in re.finditer(r"className=\{`([^`]*)`\}", src):
        static = re.sub(r"\$\{[^}]*\}", " ", m.group(1))
        out |= {c.strip() for c in static.split() if c.strip()}
    # conditional fragments inside a template literal: '...' and "..." arms
    for m in re.finditer(r"className=\{`[^`]*`\}", src):
        for arm in re.finditer(r"'([^']*)'", m.group(0)):
            out |= {c.strip() for c in arm.group(1).split() if c.strip()}
    return out


def rule_for(c: str) -> str | None:
    # ---- positioning
    if c == "absolute": return "position:absolute;"
    if c == "relative": return "position:relative;"
    if c == "fixed": return "position:fixed;"
    if c == "inset-0": return "top:0;right:0;bottom:0;left:0;"
    m = re.fullmatch(r"-(top|bottom|left|right)-\[(.+?)\]", c)
    if m: return f"{m.group(1)}: -{m.group(2)};"
    m = re.fullmatch(r"(top|bottom|left|right)-\[(.+?)\]", c)
    if m: return f"{m.group(1)}: {m.group(2)};"
    m = re.fullmatch(r"-(top|bottom|left|right)-(.+)", c)
    if m and m.group(2) in SP: return f"{m.group(1)}: -{SP[m.group(2)]};"
    m = re.fullmatch(r"(top|bottom|left|right)-(.+)", c)
    if m and m.group(2) in SP: return f"{m.group(1)}: {SP[m.group(2)]};"
    if c == "-translate-x-1/2": return "transform:translateX(-50%);"
    if c == "-translate-y-1/2": return "transform:translateY(-50%);"
    if c == "translate-x-1/2": return "transform:translateX(50%);"
    m = re.fullmatch(r"z-(\d+)", c)
    if m: return f"z-index:{m.group(1)};"
    # ---- display
    if c in ("flex", "inline-flex", "grid", "block", "inline-block", "hidden"):
        return f"display:{c};"
    if c == "flex-col": return "flex-direction:column;"
    if c == "flex-row": return "flex-direction:row;"
    if c == "flex-wrap": return "flex-wrap:wrap;"
    if c == "flex-1": return "flex:1 1 0%;"
    if c == "flex-none": return "flex:none;"
    if c.startswith("items-"): return f"align-items:${{'start':'flex-start'}}" if False else {"items-center": "align-items:center;", "items-start": "align-items:flex-start;", "items-end": "align-items:flex-end;", "items-baseline": "align-items:baseline;"}.get(c)
    if c.startswith("justify-"): return {"justify-between": "justify-content:space-between;", "justify-center": "justify-content:center;", "justify-start": "justify-content:flex-start;", "justify-end": "justify-content:flex-end;"}.get(c)
    m = re.fullmatch(r"gap-(.+)", c)
    if m and m.group(1) in SP: return f"gap:{SP[m.group(1)]};"
    m = re.fullmatch(r"gap-x-(.+)", c)
    if m and m.group(1) in SP: return f"column-gap:{SP[m.group(1)]};"
    m = re.fullmatch(r"gap-y-(.+)", c)
    if m and m.group(1) in SP: return f"row-gap:{SP[m.group(1)]};"
    m = re.fullmatch(r"grid-cols-(\d+)", c)
    if m: return f"grid-template-columns:repeat({m.group(1)},minmax(0,1fr));"
    if c == "overflow-hidden": return "overflow:hidden;"
    if c == "overflow-y-auto": return "overflow-y:auto;"
    if c == "overflow-x-hidden": return "overflow-x:hidden;"
    # ---- sizing
    if c == "w-full": return "width:100%;"
    if c == "h-full": return "height:100%;"
    if c == "h-screen": return "height:100vh;"
    m = re.fullmatch(r"w-\[(.+?)\]", c)
    if m: return f"width:{m.group(1)};"
    m = re.fullmatch(r"h-\[(.+?)\]", c)
    if m: return f"height:{m.group(1)};"
    m = re.fullmatch(r"(max|min)-w-\[(.+?)\]", c)
    if m: return f"{m.group(1)}-width:{m.group(2)};"
    m = re.fullmatch(r"min-h-\[(.+?)\]", c)
    if m: return f"min-height:{m.group(1)};"
    m = re.fullmatch(r"max-h-\[(.+?)\]", c)
    if m: return f"max-height:{m.group(1)};"
    for pre, prop in (("w-", "width"), ("h-", "height"), ("min-h-", "min-height"),
                      ("max-h-", "max-height"), ("max-w-", "max-width"), ("min-w-", "min-width")):
        if c.startswith(pre) and c[len(pre):] in SP:
            return f"{prop}:{SP[c[len(pre):]]};"
    # ---- spacing
    for pre, prop in (("p-", "padding"), ("pt-", "padding-top"), ("pb-", "padding-bottom"),
                      ("pl-", "padding-left"), ("pr-", "padding-right"),
                      ("m-", "margin"), ("mt-", "margin-top"), ("mb-", "margin-bottom"),
                      ("ml-", "margin-left"), ("mr-", "margin-right")):
        if c.startswith(pre) and c[len(pre):] in SP:
            return f"{prop}:{SP[c[len(pre):]]};"
    for pre, a, b in (("px-", "padding-left", "padding-right"), ("py-", "padding-top", "padding-bottom")):
        if c.startswith(pre) and c[len(pre):] in SP:
            v = SP[c[len(pre):]]
            return f"{a}:{v};{b}:{v};"
    if c == "mx-auto": return "margin-left:auto;margin-right:auto;"
    if c == "my-auto": return "margin-top:auto;margin-bottom:auto;"
    if c == "ml-auto": return "margin-left:auto;"
    if c == "mt-auto": return "margin-top:auto;"
    if c == "mr-auto": return "margin-right:auto;"
    # ---- type
    if c.startswith("text-") and c[5:] in FS: return f"font-size:{FS[c[5:]]};"
    if c == "font-bold": return "font-weight:700;"
    if c == "font-semibold": return "font-weight:600;"
    if c == "font-mono": return "font-family:ui-monospace,SFMono-Regular,Menlo,monospace;"
    if c == "font-sans": return "font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;"
    if c == "uppercase": return "text-transform:uppercase;"
    if c == "truncate": return "overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
    if c == "whitespace-nowrap": return "white-space:nowrap;"
    if c == "text-left": return "text-align:left;"
    if c == "text-center": return "text-align:center;"
    if c == "text-right": return "text-align:right;"
    m = re.fullmatch(r"tracking-(.+)", c)
    if m and m.group(1) in ("tighter", "tight", "normal", "wide", "wider", "widest"):
        v = {"tighter": "-0.05em", "tight": "-0.025em", "normal": "0", "wide": "0.025em",
             "wider": "0.05em", "widest": "0.1em"}[m.group(1)]
        return f"letter-spacing:{v};"
    m = re.fullmatch(r"leading-(.+)", c)
    if m and m.group(1) in ("none", "tight", "snug", "normal", "relaxed", "loose"):
        v = {"none": "1", "tight": "1.25", "snug": "1.375", "normal": "1.5",
             "relaxed": "1.625", "loose": "2"}[m.group(1)]
        return f"line-height:{v};"
    # ---- borders
    if c == "border": return "border-width:1px;border-style:solid;"
    if c == "border-0": return "border-width:0;"
    if re.fullmatch(r"border-[tblr]", c):
        side = {"t": "top", "b": "bottom", "l": "left", "r": "right"}[c[7]]
        return f"border-{side}-width:1px;border-{side}-style:solid;"
    if c == "rounded" or (c.startswith("rounded-") and c[8:] in RAD):
        v = RAD["md"] if c == "rounded" else RAD[c[8:]]
        return f"border-radius:{v};"
    m = re.fullmatch(r"border-\[(.+?)\]", c)
    if m: return f"border-color:{m.group(1)};"
    m = re.fullmatch(r"border-([a-z]+)(?:-(\d+))?(?:/(\d+))?", c)
    if m:
        rgb = rgb_for(m.group(1), m.group(2))
        if rgb:
            a = f"{int(m.group(3))/100:.2f}" if m.group(3) else "1"
            return f"border-color:rgba({rgb},{a});"
    # ---- background
    m = re.fullmatch(r"bg-\[(.+?)\]", c)
    if m and not m.group(1).startswith("repeating"):
        return f"background-color:{m.group(1)};"
    if c.startswith("bg-[repeating"):
        inner = c[len("bg-["):-1]
        return f"background-image:{inner};"
    m = re.fullmatch(r"bg-([a-z]+)(?:-(\d+))?(?:/(\d+))?", c)
    if m:
        rgb = rgb_for(m.group(1), m.group(2))
        if rgb:
            a = f"{int(m.group(3))/100:.2f}" if m.group(3) else "1"
            return f"background-color:rgba({rgb},{a});"
    # ---- foreground
    m = re.fullmatch(r"text-\[(#?[0-9a-fA-F]{3,8})\]", c)
    if m: return f"color:{m.group(1)};"
    m = re.fullmatch(r"text-([a-z]+)(?:-(\d+))?(?:/(\d+))?", c)
    if m:
        rgb = rgb_for(m.group(1), m.group(2))
        if rgb:
            a = f"{int(m.group(3))/100:.2f}" if m.group(3) else "1"
            return f"color:rgba({rgb},{a});"
    # ---- effects
    if c == "backdrop-blur-sm": return "backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);"
    if c == "backdrop-blur-md": return "backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);"
    # ARBITRARY VALUES WITH NESTED PARENS AND COMMAS.
    #
    # `shadow-[0_0_10px_rgba(0,240,255,0.8)]` defeats a `\[(.+?)\]` regex because the value
    # contains its own `(` and `,` -- and the earlier attempts silently produced no rule, which is
    # how six arbitrary-value classes ended up unstyled while the generator reported success.
    # Matched by PREFIX and sliced to the final `]`, so the content is never parsed.
    if c.startswith("shadow-[") and c.endswith("]"):
        return f"box-shadow:{c[8:-1].replace('_',' ')};"
    if c.startswith("hover:shadow-[") and c.endswith("]"):
        return f"HOVER::box-shadow:{c[14:-1].replace('_',' ')};"
    if c.startswith("bg-[repeating") and c.endswith("]"):
        return "SCANLINE"
    if c.startswith("bg-[") and c.endswith("]"):
        return f"background-color:{c[4:-1]};"
    if c.startswith("text-[") and c.endswith("]") and "#" in c:
        return f"color:{c[6:-1]};"
    # ARBITRARY VALUES: the brackets hold CSS, sometimes with spaces, commas and parens. Emitted
    # verbatim rather than parsed, because the value IS the declaration.
    m = re.fullmatch(r"(hover:)?shadow-\[(.+?)\]", c)
    if m:
        decl = f"box-shadow:{m.group(2).replace('_',' ')};"
        return decl if not m.group(1) else f"HOVER::{decl}"
    m = re.fullmatch(r"(hover:)?border-\[(.+?)\]", c)
    if m:
        decl = f"border-color:{m.group(2).replace('_',' ')};"
        return decl if not m.group(1) else f"HOVER::{decl}"
    m = re.fullmatch(r"shadow-\[(.+?)\]", c)
    if m: return f"box-shadow:{m.group(1).replace('_',' ')};"
    m = re.fullmatch(r"hover:border-([a-z]+)(?:-(\d+))?(?:/(\d+))?", c)
    if m:
        rgb = rgb_for(m.group(1), m.group(2))
        if rgb:
            a = f"{int(m.group(3))/100:.2f}" if m.group(3) else "1"
            return f"HOVERBORDER::{rgb}::{a}"
    if c == "drop-shadow-md": return "filter:drop-shadow(0 4px 3px rgba(0,0,0,.4));"
    if c == "mix-blend-overlay": return "mix-blend-mode:overlay;"
    if c == "text-ellipsis": return "text-overflow:ellipsis;"
    if c == "left-1/2": return "left:50%;"
    if c == "right-1/2": return "right:50%;"
    m = re.fullmatch(r"opacity-\[(.+?)\]", c)
    if m: return f"opacity:{m.group(1)};"
    m = re.fullmatch(r"text-\[(.+?)\]", c)
    if m: return f"font-size:{m.group(1)};"
    m = re.fullmatch(r"tracking-\[(.+?)\]", c)
    if m: return f"letter-spacing:{m.group(1)};"
    m = re.fullmatch(r"shadow-\[(.+?)\]", c)
    if m: return f"box-shadow:{m.group(1).replace('_',' ')};"
    m = re.fullmatch(r"placeholder-([a-z]+)(?:/(\d+))?", c)
    if m:
        rgb = rgb_for(m.group(1), None)
        if rgb:
            a = f"{int(m.group(2))/100:.2f}" if m.group(2) else "1"
            # `placeholder-*` targets the ::placeholder pseudo-element
            return f"PLACEHOLDER::{rgb}::{a}"
    if c in ("rail-card", "you"):
        return "TODO-named"  # handled below
    if c.startswith("selection:bg-"):
        m2 = re.fullmatch(r"selection:bg-([a-z]+)(?:-(\d+))?(?:/(\d+))?", c)
        if m2:
            rgb = rgb_for(m2.group(1), m2.group(2))
            if rgb:
                a = f"{int(m2.group(3))/100:.2f}" if m2.group(3) else "1"
                return f"SELECTION::{rgb}::{a}"
    if c == "outline-none": return "outline:none;"
    # ---- hover / state variants
    m = re.fullmatch(r"hover:(.+)", c)
    if m:
        base = rule_for(m.group(1))
        if base:
            return f"@{m.group(1)}"  # sentinel; handled by the caller
    if c in ("shadow", "shadow-md"):
        return f"box-shadow:{SHD['md']};"
    if c.startswith("shadow-") and c[7:] in SHD:
        return f"box-shadow:{SHD[c[7:]]};"
    m = re.fullmatch(r"opacity-(\d+)", c)
    if m: return f"opacity:{int(m.group(1))/100:.2f};"
    m = re.fullmatch(r"duration-(\d+)", c)
    if m: return f"transition-duration:{m.group(1)}ms;"
    if c == "transition-all": return "transition:all .2s ease;"
    if c == "transition-colors": return "transition:background-color .15s,color .15s,border-color .15s;"
    if c == "transition-opacity": return "transition:opacity .2s ease;"
    if c == "cursor-pointer": return "cursor:pointer;"
    if c == "cursor-crosshair": return "cursor:crosshair;"
    if c == "cursor-help": return "cursor:help;"
    if c == "select-none": return "user-select:none;"
    if c == "pointer-events-none": return "pointer-events:none;"
    if c == "pointer-events-auto": return "pointer-events:auto;"
    if c == "animate-pulse": return "animation:fleet-pulse 2s cubic-bezier(.4,0,.6,1) infinite;"
    if c == "animate-ping": return "animation:fleet-ping 1s cubic-bezier(0,0,.2,1) infinite;"
    if c == "resize-none": return "resize:none;"
    if c == "cursor-not-allowed": return "cursor:not-allowed;"
    return None


# COMPONENT CLASSES THE MARKUP USES AS HOOKS, not Tailwind utilities. They are written by hand
# below rather than generated, and they are here -- not in a separate file -- so the generator's
# output is provably complete: the live-page audit that found these found SEVEN gaps where the
# hand-written bridge had dropped the hologram's own styling, the scanline overlay and a hover
# state. A generator that cannot account for a class must say so; `unresolved` is that report.
_HANDWRITTEN = """
/* The hologram beside a node. Rendered only on hover or selection -- see the HOLOGRAM RULE in
   FleetReactorApp.tsx -- which is why it can afford a box and a blur where 24 permanent chips
   could not. */
.fleet-reactor .node-label {
  position: absolute; top: 0; left: 0; pointer-events: none;
  will-change: transform, opacity;
  display: flex; flex-direction: column; align-items: center; gap: 1px;
  padding: 2px 6px; border-radius: 6px;
  background: rgba(3,5,8,.75);
  border: 1px solid rgba(255,255,255,.1);
  backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
  white-space: nowrap; transition: opacity .25s ease;
}
.fleet-reactor .node-label .nl-state {
  font: 700 8px/1.2 ui-monospace, monospace; letter-spacing: .14em; text-transform: uppercase;
}
.fleet-reactor .node-label .nl-task {
  display: none; font: 10px/1.25 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  color: rgba(255,255,255,.9); max-width: 210px; overflow: hidden; text-overflow: ellipsis;
}
.fleet-reactor .node-label .nl-meta {
  display: none; font: 9px/1.2 ui-monospace, monospace; color: rgba(255,255,255,.45);
}
.fleet-reactor .node-label[data-near='1'] .nl-task,
.fleet-reactor .node-label[data-near='1'] .nl-meta { display: block; }
.fleet-reactor .node-label[data-selected='1'] { border-color: rgba(0,240,255,.5); background: rgba(3,5,8,.9); }

/* A PLAIN BUTTON. The browser paints its own grey chrome on every <button> that has no background
   of its own -- `rgb(239,239,239)` measured on the tab strip -- and that default wins over nothing
   we set, because we had set nothing. This removes the native appearance so the classes above are
   the only thing deciding how a control looks. */
/* AND IT MUST NOT OVERRIDE THE COLOUR CLASSES.
   The first version set `font: inherit; color: inherit` and `background: transparent`, which --
   being a LATER rule with equal specificity -- beat `text-white/35` and `bg-cyan-500/15` and left
   the tab transparent with black text, measured. The job here is ONLY to remove the browser's
   native button chrome; every visual decision belongs to the utility classes. So it sets nothing
   they set, and `background: none` is the one exception because the native default must go. */
.fleet-reactor .tab-plain {
  appearance: none; -webkit-appearance: none;
  margin: 0;
}
.fleet-reactor .tab-plain::-moz-focus-inner { border: 0; padding: 0; }
"""


def build() -> str:
    classes = classes_in_markup()
    lines = [BEGIN,
             "/* Generated from FleetReactorApp.tsx by bin/gen-reactor-css. Do not hand-edit:",
             "   a hand-written bridge is what produced 80+ missing classes and a white button. */",
             ".fleet-reactor { position: relative; background: #030508; }"]
    unresolved: list[str] = []

    def emit(sel: str, c: str, pseudo: str = "", hover: bool = False) -> bool:
        """Write one rule. Returns True when the class produced CSS.

        ONE PLACE THAT DECIDES, because five rounds of patching this loop left `for/else` blocks
        that never ran and prefixes that were silently skipped -- which is how
        `disabled:opacity-30`, `focus:border-cyan-500/50`, `selection:bg-cyan-500/30` and three
        arbitrary-value shadows all ended up with no rule while the generator reported success.
        """
        body = rule_for(c)
        if body is None:
            return False
        if body == "SCANLINE":
            lines.append(f"{sel} {{ background-image: repeating-linear-gradient(transparent,transparent 2px,#000 2px,#000 4px); }}")
            return True
        if body == "TODO-named":
            return True
        if body.startswith("HOVER::"):
            lines.append(f"{sel}:hover {{ {body[7:]} }}")
            return True
        if body.startswith("HOVERBORDER::"):
            _, rgb, alpha = body.split("::")
            lines.append(f"{sel}:hover {{ border-color: rgba({rgb},{alpha}); }}")
            return True
        if body.startswith("PLACEHOLDER::"):
            _, rgb, alpha = body.split("::")
            lines.append(f"{sel}::placeholder {{ color: rgba({rgb},{alpha}); }}")
            return True
        if body.startswith("SELECTION::"):
            _, rgb, alpha = body.split("::")
            lines.append(f".fleet-reactor ::selection {{ background: rgba({rgb},{alpha}); }}")
            return True
        if body.startswith("@"):
            return False
        lines.append(f"{sel}{pseudo} {{ {body} }}")
        return True

    for c in sorted(classes):
        if c in ("fleet-reactor", "group", "rail-card", "you"):
            continue
        sel = f".fleet-reactor .{esc(c)}"
        # state prefixes map to a pseudo-class or pseudo-element, and are NOT skipped
        if c.startswith("hover:"):
            if emit(sel, c[6:], hover=True):
                continue
        elif c.startswith("disabled:"):
            if emit(sel, c[9:], pseudo=":disabled"):
                continue
        elif c.startswith("focus:"):
            if emit(sel, c[6:], pseudo=":focus"):
                continue
        elif c.startswith("selection:"):
            if emit(sel, c[10:]):
                continue
        elif c.startswith("group-hover:"):
            continue   # a peer-driven state this page never triggers
        elif emit(sel, c):
            continue
        unresolved.append(c)

    lines += [_HANDWRITTEN, END, ""]
    if unresolved:
        print("UNRESOLVED CLASSES (no rule generated):", file=sys.stderr)
        for c in unresolved:
            print(f"  {c}", file=sys.stderr)
    return "\n".join(lines)


def main() -> int:
    css = build()
    if "--write" in sys.argv:
        text = CSS.read_text()
        if BEGIN in text:
            a = text.index(BEGIN)
            text = text[:a] + css + text[text.index(END, a) + len(END):].lstrip("\n")
        else:
            text = text.rstrip("\n") + "\n\n" + css
        CSS.write_text(text)
        print(f"wrote {css.count('{')} rules into {CSS.relative_to(ROOT)}", file=sys.stderr)
    else:
        print(css)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
