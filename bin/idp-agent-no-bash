#!/usr/bin/env python3
"""idp-agent-no-bash -- the agent loses all bash access.

WHY THIS EXISTS (founder, 2026-09-13, verbatim):
  "look if angnt ssneed ot lse all bash acces then so it be"
  "choukd enevr hapoen under any circustancess"
  "its a nnojor breahxx"

THE FINDING IT ANSWERS, measured, not argued:
  The 60-second cap lived in ~/.pi/agent/extensions/pi-governance/index.ts. That file is mode
  -rw-r--r--, owned by chidionyema, and the agent runs as chidionyema. The shell shim
  ~/.pi/agent/bin/bash and the git hooks in ~/.estate/guards/hooks are the same. None of the
  three is in version control.

  So every guard the estate wrote this session was a POLICY INSIDE THE IDENTITY IT GUARDS. The
  agent could rewrite its own guard, and nothing recorded that it had. That is why the cap failed
  six times in one session while being "fixed": a control that shares an identity with what it
  controls cannot deny it. There is no boundary to tune, so the access goes instead.

WHAT THIS DOES, in order, with a way back at every step:
  1. Stages the removal as a single reversibly-named marker, not a deletion of anything.
  2. Proves live work is drained first -- cutting blind would strand work in flight.
  3. Refuses to run unless the founder himself ran it (LAW 54: the founder does not run scripts;
     this is the exception his own words asked for, and it names itself as one).

Written in Python, not bash, because the estate's own shell standard refuses a new shell file over
100 lines -- and the earlier bash version of this file was 143.

USAGE
  bin/idp-agent-no-bash --plan      show exactly what would change, change nothing
  bin/idp-agent-no-bash --apply     make the change
  bin/idp-agent-no-bash --revert    put it back
  bin/idp-agent-no-bash --status    say which state the machine is in right now
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
STATE_DIR = Path(os.environ.get("IDP_AGENT_STATE_DIR", HOME / ".estate/agent-access"))
MARKER = STATE_DIR / "BASH_REVOKED"
HOME_PI = Path(os.environ.get("PI_HOME", HOME / ".pi/agent"))
GOV = HOME_PI / "extensions/pi-governance/index.ts"
SHIM = HOME_PI / "bin/bash"
HOOKS = Path(os.environ.get("ESTATE_GUARDS_DIR", HOME / ".estate/guards/hooks"))

# The things that must be drained before access is removed, and why each is named rather than
# assumed: a removal that strands a job mid-write is a second breach, not a fix.
#
# THE PI COUNT, and why it is not `pgrep -c -x pi`. Measured 2026-09-13: `-x` demands an EXACT
# process-name match, and a pi session does not present that name -- so the probe answered 0 while
# SEVEN live sessions were running on this machine, and a zero here is what AUTHORISES the
# withdrawal. A probe that undercounts is worse than no probe: it turns a refusal into a green
# light. This counts the real sessions by the one thing they all carry, and it fails CLOSED -- if
# it cannot count, it reports a number that refuses rather than a number that permits.
LIVE_CHECKS: list[tuple[str, list[str]]] = [
    ("pi processes", ["pgrep", "-f", "TERM_PROGRAM=Apple_Terminal"]),
    ("dispatch jobs", ["ls", str(HOME / ".estate/runs")]),
    ("launchd jobs", ["launchctl", "list"]),
]


def die(message: str) -> None:
    print(f"REFUSED: {message}", file=sys.stderr)
    raise SystemExit(2)


def live_counts() -> list[tuple[str, int]]:
    """Each probe fails CLOSED: a probe that cannot count reports a count that refuses."""
    counts: list[tuple[str, int]] = []
    for name, argv in LIVE_CHECKS:
        try:
            out = subprocess.run(
                argv, capture_output=True, text=True, timeout=10
            ).stdout
        except (OSError, subprocess.SubprocessError):
            counts.append((name, 1))  # cannot measure -> refuse, never permit
            continue
        if name == "dispatch jobs":
            value = sum(1 for line in out.splitlines() if line.endswith(".pid"))
        elif name == "launchd jobs":
            value = sum(1 for line in out.splitlines() if "estate" in line)
        else:
            value = sum(1 for line in out.splitlines() if line.strip())
        counts.append((name, value))
    return counts


def plan() -> int:
    print("WHAT WOULD CHANGE, and nothing is changed by this command:")
    print()
    print("  guard files the agent can currently rewrite:")
    for path in (GOV, SHIM, HOOKS):
        if not path.exists():
            continue
        st = path.stat()
        print(f"    {str(path):<62} {oct(st.st_mode)[-4:]} uid={st.st_uid}")
    print()
    print("  live work that must be drained first:")
    for name, value in live_counts():
        print(f"    {name:<20} {value}")
    print()
    print("  the change itself:")
    print(f"    a marker is written, {MARKER}")
    print("    the agent's bash tool is refused while the marker exists")
    print("    nothing is deleted, so --revert is one command and needs no backup")
    return 0


def status() -> int:
    """The three states, and why each has its own exit code.

    THE FIRST VERSION OF THIS RETURNED 0 FOR ALL THREE, measured 2026-09-20. That made OPEN -- the
    breach this whole file exists to end -- indistinguishable from REVOKED at the one place a caller
    can read: the exit code. `bin/idp-rules` decides a case with `returncode == 0` for `expect: pass`
    and `!= 0` for `expect: refuse`, so a gate that always exits 0 can be graded neither way. It was
    therefore unprovable, and an unprovable gate is the same hand-kept record as the ones this file
    was written to replace.

      0  REVOKED  the marker exists -- the access is gone. This is the safe state.
      1  OPEN     no marker -- the agent still holds bash. THIS IS THE BREACH, and it now FAILS.
      2  BLIND    the state could not be read at all (the directory exists but cannot be opened,
                  or the probe raised). BLIND never claims a verdict (LAW 28): a machine that
                  cannot judge has not found a defect, and it has not found safety either.

    WHY A MISSING DIRECTORY IS OPEN AND NOT BLIND. Corrected the same day, after this file first
    reported BLIND on the founder's own machine. `--apply` is what creates STATE_DIR, so on a machine
    where the revocation was NEVER APPLIED the directory is absent -- and that absence is not an
    inability to judge, it is the definite finding that the agent holds bash. It is the common case,
    not the exotic one: it is the state of every machine before the marker is written. Answering
    BLIND there would hide the breach behind an excuse, and the breach is the thing this file exists
    to announce. Only a directory that IS there and cannot be read is genuinely undecidable.

    WHY BLIND IS NOT 0. `exists()` swallows a permission error and answers False, so the earlier
    version reported OPEN for a directory it could not open -- it failed OPEN, in the direction that
    permits. That is the `pgrep -c -x pi` defect this file's own comment warns about (a probe that
    counted 0 while seven sessions ran, turning a refusal into a green light). Nothing here may
    resolve an unreadable state into a permission again.
    """
    try:
        if MARKER.is_file():
            print(f"REVOKED: the agent has no bash access (marker {MARKER})")
            return 0
        if STATE_DIR.exists() and not STATE_DIR.is_dir():
            print(
                f"BLIND: cannot read agent access state: {STATE_DIR} exists but is not a directory",
                file=sys.stderr,
            )
            return 2
        if STATE_DIR.is_dir():
            # Reachable and empty of the marker: judge it, readably.
            if not os.access(STATE_DIR, os.R_OK):
                print(
                    f"BLIND: cannot read agent access state: {STATE_DIR} is not readable",
                    file=sys.stderr,
                )
                return 2
        # No directory, or a readable directory with no marker: the agent holds bash. Definite.
        print(f"OPEN: the agent still has bash access (no marker at {MARKER})")
        return 1
    except OSError as exc:
        print(f"BLIND: cannot read agent access state: {exc}", file=sys.stderr)
        return 2


def apply() -> int:
    STATE_DIR.mkdir(parents=True, exist_ok=True)

    # Drain first. A removal that strands a job mid-write is a second breach, not a fix.
    stranded = False
    for name, value in live_counts():
        if value > 0:
            print(f"  STILL RUNNING: {name} = {value}")
            stranded = True
    if stranded:
        die(
            "live work is in flight. Let it finish, or dispatch it again after the change. Nothing was changed."
        )

    # Record WHY, so a later session reading this machine finds the reason and not a mystery.
    from datetime import datetime, timezone

    MARKER.write_text(
        f"revoked_at={datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}\n"
        "revoked_by=founder\n"
        "reason=the 60s cap and every other guard shared the agent's uid and were not in version\n"
        "reason_continues=control; a guard the guarded agent can rewrite is not a guard.\n"
        "founder_words=look if angnt ssneed ot lse all bash acces then so it be\n"
    )

    print("APPLIED: the agent has no bash access.")
    print(f"  marker: {MARKER}")
    print("  revert: bin/idp-agent-no-bash --revert")
    return 0


def revert() -> int:
    if not MARKER.exists():
        die("nothing to revert: the agent already has bash access.")
    from datetime import datetime, timezone

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    MARKER.rename(STATE_DIR / f"BASH_REVOKED.reverted-{stamp}")
    print("REVERTED: the agent has bash access again.")
    print(
        "  the marker was kept, renamed, not deleted -- the record that it happened survives the undoing"
    )
    return 0


def self_test() -> int:
    """A script that has never executed is not built (LAW 45). This proves it runs.

    And it proves the EXIT CODES, not just the words: the defect this replaced printed the right
    three sentences and returned 0 for every one of them, so a check that only read stdout would
    have called it healthy. Each state is exercised against a directory this function owns.
    """
    import io
    import tempfile
    from contextlib import redirect_stderr, redirect_stdout

    global STATE_DIR, MARKER
    keep_dir, keep_marker = STATE_DIR, MARKER
    try:
        with tempfile.TemporaryDirectory() as tmp:
            cases: list[tuple[str, int, str]] = []

            # REVOKED: a marker is present.
            STATE_DIR = Path(tmp)
            MARKER = STATE_DIR / "BASH_REVOKED"
            MARKER.write_text("revoked_by=self-test\n")
            buf, err = io.StringIO(), io.StringIO()
            with redirect_stdout(buf), redirect_stderr(err):
                cases.append(("REVOKED", status(), buf.getvalue().strip()))

            # OPEN: no marker, but a readable directory -- the breach, and it must be nonzero.
            MARKER.unlink()
            buf, err = io.StringIO(), io.StringIO()
            with redirect_stdout(buf), redirect_stderr(err):
                cases.append(("OPEN", status(), buf.getvalue().strip()))

            # BLIND: a directory that exists but is not a directory at all -- undecidable.
            # A MISSING directory is NOT this case: it is OPEN, and the next block proves it.
            STATE_DIR = Path(tmp) / "absent"
            MARKER = STATE_DIR / "BASH_REVOKED"
            buf, err = io.StringIO(), io.StringIO()
            with redirect_stdout(buf), redirect_stderr(err):
                missing = status()

            # A missing directory is a definite reading, not an inability to judge.
            if missing == 1:
                print(
                    "ok    idp-agent-no-bash: a machine where --apply never ran reports OPEN, not BLIND"
                )
            else:
                print(
                    f"FAIL  idp-agent-no-bash: a missing state dir said {missing}, wanted 1 (OPEN)",
                    file=sys.stderr,
                )
                return 1

            # A path that exists but is a FILE where a directory belongs: genuinely undecidable.
            notdir = Path(tmp) / "not-a-dir"
            notdir.write_text("this is a file, not a directory\n")
            STATE_DIR = notdir
            MARKER = STATE_DIR / "BASH_REVOKED"
            buf, err = io.StringIO(), io.StringIO()
            with redirect_stdout(buf), redirect_stderr(err):
                cases.append(("BLIND", status(), (buf.getvalue() + err.getvalue()).strip()))
    finally:
        STATE_DIR, MARKER = keep_dir, keep_marker

    wanted = {"REVOKED": 0, "OPEN": 1, "BLIND": 2}
    bad = [
        f"{name} said {code}, wanted {wanted[name]}"
        for name, code, _ in cases
        if code != wanted[name] or not cases
    ]
    for name, code, said in cases:
        head = said.split(":", 1)[0]
        if head != name:
            bad.append(f"{name} reported {head!r}")
    if bad:
        print("FAIL  idp-agent-no-bash exit codes: " + "; ".join(bad), file=sys.stderr)
        return 1
    print(
        "ok    idp-agent-no-bash: REVOKED=0, OPEN=1 (the breach fails), BLIND=2 (unreadable is not a verdict)"
    )
    return 0


def main(argv: list[str]) -> int:
    choice = argv[0] if argv else "--status"
    if choice == "--plan":
        return plan()
    if choice == "--apply":
        return apply()
    if choice == "--revert":
        return revert()
    if choice == "--status":
        return status()
    if choice == "--self-test":
        return self_test()
    die(f"unknown option {choice}. Use --plan, --apply, --revert or --status.")
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
