#!/usr/bin/env python3
# bin/idp-prepush-verify: pre-push gate.
#
# The full pipeline: propose_patch -> verify -> seal -> admit. Each
# step is a separate MCP call. The hook refuses push if any step
# fails, with a printout naming the failing stage.

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
VERIFIER_CURL = os.path.join(HERE, "idp-verifier-curl")


def push_diff(remote: str, branch: str) -> str:
    # include --binary so file additions survive; --diff-algorithm=myers matches the verifier
    out = subprocess.run(
        [
            "git",
            "diff",
            f"{remote}/{branch}",
            "HEAD",
            "--diff-algorithm=myers",
            "--binary",
        ],
        capture_output=True,
        text=True,
        cwd=os.getcwd(),
    )
    return out.stdout


def call(verb: str, **kwargs) -> dict:
    argv = [sys.executable, VERIFIER_CURL, verb]
    for k, v in kwargs.items():
        cli = "--" + k.replace("_", "-")
        if isinstance(v, list):
            argv.extend([cli, *v])
        else:
            argv.extend([cli, str(v)])
    proc = subprocess.run(argv, capture_output=True, text=True, timeout=55)
    if proc.returncode not in (0, 2):
        raise SystemExit(f"verifier: {verb} transport failed:\n{proc.stderr}")
    try:
        return json.loads(proc.stdout)
    except json.JSONDecodeError:
        return {"raw_stdout": proc.stdout, "raw_stderr": proc.stderr}


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--remote", required=True)
    ap.add_argument("--branch", required=True)
    ap.add_argument("--summary", default="pre-push gate")
    args = ap.parse_args()

    diff = push_diff(args.remote, args.branch)
    if not diff.strip():
        return 0

    # Step 1: propose_patch
    proposal = call(
        "propose_patch",
        patch=diff,
        summary=args.summary,
    )
    ledger_id = proposal.get("payload", {}).get("ledger_id")
    if not ledger_id:
        sys.stderr.write(f"verifier: propose_patch refused: {json.dumps(proposal)}\n")
        return 1
    sys.stderr.write(f"verifier: proposed {ledger_id}\n")

    # Step 2: verify
    verdict = call("verify", ledger_id=ledger_id)
    cv = verdict.get("payload", {}).get("claim_verdict", "FAILED")
    if cv != "PASSED":
        sys.stderr.write(f"verifier: verify FAILED on {ledger_id}: {json.dumps(verdict)}\n")
        return 1
    sys.stderr.write(f"verifier: {ledger_id} PASSED\n")

    # Step 3: seal
    sealed = call("seal", ledger_id=ledger_id)
    if not sealed.get("ok"):
        sys.stderr.write(f"verifier: seal refused: {json.dumps(sealed)}\n")
        return 1
    sys.stderr.write(f"verifier: {ledger_id} sealed\n")

    # Step 4: admit
    admitted = call("admit", ledger_id=ledger_id)
    if not admitted.get("payload", {}).get("ok"):
        sys.stderr.write(f"verifier: admit refused: {json.dumps(admitted)}\n")
        return 1
    sys.stderr.write(f"verifier: {ledger_id} admitted; push allowed\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
