#!/usr/bin/env python3
"""KARMA live, read-only Chronos observation. Never records invented obligations."""
from __future__ import annotations

import argparse
import datetime as dt
import importlib.util
import json
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
KERNEL = ROOT / "platform" / "estate" / "karma" / "observer.py"
spec = importlib.util.spec_from_file_location("karma_estate_observer", KERNEL)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)


def live_runs(repo, timeout_s=20):
    """One bounded read; credentialless fallback ONLY for the public IDP repo."""
    path = f"repos/{repo}/actions/runs?per_page=100"
    proc = None
    try:
        proc = subprocess.run(
            ["gh", "api", path],
            capture_output=True, text=True, timeout=timeout_s, check=False,
        )
        if proc.returncode == 0:
            payload = json.loads(proc.stdout)
            if not isinstance(payload, dict) or not isinstance(payload.get("workflow_runs"), list):
                raise RuntimeError("GitHub run response missing workflow_runs")
            return payload["workflow_runs"]
    except FileNotFoundError:
        pass
    # Never replace private authenticated evidence with untrusted public guesses.
    # GitHub's public endpoint needs no model token or cloud credential; the
    # existing Chronos cluster may have neither gh nor GH_TOKEN provisioned.
    if repo != "chidionyema/idp":
        raise RuntimeError(f"authenticated Github observation unavailable: {repo}")
    req = urllib.request.Request(
        "https://api.github.com/" + path,
        headers={"Accept": "application/vnd.github+json",
                 "User-Agent": "idp-karma-observer/1.0"},
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout_s) as response:
            payload = json.load(response)
    except (urllib.error.URLError, TimeoutError) as exc:
        raise RuntimeError("public GitHub observation unavailable") from exc
    if not isinstance(payload, dict) or not isinstance(payload.get("workflow_runs"), list):
        raise RuntimeError("public GitHub response missing workflow_runs")
    return payload["workflow_runs"]


def main(argv=None):
    parser = argparse.ArgumentParser()
    parser.add_argument("--repo", default="chidionyema/idp")
    parser.add_argument("--runs-json", type=Path, help="Offline replay of GH API response")
    parser.add_argument("--now", help="UTC ISO test time override")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    timestamp = args.now or dt.datetime.now(dt.timezone.utc).isoformat()
    try:
        if args.runs_json:
            source = json.loads(args.runs_json.read_text(encoding="utf-8"))
            runs = source["workflow_runs"] if isinstance(source, dict) else source
        else:
            runs = live_runs(args.repo)
        result = mod.observe_runs(args.repo, runs, timestamp)
    except (OSError, ValueError, KeyError, json.JSONDecodeError,
            subprocess.TimeoutExpired, RuntimeError) as exc:
        result = {"schema": "karma.observation.v1", "repo": args.repo,
                  "recorded_at": timestamp, "state": "BLIND", "reason": str(exc)[:220]}
        print(json.dumps(result, sort_keys=True))
        return 2
    result["state"] = "MEASURED_WITH_UNVERIFIED_YIELD"
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        print(f"KARMA {args.repo}: {result['coverage']['runs_accepted']} GitHub runs; "
              f"{result['coverage']['unlinked_to_obligation']} lack FLOW obligation linkage; "
              "verified production yield UNKNOWN. See --json for exact run evidence.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
