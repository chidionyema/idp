#!/usr/bin/env python3
"""The verdict tool (crew#631 CP1). A gate's view of a verdict file, and the prover's signer.

  bin/idp-verdict sign   FILE                 sign in place; the key is VERDICT_HMAC_KEY or the
                                              vault entry verdict-hmac-key via bin/idp-cloud
  bin/idp-verdict verify FILE [--digest D]    ok / FAIL / BLIND line, exit 0 / 1 / 2
  bin/idp-verdict show   FILE                 the assertion table
  bin/idp-verdict schema                      create the append-only table and roles (idempotent)
  bin/idp-verdict store  FILE                 INSERT the verdict as role prover; ok when the row landed
  bin/idp-verdict list   [-n N] [--check ID]  newest rows, read as agent_role
  bin/idp-verdict refuse-test                 INSERT as agent_role and UPDATE as prover must both be refused
  bin/idp-verdict key-wall                    the cluster's pods must be REFUSED verdict-hmac-key (crew#631 CP2)

verify without a key grades TTL and digest only and says so: an unsigned check is not a check.
Grading, like every bin/idp-*: one line, `ok|FAIL|BLIND  verdict  <why>`.
"""

import json
import re
import os
import subprocess
import sys

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, IDP)
from probes import store as S  # noqa: E402
from probes import verdict as V  # noqa: E402


def key_from_env_or_vault():
    k = os.environ.get("VERDICT_HMAC_KEY")
    if k:
        return k.strip()
    try:
        out = subprocess.run(
            [
                os.path.join(IDP, "bin", "idp-cloud"),
                "secret",
                "get",
                "verdict-hmac-key",
            ],
            capture_output=True,
            text=True,
            timeout=120,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout.strip() if out.returncode == 0 and out.stdout.strip() else None


def pg_primary(timeout=60):
    """The estate Postgres primary's pod name, from the CNPG cluster's own status.
    estate-db-migrate moved the backstage database off backstage/postgres-0, the pod this
    used to exec into; since the move every verdict step that touches SQL has been BLIND
    ('pods "postgres-0" not found', verdict-backstage run 34012387932)."""
    r = subprocess.run(
        [
            os.path.join(IDP, "bin", "idp-kube"),
            "get", "cluster", "estate", "-n", "estate-db",
            "-o", "jsonpath={.status.currentPrimary}",
        ],
        capture_output=True, text=True, timeout=timeout,
    )
    name = r.stdout.strip()
    return name if r.returncode == 0 and name else None


def psql(sql, timeout=120):
    """Run SQL through psql inside the estate Postgres primary (local socket, the image trusts
    it). (rc, stdout, stderr). Cluster reach is bin/idp-kube, the same door the prover uses."""
    pod = pg_primary()
    if not pod:
        return 2, "", "estate-db cluster reports no currentPrimary"
    cmd = [
        os.path.join(IDP, "bin", "idp-kube"),
        "exec",
        "-i",
        "-n",
        "estate-db",
        pod,
        "-c",
        "postgres",
        "--",
        "psql",
        "-U",
        "postgres",
        "-d",
        "backstage",
        "-v",
        "ON_ERROR_STOP=1",
        "-At",
        "-f",
        "-",
    ]
    try:
        r = subprocess.run(
            cmd, input=sql, capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired) as e:
        return 2, "", f"{type(e).__name__}: {e}"
    return r.returncode, r.stdout, r.stderr


def store_cmds(cmd, argv):
    if cmd == "schema":
        rc, out, err = psql(S.SCHEMA_SQL)
        print(
            f"{'ok  ' if rc == 0 else 'BLIND'}   verdict  schema {'applied' if rc == 0 else err.strip()[:160]}"
        )
        return 0 if rc == 0 else 2
    if cmd == "store":
        with open(argv[1]) as f:
            v = json.load(f)
        rc, out, err = psql(S.insert_sql(v))
        landed = out.strip().splitlines()[-1:] == ["1"]
        print(
            f"{'ok  ' if landed else 'BLIND'}   verdict  store {v.get('verdict_id')} {v.get('outcome')} {'row landed as prover' if landed else err.strip()[:160]}"
        )
        return 0 if landed else 2
    if cmd == "list":
        n = int(argv[argv.index("-n") + 1]) if "-n" in argv else 20
        check = argv[argv.index("--check") + 1] if "--check" in argv else None
        rc, out, err = psql(S.list_sql(n, check))
        if rc != 0:
            print(f"BLIND   verdict  list {err.strip()[:160]}")
            return 2
        rows = [line for line in out.strip().splitlines() if "|" in line]
        for line in rows:
            print(f"        verdict  {line.replace('|', '  ')}")
        print(f"ok      verdict  list {len(rows)} rows as agent_role")
        return 0
    if cmd == "key-wall":
        # crew#631 CP2, the refusal side: ExternalSecret backstage/verdict-key-wall asks the cluster's
        # own store for verdict-hmac-key as the workers dynamic group. Not Ready with the vault's
        # refusal is the wall standing; Ready means a pod can read the signing key; absent is BLIND
        # (platform/verification/verdict-key-wall.yaml not landed).
        r = subprocess.run(
            [
                os.path.join(IDP, "bin", "idp-kube"),
                "get",
                "externalsecret",
                "-n",
                "backstage",
                "verdict-key-wall",
                "-o",
                "json",
            ],
            capture_output=True,
            text=True,
            timeout=180,
        )
        if r.returncode != 0:
            why = (r.stderr or r.stdout).strip().splitlines()[-1:] or ["no answer"]
            print(
                f"BLIND   verdict  key-wall  backstage/verdict-key-wall not readable: {why[0][:120]}"
            )
            return 2
        # ESO's Ready condition says only "could not get secret data from provider"; the vault's own
        # words (HTTP 404 / NotAuthorized) live in the object's events. Read both, so the wall is
        # graded on the refusal and not on any outage that also leaves the secret unsynced.
        ev = subprocess.run(
            [
                os.path.join(IDP, "bin", "idp-kube"),
                "get",
                "events",
                "-n",
                "backstage",
                "--field-selector",
                "involvedObject.name=verdict-key-wall",
                "-o",
                "json",
            ],
            capture_output=True,
            text=True,
            timeout=180,
        )
        events = []
        if ev.returncode == 0:
            try:
                events = json.loads(ev.stdout).get("items") or []
            except ValueError:
                events = []
        return grade_key_wall(json.loads(r.stdout), events)
    if cmd == "refuse-test":
        rc1, _, err1 = psql(S.refuse_sql())
        rc2, _, err2 = psql(S.refuse_update_sql())
        # 2026-08-31: the prover role has no UPDATE grant at all, so Postgres answers "permission
        # denied" before the append-only trigger can; both are the refusal the test wants. The old
        # test wanted the trigger's word alone and printed "UPDATE as prover ACCEPTED" over a refused
        # statement on every run (run 33346560259) — a FAIL that graded the wrong property.
        ok1 = rc1 != 0 and "permission denied" in err1
        ok2 = rc2 != 0 and ("append-only" in err2 or "permission denied" in err2)

        def _why(rc, err):
            if rc == 0:
                return "ACCEPTED: the statement ran"
            return "refused by something else: " + (err or "no error")[:100]

        print(
            f"{'ok  ' if ok1 else 'FAIL'}    verdict  INSERT as agent_role {'refused' if ok1 else _why(rc1, err1)}"
        )
        print(
            f"{'ok  ' if ok2 else 'FAIL'}    verdict  UPDATE as prover {'refused (' + ('append-only trigger' if 'append-only' in err2 else 'no UPDATE grant') + ')' if ok2 else _why(rc2, err2)}"
        )
        return 0 if ok1 and ok2 else 1
    return 2


def grade_key_wall(obj, events=()):
    """0 when the ExternalSecret is refused the key by the vault, 1 when it synced, 2 when it says
    nothing yet. Printed as one row; the message names the vault's own words, read from the Ready
    condition or, when that is generic, from the object's events (ESO puts the HTTP status there)."""
    conds = {
        c.get("type"): c for c in (obj.get("status") or {}).get("conditions") or []
    }
    ready = conds.get("Ready") or {}
    msg = (ready.get("message") or "")[:140]
    ctrl = obj.get("status", {}).get("syncedResourceVersion")
    if ready.get("status") == "True" or ctrl:
        print(
            f"FAIL    verdict  key-wall  a pod READ verdict-hmac-key through estate-vault: {msg or 'synced'}"
        )
        return 1
    refusal = re.compile(r"NotAuthorized|404|not authorized|denied|forbidden", re.I)
    said = [msg] + [
        (e.get("message") or "")[:200]
        for e in events
        if (e.get("involvedObject") or {}).get("name", "verdict-key-wall")
        == "verdict-key-wall"
    ]
    refused = next((t for t in said if refusal.search(t)), None)
    if ready.get("status") == "False" and refused:
        print(
            f"ok      verdict  key-wall  pods are refused verdict-hmac-key ({ready.get('reason')}: {refused[:140]})"
        )
        return 0
    print(
        f"BLIND   verdict  key-wall  no verdict from the store yet: {ready.get('reason') or 'no Ready condition'} {msg}"
    )
    return 2


def main(argv):
    if argv and argv[0] in ("schema", "store", "list", "refuse-test", "key-wall"):
        if argv[0] == "store" and len(argv) < 2:
            print(__doc__)
            return 2
        return store_cmds(argv[0], argv)
    if len(argv) < 2 or argv[0] not in ("sign", "verify", "show"):
        print(__doc__)
        return 2
    cmd, path = argv[0], argv[1]
    with open(path) as f:
        v = json.load(f)
    if cmd == "show":
        for a in v.get("assertions", []):
            print(
                f"{'ok  ' if a['ok'] else 'FAIL'}  {a['name']:44} expected {a['expected'][:40]!s:42} actual {a['actual'][:60]}"
            )
        print(
            f"{v.get('outcome')}  {v.get('check_id')} {v.get('target')} digest={str(v.get('artifact_digest'))[:24]} nonce={v.get('nonce')} ttl={v.get('ttl_seconds')}s sig={'yes' if v.get('sig') else 'NONE'}"
        )
        return 0
    key = key_from_env_or_vault()
    if cmd == "sign":
        if not key:
            print(
                "BLIND   verdict  no signing key: set VERDICT_HMAC_KEY or put verdict-hmac-key in the vault (oke-check apply)"
            )
            return 2
        with open(path, "w") as f:
            json.dump(V.sign(v, key), f, indent=1, sort_keys=True)
        print(f"ok      verdict  signed {v.get('check_id')} {v.get('outcome')}")
        return 0
    digest = None
    if "--digest" in argv:
        digest = argv[argv.index("--digest") + 1]
    state, why = V.grade(v, key, artifact_digest=digest)
    note = (
        ""
        if key
        else " (no key here: signature NOT checked; only the control plane can)"
    )
    if state == "PASS":
        print(
            f"ok      verdict  {v['check_id']} PASS on {v['artifact_digest'][:24]} nonce {v['nonce']}{note}"
        )
        return 0 if key else 2
    print(f"FAIL    verdict  {v.get('check_id')} {state}: {why}{note}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
