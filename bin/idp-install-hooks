#!/usr/bin/env bash
# Wire this clone at .githooks AND surface every silent trap the session-plane rungs depend on.
#
# .githooks/pre-push (crew#584 CP2) was deleted 2026-09-21 -- the reason is at the deletion site
# below -- and its rungs now run in CI. Each still depends on some combination of tools,
# credentials or local services. Before this file was a preflight, a fresh clone learned
# about each dependency the moment it broke: `gh` missing surfaced when push-on-green BLINDed,
# the MCP verifier at 127.0.0.1:8001 surfaced as a Connection refused traceback the first time
# an agent pushed. Founder called both classes out on 2026-09-16: "silent things ... only
# discovered after the fact is not good" and "we are moving away from Mac or laptop dependency".
# This file is the up-front discovery point: no push is refused without the setup step naming
# the reason.
#
# Three states for each probe:
#   OK     the rung will run and can refuse a push
#   BLIND  the tool or service is absent AND the rung it belongs to fails-BLIND (informational
#          only, LAW 38: a fence a correct machine cannot satisfy is an outage). CI enforces the
#          same gate on the server side, so the push is still graded.
#   FAIL   the tool is absent AND the rung it belongs to is fail-closed. Install refuses; the
#          message names the exact package or endpoint.
#
# Idempotent. Safe to run on every checkout, and in CI where the printed report is the receipt.
case "${1:-}" in
  -h|--help)
    echo "bin/idp-install-hooks -- wire .githooks and install all CI-matrix tools; idempotent"
    exit 0
    ;;
esac
set -euo pipefail

# Resolve the CALLER's git dir before the cd below moves us to the main checkout. Inside a
# `git worktree add` tree this is .git/worktrees/<name>/, not .git/ -- and the worktree is the
# checkout whose commits need the key. Absolute, so the cd cannot invalidate it.
CALLER_SECRET_PATH="$(git rev-parse --path-format=absolute --git-path idp-hook-secret 2>/dev/null || echo)"

IDP="$(cd "$(dirname "$0")/.." && pwd)"
cd "$IDP"

# .githooks/pre-push was deleted 2026-09-21, so its absence is no longer a failure. It refused
# every push whose HEAD had no ~/.cache/idp-ci-verified/<sha> sentinel, i.e. it demanded a green
# `bin/idp-ci --full` first -- and --full cannot go green on a macOS workstation, because
# static-secret-gate grades the HOST rather than the diff: a stray .env anywhere under the home
# directory fails it no matter what is being pushed. A fence a correct machine cannot satisfy is
# an outage, not a gate. CI still runs the same rungs server-side (guarded-paths, verifier,
# offline-gate, bdd), which is where they can be enforced against the diff.

missing_required=0
lines=()

probe_bin() {
  local level="$1" name="$2" desc="$3"
  if command -v "$name" >/dev/null 2>&1; then
    local ver
    ver="$("$name" --version 2>&1 | head -1 | tr -d '\n' || true)"
    lines+=("[$level] $name  OK  ${ver:-installed}")
  else
    if [ "$level" = "REQ" ]; then
      lines+=("[$level] $name  FAIL  not on PATH -- $desc")
      missing_required=1
    else
      lines+=("[$level] $name  BLIND  not on PATH; the rung using it BLINDs, CI enforces -- $desc")
    fi
  fi
}

probe_py_module() {
  local level="$1" mod="$2" desc="$3"
  if python3 -c "import $mod" >/dev/null 2>&1; then
    lines+=("[$level] py:$mod  OK")
  else
    if [ "$level" = "REQ" ]; then
      lines+=("[$level] py:$mod  FAIL  python3 cannot import $mod -- $desc")
      missing_required=1
    else
      lines+=("[$level] py:$mod  BLIND  python3 cannot import $mod; rung using it BLINDs -- $desc")
    fi
  fi
}

probe_http() {
  local level="$1" name="$2" url="$3" desc="$4"
  if python3 - "$url" <<'PYPROBE' >/dev/null 2>&1
import sys, socket, urllib.request, urllib.error
url = sys.argv[1]
try:
    urllib.request.urlopen(url, timeout=2)
except urllib.error.HTTPError:
    pass
except (urllib.error.URLError, socket.timeout, ConnectionRefusedError, OSError):
    raise SystemExit(1)
PYPROBE
  then
    lines+=("[$level] $name  OK  $url")
  else
    if [ "$level" = "REQ" ]; then
      lines+=("[$level] $name  FAIL  unreachable at $url -- $desc")
      missing_required=1
    else
      lines+=("[$level] $name  BLIND  unreachable at $url; rung using it BLINDs, CI enforces -- $desc")
    fi
  fi
}

probe_bin       REQ git     "install git via your system package manager"
probe_bin       REQ python3 "install python 3.11+ via brew or apt"
probe_py_module REQ yaml    "pip install pyyaml (bin/idp-rules reads rules.yaml through it)"

probe_bin       REC gh      "brew install gh; without it push-on-green and pr-report BLIND"
probe_bin       REC ruff    "pip install ruff; used by bin/idp-ci fast rungs"

# Install all CI-matrix tools (kyverno, helm, conftest, flux, kustomize, kubeconform).
# These are required by bin/idp-ci --full and the pre-push kyverno rung; without them
# the hook refuses rather than going BLIND. Same pinned versions as CI.
echo ""
echo "=== installing CI-matrix tools (bin/idp-install-deps) ==="
if "$IDP/bin/idp-install-deps"; then
  export PATH="$HOME/.cache/estate-tools:$PATH"
  probe_bin REQ kyverno "bin/idp-install-deps failed to install kyverno"
  probe_bin REQ helm    "bin/idp-install-deps failed to install helm"
else
  lines+=("[REQ] idp-install-deps  FAIL  one or more CI tools could not be installed (see output above)")
  missing_required=1
fi
echo ""

probe_http      NET mcp-verifier "${IDP_MCP_URL:-http://127.0.0.1:8001/-/mcp}" \
  "the pre-push verifier rung POSTs the diff here; set IDP_MCP_URL to a remote endpoint (WJ.1 style) or start the local service; otherwise CI enforces the same gate"

echo "=== idp preflight ($(date -u +%Y-%m-%dT%H:%M:%SZ)) ==="
for l in "${lines[@]}"; do printf '  %s\n' "$l"; done
echo ""

if [ "$missing_required" -ne 0 ]; then
  echo "FAIL preflight: a required tool is missing (see [REQ] rows above). Install it and re-run bin/idp-install-hooks."
  echo "                Hooks are NOT installed."
  exit 1
fi

cur="$(git config --local core.hooksPath 2>/dev/null || true)"
if [ "$cur" = ".githooks" ]; then
  echo "ok    hooks   core.hooksPath already .githooks"
else
  git config --local core.hooksPath .githooks
  echo "ok    hooks   core.hooksPath set to .githooks (was: ${cur:-unset})"
fi
# Per-checkout hook secret. .githooks/commit-msg stamps every commit with an HMAC keyed
# by this file so CI can refuse commits that bypassed the hooks with --no-verify, and its
# header has always said "bin/idp-install-hooks provisions the secret" -- but this script
# had zero references to it (measured 2026-09-21). Whatever once created it is gone, so
# every fresh clone, and every `git worktree add` tree the rule-guard sends work into, hit
#   REFUSE: hook secret missing at <gitdir>/idp-hook-secret -- run bin/idp-install-hooks
# and could not commit at all, pointed at a script that did not do the thing. The secret
# is generated locally, lives only in the git dir (never on the tree) and is never
# printed: it is a per-checkout key, not a credential that travels.
#
# Both the main checkout AND the caller's checkout are provisioned. Before 2026-09-21 the cd
# above ran first, so a worktree caller silently keyed the MAIN clone, reported "ok", and then
# had every commit refused -- which forced --no-verify, which CI's guarded-paths rung then
# failed as an unsigned HEAD. That is what made PR #3832 red. CI only checks the trailer is
# PRESENT, never that the HMAC verifies (it cannot; the key is per-checkout and never on the
# tree), so two checkouts holding different keys is correct, not a conflict.
seen_secrets=""
for secret_path in "$(git rev-parse --path-format=absolute --git-path idp-hook-secret)" "$CALLER_SECRET_PATH"; do
  [ -n "$secret_path" ] || continue
  [ -d "$(dirname "$secret_path")" ] || continue
  case "$seen_secrets" in *"|$secret_path|"*) continue;; esac   # caller IS the main checkout
  seen_secrets="$seen_secrets|$secret_path|"
  if [ -s "$secret_path" ]; then
    echo "ok    secret  commit-msg HMAC key present ($(dirname "$secret_path"))"
  elif openssl rand -hex 32 > "$secret_path" 2>/dev/null; then
    chmod 600 "$secret_path"
    echo "ok    secret  commit-msg HMAC key provisioned ($(dirname "$secret_path"))"
  else
    rm -f "$secret_path"
    echo "WARN  secret  could not provision the commit-msg HMAC key (openssl missing?);"
    echo "        commits from this checkout will be refused by .githooks/commit-msg"
  fi
done

# Claude Code session hooks. The git hooks above refuse a bad push; these refuse a bad
# turn. Without them a Claude Code session on this clone runs with no token-optimisation
# enforcement at all -- measured on 2026-09-21, settings.json carried zero references to
# bin/idp-exec while idp/AGENTS.md had mandated it on every command since 2026-09-15.
# Idempotent, merges into the user's existing hooks, and refuses an unparseable
# settings.json rather than overwriting it.
"$IDP/.claude/hooks/install_session_hooks.py" || {
  echo "WARN  claude  session hooks not wired (see above); git hooks are installed"
}

echo "        every BLIND row above is a rung that will pass through at push time with a warning;"
echo "        every OK row is a rung that will run and can refuse the push."
