#!/usr/bin/env bash
# The front door's pulse, read from the estate's own clock (idp#229).
#
# platform/identity/front-door-heartbeat.yaml writes drills/front-door-heartbeat to the
# estate-drill-receipts bucket every five minutes. This prints one line and exits 0 only when
# the receipt starts with "ok " and is under DOOR_MAX_AGE_MIN (20) minutes old. BLIND when the
# bucket cannot be read at all; FAIL when it has never been written or the door was not a 302
# to the identity domain. Same shape as bin/idp-chaos-drill.
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
NAME=front-door-heartbeat
BUCKET="${DRILL_RECEIPT_BUCKET:-estate-drill-receipts}"
MAX_MIN="${DOOR_MAX_AGE_MIN:-20}"
blind() { printf 'BLIND   door-heartbeat  %s\n' "$1"; exit 2; }
fail()  { printf 'FAIL    door-heartbeat  %s\n' "$1"; exit 1; }
command -v python3 >/dev/null || blind "python3 is not installed"
head=$("$IDP/bin/idp-cloud" object head --bucket "$BUCKET" --name "drills/$NAME" 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
  case "$head" in
    *"404"*|*NotFound*|*"not found"*) fail "no receipt drills/$NAME in bucket $BUCKET: the CronJob identity/$NAME has never completed (Flux row identity not reconciled, or the bucket is not applied yet)" ;;
    *) blind "object head failed: $(printf '%s' "$head" | tail -1 | cut -c1-160)" ;;
  esac
fi
body=$("$IDP/bin/idp-cloud" object get --bucket "$BUCKET" --name "drills/$NAME" 2>/dev/null | head -1)
python3 - "$head" "$body" "$MAX_MIN" <<'PY'
import json, sys
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
head, body, max_min = sys.argv[1], sys.argv[2].strip(), float(sys.argv[3])
try:
    lm = json.loads(head)["last-modified"]
except Exception as e:
    print(f"BLIND   door-heartbeat  object head carried no last-modified: {e}"); sys.exit(2)
age = (datetime.now(timezone.utc) - parsedate_to_datetime(lm)).total_seconds() / 60
if not body.startswith("ok "):
    print(f"FAIL    door-heartbeat  receipt does not start with ok: {body[:140]!r}"); sys.exit(1)
if age > max_min:
    print(f"FAIL    door-heartbeat  receipt is {age:.0f} min old (max {max_min:.0f}): the CronJob stopped writing | fix: kubectl -n identity get cronjob front-door-heartbeat"); sys.exit(1)
print(f"ok      door-heartbeat  {body[:140]} ({age:.0f} min old, max {max_min:.0f})")
PY
