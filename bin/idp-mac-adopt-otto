#!/usr/bin/env bash
# ON THE FOUNDER'S MAC: let Otto (the hermes-agent pod) in over sshd, one command, no paste (crew#561).
#   bin/idp-mac-adopt-otto            read the public key from the latest oke-check apply run's log and
#                                     append it to ~/.ssh/authorized_keys once (idempotent); Remote Login on
#   bin/idp-mac-adopt-otto --check    exit 0 when authorized_keys holds the current key and sshd listens
#   bin/idp-mac-adopt-otto --shortcut-key 'ssh-ed25519 AAAA... shortcut'
#                                     authorise the iPhone Shortcut's own key the same idempotent way
#                                     (docs/founder/mac-remote-desk/README.md, Phase 4); no CI run read
#
# The key was minted on a CI runner (bin/idp-bootstrap-macrun) and only its public half is in the
# log, on the line `ok hermes-mac-run public key: ssh-ed25519 ...`. Nothing here needs a browser, a
# console, or a value typed by a person (LAW 31, R52). Remote Login is what answers port 22 on macOS
# (Tailscale SSH cannot run on the GUI Tailscale build, platform/tailscale/policy.hujson header).
set -euo pipefail
on_exit() {
	local ec=$?
	[ "$ec" -eq 0 ] || echo "  (exit $ec)" >&2
}
trap on_exit EXIT
REPO=${IDP_REPO:-$(git -C "$(dirname "$0")" remote get-url origin 2>/dev/null | sed -E 's#.*github.com[:/]##; s#\.git$##')}
WORKFLOW=${IDP_APPLY_WORKFLOW:-oke-check.yml}
MODE=adopt
[ "${1:-}" = --check ] && MODE=check
[ "${1:-}" = --shortcut-key ] && MODE=shortcut
AUTH="$HOME/.ssh/authorized_keys"
say() { printf '%-7s %-16s %s\n' "$1" "$2" "$3"; }
fail() {
	say FAIL mac-adopt-otto "$1"
	exit 1
}
if [ "$MODE" = shortcut ]; then
	key=${2:-}
	printf '%s' "$key" | grep -E '^ssh-ed25519 [A-Za-z0-9+/=]+' >/dev/null || fail "--shortcut-key wants the public key line the Shortcuts app shows (ssh-ed25519 ...)"
	run=shortcut
else
	command -v gh >/dev/null || fail "gh is not installed on this Mac"
	# The key line lives in the log of any dispatched run that reached bin/idp-bootstrap-macrun, whether
	# or not a later step of that run failed (2026-08-29: run 33280019151 minted the key and then failed
	# on unrelated steps; dispatched runs are titled "oke-check", so a title test matched nothing).
	# IDP_APPLY_RUN names one run outright.
	key=""
	run=""
	for cand in ${IDP_APPLY_RUN:-} $(gh run list --repo "$REPO" --workflow "$WORKFLOW" --event workflow_dispatch --limit 10 --json databaseId --jq '.[].databaseId' 2>/dev/null); do
		key=$(gh run view "$cand" --repo "$REPO" --log 2>/dev/null | grep -oE 'public key: ssh-ed25519 [A-Za-z0-9+/=]+ [^[:space:]]*( [^[:space:]]*)?' | tail -1 | sed 's/^public key: //' || true)
		if [ -n "$key" ]; then
			run=$cand
			break
		fi
	done
	[ -n "$run" ] || fail "no dispatched $WORKFLOW run in the last 10 printed a public key; dispatch one (mode=apply)"
fi
pub=$(printf '%s' "$key" | awk '{print $1" "$2}')
listening() { nc -z -w 2 127.0.0.1 22 >/dev/null 2>&1; }
if [ "$MODE" = check ]; then
	grep -qF "$pub" "$AUTH" 2>/dev/null || fail "authorized_keys does not hold the key from run $run"
	listening || fail "nothing listens on port 22; Remote Login is off"
	say ok mac-adopt-otto "key from run $run is authorized and sshd listens"
	exit 0
fi
mkdir -p "$HOME/.ssh"
chmod 700 "$HOME/.ssh"
touch "$AUTH"
chmod 600 "$AUTH"
if grep -qF "$pub" "$AUTH"; then
	say ok mac-adopt-otto "key from run $run already authorized"
else
	printf '%s\n' "$key" >>"$AUTH"
	say ok mac-adopt-otto "key from run $run appended to $AUTH"
fi
if ! listening; then
	# systemsetup is the documented switch for Remote Login (Apple: "sudo systemsetup -setremotelogin on").
	sudo systemsetup -setremotelogin on >/dev/null 2>&1 || fail "port 22 closed and systemsetup could not turn Remote Login on; System Settings > General > Sharing > Remote Login"
fi
listening || fail "sshd still not listening"
say ok mac-adopt-otto "sshd listens on 22; the pod's mac-run can reach this Mac"
