#!/usr/bin/env python3
"""idp-max-open-prs-gate — refuses a push that would open a new PR when the REPO already has
MAX or more open non-bot PRs. Called by .githooks/pre-push for every branch pushed.

Founder 2026-09-17: 10 open PRs was 'red signal', consolidated into one branch, and this gate
ensures we never return to that state. This is a REPO-WIDE cap, not per-author: the estate as a
whole holds no more than 5 open PRs at any time (bot lanes excluded). The cap is a constant, not
an env var: raising it is a reviewed change, not something a push can set.

On 2026-09-27 the repo reached 16 open PRs anyway: nothing called this gate, and it passed
whenever GH_TOKEN was unset, which it is in every laptop session. So now:
  - a push to a branch that already has an open PR always passes: fixing a red PR is how the
    count goes down, and the cap must never block it;
  - a new branch passes only while fewer than MAX are open, so it is at most the MAX-th;
  - the token comes from GH_TOKEN/GITHUB_TOKEN or `gh auth token` (captured, never printed);
    if the count still cannot be read the push is REFUSED (exit 2). A cap that passes when it
    cannot see is not a cap.

Bot lanes skipped (do not count against the cap, and are never refused):
  - branches starting with `flux/` (image-update loop)
  - authors ending in `[bot]` (github-actions, dependabot, image-update-pr bot)
  - PRs carrying an `image-update` label

  bin/idp-max-open-prs-gate                     # grade the estate right now
  bin/idp-max-open-prs-gate --branch fix/x      # may a push of fix/x go out?

Exit: 0 pass, 1 over the cap, 2 cannot read the open PRs.
"""
from __future__ import annotations
import argparse, json, os, subprocess, sys, urllib.request, urllib.error

CAP = 5
REPO = "chidionyema/idp"
# Pushes that never open a PR: main is ruleset-protected, agent-trunk batches itself.
NO_PR_BRANCHES = {"main", "agent-trunk"}


def token() -> str | None:
    tok = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if tok:
        return tok
    try:
        r = subprocess.run(["gh", "auth", "token"], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return r.stdout.strip() or None


def get_open_prs():
    tok = token()
    if not tok:
        print("REFUSED max-open-prs: no GH_TOKEN and `gh auth token` gave none; cannot count open PRs",
              file=sys.stderr)
        return None
    req = urllib.request.Request(
        f"https://api.github.com/repos/{REPO}/pulls?state=open&per_page=100",
        headers={"Authorization": f"token {tok}", "Accept": "application/vnd.github+json"})
    try:
        with urllib.request.urlopen(req, timeout=10) as fh:
            return json.load(fh)
    except (urllib.error.URLError, TimeoutError, ValueError) as e:
        print(f"REFUSED max-open-prs: GH API {e}; cannot count open PRs", file=sys.stderr)
        return None


def is_bot_lane(pr: dict) -> bool:
    ref = (pr.get("head") or {}).get("ref", "")
    if ref.startswith("flux/"):
        return True
    login = (pr.get("user") or {}).get("login", "")
    if login.endswith("[bot]"):
        return True
    for l in (pr.get("labels") or []):
        if l.get("name") == "image-update":
            return True
    return False


def decide(prs: list, branch: str | None, cap: int) -> tuple[int, str]:
    counted = [p for p in prs if not is_bot_lane(p)]
    n = len(counted)
    if branch is not None:
        if branch in NO_PR_BRANCHES or branch.startswith("flux/"):
            return 0, f"ok    max-open-prs  {branch} opens no PR"
        if any((p.get("head") or {}).get("ref") == branch for p in prs):
            return 0, f"ok    max-open-prs  {branch} already has an open PR ({n} open, cap {cap})"
        if n < cap:
            return 0, f"ok    max-open-prs  {n} open non-bot PRs; {branch} may be PR {n + 1} of {cap}"
    elif n <= cap:
        return 0, f"ok    max-open-prs  {n} open non-bot PRs (cap {cap})"
    lines = [f"FAIL  max-open-prs  {n} open non-bot PRs (cap {cap}) -- no new PR until one lands:"]
    for p in counted:
        who = (p.get("user") or {}).get("login", "?")
        lines.append(f"   #{p['number']:5d} by {who}  {p['title'][:80]}")
    lines.append("        push to one of those branches instead; pr-consolidate runs hourly at :17")
    return 1, "\n".join(lines)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--branch")
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()
    prs = get_open_prs()
    if prs is None:
        sys.exit(2)
    rc, text = decide(prs, args.branch, CAP)
    if not args.check or rc:
        print(text, file=sys.stderr if rc else sys.stdout)
    sys.exit(rc)


if __name__ == "__main__":
    main()
