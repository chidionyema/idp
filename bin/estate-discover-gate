#!/usr/bin/env python3
"""estate-discover-gate -- the check that the estate is not becoming less knowable.

WHAT IT CHECKS. The census (bin/estate-discover) reads the estate's own maps and names what
it can see. This gate compares that with the committed baseline and refuses when:

  1. a source became unreadable -- the census cannot see part of the estate at all;
  2. a kind of record shrank below the baseline -- something stopped being enumerated,
     which is a silent loss of discoverability;
  3. (--strict) any record has no status instrument -- the honest measurement of how much of
     the estate is BLIND. Strict mode is the founder's question asked as a verdict: how much
     of this estate can anyone actually know the status of?

It can fail, and it does: the strict mode fails today, on the measured number, and that
number is the point (2026-10-26: 481 of 700+ records had no status instrument).

    bin/estate-discover-gate
    bin/estate-discover-gate --strict
    bin/estate-discover-gate --json
"""

from __future__ import annotations

import argparse
import importlib.util
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
IDP = HERE.parent
DEFAULT_BASELINE = IDP / "catalog" / "estate-discover-baseline.json"


def load_discover():
    spec = importlib.util.spec_from_loader(
        "estate_discover",
        importlib.machinery.SourceFileLoader(
            "estate_discover", str(HERE / "estate-discover")
        ),
    )
    if spec is None or spec.loader is None:
        raise RuntimeError("cannot load bin/estate-discover")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="estate-discover-gate",
        description="Refuse when the estate becomes less knowable than its baseline.",
    )
    parser.add_argument("--idp", default="")
    parser.add_argument("--home", default="")
    parser.add_argument("--baseline", default=str(DEFAULT_BASELINE))
    parser.add_argument("--strict", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    discover = load_discover()
    census = discover.Census(
        idp=Path(args.idp) if args.idp else None,
        home=Path(args.home) if args.home else None,
    )
    census.build()
    baseline: dict = {}
    baseline_path = Path(args.baseline)
    if baseline_path.exists():
        try:
            baseline = json.loads(baseline_path.read_text())
        except ValueError:
            baseline = {}
    ok, failures, facts = discover.gate_verdict(census, baseline, strict=args.strict)

    if args.json:
        print(
            json.dumps({"ok": ok, "failures": failures, **facts}, indent=2, default=str)
        )
        return 0 if ok else 1

    print(
        f"records: {facts['counts'] and sum(facts['counts'].values()) or 0} "
        f"({', '.join(f'{k}={v}' for k, v in sorted(facts['counts'].items()))})"
    )
    print(
        f"BLIND records (no status instrument): {facts['blind_records']}"
        + (
            "  ["
            + ", ".join(f"{k}={v}" for k, v in sorted(facts["blind_fields"].items()))
            + "]"
            if facts["blind_fields"]
            else ""
        )
    )
    if ok:
        print(
            "ok      estate-discover-gate  the estate is at least as knowable as its baseline"
        )
        return 0
    for failure in failures:
        print(f"FAIL    estate-discover-gate  {failure}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
