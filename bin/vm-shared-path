#!/usr/bin/env bash
# Refuse a bind-mount source the container VM cannot see.
#
# colima shares only the user's home directory with its VM by default, plus any
# `mounts:` entries in colima.yaml. A compose bind mount whose source lies outside
# that tree does not fail: the VM hands the container an EMPTY DIRECTORY, so a file
# mount turns into "Is a directory" and a database into "unable to open database
# file". 2026-08-25: bin/mcp-up run from a worktree under /private/tmp took the
# shared estate MCP stack down for 8 minutes that way. Memory
# colima-mounts-home-only-bind-becomes-dir records the class.
#
# Usage: vm-shared-path PATH...   exit 0 when every PATH is under a shared tree,
#                                 exit 2 naming the first that is not.
# Env:   VM_SHARED_ROOTS  colon-separated override of the shared roots (tests).
set -euo pipefail
set -u
trap 'echo "$0: exit $?" >&2' EXIT
IFS=':' read -r -a roots <<<"${VM_SHARED_ROOTS:-$HOME}"
if [ -z "${VM_SHARED_ROOTS:-}" ]; then
	cfg="$HOME/.colima/default/colima.yaml"
	if [ -r "$cfg" ]; then
		while IFS= read -r loc; do
			loc="${loc/#\~/$HOME}"
			roots+=("$loc")
		done < <(sed -nE 's/^[[:space:]]*-[[:space:]]*location:[[:space:]]*"?([^"#]+)"?.*/\1/p' "$cfg")
	fi
fi
rc=0
for p in "$@"; do
	real=$(cd "$(dirname "$p")" 2>/dev/null && pwd -P)/$(basename "$p")
	ok=0
	for r in "${roots[@]}"; do
		r="${r%/}"
		rr=$(cd "$r" 2>/dev/null && pwd -P || echo "$r")
		case "$real/" in "$rr"/*)
			ok=1
			break
			;;
		esac
	done
	if [ "$ok" = 0 ]; then
		echo "FAIL  $p resolves to $real, outside the VM-shared tree (${roots[*]}); the container would see an empty directory"
		rc=2
		break
	fi
done
exit $rc
