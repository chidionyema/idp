#!/usr/bin/env bash
# The front door, driven the way a person drives it (crew#292 CP1), and the only instrument that
# answers the founder's "Face ID still not working" with a measurement rather than a guess.
#
# bin/idp-verify's login row follows a redirect chain and never carries a credential, so it proves
# the door redirects and nothing more. It cannot tell a working sign-in from a domain that hands
# every user a password-reset page, and it cannot tell a door that engages MFA from one that does
# not. This drill signs in for real, in a headless browser, as the domain user identity/apply
# creates for exactly this purpose, and reports what happens after the password: an MFA step or
# the catalogue. The Face ID assertion is the whole point -- the founder's ask is the door offering
# Face ID, and a "MFA never engages" door is the most common reason it does not.
#
# The password is Terraform's (random_password), lives only in the OCI vault as
# front-door-drill-password, and is read here into an environment variable that is never echoed
# and never reaches a log or an argv (LAW 46). The CI runner resolves the compartment via the
# GitHub OIDC exchange step; a laptop that has not bootstrapped secrets/dev/OCI_COMPARTMENT_OCID.yaml
# must export OCI_COMPARTMENT_OCID to its own value -- the drill prints a single, named FAIL line
# and exits 1 in either case.
#
#   bin/idp-login-drill
#
# Prints exactly one verdict line. Exits 0 when the door engaged an MFA step that offered
# Face ID or a security key -- observed and left uncompleted by default, or, with
# DRILL_ENROLL=1, completed and followed through to a rendered catalogue:
#   ok      login-drill  observed mfa=enroll, faceid=offered at <host> in 12.3s
#   ok      login-drill  signed in as estate-drill, mfa=challenge, faceid=offered in 11.7s
#   FAIL    login-drill  <stage> <detail>
#
# A door that signs in with the password alone fails at the mfa stage: a second factor never
# asked for is Face ID never offered, whatever the surfaces downstream go on to do.
#
# Stages, so a failure names the layer that broke: config, python, vault, browser, redirect,
# credentials, password-change, mfa, session, catalogue, identity.
#
# Python with Playwright: $DRILL_PYTHON if set, else python3. CI installs it in the job.
case "${1:-}" in
  -h|--help)
    echo "bin/idp-login-drill -- sign in to the portal as estate-drill and grade the door's MFA step."
    echo "Reads front-door-drill-password from the OCI vault. Requires playwright and a resolved OCI_COMPARTMENT_OCID."
    echo "Env: DRILL_ENROLL=1 also completes the Face ID / security-key ceremony with a virtual authenticator."
    exit 0
    ;;
esac
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
# estate-secrets sits beside the main checkout, even when this runs from a worktree
MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
export SUPPRESS_LABEL_WARNING=True
fail() { printf 'FAIL    login-drill  %s %s\n' "$1" "$2"; exit 1; }

CFG="$IDP/clusters/oke/estate-config.yaml"
[ -f "$CFG" ] || fail config "no $CFG"
ZONE=$(awk '/ESTATE_ZONE:/{print $2}' "$CFG")
DOMAIN=$(awk '/ESTATE_OIDC_DOMAIN_URL:/{print $2}' "$CFG")
[ -n "$ZONE" ] || fail config "clusters/oke/estate-config.yaml has no ESTATE_ZONE"
[ -n "$DOMAIN" ] || fail config "clusters/oke/estate-config.yaml has no ESTATE_OIDC_DOMAIN_URL"

PY="${DRILL_PYTHON:-python3}"
command -v "$PY" >/dev/null 2>&1 || fail python "no interpreter at '$PY'; set DRILL_PYTHON"
"$PY" -c 'import playwright' >/dev/null 2>&1 || fail python "$PY has no playwright; pip install playwright && playwright install chromium"

# --- the password, by name, out of the vault the client secrets already live in ---------------
export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}
C="${OCI_COMPARTMENT_OCID:-}"
if [ -z "$C" ]; then
  SEC="${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml"
  [ -f "$SEC" ] || fail config "no OCI_COMPARTMENT_OCID in the environment and no $SEC"
  C=$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "$SEC" 2>/dev/null) || fail config "cannot decrypt $SEC"
fi
DRILL_PASSWORD=$("$IDP/bin/idp-cloud" secret get front-door-drill-password 2>"${TMPDIR:-/tmp}/login-drill.err") || case $? in
  1) fail vault "no secret front-door-drill-password in the compartment; run bin/idp-identity-apply apply -auto-approve";;
  3) fail vault "$(head -1 "${TMPDIR:-/tmp}/login-drill.err")";;
  *) fail vault "secret-bundle for front-door-drill-password is empty or unreadable by this identity";;
esac
[ -n "$DRILL_PASSWORD" ] || fail vault "front-door-drill-password decodes to nothing"
export DRILL_PASSWORD
unset B64 SID
export DRILL_USER="${DRILL_USER:-estate-drill}" DRILL_ZONE="$ZONE" DRILL_DOMAIN="$DOMAIN"
# The founder cannot read a log. The drill photographs the page it graded so a red row comes with
# the picture of what he would have seen (LAW 28: an instrument nobody reads is not an instrument).
export DRILL_SHOT="${DRILL_SHOT:-${TMPDIR:-/tmp}/login-drill-home.png}"

# The password crosses into python as an environment variable only. It is never an argument, so
# it never appears in ps, and the driver never prints it.
"$PY" - <<'PYDRIVER'
import os, re, sys, time, hashlib
from urllib.parse import urlparse

USER = os.environ["DRILL_USER"]
PASSWORD = os.environ["DRILL_PASSWORD"]
ZONE = os.environ["DRILL_ZONE"]
DOMAIN_HOST = urlparse(os.environ["DRILL_DOMAIN"]).hostname or ""
HOME = f"https://catalogue.{ZONE}/"
TIMEOUT = float(os.environ.get("DRILL_TIMEOUT_MS", "30000"))
ENROLL = os.environ.get("DRILL_ENROLL", "0") == "1"
# Face ID ALONE (#5858): assert the door offers the passkey before it asks for the password.
PASSWORDLESS = os.environ.get("DRILL_PASSWORDLESS", "0") == "1"
# The founder signs in on a phone. A desktop-shaped context measures a surface he does not use, so
# the device is part of the instrument: DRILL_DEVICE names a Playwright device ("iPhone 15"), and
# the same drill is then taken on that phone's browser, viewport and touch behaviour included.
DEVICE = os.environ.get("DRILL_DEVICE", "")

# Redact the password in every failure detail and in every captured page body, so a red row's
# screenshot or step summary can never become a leak (LAW 46, crew#301).
REDACT = re.compile(re.escape(PASSWORD))
def safe(s):
    return REDACT.sub("<redacted>", s)[:800]

def fail(stage, detail):
    print(f"FAIL    login-drill  {stage} {safe(str(detail))}")
    sys.exit(1)

try:
    from playwright.sync_api import sync_playwright, Error as PWError
except Exception as e:
    fail("python", f"playwright import failed: {e}")

# A page the domain shows instead of the catalogue. Named so a failure says which one.
RESET_MARKERS = ("resetpwd", "changepwd", "/ui/v1/resetpassword")
RESET_TEXT = re.compile(r"(change your password|new password|password (has )?expired|reset your password)", re.I)
# What the post-password page looks like when MFA is engaging: the body shows one of these
# patterns, on whichever host the domain serves the factor screen from. Detection is by what
# the page says, never by which host it sits on -- a URL-leave test cannot tell "the factor
# screen, served from another host" from "no MFA at all". None of these patterns is a sign of
# a real Face ID offering -- this only proves the door stopped at MFA, the next assert proves
# it offered the right factor.
ENROLL_TEXT = re.compile(r"(set (up|it) (now|today)|enroll|get started|first[- ]time|add (a |an )(method|device|security|key|passkey))", re.I)
CHALLENGE_TEXT = re.compile(r"(verify (your identity|it.?s you)|two[- ]step|multi[- ]factor|enter the (code|otp)|approve the (notification|push))", re.I)
CONTINUE_TEXT = re.compile(r"(setup|set up|continue|next|get started|add |enrol|enroll|try |use )", re.I)
CONFIRM_TEXT = re.compile(r"^(done|finish|i.?m done|continue|next|close|ok|okay|proceed|got it)\b", re.I)
# The Face ID / security-key option. IDCS presents it as a button or a link in the MFA screen's
# "Other options" menu; the regex matches any of the common phrasings, case-insensitive, across
# ... and the domain's own label for the factor, which this drill learned the hard way: the front
# door offers it as the button "FIDO Authenticator", which contains none of the consumer phrasings
# above. A platform FIDO authenticator is Touch ID / Face ID; a cross-platform one is a security
# key. The vocabulary must name the factor the domain actually prints.
# the full visible text. A match is the answer to the founder's question.
FACEID_TEXT = re.compile(r"(face\s*id|touch\s*id|fingerprint|passkey|security\s*key|webauthn|fido|use (a |an )?(security|pass)?\s*key|use (your )?(face|touch)\s*id|other (sign[- ]?in )?options)", re.I)
# The interstitial this domain shows in front of its factor list: it names the two method
# families and asks for a click, and carries no factor of its own. Recognised so the drill opens
# it instead of grading it as if it were the list of factors.
SECURE_VERIFICATION_TEXT = re.compile(r"(enable secure verification|secure verification methods)", re.I)
# The disclosure that HIDES another way in. It is a menu, not a factor and not an offer: pressing
# it is a click, and the passkey is behind it. Two labels measured on this domain 2026-10-12 --
# a:"Show alternative login methods" on the sign-in screen (run 38277106763) and "Other options"
# on the factor list. One list for both steps, so neither walk can drift from the other's: a walk
# that renames the menu in only one place is how a false red is born.
DISCLOSURE_LABELS = ("Other options", "Show alternative login methods", "Other sign-in options",
                     "Alternative login methods", "More options")
DISCLOSURE_TEXT = re.compile("|".join(re.escape(l) for l in DISCLOSURE_LABELS), re.I)

# Selectors, off the live page 2026-08-26 -- the password input's id contains a pipe
# ("idcs-signin-basic-signin-form-password|input"), which no #id selector can match.
USER_SELECTORS = ["#idcs-signin-basic-signin-form-username",
                  "input[name='username']", "input[autocomplete='username']",
                  "input[placeholder*='User name' i]",
                  "input[type='email']", "input[type='text']:visible"]
PASS_SELECTORS = ["[id='idcs-signin-basic-signin-form-password|input']",
                  "input[name='password']", "input[type='password']"]
SUBMIT_SELECTORS = ["#idcs-signin-basic-signin-form-submit-button",
                    "button:has-text('Sign In')", "button:has-text('Sign in')",
                    "input[type='submit'][value*='Sign' i]"]
# A consent or notice banner the domain shows in front of the form. Dismissed, never bypassed.
BANNER_SELECTORS = ["button:has-text('Acknowledge')", "button:has-text('Accept')"]


def first(page, selectors, what):
    for s in selectors:
        loc = page.locator(s).first
        try:
            loc.wait_for(state="visible", timeout=4000)
            return loc
        except PWError:
            continue
    fail("credentials", f"no {what} field on {page.url}")


def page_text(page):
    # The domain renders its sign-in copy inside shadow roots, and inner_text() reads the light
    # DOM only: on the factor screen it returned "Cloud Infrastructure" alone from a page whose
    # own screenshot shows the whole interstitial (measured 2026-10-12 by OCR of the drill's
    # artifact). Walk the tree with the shadow roots included, and normalise whitespace, so the
    # vocabulary above reads what the founder actually sees.
    js = """() => {
      const parts = [];
      const walk = (root) => {
        for (const el of root.querySelectorAll('*')) if (el.shadowRoot) walk(el.shadowRoot);
        parts.push(root.textContent || '');
      };
      walk(document.body);
      return parts.join(' ');
    }"""
    try:
        return " ".join((page.evaluate(js) or "").split())
    except PWError:
        return ""


def controls(page):
    # What the door OFFERS is what it shows as something pressable, never what its copy says. A
    # page can name "a security key" in prose and offer no such control -- which is exactly the
    # false green this drill reported while the founder could see there was no Face ID at the
    # door. Enumerate the interactive elements across every shadow root and every frame, so
    # "offered" is answered with controls a visitor can press.
    js = """() => {
      const out = [];
      const els = [];
      const nm = (el) => (el.getAttribute('aria-label') || el.getAttribute('title') ||
        (el.innerText || el.textContent || '').trim() || el.value || el.getAttribute('alt') || '').trim();
      const card = (el) => {
        // The door offers "Mobile App" and "FIDO Authenticator" side by side, each with its own
        // Setup control, so a selector that matches only the word presses whichever comes first in
        // the DOM -- measured 2026-10-12 on the real door: button:"Setup" pressed after
        // button:"FIDO Authenticator" produced no ceremony. Report each control's own card, so the
        // press can be bound to the factor that was asked for.
        let n = el, t = '';
        for (let i = 0; i < 7 && n; i++) {
          t = (n.innerText || n.textContent || '').trim();
          if (t.length > 400) break;
          if (/fido|security key|passkey|mobile app/i.test(t)) break;
          n = n.parentElement || (n.getRootNode() && n.getRootNode().host) || null;
        }
        return (t || '').replace(/\\s+/g, ' ').slice(0, 120);
      };
      const walk = (root) => {
        for (const el of root.querySelectorAll('button,a,[role=button],[role=link],input[type=submit],input[type=button],summary')) {
          const cs = getComputedStyle(el); const r = el.getBoundingClientRect();
          if (cs.display !== 'none' && cs.visibility !== 'hidden' && r.width > 0 && r.height > 0) {
            const n = nm(el);
            if (n) {
              el.setAttribute('data-drill-idx', String(els.length));
              els.push(el);
              out.push({name: n.slice(0, 80), tag: el.tagName.toLowerCase(), idx: els.length - 1,
                off: !!(el.disabled || el.getAttribute('aria-disabled') === 'true'),
                x: Math.round(r.x + r.width / 2), y: Math.round(r.y + r.height / 2), card: card(el),
                html: (el.outerHTML || '').replace(/\\s+/g, ' ').slice(0, 300),
                parent: el.parentElement ? (el.parentElement.tagName.toLowerCase() + ' ' +
                  Array.from(el.parentElement.attributes || []).map((a) => a.name + '=' + a.value)
                    .join(' ')).slice(0, 200) : ''});
            }
          }
        }
        for (const el of root.querySelectorAll('*')) if (el.shadowRoot) walk(el.shadowRoot);
      };
      walk(document.body);
      window.__drillCtl = els;
      return out;
    }"""
    found = []
    for fr in page.frames:
        try:
            for c in fr.evaluate(js) or []:
                c["frame"] = fr.url[:80]
                found.append(c)
        except PWError:
            continue
    seen, uniq = set(), []
    for c in found:
        k = (str(c.get("name", "")).strip().lower(), c.get("tag"))
        if k not in seen:
            seen.add(k)
            uniq.append(c)
    return uniq


SCROLL_JS = """(i) => {
  // Put the control on screen and answer with where it now is. A phone viewport leaves the
  // factor card below the fold, and a box measured in another frame is not a place this page
  // can click -- both would press empty space and report the door as refusing.
  const all = [];
  const walk = (root) => {
    for (const el of root.querySelectorAll('[data-drill-idx]')) all.push(el);
    for (const el of root.querySelectorAll('*')) if (el.shadowRoot) walk(el.shadowRoot);
  };
  walk(document.body);
  const el = all.find((e) => e.getAttribute('data-drill-idx') === String(i)) ||
             (window.__drillCtl || [])[i];
  if (!el) return null;
  el.scrollIntoView({block: 'center', inline: 'center'});
  const r = el.getBoundingClientRect();
  if (!r.width || !r.height) return null;
  return {x: Math.round(r.x + r.width / 2), y: Math.round(r.y + r.height / 2)};
}"""


def webauthn_requests(page):
    # Every open page and frame of the browser, not only the one that was pressed: the ceremony may
    # open in a new window, and a page-scoped read would then answer "no request" for a door that
    # did raise one -- the same defect as reading a phrase instead of the control.
    reqs = []
    try:
        pages = list(page.context.pages)
    except PWError:
        pages = [page]
    for pg in pages:
        for fr in pg.frames:
            try:
                reqs += fr.evaluate("() => window.__drillWebauthn || []") or []
            except PWError:
                continue
    return reqs


# A passkey/security-key offer is, mechanically, a call to navigator.credentials with a publicKey.
# No amount of page copy can fake that, so the drill records every such request and can answer with
# the ceremony rather than with a phrase.
WEBAUTHN_HOOK = """(() => {
  window.__drillWebauthn = [];
  const wrap = (k) => {
    const orig = navigator.credentials && navigator.credentials[k];
    if (!orig) return;
    navigator.credentials[k] = function (opts) {
      const pk = opts && opts.publicKey;
      if (pk) {
        const sel = pk.authenticatorSelection || {};
        window.__drillWebauthn.push({call: k, rpId: (pk.rp && pk.rp.id) || null,
          attachment: sel.authenticatorAttachment || null,
          userVerification: sel.userVerification || pk.userVerification || null,  // get() carries it on publicKey, create() on authenticatorSelection
          algos: (pk.pubKeyCredParams || []).map((a) => a.alg)});
      }
      return orig.apply(this, arguments);
    };
  };
  wrap('create'); wrap('get');
})()"""


started = time.time()
mfa_kind = "none"
faceid_offered = False
with sync_playwright() as p:
    try:
        browser = p.chromium.launch(headless=True)
    except PWError as e:
        fail("browser", f"chromium will not launch: {e}")
    try:
        ctx = browser.new_context(**p.devices[DEVICE]) if DEVICE else browser.new_context(ignore_https_errors=False)
    except KeyError:
        fail("config", f"DRILL_DEVICE={DEVICE!r} is not a Playwright device name, so no phone was measured")
    ctx.set_default_timeout(TIMEOUT)
    # The hook must be INVOKED here. Added as a bare function expression it is an expression
    # statement: Playwright evaluates the init script as a script, the function is created and
    # thrown away, and window.__drillWebauthn never exists -- so every "no WebAuthn request"
    # verdict this drill has produced was about this line, not the door (measured 2026-10-12:
    # four rounds of FAIL on a door whose own payload had already created the enrolment request).
    ctx.add_init_script(script=WEBAUTHN_HOOK)
    page = ctx.new_page()
    page_errors = []
    page.on("pageerror", lambda e: page_errors.append(safe(str(e))))

    # The domain asks the BROWSER whether it has a platform authenticator when it renders the
    # factor screen, and answers that question in its own markup: with none present the FIDO enrol
    # button comes back disabled="" and every press on it does nothing. Attaching after the page
    # had rendered (2026-10-12) therefore graded this browser, not the door: the press landed, the
    # button carried oj-focus, and it was dead by the door's own attribute. Attach before the first
    # navigation, so the door's capability check sees what a person's phone would show it.
    try:
        auth = ctx.new_cdp_session(page)
        auth.send("WebAuthn.enable", {"enableUI": False})
        auth.send("WebAuthn.addVirtualAuthenticator", {"options": {
            "protocol": "ctap2", "transport": "internal", "hasResidentKey": True,
            "hasUserVerification": True, "isUserVerified": True,
            "automaticPresenceSimulation": bool(ENROLL)}})
    except PWError as e:
        fail("config", f"the drill could not attach a virtual authenticator before the door "
                       f"rendered, so its own capability check cannot pass and any refusal would "
                       f"be this browser's, not the door's: {e}")

    # The door's own data: its SPA states what it will offer in the payloads it fetches, and a
    # control the door disables is explained by that payload or not at all.
    seen = []

    def note_response(resp):
        # Read the body as it arrives. By the time the drill refuses, the enroll screen's own
        # payloads are gone from the browser and asking for them then raises (measured 2026-10-12:
        # Network.getResponseBody -- no resource with given identifier found).
        try:
            if resp.request.resource_type not in ("xhr", "fetch") or len(seen) >= 60:
                return
            if "json" not in (resp.headers or {}).get("content-type", ""):
                return
            seen.append("{} {}\n    {}".format(resp.status, resp.url, safe(resp.text())[:600]))
        except (PWError, OSError, TypeError, ValueError):
            pass

    page.on("response", note_response)

    def press(c):
        # Scroll the chosen control into view and press it at the box it then occupies, in the
        # frame it belongs to; answer where it was pressed, or None if it could not be reached.
        for fr in page.frames:
            if c.get("frame") and fr.url[:80] != c["frame"]:
                continue
            try:
                p2 = fr.evaluate(SCROLL_JS, int(c.get("idx", -1)))
            except (PWError, ValueError, TypeError):
                p2 = None
            if p2:
                page.mouse.click(int(p2["x"]), int(p2["y"]))
                return p2
        return None

    # 1. the door must hand an anonymous visitor to the identity domain, not serve the catalogue
    try:
        page.goto(HOME, wait_until="domcontentloaded")
    except PWError as e:
        fail("redirect", f"{HOME} did not load: {e}")
    host = urlparse(page.url).hostname or ""
    if host != DOMAIN_HOST:
        fail("redirect", f"{HOME} landed on {host}, expected the identity domain {DOMAIN_HOST}")
    # A gate that can fail: grade the detector before grading the door with it. The door redirects
    # and navigates, and reading the page in the middle of that raises "execution context was
    # destroyed" -- an instrument that dies on the door's own redirect grades nothing (measured
    # 2026-10-12, run 38238382947: the check itself raised and the run ended in a traceback). So
    # read it on a settled page, retry across the navigations, and still refuse if it never appears.
    hook_state, hook_deadline = None, time.time() + 30
    while time.time() < hook_deadline:
        try:
            hook_state = page.evaluate("() => typeof window.__drillWebauthn")
            if hook_state == "object":
                break
        except PWError:
            hook_state = None
        page.wait_for_timeout(500)
    if hook_state != "object":
        fail("config", "the drill's WebAuthn hook did not install (window.__drillWebauthn is "
                       f"{hook_state!r}), so any 'no WebAuthn request' from this run would be this "
                       "script's, not the door's")

    # Two ways a control is the passkey's. Its own name says so ("FIDO Authenticator"), or it
    # is the action button of a card that is headed as the FIDO factor: with a passkey enrolled
    # the door skips the factor list and shows "FIDO Authenticator Verification" with a single
    # button:"Verify" (screenshot of run 38290425763, 2026-10-12), whose name carries none of
    # the vocabulary. The card must name FIDO and must not name the Mobile App, so the Verify
    # that approves a push -- a different factor -- is still not counted. Defined here, ahead of
    # step 2, because the passwordless walk meets the same card: named by vocabulary alone it
    # skipped "Verify" and graded a door that offers Face ID as one that does not.
    def is_passkey(c):
        if FACEID_TEXT.search(str(c.get("name", ""))):
            return True
        own = str(c.get("card", ""))
        return (bool(re.match(r"^(verify|continue|next)$", str(c.get("name", "")).strip(), re.I))
                and bool(re.search(r"fido authenticator", own, re.I))
                and not re.search(r"mobile app", own, re.I))

    # 2. sign in as the drill user
    for b in BANNER_SELECTORS:
        loc = page.locator(b).first
        try:
            if loc.is_visible(timeout=2000):
                loc.click()
        except PWError:
            pass
    if PASSWORDLESS:
        # With a passwordless rule in front of this account the door is meant to offer the passkey
        # BEFORE it asks for the password. Played before the password is typed, because a password
        # typed first is the thing the founder asked to stop typing. The assertion is mechanical:
        # a passkey offer is a control, and pressing that control must drive navigator.credentials
        # -- page copy can fabricate neither.
        first(page, USER_SELECTORS, "username").fill(USER)
        try:
            page.keyboard.press("Enter")
        except PWError:
            pass
        offer, deadline, pressed = None, time.time() + 20, None
        while time.time() < deadline:
            # FACEID_TEXT matches a disclosure too ("other options"), so a disclosure is pressed and
            # then excluded from the candidates. Otherwise this walk presses a menu, no ceremony
            # follows, and it grades its own click as the door refusing to offer a passkey.
            cands = [c for c in controls(page) if is_passkey(c)]
            passkeys = [c for c in cands if not DISCLOSURE_TEXT.search(str(c.get("name", "")))]
            if passkeys:
                offer = passkeys[0]
                break
            if pressed is None:
                try:
                    page.locator(", ".join(f"button:has-text('{l}'), a:has-text('{l}')"
                                           for l in DISCLOSURE_LABELS)).first.click(timeout=3000)
                    page.wait_for_timeout(1500)
                    pressed = next((str(c.get("name")) for c in cands
                                    if DISCLOSURE_TEXT.search(str(c.get("name", "")))), "a login-methods menu")
                    continue
                except PWError:
                    pass
            page.wait_for_timeout(1000)
        if not offer:
            inv = ", ".join('{}:"{}"'.format(c.get("tag"), c.get("name")) for c in controls(page)[:8]) or "none"
            how = (f"the door's own {pressed!r} menu was opened and still no passkey control followed"
                   if pressed else "there was not even a login-methods disclosure to open")
            fail("passwordless",
                 f"the door does not offer Face ID alone to {USER}: after the username, {how} on "
                 f"{page.url.split('?')[0]}, and the password form is still the way in. This walk "
                 f"sees the door, not the policy, so it cannot say why -- whether a passwordless "
                 f"rule is wired to the front door at all is answered by `bin/idp-identity-apply "
                 f"probe` (its polrule line), never from here. Measured 2026-10-12: this line used "
                 f"to assert the carried value was 'not honoured by this domain' while the policy "
                 f"called no passwordless rule at all (run 38296585146 red, probe 38297811340 "
                 f"showing one rule called, sequence 1, the second factor), and the wrong "
                 f"diagnosis cost two hours. "
                 f"Controls the door does offer: {inv}")
        at = press(offer)
        if not at:
            fail("config", f"the drill could not reach {offer.get('name')!r} to press it, so any "
                           f"'no WebAuthn request' from here would be this script's, not the door's")
        w, wdeadline = [], time.time() + 15
        while time.time() < wdeadline:
            w = webauthn_requests(page)
            if w:
                break
            page.wait_for_timeout(1000)
        if not w:
            fail("passwordless",
                 f"the door offered {offer.get('name')!r} to {USER} but pressing it drove no WebAuthn "
                 f"request (navigator.credentials was never called), so the control is decoration and no "
                 f"Face ID can follow it")
        # Passkey alone replaces the password AND the second factor, so the biometric is the only
        # factor left. With userVerification "preferred" or "discouraged" the ceremony can finish on
        # a bare tap or a security key, and "Face ID alone" is then "any tap alone".
        uvs = {str(r.get("userVerification")) for r in w}
        if "required" not in uvs:
            fail("passwordless",
                 f"the door drove navigator.credentials for {USER} without userVerification=required "
                 f"(saw {sorted(uvs)}), so a passkey alone could be satisfied without Face ID: the "
                 f"biometric is not what stands in for the password")
        calls = ",".join(sorted({str(r.get("call")) for r in w}))
        print(f"ok      login-drill  Face ID alone is offered at the door for {USER}: pressed "
              f"{offer.get('name')!r} and the door drove navigator.credentials [{calls}] "
              f"({len(w)} request(s)) in {time.time()-started:.1f}s -- no password was typed")
        raise SystemExit(0)
    first(page, USER_SELECTORS, "username").fill(USER)
    first(page, PASS_SELECTORS, "password").fill(PASSWORD)
    try:
        first(page, SUBMIT_SELECTORS, "submit").click()
    except PWError as e:
        fail("credentials", f"sign-in button would not click: {e}")

    # 3. after the password the door either stops for a second factor or signs straight through.
    #    Detect the step by what the page SAYS (the MFA vocabulary above), on whichever host the
    #    domain serves the factor screen from; only conclude "no MFA" once the sign-in has left
    #    the identity domain without a single page showing it. A first-login password change is
    #    checked first: it is a real failure of this drill, not something to bypass -- the
    #    drill's password is Terraform's, and a domain that demands a new one has taken the
    #    account out of Terraform's hands, where no script here is allowed to put it back.
    saw_mfa = False
    text = ""
    deadline = time.time() + (TIMEOUT / 1000.0)
    while time.time() < deadline:
        body = ""
        try:
            # MFA vocabulary is only trusted on a page that is no longer the sign-in form: a
            # visible password field means the form is still up (or its DOM is stale mid-submit)
            # and its "other sign-in options" link would read as a factor screen it is not.
            if page.locator("input[type='password']:visible").count() == 0:
                body = page_text(page)
        except PWError:
            body = ""
        if body and (ENROLL_TEXT.search(body) or CHALLENGE_TEXT.search(body) or FACEID_TEXT.search(body)):
            saw_mfa = True
            text = body
            break
        if (urlparse(page.url).hostname or "") != DOMAIN_HOST:
            break   # the sign-in has left the identity domain; no page on the way said MFA
        page.wait_for_timeout(1000)

    if not saw_mfa:
        u = page.url
        text = page_text(page)
        if any(m in u.lower() for m in RESET_MARKERS) or RESET_TEXT.search(text):
            fail("password-change",
                 f"the domain is demanding a new password for {USER} at {u}; the drill will not set one -- "
                 "re-run bin/idp-identity-apply apply, or clear the must-change flag on the user")
        if (urlparse(u).hostname or "") == DOMAIN_HOST:
            fail("mfa",
                 f"the door stopped on the identity domain at {u} after the password, but the page is not "
                 f"recognised as an MFA step; body excerpt: {safe(text)[:240]}")
        # The door let the password through alone. That is the root cause of "Face ID still not
        # working": a second factor never asked for is a passkey never offered. It must fail
        # HERE, at the mfa stage -- falling through to the downstream checks lets whatever they
        # trip over first (the guest page, the catalogue) stand in as the verdict and buries the
        # founder's answer under a symptom (measured 2026-10-12 00:58Z: the drill reached the
        # identity stage and reported Backstage's guest page while mfa_kind was still "none").
        fail("mfa",
             f"after the password, the sign-in left the identity domain for {u.split('?')[0]} without "
             "ever stopping at a second factor -- no MFA step was shown, so Face ID is never offered. "
             "The domain reads back mfaEnrollmentType=Required and SsoSettings.mfaEnabledCategory=ALL, "
             "but nothing enforces them on this sign-in: the front-door app's own sign-on policy is "
             "where to look, not the domain-level settings")

    # The MFA step: classify it and assert it offers Face ID.
    if ENROLL_TEXT.search(text):
        mfa_kind = "enroll"
    elif CHALLENGE_TEXT.search(text):
        mfa_kind = "challenge"
    else:
        mfa_kind = "faceid-only"
    # Prose may classify the step; it may never claim the factor. The page's own copy names "a
    # security key" while showing no such control (measured 2026-10-12), and matching that prose
    # reported faceid=offered on runs where the founder could see no Face ID at the door.
    def offered_controls():
        return [c for c in controls(page) if is_passkey(c)]

    def inventory(cs=None):
        cs = controls(page) if cs is None else cs
        return ", ".join('{}:"{}"'.format(c.get("tag"), c.get("name")) for c in cs[:10]) or "none"

    faceid_controls = offered_controls()
    faceid_offered = bool(faceid_controls)
    # The menu is the founder's question, and until now nothing reported what it holds: the
    # photograph is taken BEFORE it is pressed, and the press was followed only by another check of
    # the Face ID vocabulary -- so a red row could say "no Face ID" about a menu nobody had looked
    # inside. Keep the page as it was, then say what the press actually changed.
    pre_disclosure_controls, pre_disclosure_url = controls(page), page.url
    disclosure_pressed = ""
    webauthn = []
    # The domain fronts the factor list with an "Enable Secure Verification" interstitial: the
    # page says the two method families exist and asks for one click before it shows them
    # (measured 2026-10-12). Clicking it is navigation, not enrolment -- the credential is made
    # only by the ceremony DRILL_ENROLL gates below. Without this step the drill grades the
    # interstitial as if it were the list of factors, and reds a door that is working.
    if not faceid_offered and SECURE_VERIFICATION_TEXT.search(text):
        try:
            page.locator("button:has-text('Enable Secure Verification'), "
                         "a:has-text('Enable Secure Verification'), "
                         "button:has-text('Continue'), a:has-text('Continue')").first.click(timeout=5000)
            page.wait_for_timeout(2500)
            revealed = page_text(page)
            if revealed and len(revealed) > len(text):
                text = revealed
                if ENROLL_TEXT.search(text):
                    mfa_kind = "enroll"
                elif CHALLENGE_TEXT.search(text):
                    mfa_kind = "challenge"
                faceid_controls = offered_controls()
                faceid_offered = bool(faceid_controls)
        except PWError:
            pass
    # Always photograph the MFA page so a red row carries the picture of what the founder saw.
    try:
        page.screenshot(path=os.environ.get("DRILL_SHOT", "/tmp/login-drill-home.png"), full_page=True)
    except PWError:
        pass
    if not faceid_offered:
        # Expand the disclosure before declaring defeat -- IDCS nests Face ID under a menu on some
        # skins, and the founder only sees it after a click. The label depends on the skin and the
        # step: this domain's sign-in screen renders the way in as a:"Show alternative login
        # methods" (measured 2026-10-12 16:26Z, run 38277106763) while the factor list uses "Other
        # options". Press ONLY a disclosure. The sibling control on that screen is button:"Verify",
        # which approves a push to the Oracle Mobile Authenticator -- a different factor, and
        # pressing it would grade a door that never offered the passkey as if it had.
        for label in DISCLOSURE_LABELS:
            if faceid_offered:
                break
            try:
                page.locator(f"button:has-text('{label}'), a:has-text('{label}')").first.click(timeout=3000)
                page.wait_for_timeout(1500)
                disclosure_pressed = label
                faceid_controls = offered_controls()
                if faceid_controls:
                    faceid_offered = True
            except PWError:
                continue
    # What the menu holds, named whether or not it holds a passkey. The founder can see this control
    # and cannot see behind it, so a grade that stops at "the door offers a:'Show alternative login
    # methods'" answers a different question than his: every control the press added, and the text it
    # added, so the next row carries the menu's own contents instead of a vocabulary miss.
    if disclosure_pressed and not faceid_offered:
        before_names = {str(c.get("name", "")) for c in pre_disclosure_controls}
        gained = [c for c in controls(page) if str(c.get("name", "")) not in before_names]
        after_text = page_text(page)
        gained_text = (after_text[len(text):] if after_text.startswith(text) else after_text)[:400]
        print('DISCLOSURE: pressed "{}" at the {} step; url {} -> {}; the menu holds {} control(s) '
              'the page did not have before: {} | text it added: {!r}'.format(
                  disclosure_pressed, mfa_kind, pre_disclosure_url.split("?")[0],
                  page.url.split("?")[0], len(gained),
                  ", ".join('{}:"{}"'.format(c.get("tag"), c.get("name")) for c in gained[:12]) or "none",
                  gained_text))
    if not faceid_offered:
        fail("mfa",
             f"the door engages MFA (kind={mfa_kind}) but offers no control for Face ID or a security "
             f"key on the {page.url.split('?')[0]} screen; the founder cannot use the passkey that is "
             f"enabled in the domain. Controls the door offers with the menu closed: "
             f"{inventory(pre_disclosure_controls)}; with it open: {inventory(controls(page))}")
    # What the control actually does: a real passkey/security-key offer drives a WebAuthn call.
    # With the UI suppressed and no virtual authenticator attached, a request can be recorded but
    # no credential can be created, so an observe-only run never burns an enrolment slot. Skipped
    # under DRILL_ENROLL=1, where the ceremony below is the proof and must not be disturbed.
    presses, uvpa, trace, walk_error = [], None, [], None
    if not ENROLL:
        try:
            # The authenticator has been attached since before the door rendered (the block above);
            # there is nothing to add here, only the requests to read back.
            # The factor's own control and the control that raises the ceremony are two different
            # presses on this domain (measured: button:"FIDO Authenticator", then button:"Setup"),
            # and the first press does not change the URL -- so a probe that stopped after one press
            # called a working door "decoration". Follow the screen forward the way a person does,
            # pressing the control that belongs to the FIDO card, until a request appears.
            uvpa = None
            try:
                uvpa = page.evaluate(
                    "() => (window.PublicKeyCredential && PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable)"
                    " ? PublicKeyCredential.isUserVerifyingPlatformAuthenticatorAvailable() : null")
            except PWError:
                # A capability read that fails must not become "the door refused": it stays measured
                # as unknown and the verdict below reports it as unknown.
                uvpa = None
            presses, clicked, stale = [], set(), set()
            try:
                shot0 = prev_shot = hashlib.sha256(page.screenshot()).hexdigest()[:8]
            except PWError:
                shot0 = prev_shot = "?"
            trace.append(f"before any press: shot={shot0} url={page.url.split('?')[0]}")

            def rank(c):
                name, own = str(c.get("name", "")), str(c.get("card", ""))
                factor_card = 0 if re.search(r"fido|security key|passkey", own, re.I) else (
                    1 if not re.search(r"mobile app", own, re.I) else 2)
                if is_passkey(c):
                    return (0, factor_card)
                if CONTINUE_TEXT.search(name):
                    return (1, factor_card)
                return (9, 9)

            for _ in range(8):
                here = [c for c in controls(page) if (str(c.get("name")), c.get("x"), c.get("y")) not in clicked]
                here = [c for c in here if rank(c)[0] < 9]
                # A control the door renders disabled cannot act, so pressing it tests nothing; and
                # a control that changed nothing when pressed is not the way forward either. Both
                # are recorded rather than counted as the door refusing.
                fresh = [c for c in here if str(c.get("name")) not in stale]
                if fresh:
                    here = fresh
                live = [c for c in here if not c.get("off")]
                if not live:
                    trace.append(f"{len(presses) + 1}. the only control left for this factor is one "
                                 f"the door renders disabled: " + "; ".join(
                                     f"{c.get('tag')}:{str(c.get('name'))[:40]}" for c in here))
                    break
                pick = sorted(live, key=rank)[0]
                clicked.add((str(pick.get("name")), pick.get("x"), pick.get("y")))
                # Press it where it is, with a real mouse: a trusted input at the control's own box,
                # scrolled into view first, so it lands on the control that was chosen.
                pt = press(pick)
                if not pt:
                    trace.append(f"{len(presses) + 1}. could not reach {str(pick.get('name'))[:40]!r} "
                                 f"to press it (idx={pick.get('idx')}, frame={pick.get('frame')})")
                    break
                presses.append(str(pick.get("name"))[:40])
                page.wait_for_timeout(2000 if len(presses) > 1 else 1500)
                # Prove the press LANDED, never assume it: a page that does not change after a
                # press means the input missed its target, and a verdict read from there would be
                # about the instrument, not the door (2026-10-12: two presses, byte-identical
                # screen, and no way to tell which of the two had happened).
                try:
                    active = page.evaluate("() => { const a = document.activeElement; return a ? a.tagName"
                                           " + ':' + (a.innerText || a.value || '').slice(0, 30) : 'none'; }")
                except PWError:
                    active = "?"
                try:
                    shot = hashlib.sha256(page.screenshot()).hexdigest()[:8]
                except PWError:
                    shot = "?"
                trace.append(f"{len(presses)}. pressed {str(pick.get('name'))[:40]!r} at "
                             f"{pt['x']},{pt['y']} -> active={active} shot={shot} "
                             f"webauthn={len(webauthn_requests(page))}")
                if webauthn_requests(page):
                    break
                if shot != "?" and shot == prev_shot:
                    stale.add(str(pick.get("name")))
                prev_shot = shot
            # Which factors the door itself will start. A control that is live for the Mobile App
            # card and dead for the FIDO card is the door's own decision about this factor, and a
            # control dead for both is not about WebAuthn at all -- so measure both, and never press
            # a control the door has disabled.
            for card_name in ("Mobile App", "FIDO Authenticator"):
                card = [c for c in controls(page) if str(c.get("name")) == card_name and not c.get("off")]
                if not card:
                    continue
                if press(card[0]):
                    page.wait_for_timeout(1500)
                    setup = [c for c in controls(page) if str(c.get("name")) == "Setup"]
                    trace.append("panel after selecting {!r}: {}".format(card_name, "; ".join(
                        "Setup disabled={}".format(bool(c.get("off"))) for c in setup) or "no Setup control"))
        except PWError as e:
            walk_error = e
        webauthn = webauthn_requests(page)
        pressed = " -> ".join(presses)
        if walk_error is not None and not webauthn:
            # The walk died before it could measure the screen. An empty record here is the
            # instrument's, not the door's -- reporting "the door produced no WebAuthn request" from
            # a walk that never completed is the exact defect this drill has now produced four
            # times (2026-10-12), so it is refused as a config failure instead.
            fail("config", f"the drill could not walk the factor screen to the ceremony, so it never "
                           f"measured the door: {type(walk_error).__name__}: {walk_error}")
        offer = '{}:"{}"'.format(faceid_controls[0].get("tag"), faceid_controls[0].get("name"))
        if not webauthn:
            now = controls(page)
            # The door's own markup, its own copy and the record of every press, written next to
            # the screenshot and uploaded with it: the next reader measures the door, not a story
            # about it, and needs no second run to see what the page was made of.
            try:
                with open(os.environ.get("DRILL_SHOT", "/tmp/login-drill-home.png").replace(".png", ".dom.txt"), "w") as fh:
                    fh.write("url: " + page.url + "\n\npresses:\n" + "\n".join(trace)
                             + "\n\ncopy:\n" + safe(page_text(page)) + "\n\ncontrols:\n"
                             + "\n".join('{}:"{}" at {},{} disabled={} card="{}"\n    html={}\n    parent={}'.format(
                                 c.get("tag"), c.get("name"), c.get("x"), c.get("y"), bool(c.get("off")),
                                 c.get("card"), c.get("html"), c.get("parent")) for c in now)
                             + "\n\napi:\n" + "\n".join(seen) + "\n")
            except (OSError, TypeError, PWError):
                pass
            shut = [c for c in now if c.get("off") and rank(c)[0] < 9]
            fail("mfa",
                 f"the door shows the control {offer} for Face ID, but it is unusable: pressing "
                 f"{pressed or 'it'} produced no WebAuthn request on the "
                 f"{page.url.split('?')[0]} screen (the browser reports a platform authenticator:"
                 f" {uvpa}), so the founder cannot use the passkey enabled in "
                 f"the domain. Controls the door does offer: {inventory()}."
                 + ("; the door renders its own factor control disabled: "
                    + ", ".join('{}:"{}"'.format(c.get("tag"), str(c.get("name"))[:40]) for c in shut)
                    if shut else "")
                 + f" The door's own copy: {safe(page_text(page))[:300]}")
        # A platform authenticator is Touch ID / Face ID; cross-platform is an external security
        # key. If the door only ever asks for a cross-platform one, this machine's biometrics are
        # never offered and saying "faceid=offered" would be the same false green as before.
        att = {w.get("attachment") for w in webauthn}
        if att == {"cross-platform"}:
            fail("mfa",
                 f"the door offers {offer} but requests only a cross-platform authenticator "
                 f"(an external security key); Face ID needs a platform authenticator, so the "
                 f"founder is still not offered the biometric on this machine")
    else:
        offer = '{}:"{}"'.format(faceid_controls[0].get("tag"), faceid_controls[0].get("name"))

    # detail, so a green row proves the mechanism and not the label
    det = "none"
    if webauthn:
        w = webauthn[0]
        det = f"{w.get('call')},attachment={w.get('attachment')},uv={w.get('userVerification')}"

    # Face ID (or a security key) is offered. With DRILL_ENROLL=1, complete the ceremony with
    # a virtual authenticator so the hourly run leaves the door behind a real WebAuthn step;
    # without it, observe only -- enrolling creates a FIDO2 credential and a real one per
    # hour would hit the domain's maxEnrolledDevices cap.
    if ENROLL:
        # The authenticator was attached before the first navigation with presence simulation on,
        # the way a person's Touch ID answers, so the ceremony below completes for real.
        #
        # One press is not the ceremony on this domain: the factor's own control selects the FIDO
        # card and a control INSIDE that card is what calls navigator.credentials.create() --
        # measured by this drill's own observation path (button:'FIDO Authenticator', then
        # button:'Setup', and the first press does not change the URL). Until 2026-10-12 this
        # branch pressed once, then waited for a ceremony it had never asked for, and reported
        # "the Face ID ceremony was offered but never completed" over a door that had offered it:
        # the red was this branch's missing press, read as the door's. So press, read the WebAuthn
        # record, press again -- the way the observation path above walks the same screen.
        presses, tried = [], set()
        for _ in range(6):
            if webauthn_requests(page):
                break
            live = [c for c in controls(page) if not c.get("off") and str(c.get("name")) not in tried
                    and (FACEID_TEXT.search(str(c.get("name", "")))
                         or CONTINUE_TEXT.search(str(c.get("name", ""))))]
            live.sort(key=lambda c: (0 if FACEID_TEXT.search(str(c.get("name", ""))) else 1))
            if not live or not press(live[0]):
                break
            tried.add(str(live[0].get("name")))
            presses.append(str(live[0].get("name"))[:40])
            page.wait_for_timeout(2000)
        def dump(note):
            # Every press, the WebAuthn record and the page's own markup, written next to the
            # picture the workflow already uploads. This branch failed without one, so each reader
            # of its red had to reproduce the whole run to see the screen (2026-10-12).
            try:
                with open(os.environ.get("DRILL_SHOT", "/tmp/login-drill-home.png").replace(".png", ".dom.txt"), "w") as fh:
                    fh.write("url: " + page.url + "\nenroll=1 presses: " + " -> ".join(presses) + note
                             + "\nwebauthn: " + str(webauthn_requests(page))[:500]
                             + "\n\ncopy:\n" + safe(page_text(page)) + "\n\ncontrols:\n"
                             + "\n".join('{}:"{} at {},{} disabled={} card="{}"\n    html={}\n    parent={}'.format(
                                 c.get("tag"), c.get("name"), c.get("x"), c.get("y"), bool(c.get("off")),
                                 c.get("card"), c.get("html"), c.get("parent")) for c in controls(page))
                             + "\n\napi:\n" + "\n".join(seen) + "\n")
            except (OSError, TypeError, PWError):
                pass

        if not webauthn_requests(page):
            dump("")
            fail("mfa",
                 f"the door shows the enrolment screen at {page.url.split('?')[0]} but pressing "
                 f"{' -> '.join(presses) or 'nothing'} raised no WebAuthn request, so no passkey can "
                 f"be created for {USER}. Controls the door does offer: {inventory()}")
        # The ceremony's own screen does not leave the domain on its own. 2026-10-12: the run that
        # first completed a ceremony (the record above) sat on "...enrollment-router=success-enroll"
        # with "Successfully Enrolled FIDO Authenticator is now set up. Done" on screen, waited
        # there, and reported the ceremony as never completed -- over an enrolment that had just
        # happened. So walk the confirmation forward the same way, then wait for the door.
        confirmed = []
        for _ in range(4):
            if urlparse(page.url).hostname != DOMAIN_HOST:
                break
            done = [c for c in controls(page) if not c.get("off")
                    and CONFIRM_TEXT.search(str(c.get("name", "")).strip())]
            if not done or not press(done[0]):
                break
            confirmed.append(str(done[0].get("name"))[:40])
            page.wait_for_timeout(2000)
        if confirmed:
            dump("  |  confirm: " + " -> ".join(confirmed))
        # Let the WebAuthn ceremony resolve, then continue to the session stage.
        try:
            page.wait_for_url(lambda u: urlparse(u).hostname != DOMAIN_HOST, timeout=TIMEOUT)
        except PWError:
            u2 = page.url
            w = webauthn_requests(page)
            fail("mfa", (f"the passkey ceremony raised {w[0].get('call')} and the door stayed at "
                         f"{u2.split('?')[0]} after pressing "
                         f"{' -> '.join(presses + confirmed) or 'nothing'}") if w else
                 f"the Face ID ceremony was offered but never completed; still at {u2}")
    else:
        # Observation-only run: do not complete the ceremony. The verdict is "Face ID is offered",
        # which is the answer the founder needs, and no credential is created.
        print(f"ok      login-drill  observed mfa={mfa_kind}, faceid=offered({offer}, webauthn={det}) "
              f"at {urlparse(page.url).hostname} in {time.time()-started:.1f}s")
        sys.exit(0)

    # 4. the session must actually serve the catalogue: 200 and the Backstage shell
    landed = urlparse(page.url).hostname or ""
    if landed != f"catalogue.{ZONE}":
        page.wait_for_timeout(5000)
        landed = urlparse(page.url).hostname or ""
    if landed != f"catalogue.{ZONE}":
        body = ""
        try:
            body = " ".join(page.locator("body").inner_text(timeout=3000).split())[:240]
        except PWError:
            pass
        fail("session", f"signed in but landed on {page.url.split('?')[0]}, expected catalogue.{ZONE}; page says: {safe(body)}")
    try:
        resp = page.goto(HOME, wait_until="domcontentloaded")
    except PWError as e:
        fail("catalogue", f"{HOME} did not reload with the session cookie: {e}")
    if resp is None or resp.status != 200:
        fail("catalogue", f"{HOME} answered {getattr(resp, 'status', 'no response')} to the signed-in session")
    words = ""
    for _ in range(int(TIMEOUT / 1000)):
        try:
            words = " ".join(page.locator("body").inner_text(timeout=1000).split())
        except PWError:
            words = ""
        if len(words) > 40:
            break
        time.sleep(1)
    if len(words) <= 40:
        try:
            page.screenshot(path=os.environ.get("DRILL_SHOT", "/tmp/login-drill-home.png"), full_page=True)
        except PWError:
            pass
        errs = " | ".join(e.splitlines()[0][:300] for e in page_errors) or "no uncaught page error"
        fail("catalogue", f"{HOME} answered 200 but drew nothing; page errors: {errs}; page says: {safe(words) or '(empty body)'}")

    # 5. the whole path, not just the door: the door's headers must reach Backstage's own
    # auth provider and come back as a signed-in identity.
    if page.locator("button:has-text('Enter')").count() > 0 or "Enter as a Guest" in (page.inner_text("body") or ""):
        fail("identity", f"{HOME} rendered Backstage's guest sign-in page; the door's identity never reached the auth provider")
    try:
        who = page.request.post(f"{HOME}api/auth/oauth2Proxy/refresh", headers={"x-requested-with": "XMLHttpRequest"})
    except PWError as e:
        fail("identity", f"auth provider oauth2Proxy did not answer: {e}")
    if who.status != 200:
        fail("identity", f"auth provider oauth2Proxy answered {who.status} to the door's session: {safe(who.text())[:240]}")

    print(f"ok      login-drill  signed in as {USER}, mfa={mfa_kind}, faceid=offered({offer}, webauthn=ceremony) in {time.time()-started:.1f}s")
PYDRIVER
