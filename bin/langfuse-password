#!/usr/bin/env bash
# Put the Langfuse UI password on the clipboard without displaying it.
#
# LAW 21: a secret never appears anywhere it can be read again -- not a
# terminal, not a log, not a screenshot. So this pipes straight to pbcopy and
# prints only the email address.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT

ENVF="$(cd "$(dirname "$0")/.." && pwd)/observability/.env"
[ -f "$ENVF" ] || {
	echo "no $ENVF -- run bin/langfuse-up"
	exit 2
}

grep -m1 '^LANGFUSE_INIT_USER_PASSWORD=' "$ENVF" | cut -d= -f2- | tr -d '\n' | pbcopy
email=$(grep -m1 '^LANGFUSE_INIT_USER_EMAIL=' "$ENVF" | cut -d= -f2-)

echo "password copied to clipboard (not shown)"
echo "sign in at http://127.0.0.1:3200/  as  $email"
