#!/usr/bin/env python3
"""Dark matter: the capability this estate built and is not running.

The problem this exists for, measured 2026-09-12:

    1,523 branches are unmerged. 178 worktrees are on disk. Of a 300-branch sample,
    722 files exist on a branch and on no commit of main. Three agents are deployed
    and dead (`research` 0/1, `hindsight` 0/1, `otto-gateway` 2/13).

None of that is in `docs/inventory` or in the Backstage catalogue, because both are
generated from DECLARED state -- the manifests in `clusters/` and `platform/`. Work
that exists on a branch is not declared, so it does not exist as far as the estate can
tell. An agent asked "do we already have this?" answers no, and rebuilds it.

    The catalogue was never wrong about what is declared. It was silent about what
    is built. Silence reads as absence, and absence is what makes an estate rebuild
    its own work.

So this counts the missing half into `backstage/platform/dark-matter.json`, and stops
there. `bin/estate-twin-runtime --once --code` reads that file instead of re-scanning
git, so the twin and this sweep report one number by construction.

It used to also emit 3,539 lines of Backstage Components into
`backstage/platform/dark-matter.yaml`. Deleted 2026-09-22: no catalog location in
`backstage/app-config.yaml` ever pointed at it, so Backstage never ingested it, and the
only thing in the repository that read it back was the `--check` in this file comparing
it to a fresh render of itself. It had reached the point of listing itself as a file
that exists on no commit of main.

The counts remain because something reads them. The point was never the report; it is
that 932 of 954 remote branches are older than a day (measured 2026-09-22). DORA puts
the line at 24 hours and Google, Meta and Netflix branch from HEAD, so the standard
answer to a branch that has been alive for a week is not a nicer inventory of it.

Usage:
    bin/catalog-dark-matter            sweep and write the counts
    bin/catalog-dark-matter --check    exit 1 if the counts and the twin disagree

Exit codes: 0 ok, 1 the two surfaces disagree (--check), 2 the sweep could not run.

Design rules this obeys, each for a reason:

* It writes one small machine-readable file, read by one consumer. Nothing renders a
  document that no reader opens.
* A branch with no new files is an edit in flight, not a stranded capability, and is
  not counted. This keeps the number to work that is genuinely absent from main.
"""

from __future__ import annotations

import json
import os
import sqlite3
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
COUNTS = os.path.join(ROOT, "backstage", "platform", "dark-matter.json")


def sh(args: list[str], cwd: str = ROOT) -> str:
    try:
        p = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=180)
    except Exception:
        return ""
    return p.stdout if p.returncode == 0 else ""


def base_ref() -> str:
    """The trunk. origin/main if it exists, else main, else HEAD."""
    for ref in ("origin/main", "main", "HEAD"):
        if sh(["git", "rev-parse", "--verify", "--quiet", ref]).strip():
            return ref
    return "HEAD"


def stranded_branches(base: str, cap: int | None = None) -> list[dict]:
    """Unmerged branches carrying files that exist on no commit of the trunk.

    `git diff --diff-filter=A base..branch` is the set of files the branch first added.
    A branch whose only change is to existing files is work in flight, not a stranded
    capability, so it is excluded -- see the design rules in the module docstring.
    """
    names = [
        b
        for b in sh(
            [
                "git",
                "for-each-ref",
                "--sort=-committerdate",
                "--format=%(refname:short)",
                "refs/heads/",
            ]
        ).splitlines()
        if b.strip() and b.strip() != base.replace("origin/", "")
    ]
    out: list[dict] = []
    for b in names:
        added = [
            f
            for f in sh(
                ["git", "diff", "--name-only", "--diff-filter=A", f"{base}..{b}"]
            ).splitlines()
            if f.strip()
        ]
        if not added:
            continue
        date = sh(["git", "log", "-1", "--format=%cs", b]).strip()
        out.append({"branch": b, "files": added, "count": len(added), "date": date})
        if cap is not None and len(out) >= cap:
            break
    return out


def dead_deployments() -> list[dict]:
    """Deployments scaled to zero, i.e. deployed and switched off.

    kubectl may be absent or the cluster unreachable; that is not a failure of the
    sweep, it means this half is empty, and the header says so.
    """
    raw = sh(["kubectl", "get", "deploy", "-A", "-o", "json"])
    if not raw.strip():
        return []
    try:
        doc = json.loads(raw)
    except Exception:
        return []
    out: list[dict] = []
    for d in doc.get("items", []):
        spec = d.get("spec") or {}
        meta = d.get("metadata") or {}
        if (spec.get("replicas") or 0) == 0:
            out.append(
                {"namespace": meta.get("namespace", "?"), "name": meta.get("name", "?")}
            )
    return out


def main(argv: list[str]) -> int:
    # A linked worktree has .git as a FILE pointing at the real gitdir, not a directory,
    # so test for either and let git decide.
    if not os.path.exists(os.path.join(ROOT, ".git")):
        print("dark-matter: not a git checkout; cannot sweep", file=sys.stderr)
        return 2

    # --check reads the CACHED counts, never a fresh scan. The scan is what
    # `bin/catalog-dark-matter` with no flag does, and six minutes over 954 branches is a
    # gate nobody runs. What it checks is the one thing two surfaces can disagree about:
    # the number the twin holds and the number this sweep last wrote.
    if "--check" in argv:
        if not os.path.exists(COUNTS):
            print(
                "FAIL    catalog-dark-matter  no counts file; run bin/catalog-dark-matter"
            )
            return 1
        counts = json.loads(open(COUNTS).read())
        db = os.path.join(ROOT, "catalog", "estate.db")
        if os.path.exists(db):
            try:
                con = sqlite3.connect(db)
                row = con.execute(
                    "select metadata from nodes where id = 'git:summary:stranded'"
                ).fetchone()
                con.close()
                if row:
                    twin = json.loads(row[0]).get("stranded_branches")
                    if twin != counts["stranded_branches"]:
                        print(
                            f"FAIL    catalog-dark-matter  the graph says {twin} stranded branches and the counts file says {counts['stranded_branches']}; run bin/estate-twin-runtime --once --code"
                        )
                        return 1
            except Exception:
                pass
        print(
            f"ok      catalog-dark-matter  {counts['stranded_branches']} stranded branch(es), {counts['dead_deployments']} dead deployment(s) current"
        )
        return 0

    base = base_ref()
    all_stranded = stranded_branches(base)
    branches_total = len(all_stranded)  # what is true, and what the twin must match
    # DISTINCT files, not a sum of per-branch counts. Adding up `count` over every stranded
    # branch counts a file once per branch that adds it, so one shared file on 400 branches
    # read as 400 files and the estate reported 94,093 files absent from main when the
    # distinct number is 9,594 (measured 2026-09-13, 648 branches). The two numbers mean
    # different things and both are kept, under names that say which is which.
    distinct = {f for b in all_stranded for f in b["files"]}
    files_total = len(distinct)
    files_added_across_branches = sum(b["count"] for b in all_stranded)

    dead = dead_deployments()

    date = sh(["git", "log", "-1", "--format=%cs", base]).strip() or "unknown"

    # The counts, in a small machine-readable file. `bin/estate-twin-runtime --code` reads
    # THIS instead of re-scanning git, so the portal and the graph report one number by
    # construction rather than by two implementations agreeing by luck.
    os.makedirs(os.path.dirname(COUNTS), exist_ok=True)
    counts = {
        "at": date,
        "base": base,
        "stranded_branches": branches_total,
        "files_absent_from_base": files_total,
        "files_added_across_branches": files_added_across_branches,
        "dead_deployments": len(dead),
        "dead_names": [f"{d['namespace']}/{d['name']}" for d in dead],
    }
    open(COUNTS, "w").write(json.dumps(counts, indent=2, sort_keys=True) + "\n")
    print(
        f"ok      catalog-dark-matter  wrote {os.path.relpath(COUNTS, ROOT)}: "
        f"{branches_total} stranded branch(es) carrying {files_total} file(s) absent "
        f"from {base}, {len(dead)} dead deployment(s)"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
