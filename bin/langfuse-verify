#!/usr/bin/env bash
# Is the observability actually observing? This is the definition of done for
# Langfuse, written as a command.
#
# Reachable is not the same as working. A Langfuse whose worker cannot write to
# ClickHouse answers 200 on /api/public/health, renders a perfectly good empty
# dashboard, and silently drops everything sent to it. So this does not probe a
# port. It sends a real span through the real OTLP endpoint and then reads it
# back out of the API, which is the only evidence that ingestion works end to
# end.
#
# It does the same for the fallback, because a fallback nobody has ever sent a
# span to is a hope, not a fallback (LAW 19).
#
#   langfuse-verify          check both
#   langfuse-verify --primary-only
#
# Exit 0 only when a span sent in comes back out.
set -uo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
ENVF="$IDP/observability/.env"
JQ=/usr/local/bin/jq
PRIMARY=http://127.0.0.1:3200
FALLBACK=http://127.0.0.1:4318

fail=0
say() { printf '%s\n' "$*"; }

[ -f "$ENVF" ] || { say "FAIL  no $ENVF -- run bin/langfuse-up"; exit 1; }
pk=$(grep -m1 '^LANGFUSE_INIT_PROJECT_PUBLIC_KEY=' "$ENVF" | cut -d= -f2-)
sk=$(grep -m1 '^LANGFUSE_INIT_PROJECT_SECRET_KEY=' "$ENVF" | cut -d= -f2-)

# A fresh trace id each run, so a pass can never be last run's data.
trace_id=$(openssl rand -hex 16)
span_id=$(openssl rand -hex 8)
now_ns=$(( $(date +%s) * 1000000000 ))
end_ns=$(( now_ns + 1000000 ))

payload=$(cat <<JSON
{"resourceSpans":[{
  "resource":{"attributes":[
    {"key":"service.name","value":{"stringValue":"langfuse-verify"}}]},
  "scopeSpans":[{
    "scope":{"name":"idp.langfuse-verify"},
    "spans":[{
      "traceId":"$trace_id",
      "spanId":"$span_id",
      "name":"verify-probe",
      "kind":1,
      "startTimeUnixNano":"$now_ns",
      "endTimeUnixNano":"$end_ns",
      "attributes":[
        {"key":"langfuse.observation.type","value":{"stringValue":"span"}},
        {"key":"probe","value":{"stringValue":"idp-langfuse-verify"}}]
    }]}]}]}
JSON
)

# --- primary: send a span, then read it back ---------------------------------
say "trace     $trace_id"
code=$(curl -sS -o /tmp/lf-verify-post.$$ -w '%{http_code}' --max-time 15 \
  -X POST "$PRIMARY/api/public/otel/v1/traces" \
  -u "$pk:$sk" -H 'Content-Type: application/json' \
  -d "$payload" 2>/dev/null)
# curl writes 000 via -w AND exits non-zero when it cannot connect, so a
# `|| echo 000` here appended a second 000 and the script reported "HTTP 000000".
code=${code:-000}

if [ "$code" != "200" ] && [ "$code" != "202" ] && [ "$code" != "204" ]; then
  say "FAIL      primary rejected the span: HTTP $code"
  sed 's/^/            /' /tmp/lf-verify-post.$$ 2>/dev/null | head -5
  fail=1
else
  say "primary   span accepted (HTTP $code) -- waiting for the worker to flush"
  found=""
  for i in $(seq 1 24); do
    sleep 5
    got=$(curl -sS --max-time 10 -u "$pk:$sk" \
      "$PRIMARY/api/public/traces/$trace_id" 2>/dev/null \
      | $JQ -r '.id // empty' 2>/dev/null)
    if [ -n "$got" ]; then found="$got"; break; fi
    [ $(( i % 4 )) -eq 0 ] && say "          still flushing ($(( i * 5 ))s)"
  done
  if [ -n "$found" ]; then
    say "primary   PASS -- the span came back out of the API after $(( i * 5 ))s"
  else
    say "FAIL      primary accepted the span but it never appeared in the API."
    say "          That is the silent-drop case. Check the worker:"
    say "            docker logs --tail 40 langfuse-worker"
    fail=1
  fi
fi
rm -f /tmp/lf-verify-post.$$

[ "${1:-}" = "--primary-only" ] && { say; [ "$fail" -eq 0 ] && say "PASS" || say "FAIL"; exit "$fail"; }

# --- fallback: same span, different receiver ---------------------------------
#
# Read the trace file with `docker cp`, not `docker exec sh`. The collector
# image is distroless: there is no shell in it, so `docker exec ... sh -c` fails
# and prints its error onto stdout. That error string then landed in a numeric
# test as `[ "OCIruntimeexec..." -ge 1 ]`, which is a syntax error, and the
# script fell through to a definite FAIL about evidence it had never read.
# Found 2026-08-24, and it is the same defect as the rego one: a guard that
# loses its evidence must say so, not return a verdict.
read_traces() {
  docker cp langfuse-otel-fallback:/data/traces.jsonl - 2>/dev/null | tar -xO 2>/dev/null
}

before=$(read_traces | wc -l | tr -d ' \r')
code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 \
  -X POST "$FALLBACK/v1/traces" \
  -H 'Content-Type: application/json' -d "$payload" 2>/dev/null)
code=${code:-000}

if [ "$code" != "200" ]; then
  say "FAIL      fallback rejected the span: HTTP $code"
  fail=1
else
  # The batch processor holds spans for up to 5s before writing.
  sleep 8
  dump=$(read_traces)
  if [ -z "$dump" ]; then
    # No file, or the container would not give it up. That is not a pass and it
    # is not a proven failure -- it is a blind spot, and it is reported as one.
    say "BLIND     fallback took the span (HTTP 200) but /data/traces.jsonl"
    say "          could not be read back, so nothing here is proven either way"
    fail=1
  else
    after=$(printf '%s\n' "$dump" | wc -l | tr -d ' \r')
    if printf '%s\n' "$dump" | grep -q "$trace_id"; then
      say "fallback  PASS -- the same trace id is on disk (${before:-0} -> ${after:-0} lines)"
    else
      say "FAIL      fallback accepted the span but the trace id is not in"
      say "          /data/traces.jsonl (read back ${after:-0} lines)"
      fail=1
    fi
  fi
fi

say
if [ "$fail" -eq 0 ]; then
  say "PASS      both receivers took a span and gave it back. Switching between"
  say "          them is one environment variable, and both are already running."
else
  say "FAIL      observability is not proven working"
fi
exit "$fail"
