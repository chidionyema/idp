#!/usr/bin/env python3
"""Load a Dagster code location the way workspace.yaml loads it: by file path, never as a package.

On 2026-08-25 definitions.py imported a sibling with `from .describe import`, passed every offline
check, and put the live code location in PythonError the moment it reloaded. So the check has to
load it the way it runs. Lifted out of bin/idp-ci on 2026-09-07 (rules.yaml: defs-load-by-path).

  idp-defs-validate PATH/definitions.py
"""
from __future__ import annotations

import os
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))


def _can_import_dagster(python: str) -> bool:
    """True when `python` can import dagster.

    An existing .venv is not proof of a usable one: on 2026-09-13 this checkout held a hollow
    .venv (Python 3.14.7, no dagster) while the system interpreter carried dagster 1.13.22. The
    old code preferred .venv merely because the directory existed, so the validator ran under an
    interpreter that could not import dagster and returned rc=1 -- which the doc-render gate read
    as a defect in the page rather than a defect in this script.
    """
    try:
        proc = subprocess.run([python, "-c", "import dagster"],
                              capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError):
        return False
    return proc.returncode == 0


def _interpreter_with_dagster() -> str:
    """The interpreter to run `dagster definitions validate` under.

    Preference order: the running interpreter, then the checkout's .venv -- each accepted only
    after proving it can import dagster. When neither can, the running interpreter is returned so
    the failure is reported by dagster's own missing-module error rather than by a silent choice.
    """
    candidates = [sys.executable, os.path.join(ROOT, ".venv", "bin", "python")]
    seen = set()
    for python in candidates:
        if python in seen or not os.path.exists(python):
            continue
        seen.add(python)
        if _can_import_dagster(python):
            return python
    return sys.executable


def main() -> int:
    if len(sys.argv) != 2:
        print(__doc__)
        return 2
    target = sys.argv[1]
    if not os.path.isabs(target):
        target = os.path.join(ROOT, target)
    python = _interpreter_with_dagster()
    env = dict(os.environ, DAGSTER_HOME=tempfile.mkdtemp())
    proc = subprocess.run([python, "-m", "dagster", "definitions", "validate",
                           "-f", os.path.basename(target)],
                          cwd=os.path.dirname(target), env=env, capture_output=True, text=True)
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    return proc.returncode


if __name__ == "__main__":
    sys.exit(main())
