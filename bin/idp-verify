#!/usr/bin/env bash
# Does what is published actually match the inventory? This is the definition of
# done for the portal, written as a command.
#
# It exists because of a real failure on 2026-08-24: catalog-gen emitted
# annotation values as YAML numbers, Backstage rejected 141 of 194 entities as
# "Malformed envelope ... must be string", and the portal rendered perfectly
# with three quarters of the estate missing. Nothing went red. A catalogue that
# is quietly incomplete is worse than one that is down, because a buyer reads
# what is there and believes it is everything.
#
#   idp-verify          check once
#   idp-verify --wait   allow up to 180s for Backstage to finish ingesting
#
# Exit 0 only when every entity in the generated file is present in the
# catalogue. There is one catalogue: Backstage. Founder ruling 2026-08-24,
# "backstge is for catalog" and "ive seen 5 ui faces today" -- the Datasette
# fallback this script used to check as a second renderer is gone.
set -uo pipefail

IDP="$(cd "$(dirname "$0")/.." && pwd)"
YAML="$IDP/catalog/catalog-info.yaml"
BACKEND="http://127.0.0.1:7107"
JQ=/usr/local/bin/jq

deadline=0
[ "${1:-}" = "--wait" ] && deadline=$(( $(date +%s) + 180 ))

fail=0
say() { printf '%s\n' "$*"; }

# --- source of truth: what the generator wrote --------------------------------
if [ ! -f "$YAML" ]; then
  say "FAIL  no $YAML -- run bin/catalog-gen"; exit 1
fi
# Only asset documents are counted: Domain, System and Group are structure that
# catalog-gen adds itself and the inventory (and therefore estate.db) never holds.
# Counting every 'kind:' made 237 vs 239 look like two dropped assets on 2026-08-24.
want=$(grep -c '^kind: \(Component\|Resource\)$' "$YAML")
say "source    $want entities in catalog-info.yaml"
# crew#269 row 3: every Component carries a URL a person can open. Offenders are named;
# a repo with no github remote is the usual cause (LAW 24).
if lk=$(python3 "$IDP/bin/catalog-links-check" "$YAML" 2>&1); then say "ok        links     $lk"
else say "FAIL      links     $(printf '%s' "$lk" | head -1)"; printf '%s\n' "$lk" | tail -n +2 | sed 's/^/          /'; fail=1; fi

# --- schema: catalog-info.yaml validates against Backstage's published schema -
# Backstage's own schema lives at github.com/backstage/backstage under
# packages/catalog-model/src/schema/kinds/*.schema.json, one file per kind,
# cross-referencing each other by bare $id ("EntityMeta", "common#relation")
# rather than resolvable URIs -- they are bundled at Backstage's own build
# time, not fetchable as a standalone schema. SchemaStore republishes the same
# coverage as one self-contained, resolvable file, listed in SchemaStore's own
# catalog as "Catalog Info" / Backstage: https://json.schemastore.org/catalog-info.json
# (anyOf across API, Component, Domain, Group, Location, Resource, System,
# Template, User -- confirmed against SchemaStore's repo 2026-08-24).
#
# That schema validates one entity document. catalog-info.yaml is a
# multi-document YAML stream (`---`-separated) and check-jsonschema parses one
# document per file, so pointing it at the whole file fails to parse --
# "ComposerError: expected a single document in the stream" -- before the
# schema ever runs. Confirmed 2026-08-24, exit 1, no document checked. So this
# splits the stream into one instance file per document first and validates
# each one, which is everything the published schema can check; it does not
# and cannot validate cross-document properties such as duplicate names.
CJS="$IDP/.venv/bin/check-jsonschema"
SCHEMA_URL="https://json.schemastore.org/catalog-info.json"
if [ ! -x "$CJS" ]; then
  say "FAIL      schema  check-jsonschema missing -- $IDP/.venv/bin/pip install check-jsonschema"
  fail=1
else
  split_dir=$(mktemp -d)
  n_docs=$("$IDP/.venv/bin/python3" - "$YAML" "$split_dir" <<'PY'
import sys, os, yaml
src, out = sys.argv[1], sys.argv[2]
n = 0
for doc in yaml.safe_load_all(open(src)):
    if not doc:
        continue
    n += 1
    kind = doc.get("kind", "unknown")
    name = (doc.get("metadata") or {}).get("name", "x")
    with open(os.path.join(out, f"{n:04d}-{kind}-{name}.yaml"), "w") as fh:
        yaml.safe_dump(doc, fh)
print(n)
PY
)
  schema_out=$(mktemp)
  if [ "$n_docs" -eq 0 ]; then
    say "FAIL      schema  no entity documents parsed out of $YAML"
    fail=1
  elif "$CJS" --schemafile "$SCHEMA_URL" "$split_dir"/*.yaml > "$schema_out" 2>&1; then
    say "schema    $n_docs/$n_docs entity documents valid against $SCHEMA_URL"
  else
    say "FAIL      schema validation failed against $SCHEMA_URL:"
    sed 's/^/            /' "$schema_out"
    fail=1
  fi
  rm -f "$schema_out"
  rm -rf "$split_dir"
fi

# --- the catalogue ------------------------------------------------------------
ingested_names() {
  local tok
  tok=$(curl -sS --max-time 8 -X POST "$BACKEND/api/auth/guest/refresh" 2>/dev/null \
        | $JQ -r '.backstageIdentity.token // empty' 2>/dev/null)
  [ -z "$tok" ] && return 1
  curl -sS --max-time 25 -H "Authorization: Bearer $tok" \
    "$BACKEND/api/catalog/entities?limit=5000&fields=kind,metadata.name" 2>/dev/null \
    | $JQ -r '.[] | "\(.kind)/\(.metadata.name)"' 2>/dev/null
}

wanted_names() {
  awk '
    /^kind: /            { k=$2 }
    /^  name: / && k != "" { n=$2; gsub(/^'"'"'|'"'"'$/,"",n); print k "/" n; k="" }
  ' "$YAML"
}

# There is no second renderer to fall back to, so a backend that is not
# answering is a failing verification, not a partial one. This used to exit 0
# on the strength of Datasette serving the same rows.
if ! curl -sS -o /dev/null --max-time 4 "$BACKEND/api/catalog/entities" 2>/dev/null; then
  say "FAIL      the Backstage backend on 7107 is not answering -- nothing is serving the catalogue"
  exit 1
fi

tmp_w=$(mktemp); tmp_i=$(mktemp)
wanted_names | sort -u > "$tmp_w"
while :; do
  ingested_names | sort -u > "$tmp_i" 2>/dev/null
  missing=$(comm -23 "$tmp_w" "$tmp_i" | wc -l | tr -d ' ')
  [ "$missing" -eq 0 ] && break
  [ "$(date +%s)" -ge "$deadline" ] && break
  say "          waiting: $missing of $want not ingested yet"
  sleep 15
done

if [ "$missing" -eq 0 ]; then
  say "primary   all $want entities ingested by Backstage -- matches"
else
  say "FAIL      primary is missing $missing of $want entities:"
  comm -23 "$tmp_w" "$tmp_i" | head -10 | sed 's/^/            /'
  [ "$missing" -gt 10 ] && say "            ... and $((missing - 10)) more"
  say "          look for 'Policy check failed' in logs/backstage.log"
  fail=1
fi
rm -f "$tmp_w" "$tmp_i"

say
if [ "$fail" -eq 0 ]; then
  say "PASS      the catalogue matches the inventory: $want entities"
else
  say "FAIL      the portal does not match the inventory"
fi
# Port lock, live half (crew#186 CP4): every listener the inventory saw is declared
# in catalog/ports.yaml, and nothing but the gateway is off loopback (R20).
if out=$(python3 "$IDP/bin/port-gate" --live 2>&1); then say "ok        portlock  $(printf '%s' "$out" | tail -1 | sed 's/^ok *ports *//')"
else say "FAIL      portlock"; printf '%s\n' "$out" | sed 's/^/          /'; fail=1; fi
# Oracle identity drill (ADR 0004 step 1, founder 2026-08-25 "added to drill"): the vaulted key
# must still open the tenancy. BLIND until bin/idp-oci-bootstrap has run once.
if out=$("$IDP/bin/idp-oci-login" --check 2>&1); then say "$(printf '%s' "$out" | tail -1)"
elif [ $? = 2 ]; then say "$(printf '%s' "$out" | tail -1)"
else say "FAIL      oci     $(printf '%s' "$out" | tail -1)"; fail=1; fi
# The VM's config is a repo file (crew#212): drift here means the machine runs a VM nobody reviewed.
if out=$("$IDP/bin/idp-install-colima" --check 2>&1); then say "ok        colima    live profile matches substrate/colima.yaml"
else say "FAIL      colima    $(printf '%s' "$out" | head -1)"; fail=1; fi
# Every scheduled job carries a description in the Dagster UI. This is the live half:
# it needs the scripts the jobs actually run, which a CI runner does not have.
if out=$( ( cd "$IDP/scheduler" && python3 -m estate_scheduler.describe ) 2>&1); then
  say "ok        describe  $(printf '%s' "$out" | tail -1)"
else say "FAIL      describe  a scheduled job would reach the UI with no description"
  printf '%s\n' "$out" | grep '^FAIL' | sed 's/^/          /'; fail=1; fi
# Front door login (crew#269, ADR 0007): no password exists to try, so the proof is the redirect
# a browser would follow. Unauthenticated -> 302 to GitHub's authorize page, either directly
# (skip-provider-button, measured live 2026-08-26 after idp#147) or via /oauth2/start on the
# catalogue host. A 401, a 200, a 500 or any other Location is a FAIL, never a wait.
zone=$(sed -n 's/^  ESTATE_ZONE: *//p' "$IDP/clusters/oke/estate-config.yaml" | head -1)
if [ -z "$zone" ]; then say "BLIND     login     no ESTATE_ZONE in clusters/oke/estate-config.yaml"
else
  hop=$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 10 "https://catalogue.$zone/" 2>/dev/null || echo "000")
  case "$hop" in
    "302 https://catalogue.$zone/oauth2/start"*) hop=$(curl -sS -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 10 "${hop#302 }" 2>/dev/null || echo "000") ;;
  esac
  # The front door is generic OIDC against the estate's identity domain (platform/oci/identity);
  # the authorize URL is the one value in estate-config, never a provider name here (R36).
  idp_url=$(sed -n 's/^  ESTATE_OIDC_DOMAIN_URL: *//p' "$IDP/clusters/oke/estate-config.yaml" | head -1)
  case "$hop" in
    "302 ${idp_url%/}/oauth2/v1/authorize"*)
      # The client id in the redirect is what the vault holds (idp#149 review): empty or the
      # placeholder is a FAIL with the command that refreshes the pod after bin/idp-identity-apply.
      cid=$(printf '%s' "${hop#* }" | tr '?&' '\n\n' | sed -n 's/^client_id=//p' | head -1)
      case "$cid" in
        ""|replace-in-console) say "FAIL      login     https://catalogue.$zone -> identity domain with client_id '${cid:-<empty>}' (run bin/idp-identity-apply apply, then kubectl -n identity annotate externalsecret oauth2-proxy force-sync=\$(date +%s) --overwrite && kubectl -n identity rollout restart deploy/oauth2-proxy)"; fail=1 ;;
        *) say "ok        login     https://catalogue.$zone -> identity domain sign-in (no password anywhere, ADR 0007)" ;;
      esac
      # Incident 2026-08-26 02:31Z: the redirect was right and the first sign-in still returned 500,
      # because oauth2-proxy could not read the domain's JWKS (401) to verify the id_token. The row
      # above only proves the way in; this one proves the way back.
      jwks=$(curl -s -o /dev/null -m 10 -w '%{http_code}' "${idp_url%/}/admin/v1/SigningCert/jwk" 2>/dev/null || echo 000)
      case "$jwks" in
        200) say "ok        jwks      identity domain signing keys readable without a credential (callback can verify id_tokens)" ;;
        *) say "FAIL      jwks      ${idp_url%/}/admin/v1/SigningCert/jwk answers $jwks; the sign-in callback returns 500 (run bin/idp-identity-apply apply: it PATCHes signingCertPublicAccess)"; fail=1 ;;
      esac ;;
    "302 https://github.com/login/oauth/authorize"*) say "FAIL      login     https://catalogue.$zone -> GitHub: the pod still runs provider github; reconcile platform/identity (flux reconcile ks platform --with-source)"; fail=1 ;;
    *) say "FAIL      login     https://catalogue.$zone -> ${hop%% *} $(printf '%s' "${hop#* }" | cut -d'?' -f1) (want 302 to the identity domain; kubectl -n backstage get middleware login-forward-auth; kubectl -n identity get pods)"; fail=1 ;;
  esac
fi
# --- drills: the scheduled drills actually ran (crew#292 CP2) -----------------
# Founder 2026-08-26: "we have drills? ... when we get it working we need to drill". Every row
# above this one grades something static -- a file, a redirect, a declared port. None of them
# said whether the drills that are supposed to run on a cron had run at all. A workflow whose
# schedule silently stopped firing (a disabled workflow, a renamed default branch, or 60 days of
# repository inactivity, which is GitHub's documented rule for suspending scheduled workflows)
# looks identical from the repository to one that is passing every night.
#
# drills/catalogue.yaml is the list; this asks GitHub for the last successful run of each
# workflow and grades its age against max_age_hours. Entries marked pending are drills that are
# named but not merged yet: they print n/a and never FAIL, so the catalogue can carry the drill
# the estate is missing instead of staying quiet about it.
drills_out=$(python3 - "$IDP/drills/catalogue.yaml" "$IDP" <<'DRILLPY'
import json, os, subprocess, sys
from datetime import datetime, timezone

import yaml

cat_path, root = sys.argv[1], sys.argv[2]


def row(status, text):
    print("%-9s %-9s %s" % (status, "drills", text))


try:
    entries = (yaml.safe_load(open(cat_path, encoding="utf-8")) or {}).get("drills") or []
except FileNotFoundError:
    row("BLIND", "no %s -- nothing declares which drills should be running" % cat_path)
    sys.exit(2)
if not entries:
    row("BLIND", "%s declares no drills" % cat_path)
    sys.exit(2)


def gh(args):
    return subprocess.run(["gh"] + args, cwd=root, capture_output=True, text=True, timeout=60)


# One authentication probe for the whole row: an unauthenticated gh answers the same "not logged
# in" for every workflow, which would print N identical FAILs for one missing token. Freshness
# that cannot be measured is BLIND, never green (LAW 45 step 5).
try:
    auth = gh(["auth", "status"])
except FileNotFoundError:
    row("BLIND", "gh is not installed -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
except subprocess.TimeoutExpired:
    row("BLIND", "gh auth status timed out -- cannot ask GitHub when the drills last ran")
    sys.exit(2)
if auth.returncode != 0:
    row("BLIND", "gh is not authenticated (run: gh auth login) -- drill freshness unknown, not green")
    sys.exit(2)

now = datetime.now(timezone.utc)
graded, stale, pending = 0, [], 0
for d in entries:
    name = d.get("name", "?")
    wf = d.get("workflow", "")
    job = d.get("job")
    label = "%s%s" % (name, "" if not job or job == name else " (job %s)" % job)
    if d.get("pending"):
        pending += 1
        row("n/a", "%-22s %s not merged yet -- declared in the catalogue, never graded" % (label, wf))
        continue
    graded += 1
    # GitHub keeps run history for a deleted workflow, so a retired file still answers "last
    # green 0.2h ago" for a while (idp#178 review, 2026-08-26: the workflow retired in #167
    # kept being graded from its run history). The file on disk is the only honest source.
    if not os.path.isfile(os.path.join(root, ".github", "workflows", wf)):
        stale.append(name)
        row("FAIL", "%-22s .github/workflows/%s does not exist -- the catalogue names a retired workflow; fix the entry or the file" % (label, wf))
        continue
    try:
        r = gh(["run", "list", "--workflow", wf, "--status", "success", "--limit", "1",
                "--json", "updatedAt"])
    except subprocess.TimeoutExpired:
        stale.append(name)
        row("FAIL", "%-22s gh run list --workflow %s timed out" % (label, wf))
        continue
    if r.returncode != 0:
        stale.append(name)
        detail = ((r.stderr or "").strip().splitlines() or [""])[0]
        row("FAIL", "%-22s gh could not list runs of %s: %s" % (label, wf, detail))
        continue
    try:
        runs = json.loads(r.stdout or "[]")
    except json.JSONDecodeError:
        runs = []
    if not runs:
        stale.append(name)
        row("FAIL", "%-22s no successful run of %s has ever been recorded (cron %s)"
            % (label, wf, d.get("schedule", "?")))
        continue
    ts = datetime.strptime(runs[0]["updatedAt"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    age = (now - ts).total_seconds() / 3600.0
    cap = float(d.get("max_age_hours", 26))
    if age > cap:
        stale.append(name)
        row("FAIL", "%-22s %s last green %.1fh ago, older than %gh (cron %s)"
            % (label, wf, age, cap, d.get("schedule", "?")))
    else:
        row("ok", "%-22s %s last green %.1fh ago (max %gh)" % (label, wf, age, cap))

tail = " (%d pending)" % pending if pending else ""
if stale:
    row("FAIL", "%d of %d stale: %s%s" % (len(stale), graded, ", ".join(stale), tail))
    sys.exit(1)
row("ok", "%d/%d green within window%s" % (graded, graded, tail))
sys.exit(0)
DRILLPY
)
drills_rc=$?
printf '%s\n' "$drills_out"
[ "$drills_rc" = 1 ] && fail=1
exit "$fail"
