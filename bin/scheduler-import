#!/usr/bin/env bash
# Read every scheduled (non-daemon) job in ~/Library/LaunchAgents and print it as
# scheduler/schedule.yml. Report mode only: it writes to stdout, never to disk.
#
#   bin/scheduler-import > scheduler/schedule.yml
#
# Paths under $HOME are written as ~ so the file carries no machine name (LAW 46).
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
IDP="$(cd "$(dirname "$0")/.." && pwd)"
exec "$IDP/.venv/bin/python" "$IDP/scheduler/estate_scheduler/import_launchd.py" "$@"
