#!/usr/bin/env bash
# idp-prove — run a check and print the trailer that proves it ran.
#
# WHY. The estate's oldest defect is a claim made without its checker: an agent guesses at a
# cause, pushes, and the guess costs a batch. AGENTS.md section 3 already says a claim without
# its proof is not made; this makes that mechanical for commits. A `Proof:` trailer cannot be
# invented -- the hook compares it to the record this command just wrote, which carries the
# command, its exit status and a sha256 of its actual output.
#
#   bin/idp-prove -- bin/idp-ci
#   Proof: bin/idp-ci exit=0 sha256=ab12...
set -euo pipefail
[ "${1:-}" = "--" ] && shift
[ $# -gt 0 ] || { echo "usage: bin/idp-prove -- <command...>" >&2; exit 2; }
dir="${HOME}/.estate/proofs"; mkdir -p "$dir"
out="$(mktemp)"; trap 'rm -f "$out"' EXIT
set +e; "$@" >"$out" 2>&1; rc=$?; set -e
sum="$(shasum -a 256 "$out" | awk '{print $1}')"
cmd="$*"
printf '{"at":"%s","command":"%s","exit":%s,"sha256":"%s"}\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${cmd//\"/\\\"}" "$rc" "$sum" >> "$dir/proofs.jsonl"
printf 'Proof: %s exit=%s sha256=%s\n' "$cmd" "$rc" "$sum"
[ "$rc" -eq 0 ] || exit "$rc"
