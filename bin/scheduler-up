#!/usr/bin/env bash
# Start the estate scheduler: dagster-daemon (ticks schedules and sensors, runs
# the queue) and dagster-webserver (the one place to see every job). Idempotent.
#
#   primary   dagster-daemon      no port
#   ui        dagster-webserver   127.0.0.1:3210
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
export DAGSTER_HOME="$IDP/run/dagster"
mkdir -p "$DAGSTER_HOME"
cp "$IDP/scheduler/dagster.yaml" "$DAGSTER_HOME/dagster.yaml"
PORT=3210
log() { printf '%s  %s\n' "$(date -u +%H:%M:%SZ)" "$*"; }

# Fail early if schedule.yml does not load: a scheduler with a broken policy
# file ticks nothing and says nothing.
"$IDP/.venv/bin/python" -c "import sys; sys.path.insert(0, '$IDP/scheduler'); from estate_scheduler.definitions import defs; print('schedule.yml ok:', len(list(defs.jobs or [])), 'jobs')"

if ! pgrep -qf "[d]agster-daemon run"; then  # bracket: never match a shell whose own command line names it (crew#85)
  ( cd "$IDP/scheduler" && nohup "$IDP/.venv/bin/dagster-daemon" run -w workspace.yaml > "$IDP/run/dagster-daemon.out" 2>&1 & echo $! > "$IDP/run/dagster-daemon.pid" )
  log "daemon    starting (pid $(cat "$IDP/run/dagster-daemon.pid"))"
else
  log "daemon    already running"
fi
if ! curl -fsS -o /dev/null "http://127.0.0.1:$PORT/server_info" 2>/dev/null; then
  ( cd "$IDP/scheduler" && nohup "$IDP/.venv/bin/dagster-webserver" -w workspace.yaml -h 127.0.0.1 -p "$PORT" > "$IDP/run/dagster-web.out" 2>&1 & echo $! > "$IDP/run/dagster-web.pid" )
  log "webserver starting on $PORT (pid $(cat "$IDP/run/dagster-web.pid"))"
else
  # crew#85, 2026-08-27 07:45Z: idp#316 landed, the running webserver kept the code location it had
  # imported before the merge (ImportError: load_gate), and every launch from the UI was refused
  # for two hours while the tree on disk was correct. A running webserver serves the tree it last
  # loaded, so an update is not applied until the location is reloaded. Reload, and refuse to
  # report "up" over a location that does not import.
  reload='{"query":"mutation { reloadWorkspace { __typename ... on Workspace { locationEntries { name locationOrLoadError { __typename ... on PythonError { message } } } } ... on PythonError { message } } }"}'
  if ! curl -fsS -m 120 -H 'Content-Type: application/json' -d "$reload" "http://127.0.0.1:$PORT/graphql" \
      | "$IDP/.venv/bin/python" -c '
import json, sys
w = json.load(sys.stdin)["data"]["reloadWorkspace"]
bad = [e for e in w.get("locationEntries", []) if e["locationOrLoadError"]["__typename"] == "PythonError"]
for e in bad:
    print("code location", e["name"], "does not load:", e["locationOrLoadError"]["message"].splitlines()[0][:200])
sys.exit(1 if bad or w["__typename"] != "Workspace" else 0)
'; then
    log "webserver up on $PORT but its code location does not load; see above"
    exit 1
  fi
  log "webserver already up on $PORT; code location reloaded from the tree on disk"
fi
