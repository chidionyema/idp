#!/usr/bin/env python3
"""idp-apply MANIFEST [--dry-run]: the one way an agent starts something on
this host (crew#186 CP5, R22 mechanism 5).

  1 validate   check-jsonschema against catalog/manifests/schema.json:
               pinned image, loopback ports, a health URL, nothing else
  2 ports      every host port is declared for this service in catalog/ports.yaml
  3 migration  if the manifest names one, bin/migration-gate must pass first
  4 sandbox    docker run --cap-drop ALL --security-opt no-new-privileges
               --pids-limit --memory --cpus --read-only-tmpfs, loopback only,
               label idp.manifest=<name> so bin/idp-reconcile owns it
  5 health     poll health.url; red means the container is removed, exit 1
Every step appends to run/apply.jsonl. The manifest must live in
catalog/manifests/ or reconcile removes the container on its next tick.
"""
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request

import yaml

IDP = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
SCHEMA = os.path.join(IDP, "catalog", "manifests", "schema.json")
REG = os.environ.get("REG") or os.path.join(IDP, "catalog", "ports.yaml")
LEDGER = os.environ.get("APPLY_LEDGER") or os.path.join(IDP, "run", "apply.jsonl")


def log(step, name, ok, detail=""):
    print(f"{'ok  ' if ok else 'FAIL'}  apply {step:<9} {name}: {detail}".rstrip(": "))
    os.makedirs(os.path.dirname(LEDGER), exist_ok=True)
    open(LEDGER, "a").write(json.dumps({"at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "step": step,
                                        "name": name, "ok": ok, "detail": detail}, sort_keys=True) + "\n")


def main() -> int:
    argv = [a for a in sys.argv[1:] if not a.startswith("--")]
    dry = "--dry-run" in sys.argv
    if not argv:
        print(__doc__)
        return 2
    path = os.path.abspath(argv[0])
    name = os.path.basename(path).rsplit(".", 1)[0]
    r = subprocess.run(["check-jsonschema", "--schemafile", SCHEMA, path], capture_output=True, text=True)
    if r.returncode:
        why = [l for l in (r.stdout + r.stderr).splitlines() if l.strip()][-1:]
        log("validate", name, False, why[0].strip() if why else "schema refused")
        return 1
    m = yaml.safe_load(open(path))
    if m["name"] != name:
        log("validate", name, False, f"manifest name {m['name']} must equal the file name")
        return 1
    log("validate", name, True, "schema ok")
    declared = {int(p["port"]): p for p in (yaml.safe_load(open(REG)) or {}).get("ports", [])}
    for p in m.get("ports", []):
        d = declared.get(p["host"])
        if not d or d["service"] != name:
            log("ports", name, False, f"host port {p['host']} is not declared for {name} in catalog/ports.yaml")
            return 1
    log("ports", name, True, f"{len(m.get('ports', []))} port(s) declared")
    if m.get("migration"):
        mig = os.path.join(os.path.dirname(path), m["migration"]) if not os.path.isabs(m["migration"]) else m["migration"]
        r = subprocess.run([os.path.join(IDP, "bin", "migration-gate"), mig], capture_output=True, text=True)
        log("migration", name, r.returncode == 0, (r.stdout.strip().splitlines() or ["?"])[-1][:140])
        if r.returncode:
            return 1
    if m["action"] == "down":
        if not dry:
            subprocess.run(["docker", "rm", "-f", name], capture_output=True)
        log("down", name, True, "dry-run" if dry else "removed")
        return 0
    lim = m.get("limits", {})
    cmd = ["docker", "run", "-d", "--name", name, "--label", f"idp.manifest={name}",
           "--cap-drop", "ALL", "--security-opt", "no-new-privileges", "--pids-limit", "256",
           "--memory", lim.get("memory", "512m"), "--cpus", str(lim.get("cpus", 1)), "--restart", "unless-stopped"]
    for cap in m.get("caps", []):
        cmd += ["--cap-add", cap]
    for p in m.get("ports", []):
        cmd += ["-p", f"127.0.0.1:{p['host']}:{p['container']}"]
    for k, v in (m.get("env") or {}).items():
        cmd += ["-e", f"{k}={v}"]
    cmd.append(m["image"])
    if dry:
        log("sandbox", name, True, "dry-run: " + " ".join(cmd[:14]) + " ...")
        return 0
    if not shutil.which("docker"):
        log("sandbox", name, False, "docker not on PATH")
        return 1
    subprocess.run(["docker", "rm", "-f", name], capture_output=True)
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        log("sandbox", name, False, r.stderr.strip().splitlines()[-1][:140])
        return 1
    log("sandbox", name, True, r.stdout.strip()[:12])
    deadline = time.time() + m["health"].get("timeout_s", 60)
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(m["health"]["url"], timeout=3) as resp:
                if resp.status < 400:
                    log("health", name, True, f"{m['health']['url']} -> {resp.status}")
                    return 0
        except Exception:
            pass
        time.sleep(2)
    subprocess.run(["docker", "rm", "-f", name], capture_output=True)
    log("health", name, False, f"{m['health']['url']} never answered; container removed")
    return 1


if __name__ == "__main__":
    sys.exit(main())
