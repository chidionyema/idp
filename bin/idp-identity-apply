#!/usr/bin/env bash
# Provision the front door's OIDC client in the estate's identity domain (platform/oci/identity)
# with every input read from where it already lives: zone from estate-config, the domain URL and
# founder email from the repository variables bin/idp-oci-bootstrap wrote (or the environment in
# CI), vault/key/compartment from the existing vault secrets. Nothing typed, nothing pasted
# (crew#281, crew#269, LAW 46).  Usage: bin/idp-identity-apply [plan|apply -auto-approve]
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
export SUPPRESS_LABEL_WARNING=True
zone=$(awk '/ESTATE_ZONE:/{print $2}' "$IDP/clusters/oke/estate-config.yaml")
export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}
repo() { gh -R "$(git -C "$IDP" remote get-url origin)" repo view --json nameWithOwner -q .nameWithOwner; }
DOMAIN_BASE_URL="${DOMAIN_BASE_URL:-$(gh variable get DOMAIN_BASE_URL -R "$(repo)")}"
ESTATE_FOUNDER_EMAIL="${ESTATE_FOUNDER_EMAIL:-$(gh variable get ESTATE_FOUNDER_EMAIL -R "$(repo)")}"
: "${DOMAIN_BASE_URL:?DOMAIN_BASE_URL: run bin/idp-oci-bootstrap}"; : "${ESTATE_FOUNDER_EMAIL:?ESTATE_FOUNDER_EMAIL: the email the front door admits}"
cfg=$(awk '/ESTATE_OIDC_DOMAIN_URL:/{print $2}' "$IDP/clusters/oke/estate-config.yaml")
[ "${cfg%/}" = "${DOMAIN_BASE_URL%/}" ] || { echo "FAIL    identity estate-config ESTATE_OIDC_DOMAIN_URL ($cfg) differs from DOMAIN_BASE_URL; the pod would sign in against a different domain than the client lives in"; exit 2; }
# compartment: the CI variable when the job sets it, else the vault, as bin/idp-vault-put
C="${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$IDP/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}"
# vault and key: the ones the existing estate secrets already live in; placeholders are imported, never re-created
CID=$(oci vault secret list --compartment-id "$C" --name oauth2-proxy-client-id --query 'data[0].id' --raw-output 2>/dev/null || true)
CSEC=$(oci vault secret list --compartment-id "$C" --name oauth2-proxy-client-secret --query 'data[0].id' --raw-output 2>/dev/null || true)
[ -n "$CID" ] || { echo "FAIL    identity vault secret oauth2-proxy-client-id not found in compartment; platform/identity has never been bootstrapped"; exit 2; }
V=$(oci vault secret get --secret-id "$CID" --query 'data."vault-id"' --raw-output)
K=$(oci vault secret get --secret-id "$CID" --query 'data."key-id"' --raw-output)
M="$IDP/platform/oci/identity"
if [ -f "$M/backend_override.tf" ]; then "$IDP/bin/idp-state-guard" "$M"; tofu -chdir="$M" init -input=false -reconfigure >/dev/null
else echo "BLIND   state   platform/oci/identity/backend_override.tf missing: local state; run bin/idp-oci-login"; tofu -chdir="$M" init -input=false >/dev/null; fi
tofu -chdir="$M" "${1:-plan}" -input=false "${@:2}" \
  -var "idcs_endpoint=$DOMAIN_BASE_URL" -var "zone=$zone" -var "founder_emails=[\"$ESTATE_FOUNDER_EMAIL\"]" \
  -var "compartment_ocid=$C" -var "vault_ocid=$V" -var "key_ocid=$K" \
  -var "client_id_secret_ocid=${CID:-}" -var "client_secret_secret_ocid=${CSEC:-}"
