#!/usr/bin/env bash
# Provision the front door's OIDC client in the estate's identity domain (platform/oci/identity)
# with every input read from where it already lives: zone from estate-config, the domain URL and
# founder email from the repository variables bin/idp-oci-bootstrap wrote (or the environment in
# CI), vault/key/compartment from the existing vault secrets. Nothing typed, nothing pasted
# (crew#281, crew#269, LAW 46).  Usage: bin/idp-identity-apply [plan|apply -auto-approve]
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
export SUPPRESS_LABEL_WARNING=True
zone=$(awk '/ESTATE_ZONE:/{print $2}' "$IDP/clusters/oke/estate-config.yaml")
export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$HOME/.config/prospector/age-key.txt}
# the main checkout, even when this script runs from a worktree under .claude/worktrees (crew#408)
MAIN=$(dirname "$(git -C "$IDP" rev-parse --path-format=absolute --git-common-dir)")
repo() { gh repo view "$(git -C "$IDP" remote get-url origin)" --json nameWithOwner -q .nameWithOwner; }
DOMAIN_BASE_URL="${DOMAIN_BASE_URL:-$(gh variable get DOMAIN_BASE_URL -R "$(repo)")}"
ESTATE_FOUNDER_EMAIL="${ESTATE_FOUNDER_EMAIL:-$(gh variable get ESTATE_FOUNDER_EMAIL -R "$(repo)")}"
: "${DOMAIN_BASE_URL:?DOMAIN_BASE_URL: run bin/idp-oci-bootstrap}"; : "${ESTATE_FOUNDER_EMAIL:?ESTATE_FOUNDER_EMAIL: the email the front door admits}"
cfg=$(awk '/ESTATE_OIDC_DOMAIN_URL:/{print $2}' "$IDP/clusters/oke/estate-config.yaml")
[ "${cfg%/}" = "${DOMAIN_BASE_URL%/}" ] || { echo "FAIL    identity estate-config ESTATE_OIDC_DOMAIN_URL ($cfg) differs from DOMAIN_BASE_URL; the pod would sign in against a different domain than the client lives in"; exit 2; }
# `probe` is the read-only door to the app's sign-on policy. There is no Terraform resource
# for it (no oci_identity_domains sign-on resource in provider oracle/oci 8.19+, measured 404
# against the provider docs 2026-10-12), and the classic docs point at /admin/v1/SignOnPolicies,
# which is the WRONG ENDPOINT NAME on this OCI-generation domain and 401s every auth (API key
# and the CI runner's security token alike, measured 2026-10-12). The live endpoints are
# /admin/v1/{Policies,Rules,Conditions} -- readable by the same auth that reads Apps. Probe
# prints the app's policy ref, every policy, rule and condition, and which of those rules the
# front-door policy actually calls, then exits -- no PUT, no PATCH,
# no vault read, no tofu. The enforcement block below was designed from this dump, not from the
# classic-IDCS docs, because this domain has already refused two of their values (RequiredForAll
# and ALL_USERS, both 400, measured 2026-10-11).
if [ "${1:-plan}" = probe ]; then
  app=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps?filter=displayName%20eq%20%22estate-front-door%22&attributes=id,displayName,signonPolicy" 2>/dev/null | jq -c '.data.Resources[0] // empty')
  echo "probe   app      $app"
  appid=$(printf '%s' "$app" | jq -r '.id // ""')
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" 2>/dev/null \
    | jq -c '.data.Resources[] | {id, name, active}' | sed 's/^/probe   policy   /'
  # every rule with its `return` list, not just its name: the factor values this domain's own rules
  # carry are the only authority on what it honours at sign-in, and a name alone cannot say why a
  # rule the domain ignores is worse than no rule at all (#5858, measured 2026-10-12: the door
  # offered no passkey control to the cohort and then signed it in with its password alone).
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null \
    | jq -c '.data.Resources[] | {id, name, return}' | sed 's/^/probe   rule     /'
  # Which rules the front-door policy actually CALLS, and in what order. A rule can exist, be
  # active and carry a factor value while the policy never references it -- measured 2026-10-12:
  # the domain held two live rules named "front door offers passwordless sign-in" while the door
  # still asked the cohort for its password (drill run 38296585146), and a dump that lists rules
  # without the policy's own sequence cannot tell "wired and not honoured" from "not wired at
  # all". Two different fixes, and tonight's two-hour detour was the difference (#5858).
  if [ -n "$appid" ]; then
    fdp=$(printf '%s' "$app" | jq -r '.signonPolicy.value // ""')
    [ -n "$fdp" ] || fdp=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps/$appid?attributes=signonPolicy" 2>/dev/null | jq -r '.data.signonPolicy.value // ""')
    oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies/$fdp?attributes=name,rules" 2>/dev/null \
      | jq -c '{policy: .data.name, called: [(.data.rules[]? | {rule: .value, sequence})]}' | sed 's/^/probe   polrule  /'
  fi
  # does the app itself carry a passwordless/FIDO switch, or is the sign-on policy the only place
  # on this domain where a factor is named? Attribute names only, never their values.
  if [ -n "$appid" ]; then
    oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps/$appid" 2>/dev/null \
      | jq -r '.data | keys_unsorted | map(select(test("factor|password|fido|webauthn|passkey";"i"))) | join(",")' \
      | sed 's/^/probe   appattrs /'
  fi
  # and if the domain enumerates the factor values its own Rule schema accepts, this is where it says so
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Schemas/urn:ietf:params:scim:schemas:oracle:idcs:Rule" 2>/dev/null \
    | jq -c '[.data.attributes[]? | select(.name | test("factor|^return$|passwordless";"i")) | {name,type,multiValued,canonicalValues,description}]' \
    | sed 's/^/probe   rschema  /'
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions" 2>/dev/null \
    | jq -c '.data.Resources[] | {id}' | sed 's/^/probe   cond     /'
  exit 0
fi
# compartment: the CI variable when the job sets it, else the vault, as bin/idp-vault-put
C="${OCI_COMPARTMENT_OCID:-$(sops -d --extract '["OCI_COMPARTMENT_OCID"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_COMPARTMENT_OCID.yaml")}"
# vault and key: the ones the existing estate secrets already live in; placeholders are imported, never re-created
# crew#66 CP5b: vault reads go through bin/idp-cloud (one primitive layer). A layer exit 1 (NotFound) is FAIL;
# a layer exit 3 (Split) or any other non-zero is BLIND (exit 2), never treated as a silent empty value.
# one stderr file per describe: a BLIND on client-id must print client-id's line, never client-secret's
err_id="${TMPDIR:-/tmp}/identity-id.err"; : > "$err_id"
err_sec="${TMPDIR:-/tmp}/identity-secret.err"; : > "$err_sec"
desc_id=$("$IDP/bin/idp-cloud" secret describe oauth2-proxy-client-id 2>"$err_id"); rc_id=$?
desc_sec=$("$IDP/bin/idp-cloud" secret describe oauth2-proxy-client-secret 2>"$err_sec"); rc_sec=$?
case "$rc_id" in
  0) CID=$(printf '%s' "$desc_id" | jq -r .id); V=$(printf '%s' "$desc_id" | jq -r '."vault-id"'); K=$(printf '%s' "$desc_id" | jq -r '."key-id"');;
  1) echo "FAIL    identity vault secret oauth2-proxy-client-id not found in compartment; platform/identity has never been bootstrapped"; exit 2;;
  *) echo "BLIND   identity $(head -1 "$err_id")"; exit 2;;
esac
[ -n "$CID" ] && [ "$CID" != null ] || { echo "FAIL    identity vault secret oauth2-proxy-client-id not found in compartment; platform/identity has never been bootstrapped"; exit 2; }
case "$rc_sec" in
  0) CSEC=$(printf '%s' "$desc_sec" | jq -r .id);;
  1) CSEC="";;
  *) echo "BLIND   identity $(head -1 "$err_sec")"; exit 2;;
esac
# Incident 2026-08-26 02:31Z (crew#269): the first sign-in returned 500. oauth2-proxy read
# /admin/v1/SigningCert/jwk to verify the id_token and the domain answered 401: a new domain keeps its
# signing certificate private. The OpenTofu resource cannot set one flag (PutSetting replaces the
# whole object and the domain refuses a partial one, measured 400), so the flag is a SCIM PATCH here,
# idempotent, and part of provisioning the client rather than a console toggle.
sc=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Settings/Settings?attributes=signingCertPublicAccess" 2>/dev/null | jq -r '.data.signingCertPublicAccess // false')
if [ "$sc" != "true" ]; then
  T=$(mktemp -d); chmod 700 "$T"; trap 'rm -rf "$T"' EXIT
  printf '%s' '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"signingCertPublicAccess","value":true}]}' > "$T/s.json"
  pr=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/Settings/Settings" --request-body "file://$T/s.json" 2>&1)
  if printf '%s' "$pr" | jq -e '.data.signingCertPublicAccess == true' >/dev/null 2>&1; then echo "ok      identity domain signing certificate is public (JWKS readable by oauth2-proxy)"
  else echo "FAIL    identity domain Settings PATCH refused: $(printf '%s' "$pr" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; fi
else echo "ok      identity domain signing certificate is public"; fi
# Phase 2 of Face ID at the front door (#5753): MFA enrollment must be required for all users, or
# the domain never offers a second factor and Face ID can never appear at the front door. The
# terraform resource for this singleton is PUT-everything (49 attributes) and its import never
# lands clean: the provider does not persist authentication_factor_setting_id, so every plan
# would replace the domain's whole factor policy, and one wrong value in that PUT is a founder
# lockout. Same decision as the signing certificate above (crew#269): a one-attribute SCIM
# PATCH, idempotent, read back. The FIDO2 factor itself is already enabled in the domain
# (fido_authenticator_enabled=true, userVerification=PREFERRED, measured 2026-10-11). The
# domain's enum here is "Required" ("Optional" | "Required"; the classic-IDCS value
# "RequiredForAll" is refused with 400 on this OCI-generation domain, measured 2026-10-11).
mfa=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/AuthenticationFactorSettings/AuthenticationFactorSettings?attributes=mfaEnrollmentType" 2>/dev/null | jq -r '.data.mfaEnrollmentType // ""')
if [ "$mfa" != "Required" ]; then
  T=$(mktemp -d); chmod 700 "$T"; trap 'rm -rf "$T"' EXIT
  printf '%s' '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"mfaEnrollmentType","value":"Required"}]}' > "$T/m.json"
  pm=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/AuthenticationFactorSettings/AuthenticationFactorSettings" --request-body "file://$T/m.json" 2>&1)
  if printf '%s' "$pm" | jq -e '.data.mfaEnrollmentType == "Required"' >/dev/null 2>&1; then echo "ok      identity domain MFA enrollment required for all users (Face ID can be enrolled at the next sign-in, #5753)"
  else echo "FAIL    identity domain MFA enrollment PATCH refused: $(printf '%s' "$pm" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; fi
else echo "ok      identity domain MFA enrollment already required for all users"; fi
# The other half of the gate: mfaEnabledCategory on SsoSettings. mfaEnrollmentType only says
# "enroll when the user signs in"; if this category is NONE the domain never shows the MFA step
# at all (founder saw the plain Oracle login page even with enrollment Required, 2026-10-11).
# Not terraform-reachable (SsoSettings has no provider resource; SignOnPolicies REST refuses
# API-key signatures), so same idempotent SCIM PATCH. Enum on this domain: NONE | ALL
# (ALL_USERS/EVERYONE/USERS refused 400, measured 2026-10-11).
mec=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/SsoSettings" 2>/dev/null | jq -r '.data.Resources[0].mfaEnabledCategory // ""')
if [ "$mec" != "ALL" ]; then
  T2=$(mktemp -d); chmod 700 "$T2"; trap 'rm -rf "${T:-/dev/null}" "${T2:-/dev/null}" 2>/dev/null || true' EXIT
  printf '%s' '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"mfaEnabledCategory","value":"ALL"}]}' > "$T2/m.json"
  pm2=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/SsoSettings/SsoSettings" --request-body "file://$T2/m.json" 2>&1)
  if printf '%s' "$pm2" | jq -e '.data.mfaEnabledCategory == "ALL"' >/dev/null 2>&1; then echo "ok      identity domain MFA enabled for all users at sign-in (#5753)"
  else echo "FAIL    identity domain SsoSettings MFA PATCH refused: $(printf '%s' "$pm2" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; fi
else echo "ok      identity domain MFA enabled for all users at sign-in already"; fi
# The passkey itself (#5818). A WebAuthn credential created with authenticatorSelectionResidentKey
# =NONE is NON-DISCOVERABLE: the server must name it in allowCredentials, so a username -- and on
# this door a password -- has to come first, and the credential can therefore never be a
# passwordless factor, whatever a rule says. Measured live 2026-10-12: requireResidentKey=false,
# residentKey="NONE", userVerification="PREFERRED". That is the mechanism behind
# authenticationFactor="Passwordless" being inert at the door: the domain held no credential it
# could offer on its own, so it fell back to the password form. REQUIRED residency makes the
# credential a passkey -- the thing a platform authenticator (Face ID / Touch ID) signs in with
# unaccompanied -- and REQUIRED user verification makes the ceremony a real biometric rather than
# a bare presence tap, which is what "Face ID alone" has to mean. Same one-object SCIM PATCH as
# mfaEnrollmentType above: idempotent, read back, no terraform and no founder lockout path.
read_fido() {
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/AuthenticationFactorSettings" 2>/dev/null \
    | jq -r '.data.Resources[0]["urn:ietf:params:scim:schemas:oracle:idcs:extension:fido:AuthenticationFactorSettings"] // {} | "\(.authenticatorSelectionResidentKey // "")/\(.authenticatorSelectionRequireResidentKey // "")/\(.authenticatorSelectionUserVerification // "")"'
}
fido=$(read_fido)
if [ "$fido" != "REQUIRED/true/REQUIRED" ]; then
  T=$(mktemp -d); chmod 700 "$T"; trap 'rm -rf "${T:-/dev/null}" "${T2:-/dev/null}" 2>/dev/null || true' EXIT
  printf '%s' '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"urn:ietf:params:scim:schemas:oracle:idcs:extension:fido:AuthenticationFactorSettings:authenticatorSelectionResidentKey","value":"REQUIRED"},{"op":"replace","path":"urn:ietf:params:scim:schemas:oracle:idcs:extension:fido:AuthenticationFactorSettings:authenticatorSelectionRequireResidentKey","value":true},{"op":"replace","path":"urn:ietf:params:scim:schemas:oracle:idcs:extension:fido:AuthenticationFactorSettings:authenticatorSelectionUserVerification","value":"REQUIRED"}]}' > "$T/f.json"
  pf=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/AuthenticationFactorSettings/AuthenticationFactorSettings" --request-body "file://$T/f.json" 2>&1)
  rb=$(read_fido)
  if [ "$rb" = "REQUIRED/true/REQUIRED" ]; then echo "ok      identity FIDO2 credentials are passkeys (residentKey=REQUIRED, userVerification=REQUIRED): the domain can offer a Face ID sign-in with no password (#5818)"
  else echo "FAIL    identity FIDO2 passkey PATCH refused (read back met=$rb): $(printf '%s' "$pf" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; fi
else echo "ok      identity FIDO2 credentials are already passkeys (residentKey=REQUIRED, userVerification=REQUIRED)"; fi
M="$IDP/platform/oci/identity"
# the provider signs in the way the oci CLI in this run does: SecurityToken under GitHub OIDC
# (oke-check sets OCI_CLI_AUTH=security_token), APIKey on a laptop (crew#408)
PAUTH=APIKey; [ "${OCI_CLI_AUTH:-}" = security_token ] && PAUTH=SecurityToken
# region: the CI variable when the job sets it, else the vault; a SecurityToken provider cannot read it from the profile (run 33030450105)
REGION="${OCI_REGION:-$(sops -d --extract '["OCI_REGION"]' "${ESTATE_SECRETS:-${ESTATE_CODE:-$MAIN/..}/estate-secrets}/secrets/dev/OCI_REGION.yaml")}"
if [ -f "$M/backend_override.tf" ]; then "$IDP/bin/idp-state-guard" "$M"; tofu -chdir="$M" init -input=false -reconfigure >/dev/null
else echo "BLIND   state   platform/oci/identity/backend_override.tf missing: local state; run bin/idp-oci-login"; tofu -chdir="$M" init -input=false >/dev/null; fi
tofu -chdir="$M" "${1:-plan}" -input=false "${@:2}" \
  -var "idcs_endpoint=$DOMAIN_BASE_URL" -var "zone=$zone" -var "founder_emails=[\"$ESTATE_FOUNDER_EMAIL\"]" \
  -var "compartment_ocid=$C" -var "vault_ocid=$V" -var "key_ocid=$K" \
  -var "client_id_secret_ocid=${CID:-}" -var "client_secret_secret_ocid=${CSEC:-}" \
  -var "oci_auth=$PAUTH" -var "oci_profile=${OCI_CLI_PROFILE:-DEFAULT}" -var "region=$REGION"

# The enforcement itself (#5818): the app's own sign-on policy. The knobs above are domain-level
# and the drill measured they do not bind a second factor to THIS app (bd34e386a, 2026-10-12
# 00:58Z: the door signed straight through on the password alone, mfa_kind=none). The app carries
# no signonPolicy ref, so it falls to DefaultSignOnPolicy, whose DefaultSignOnRule returns
# authenticationFactor IDP -- password only (all three shapes read from this domain's own dump,
# 2026-10-12). No Terraform resource manages Policies/Rules/Conditions, so like the singletons
# above this is an idempotent SCIM ensure, read back: one condition (target.action eq "Login"),
# one rule (IDP+2FA with the same factor spelling as the domain's own Console MFA rule, enrolment
# not skippable, every sign-in), one policy holding that rule, and the policy assigned to the
# app. The grader is the hourly login drill: it should stop at mfa=enroll with faceid=offered.
#
# Four facts the first applies taught (run 38206416420 "condition PUT refused: The resource
# does not exist"; run 38208401584 "Missing required attribute(s): attributeName,attributeValue"):
#   1. These ids are SERVER-assigned. PUT to a chosen id cannot create; creation is POST to the
#      collection, and the returned id is what everything else references. The readable ids in
#      the domain's own policies (OciConsolePolicy, DefaultSignOnPolicy) were minted by IDCS's
#      own idcssm app, not by clients.
#   2. The rule's return list is `return`, exactly as the domain's own MFA rule
#      (OciConsoleMFANonAdminRule, "MFA for all users") serializes it (read back from this
#      domain 2026-10-12), not `-return`.
#   3. Conditions take camelCase attributeName/attributeValue; the SCIM-style dash form is
#      refused. Read back from this domain 2026-10-12: the Security Default's own condition is
#      {attributeName:"target.action", operator:"eq", attributeValue:"\"Login\""} under
#      schemas [urn:ietf:params:scim:schemas:oracle:idcs:Condition].
#   3b. The same spelling governs the Rule and Policy bodies: the domain's own MFA rule reads
#      back as policyType/conditionGroup (read 2026-10-12), and the dash form is refused the
#      same way. Measured in production against run 38211191902: the Condition was created
#      (front door sign-in, 46e5dafb927a42e6844a12c136e8742c) and the apply then died at the
#      Rule, which did not exist -- so camelCase was the whole of the Condition's cost, and
#      the Rule and Policy carried the identical defect.
#   4. The ensure runs AFTER the tofu apply, not before it: tofu owns the App resource and its
#      provider does not model signonPolicy (no such attribute in oracle/oci 8.19+), so a
#      drift-driven tofu PUT of the app would strip the ref the SCIM PATCH just set. The PATCH
#      is the last writer in every run, and the next run re-reads and re-asserts it.
fdj=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps?filter=displayName%20eq%20%22estate-front-door%22&attributes=id,signonPolicy" 2>/dev/null | jq -c '.data.Resources[0] // empty')
fd_appid=$(printf '%s' "$fdj" | jq -r '.id // ""')
fpid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" 2>/dev/null | jq -r '.data.Resources[]? | select(.name == "Front Door Sign-On Policy") | .id' | head -1)
# The fact the passwordless rule depends on, read from the domain: every member of the pilot
# cohort holds an ENROLLED FIDO_AUTHENTICATOR. Initiated-but-never-finished ceremonies do not
# count -- the drill account held twelve INITIATED and no ENROLLED device (read 2026-10-12), and
# a passwordless rule over a member with no passkey is not a passkey prompt: measured 13:21Z, that
# member signed in with its password and never saw a second factor. Echoes "1" when every member
# is ready, else "0 <the members still waiting>". Reads only, and the one place this is decided:
# the skip below and the write further down both ask it, so they cannot disagree.
pl_group="estate-passwordless-pilots"
# Face ID ALONE (#5858) is a sign-on rule that knows HOW the user signed in, not a factor value.
# This domain's rules only ever return authenticationFactor IDP or IDP+2FA (probe, 2026-10-13); the
# "Passwordless" #5858 shipped is no value of its own, so it was taken and ignored, and no drill could
# ever measure a passkey-only value because none exists. IDP means "the identity provider that signed
# you in is enough"; the passkey is already an identity provider at this door (the IdP policy further
# down). So the rule is: signed in BY the FIDO authenticator -> ALLOW, IDP, at sequence 1; everyone
# else falls through to the second-factor rule. The condition's vocabulary is the domain's own,
# read back from a rule the founder made once in the Console (2026-10-13 01:27Z, condition
# 5f579060..): attributeName subject.authenticatedBy, operator in, attributeValue ["FIDO_AUTHENTICATOR"].
# Nobody without a passkey can match it, so it needs no cohort; it does need userVerification
# REQUIRED, or "signed in by the passkey" could be a bare tap rather than Face ID (pl_uv_value).
pk_rule="front door passkey sign-in"
pk_cond="front door signed in with a passkey"
pk_attr="subject.authenticatedBy"
pk_val='["FIDO_AUTHENTICATOR"]'
pl_cohort_ready() {
  local gid mus devf mu nf out un
  gid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups?filter=displayName%20eq%20%22$pl_group%22&attributes=id" 2>/dev/null | jq -r '.data.Resources[0].id // ""')
  [ -n "$gid" ] || { echo 0; return 0; }
  mus=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups/$gid?attributes=members" 2>/dev/null | jq -r '.data.members[]?.value' 2>/dev/null || true)
  [ -n "$mus" ] || { echo "0 (the cohort's members could not be read)"; return 0; }
  devf=$(mktemp); chmod 600 "$devf"
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Devices?count=200" 2>/dev/null > "$devf" || true
  # count=200 is a page, not the table (measured 2026-10-12: 21 devices, 12 of them the drill's
  # INITIATED ceremonies). A member whose passkey sits past the page would read as "not ready"; say
  # so rather than call it a missing passkey, and never wire the rule over a list that was cut off.
  if ! jq -e '(.data.totalResults // 0) <= ((.data.Resources // []) | length)' "$devf" >/dev/null 2>&1; then
    rm -f "$devf"; echo "0 (the device list was truncated or unreadable)"; return 0
  fi
  out=""
  for mu in $mus; do
    nf=$(jq -r --arg u "$mu" '[.data.Resources[]? | select(([.additionalAttributes[]? | select(.key == "user.value") | .value] | join("")) == $u) | select(([.authenticationFactors[]? | select(.type == "FIDO_AUTHENTICATOR" and .status == "ENROLLED")] | length) > 0)] | length' "$devf" 2>/dev/null)
    if [ "${nf:-0}" -gt 0 ] 2>/dev/null; then :; else
      un=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Users/$mu?attributes=userName" 2>/dev/null | jq -r '.data.userName // "?"')
      out="$out $un"
    fi
  done
  rm -f "$devf"
  if [ -n "$out" ]; then echo "0$out"; else echo 1; fi
}
# The passkey is only "Face ID" if the ceremony demands the biometric. userVerification is a
# DOMAIN-wide FIDO setting here, not a rule field (read 2026-10-12: authenticatorSelectionUserVerification
# PREFERRED, authenticatorSelectionAttachment BOTH), and with PREFERRED a passkey alone can finish on
# a bare tap or a security key -- "Face ID alone" would be "any tap alone". Echoes the live value.
pl_uv_value() {
  oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/AuthenticationFactorSettings/AuthenticationFactorSettings" 2>/dev/null \
    | jq -r '.data["urn:ietf:params:scim:schemas:oracle:idcs:extension:fido:AuthenticationFactorSettings"].authenticatorSelectionUserVerification // ""'
}
# Drift, not just absence: a policy that has lost the passkey rule (or carries it while
# userVerification is not REQUIRED) is not "already assigned", so the skip asks the domain the same
# question the write does.
pk_rid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r --arg n "$pk_rule" '.data.Resources[]? | select(.name == $n) | .id' | head -1)
pk_wired=false
if [ -n "$fpid" ] && [ -n "$pk_rid" ]; then
  pk_wired=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies/$fpid?attributes=rules" 2>/dev/null | jq -r --arg r "$pk_rid" '(.data.rules // []) | map(select(.value == $r and .sequence == 1)) | length > 0' 2>/dev/null)
fi
pk_uv=$(pl_uv_value)
pk_want=false; [ "$pk_uv" = REQUIRED ] && pk_want=true
pl_stale=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r '[.data.Resources[]? | select(.name == "front door offers passwordless sign-in")] | length')
pk_stray=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" 2>/dev/null | jq -r --arg fp "$fpid" --arg n "$pk_rule" '[.data.Resources[]? | select(.name == $n and .id != $fp)] | length')
if [ -n "$fpid" ] && [ "$(printf '%s' "$fdj" | jq -r '.signonPolicy.value // ""')" = "$fpid" ] && [ "$pk_wired" = "$pk_want" ] && [ "${pl_stale:-1}" = 0 ] && [ "${pk_stray:-1}" = 0 ]; then
  echo "ok      identity front door sign-on policy already assigned (a passkey sign-in is Face ID alone: $pk_wired; every other sign-in owes a second factor, #5818/#5858)"
else
  T3=$(mktemp -d); chmod 700 "$T3"; trap 'rm -rf "${T:-/dev/null}" "${T2:-/dev/null}" "${T3:-/dev/null}" 2>/dev/null || true' EXIT
  # Refuse to send a schema this domain does not have, by name. The domain answers an unknown URN
  # with "Schema is not recognized", which is how this lane's first governed apply went red on
  # 2026-10-12: a Group here is core SCIM (urn:ietf:params:scim:schemas:core:2.0:Group), not
  # oracle:idcs:Group -- and no plan can tell you which, only the domain can. Four reads, on the
  # path that is about to write, turn a blind refusal into a line that names the URN.
  for sch in urn:ietf:params:scim:schemas:core:2.0:Group \
             urn:ietf:params:scim:schemas:oracle:idcs:Condition \
             urn:ietf:params:scim:schemas:oracle:idcs:Rule \
             urn:ietf:params:scim:schemas:oracle:idcs:Policy; do
    sn=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Schemas/$sch" 2>/dev/null | jq -r '.data.name // ""' || true)
    [ -n "$sn" ] || { echo "FAIL    identity apply would send a schema this domain does not have: $sch"; exit 1; }
  done
  # condition: the same target.action="Login" vocabulary the domain's own Console condition uses
  fcid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions" 2>/dev/null | jq -r '.data.Resources[]? | select(.name == "front door sign-in") | .id' | head -1)
  printf '%s' '{"schemas":["urn:ietf:params:scim:schemas:oracle:idcs:Condition"],"name":"front door sign-in","attributeName":"target.action","operator":"eq","attributeValue":"\"Login\""}' > "$T3/c.json"
  if [ -n "$fcid" ]; then pc=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions/$fcid" --request-body "file://$T3/c.json" 2>&1)
  else pc=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions" --request-body "file://$T3/c.json" 2>&1); fi
  fcid=$(printf '%s' "$pc" | jq -r '.data.id // ""')
  [ -n "$fcid" ] || { echo "FAIL    identity front door condition refused: $(printf '%s' "$pc" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
  # rule: a second factor at every sign-in, enrolment not skippable, the Console rule's factors
  frid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r '.data.Resources[]? | select(.name == "front door requires a second factor") | .id' | head -1)
  jq -n --arg c "$fcid" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Rule"],name:"front door requires a second factor","policyType":{value:"SignOn"},"conditionGroup":{type:"Condition",value:$c},return:[{name:"effect",value:"ALLOW"},{name:"reAuthenticate",value:"false"},{name:"authenticationFactor",value:"IDP+2FA"},{name:"2FAFactors",value:"[\"TOTP\",\"PUSH\",\"FIDO_AUTHENTICATOR\",\"BYPASSCODE\"]"},{name:"allowUserToSkip2FAEnrolment",value:"false"},{name:"2FAFrequency",value:"ALWAYS"}]}' > "$T3/r.json"
  if [ -n "$frid" ]; then pr=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/$frid" --request-body "file://$T3/r.json" 2>&1)
  else pr=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" --request-body "file://$T3/r.json" 2>&1); fi
  frid=$(printf '%s' "$pr" | jq -r '.data.id // ""')
  [ -n "$frid" ] || { echo "FAIL    identity front door MFA rule refused: $(printf '%s' "$pr" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
  # The passwordless pilot cohort: the group the IdP policy below reads (pl_cohort_ready) before
  # it offers the passkey at the door. The drill account is its member; widening the rollout is
  # adding a member. The group condition's vocabulary is the domain's own (user.groups[*].value).
  drill_uid=$(tofu -chdir="$M" output -raw drill_user_id 2>/dev/null || true)
  [ -n "$drill_uid" ] || drill_uid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Users?filter=userName%20eq%20%22estate-drill%22&attributes=id" 2>/dev/null | jq -r '.data.Resources[0].id // ""')
  # Rules named "front door offers passwordless sign-in" carry "Passwordless", a value this domain
  # takes and ignores (top of this file). None is ever wired again: the policy PUT below stops
  # calling one, and this deletes every one the policy does not call, so a wired one goes next run.
  for old in $(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r '.data.Resources[]? | select(.name == "front door offers passwordless sign-in") | .id'); do
    if [ "$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies/$fpid?attributes=rules" 2>/dev/null | jq -r --arg r "$old" '((.data.rules // []) | map(.value) | index($r)) != null')" = true ]; then
      echo "WARN    identity \"Passwordless\" rule $old is still wired; this run's policy PUT unwires it and the next run deletes it"; continue
    fi
    oci raw-request --http-method DELETE --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/$old" >/dev/null 2>&1 \
      && echo "ok      identity removed \"Passwordless\" rule $old (a value this domain ignores)" \
      || echo "WARN    identity could not remove \"Passwordless\" rule $old"
  done
  # The Console's first draft of the passkey rule (2026-10-13 01:27Z) sat in a policy of its own,
  # inactive and assigned to nothing. This file owns the rule now and reuses it by name below; the
  # draft's policy goes. Only an INACTIVE one: an active policy of that name is somebody's door.
  for sp in $(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" 2>/dev/null | jq -r --arg fp "$fpid" --arg n "$pk_rule" '.data.Resources[]? | select(.name == $n and .id != $fp and .active != true) | .id'); do
    oci raw-request --http-method DELETE --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies/$sp" >/dev/null 2>&1 \
      && echo "ok      identity removed the Console's inactive draft policy $sp (its rule is wired into the front door policy instead)" \
      || echo "WARN    identity could not remove the Console's inactive draft policy $sp"
  done
  if [ -n "$drill_uid" ]; then
    gid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups?filter=displayName%20eq%20%22$pl_group%22&attributes=id,members" 2>/dev/null | jq -r '.data.Resources[0].id // ""')
    if [ -z "$gid" ]; then
      jq -n --arg g "$pl_group" --arg u "$drill_uid" '{schemas:["urn:ietf:params:scim:schemas:core:2.0:Group"],displayName:$g,description:"Face ID alone (passwordless) pilot cohort for the front door -- #5858",members:[{value:$u,type:"User"}]}' > "$T3/g.json"
      pg=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups" --request-body "file://$T3/g.json" 2>&1)
      gid=$(printf '%s' "$pg" | jq -r '.data.id // ""')
      [ -n "$gid" ] || { echo "FAIL    identity passwordless cohort group refused: $(printf '%s' "$pg" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
    else
      mem=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups/$gid?attributes=members" 2>/dev/null | jq -c '[.data.members[]? | {value,type}]')
      if ! printf '%s' "$mem" | jq -e --arg u "$drill_uid" 'any(.[]; .value == $u)' >/dev/null 2>&1; then
        jq -n --arg g "$pl_group" --argjson m "$mem" --arg u "$drill_uid" '{schemas:["urn:ietf:params:scim:schemas:core:2.0:Group"],displayName:$g,members:($m + [{value:$u,type:"User"}])}' > "$T3/g.json"
        pg=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Groups/$gid" --request-body "file://$T3/g.json" 2>&1)
        printf '%s' "$pg" | jq -e --arg u "$drill_uid" 'any(.data.members[]?; .value == $u)' >/dev/null 2>&1 || { echo "FAIL    identity passwordless cohort membership refused: $(printf '%s' "$pg" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
      fi
    fi
  else
    echo "BLIND   identity passwordless cohort: the drill account could not be read, so the cohort group was not maintained"
  fi
  # Face ID ALONE: the passkey rule, in the vocabulary at the top of this file, read back before it is wired.
  if [ "$pk_want" = true ]; then
    pkcid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions" 2>/dev/null | jq -r --arg n "$pk_cond" --arg a "$pk_attr" --arg v "$pk_val" '.data.Resources[]? | select(.name == $n or (.attributeName == $a and .attributeValue == $v)) | .id' | head -1)
    jq -n --arg n "$pk_cond" --arg a "$pk_attr" --arg v "$pk_val" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Condition"],name:$n,attributeName:$a,operator:"in",attributeValue:$v}' > "$T3/pkc.json"
    if [ -n "$pkcid" ]; then pc=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions/$pkcid" --request-body "file://$T3/pkc.json" 2>&1)
    else pc=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions" --request-body "file://$T3/pkc.json" 2>&1); fi
    pkcid=$(printf '%s' "$pc" | jq -r '.data.id // ""')
    [ -n "$pkcid" ] || { echo "FAIL    identity passkey sign-in condition refused: $(printf '%s' "$pc" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
    jq -n --arg n "$pk_rule" --arg c "$pkcid" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Rule"],name:$n,"policyType":{value:"SignOn"},"conditionGroup":{type:"Condition",value:$c},return:[{name:"effect",value:"ALLOW"},{name:"reAuthenticate",value:"false"},{name:"authenticationFactor",value:"IDP"}]}' > "$T3/pk.json"
    pk_rid=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r --arg n "$pk_rule" '.data.Resources[]? | select(.name == $n) | .id' | head -1)
    if [ -n "$pk_rid" ]; then
      pr=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/$pk_rid" --request-body "file://$T3/pk.json" 2>&1)
    else pr=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" --request-body "file://$T3/pk.json" 2>&1); fi
    pk_rid=$(printf '%s' "$pr" | jq -r '.data.id // ""')
    [ -n "$pk_rid" ] || { echo "FAIL    identity passkey sign-in rule refused: $(printf '%s' "$pr" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
    # The domain takes any value without complaint, so what it holds is read back, not assumed.
    pk_rb=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Conditions/$pkcid" 2>/dev/null | jq -r '.data | "\(.attributeName) \(.operator) \(.attributeValue)"')
    pk_rf=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/$pk_rid" 2>/dev/null | jq -r '.data | "\(.conditionGroup.value) \([.return[]? | select(.name == "authenticationFactor") | .value] | join(","))"')
    [ "$pk_rb" = "$pk_attr in $pk_val" ] && [ "$pk_rf" = "$pkcid IDP" ] || { echo "FAIL    identity passkey sign-in rule reads back as [$pk_rf] over [$pk_rb], not [$pkcid IDP] over [$pk_attr in $pk_val]; the policy was not given it"; pk_rid=""; exit 1; }
  else
    pk_rid=""
    echo "WAIT    identity passkey sign-in: the domain's passkey userVerification is ${pk_uv:-unreadable}, not REQUIRED, so a passkey sign-in could be a bare tap rather than Face ID; the policy keeps the second-factor rule alone (#5858)"
  fi
  # policy: active, SignOn, the passkey rule first (when there is one), the second factor after it
  if [ -n "$pk_rid" ]; then pl_rules=$(jq -n --arg pl "$pk_rid" --arg mfa "$frid" '[{value:$pl,sequence:1},{value:$mfa,sequence:2}]')
  else pl_rules=$(jq -n --arg mfa "$frid" '[{value:$mfa,sequence:1}]'); fi
  jq -n --argjson r "$pl_rules" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Policy"],name:"Front Door Sign-On Policy",description:"assigned to estate-front-door by bin/idp-identity-apply (#5818); a passkey sign-in is Face ID alone (#5858)",active:true,"policyType":{value:"SignOn"},rules:$r}' > "$T3/p.json"
  if [ -n "$fpid" ]; then pp=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies/$fpid" --request-body "file://$T3/p.json" 2>&1)
  else pp=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" --request-body "file://$T3/p.json" 2>&1); fi
  fpid=$(printf '%s' "$pp" | jq -r '.data.id // ""')
  [ -n "$fpid" ] || { echo "FAIL    identity front door policy refused: $(printf '%s' "$pp" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
  # assignment: the app's signonPolicy ref, read back
  jq -n --arg p "$fpid" '{schemas:["urn:ietf:params:scim:api:messages:2.0:PatchOp"],Operations:[{op:"replace",path:"signonPolicy",value:{value:$p}}]}' > "$T3/a.json"
  pa=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps/$fd_appid" --request-body "file://$T3/a.json" 2>&1)
  rb=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps?filter=displayName%20eq%20%22estate-front-door%22&attributes=signonPolicy" 2>/dev/null | jq -r '.data.Resources[0].signonPolicy.value // ""')
  if [ "$rb" = "$fpid" ]; then
    echo "ok      identity front door sign-on policy assigned (second factor at every sign-in, #5818)"
    if [ -n "$pk_rid" ]; then
      echo "ok      identity front door: a passkey sign-in is Face ID alone ($pk_attr in $pk_val -> IDP, rule sequence 1); every other sign-in still owes a second factor (#5858)"
    fi
  else
    echo "FAIL    identity front door app signonPolicy PATCH refused: $(printf '%s' "$pa" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1
  fi
fi

# Face ID FIRST (#5858). Which sign-in methods the door offers is not a sign-on rule at all: it is the
# IDENTITY-PROVIDER policy, read before any sign-on rule. Read 2026-10-12: the domain held only
# DefaultIDPPolicy, whose one rule returns LocalIDPs ["UserNamePassword"], and the local IdP
# FIDO_AUTHENTICATOR was enabled=false -- so no sign-on factor value could ever have put the passkey
# first, which is the whole of why "Passwordless" was inert at the door. Oracle's passwordless
# recipe is: enable the FIDO IdP, then an IdP rule assigning "Fido Authenticator", scoped to a group,
# at priority 1. Its recipe leaves Username-Password OUT of that rule; this file keeps it IN, for two
# reasons: the cohort's member is the drill account, whose hourly walk types the password
# (bin/idp-login-drill, PASS_SELECTORS) and would go red on a door with no password field; and a
# passkey-only member who loses the phone has no way back in. The password path must keep the second
# factor: it does, because only a sign-in authenticated BY the passkey matches the IDP rule above. So: the IdP on; one IdP policy owned
# by this file and assigned to the front door alone (App.idpPolicy {value}), holding ONE rule:
# everyone -> a copy of DefaultIDPRule's own condition and return, read live, with FIDO_AUTHENTICATOR
# added to its LocalIDPs only while pl_cohort_ready and userVerification=REQUIRED -- the same gate as
# the sign-on rule above. The copy is read back and must equal what was sent before the policy is
# assigned; a mismatch fails here rather than reaching the door.
# Not scoped to the cohort, because a cohort-scoped IdP rule can never fire. Measured 2026-10-13
# 00:06Z, 47 min after CI wired a rule 1 for the cohort (user.groups[*].value coany, the same shape
# as the console's own OciConsoleGroupCondition) with estate-drill a member: the door's loginCtx
# carried userNameRequired=false, i.e. the domain picks the IdPs before it knows the user, the group
# condition never matches, and every visitor -- the cohort too -- got rule 2's password-only form.
# Offering the passkey to everyone loosens nothing: who must also give a second factor is decided by
# the sign-on policy, after the user is known, where the cohort condition does evaluate. A visitor
# with no passkey who presses it gets a refused ceremony and the password beside it.
fido_on=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/IdentityProviders/FIDO_AUTHENTICATOR?attributes=enabled" 2>/dev/null | jq -r '.data.enabled // ""')
if [ "$fido_on" != true ]; then
  T4=$(mktemp -d); chmod 700 "$T4"; trap 'rm -rf "${T:-/dev/null}" "${T2:-/dev/null}" "${T3:-/dev/null}" "${T4:-/dev/null}" 2>/dev/null || true' EXIT
  printf '%s' '{"schemas":["urn:ietf:params:scim:api:messages:2.0:PatchOp"],"Operations":[{"op":"replace","path":"enabled","value":true}]}' > "$T4/e.json"
  pe=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/IdentityProviders/FIDO_AUTHENTICATOR" --request-body "file://$T4/e.json" 2>&1)
  fido_on=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/IdentityProviders/FIDO_AUTHENTICATOR?attributes=enabled" 2>/dev/null | jq -r '.data.enabled // ""')
  [ "$fido_on" = true ] || { echo "FAIL    identity FIDO_AUTHENTICATOR identity provider enable refused: $(printf '%s' "$pe" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
  echo "ok      identity FIDO_AUTHENTICATOR identity provider enabled (the domain default policy still offers it to nobody)"
else echo "ok      identity FIDO_AUTHENTICATOR identity provider already enabled"; fi
if [ -n "$fd_appid" ]; then
  T4=${T4:-$(mktemp -d)}; chmod 700 "$T4"; trap 'rm -rf "${T:-/dev/null}" "${T2:-/dev/null}" "${T3:-/dev/null}" "${T4:-/dev/null}" 2>/dev/null || true' EXIT
  rule_id() { oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules" 2>/dev/null | jq -r --arg n "$1" '.data.Resources[]? | select(.name == $n) | .id' | head -1; }
  put_or_post() { # collection, id-or-empty, body file -> echoes the id, or empty with the refusal on stderr
    local r; if [ -n "$2" ]; then r=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/$1/$2" --request-body "file://$3" 2>&1)
    else r=$(oci raw-request --http-method POST --target-uri "$DOMAIN_BASE_URL/admin/v1/$1" --request-body "file://$3" 2>&1); fi
    printf '%s' "$r" | jq -r '.data.id // ""' 2>/dev/null || true
    printf '%s' "$r" | jq -e '.data.id' >/dev/null 2>&1 || printf '%s' "$r" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200 >&2
  }
  dflt=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/DefaultIDPRule" 2>/dev/null | jq -c '.data | {condition, cg: .conditionGroup.value, ret: ([.return[]? | {name, value}] | sort_by(.name))}')
  [ -n "$dflt" ] && [ "$(printf '%s' "$dflt" | jq -r '.ret | length')" -gt 0 ] || { echo "FAIL    identity DefaultIDPRule unreadable, so the front door's identity-provider policy was not touched"; exit 1; }
  ip_cohort=false
  if [ "$(pl_cohort_ready)" = 1 ] && [ "$(pl_uv_value)" = REQUIRED ]; then
    ip_cohort=true
  else
    echo "WAIT    identity front door passkey offer: the pilot cohort is not every-member-ENROLLED with userVerification=REQUIRED, so the passkey stays off the door -- it offers the domain default to everyone"
  fi
  # The rule as it must read back: the default, plus the passkey after the password when the gate is open.
  want=$(printf '%s' "$dflt" | jq -c --argjson on "$ip_cohort" 'if $on then .ret |= map(if .name == "LocalIDPs" then .value = ((.value | fromjson) as $l | if ($l | index("FIDO_AUTHENTICATOR")) then $l else $l + ["FIDO_AUTHENTICATOR"] end | tojson) else . end) else . end')
  jq -n --argjson d "$want" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Rule"],name:"front door identity providers (everyone)",policyType:{value:"IdentityProvider"},condition:$d.condition,conditionGroup:{type:"Condition",value:$d.cg},return:$d.ret}' > "$T4/ia.json"
  iaid=$(put_or_post Rules "$(rule_id "front door identity providers (everyone)")" "$T4/ia.json" 2>"$T4/err") \
    && [ -n "$iaid" ] || { echo "FAIL    identity front door everyone IdP rule refused: $(cat "$T4/err")"; exit 1; }
  ia_rb=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Rules/$iaid" 2>/dev/null | jq -c '.data | {condition, cg: .conditionGroup.value, ret: ([.return[]? | {name, value}] | sort_by(.name))}')
  [ "$ia_rb" = "$want" ] || { echo "FAIL    identity front door everyone IdP rule reads back as $ia_rb, not $want; the policy was not assigned"; exit 1; }
  ip_rules=$(jq -n --arg a "$iaid" '[{value:$a,sequence:1}]')
  ipol=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Policies" 2>/dev/null | jq -r '.data.Resources[]? | select(.name == "Front Door Identity Provider Policy") | .id' | head -1)
  jq -n --argjson r "$ip_rules" '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:Policy"],name:"Front Door Identity Provider Policy",description:"assigned to estate-front-door by bin/idp-identity-apply (#5858): the domain default, with the passkey offered beside the password once the pilot cohort is enrolled",active:true,policyType:{value:"IdentityProvider"},rules:$r}' > "$T4/ipp.json"
  ipol=$(put_or_post Policies "$ipol" "$T4/ipp.json" 2>"$T4/err") && [ -n "$ipol" ] || { echo "FAIL    identity front door IdP policy refused: $(cat "$T4/err")"; exit 1; }
  jq -n --arg p "$ipol" '{schemas:["urn:ietf:params:scim:api:messages:2.0:PatchOp"],Operations:[{op:"replace",path:"idpPolicy",value:{value:$p}}]}' > "$T4/ipa.json"
  pa=$(oci raw-request --http-method PATCH --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps/$fd_appid" --request-body "file://$T4/ipa.json" 2>&1)
  rb=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Apps/$fd_appid?attributes=idpPolicy" 2>/dev/null | jq -r '.data.idpPolicy.value // ""')
  [ "$rb" = "$ipol" ] || { echo "FAIL    identity front door app idpPolicy PATCH refused: $(printf '%s' "$pa" | jq -r '.detail // .data.detail // .' 2>/dev/null | head -c 200)"; exit 1; }
  if [ "$ip_cohort" = true ]; then echo "ok      identity front door IdP policy assigned: passkey offered beside the password to everyone at the door; the sign-on policy decides who still owes a second factor (#5858)"
  else echo "ok      identity front door IdP policy assigned: the domain default for everyone (#5858)"; fi
else
  echo "BLIND   identity front door app not found, so no identity-provider policy was assigned"
fi

# The domain sets mustChange=true on the password Terraform supplies at create (the flag is read-only on
# the user and no password policy switches it off), so the drill user's live password is set here once
# through the admin UserPasswordChanger, which clears the flag. Idempotent: nothing happens while
# mustChange is false. The vault copy (front-door-drill-password) is the one the drill signs in with.
if [ "${1:-plan}" = apply ]; then
  uid=$(tofu -chdir="$M" output -raw drill_user_id 2>/dev/null || true)
  if [ -n "$uid" ]; then
    mc=$(oci raw-request --http-method GET --target-uri "$DOMAIN_BASE_URL/admin/v1/Users/$uid?attributes=urn:ietf:params:scim:schemas:oracle:idcs:extension:passwordState:User:mustChange" 2>/dev/null \
         | jq -r '.data["urn:ietf:params:scim:schemas:oracle:idcs:extension:passwordState:User"].mustChange // false')
    if [ "$mc" = true ]; then
      T=${T:-$(mktemp -d)}
      jq -n --arg n "$(tofu -chdir="$M" output -raw drill_live_password)" \
        '{schemas:["urn:ietf:params:scim:schemas:oracle:idcs:UserPasswordChanger"],password:$n,bypassNotification:true}' > "$T/pw.json"
      cr=$(oci raw-request --http-method PUT --target-uri "$DOMAIN_BASE_URL/admin/v1/UserPasswordChanger/$uid" --request-body "file://$T/pw.json" 2>&1)
      rm -f "$T/pw.json"
      if printf '%s' "$cr" | jq -e '.status == "200 OK"' >/dev/null 2>&1; then
        echo "ok      drill user password settled (mustChange cleared; the vault copy is the live one)"
      else echo "FAIL    drill user password change refused: $(printf '%s' "$cr" | jq -r '.data.detail // .data // .' 2>/dev/null | head -c 200)"; exit 1; fi
    else echo "ok      drill user password already settled (mustChange=false)"; fi
  fi
fi
