#!/usr/bin/env python3
"""estate-supervisor -- one warning per violation class, then the keys are taken away.

    estate-supervisor --class write-without-claim --session <sid> [--provider minimax]
                       [--detail "..."] [--pid 1234] [--cwd /path] [--model x]

What it does, in the founder's order (2026-10-29, graduated 2026-11-08):

    first violation of a report class    warn, with a countdown (one correction left)
    second violation of a report class   warn again, last correction
    next violation                       terminate the session, lock it (no write, no shell,
                                         no push), and relaunch it with the instruction to
                                         plug the hole first and prove it

    --clear --session S                  reset the countdown after a green receipt
    --unlock --session S --proof "CMD"  run CMD; if it exits 0, lift the lockdown and clear

Mutation and security classes keep the short ladder: one warning, then removal.
Path is clear: every runtime (pi, Claude, Codex) calls this same binary.

Exit 0 on a warning, 3 when the session was terminated and locked, 1 on a bad call.
HARNESS AGNOSTIC: it kills a pid and relaunches `pi --print`; the same call works for any
runtime that passes its own pid.
"""

from __future__ import annotations

import argparse
import json
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))


def _governance_path() -> str:
    """Where the governance package lives: this checkout, or the estate's runtime tree."""

    repo_root = os.path.dirname(HERE)
    for cand in (
        os.environ.get("ESTATE_GOVERNANCE_TREE", ""),
        os.path.join(repo_root, "platform", "estate"),
        os.path.join(repo_root, "runtime", "idp", "platform", "estate"),
        os.path.expanduser("~/.estate/runtime/idp/platform/estate"),
    ):
        if cand and os.path.isfile(os.path.join(cand, "governance", "registry.py")):
            return cand
    raise SystemExit("estate: the governance package was not found (set ESTATE_GOVERNANCE_TREE)")


sys.path.insert(0, _governance_path())

from governance import ledger, supervisor  # noqa: E402


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--class", dest="cls", default="")
    ap.add_argument("--session", required=True)
    ap.add_argument("--status", action="store_true", help="report the session's lock state and exit")
    ap.add_argument("--provider", default="")
    ap.add_argument("--detail", default="")
    ap.add_argument("--pid", type=int, default=None)
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--model", default="")
    ap.add_argument("--source", default="")
    ap.add_argument("--no-relaunch", action="store_true")
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--clear",
        action="store_true",
        help="clear this session's strikes (green receipt resets the countdown)",
    )
    ap.add_argument(
        "--unlock",
        action="store_true",
        help="run the proof and, if it exits 0, lift the lockdown",
    )
    ap.add_argument(
        "--proof",
        default="",
        help="the proof command to run with --unlock",
    )
    args = ap.parse_args(argv[1:])

    if args.clear:
        removed = ledger.clear_violations(args.session)
        print(
            json.dumps({"session": args.session, "cleared": removed, "ok": True})
            if args.json
            else f"cleared {removed} violation record(s) for session {args.session}"
        )
        return 0

    if args.unlock:
        proof = args.proof or ledger.get_session_state(args.session).get("proof", "")
        if not proof:
            print(
                "estate-supervisor: --unlock needs --proof <command> (none recorded)",
                file=sys.stderr,
            )
            return 1
        import subprocess as _sp

        run = _sp.run(  # noqa: S603 - the proof is data, subprocess.run is correct here
            proof, shell=True, capture_output=True, text=True
        )
        out = {
            "session": args.session,
            "unlocked": run.returncode == 0,
            "proof": proof,
            "exit": run.returncode,
        }
        tail = (run.stdout or run.stderr or "").strip().splitlines()
        if tail:
            out["line"] = tail[-1]
        if run.returncode == 0:
            ledger.unlock_session(
                args.session, proof_result=f"exit 0"
            )
            ledger.clear_violations(args.session)
        print(json.dumps(out, indent=2, default=str))
        return 0 if run.returncode == 0 else 3

    if args.status:
        state = ledger.get_session_state(args.session)
        locked = ledger.is_locked(args.session)
        out = {
            "session": args.session,
            "locked": locked,
            "status": state.get("status", "unknown"),
            "proof": state.get("proof", ""),
            "class": state.get("violation_class") or state.get("class", ""),
            "instruction": state.get("instruction", ""),
        }
        if args.json:
            print(json.dumps(out, indent=2, default=str))
        else:
            print(
                f"session: {out['session']}  locked: {out['locked']}  "
                f"status: {out['status']}  proof: {out['proof'] or '-'}"
            )
        return 3 if out["locked"] else 0

    if not args.cls:
        print("estate-supervisor: --class is required (or --status)", file=sys.stderr)
        return 1

    verdict = supervisor.grade(
        cls=args.cls,
        session=args.session,
        provider=args.provider,
        detail=args.detail,
        source=args.source,
        pid=args.pid,
        cwd=args.cwd,
        model=args.model,
    )

    if args.json:
        print(json.dumps(verdict, indent=2, default=str))
    else:
        print(
            f"class: {args.cls}  session: {args.session}  "
            f"count: {int(verdict.get('prior', 0)) + 1}"
        )
        print(f"action: {verdict.get('decision')}")
        print(f"proof: {verdict.get('proof')}")
        print(f"message: {verdict.get('message', '')}")
        if verdict.get("locked"):
            print("locked: yes (no write, no shell, no push until the proof is green)")
        if verdict.get("instruction"):
            print("--- relaunch instruction ---")
            print(verdict["instruction"])
        if verdict.get("relaunch"):
            print(
                "relaunched: "
                + json.dumps(verdict["relaunch"].get("command", []), default=str)
            )

    state = ledger.get_session_state(args.session)
    return 3 if state.get("locked") else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
