#!/usr/bin/env python3
"""An ExternalSecret that cannot sync is a founder action, or it is a silent hole.

Incident: 2026-09-13, cyrus. Rule: externalsecret-blockers-are-loud (rules.yaml).

THE INCIDENT. `cyrus` sat `HealthCheckFailed` for days, and the reason was buried
three layers down:

    cluster:  cyrus   Ready=Unknown  "Reconciliation in progress"
    flux:     "health check failed after 10m: timeout waiting for:
               [ExternalSecret/cyrus/cyrus-linear-oauth status: 'InProgress']"
    ESO:      "Ready=False / SecretSyncedError -- could not get secret data from provider"

The bottom line is not a defect anyone can fix in code. The vault entries
`cyrus-linear-client-id` and `cyrus-linear-client-secret` are born in a BROWSER --
Linear publishes no API to create an OAuth application -- so the pair can only be
typed by a person, and until it is, one row holds and the reason is invisible in
the top-level status.

THE RULE THIS GATE SERVES. R47: a founder blocker is loud and one action. A
blocker that reads as "Reconciliation in progress" is neither. Measured
2026-09-13: 5 of 138 ExternalSecrets cannot sync, every one of them waiting on a
value only a person can produce:

    backstage/verdict-key-wall          verdict-hmac-key
    concierge/human-card-key            CONCIERGE_CARD_KEY
    cyrus/cyrus-linear-oauth            cyrus-linear-client-id, cyrus-linear-client-secret
    hermes-agent/human-telegram         TELEGRAM_HERMES_BOT_TOKEN
    notify/human-apprise-telegram       TELEGRAM_ALERTS_CHAT_ID, TELEGRAM_ALERTS_BOT_TOKEN

WHAT IT DOES NOT DO. It does not fail on them. A missing vault entry is a person's
step and the estate cannot take it; refusing the tree for it would be a guard
refusing work it has no power to unblock (R38) -- and a gate red from day one gets
switched off. It NAMES each one with the vault key it needs, which is the line the
founder register is built from.

    bin/idp-externalsecret-blockers            # the human list
    bin/idp-externalsecret-blockers --json
    bin/idp-externalsecret-blockers --fail-on-blocker   # once the count is zero
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

# The reasons External Secrets Operator reports for "the value is not there yet".
# Anything else is a different failure and this gate must not swallow it: a store
# that is unreachable, a selector that matches nothing and a vault that refuses
# auth all read differently and need different answers.
MISSING_IN_PROVIDER = "SecretSyncedError"


def _items(args: list[str], timeout: int = 90) -> list[dict]:
    try:
        r = subprocess.run(
            ["kubectl", *args], capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.SubprocessError) as exc:
        print(
            f"BLIND externalsecret-blockers: kubectl could not run: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(2) from exc
    if r.returncode != 0:
        print(
            f"BLIND externalsecret-blockers: {' '.join(args)} exited {r.returncode}: "
            f"{(r.stderr or '')[:300]}",
            file=sys.stderr,
        )
        raise SystemExit(2)
    try:
        doc = json.loads(r.stdout or "{}")
    except ValueError as exc:
        print(
            f"BLIND externalsecret-blockers: no JSON from kubectl: {exc}",
            file=sys.stderr,
        )
        raise SystemExit(2) from exc
    items = doc.get("items")
    return items if isinstance(items, list) else []


def blockers(externalsecrets: list[dict]) -> dict:
    """Every ExternalSecret that cannot sync, with the vault key each one needs.

    A `Ready` condition that is not `True` is the trigger. The vault keys come
    from the spec, because they are the actionable part: "the vault has no
    `cyrus-linear-client-id`" is a step a person can take, and "the ExternalSecret
    is InProgress" is not.
    """
    out = []
    for es in externalsecrets:
        meta = es.get("metadata") or {}
        ns = meta.get("namespace", "")
        name = meta.get("name", "")
        for cond in (es.get("status") or {}).get("conditions") or []:
            if cond.get("type") != "Ready" or cond.get("status") == "True":
                continue
            spec = es.get("spec") or {}
            keys = [
                (d.get("remoteRef") or {}).get("key")
                for d in (spec.get("data") or []) + (spec.get("dataFrom") or [])
            ]
            keys = [k for k in keys if k]
            store = (spec.get("secretStoreRef") or {}).get("name", "")
            out.append(
                {
                    "externalsecret": f"{ns}/{name}",
                    "reason": cond.get("reason"),
                    "message": (cond.get("message") or "")[:200],
                    "vault_keys": sorted(set(keys)),
                    "store": store,
                    # A missing entry in the provider is a person's step. Anything
                    # else may be an estate defect, and the two must not be
                    # reported as the same thing.
                    "needs_a_person": cond.get("reason") == MISSING_IN_PROVIDER,
                }
            )
            break
    return {
        "summary": {
            "externalsecrets": len(externalsecrets),
            "blocked": len(out),
            "waiting_on_a_person": sum(1 for b in out if b["needs_a_person"]),
            "other_failures": sum(1 for b in out if not b["needs_a_person"]),
        },
        "blockers": out,
    }


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="idp-externalsecret-blockers")
    ap.add_argument("--json", action="store_true")
    ap.add_argument(
        "--from",
        dest="source",
        default="",
        help="read a `kubectl get externalsecrets -A -o json` document instead of the cluster",
    )
    ap.add_argument(
        "--fail-on-blocker",
        action="store_true",
        help="exit 1 when anything is blocked. Off by default: the estate has 5, and a gate "
        "red from day one gets switched off (R38).",
    )
    args = ap.parse_args(argv)

    if args.source:
        try:
            doc = json.loads(Path(args.source).read_text())
        except (OSError, ValueError) as exc:
            print(
                f"BLIND externalsecret-blockers: {args.source} is unreadable: {exc}",
                file=sys.stderr,
            )
            raise SystemExit(2) from exc
        items = doc.get("items")
        payload = blockers(items if isinstance(items, list) else [])
    else:
        payload = blockers(_items(["get", "externalsecrets", "-A", "-o", "json"]))

    if args.json:
        print(json.dumps(payload, indent=2))
        return 0

    s = payload["summary"]
    print(
        f"ok    secret-blockers  {s['externalsecrets']} ExternalSecret(s); {s['blocked']} blocked, "
        f"{s['waiting_on_a_person']} waiting on a value only a person can produce, "
        f"{s['other_failures']} other"
    )
    for b in payload["blockers"]:
        who = "FOUNDER ACTION" if b["needs_a_person"] else "ESTATE"
        keys = ", ".join(b["vault_keys"]) or "(no remoteRef key)"
        print(
            f"      {who}: {b['externalsecret']} needs {keys} in {b['store'] or 'the store'}"
        )

    if args.fail_on_blocker and s["blocked"]:
        print(f"FAIL  secret-blockers  {s['blocked']} ExternalSecret(s) cannot sync")
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
