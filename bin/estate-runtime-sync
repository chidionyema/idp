#!/usr/bin/env python3
"""Keep the laptop estate running `main`: one tree, converged every five minutes, rolled back if it breaks.

WHY. 2026-09-27 /fleet ran whatever branch ~/Documents/code/idp happened to be on. A reinstall from
that branch dropped the `voice` lane (voice dead 14:02-15:54), the backend lacked main's /voice/intent
(404, voice->intent off), and ~/.estate/intents was missing 16 of main's intents while three were stale,
so the few intents voice could name failed to run. Every one of those was the runtime following a
working checkout instead of main.

THE TREE. ~/.estate/runtime/idp: its own partial clone of origin (not a worktree -- a worktree's
objects live under ~/Documents, which launchd cannot read, TCC), sparse without packages/ and
rescued_patches2/, detached at origin/main. Nobody works in it; this job is its only writer.

EACH RUN
  1. fetch origin main; if it moved, check it out and note which paths changed
  2. stage from the tree: platform/estate/intents and libexec into ~/.estate (added or updated, never
     deleted -- an extra is reported), and the launchers voice needs into ~/.estate/bin
  3. voice-router changed -> rebuild ~/.estate/voice-router/voice-router and restart it; wait for /readyz
  4. the fleetview backend's code changed -> restart it; wait for /healthz
  4a. estate memory: bin/estate-memory-install from the tree, which writes only what drifted (the
     brief, the bridge, the enforcement hooks, each runtime's config); a refusal is reported
  4b. the laptop router's config (llm/config.yaml) or modules (bin/litellm-local's MODULES) differ
     from what it runs -> copy them in, restart it, and keep them only if the router comes back AND
     voice's /readyz is at least as ready as before; otherwise put the previous bytes back. Its
     launcher and keys are never touched.
  4c. the executor daemon -- the agent's command door -- is restarted when its bytes change (the
     daemon, the plugin it imports, the plan module, the intent executor, the pi adapters) and is
     then asked, on its own UNIX socket, whether it came back. It was never restarted here before
     2026-10-30, so a landed fix waited for a human to kickstart it.
  4d. the installed pi extensions are refreshed from main's bytes, file by file, and only for an
     extension the host already has. Drift that is NOT acted on -- an extension on main that is not
     installed here, an installed extension that is not on main -- is reported, because installing
     a new extension changes what pi does and is the founder's call.
  5. a restarted service that does not come back -> check out the previous commit, restart again,
     and alert (~/.estate/alerts/inbox.jsonl + a notification). Main never takes /fleet down; that
     commit is remembered in ~/.estate/runtime-sync.bad and not tried again until main moves on.
  6. the state of the convergence is written to ~/.estate/runtime-sync.status.json and can be asked
     for with `bin/estate-runtime-sync --status`: is the tree on main, did the last run succeed,
     and was this job skipped instead of run.
One line per run in ~/.estate/runtime-sync.log.

THE GIT CALLS ARE ISOLATED from the founder's global and system config (GIT_CONFIG_GLOBAL and
GIT_CONFIG_SYSTEM point at /dev/null). The global config rewrites ssh GitHub URLs to https, so a
sync that inherited it fetched over a transport it was not written for, invisibly. The founder's
config is never edited; the sync's own calls simply do not read it.
"""

import filecmp
import json
import os
import re
import shutil
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
STATE = HOME / ".estate"
TREE = Path(os.environ.get("ESTATE_RUNTIME_TREE") or STATE / "runtime/idp")
# THE REMOTE IS NORMALISED, ALWAYS. The founder's global git config rewrites ssh GitHub
# URLs to https (url.https://github.com/.insteadof, measured 2026-10-30), so a sync that
# inherits it fetches over a different transport than the one it was written for, with a
# credential it may not have -- and the rewrite is invisible in the sync's own output. The
# ssh form names the port explicitly (ssh://git@github.com:443/...): the founder's
# ~/.ssh/config already points github.com at ssh.github.com:443, and :22 is not open.
SSH_REMOTE = "ssh://git@github.com:443/chidionyema/idp.git"


def normalise_remote(url: str) -> str:
    """The canonical ssh form of a GitHub remote. An https remote is left alone."""
    m = re.match(r"^git@github\.com:(?P<p>.+)$", url)
    if m:
        return f"ssh://git@github.com:443/{m.group('p')}"
    m = re.match(r"^ssh://git@github\.com/(?P<p>.+)$", url)
    if m:
        return f"ssh://git@github.com:443/{m.group('p')}"
    return url


REMOTE = normalise_remote(os.environ.get("ESTATE_RUNTIME_REMOTE") or SSH_REMOTE)
# Git isolation: the sync's own git calls never read the founder's global or system config.
# The rewrite above lives in the global config, so this is what keeps it from applying.
GIT_ISOLATION = {
    "GIT_CONFIG_GLOBAL": "/dev/null",
    "GIT_CONFIG_SYSTEM": "/dev/null",
    "GIT_CONFIG_NOSYSTEM": "1",
}


def git_env(extra=None) -> dict:
    """The environment every git call of this script runs in: isolated from the founder's
    config, no prompts, ssh that cannot hang on a password."""
    env = dict(os.environ)
    env.update(GIT_ISOLATION)
    env["GIT_TERMINAL_PROMPT"] = "0"
    env.setdefault("GIT_SSH_COMMAND", "ssh -o BatchMode=yes -o ConnectTimeout=20")
    if extra:
        env.update(extra)
    return env
# The live board's data; the tree links to it, never copies it.
DATA = HOME / "Documents/code/idp/catalog"
LOG, INBOX = STATE / "runtime-sync.log", STATE / "alerts/inbox.jsonl"
# A main commit that broke a service; not retried until main moves on.
BAD = STATE / "runtime-sync.bad"
# launchd's PATH is /usr/bin:/bin, so `which` alone misses every user install. 2026-10-08: go lived only
# in ~/.local/bin, the fallback did not exist, and every tick died in the voice build before the router.
GO = next(
    (
        str(g)
        for g in (
            shutil.which("go"),
            HOME / ".local/bin/go",
            "/opt/homebrew/bin/go",
            "/usr/local/go/bin/go",
            "/usr/local/bin/go",
            HOME / ".cache/estate-tools/go/bin/go",
        )
        if g and os.access(g, os.X_OK)
    ),
    "go",
)
UID = os.getuid()
SPARSE = ["/*", "!/packages/", "!/rescued_patches2/"]
LAUNCHERS = [
    "fleetview-launchd",
    "voice-router-launchd",
    "voice-watch",
    "estate-runtime-sync",
    # The launchd wrapper that runs a gated job only if the machine can take it. It was
    # hand-installed by the fleet conversion, so the estate could not see what it did:
    # a skip became exit 0, launchd reported success, and the job had not run at all
    # (measured 2026-10-30: 83 runs reported green, every one of them skipped). The
    # wrapper is in the repository now, so the sync stages it and the skip it records
    # names the command it refused.
    "load-gate-and-run",
    "fleetview-frontend-launchd",
    # The progress writer is a command the surfaces call, not a daemon: it lives in ~/.estate/bin
    # so `estate-progress` and the estate.progress intent find the SAME bytes main carries,
    # whichever checkout happens to be on a branch on this laptop (2026-10-29: the intent's
    # default root was a work branch and the writer was nowhere on the host).
    "estate-progress",
    # The founder's governance launchers (2026-10-29). They live in ~/.estate/bin so every
    # runtime -- pi, Claude Code, Codex -- calls the SAME bytes main carries: the policy is
    # shared, the adapters are thin.
    "estate-law-gate",
    "estate-spec-status",
    "estate-supervisor",
    "estate-freeze",
    "estate-founder-intake",
    "estate-state-page",
    "estate-provider-renewal",
    "estate-receipt",
    "estate-executor-permission",
]


def launchers() -> list[str]:
    # Plus every bin/ file a launchd template runs from ~/.estate/bin. The hand list alone left
    # idp-disk-watch installed a day stale (2026-09-28: its 20G early cleanup merged, never ran,
    # disk hit 265M free).
    names = set(LAUNCHERS)
    for t in (TREE / "launchd").glob("*.tmpl"):
        names.update(re.findall(r"\$\{HOME\}/\.estate/bin/([\w.-]+)", t.read_text()))
    return sorted(names)


# /fleet's frontend: its own sparse clone (backstage/ only) with node_modules, served by
# ai.estate.fleetview-frontend. The dev server hot-reloads what this checks out.
FRONTEND = Path(os.environ.get("ESTATE_FRONTEND_TREE") or STATE / "frontend/idp")
# `localhost`, not 127.0.0.1: the dev server binds ::1 only (app.baseUrl says localhost), so the v4
# literal was refused on every tick and every frontend deploy was rolled back (2026-09-28).
FRONTEND_PROBE = "http://localhost:3100/"
BACKEND_PROBE = "http://127.0.0.1:7107/.backstage/health/v1/liveness"
# fleetview_backend reaches the repo root for these (parents[5]); a change here is a backend change.
BACKEND_PATHS = (
    "backstage/plugins/fleetview-backend/",
    "lib/",
    "mcp/plugins/",
    "platform/estate/intents/",
)


def git(*args: str, check: bool = True, tree: Path = TREE) -> str:
    env = git_env({"GIT_SSH_COMMAND": "ssh -o BatchMode=yes -o ConnectTimeout=20"})
    r = subprocess.run(
        ["git", "-C", str(tree), *args],
        capture_output=True,
        text=True,
        timeout=300,
        env=env,
    )
    if check and r.returncode:
        raise RuntimeError(f"git {' '.join(args)}: {r.stderr.strip()[-300:]}")
    return r.stdout.strip()


def scrub_tree() -> str:
    """Put back any hand edit in the tree; this job is its only writer. 2026-10-08 a hand-patched
    efficiency_gateway.py made every `checkout` refuse for 10 hours, silently: main never deployed.
    The edit is kept as a diff and named in an alert, never lost."""
    if not git("status", "--porcelain", "--untracked-files=no").strip():
        return ""
    keep = (
        STATE
        / f"runtime-sync-discarded-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}.diff"
    )
    keep.write_text(git("diff", "HEAD"))
    git("reset", "-q", "--hard")
    alert(f"runtime tree had hand edits; reset to main, kept in {keep}")
    return f"discarded hand edits -> {keep.name}"


def ensure_tree() -> None:
    if (TREE / ".git").exists():
        return
    TREE.parent.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        [
            "git",
            "clone",
            "-q",
            "--filter=blob:none",
            "--no-checkout",
            REMOTE,
            str(TREE),
        ],
        check=True,
        timeout=600,
        env=git_env({"GIT_SSH_COMMAND": "ssh -o BatchMode=yes"}),
    )
    git("sparse-checkout", "set", "--no-cone", *SPARSE)
    git("checkout", "-q", "--detach", "origin/main")


def normalise_origin(tree: Path = TREE) -> str:
    """Point the tree's origin at the canonical remote, whatever it was cloned as.

    The tree was cloned with `git@github.com:...`, which the founder's global config
    rewrote to https; the stored origin therefore named a transport the sync does not
    intend to use. The remote is corrected here, in the tree, without touching the
    founder's config.
    """
    try:
        current = git("remote", "get-url", "origin", tree=tree)
    except RuntimeError:
        current = ""
    if current == REMOTE:
        return ""
    if current:
        git("remote", "set-url", "origin", REMOTE, tree=tree)
    else:
        git("remote", "add", "origin", REMOTE, tree=tree)
    return f"origin {(current or '(unset)')} -> {REMOTE}"


def link_data() -> None:
    for name in ("estate.db", "catalog-info.yaml"):
        dst, src = TREE / "catalog" / name, DATA / name
        if src.exists() and not dst.is_symlink():
            dst.unlink(missing_ok=True)
            dst.symlink_to(src)


def stage() -> list[str]:
    # Once the root converger (#4555, /usr/local/estate) is installed it owns ~/.estate's intents,
    # libexec and bin as symlinks into its release, and moves copies aside as drift: one deliverer.
    if (Path("/usr/local/estate/releases/current")).exists():
        return ["staging left to estate-converge"]
    notes = []
    for sub in ("intents", "libexec", "skills"):
        src, dst = TREE / "platform/estate" / sub, STATE / sub
        dst.mkdir(parents=True, exist_ok=True)
        if sub == "skills":
            # A tree, not a file list: the skill packs. Copied only when a file differs, so
            # an unchanged pack is not rewritten under a running agent.
            changed = []
            for f in sorted(src.rglob("*")):
                if not f.is_file() or f.name == ".DS_Store":
                    continue
                rel = f.relative_to(src)
                target = dst / rel
                if not target.exists() or not filecmp.cmp(f, target, False):
                    target.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(f, target)
                    changed.append(str(rel))
            if changed:
                notes.append(f"skills +{len(changed)} files")
            continue
        changed = []
        for f in sorted(src.iterdir()):
            if not f.is_file():
                continue
            if not (dst / f.name).exists() or not filecmp.cmp(f, dst / f.name, False):
                shutil.copy2(f, dst / f.name)
                changed.append(f.name)
        if changed:
            notes.append(
                f"{sub} +{len(changed)} ({', '.join(changed[:6])}{'...' if len(changed) > 6 else ''})"
            )
        if sub == "intents":
            extra = {p.name for p in dst.glob("*.yaml")} - {
                p.name for p in src.glob("*.yaml")
            }
            if extra:
                notes.append(f"intents not on main: {len(extra)}")
    for name in launchers():
        f = TREE / "bin" / name
        if f.exists() and not (
            (STATE / "bin" / name).exists()
            and filecmp.cmp(f, STATE / "bin" / name, False)
        ):
            # the destination may not exist yet: a sync must not crash on a missing
            # ~/.estate/bin, it must fill it
            (STATE / "bin").mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, STATE / "bin" / name)
            (STATE / "bin" / name).chmod(0o755)
            notes.append(f"bin/{name}")
    return notes


def kickstart(label: str) -> None:
    subprocess.run(
        ["/bin/launchctl", "kickstart", "-k", f"gui/{UID}/{label}"],
        capture_output=True,
        timeout=30,
    )


def answers(url: str, within_s: int) -> bool:
    end = time.time() + within_s
    while time.time() < end:
        try:
            with urllib.request.urlopen(url, timeout=20) as r:
                if r.status == 200:
                    return True
        except (urllib.error.URLError, TimeoutError, OSError):
            pass
        time.sleep(2)
    return False


# THE EXECUTOR IS A SERVICE TOO. platform/executor/daemon.py serves ~/.estate/executor.sock
# and every governed command an agent runs goes through it. It runs from the runtime tree,
# so a change to the tree's daemon, plugin, plan module or intent executor is only live
# once the daemon is restarted -- and the sync did not restart it at all until 2026-10-30,
# so a landed fix waited for a human to kickstart it. A door that serves the bytes from
# before the fix is a door that is not enforced.
EXECUTOR_LABEL = "ai.estate.executor"
EXECUTOR_SOCKET = Path(os.environ.get("ESTATE_EXECUTOR_SOCKET") or STATE / "executor.sock")


def socket_answers(path: Path, within_s: int, verb: str = "health") -> bool:
    """Ask the executor daemon, on its own UNIX socket, whether it is alive.

    The daemon answers one newline-delimited JSON request; `{"verb": "health"}` replies
    with {"ok": true, ...}. It is not an HTTP service and there is no HTTP health endpoint,
    so the probe is the socket itself. Anything that is not a parsed {"ok": true} is not
    an answer: a half-written reply is not health.
    """
    end = time.time() + within_s
    while time.time() < end:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
                s.settimeout(10)
                s.connect(str(path))
                s.sendall((json.dumps({"verb": verb}) + "\n").encode())
                buf = b""
                while b"\n" not in buf:
                    chunk = s.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
            reply = json.loads(buf.decode("utf-8", "replace").strip().splitlines()[0])
            if reply.get("ok") is True:
                return True
        except (OSError, ValueError, IndexError):
            pass
        time.sleep(2)
    return False


def service_answers(kind: str, probe: str, wait: int) -> bool:
    """One probe, two kinds: an HTTP endpoint, or the executor's UNIX socket."""
    if kind == "unix":
        return socket_answers(Path(probe), wait)
    return answers(probe, wait)


# The laptop router (com.estate.litellm-local). Only its modules follow main: the live launcher is the
# one that loads vendor keys from Bitwarden, and its config is the laptop's own, so both stay as
# installed. Before this, every router fix merged and then waited on a hand-copied file (2026-09-29:
# the holdout trial merged in #4909 while the router still ran the commit before it).
ROUTER = Path(os.environ.get("ESTATE_ROUTER_DIR") or STATE / "litellm-local")
ROUTER_LABEL = "com.estate.litellm-local"
# The front is its own process, launched from the same stage directory (bin/litellm-local
# `front`): new bytes in the stage are not a new front until the label is restarted, and a
# front that is not restarted is a router fix that waits for a human -- exactly the holdout
# this file was written for (2026-09-29, #4909), one layer out.
ROUTER_FRONT_LABEL = "com.estate.litellm-front"
ROUTER_PROBE = "http://127.0.0.1:4000/health/liveliness"


def router_files() -> list[tuple[Path, str]]:
    # (source in main, name under ROUTER). The config is carried too: 2026-09-29 #4962 added the
    # `voice` lane to llm/config.yaml, only the modules followed main, and every spoken turn failed
    # for a day with "no healthy deployments for model_group=voice".
    m = re.search(r'^MODULES="([^"]*)"', (TREE / "bin/litellm-local").read_text(), re.M)
    mods = m.group(1).split() if m else []
    # The artifact policy travels with the router: the module that reads it, and the
    # canonical YAML it reads. Both are named here, not only through MODULES, so the
    # policy reaches the live router even when bin/litellm-local's MODULES list has
    # not been extended yet -- a policy the router cannot read is a router that
    # silently keeps the legacy behaviour.
    files = [
        (TREE / "llm/config.yaml", "config.yaml"),
        (TREE / "platform/llm/artifact_tier.py", "modules/artifact_tier.py"),
        (TREE / "platform/llm/artifact-tier.yaml", "modules/artifact-tier.yaml"),
        # The front travels with the router (2026-10-28): it is the process every model call
        # goes through, and a fix to it that only reaches main is a fix the laptop does not
        # have. It is copied to the stage's top level, which is where bin/litellm-local
        # launches it from.
        (TREE / "platform/llm/front.py", "front.py"),
    ] + [(TREE / "platform/llm" / n, f"modules/{n}") for n in mods]
    seen: set[str] = set()
    unique: list[tuple[Path, str]] = []
    for src, name in files:
        if name in seen:
            continue
        seen.add(name)
        unique.append((src, name))
    return unique


VOICE_PROBE = "http://127.0.0.1:8091/readyz"

# The installed delegate-build runs from ~/.estate/libexec and loads the artifact policy from
# ~/.estate/llm, next to itself (its parents[1]/llm). The policy was only staged into the
# router's modules dir, so the intent's planner had no policy to read and every delegated plan
# died on a missing file: the router and the delegator must run the same bytes.
POLICY_DIR = ROUTER.parent / "llm"


def sync_artifact_policy() -> list[str]:
    # Stage the canonical policy (platform/llm/artifact_tier.py + its YAML) into the installed
    # layout the delegate-build reads. Copied only when the bytes differ, so an unchanged policy
    # is not rewritten under a running delegate.
    notes = []
    for name in ("artifact_tier.py", "artifact-tier.yaml"):
        src = TREE / "platform/llm" / name
        dst = POLICY_DIR / name
        if not src.is_file():
            continue
        if dst.exists() and filecmp.cmp(src, dst, False):
            continue
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)
        notes.append(f"policy {name}")
    return notes


def router_accepted(voice_was_ready: bool, within_s: int) -> bool:
    # Acceptance, not liveness: the router answering /health/liveliness proved nothing while voice
    # was dead. A change is kept only if the router is up and voice, which asks the router for its
    # `voice` brain on /readyz, is at least as ready as before it.
    if not answers(ROUTER_PROBE, within_s):
        return False
    return answers(VOICE_PROBE, within_s) or not voice_was_ready


def sync_watchdog() -> list[str]:
    # The router's guardian runs from the stage (launchd/ai.estate.litellm-watchdog.plist.tmpl),
    # but only `bin/litellm-local install` copied it, so a fix on main never reached the laptop:
    # 2026-10-02 the staged copy kept restarting a slow-but-listening router 12 times while the
    # fix sat in source. launchd runs it fresh every 15 s, so staging it needs no restart.
    src, dst = TREE / "platform/llm/watchdog.py", ROUTER / "watchdog.py"
    if not src.is_file() or (dst.exists() and filecmp.cmp(src, dst, False)):
        return []
    shutil.copy2(src, dst)
    return ["router watchdog.py staged"]


def sync_memory() -> list[str]:
    # Estate memory reached each runtime only when someone ran bin/estate-memory-install by hand,
    # so a fix to the brief, the bridge or the enforcement hooks merged and then waited on that
    # (2026-10-19: the hooks ran from an unlanded worktree until a person re-ran the installer).
    # The installer is idempotent and writes only what drifted, so it runs from main every tick.
    installer = TREE / "bin/estate-memory-install"
    if not installer.is_file():
        return []
    try:
        r = subprocess.run(  # noqa: S603 - fixed argv: this interpreter, main's own installer
            [sys.executable, str(installer)],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        return [f"memory install failed: {exc}"]
    wrote = [ln.split()[1] for ln in r.stdout.splitlines() if ln.startswith("wrote")]
    notes = [f"memory +{len(wrote)} ({', '.join(sorted(set(wrote)))})"] if wrote else []
    if r.returncode != 0:
        # a refusal (a hand-edited config it will not rewrite) is the founder's call, not a rollback
        notes.append(
            f"memory install exit {r.returncode}: {(r.stdout + r.stderr).strip()[-200:]}"
        )
    return notes


def restart_router() -> bool:
    """Put the staged router into service. False only when it never answered.

    With slots (bin/litellm-local `swap`, 2026-10-02) the new router boots beside the live one
    and takes over only once it answers, so no caller is ever refused; one that never answers
    is stopped and the live one keeps serving. A stage still on the single router is kickstarted
    as before, which refuses every caller for the ~90 s LiteLLM takes to start.
    """
    launcher = ROUTER / "litellm-local"
    if launcher.is_file() and "\n  swap) swap ;;" in launcher.read_text():
        r = subprocess.run(
            ["/bin/bash", str(launcher), "swap"],
            capture_output=True,
            text=True,
            timeout=400,
        )
        if r.returncode != 0:
            print(r.stdout[-1500:], r.stderr[-1500:], file=sys.stderr)
        return r.returncode == 0
    kickstart(ROUTER_LABEL)
    return True


def restart_front(previous: "dict[str, bytes | None]", within_s: int = 120) -> str:
    """Put a changed front into service. Returns a note, or "" when the front did not change.

    The front is a separate launchd label, so copied bytes are not a running front. A front
    that does not come back with the new bytes is rolled back the same way the router is: the
    previous bytes go back and the label is restarted again.
    """
    if "front.py" not in previous:
        return ""
    kickstart(ROUTER_FRONT_LABEL)
    if answers(ROUTER_PROBE, within_s):
        return f"; front restarted {ROUTER_FRONT_LABEL}"
    old = previous["front.py"]
    if old is None:
        (ROUTER / "front.py").unlink(missing_ok=True)
    else:
        (ROUTER / "front.py").write_bytes(old)
    kickstart(ROUTER_FRONT_LABEL)
    answers(ROUTER_PROBE, within_s)
    alert(f"front from main did not come back; the previous front is back in service")
    return f"; FRONT KEPT previous"


def sync_router(within_s: int = 120) -> list[str]:
    if not (ROUTER / "modules").is_dir():
        return []
    staged = sync_watchdog()
    voice_was_ready = answers(VOICE_PROBE, 5)
    previous: dict[str, bytes | None] = {}
    for src, name in router_files():
        dst = ROUTER / name
        if not src.is_file() or (dst.exists() and filecmp.cmp(src, dst, False)):
            continue
        previous[name] = dst.read_bytes() if dst.exists() else None
        shutil.copy2(src, dst)
    if not previous:
        return staged
    names = ", ".join(sorted(previous))
    deployed = restart_router()
    if deployed and router_accepted(voice_was_ready, within_s):
        voice = "voice ready" if answers(VOICE_PROBE, 5) else "voice STILL NOT READY"
        if voice != "voice ready":
            alert(f"router took {names} from main but voice is still not ready")
        front = restart_front(previous)
        return staged + [f"router {names}; deployed {ROUTER_LABEL}; {voice}{front}"]
    for name, old in previous.items():
        dst = ROUTER / name
        if old is None:
            dst.unlink(missing_ok=True)
        else:
            dst.write_bytes(old)
    if (
        deployed
    ):  # it took over and broke voice: put the previous bytes back into service
        restart_router()
        answers(ROUTER_PROBE, within_s)
    alert(f"router {names} from main broke the router or voice; previous kept")
    return staged + [f"ROUTER KEPT previous ({names})"]


def build_voice_router() -> bool:
    out = STATE / "voice-router/voice-router"
    out.parent.mkdir(parents=True, exist_ok=True)
    try:
        r = subprocess.run(
            [GO, "build", "-trimpath", "-o", f"{out}.new", "./cmd/voice-router"],
            cwd=TREE / "platform/voice-router",
            capture_output=True,
            text=True,
            timeout=900,
            env=dict(os.environ, CGO_ENABLED="1"),
        )
    except (OSError, subprocess.SubprocessError):
        # no toolchain is a failed build, not a dead sync: the router still gets main
        return False
    if r.returncode:
        return False
    os.replace(f"{out}.new", out)
    return True


def alert(text: str) -> None:
    INBOX.parent.mkdir(parents=True, exist_ok=True)
    with INBOX.open("a") as f:
        f.write(
            json.dumps(
                {
                    "ts": time.time(),
                    "source": "estate-runtime-sync",
                    "key": "runtime-sync",
                    "text": text,
                }
            )
            + "\n"
        )



SERVICES = [
    # (label, what changes it, probe, seconds to come back, how to probe it)
    (
        "ai.estate.voice-router",
        # its launcher too: it is what fetches missing speech models, and only runs on a restart
        ("platform/voice-router/", "bin/voice-router-launchd"),
        "http://127.0.0.1:8091/readyz",
        # a start may first fetch 210 MB of speech models (bin/voice-router-launchd): at 90 s the
        # first such start was judged broken and rolled back while the download was still running
        600,
        "http",
    ),
    (
        "ai.estate.fleetview-backend",
        # its launcher too: the server's PATH (and so /agent-jobs' gh) is set there
        (*BACKEND_PATHS, "bin/fleetview-launchd"),
        "http://127.0.0.1:18790/healthz",
        90,
        "http",
    ),
    (
        EXECUTOR_LABEL,
        # the daemon's own code, the plugin it imports, the plan module it gates on, the
        # intent executor it runs, and the pi adapters that call it
        (
            "platform/executor/",
            "mcp/plugins/",
            "platform/estate/bin/",
            "platform/estate/memory/",
            "extensions/",
            "bin/estate-memory-",
        ),
        str(EXECUTOR_SOCKET),
        90,
        "unix",
    ),
]


def services_for(changed: list, force: bool = False) -> list:
    """The services a set of changed paths demands a restart of."""
    out = []
    for label, paths, _probe, _wait, _kind in SERVICES:
        if force or any(p.startswith(paths) for p in changed):
            out.append(label)
    return out


def sync_frontend(sha: str) -> list[str]:
    """Move the frontend tree to sha; a lockfile change reinstalls; a dead /fleet rolls it back."""
    fresh = not (FRONTEND / ".git").exists()
    if fresh:
        FRONTEND.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            [
                "git",
                "clone",
                "-q",
                "--filter=blob:none",
                "--no-checkout",
                REMOTE,
                str(FRONTEND),
            ],
            check=True,
            timeout=900,
            env=git_env({"GIT_SSH_COMMAND": "ssh -o BatchMode=yes"}),
        )
        git("sparse-checkout", "set", "--no-cone", "/backstage/", tree=FRONTEND)
        git("checkout", "-q", "--detach", sha, tree=FRONTEND)
    normalise_origin(FRONTEND)
    was = git("rev-parse", "HEAD", tree=FRONTEND)
    if was == sha and not fresh:
        return []
    git("fetch", "-q", "origin", "main", tree=FRONTEND)
    lock_changed = fresh or bool(
        git("diff", "--name-only", was, sha, "--", "backstage/yarn.lock", tree=FRONTEND)
    )
    # A deploy tree, never a work tree: force, so a stray edit cannot pin it off main.
    git("checkout", "-q", "-f", "--detach", sha, tree=FRONTEND)
    if lock_changed:
        yarn = next((FRONTEND / "backstage/.yarn/releases").glob("yarn-*.cjs"))
        node = shutil.which("node") or str(
            sorted((HOME / ".nvm/versions/node").glob("v22.*/bin/node"))[-1]
        )
        r = subprocess.run(
            [node, str(yarn), "install", "--immutable"],
            cwd=FRONTEND / "backstage",
            capture_output=True,
            text=True,
            timeout=1800,
        )
        if r.returncode:
            git("checkout", "-q", "--detach", was, tree=FRONTEND)
            # The reason travels with the alert: a bare "install failed" hid the cause for hours.
            why = (r.stderr or r.stdout or "").strip().splitlines()[-3:]
            alert(
                f"/fleet frontend: yarn install for {sha[:8]} failed (exit {r.returncode}: "
                f"{' | '.join(why)[:300]}); kept {was[:8]}"
            )
            return [f"frontend held at {was[:8]} (install failed)"]
    # A backend that is not answering is a service that died, not a bad frontend: restart it once
    # before judging the checkout (2026-09-28: its Node child died and nothing restarted it, so
    # every deploy after was rolled back for 16 hours).
    if not answers(BACKEND_PROBE, 5):
        kickstart("ai.estate.backstage-backend")
    if answers(FRONTEND_PROBE, 180) and answers(BACKEND_PROBE, 180):
        return [f"frontend {was[:8]}->{sha[:8]}"]
    git("checkout", "-q", "--detach", was, tree=FRONTEND)
    alert(f"/fleet frontend stopped answering on {sha[:8]}; rolled back to {was[:8]}")
    return [f"frontend ROLLED BACK to {was[:8]}"]


# WHAT ANYBODY ASKS: `bin/estate-runtime-sync --status`. A convergence job that cannot say
# whether it converged is a job that is silently stuck: launchd reported "last exit code = 0"
# for 83 runs while the load gate had skipped every one of them (measured 2026-10-30) and the
# tree sat on an old commit. The status answers the three questions the log could not: is the
# tree on main, did the last run succeed, and was this job skipped instead of run.
STATUS = STATE / "runtime-sync.status.json"
SKIP_LOG = STATE / "logs/load-gate-skips.log"
INTERVAL_S = 300
# pi loads its extensions from here, not from the runtime tree: a separate installed artifact.
PI_EXTENSIONS = HOME / ".pi/agent/extensions"


def iso(ts: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts))


def skipped_since(marker: str, command: str) -> list:
    """The skips the load gate recorded against `command` since `marker` (an ISO timestamp).

    The gate logs the skip against ITSELF, not against the command it refused, so a skipped
    job could not be named and a starved job looked exactly like a healthy one. The
    repository-managed wrapper (bin/load-gate-and-run) records the command it refused; this
    reads what it wrote.
    """
    if not SKIP_LOG.exists():
        return []
    out = []
    try:
        lines = SKIP_LOG.read_text(errors="replace").splitlines()
    except OSError:
        return []
    for line in lines:
        if " skip " not in line or command not in line:
            continue
        if marker and line.split(" ", 1)[0] <= marker:
            continue
        out.append(line)
    return out


def previous_status() -> dict:
    try:
        data = json.loads(STATUS.read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def write_status(payload: dict) -> None:
    STATUS.parent.mkdir(parents=True, exist_ok=True)
    STATUS.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


def read_status() -> dict:
    """The convergence state, read live. A status reader that raises is a status reader nobody
    reads, so every failure here is a value, not an exception."""
    data = previous_status()
    last_success = data.get("last_success") or 0
    try:
        last_success = float(last_success)
    except (TypeError, ValueError):
        last_success = 0.0
    marker = iso(last_success) if last_success else ""
    skips = skipped_since(marker, "estate-runtime-sync")
    now = time.time()
    tree_head = data.get("tree_head") or ""
    origin_main = data.get("origin_main") or ""
    stale = bool(tree_head and origin_main and tree_head != origin_main)
    starved = bool(last_success) and (now - last_success) > 2 * INTERVAL_S
    return {
        "last_run": data.get("last_run"),
        "last_success": last_success or None,
        "last_success_iso": marker,
        "last_line": data.get("last_line", ""),
        "tree_head": tree_head,
        "origin_main": origin_main,
        "stale": stale,
        "starved": starved,
        "never_ran": not last_success,
        "skipped_since_last_success": len(skips),
        "last_skip": skips[-1] if skips else "",
        "services": data.get("services", {}),
        "pi_extensions": data.get("pi_extensions", {}),
        "notes": data.get("notes", []),
        "ok": bool(data.get("ok")),
        "converged": bool(
            data.get("ok") and not stale and not starved and not skips and tree_head
        ),
    }


def sync_pi_extensions() -> tuple:
    """Refresh the installed pi extensions from main's bytes.

    A pi extension is a SEPARATE installed artifact from the runtime tree: the tree carries
    main's bytes, but pi loads the copy under ~/.pi/agent/extensions. A fix that lands in
    main and reaches the tree has still not reached pi (measured 2026-10-30: the installed
    estate-capabilities adapter was a month old and sent no session identity, so the plan
    gate had nothing to enforce at the door).

    Only an extension the host ALREADY has is refreshed, file by file, and only when the
    bytes differ. Nothing is installed that the host did not ask for -- installing a new
    extension changes what pi does, and that is the founder's call -- and nothing is
    deleted: drift is REPORTED, not acted on.
    """
    src_root = TREE / "extensions"
    if not src_root.is_dir() or not PI_EXTENSIONS.is_dir():
        return [], {}
    changed = []
    for ext in sorted(p for p in src_root.iterdir() if p.is_dir()):
        dst = PI_EXTENSIONS / ext.name
        if not dst.is_dir():
            continue
        for f in sorted(ext.rglob("*")):
            if not f.is_file():
                continue
            rel = f.relative_to(ext)
            target = dst / rel
            if target.exists() and filecmp.cmp(f, target, False):
                continue
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f, target)
            changed.append(f"{ext.name}/{rel}")
    on_main = sorted(p.name for p in src_root.iterdir() if p.is_dir())
    installed = sorted(p.name for p in PI_EXTENSIONS.iterdir() if p.is_dir())
    not_installed = [n for n in on_main if n not in installed]
    not_on_main = [n for n in installed if n not in on_main]
    notes = []
    if changed:
        shown = ", ".join(changed[:6]) + ("..." if len(changed) > 6 else "")
        notes.append(f"pi extensions +{len(changed)} ({shown})")
    if not_installed:
        notes.append(f"pi extensions on main, not installed here: {', '.join(not_installed)}")
    if not_on_main:
        notes.append(f"pi extensions installed, not on main: {', '.join(not_on_main)}")
    return notes, {
        "refreshed": changed,
        "on_main": on_main,
        "installed": installed,
        "on_main_not_installed": not_installed,
        "installed_not_on_main": not_on_main,
    }


def main() -> int:
    ensure_tree()
    scrubbed = scrub_tree()
    origin_note = normalise_origin()
    before = git("rev-parse", "HEAD")
    git("fetch", "-q", "origin", "main")
    origin_main = git("rev-parse", "origin/main")
    after = origin_main
    if BAD.exists() and BAD.read_text().strip() == after:
        after = before
    changed = (
        git("diff", "--name-only", before, after).splitlines()
        if after != before
        else []
    )
    if after != before:
        git("checkout", "-q", "--force", "--detach", after)
    link_data()
    notes = ([scrubbed] if scrubbed else []) + stage()
    if origin_note:
        notes.append(origin_note)
    force = sys.argv[1:] == ["--restart"]
    broke = []
    services: dict = {}
    for label, paths, probe, wait, kind in SERVICES:
        if not (force or any(p.startswith(paths) for p in changed)):
            continue
        if label == "ai.estate.voice-router" and not build_voice_router():
            broke.append(f"{label}: build failed, previous binary kept")
            services[label] = False
            continue
        kickstart(label)
        if service_answers(kind, probe, wait):
            notes.append(f"restarted {label}")
            services[label] = True
        else:
            broke.append(label)
            services[label] = False
    if broke and after != before:
        git("checkout", "-q", "--detach", before)
        stage()
        for label, _, probe, wait, kind in SERVICES:
            if label in broke:
                if label == "ai.estate.voice-router":
                    build_voice_router()
                kickstart(label)
                services[label] = service_answers(kind, probe, wait)
        BAD.write_text(after)
        alert(f"main {after[:8]} broke {', '.join(broke)}; rolled back to {before[:8]}")
        notes.append(f"ROLLED BACK to {before[:8]}")
    elif broke:
        alert(f"runtime sync: {', '.join(broke)} did not come back")
    notes += sync_memory()
    try:
        notes += sync_artifact_policy()
    except OSError as exc:
        notes.append(f"artifact policy sync failed: {exc}")
    try:
        notes += sync_router()
    except (OSError, subprocess.SubprocessError) as exc:
        notes.append(f"router sync failed: {exc}")
    try:
        notes += sync_frontend(git("rev-parse", "HEAD"))
    except (
        RuntimeError,
        OSError,
        subprocess.SubprocessError,
        StopIteration,
        IndexError,
    ) as exc:
        notes.append(f"frontend sync failed: {exc}")
    try:
        pi_notes, pi_state = sync_pi_extensions()
        notes += pi_notes
    except OSError as exc:
        pi_notes, pi_state = [], {}
        notes.append(f"pi extension refresh failed: {exc}")
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{stamp} {before[:8]}->{after[:8]} changed={len(changed)} {'; '.join(notes) or 'nothing to do'}"
    with LOG.open("a") as f:
        f.write(line + ("; BROKE " + ", ".join(broke) if broke else "") + "\n")
    now = time.time()
    previous = previous_status()
    tree_head = git("rev-parse", "HEAD")
    write_status(
        {
            "last_run": now,
            "last_success": now if not broke else previous.get("last_success", 0),
            "last_line": line,
            "tree_head": tree_head,
            "origin_main": origin_main,
            "stale": bool(broke) or tree_head != origin_main,
            "services": services,
            "pi_extensions": pi_state,
            "notes": notes,
            "ok": not broke,
        }
    )
    print(line)
    return 1 if broke else 0


if __name__ == "__main__":
    if "--status" in sys.argv[1:]:
        state = read_status()
        print(json.dumps(state, indent=2, sort_keys=True))
        raise SystemExit(0 if state.get("converged") else 1)
    crashed = STATE / "runtime-sync.crash"
    try:
        code = main()
    except Exception as exc:
        # a crash used to land only in runtime-sync.err.log (610 tracebacks, nobody told); one
        # alert per distinct crash, not one every five minutes
        why = f"runtime sync crashed: {type(exc).__name__}: {exc}"[:300]
        if not crashed.exists() or crashed.read_text() != why:
            crashed.write_text(why)
            alert(why)
        previous = previous_status()
        write_status(
            {
                "last_run": time.time(),
                "last_success": previous.get("last_success", 0),
                "ok": False,
                "error": why,
                "notes": [why],
            }
        )
        raise
    crashed.unlink(missing_ok=True)
    raise SystemExit(code)
