#!/usr/bin/env python3
"""Turn every finished or abandoned branch into a tag, then delete the branch. Nothing is lost.

Founder, 2026-09-09: "if branches have been merged into main then they should be deleted, we need
better cleanup mechanism without risk of losing work and all this constant admin and stress".

Measured that night: the repository carried 189 branches beside main. GitHub's own
delete-branch-on-merge was already on, so none of them was a merged pull request's head; 184
carried patches that were never on main, 5 were patch-for-patch already on main, and 4 had an
open pull request. The clutter is abandoned work, and deleting abandoned work by hand is the
stress the founder named: every sweep before this one moved tips to `backup/<date>/` branches,
which is a branch list that only grows.

The mechanism: a branch that is finished (every patch on main), named as a backup, or untouched
for `--age-days` with no open pull request becomes a tag `archive/<branch>` at its tip and the
branch is deleted. A tag keeps every commit reachable, so nothing is lost and the branch list
only holds live work. Restore is one command:

    git push origin refs/tags/archive/<branch>:refs/heads/<branch>

Protected: main, and `flux/*`, which Flux image automation writes and reads as a mailbox.
Never touched: a branch with an open pull request. Idempotent: a second run over the same
remote plans nothing. Dry run by default.

`--apply` pushes tags and deletes branches in batches of 20, never atomically, and treats a
refspec the remote refuses as a SKIP, not a death. It has to: between 2026-09-09 and 2026-09-22
this job ran eight times, planned `archived 795 branch(es); kept 137` correctly every time, and
deleted nothing. One `git push` carried every refspec, one of them was refused, `check=True`
raised, and `capture_output=True` swallowed git's reason -- so seven consecutive weekly runs
reported `returned non-zero exit status 1` and no more, while 954 branches stayed. A fence that
does nothing at all when one of 795 refs is bad is not a fence. Each batch now goes with
`--porcelain` and `check=False`; a refused ref is named with the remote's own reason, and the
other 794 land. A branch is deleted only once its tag is confirmed on the remote, so a refused
tag costs that branch nothing. Runs on the estate's clock through
.github/workflows/branch-archive.yml; the repo slug comes from GITHUB_REPOSITORY or `gh`, never
from this file (LAW 46).
"""
from __future__ import annotations

import argparse
import collections
import os
import subprocess
import sys
import time

PROTECTED = frozenset({"main", "HEAD"})
PROTECTED_PREFIXES = ("flux/",)
ARCHIVE_BY_NAME = ("backup/", "rescue/")
AGE_DAYS = 14


def git(*args: str) -> str:
    # The remote's reason travels on stderr; the second apply run (34308053868) died on a
    # CalledProcessError that named the 100 refspecs and not one word of why they were refused.
    r = subprocess.run(["git", *args], text=True, capture_output=True)
    if r.returncode:
        sys.exit(f"git {args[0]} failed ({r.returncode}): {r.stderr.strip()}")
    return r.stdout


def open_pull_request_heads(repo: str) -> set[str]:
    out = subprocess.run(
        ["gh", "api", "--paginate", f"repos/{repo}/pulls?state=open&per_page=100", "--jq", ".[].head.ref"],
        check=True, text=True, capture_output=True,
    ).stdout
    return set(out.split())


def repo_slug() -> str:
    slug = os.environ.get("GITHUB_REPOSITORY")
    if slug:
        return slug
    return subprocess.run(
        ["gh", "repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"],
        check=True, text=True, capture_output=True,
    ).stdout.strip()


def plan(remote: str, age_days: int, now: float) -> tuple[list[tuple[str, str, str, str]], collections.Counter]:
    git("fetch", "--quiet", "--prune", remote, f"+refs/heads/*:refs/remotes/{remote}/*", "+refs/tags/*:refs/tags/*")
    heads = git("for-each-ref", "--format=%(refname:short) %(objectname) %(committerdate:unix)",
                f"refs/remotes/{remote}/").splitlines()
    tags = {t for t in git("tag", "--list", "archive/*").split()}
    open_heads = open_pull_request_heads(repo_slug())
    kept: collections.Counter = collections.Counter()
    out: list[tuple[str, str, str, str]] = []
    for line in heads:
        ref, sha, ts = line.split()
        branch = ref[len(remote) + 1:]
        if branch in PROTECTED or branch.startswith(PROTECTED_PREFIXES):
            kept["protected"] += 1
            continue
        if branch in open_heads:
            kept["open pull request"] += 1
            continue
        if branch.startswith(ARCHIVE_BY_NAME):
            reason = "named as a backup"
        else:
            unmerged = sum(1 for c in git("cherry", f"{remote}/main", ref).splitlines() if c.startswith("+"))
            age = int((now - int(ts)) // 86400)
            if unmerged == 0:
                reason = "every patch is on main"
            elif age >= age_days:
                reason = f"{unmerged} patch(es) not on main, untouched {age} days"
            else:
                kept[f"live, touched under {age_days} days ago"] += 1
                continue
        tag = f"archive/{branch}"
        if tag in tags and git("rev-parse", f"{tag}^{{commit}}").strip() != sha:
            tag = f"archive/{branch}@{sha[:7]}"
        out.append((branch, sha, reason, tag))
    return out, kept


# 20, not 100 and never all 795: a batch is the blast radius of one bad refspec, and a
# smaller batch is also a shorter retry. Never --atomic, which would restore the exact
# all-or-nothing failure this file exists to end.
BATCH = 20


def push(remote: str, *refspecs: str) -> dict[str, str]:
    """Push these refspecs and return {ref: the remote's reason} for the ones it refused.

    `--porcelain` prints one machine-readable line per ref, so a refusal is data rather than
    an exit code; `check=False` because a rejected ref is a skip, not a death. Returns an
    empty dict when every ref landed.
    """
    p = subprocess.run(
        ["git", "push", "--porcelain", remote, *refspecs],
        text=True, capture_output=True,
    )
    refused: dict[str, str] = {}
    for line in p.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) < 3 or parts[0] not in ("!", "="):
            continue
        if parts[0] == "!":
            refused[parts[1]] = parts[2]
    if p.returncode != 0 and not refused:
        # The push failed before it reported on any single ref -- auth, network, a server
        # hook. Name every ref in the batch with git's own stderr, never a bare exit code:
        # an unexplained `exit status 1` is what hid this failure for seven weeks.
        reason = (p.stderr.strip().splitlines() or ["git push failed with no output"])[-1]
        return {r: reason for r in refspecs}
    return refused


def remote_archive_tags(remote: str) -> set[str]:
    """The archive tags ORIGIN holds. The runner's checkout is not the authority: a tag the
    remote already has is a branch already archived, and re-pushing it is the refusal that
    used to kill the run."""
    out = git("ls-remote", "--tags", remote, "refs/tags/archive/*")
    names = set()
    for line in out.splitlines():
        if "refs/tags/" not in line:
            continue
        name = line.split("refs/tags/", 1)[1].strip()
        names.add(name[:-3] if name.endswith("^{}") else name)
    return names


def apply(remote: str, rows: list[tuple[str, str, str, str]]) -> tuple[int, dict[str, str]]:
    """Tag then delete, in batches, skipping whatever the remote refuses.

    Returns (branches deleted, {branch: why it was skipped}).
    """
    refused: dict[str, str] = {}
    on_remote = remote_archive_tags(remote)

    # Pre-filter: only tags origin does not already hold.
    todo = [(b, sha, tag) for b, sha, _r, tag in rows if tag not in on_remote]
    tagged = {b for b, _sha, _r, tag in rows if tag in on_remote}
    for i in range(0, len(todo), BATCH):
        chunk = todo[i:i + BATCH]
        bad = push(remote, *[f"{sha}:refs/tags/{tag}" for _b, sha, tag in chunk])
        for b, sha, tag in chunk:
            why = bad.get(f"refs/tags/{tag}") or bad.get(f"{sha}:refs/tags/{tag}")
            if why:
                refused[b] = f"tag refused: {why}"
            else:
                tagged.add(b)

    # A branch goes only once its tag is on the remote. A refused tag costs that branch
    # nothing; it is simply carried to the next run.
    deletable = [b for b, *_ in rows if b in tagged]
    deleted = 0
    for i in range(0, len(deletable), BATCH):
        chunk = deletable[i:i + BATCH]
        bad = push(remote, "--delete", *chunk)
        for b in chunk:
            why = bad.get(f"refs/heads/{b}") or bad.get(b)
            if why:
                refused[b] = f"delete refused: {why}"
            else:
                deleted += 1
    return deleted, refused


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--apply", action="store_true", help="push the tags and delete the branches; default is a dry run")
    ap.add_argument("--age-days", type=int, default=AGE_DAYS, help=f"a branch untouched this long with no open pull request is archived (default {AGE_DAYS})")
    ap.add_argument("--remote", default="origin")
    a = ap.parse_args(argv)
    rows, kept = plan(a.remote, a.age_days, time.time())
    by_reason = collections.Counter(r.split(",")[0] if "patch(es)" not in r else "unmerged and untouched" for _b, _s, r, _t in rows)
    verb = "archived" if a.apply else "would archive"
    lines = [f"branch-archive  {verb} {len(rows)} branch(es); kept {sum(kept.values())}"]
    lines += [f"  {verb}: {n} {why}" for why, n in sorted(by_reason.items())]
    lines += [f"  kept: {n} {why}" for why, n in sorted(kept.items())]
    for b, sha, reason, tag in rows:
        lines.append(f"  {b} -> {tag} ({sha[:7]}; {reason})")
    if rows:
        lines.append("  restore any of them: git push origin refs/tags/archive/<branch>:refs/heads/<branch>")
    text = "\n".join(lines)
    print(text)
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a", encoding="utf-8") as f:
            f.write("```\n" + text + "\n```\n")
    if a.apply and rows:
        deleted, refused = apply(a.remote, rows)
        done = [f"branch-archive  deleted {deleted} branch(es); skipped {len(refused)}"]
        done += [f"  skipped: {b} -- {why}" for b, why in sorted(refused.items())]
        text = "\n".join(done)
        print(text)
        if summary:
            with open(summary, "a", encoding="utf-8") as f:
                f.write("```\n" + text + "\n```\n")
        # A skip is not a death, but deleting NOTHING when there was work to do is: that is
        # the seven-week failure, and a gate that cannot fail is not a gate.
        if deleted == 0:
            print("branch-archive: planned work but deleted nothing", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
