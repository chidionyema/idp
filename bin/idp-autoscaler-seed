#!/usr/bin/env bash
# crew#539 CP4: put the node pool the Cluster Autoscaler manages into the vault as `oke-autoscaler`
# (NODEPOOL_ID, COMPARTMENT_ID, REGION), the way every other row gets its facts: ExternalSecret
# platform/oci/autoscaler reads it, the Deployment's --nodes flag is `min:max:$(NODEPOOL_ID)`. No pool
# OCID is ever typed in git (LAW 46); the pool is found by cluster name, once per apply run.
#   OCI_COMPARTMENT_OCID=... OCI_REGION=... OCI_CLUSTER_NAME=estate bin/idp-autoscaler-seed [pool-key] [spot-pool-key]
# crew#539 CP10: the preemptible pool travels the same way, as SPOT_NODEPOOL_ID (pool key a1-spot).
# Prints key NAMES only. Exit 2 is BLIND (no ACTIVE cluster or pool of that name), never a write.
set -euo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
: "${OCI_COMPARTMENT_OCID:?}" "${OCI_REGION:?}" "${OCI_CLUSTER_NAME:=estate}"
POOL_KEY=${1:-a1}
SPOT_POOL_KEY=${2:-a1-spot}
CID=$(oci ce cluster list --compartment-id "$OCI_COMPARTMENT_OCID" --name "$OCI_CLUSTER_NAME" --lifecycle-state ACTIVE --query 'data[0].id' --raw-output 2>/dev/null || true)
[ -n "$CID" ] && [ "$CID" != null ] || { echo "BLIND   autoscaler-seed   no ACTIVE cluster named $OCI_CLUSTER_NAME"; exit 2; }
# the module names a pool <cluster>-<key>; ACTIVE only, the newest if a surge left two
pool_id() {
  oci ce node-pool list --compartment-id "$OCI_COMPARTMENT_OCID" --cluster-id "$CID" --name "$OCI_CLUSTER_NAME-$1" --lifecycle-state ACTIVE --sort-by TIME_CREATED --sort-order DESC --query 'data[0].id' --raw-output 2>/dev/null || true
}
PID=$(pool_id "$POOL_KEY")
[ -n "$PID" ] && [ "$PID" != null ] || { echo "BLIND   autoscaler-seed   no ACTIVE node pool named $OCI_CLUSTER_NAME-$POOL_KEY in cluster $OCI_CLUSTER_NAME"; exit 2; }
SPID=$(pool_id "$SPOT_POOL_KEY")
[ -n "$SPID" ] && [ "$SPID" != null ] || { echo "BLIND   autoscaler-seed   no ACTIVE node pool named $OCI_CLUSTER_NAME-$SPOT_POOL_KEY in cluster $OCI_CLUSTER_NAME"; exit 2; }
umask 077; f=$(mktemp); trap 'rm -f "$f"' EXIT
printf 'NODEPOOL_ID=%s\nSPOT_NODEPOOL_ID=%s\nCOMPARTMENT_ID=%s\nREGION=%s\n' "$PID" "$SPID" "$OCI_COMPARTMENT_OCID" "$OCI_REGION" > "$f"
ESTATE_ENV_FILE="$f" "$IDP/bin/idp-vault-put" oke-autoscaler NODEPOOL_ID=NODEPOOL_ID SPOT_NODEPOOL_ID=SPOT_NODEPOOL_ID COMPARTMENT_ID=COMPARTMENT_ID REGION=REGION
