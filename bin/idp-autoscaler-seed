#!/usr/bin/env bash
# crew#539 CP4: put the node pool the Cluster Autoscaler manages into the vault as `oke-autoscaler`
# (NODEPOOL_ID, COMPARTMENT_ID, REGION), the way every other row gets its facts: ExternalSecret
# platform/oci/autoscaler reads it, the Deployment's --nodes flag is `min:max:$(NODEPOOL_ID)`. No pool
# OCID is ever typed in git (LAW 46); the pool is found by cluster name, once per apply run.
#   OCI_COMPARTMENT_OCID=... OCI_REGION=... OCI_CLUSTER_NAME=estate bin/idp-autoscaler-seed [pool-key] [spot-pool-key]
# crew#539 CP10: the preemptible pool travels the same way, as SPOT_NODEPOOL_ID (pool key a1-spot).
# Prints key NAMES only. Exit 2 is BLIND (no ACTIVE cluster or pool of that name), never a write.
set -euo pipefail
trap 'echo "$0: exit $?" >&2' EXIT
IDP=$(cd "$(dirname "$0")/.." && pwd)
: "${OCI_COMPARTMENT_OCID:?}" "${OCI_REGION:?}" "${OCI_CLUSTER_NAME:=estate}"
POOL_KEY=${1:-a1}
SPOT_POOL_KEY=${2:-a1-spot}
CID=$(oci ce cluster list --compartment-id "$OCI_COMPARTMENT_OCID" --name "$OCI_CLUSTER_NAME" --lifecycle-state ACTIVE --query 'data[0].id' --raw-output 2>/dev/null || true)
[ -n "$CID" ] && [ "$CID" != null ] || {
	echo "BLIND   autoscaler-seed   no ACTIVE cluster named $OCI_CLUSTER_NAME"
	exit 2
}
# The OKE module names a pool by its key (`a1`, `a1-spot`), not `<cluster>-<key>`: the 2026-08-27
# apply run 33123127717 asked for `estate-a1`, found nothing, and left the vault empty while the
# ExternalSecret 404ed (tests/test_incident_crew539_seed_finds_the_pool_by_key.py). So: every ACTIVE
# pool of the cluster once, then the newest whose name is the key, `<cluster>-<key>`, or ends in
# `-<key>` (a surge can leave two). BLIND says which names exist, so the receipt explains itself.
POOLS=$(oci ce node-pool list --compartment-id "$OCI_COMPARTMENT_OCID" --cluster-id "$CID" --lifecycle-state ACTIVE --all \
	--query 'data[].{name:name,id:id,at:"time-created"}' --output json 2>/dev/null || echo '[]')
pool_id() {
	printf '%s' "$POOLS" | python3 -c '
import json, sys
key, cluster = sys.argv[1], sys.argv[2]
pools = [p for p in json.load(sys.stdin) if p["name"] in (key, f"{cluster}-{key}") or p["name"].endswith(f"-{key}")]
pools.sort(key=lambda p: p["at"], reverse=True)
print(pools[0]["id"] if pools else "")' "$1" "$OCI_CLUSTER_NAME"
}
names() { printf '%s' "$POOLS" | python3 -c 'import json,sys; print(" ".join(sorted(p["name"] for p in json.load(sys.stdin))) or "none")'; }
PID=$(pool_id "$POOL_KEY")
[ -n "$PID" ] || {
	echo "BLIND   autoscaler-seed   no ACTIVE node pool for key $POOL_KEY in cluster $OCI_CLUSTER_NAME (ACTIVE pools: $(names))"
	exit 2
}
SPID=$(pool_id "$SPOT_POOL_KEY")
[ -n "$SPID" ] || {
	echo "BLIND   autoscaler-seed   no ACTIVE node pool for key $SPOT_POOL_KEY in cluster $OCI_CLUSTER_NAME (ACTIVE pools: $(names))"
	exit 2
}
umask 077
f=$(mktemp)
trap 'rm -f "$f"' EXIT
printf 'NODEPOOL_ID=%s\nSPOT_NODEPOOL_ID=%s\nCOMPARTMENT_ID=%s\nREGION=%s\n' "$PID" "$SPID" "$OCI_COMPARTMENT_OCID" "$OCI_REGION" >"$f"
ESTATE_ENV_FILE="$f" "$IDP/bin/idp-vault-put" oke-autoscaler NODEPOOL_ID=NODEPOOL_ID SPOT_NODEPOOL_ID=SPOT_NODEPOOL_ID COMPARTMENT_ID=COMPARTMENT_ID REGION=REGION
