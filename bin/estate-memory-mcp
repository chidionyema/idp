#!/usr/bin/env python3
"""Estate memory as a stdio MCP server, for any runtime (#6156).

Every runtime registers this one command (bin/estate-memory-install writes the entry), so no
runtime's config holds the door's URL or key: the bridge reads the key by name when the first tool
is called, from MCP_GATEWAY_KEY or the vault, and forwards to the gateway with the Bearer header.

It serves only the manifest's memory tools (brief, recall, remember). The gateway behind it holds
execute_command and the rest; passing those through would make this a second execution surface,
and execution is intents only (AGENTS.md section 7). A call to any other tool is refused here.

It also serves the plan tools (platform/estate/memory/plan.py: declare_plan, revise_plan, add_bdd,
address_edgecases, address_2nd_order_effects, complete_goal), answered here with no door and no
key, so every MCP runtime has them even when the gateway is down (#6675). The bridge is one
process per session, so the plan it holds is that session's plan.
"""

from __future__ import annotations

import json
import os
import sys
import time

sys.path.insert(
    0,
    os.path.join(
        os.path.dirname(os.path.realpath(__file__)),
        "..",
        "platform",
        "estate",
        "memory",
    ),
)
import door  # noqa: E402
import focus  # noqa: E402
import plan  # noqa: E402

TOOLS = set(door.MANIFEST["tools"])
TIMEOUT_S = 30


class Bridge:
    def __init__(self):
        self.secret = None
        self.plan = None
        # THIS SESSION'S IDENTITY. The bridge is one process per runtime session, so it is the
        # natural place to bind a session to a ledger: the plan it holds is that session's plan
        # and the door reads the same ledger. The id comes from the environment first (the
        # runtime that set it owns the session), then the pointer the owning runtime wrote for
        # its process; failing both, this bridge generates one, because a session that has no
        # identity cannot be held to a plan at all.
        self.session_id = self._resolve_session()
        # The ordered plan calls this bridge has served. They are the bridge's own copy of
        # the plan, and they are what is MIGRATED when a later pointer turns out to own the
        # session (see _adopt_parent_session).
        self.calls: list = []

    def _resolve_session(self) -> str:
        sid = (os.environ.get("ESTATE_SESSION_ID") or "").strip()
        if sid:
            return sid
        for pid in (os.getppid(), os.getpid()):
            try:
                with open(plan.session_pointer_path(pid), encoding="utf-8") as fh:
                    data = json.load(fh)
            except (OSError, ValueError):
                continue
            sid = str((data or {}).get("session_id") or "").strip()
            if sid:
                return sid
        return "mcp-%d-%d" % (os.getpid(), int(time.time()))

    def _parent_session(self) -> str:
        """The session id the OWNING runtime bound to its own process, if it has."""
        try:
            with open(plan.session_pointer_path(os.getppid()), encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            return ""
        return str((data or {}).get("session_id") or "").strip()

    def _adopt_parent_session(self) -> None:
        """Adopt the owning runtime's session id when it appears AFTER this bridge started.

        The bridge generates its own id when no runtime pointer exists yet. Claude Code's
        hook writes its real session id later, when the first tool call happens. If the
        bridge kept its generated id, the door would read a ledger nobody declares into --
        the session would look unplanned forever. So the later pointer WINS, and the calls
        the bridge already served are migrated into the adopted ledger, in order.
        """
        sid = self._parent_session()
        if not sid or sid == self.session_id:
            return
        self.session_id = sid
        try:
            plan.sync_plan_calls(sid, self.calls)
        except Exception:  # noqa: BLE001 - a broken ledger must not break the session
            pass
        try:
            plan.write_session_pointer(sid)
        except Exception:  # noqa: BLE001 - a missing pointer must not break the session
            pass

    def _publish(self) -> None:
        """Make this session visible to the door: a pointer for the process, a ledger for the plan.

        The ledger is opened even when no plan is declared: its EXISTENCE is what tells the door
        that this runtime's adapter is live, and a live adapter with no plan is refused. A
        session whose adapter never ran has no ledger, and is allowed and recorded instead.

        Publication itself lives in plan.py (`publish_session`), so there is ONE definition of
        what a pointer, a marker and an ordered plan call mean -- here and in every adapter.
        """
        # A pointer that appeared since startup owns the session: adopt its id first, so the
        # pointer this bridge writes names the session the door will read.
        self._adopt_parent_session()
        try:
            # Two pointers: this bridge's own pid, and the pid of the runtime that owns it.
            # The door may be reached from a sibling of the bridge (the intent executor is
            # another child of the runtime), and it resolves identity by walking the process
            # tree -- so the runtime's pid is the pointer that answers it.
            plan.publish_session(self.session_id, pid=os.getpid(), overwrite=True)
            parent = os.getppid()
            # The runtime's pointer is NOT overwritten: Claude Code's own hook writes that
            # pointer under Claude's session id, and the hook's ledger is the transcript's
            # plan. Last writer wins would put two ledgers behind one pointer, and the door
            # would read whichever survived.
            plan.publish_session(self.session_id, pid=parent, overwrite=False)
        except Exception:  # noqa: BLE001 - a missing pointer must not break the session
            pass

    def plan_call(self, mid, name: str, args) -> dict:
        r = plan.apply(self.plan, name, args)
        if not r["ok"]:
            return refuse(mid, f"Refused: {r['reason']}")
        self.plan = r["plan"]
        # The durable ledger is the plan's home. The in-memory plan above is the same plan
        # (plan.apply is the only interpreter); this writes it where the door can read it, in
        # declaration order, so the very next command is authorised by what was just declared.
        self.calls.append([name, args or {}])
        try:
            # A pointer that appeared since startup owns the session: adopt it BEFORE the
            # event is written, so the event lands in the ledger the door will read.
            self._adopt_parent_session()
            plan.append_plan_event(self.session_id, name, args or {})
        except Exception:  # noqa: BLE001 - a broken ledger must not break the declaration
            pass
        return ok(mid, {"content": [{"type": "text", "text": r["message"]}]})

    def key(self) -> str:
        if self.secret is None:
            self.secret = door.key()
        return self.secret

    def handle(self, msg: dict) -> dict | None:
        if "id" not in msg:
            return None  # notifications need no answer, and the door holds no session for us
        method, mid = msg.get("method"), msg["id"]
        if method == "initialize":
            return ok(
                mid,
                {
                    "protocolVersion": msg.get("params", {}).get(
                        "protocolVersion", "2025-06-18"
                    ),
                    "capabilities": {"tools": {"listChanged": False}},
                    "serverInfo": {"name": door.MANIFEST["server"], "version": "1"},
                    "instructions": "Estate memory, shared by every agent and model. Call brief at the "
                    "start of a task, recall before deciding, remember what a later session should know. "
                    "Call declare_plan before any work, then per sub-goal: add_bdd before working on it, "
                    "address_edgecases and address_2nd_order_effects, complete_goal with proof.",
                },
            )
        if method == "ping":
            return ok(mid, {})
        if method not in ("tools/list", "tools/call"):
            return {
                "jsonrpc": "2.0",
                "id": mid,
                "error": {"code": -32601, "message": f"no method {method}"},
            }
        params = msg.get("params") or {}
        if method == "tools/call" and params.get("name") in plan.PLAN_TOOLS:
            return self.plan_call(mid, params["name"], params.get("arguments") or {})
        if method == "tools/call" and params.get("name") not in TOOLS:
            return refuse(
                mid, f"estate-memory serves {sorted(TOOLS | set(plan.PLAN_TOOLS))} only"
            )
        # The plan tools are listed whatever the door says: a runtime with no key or no
        # gateway must still be able to declare a plan, or the hook refuses it everything.
        if method == "tools/list":
            reply = self.forward(mid, msg)
            if "result" not in reply or reply["result"].get("isError"):
                reply = ok(mid, {"tools": []})
            reply["result"]["tools"] = [
                t for t in reply["result"].get("tools", []) if t["name"] in TOOLS
            ] + plan.TOOL_SCHEMAS
            return reply
        reply = self.forward(mid, msg)
        if "result" in reply and not reply["result"].get("isError"):
            name = params.get("name")
            if name in ("brief", "recall"):
                self.retire_ghosts(name, reply["result"])
        return reply

    def forward(self, mid, msg: dict) -> dict:
        """The door's reply to msg, or a refusal saying why there is none."""
        secret = self.key()
        if not secret:
            env = door.MANIFEST["door"]["key_env"]
            return refuse(
                mid,
                f"no {env}: export it, or add the vault entry dev/{env} (AGENTS.md section 4)",
            )
        try:
            reply, _ = door.post(msg, secret, TIMEOUT_S)
        except Exception as e:
            return refuse(
                mid, f"memory door unreachable: {type(e).__name__}: {str(e)[:200]}"
            )
        if reply is None:
            return refuse(mid, "memory door gave no reply")
        return reply

    def retire_ghosts(self, tool: str, result: dict) -> None:
        """Drop focus facts whose claim has closed from a brief/recall result, and give `brief`
        the live focus register. This is the root-cause fix for idp#6543: the session-start hook
        retired ghosts but the tools agents call mid-session did not, so a dead "ACTIVE FOCUS"
        fact kept being served. Every runtime passes this bridge, so it is fixed once, here.
        Never raises: a result we cannot parse is returned as the door sent it."""
        try:
            register = focus.live_focus() if tool == "brief" else None
            dropped = []
            payloads = []
            if isinstance(result.get("structuredContent"), dict):
                payloads.append((result["structuredContent"], None))
            for block in result.get("content", []):
                if block.get("type") == "text":
                    try:
                        parsed = json.loads(block.get("text", ""))
                    except (ValueError, TypeError):
                        continue
                    if isinstance(parsed, dict):
                        payloads.append((parsed, block))
            for payload, block in payloads:
                dropped += focus.scrub(tool, payload)
                if register is not None:
                    payload["active_focus"] = register
                if block is not None:
                    block["text"] = json.dumps(payload)
            if dropped:
                names = ", ".join(sorted({d["text"].strip()[:60] for d in dropped}))
                print(
                    f"estate-memory: dropped {len(dropped)} stale focus fact(s) from {tool}: {names}",
                    file=sys.stderr,
                )
        except Exception as e:  # a filter must never cost an agent its memory
            print(
                f"estate-memory: focus filter skipped ({type(e).__name__})",
                file=sys.stderr,
            )


def ok(mid, result: dict) -> dict:
    return {"jsonrpc": "2.0", "id": mid, "result": result}


def refuse(mid, why: str) -> dict:
    return ok(mid, {"content": [{"type": "text", "text": why}], "isError": True})


def main() -> int:
    bridge = Bridge()
    bridge._publish()
    for line in sys.stdin:
        if not line.strip():
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue
        out = bridge.handle(msg)
        if out is not None:
            sys.stdout.write(json.dumps(out) + "\n")
            sys.stdout.flush()
    return 0


if __name__ == "__main__":
    sys.exit(main())
