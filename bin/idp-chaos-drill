#!/usr/bin/env bash
# crew#292 CP4: grades the weekly Chaos Mesh experiment from outside the cluster.
#
# platform/chaos/backstage-pod-kill.yaml kills one Backstage pod every Monday 03:00Z while a
# StatusCheck watches /healthcheck; its last step writes one line to the Object Storage bucket
# platform/oci/receipts.tf owns, from the worker node's identity. A runner has no kube path, so
# this reads that object through the OCI session the job already holds and grades its age.
#
# Prints one line, like every drill:
#   ok      chaos-drill  <receipt text> (<age>h old, max <max>h)
#   FAIL    chaos-drill  <why>            -- no receipt, a stale one, or one that is not "ok"
#   BLIND   chaos-drill  <why>            -- no oci CLI or no session; nothing was graded
# max age 194h = 7 days + 2h scheduling slack. Override with CHAOS_MAX_AGE_HOURS.
# crew#539 DoD 2: the same grader reads any experiment's receipt: `idp-chaos-drill <name> <row>`
# (default backstage-pod-kill chaos-drill; `langfuse-alert-drill alert-drill` grades the page drill).
set -uo pipefail
IDP=$(cd "$(dirname "$0")/.." && pwd)
NAME="${1:-backstage-pod-kill}"
ROW="${2:-chaos-drill}"
BUCKET="${DRILL_RECEIPT_BUCKET:-estate-drill-receipts}"
MAX_H="${CHAOS_MAX_AGE_HOURS:-194}"
blind() { printf 'BLIND   %s  %s\n' "$ROW" "$1"; exit 2; }
fail()  { printf 'FAIL    %s  %s\n' "$ROW" "$1"; exit 1; }
command -v python3 >/dev/null || blind "python3 is not installed"
head=$("$IDP/bin/idp-cloud" object head --bucket "$BUCKET" --name "chaos/$NAME" 2>&1)
rc=$?
if [ $rc -ne 0 ]; then
  case "$head" in
    *"404"*|*NotFound*|*"not found"*) fail "no receipt chaos/$NAME in bucket $BUCKET: the Schedule has never accomplished a run (or the bucket is not applied yet)" ;;
    *) blind "object head failed: $(printf '%s' "$head" | tail -1 | cut -c1-160)" ;;
  esac
fi
body=$("$IDP/bin/idp-cloud" object get --bucket "$BUCKET" --name "chaos/$NAME" 2>/dev/null | head -1)
# crew#539 (2026-08-28 00:28Z, run 33129788480): the outage receipt (36 Flux rows, 40 pods with
# their last log) outgrew ARG_MAX and `python3: Argument list too long` graded the estate BLIND
# at the moment it needed reading. The body travels by file, never by argv.
bodyf=$(mktemp); trap 'rm -f "$bodyf"' EXIT; printf '%s' "$body" > "$bodyf"
python3 - "$head" "$bodyf" "$MAX_H" "$ROW" <<'PY'
import os as _os
def _body_arg(a):
    # crew#539: the receipt is a file path when the caller wrote it out (ARG_MAX, run 33129788480); a literal body is still accepted for the test harnesses.
    return (open(a, encoding='utf-8', errors='replace').read() if _os.path.isfile(a) else a).strip()
import json, sys
from datetime import datetime, timezone
from email.utils import parsedate_to_datetime
head, body, max_h, row = sys.argv[1], _body_arg(sys.argv[2]), float(sys.argv[3]), sys.argv[4]
try:
    lm = json.loads(head)["last-modified"]
except Exception as e:
    print(f"BLIND   {row}  object head carried no last-modified: {e}"); sys.exit(2)
age = (datetime.now(timezone.utc) - parsedate_to_datetime(lm)).total_seconds() / 3600
if not body.startswith("ok "):
    print(f"FAIL    {row}  receipt does not start with ok: {body[:120]!r}"); sys.exit(1)
if age > max_h:
    print(f"FAIL    {row}  receipt is {age:.1f}h old (max {max_h:.0f}h): {body[:120]}"); sys.exit(1)
print(f"ok      {row}  {body[:120]} ({age:.1f}h old, max {max_h:.0f}h)")
PY
