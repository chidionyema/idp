#!/usr/bin/env python3
"""Grade the portal a person sees, as served, for plain English.

Founder, 2026-08-31: "need to remeasure when the PR is live". The files are graded by
.github/workflows/prose.yml; this grades what the running portal serves, with the login drill's
signed-in session (DRILL_STATE, written by bin/idp-login-drill when DRILL_STATE_OUT is set):

  buttons    every Template entity: title, description, form labels, output link titles
  catalogue  every other entity: title, description, link titles
  docs       every page of every entity that carries rendered docs (TechDocs search index)

Each surface is graded by Vale with the estate boundary (.vale.ini, styles/Estate), error level.
Output, one line per surface: `ok|FAIL  prose-live  <surface> errors=<n> items=<m>` and a JSON
receipt at PROSE_LIVE_OUT when set. Exit 0 = measured; 1 = a founder-first surface (buttons,
catalogue) carries errors and PROSE_LIVE_STRICT=1; 2 = BLIND, the portal could not be read.
Nothing here names a host: the portal URL comes from the drill's state.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

ROOT = os.environ.get("IDP_ROOT") or os.path.dirname(
    os.path.dirname(os.path.abspath(__file__))
)


def blind(reason: str) -> None:
    print(f"BLIND   prose-live  {reason}")
    sys.exit(2)


def entity_fields(e: dict) -> list[str]:
    """The strings a person reads on an entity's page. Keys, URLs and refs are not among them."""
    m = e.get("metadata") or {}
    out = [m.get("title") or "", m.get("description") or ""]
    out += [link.get("title") or "" for link in m.get("links") or []]
    spec = e.get("spec") or {}
    if (e.get("kind") or "").lower() == "template":
        for step in spec.get("parameters") or []:
            out += [step.get("title") or "", step.get("description") or ""]
            for prop in (step.get("properties") or {}).values():
                out += [prop.get("title") or "", prop.get("description") or ""]
        out += [
            link.get("title") or ""
            for link in (spec.get("output") or {}).get("links") or []
        ]
    return [x for x in out if x]


def grade(text: str) -> list[dict]:
    """Vale, error level, estate boundary. Returns the alerts."""
    r = subprocess.run(
        ["vale", "--ext=.md", "--output=JSON", "--no-exit", "--minAlertLevel=error"],
        input=text,
        capture_output=True,
        text=True,
        cwd=ROOT,
        check=False,
    )
    if r.returncode != 0:
        blind(f"vale did not run: {r.stderr.strip()[:200]}")
    doc = json.loads(r.stdout or "{}")
    return [a for alerts in doc.values() for a in alerts]


class Portal:
    def __init__(self, state: dict):
        self.home = state["home"].rstrip("/")
        host = urllib.parse.urlparse(self.home).hostname or ""
        cookie = "; ".join(
            f"{c['name']}={c['value']}"
            for c in state.get("cookies", [])
            if host.endswith((c.get("domain") or "").lstrip("."))
        )
        self.headers = {"Cookie": cookie, "Authorization": f"Bearer {state['token']}"}

    def get_json(self, path: str):
        req = urllib.request.Request(self.home + path, headers=self.headers)
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            blind(f"{path} answered {e.code}")
        except (urllib.error.URLError, ValueError) as e:
            blind(f"{path} did not answer: {e}")


def measure(entities: list[dict], docs_index: dict[str, list[dict]]) -> dict:
    """Pure: entities and per-entity search indexes in, per-surface counts and alerts out."""
    surfaces: dict[str, dict] = {}
    buttons = [e for e in entities if (e.get("kind") or "").lower() == "template"]
    others = [e for e in entities if e not in buttons]
    for name, group in (("buttons", buttons), ("catalogue", others)):
        text = "\n\n".join("\n\n".join(entity_fields(e)) for e in group)
        alerts = grade(text) if text.strip() else []
        surfaces[name] = {
            "items": len(group),
            "errors": len(alerts),
            "alerts": alerts[:50],
        }
    pages = [d for docs in docs_index.values() for d in docs if d.get("text")]
    text = "\n\n".join(f"# {d.get('title', '')}\n\n{d['text']}" for d in pages)
    alerts = grade(text) if text.strip() else []
    surfaces["docs"] = {
        "items": len(pages),
        "errors": len(alerts),
        "alerts": alerts[:50],
    }
    return surfaces


def main() -> int:
    state_path = os.environ.get("DRILL_STATE")
    if not state_path or not os.path.isfile(state_path):
        blind(
            "DRILL_STATE names no file; run bin/idp-login-drill with DRILL_STATE_OUT first"
        )
    with open(state_path) as fh:
        portal = Portal(json.load(fh))
    entities = portal.get_json("/api/catalog/entities")
    if not isinstance(entities, list) or not entities:
        blind("the catalogue API answered no entities")
    docs_index: dict[str, list[dict]] = {}
    for e in entities:
        ann = (e.get("metadata") or {}).get("annotations") or {}
        if "backstage.io/techdocs-ref" not in ann:
            continue
        m = e["metadata"]
        ref = f"{m.get('namespace', 'default')}/{e['kind']}/{m['name']}".lower()
        idx = portal.get_json(
            f"/api/techdocs/static/docs/{ref}/search/search_index.json"
        )
        if idx and isinstance(idx.get("docs"), list):
            docs_index[ref] = idx["docs"]
    surfaces = measure(entities, docs_index)
    strict = os.environ.get("PROSE_LIVE_STRICT") == "1"
    rc = 0
    for name, s in surfaces.items():
        red = s["errors"] > 0 and name in ("buttons", "catalogue") and strict
        rc = 1 if red else rc
        print(
            f"{'FAIL' if red else 'ok'}    prose-live  {name} errors={s['errors']} items={s['items']}"
        )
    out = os.environ.get("PROSE_LIVE_OUT")
    if out:
        with open(out, "w") as fh:
            json.dump({"portal": portal.home, "surfaces": surfaces}, fh, indent=1)
    return rc


if __name__ == "__main__":
    sys.exit(main())
