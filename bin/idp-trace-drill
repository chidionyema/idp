#!/usr/bin/env bash
# One call through the estate's router, and its trace read back out of the estate's trace
# store (crew#325 showcase). This is the definition of done for "model routing" and "traces"
# as one command: LiteLLM at llm.<zone> answers a chat completion, and Langfuse at
# langfuse.<zone> holds the trace of that exact call a few seconds later.
#
# Reachable is not the same as working. A router that answers 200 with the langfuse callback
# misconfigured drops every trace silently; a Langfuse whose worker cannot write to ClickHouse
# renders an empty dashboard. So the drill sends a real call with its own trace id, then asks
# Langfuse's public API for that id. Nothing else proves the whole chain (DNS, the Gateway
# listener, LiteLLM, the upstream, the callback, Langfuse ingestion) at once.
#
# Credentials come out of the vault by name and are never printed (LAW 46):
#   litellm-upstream (JSON)        -> LITELLM_MASTER_KEY
#   langfuse-init-public-key       -> the project's public key
#   langfuse-init-secret-key       -> the project's secret key
#
#   bin/idp-trace-drill
#
# Prints exactly one verdict line and exits 0 only when the trace came back:
#   ok      trace-drill  llm.<zone> answered via <model> in 2.3s; trace <id> in Langfuse after 4s
#   FAIL    trace-drill  <stage> <detail>
# Stages: config, tools, vault, dns, router, trace.
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
export SUPPRESS_LABEL_WARNING=True
fail() { printf 'FAIL    trace-drill  %s %s\n' "$1" "$2"; exit 1; }

for t in oci curl jq dig python3; do command -v "$t" >/dev/null 2>&1 || fail tools "$t missing"; done

CFG="$IDP/clusters/oke/estate-config.yaml"
[ -f "$CFG" ] || fail config "no $CFG"
ZONE=$(awk '/ESTATE_ZONE:/{print $2}' "$CFG")
[ -n "$ZONE" ] || fail config "clusters/oke/estate-config.yaml has no ESTATE_ZONE"
MODEL="${TRACE_DRILL_MODEL:-openrouter}"   # a model_name in platform/llm/config.yaml. Incident 2026-08-26 (crew#325): the direct deepseek key answered 402 Insufficient Balance and litellm does not fall back on a 4xx; openrouter routes the same model through a funded account.
LLM="https://llm.$ZONE"
LF="https://langfuse.$ZONE"

# --- the keys, by name, out of the vault --------------------------------------------------------
C="${OCI_COMPARTMENT_OCID:-}"
[ -n "$C" ] || fail config "OCI_COMPARTMENT_OCID is not set"
vault() {  # vault <secret-name> -> decoded content on stdout, never on argv
  local sid b64
  # ACTIVE only: a same-named secret pending deletion lists first and holds stale keys (run 33006811039)
  # crew#325 (run 33008917584): two vaults named estate-secrets each held an ACTIVE $1; the cluster
  # reads one, CI wrote the other, and a by-name read picked either. More than one is a split, not a hit.
  local out; out=$("$IDP/bin/idp-cloud" secret get "$1" 2>"${TMPDIR:-/tmp}/trace-drill.err") || case $? in
    1) fail vault "no secret $1 in the compartment";;
    3) fail vault "$(head -1 "${TMPDIR:-/tmp}/trace-drill.err")";;
    *) fail vault "secret-bundle for $1 is empty or unreadable by this identity";;
  esac
  printf '%s' "$out"
}
UP=$(vault litellm-upstream)
MASTER=$(printf '%s' "$UP" | jq -r '.LITELLM_MASTER_KEY // empty' 2>/dev/null)
# On a miss, name the keys the secret does hold (names only, never values; LAW 46)
shape() {  # value-free description of a secret payload that did not parse as JSON
  local b64 dd
  b64=$(printf '%s' "$1" | tr -d '\n' | grep -qE '^[A-Za-z0-9+/=]+$' && echo yes || echo no)
  dd=$(printf '%s' "$1" | base64 -d 2>/dev/null | jq -e 'type' 2>/dev/null || echo no)
  printf 'len=%s base64-shaped=%s json-after-second-decode=%s' "${#1}" "$b64" "$dd"
}
[ -n "$MASTER" ] || fail vault "litellm-upstream holds no LITELLM_MASTER_KEY; keys present: $(printf '%s' "$UP" | jq -r 'keys | join(" ")' 2>/dev/null || echo "not JSON ($(shape "$UP"))")"
unset UP
LF_PK=$(vault langfuse-init-public-key); LF_SK=$(vault langfuse-init-secret-key)
[ -n "$LF_PK" ] && [ -n "$LF_SK" ] || fail vault "langfuse-init-public-key or langfuse-init-secret-key decodes to nothing"

# --- dns: both hostnames must resolve, or the layer that broke is external-dns --------------------
for h in "llm.$ZONE" "langfuse.$ZONE"; do
  [ -n "$(dig +short "$h" A | head -1)" ] || fail dns "$h has no A record (external-dns has not published the HTTPRoute hostname)"
done

# --- one call, with a trace id of our own -------------------------------------------------------
TRACE="drill-$(date -u +%Y%m%dT%H%M%SZ)-$RANDOM"
T0=$(date +%s.%N)
RESP=$(curl -sS --max-time 90 -o - -w '\n%{http_code}' "$LLM/v1/chat/completions" \
  -H "Authorization: Bearer $MASTER" -H 'Content-Type: application/json' \
  -d "$(jq -cn --arg m "$MODEL" --arg t "$TRACE" '{model:$m, max_tokens:8, messages:[{role:"user",content:"Reply with the single word: ok"}], metadata:{trace_id:$t, tags:["trace-drill"]}}')") || fail router "curl to $LLM failed"
CODE=${RESP##*$'\n'}; BODY=${RESP%$'\n'*}
unset MASTER
[ "$CODE" = "200" ] || fail router "$LLM/v1/chat/completions answered http $CODE: $(printf '%s' "$BODY" | jq -r '.error.message // .' 2>/dev/null | head -c 200)"
USED=$(printf '%s' "$BODY" | jq -r '.model // "?"')
T1=$(date +%s.%N)
ROUTER_S=$(python3 -c "print(f'{$T1-$T0:.1f}')")

# --- the trace, read back by id -------------------------------------------------------------------
# /api/public/ carries Langfuse's own key auth and bypasses the login ForwardAuth
# (platform/observability/httproute.yaml). Ingestion is asynchronous; give it up to 90 s.
i=0
while [ $i -lt 18 ]; do
  sleep 5; i=$((i+1))
  CODE=$(curl -sS --max-time 20 -o /dev/null -w '%{http_code}' -u "$LF_PK:$LF_SK" "$LF/api/public/traces/$TRACE") || CODE=000
  if [ "$CODE" = "200" ]; then
    printf 'ok      trace-drill  llm.%s answered via %s in %ss; trace %s in Langfuse after %ss\n' "$ZONE" "$USED" "$ROUTER_S" "$TRACE" "$((i*5))"
    exit 0
  fi
  case "$CODE" in 404|000) ;; *) fail trace "$LF/api/public/traces/$TRACE answered http $CODE (a 302 means the login still fronts the public API)";; esac
done
fail trace "trace $TRACE not in Langfuse 90s after a 200 from the router (callback or ingestion)"
