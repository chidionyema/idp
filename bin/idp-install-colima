#!/usr/bin/env bash
# Install substrate/colima.yaml as this machine's colima profile config (LAW 24: the VM's
# sizing and binfmt setting were load-bearing and lived only under ~/.colima until crew#212).
# It never restarts colima (ruling R22): a changed file takes effect on the next `colima start`,
# and this script says so. `--check` only reports drift; exit 1 on drift, 2 if colima is absent.
set -euo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
SRC="$IDP/substrate/colima.yaml"
DEST="${COLIMA_HOME:-$HOME/.colima}/default/colima.yaml"
command -v colima >/dev/null || { echo "BLIND colima is not installed on this machine"; exit 2; }
if cmp -s "$SRC" "$DEST"; then echo "ok      colima config matches substrate/colima.yaml"; exit 0; fi
if [ "${1:-}" = "--check" ]; then
  echo "DRIFT   $DEST differs from substrate/colima.yaml:"; diff "$DEST" "$SRC" | head -20 || true; exit 1
fi
cp "$SRC" "$DEST"
echo "written $DEST from substrate/colima.yaml"
echo "note    takes effect on the next colima start; this script does not restart colima (R22)"
