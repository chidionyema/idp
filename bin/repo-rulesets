#!/usr/bin/env bash
# repo-rulesets [--apply]: every repository under the estate account carries
# platform/github/ruleset.default-branch.json, and a repository named in an
# overlay file platform/github/ruleset.<repo>.<name>.json carries that ruleset
# too (idp: ruleset.idp.required-checks.json makes offline-gate, bdd and
# security-scan required before anything lands on main). Report mode by default.
#
# Why per repo: the account is a User (gh api /users/<owner> -q .type), and
# org-wide rulesets ("~ALL") exist only on organizations. On the free plan a
# private repo answers 403 to the rulesets API; those are printed as BLOCKED,
# never skipped silently. Idempotent: an existing ruleset of the same name is
# updated (PUT), a missing one created (POST).
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
OWNER="${ESTATE_GH_OWNER:-$(gh api /user -q .login)}"
DEFAULT="$IDP/platform/github/ruleset.default-branch.json"
apply=0; [ "${1:-}" = "--apply" ] && apply=1
ok=0; drift=0; blocked=0
apply_spec() {
  repo="$1"; SPEC="$2"; NAME="$(jq -r .name "$SPEC")"
  list="$(gh api "/repos/$OWNER/$repo/rulesets" 2>/dev/null)" || { echo "BLOCKED $repo: private on the free plan (403); make it public or upgrade"; blocked=$((blocked+1)); return; }
  id="$(printf '%s' "$list" | jq -r --arg n "$NAME" '.[] | select(.name==$n) | .id' | head -1)"
  if [ -n "$id" ]; then
    live="$(gh api "/repos/$OWNER/$repo/rulesets/$id" | jq -S '{target,enforcement,conditions,rules:[.rules[]|{type}]}')"
    want="$(jq -S '{target,enforcement,conditions,rules:[.rules[]|{type}]}' "$SPEC")"
    if [ "$live" = "$want" ]; then echo "ok      $repo: $NAME #$id"; ok=$((ok+1)); return; fi
    if [ $apply = 1 ]; then gh api -X PUT "/repos/$OWNER/$repo/rulesets/$id" --input "$SPEC" >/dev/null && echo "FIXED   $repo: updated #$id" && ok=$((ok+1)) && return; fi
    echo "DRIFT   $repo: $NAME #$id differs from $SPEC"; drift=$((drift+1))
  else
    if [ $apply = 1 ]; then nid="$(gh api -X POST "/repos/$OWNER/$repo/rulesets" --input "$SPEC" -q .id)" && echo "FIXED   $repo: created #$nid" && ok=$((ok+1)) && return; fi
    echo "MISSING $repo: no ruleset $NAME"; drift=$((drift+1))
  fi
}
while read -r repo; do apply_spec "$repo" "$DEFAULT"; done < <(gh repo list "$OWNER" --limit 200 --no-archived --json name -q '.[].name' | sort)
for f in "$IDP"/platform/github/ruleset.*.*.json; do
  [ -e "$f" ] || break
  r="$(basename "$f")"; r="${r#ruleset.}"; r="${r%%.*}"
  apply_spec "$r" "$f"
done
echo "$([ $drift = 0 ] && echo 'ok  ' || echo FAIL)  rulesets $ok in place, $drift missing or drifted, $blocked private repos blocked by plan"
[ $drift = 0 ]
