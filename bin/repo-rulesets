#!/usr/bin/env bash
# repo-rulesets [--apply]: every repository under the estate account carries
# platform/github/ruleset.default-branch.json, and a repository named in an
# overlay file platform/github/ruleset.<repo>.<name>.json carries that ruleset
# too (idp: ruleset.idp.required-checks.json makes offline-gate, bdd and
# security-scan required before anything lands on main). An overlay named
# ruleset.@active.<name>.json applies to every repository pushed in the last
# ACTIVE_DAYS (30) days: the estate-wide gates security-scan and spec-gate,
# which bin/estate-security-rollout installs first. Report mode by default.
#
# Why per repo: the account is a User (gh api /users/<owner> -q .type), and
# org-wide rulesets ("~ALL") exist only on organizations. On the free plan a
# private repo answers 403 to the rulesets API; those are printed as BLOCKED,
# never skipped silently. The comparison includes each rule's parameters (crew#631 CP6):
# a required-check list edited by hand is DRIFT, not ok; do_not_enforce_on_create is a default
# GitHub adds to every answer and is dropped from both sides. Idempotent: an existing ruleset of the same name is
# updated (PUT), a missing one created (POST).
set -uo pipefail
ruleset_shape() {
  jq -eS '{target,enforcement,conditions,
    bypass_actors: ((.bypass_actors // []) | sort_by(.actor_type,.actor_id,.bypass_mode)),
    rules:[.rules[]|{type,parameters:(.parameters|del(.do_not_enforce_on_create))}]}'
}
if [ "${1:-}" = --self-test ]; then
  empty='{"target":"branch","enforcement":"active","conditions":{},"rules":[],"bypass_actors":[]}'
  extra='{"target":"branch","enforcement":"active","conditions":{},"rules":[],"bypass_actors":[{"actor_id":1,"actor_type":"RepositoryRole","bypass_mode":"always"}]}'
  hidden='{"target":"branch","enforcement":"active","conditions":{},"rules":[]}'
  test "$(printf '%s' "$empty" | ruleset_shape)" != "$(printf '%s' "$extra" | ruleset_shape)" || exit 1
  test "$(printf '%s' "$empty" | ruleset_shape)" = "$(printf '%s' "$hidden" | ruleset_shape)" || exit 1
  if printf '%s' "$hidden" | jq -e 'has("bypass_actors") and (.bypass_actors | type == "array")' >/dev/null; then exit 1; fi
  printf '%s' "$empty" | jq -e 'has("bypass_actors") and (.bypass_actors | type == "array")' >/dev/null || exit 1
  echo 'ruleset-bypass self-test: 4/4 passed'
  exit 0
fi
IDP="$(cd "$(dirname "$0")/.." && pwd)"
OWNER="${ESTATE_GH_OWNER:-$(gh api /user -q .login)}"
DEFAULT="$IDP/platform/github/ruleset.default-branch.json"
apply=0; [ "${1:-}" = "--apply" ] && apply=1
ok=0; drift=0; blocked=0
apply_spec() {
  repo="$1"; SPEC="$2"; NAME="$(jq -r .name "$SPEC")"
  list="$(gh api "/repos/$OWNER/$repo/rulesets" 2>/dev/null)" || { echo "BLOCKED $repo: private on the free plan (403); make it public or upgrade"; blocked=$((blocked+1)); return; }
  id="$(printf '%s' "$list" | jq -r --arg n "$NAME" '.[] | select(.name==$n) | .id' | head -1)"
  if [ -n "$id" ]; then
    # The API omits bypass actors when the caller cannot administer this ruleset.
    # Missing visibility is not proof that no actor can bypass.
    live_json="$(gh api "/repos/$OWNER/$repo/rulesets/$id")" || {
      echo "BLOCKED $repo: $NAME live ruleset unreadable"; blocked=$((blocked+1)); return; }
    if ! printf '%s' "$live_json" | jq -e 'has("bypass_actors") and (.bypass_actors | type == "array")' >/dev/null; then
      echo "BLOCKED $repo: $NAME bypass actors not observable"; blocked=$((blocked+1)); return
    fi
    live="$(printf '%s' "$live_json" | ruleset_shape)" || {
      echo "BLOCKED $repo: $NAME invalid live rule shape"; blocked=$((blocked+1)); return; }
    want="$(ruleset_shape < "$SPEC")" || {
      echo "BLOCKED $repo: $NAME invalid declared rule shape"; blocked=$((blocked+1)); return; }
    if [ "$live" = "$want" ]; then echo "ok      $repo: $NAME #$id"; ok=$((ok+1)); return; fi
    if [ $apply = 1 ]; then gh api -X PUT "/repos/$OWNER/$repo/rulesets/$id" --input "$SPEC" >/dev/null && echo "FIXED   $repo: updated #$id" && ok=$((ok+1)) && return; fi
    echo "DRIFT   $repo: $NAME #$id differs from $SPEC"; drift=$((drift+1))
  else
    if [ $apply = 1 ]; then nid="$(gh api -X POST "/repos/$OWNER/$repo/rulesets" --input "$SPEC" -q .id)" && echo "FIXED   $repo: created #$nid" && ok=$((ok+1)) && return; fi
    echo "MISSING $repo: no ruleset $NAME"; drift=$((drift+1))
  fi
}
jobs_on_main() {  # true when the caller workflow, or a ci.yml carrying both jobs, is on the default branch
  gh api "/repos/$OWNER/$1/contents/.github/workflows/security-scan.yml" -q .sha >/dev/null 2>&1 && return 0
  gh api "/repos/$OWNER/$1/contents/.github/workflows/ci.yml" -q .content 2>/dev/null | base64 -d 2>/dev/null | grep '^  spec-gate:' >/dev/null
}
# crew#586 CP5: under GitHub's "first_time_contributors" policy every pull request opened by
# github-actions (state/live-diagram, flux/image-updates) sits in
# action_required until a person approves its runs -- an auto-merge PR nobody approves is a
# daily hand. platform/github/actions-pr-approval.json pins the policy per repository.
APPROVAL="$IDP/platform/github/actions-pr-approval.json"
apply_pr_approval() {
  repo="$1"; want="$(jq -r .approval_policy "$APPROVAL")"
  live="$(gh api "/repos/$OWNER/$repo/actions/permissions/fork-pr-contributor-approval" -q .approval_policy 2>/dev/null)" || { echo "BLOCKED $repo: pr-approval policy unreadable"; blocked=$((blocked+1)); return; }
  [ "$live" = "$want" ] && return
  if [ $apply = 1 ]; then gh api -X PUT "/repos/$OWNER/$repo/actions/permissions/fork-pr-contributor-approval" --input "$APPROVAL" >/dev/null && echo "FIXED   $repo: pr-approval $live -> $want" && return; fi
  echo "DRIFT   $repo: pr-approval is $live, spec says $want (bot PRs sit in action_required)"; drift=$((drift+1))
}
waiting=0
ACTIVE_DAYS="${ACTIVE_DAYS:-30}"
since="$(date -u -v-"${ACTIVE_DAYS}"d +%Y-%m-%d 2>/dev/null || date -u -d "-${ACTIVE_DAYS} days" +%Y-%m-%d)"
repos="$(gh repo list "$OWNER" --limit 200 --no-archived --json name,pushedAt -q '.[] | .name+" "+.pushedAt[:10]' | sort)"
while read -r repo _; do apply_spec "$repo" "$DEFAULT"; apply_pr_approval "$repo"; done <<< "$repos"
for f in "$IDP"/platform/github/ruleset.*.*.json; do
  [ -e "$f" ] || break
  r="$(basename "$f")"; r="${r#ruleset.}"; r="${r%%.*}"
  if [ "$r" = "@active" ]; then
    # A required check that never reports blocks every merge (LAW 38). The overlay
    # is applied only where the jobs it requires exist on the default branch.
    while read -r repo pushed; do
      [ "$pushed" \> "$since" ] || continue
      if jobs_on_main "$repo"; then apply_spec "$repo" "$f"
      else echo "WAITING $repo: $(jq -r .name "$f") not applied; .github/workflows/security-scan.yml is not on the default branch yet (bin/estate-security-rollout)"; waiting=$((waiting+1)); fi
    done <<< "$repos"
  else
    apply_spec "$r" "$f"
  fi
done
echo "$([ $drift = 0 ] && echo 'ok  ' || echo FAIL)  rulesets $ok in place, $drift missing or drifted, $blocked private repos blocked by plan, $waiting active repos waiting for the rollout"
[ "$drift" -eq 0 ] && [ "$blocked" -eq 0 ]
