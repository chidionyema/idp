#!/usr/bin/env bash
# repo-rulesets [--apply]: every repository under the estate account carries
# platform/github/ruleset.default-branch.json. Report mode by default.
#
# Why per repo: the account is a User (gh api /users/<owner> -q .type), and
# org-wide rulesets ("~ALL") exist only on organizations. On the free plan a
# private repo answers 403 to the rulesets API; those are printed as BLOCKED,
# never skipped silently. Idempotent: an existing ruleset of the same name is
# updated (PUT), a missing one created (POST).
set -uo pipefail
IDP="$(cd "$(dirname "$0")/.." && pwd)"
OWNER="${ESTATE_GH_OWNER:-$(gh api /user -q .login)}"
SPEC="$IDP/platform/github/ruleset.default-branch.json"
NAME="$(jq -r .name "$SPEC")"
apply=0; [ "${1:-}" = "--apply" ] && apply=1
ok=0; drift=0; blocked=0
while read -r repo; do
  list="$(gh api "/repos/$OWNER/$repo/rulesets" 2>/dev/null)" || { echo "BLOCKED $repo: private on the free plan (403); make it public or upgrade"; blocked=$((blocked+1)); continue; }
  id="$(printf '%s' "$list" | jq -r --arg n "$NAME" '.[] | select(.name==$n) | .id' | head -1)"
  if [ -n "$id" ]; then
    live="$(gh api "/repos/$OWNER/$repo/rulesets/$id" | jq -S '{target,enforcement,conditions,rules:[.rules[]|{type}]}')"
    want="$(jq -S '{target,enforcement,conditions,rules:[.rules[]|{type}]}' "$SPEC")"
    if [ "$live" = "$want" ]; then echo "ok      $repo: $NAME #$id"; ok=$((ok+1)); continue; fi
    if [ $apply = 1 ]; then gh api -X PUT "/repos/$OWNER/$repo/rulesets/$id" --input "$SPEC" >/dev/null && echo "FIXED   $repo: updated #$id" && ok=$((ok+1)) && continue; fi
    echo "DRIFT   $repo: $NAME #$id differs from $SPEC"; drift=$((drift+1))
  else
    if [ $apply = 1 ]; then nid="$(gh api -X POST "/repos/$OWNER/$repo/rulesets" --input "$SPEC" -q .id)" && echo "FIXED   $repo: created #$nid" && ok=$((ok+1)) && continue; fi
    echo "MISSING $repo: no ruleset $NAME"; drift=$((drift+1))
  fi
done < <(gh repo list "$OWNER" --limit 200 --no-archived --json name -q '.[].name' | sort)
echo "$([ $drift = 0 ] && echo 'ok  ' || echo FAIL)  rulesets $ok carry $NAME, $drift missing or drifted, $blocked private repos blocked by plan"
[ $drift = 0 ]
